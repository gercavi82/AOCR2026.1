        /// <summary>
        /// Inserta un nuevo control FR3 con su detalle automáticamente
        /// (equivalente a NuevoControlFR3 en CD_ControlFR3)
        /// </summary>
        public int Insertar(ControlFR3 control)
        {
            int idInsertado = 0;

            try
            {
                // Asignar secuencial automático
                control.Secuencial = ObtenerSiguienteSecuencial(control.Aeropuerto);
                control.FechaCreacion = DateTime.Now;
                control.FechaCr = DateTime.Now.ToString("yyyyMMdd");
                control.HoraCr = DateTime.Now.ToString("HHmmss");

                using (var conn = new NpgsqlConnection(_connectionString))
                {
                    conn.Open();
                    using (var tran = conn.BeginTransaction())
                    {
                        try
                        {
                            // Insertar cabecera
                            var sql = @"INSERT INTO aocr_control_fr3 (
                                secuencial, aeropuerto, anio, fecha_control_vuelo, tipo_operacion, 
                                ruta_total_plan_vlo, num_aterriza_pais, subtotal, valor_charter, total, 
                                gran_total, gran_total_letras, autorizacion, observacion, oid_cia_aviacion, 
                                origen, destino, retorno, callsign, estado, ruc, email, nac_inter, 
                                usuario_cr, fecha_cr, hora_cr, id_aeropuerto, telefono, nombre_cliente, 
                                direccion, oid_ubicacion_cliente, forma_pago, nombre_cia, modelo, 
                                peso_matricula, codigo_oaci_cia, nombre_aeropuerto, email_usuario_dgac, 
                                matricula, procesado, oid_ubicacion, valor_total_millas, tipo_tramite,
                                fecha_creacion, activo
                            ) VALUES (
                                @secuencial, @aeropuerto, @anio, @fechaControlVuelo, @tipoOperacion,
                                @rutaTotalPlanVlo, @numAterrizaPais, @subtotal, @valorCharter, @total,
                                @granTotal, @granTotalLetras, @autorizacion, @observacion, @oidCiaAviacion,
                                @origen, @destino, @retorno, @callsign, @estado, @ruc, @email, @nacInter,
                                @usuarioCr, @fechaCr, @horaCr, @idAeropuerto, @telefono, @nombreCliente,
                                @direccion, @oidUbicacionCliente, @formaPago, @nombreCia, @modelo,
                                @pesoMatricula, @codigoOACICia, @nombreAeropuerto, @emailUsuarioDGAC,
                                @matricula, @procesado, @oidUbicacion, @valorTotalMillas, @tipoTramite,
                                @fechaCreacion, TRUE
                            ) RETURNING id";

                            using (var cmd = new NpgsqlCommand(sql, conn, tran))
                            {
                                cmd.Parameters.AddWithValue("@secuencial", control.Secuencial);
                                cmd.Parameters.AddWithValue("@aeropuerto", control.Aeropuerto ?? "");
                                cmd.Parameters.AddWithValue("@anio", control.Anio ?? DateTime.Now.Year.ToString());
                                cmd.Parameters.AddWithValue("@fechaControlVuelo", control.FechaControlVuelo ?? "");
                                cmd.Parameters.AddWithValue("@tipoOperacion", control.TipoOperacion ?? "");
                                cmd.Parameters.AddWithValue("@rutaTotalPlanVlo", control.RutaTotalPlanVlo ?? "");
                                cmd.Parameters.AddWithValue("@numAterrizaPais", control.NumAterrizaPais);
                                cmd.Parameters.AddWithValue("@subtotal", control.SubTotal);
                                cmd.Parameters.AddWithValue("@valorCharter", control.ValorCharter);
                                cmd.Parameters.AddWithValue("@total", control.Total);
                                cmd.Parameters.AddWithValue("@granTotal", control.GranTotal);
                                cmd.Parameters.AddWithValue("@granTotalLetras", control.GranTotalLetras ?? "");
                                cmd.Parameters.AddWithValue("@autorizacion", control.Autorizacion ?? "");
                                cmd.Parameters.AddWithValue("@observacion", control.Observacion ?? "");
                                cmd.Parameters.AddWithValue("@oidCiaAviacion", control.OidCiaAviacion);
                                cmd.Parameters.AddWithValue("@origen", control.Origen ?? "");
                                cmd.Parameters.AddWithValue("@destino", control.Destino ?? "");
                                cmd.Parameters.AddWithValue("@retorno", control.Retorno ?? "");
                                cmd.Parameters.AddWithValue("@callsign", control.Callsign ?? "");
                                cmd.Parameters.AddWithValue("@estado", control.Estado ?? "E");
                                cmd.Parameters.AddWithValue("@ruc", control.Ruc ?? "");
                                cmd.Parameters.AddWithValue("@email", control.Email ?? "");
                                cmd.Parameters.AddWithValue("@nacInter", control.NacInter ?? "");
                                cmd.Parameters.AddWithValue("@usuarioCr", control.UsuarioCr ?? "");
                                cmd.Parameters.AddWithValue("@fechaCr", control.FechaCr ?? "");
                                cmd.Parameters.AddWithValue("@horaCr", control.HoraCr ?? "");
                                cmd.Parameters.AddWithValue("@idAeropuerto", control.IdAeropuerto);
                                cmd.Parameters.AddWithValue("@telefono", control.Telefono ?? "");
                                cmd.Parameters.AddWithValue("@nombreCliente", control.NombreCliente ?? "");
                                cmd.Parameters.AddWithValue("@direccion", control.Direccion ?? "");
                                cmd.Parameters.AddWithValue("@oidUbicacionCliente", control.OidUbicacionCliente);
                                cmd.Parameters.AddWithValue("@formaPago", control.FormaPago ?? "");
                                cmd.Parameters.AddWithValue("@nombreCia", control.NombreCia ?? "");
                                cmd.Parameters.AddWithValue("@modelo", control.Modelo ?? "");
                                cmd.Parameters.AddWithValue("@pesoMatricula", control.PesoMatricula);
                                cmd.Parameters.AddWithValue("@codigoOACICia", control.CodigoOACICia ?? "");
                                cmd.Parameters.AddWithValue("@nombreAeropuerto", control.NombreAeropuerto ?? "");
                                cmd.Parameters.AddWithValue("@emailUsuarioDGAC", control.EmailUsuarioDGAC ?? "");
                                cmd.Parameters.AddWithValue("@matricula", control.Matricula ?? "");
                                cmd.Parameters.AddWithValue("@procesado", control.Procesado ?? "E");
                                cmd.Parameters.AddWithValue("@oidUbicacion", control.OidUbicacion);
                                cmd.Parameters.AddWithValue("@valorTotalMillas", control.GranTotal); // mismo valor que GranTotal
                                cmd.Parameters.AddWithValue("@tipoTramite", control.TipoTramite ?? "");
                                cmd.Parameters.AddWithValue("@fechaCreacion", control.FechaCreacion);

                                var result = cmd.ExecuteScalar();
                                idInsertado = Convert.ToInt32(result);
                            }

                            // Actualizar tabla de secuenciales
                            ActualizarSecuencialInterno(conn, tran, control.Aeropuerto, control.Secuencial);

                            // Insertar detalle automático si existe
                            if (control.Detalle != null)
                            {
                                control.Detalle.ControlFR3Id = idInsertado;
                                control.Detalle.Secuencial = control.Secuencial;
                                control.Detalle.Aeropuerto = control.Aeropuerto;
                                control.Detalle.Anio = control.Anio;
                                control.Detalle.SecuencialDetalle = 1;
                                InsertarDetalleInterno(conn, tran, control.Detalle);
                            }
                            else
                            {
                                // Crear detalle automático (como en CD_ControlFR3 original)
                                var detalle = CrearDetalleAutomatico(control, idInsertado);
                                InsertarDetalleInterno(conn, tran, detalle);
                            }

                            tran.Commit();
                            _logger.LogInfo("Control FR3 insertado con ID={0}, Secuencial={1}, Aeropuerto={2}", 
                                idInsertado, control.Secuencial, control.Aeropuerto);
                        }
                        catch
                        {
                            tran.Rollback();
                            throw;
                        }
                    }
                }
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Error en Insertar ControlFR3");
                throw;
            }

            return idInsertado;
        }

