        /// <summary>
        /// Obtiene estadísticas de FR3 por estado
        /// </summary>
        public Dictionary<string, int> ObtenerEstadisticas(string aeropuerto = null)
        {
            var stats = new Dictionary<string, int>();

            try
            {
                using (var conn = new NpgsqlConnection(_connectionString))
                {
                    conn.Open();
                    var sql = @"SELECT COALESCE(estado, 'SIN_ESTADO') as estado, COUNT(*) as cantidad 
                                FROM aocr_control_fr3 WHERE activo = TRUE";

                    if (!string.IsNullOrWhiteSpace(aeropuerto))
                        sql += " AND aeropuerto = @aeropuerto";

                    sql += " GROUP BY estado";

                    using (var cmd = new NpgsqlCommand(sql, conn))
                    {
                        if (!string.IsNullOrWhiteSpace(aeropuerto))
                            cmd.Parameters.AddWithValue("@aeropuerto", aeropuerto);

                        using (var reader = cmd.ExecuteReader())
                        {
                            while (reader.Read())
                            {
                                stats[reader.GetString(0)] = reader.GetInt32(1);
                            }
                        }
                    }
                }
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Error en ObtenerEstadisticas");
            }

            return stats;
        }

