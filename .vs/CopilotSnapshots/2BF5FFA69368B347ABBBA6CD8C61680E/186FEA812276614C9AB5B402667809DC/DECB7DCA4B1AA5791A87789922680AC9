    public class ControlFR3DAO
    {
        private readonly string _connectionString;
        private readonly ILoggerService _logger;

        public ControlFR3DAO()
        {
            _connectionString = System.Configuration.ConfigurationManager.ConnectionStrings["DefaultConnection"]?.ConnectionString
                ?? System.Configuration.ConfigurationManager.ConnectionStrings["AOCRConnection"]?.ConnectionString
                ?? "";
            _logger = new NLogLoggerService("ControlFR3DAO");
        }

        public ControlFR3DAO(string connectionString)
        {
            _connectionString = connectionString;
            _logger = new NLogLoggerService("ControlFR3DAO");
        }

        #region Lectura

        /// <summary>
        /// Obtiene un control FR3 por secuencial, aeropuerto y año
        /// (equivalente a ObtienerControlFr3 en CD_ControlFR3)
        /// </summary>
        public ControlFR3 ObtenerPorSecuencial(decimal secuencial, string aeropuerto, string anio)
        {
            ControlFR3 control = null;

            try
            {
                using (var conn = new NpgsqlConnection(_connectionString))
                {
                    conn.Open();
                    var sql = @"SELECT * FROM aocr_control_fr3 
                                WHERE secuencial = @secuencial 
                                  AND aeropuerto = @aeropuerto 
                                  AND anio = @anio 
                                  AND activo = TRUE
                                LIMIT 1";

                    using (var cmd = new NpgsqlCommand(sql, conn))
                    {
                        cmd.Parameters.AddWithValue("@secuencial", secuencial);
                        cmd.Parameters.AddWithValue("@aeropuerto", aeropuerto ?? "");
                        cmd.Parameters.AddWithValue("@anio", anio ?? "");

                        using (var reader = cmd.ExecuteReader())
                        {
                            if (reader.Read())
                            {
                                control = MapearControlFR3(reader);
                            }
                        }
                    }
                }
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Error en ObtenerPorSecuencial");
                throw;
            }

            return control;
        }

        /// <summary>
        /// Obtiene un control FR3 por su ID de PostgreSQL
        /// </summary>
        public ControlFR3 ObtenerPorId(int id)
        {
            ControlFR3 control = null;

            try
            {
                using (var conn = new NpgsqlConnection(_connectionString))
                {
                    conn.Open();
                    var sql = "SELECT * FROM aocr_control_fr3 WHERE id = @id AND activo = TRUE";

                    using (var cmd = new NpgsqlCommand(sql, conn))
                    {
                        cmd.Parameters.AddWithValue("@id", id);

                        using (var reader = cmd.ExecuteReader())
                        {
                            if (reader.Read())
                            {
                                control = MapearControlFR3(reader);
                            }
                        }
                    }

                    // Cargar detalle si existe
                    if (control != null)
                    {
                        control.Detalle = ObtenerDetallePorControlId(control.Id, conn);
                    }
                }
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Error en ObtenerPorId");
                throw;
            }

            return control;
        }

        /// <summary>
        /// Obtiene un control FR3 por su ID de PostgreSQL (async)
        /// </summary>
        public Task<ControlFR3> ObtenerPorIdAsync(int id)
        {
            return Task.FromResult(ObtenerPorId(id));
        }

        /// <summary>
        /// Lista todos los controles FR3 activos, opcionalmente filtrados
        /// </summary>
        public List<ControlFR3> Listar(string aeropuerto = null, string anio = null, string estado = null)
        {
            var lista = new List<ControlFR3>();

            try
            {
                using (var conn = new NpgsqlConnection(_connectionString))
                {
                    conn.Open();
                    var sql = "SELECT * FROM aocr_control_fr3 WHERE activo = TRUE";
                    var filtros = new List<string>();

                    if (!string.IsNullOrWhiteSpace(aeropuerto))
                        filtros.Add(" AND aeropuerto = @aeropuerto");
                    if (!string.IsNullOrWhiteSpace(anio))
                        filtros.Add(" AND anio = @anio");
                    if (!string.IsNullOrWhiteSpace(estado))
                        filtros.Add(" AND estado = @estado");

                    sql += string.Join("", filtros) + " ORDER BY fecha_creacion DESC";

                    using (var cmd = new NpgsqlCommand(sql, conn))
                    {
                        if (!string.IsNullOrWhiteSpace(aeropuerto))
                            cmd.Parameters.AddWithValue("@aeropuerto", aeropuerto);
                        if (!string.IsNullOrWhiteSpace(anio))
                            cmd.Parameters.AddWithValue("@anio", anio);
                        if (!string.IsNullOrWhiteSpace(estado))
                            cmd.Parameters.AddWithValue("@estado", estado);

                        using (var reader = cmd.ExecuteReader())
                        {
                            while (reader.Read())
                            {
                                lista.Add(MapearControlFR3(reader));
                            }
                        }
                    }
                }
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Error en Listar");
                throw;
            }

            return lista;
        }

