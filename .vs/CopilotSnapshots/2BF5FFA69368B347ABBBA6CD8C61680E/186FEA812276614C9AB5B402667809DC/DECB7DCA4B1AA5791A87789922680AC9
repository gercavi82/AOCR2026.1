        private ControlFR3Detalle ObtenerDetallePorControlId(int controlFR3Id, NpgsqlConnection conn)
        {
            ControlFR3Detalle detalle = null;

            var sql = @"SELECT * FROM aocr_control_fr3_detalle 
                        WHERE control_fr3_id = @controlId AND activo = TRUE
                        ORDER BY secuencial_detalle ASC LIMIT 1";

            using (var cmd = new NpgsqlCommand(sql, conn))
            {
                cmd.Parameters.AddWithValue("@controlId", controlFR3Id);

                using (var reader = cmd.ExecuteReader())
                {
                    if (reader.Read())
                    {
                        detalle = MapearDetalle(reader);
                    }
                }
            }

            return detalle;
        }

        /// <summary>
        /// Obtiene todos los detalles de un control FR3
        /// </summary>
        public List<ControlFR3Detalle> ObtenerDetallesPorControlId(int controlFR3Id)
        {
            var detalles = new List<ControlFR3Detalle>();

            try
            {
                using (var conn = new NpgsqlConnection(_connectionString))
                {
                    conn.Open();
                    var sql = @"SELECT * FROM aocr_control_fr3_detalle 
                                WHERE control_fr3_id = @controlId AND activo = TRUE
                                ORDER BY secuencial_detalle ASC";

                    using (var cmd = new NpgsqlCommand(sql, conn))
                    {
                        cmd.Parameters.AddWithValue("@controlId", controlFR3Id);

                        using (var reader = cmd.ExecuteReader())
                        {
                            while (reader.Read())
                            {
                                detalles.Add(MapearDetalle(reader));
                            }
                        }
                    }
                }
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Error en ObtenerDetallesPorControlId");
                throw;
            }

            return detalles;
        }

