        /// <summary>
        /// Obtiene el próximo número secuencial para un aeropuerto
        /// (equivalente a secuencialFR3 en CD_ControlFR3)
        /// </summary>
        public decimal ObtenerSiguienteSecuencial(string aeropuerto)
        {
            decimal secuencial = 1;

            try
            {
                using (var conn = new NpgsqlConnection(_connectionString))
                {
                    conn.Open();
                    var sql = @"SELECT COALESCE(MAX(secuencial), 0) + 1 
                                FROM aocr_control_fr3 
                                WHERE aeropuerto = @aeropuerto AND activo = TRUE";

                    using (var cmd = new NpgsqlCommand(sql, conn))
                    {
                        cmd.Parameters.AddWithValue("@aeropuerto", aeropuerto ?? "");
                        var result = cmd.ExecuteScalar();
                        if (result != null && result != DBNull.Value)
                        {
                            secuencial = Convert.ToDecimal(result);
                        }
                    }
                }
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Error en ObtenerSiguienteSecuencial");
                throw;
            }

            return secuencial;
        }

        /// <summary>
        /// Obtiene el próximo secuencial de detalle para un control FR3
        /// (equivalente a secuencialFR3Detalle en CD_ControlFR3)
        /// </summary>
        public decimal ObtenerSiguienteSecuencialDetalle(int controlFR3Id)
        {
            decimal secuencial = 1;

            try
            {
                using (var conn = new NpgsqlConnection(_connectionString))
                {
                    conn.Open();
                    var sql = @"SELECT COALESCE(MAX(secuencial_detalle), 0) + 1 
                                FROM aocr_control_fr3_detalle 
                                WHERE control_fr3_id = @controlId AND activo = TRUE";

                    using (var cmd = new NpgsqlCommand(sql, conn))
                    {
                        cmd.Parameters.AddWithValue("@controlId", controlFR3Id);
                        var result = cmd.ExecuteScalar();
                        if (result != null && result != DBNull.Value)
                        {
                            secuencial = Convert.ToDecimal(result);
                        }
                    }
                }
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Error en ObtenerSiguienteSecuencialDetalle");
                throw;
            }

            return secuencial;
        }

        /// <summary>
        /// Actualiza el secuencial en la tabla de secuenciales
        /// (equivalente a ActualizaSecuencialFR3 en CD_ControlFR3)
        /// </summary>
        public bool ActualizarSecuencial(string aeropuerto, decimal secuencial)
        {
            try
            {
                if (string.IsNullOrWhiteSpace(aeropuerto))
                {
                    _logger.LogWarning("No se puede actualizar secuencial: aeropuerto vacío");
                    return false;
                }

                using (var conn = new NpgsqlConnection(_connectionString))
                {
                    conn.Open();
                    ActualizarSecuencialInterno(conn, null, aeropuerto, secuencial);
                    return true;
                }
            }
            catch (Npgsql.PostgresException pgEx)
            {
                _logger.LogError(pgEx, "Error PostgreSQL en ActualizarSecuencial. SqlState={0}", pgEx.SqlState);
                return false;
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Error en ActualizarSecuencial");
                return false;
            }
        }

