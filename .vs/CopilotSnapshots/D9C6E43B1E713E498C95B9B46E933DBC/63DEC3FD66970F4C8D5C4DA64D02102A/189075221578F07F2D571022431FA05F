        public static Dictionary<string, decimal> ObtenerTotalesPorTipo(int codigoInspeccion)
        {
            NpgsqlConnection conexion = null;
            Dictionary<string, decimal> totales = new Dictionary<string, decimal>();

            try
            {
                conexion = ConexionDAO.ObtenerConexion();
                string query = @"SELECT tipo, SUM(monto) as total
                    FROM aocr_tbviatico 
                    WHERE codigo_inspeccion = @id
                    GROUP BY tipo
                    ORDER BY tipo";

                using (NpgsqlCommand cmd = new NpgsqlCommand(query, conexion))
                {
                    cmd.Parameters.AddWithValue("@id", codigoInspeccion);

                    using (NpgsqlDataReader reader = cmd.ExecuteReader())
                    {
                        // Resolver ordinales una sola vez fuera del bucle
                        int ordTipo  = reader.GetOrdinal("tipo");
                        int ordTotal = reader.GetOrdinal("total");
                        while (reader.Read())
                        {
                            string tipo = reader.IsDBNull(ordTipo) ? "Sin Tipo" : reader.GetString(ordTipo);
                            decimal total = reader.GetDecimal(ordTotal);
                            totales[tipo] = total;
                        }
                    }
                }
                return totales;
            }
            catch (Exception ex)
            {
                throw new Exception("Error al obtener totales por tipo: " + ex.Message, ex);
            }
            finally
            {
                ConexionDAO.CerrarConexion(conexion);
            }
        }

