        #region Mapeo

        private static Viatico MapearViatico(NpgsqlDataReader reader)
        {
            // Resolver todos los ordinales una sola vez para evitar búsquedas repetidas por nombre
            int ordCodViatico  = reader.GetOrdinal("codigo_viatico");
            int ordCodInsp     = reader.GetOrdinal("codigo_inspeccion");
            int ordCodTec      = reader.GetOrdinal("codigo_tecnico");
            int ordConcepto    = reader.GetOrdinal("concepto");
            int ordMonto       = reader.GetOrdinal("monto");
            int ordFecha       = reader.GetOrdinal("fecha");
            int ordTipo        = reader.GetOrdinal("tipo");
            int ordComprobante = reader.GetOrdinal("comprobante");
            int ordObs         = reader.GetOrdinal("observaciones");
            int ordNombre      = reader.GetOrdinal("nombretecnico");
            int ordApellido    = reader.GetOrdinal("apellidotecnico");

            return new Viatico
            {
                CodigoViatico    = Convert.ToInt32(reader.GetValue(ordCodViatico)),
                CodigoInspeccion = reader.IsDBNull(ordCodInsp)     ? (int?)null      : Convert.ToInt32(reader.GetValue(ordCodInsp)),
                CodigoTecnico    = reader.IsDBNull(ordCodTec)      ? (int?)null      : Convert.ToInt32(reader.GetValue(ordCodTec)),
                Concepto         = reader.IsDBNull(ordConcepto)    ? null            : reader.GetString(ordConcepto),
                Monto            = reader.IsDBNull(ordMonto)       ? (decimal?)null  : reader.GetDecimal(ordMonto),
                Fecha            = reader.IsDBNull(ordFecha)       ? (DateTime?)null : reader.GetDateTime(ordFecha),
                Tipo             = reader.IsDBNull(ordTipo)        ? null            : reader.GetString(ordTipo),
                Comprobante      = reader.IsDBNull(ordComprobante) ? null            : reader.GetString(ordComprobante),
                Observaciones    = reader.IsDBNull(ordObs)         ? null            : reader.GetString(ordObs),
                NombreTecnico    = reader.IsDBNull(ordNombre)      ? null
                    : reader.GetString(ordNombre) + " " + (reader.IsDBNull(ordApellido) ? string.Empty : reader.GetString(ordApellido))
            };
        }

