            int ordTotal = reader.GetOrdinal("total");
            int ordLugarEmision = reader.GetOrdinal("lugar_emision");
            int ordCompania = reader.GetOrdinal("compania");
            int ordRucCedula = reader.GetOrdinal("ruc_cedula");
            int ordCorreo = reader.GetOrdinal("correo");
            int ordTelefono = reader.GetOrdinal("telefono");
            int ordConceptoId = reader.GetOrdinal("concepto_id");
            int ordConceptoNombre = reader.GetOrdinal("concepto_nombre");
            var orden = new OrdenRecaudacion
            {
                Id = reader.IsDBNull(ordId) ? 0 : reader.GetInt32(ordId),
                CodigoUsuario = reader.IsDBNull(ordCodUsr) ? (int? )null : reader.GetInt32(ordCodUsr),
                CodigoSolicitud = reader.IsDBNull(ordCodSol) ? (int? )null : reader.GetInt32(ordCodSol),
                NumeroOrden = reader.IsDBNull(ordNumOrden) ? null : reader.GetString(ordNumOrden),
                FechaCreacion = reader.IsDBNull(ordFecha) ? DateTime.Now : reader.GetDateTime(ordFecha),
                Estado = reader.IsDBNull(ordEstado) ? EstadoOrden.Borrador : reader.GetString(ordEstado),
                Observacion = reader.IsDBNull(ordObservacion) ? null : reader.GetString(ordObservacion),
                Subtotal = reader.IsDBNull(ordSubtotal) ? 0m : reader.GetDecimal(ordSubtotal),
                Admin = reader.IsDBNull(ordAdmin) ? 0m : reader.GetDecimal(ordAdmin),
                Total = reader.IsDBNull(ordTotal) ? 0m : reader.GetDecimal(ordTotal),
                LugarEmision = reader.IsDBNull(ordLugarEmision) ? null : reader.GetString(ordLugarEmision),
                Compania = reader.IsDBNull(ordCompania) ? null : reader.GetString(ordCompania),
                RucCedula = reader.IsDBNull(ordRucCedula) ? null : reader.GetString(ordRucCedula),
                Correo = reader.IsDBNull(ordCorreo) ? null : reader.GetString(ordCorreo),
                Telefono = reader.IsDBNull(ordTelefono) ? null : reader.GetString(ordTelefono),
