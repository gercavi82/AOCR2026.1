        private static Pago MapearPagoEntidadOptimizado(IDataReader reader)
        {
            int ordCodigoPago      = reader.GetOrdinal("codigo_pago");
            int ordCodSolicitud    = reader.GetOrdinal("codigo_solicitud");
            int ordNumFactura      = reader.GetOrdinal("numero_factura");
            int ordMonto           = reader.GetOrdinal("monto");
            int ordMetodoPago      = reader.GetOrdinal("metodo_pago");
            int ordBanco           = reader.GetOrdinal("banco");
            int ordEstado          = reader.GetOrdinal("estado");
            int ordFechaPago       = reader.GetOrdinal("fecha_pago");
            int ordObservaciones   = reader.GetOrdinal("observaciones");
            int ordComprobanteRuta = reader.GetOrdinal("comprobante_ruta");
            int ordFechaVal        = reader.GetOrdinal("fecha_validacion");
            int ordValidadoPor     = reader.GetOrdinal("validado_por");

            return new Pago
            {
                Id                = reader.IsDBNull(ordCodigoPago)      ? 0                : Convert.ToInt32(reader.GetValue(ordCodigoPago)),
                CodigoSolicitud   = reader.IsDBNull(ordCodSolicitud)    ? 0                : Convert.ToInt32(reader.GetValue(ordCodSolicitud)),
                NumeroComprobante = reader.IsDBNull(ordNumFactura)      ? null             : reader.GetString(ordNumFactura),
                MontoPagado       = reader.IsDBNull(ordMonto)           ? 0m               : reader.GetDecimal(ordMonto),
                MetodoPago        = reader.IsDBNull(ordMetodoPago)      ? null             : reader.GetString(ordMetodoPago),
                BancoOrigen       = reader.IsDBNull(ordBanco)           ? null             : reader.GetString(ordBanco),
                Estado            = reader.IsDBNull(ordEstado)          ? null             : reader.GetString(ordEstado),
                FechaPago         = reader.IsDBNull(ordFechaPago)       ? DateTime.MinValue : reader.GetDateTime(ordFechaPago),
                Observaciones     = reader.IsDBNull(ordObservaciones)   ? null             : reader.GetString(ordObservaciones),
                RutaComprobante   = reader.IsDBNull(ordComprobanteRuta) ? null             : reader.GetString(ordComprobanteRuta),
                FechaValidacion   = reader.IsDBNull(ordFechaVal)        ? (DateTime?)null  : reader.GetDateTime(ordFechaVal),
                UsuarioValidacion = reader.IsDBNull(ordValidadoPor)     ? null             : reader.GetString(ordValidadoPor)
            };
        }

