        // Helpers copiados del DAO actual
        private static int GetSafeInt32Actual(IDataReader reader, string columnName)
        {
            var ordinal = reader.GetOrdinal(columnName);
            if (reader.IsDBNull(ordinal))
                return 0;
            var ft = reader.GetFieldType(ordinal);
            if (ft == typeof(int))
                return reader.GetInt32(ordinal);
            if (ft == typeof(string))
            {
                int r;
                return int.TryParse(reader.GetString(ordinal), out r) ? r : 0;
            }

            return Convert.ToInt32(reader.GetValue(ordinal));
        }

        private static int? GetSafeNullableIntActual(IDataReader reader, string columnName)
        {
            var ordinal = reader.GetOrdinal(columnName);
            if (reader.IsDBNull(ordinal))
                return null;
            var ft = reader.GetFieldType(ordinal);
            if (ft == typeof(int))
                return reader.GetInt32(ordinal);
            if (ft == typeof(string))
            {
                int r;
                return int.TryParse(reader.GetString(ordinal), out r) ? (int? )r : null;
            }

            return Convert.ToInt32(reader.GetValue(ordinal));
        }

