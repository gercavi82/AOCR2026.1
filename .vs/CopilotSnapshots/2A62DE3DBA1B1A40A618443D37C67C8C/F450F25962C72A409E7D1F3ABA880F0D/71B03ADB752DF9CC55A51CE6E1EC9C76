using System;
using System.Globalization;
using System.Security.Cryptography;
using System.Text;
using System.Web;
using CapaDatos.DAOs;
using CapaDatos.Entidades;
using CapaModelo;

namespace CapaDatos.Services
{
    public enum EmailDeliveryPolicy
    {
        DirectThenQueue = 0,
        QueueOnly = 1,
        DirectOnly = 2
    }

    public sealed class EmailWorkflowRequest
    {
        public string EventCode { get; set; }
        public string TemplateKey { get; set; }
        public string Controller { get; set; }
        public string Action { get; set; }
        public string Actor { get; set; }
        public string CorrelationId { get; set; }
        public int? OrdenId { get; set; }
        public int? SolicitudId { get; set; }
        public int? InspeccionId { get; set; }
        public string NumeroOrden { get; set; }
        public string RecipientEmail { get; set; }
        public string RecipientName { get; set; }
        public string Subject { get; set; }
        public string HtmlBody { get; set; }
        public byte[] AttachmentBytes { get; set; }
        public string AttachmentName { get; set; }
        public string EventKey { get; set; }
        public EmailDeliveryPolicy DeliveryPolicy { get; set; }
        public int MaxAttempts { get; set; }

        public EmailWorkflowRequest()
        {
            DeliveryPolicy = EmailDeliveryPolicy.DirectThenQueue;
            MaxAttempts = 3;
        }
    }

    public sealed class EmailWorkflowResult
    {
        public bool Success { get; set; }
        public bool Skipped { get; set; }
        public string Reason { get; set; }
        public string ChannelUsed { get; set; }
        public int? QueueId { get; set; }
        public string MessageId { get; set; }
        public string ErrorDetail { get; set; }

        public static EmailWorkflowResult OkDirect(string messageId)
        {
            return new EmailWorkflowResult { Success = true, ChannelUsed = "SMTP_DIRECT", MessageId = messageId };
        }

        public static EmailWorkflowResult OkQueue(int queueId)
        {
            return new EmailWorkflowResult { Success = true, ChannelUsed = "QUEUE", QueueId = queueId };
        }

        public static EmailWorkflowResult Skip(string reason)
        {
            return new EmailWorkflowResult { Skipped = true, Reason = reason };
        }

        public static EmailWorkflowResult Fail(string detail, string channel)
        {
            return new EmailWorkflowResult { ErrorDetail = detail, ChannelUsed = channel };
        }
    }

    public interface IEmailWorkflowService
    {
        EmailWorkflowResult Dispatch(EmailWorkflowRequest request);
        EmailWorkflowResult NotificarSolicitudCreada(SolicitudAOCR solicitud, int codigoSolicitud, string actor, string detalleUrl);
        EmailWorkflowResult NotificarInspectorAsignado(SolicitudAOCR solicitud, string nombreInspector, DateTime fechaInspeccion, string actor, string detalleUrl);
        EmailWorkflowResult NotificarAprobacionFinanciera(OrdenRecaudacion orden, string actor);
    }

    public class EmailWorkflowService : IEmailWorkflowService
    {
        private readonly ILoggingService _logger;
        private readonly IEmailService _smtpService;
        private readonly IEmailQueueService _queueService;
        private readonly OrdenRecaudacionDAO _ordenDao;

        public EmailWorkflowService()
            : this(new EmailService(new SecureConfigurationService()), new EmailQueueService(), LoggingServiceFactory.Create(), new OrdenRecaudacionDAO())
        {
        }

        public EmailWorkflowService(IEmailService smtpService, IEmailQueueService queueService, ILoggingService logger, OrdenRecaudacionDAO ordenDao)
        {
            _smtpService = smtpService;
            _queueService = queueService;
            _logger = logger;
            _ordenDao = ordenDao;
        }

        public EmailWorkflowResult Dispatch(EmailWorkflowRequest request)
        {
            request = request ?? new EmailWorkflowRequest();
            request.CorrelationId = string.IsNullOrWhiteSpace(request.CorrelationId)
                ? Guid.NewGuid().ToString("N").Substring(0, 12)
                : request.CorrelationId.Trim();

            if (string.IsNullOrWhiteSpace(request.RecipientEmail))
            {
                LogWarning("Email workflow skipped: recipient empty.", request, "EMAIL_RECIPIENT_EMPTY");
                return EmailWorkflowResult.Skip("Recipient empty.");
            }

            if (string.IsNullOrWhiteSpace(request.Subject))
            {
                request.Subject = "Notificacion AOCR";
            }

            if (string.IsNullOrWhiteSpace(request.HtmlBody))
            {
                request.HtmlBody = "<p>Notificacion AOCR.</p>";
            }

            if (request.DeliveryPolicy == EmailDeliveryPolicy.QueueOnly)
            {
                return TryQueue(request, null);
            }

            var direct = TryDirect(request);
            if (direct.Success || request.DeliveryPolicy == EmailDeliveryPolicy.DirectOnly)
            {
                return direct;
            }

            return TryQueue(request, direct.ErrorDetail);
        }

        public EmailWorkflowResult NotificarSolicitudCreada(SolicitudAOCR solicitud, int codigoSolicitud, string actor, string detalleUrl)
        {
            if (solicitud == null || codigoSolicitud <= 0) return EmailWorkflowResult.Skip("Solicitud invalida.");
            var recipient = FirstNonEmpty(solicitud.CorreoRepresentanteTecnico, solicitud.Email);
            if (string.IsNullOrWhiteSpace(recipient)) return EmailWorkflowResult.Skip("Solicitud sin correo.");

            var numero = FirstNonEmpty(solicitud.NumeroSolicitud, "#" + codigoSolicitud.ToString(CultureInfo.InvariantCulture));
            var operador = FirstNonEmpty(solicitud.NombreOperador, solicitud.RazonSocial, "Operador");
            var subject = "AOCR - Solicitud registrada " + numero;
            var body = "<p>Estimado/a solicitante,</p>"
                     + "<p>Su solicitud AOCR se registro correctamente.</p>"
                     + "<p><strong>Solicitud:</strong> " + HttpUtility.HtmlEncode(numero) + "</p>"
                     + "<p><strong>Operador:</strong> " + HttpUtility.HtmlEncode(operador) + "</p>"
                     + (!string.IsNullOrWhiteSpace(detalleUrl)
                        ? "<p><a href=\"" + HttpUtility.HtmlAttributeEncode(detalleUrl) + "\">Ver detalle</a></p>"
                        : string.Empty);

            return Dispatch(new EmailWorkflowRequest
            {
                EventCode = "SOLICITUD_CREADA",
                TemplateKey = "solicitud_creada_v1",
                Controller = "SolicitudAOCR",
                Action = "Crear",
                Actor = actor,
                SolicitudId = codigoSolicitud,
                RecipientEmail = recipient,
                RecipientName = operador,
                Subject = subject,
                HtmlBody = body,
                EventKey = "SOLICITUD_CREADA_" + codigoSolicitud.ToString(CultureInfo.InvariantCulture) + "_" + SanitizeForKey(recipient)
            });
        }

        public EmailWorkflowResult NotificarInspectorAsignado(SolicitudAOCR solicitud, string nombreInspector, DateTime fechaInspeccion, string actor, string detalleUrl)
        {
            if (solicitud == null || solicitud.CodigoSolicitud <= 0) return EmailWorkflowResult.Skip("Solicitud invalida.");
            var recipient = FirstNonEmpty(solicitud.CorreoRepresentanteTecnico, solicitud.Email);
            if (string.IsNullOrWhiteSpace(recipient)) return EmailWorkflowResult.Skip("Solicitud sin correo.");

            var numero = FirstNonEmpty(solicitud.NumeroSolicitud, "#" + solicitud.CodigoSolicitud.ToString(CultureInfo.InvariantCulture));
            var inspector = FirstNonEmpty(nombreInspector, "Inspector asignado");
            var subject = "AOCR - Inspector asignado " + numero;
            var body = "<p>Se asigno inspector para su solicitud AOCR.</p>"
                     + "<p><strong>Solicitud:</strong> " + HttpUtility.HtmlEncode(numero) + "</p>"
                     + "<p><strong>Inspector:</strong> " + HttpUtility.HtmlEncode(inspector) + "</p>"
                     + "<p><strong>Fecha:</strong> " + HttpUtility.HtmlEncode(fechaInspeccion.ToString("dd/MM/yyyy HH:mm", CultureInfo.InvariantCulture)) + "</p>"
                     + (!string.IsNullOrWhiteSpace(detalleUrl)
                        ? "<p><a href=\"" + HttpUtility.HtmlAttributeEncode(detalleUrl) + "\">Ver detalle</a></p>"
                        : string.Empty);

            return Dispatch(new EmailWorkflowRequest
            {
                EventCode = "INSPECTOR_ASIGNADO",
                TemplateKey = "inspector_asignado_v1",
                Controller = "Tecnico",
                Action = "AsignarInspector",
                Actor = actor,
                SolicitudId = solicitud.CodigoSolicitud,
                RecipientEmail = recipient,
                RecipientName = FirstNonEmpty(solicitud.NombreOperador, solicitud.RazonSocial, "Solicitante"),
                Subject = subject,
                HtmlBody = body,
                EventKey = "INSPECTOR_ASIGNADO_" + solicitud.CodigoSolicitud.ToString(CultureInfo.InvariantCulture) + "_" + SanitizeForKey(recipient)
            });
        }

        public EmailWorkflowResult NotificarAprobacionFinanciera(OrdenRecaudacion orden, string actor)
        {
            if (orden == null || orden.Id <= 0)
            {
                var invalidRequest = new EmailWorkflowRequest
                {
                    EventCode = "FIN_APROBADA_AS400_SOLICITANTE",
                    Controller = "Financiero",
                    Action = "AprobarYEnviarAS400",
                    Actor = actor
                };
                LogWarning("Notificacion financiera omitida: orden invalida.", invalidRequest, "EMAIL_ORDEN_INVALIDA");
                return EmailWorkflowResult.Skip("Orden invalida.");
            }

            var solicitud = ResolveSolicitud(orden);
            var solicitudId = solicitud != null && solicitud.CodigoSolicitud > 0 ? (int?)solicitud.CodigoSolicitud : orden.CodigoSolicitud;
            var recipient = ResolveEmailSolicitante(solicitud, orden);
            var numeroSolicitud = FirstNonEmpty(solicitud != null ? solicitud.NumeroSolicitud : null, solicitudId.HasValue ? solicitudId.Value.ToString(CultureInfo.InvariantCulture) : null, "N/A");
            var numeroOrden = FirstNonEmpty(orden.NumeroOrden, orden.Id.ToString(CultureInfo.InvariantCulture));
            var nombre = FirstNonEmpty(solicitud != null ? solicitud.NombreOperador : null, solicitud != null ? solicitud.RazonSocial : null, orden.Compania, "Solicitante");
            var subject = "AOCR aprobada financieramente - Solicitud " + numeroSolicitud + " / Orden " + numeroOrden;

            var request = new EmailWorkflowRequest
            {
                EventCode = "FIN_APROBADA_AS400_SOLICITANTE",
                TemplateKey = "fin_aprobada_solicitante_v2",
                Controller = "Financiero",
                Action = "AprobarYEnviarAS400",
                Actor = actor,
                OrdenId = orden.Id,
                SolicitudId = solicitudId,
                NumeroOrden = numeroOrden,
                RecipientEmail = recipient,
                RecipientName = nombre,
                Subject = subject,
                HtmlBody = "<p>Estimado/a " + HttpUtility.HtmlEncode(nombre) + ",</p><p>Su solicitud AOCR " + HttpUtility.HtmlEncode(numeroSolicitud) + " y la orden " + HttpUtility.HtmlEncode(numeroOrden) + " fueron aprobadas financieramente.</p>",
                EventKey = "FIN_APROBADA_SOL_" + (solicitudId.HasValue ? solicitudId.Value.ToString(CultureInfo.InvariantCulture) : "NA") + "_ORD_" + orden.Id.ToString(CultureInfo.InvariantCulture)
            };

            LogInfo(
                "Notificacion financiera inicio. OrdenId=" + orden.Id.ToString(CultureInfo.InvariantCulture)
                + "; SolicitudId=" + (solicitudId.HasValue ? solicitudId.Value.ToString(CultureInfo.InvariantCulture) : "N/A"),
                request,
                "EMAIL_FINANCIERO_INICIO");

            if (solicitud == null)
            {
                LogWarning(
                    "Notificacion financiera: no existe solicitud relacionada para la orden. Se aplicara fallback por datos de orden/usuario.",
                    request,
                    "EMAIL_SOLICITUD_NO_ENCONTRADA");
            }

            if (string.IsNullOrWhiteSpace(recipient))
            {
                LogWarning(
                    "Notificacion financiera omitida: correo de solicitante vacio.",
                    request,
                    "EMAIL_SOLICITANTE_SIN_CORREO");
                return EmailWorkflowResult.Skip("Solicitante sin correo.");
            }

            LogInfo(
                "Notificacion financiera preparada. Correo=" + recipient + "; Asunto=" + subject,
                request,
                "EMAIL_FINANCIERO_PREPARADA");

            return Dispatch(request);
        }

        private EmailWorkflowResult TryDirect(EmailWorkflowRequest request)
        {
            try
            {
                var send = _smtpService.EnviarAsync(
                    request.RecipientEmail.Trim(),
                    FirstNonEmpty(request.RecipientName, "Usuario"),
                    request.Subject ?? string.Empty,
                    request.HtmlBody ?? string.Empty,
                    request.AttachmentBytes,
                    request.AttachmentName).GetAwaiter().GetResult();

                if (send != null && send.Success)
                {
                    LogInfo("Email direct success. Event=" + Safe(request.EventCode) + "; Recipient=" + Safe(request.RecipientEmail), request, "EMAIL_DIRECT_OK");
                    return EmailWorkflowResult.OkDirect(send.MessageId);
                }

                var error = send != null ? send.Error : "SMTP result null";
                LogWarning("Email direct failed. Event=" + Safe(request.EventCode) + "; Error=" + Safe(error), request, "EMAIL_DIRECT_FAIL");
                return EmailWorkflowResult.Fail(error, "SMTP_DIRECT");
            }
            catch (Exception ex)
            {
                LogError("Email direct exception. Event=" + Safe(request.EventCode), ex, request, "EMAIL_DIRECT_EX");
                return EmailWorkflowResult.Fail(ex.Message, "SMTP_DIRECT");
            }
        }

        private EmailWorkflowResult TryQueue(EmailWorkflowRequest request, string previousError)
        {
            try
            {
                var eventKey = string.IsNullOrWhiteSpace(request.EventKey) ? BuildEventKey(request) : request.EventKey.Trim();
                var item = new EmailQueueItem
                {
                    Para = request.RecipientEmail.Trim(),
                    ParaNombre = FirstNonEmpty(request.RecipientName, "Usuario"),
                    Asunto = request.Subject ?? string.Empty,
                    Cuerpo = request.HtmlBody ?? string.Empty,
                    EsHtml = true,
                    Estado = "PENDIENTE",
                    OrdenId = request.SolicitudId.HasValue && request.SolicitudId.Value > 0 ? request.SolicitudId : request.OrdenId,
                    EventKey = eventKey,
                    CorrelationId = request.CorrelationId,
                    NumeroOrden = FirstNonEmpty(request.NumeroOrden, request.OrdenId.HasValue ? request.OrdenId.Value.ToString(CultureInfo.InvariantCulture) : null),
                    TipoNotificacion = request.EventCode,
                    MaxIntentos = request.MaxAttempts > 0 ? request.MaxAttempts : 3
                };

                var queueId = _queueService.EncolarAsync(item).GetAwaiter().GetResult();
                LogInfo("Email enqueued. Event=" + Safe(request.EventCode) + "; QueueId=" + queueId.ToString(CultureInfo.InvariantCulture) + "; PreviousError=" + Safe(previousError), request, "EMAIL_QUEUE_OK");
                return EmailWorkflowResult.OkQueue(queueId);
            }
            catch (Exception ex)
            {
                LogError("Email queue exception. Event=" + Safe(request.EventCode), ex, request, "EMAIL_QUEUE_EX");
                return EmailWorkflowResult.Fail(ex.Message, "QUEUE");
            }
        }

        private SolicitudAOCR ResolveSolicitud(OrdenRecaudacion orden)
        {
            int solicitudId = orden.CodigoSolicitud.HasValue ? orden.CodigoSolicitud.Value : 0;
            if (solicitudId <= 0)
            {
                try
                {
                    var pago = _ordenDao.ObtenerUltimoPagoPorOrden(orden.Id);
                    if (pago != null && pago.CodigoSolicitud > 0) solicitudId = pago.CodigoSolicitud;
                }
                catch (Exception exPago)
                {
                    _logger.LogWarning("ResolveSolicitud: no se pudo leer pago para OrdenId=" + orden.Id + "; Error=" + exPago.Message);
                }
            }

            if (solicitudId <= 0)
            {
                _logger.LogWarning("ResolveSolicitud: no se encontro SolicitudId para OrdenId=" + orden.Id + "; CodigoSolicitud=" + (orden.CodigoSolicitud.HasValue ? orden.CodigoSolicitud.Value.ToString(CultureInfo.InvariantCulture) : "NULL"));
                return null;
            }

            try
            {
                var sol = new SolicitudAOCRDAO().ObtenerPorCodigo(solicitudId);
                if (sol == null)
                {
                    _logger.LogWarning("ResolveSolicitud: ObtenerPorCodigo devolvio null. OrdenId=" + orden.Id + "; SolicitudId=" + solicitudId);
                }
                return sol;
            }
            catch (Exception exSol)
            {
                _logger.LogError("ResolveSolicitud: excepcion consultando solicitud. OrdenId=" + orden.Id + "; SolicitudId=" + solicitudId + "; Error=" + exSol.Message);
                return null;
            }
        }

        private string ResolveEmailSolicitante(SolicitudAOCR solicitud, OrdenRecaudacion orden)
        {
            // 1. campos directos de la solicitud
            var email = FirstNonEmpty(
                solicitud != null ? solicitud.CorreoRepresentanteTecnico : null,
                solicitud != null ? solicitud.Email : null,
                orden != null ? orden.Correo : null);

            if (!string.IsNullOrWhiteSpace(email))
            {
                _logger.LogInfo("ResolveEmailSolicitante: correo resuelto de campos directos. Email=" + email
                    + "; Fuente=" + (solicitud != null && !string.IsNullOrWhiteSpace(solicitud.CorreoRepresentanteTecnico) ? "solicitud.CorreoRepresentanteTecnico"
                        : solicitud != null && !string.IsNullOrWhiteSpace(solicitud.Email) ? "solicitud.Email"
                        : "orden.Correo"));
                return email;
            }

            _logger.LogWarning("ResolveEmailSolicitante: campos directos vacios."
                + " solicitud.CorreoRT=" + (solicitud != null ? (solicitud.CorreoRepresentanteTecnico ?? "NULL") : "SIN_SOLICITUD")
                + "; solicitud.Email=" + (solicitud != null ? (solicitud.Email ?? "NULL") : "SIN_SOLICITUD")
                + "; orden.Correo=" + (orden != null ? (orden.Correo ?? "NULL") : "SIN_ORDEN")
                + "; OrdenId=" + (orden != null ? orden.Id.ToString(CultureInfo.InvariantCulture) : "N/A"));

            // 2. correo del usuario relacionado
            int codigoUsuario = solicitud != null && solicitud.CodigoUsuario > 0
                ? solicitud.CodigoUsuario
                : (orden != null && orden.CodigoUsuario.HasValue ? orden.CodigoUsuario.Value : 0);

            _logger.LogInfo("ResolveEmailSolicitante: intentando desde usuario. CodigoUsuario=" + codigoUsuario
                + "; OrdenId=" + (orden != null ? orden.Id.ToString(CultureInfo.InvariantCulture) : "N/A"));

            if (codigoUsuario > 0)
            {
                try
                {
                    var usuario = UsuarioDAO.ObtenerPorId(codigoUsuario);
                    var emailUsuario = usuario != null ? usuario.Email : null;
                    if (!string.IsNullOrWhiteSpace(emailUsuario))
                    {
                        _logger.LogInfo("ResolveEmailSolicitante: correo resuelto desde usuario. CodigoUsuario=" + codigoUsuario + "; Email=" + emailUsuario);
                        return emailUsuario.Trim();
                    }
                    _logger.LogWarning("ResolveEmailSolicitante: usuario encontrado pero sin correo. CodigoUsuario=" + codigoUsuario + "; UsuarioNull=" + (usuario == null));
                }
                catch (Exception exUsr)
                {
                    _logger.LogError("ResolveEmailSolicitante: excepcion buscando usuario. CodigoUsuario=" + codigoUsuario + "; Error=" + exUsr.Message);
                }
            }
            else
            {
                _logger.LogWarning("ResolveEmailSolicitante: CodigoUsuario no disponible."
                    + " solicitud.CodigoUsuario=" + (solicitud != null ? solicitud.CodigoUsuario.ToString(CultureInfo.InvariantCulture) : "SIN_SOLICITUD")
                    + "; orden.CodigoUsuario=" + (orden != null && orden.CodigoUsuario.HasValue ? orden.CodigoUsuario.Value.ToString(CultureInfo.InvariantCulture) : "NULL"));
            }

            return null;
        }

        private static string BuildEventKey(EmailWorkflowRequest request)
        {
            var raw = Safe(request.EventCode)
                + "|" + (request.OrdenId.HasValue ? request.OrdenId.Value.ToString(CultureInfo.InvariantCulture) : "NA")
                + "|" + (request.SolicitudId.HasValue ? request.SolicitudId.Value.ToString(CultureInfo.InvariantCulture) : "NA")
                + "|" + Safe(request.RecipientEmail)
                + "|" + Safe(request.Subject);
            using (var sha1 = SHA1.Create())
            {
                var hash = sha1.ComputeHash(Encoding.UTF8.GetBytes(raw));
                var sb = new StringBuilder(hash.Length * 2);
                for (var i = 0; i < hash.Length; i++) sb.Append(hash[i].ToString("x2", CultureInfo.InvariantCulture));
                return "EMAIL_" + SanitizeForKey(request.EventCode) + "_" + sb.ToString();
            }
        }

        private void LogInfo(string message, EmailWorkflowRequest request, string errorCode)
        {
            _logger.LogInfo(message, BuildContext(request, errorCode));
            System.Diagnostics.Debug.WriteLine("[EmailWorkflowService][INFO] " + message);
        }

        private void LogWarning(string message, EmailWorkflowRequest request, string errorCode)
        {
            _logger.LogWarning(message, BuildContext(request, errorCode));
            System.Diagnostics.Debug.WriteLine("[EmailWorkflowService][WARN] " + message);
        }

        private void LogError(string message, Exception ex, EmailWorkflowRequest request, string errorCode)
        {
            var context = BuildContext(request, errorCode);
            if (ex != null)
            {
                _logger.LogError(message + " | " + ex.Message, context);
                _logger.LogError(ex, context);
                System.Diagnostics.Debug.WriteLine("[EmailWorkflowService][ERROR] " + message + " | " + ex);
            }
            else
            {
                _logger.LogError(message, context);
                System.Diagnostics.Debug.WriteLine("[EmailWorkflowService][ERROR] " + message);
            }
        }

        private static string FirstNonEmpty(params string[] values)
        {
            if (values == null) return null;
            for (var i = 0; i < values.Length; i++)
            {
                if (!string.IsNullOrWhiteSpace(values[i])) return values[i].Trim();
            }
            return null;
        }

        private LogContext BuildContext(EmailWorkflowRequest request, string errorCode)
        {
            return new LogContext
            {
                CorrelationId = request.CorrelationId,
                NumeroOrden = FirstNonEmpty(request.NumeroOrden, request.OrdenId.HasValue ? request.OrdenId.Value.ToString(CultureInfo.InvariantCulture) : null),
                CodigoSolicitud = request.SolicitudId.HasValue ? request.SolicitudId.Value.ToString(CultureInfo.InvariantCulture) : null,
                Controller = FirstNonEmpty(request.Controller, "EmailWorkflow"),
                Action = FirstNonEmpty(request.Action, request.EventCode),
                UserId = FirstNonEmpty(request.Actor, "SYSTEM"),
                ErrorCode = errorCode
            };
        }

        private static string Safe(string value)
        {
            return string.IsNullOrWhiteSpace(value) ? "N/A" : value.Trim();
        }

        private static string SanitizeForKey(string value)
        {
            if (string.IsNullOrWhiteSpace(value)) return "NA";
            var chars = value.Trim().ToUpperInvariant().ToCharArray();
            var sb = new StringBuilder(chars.Length);
            for (var i = 0; i < chars.Length; i++)
            {
                var c = chars[i];
                if ((c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_') sb.Append(c);
                else sb.Append('_');
            }
            return sb.ToString();
        }
    }
