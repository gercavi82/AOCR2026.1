    #region Procesador de Cola

    /// <summary>
    /// Procesador de cola de correos (ejecutar como background job)
    /// </summary>
    public class EmailQueueProcessor : IDisposable
    {
        private readonly IEmailQueueService _queueService;
        private readonly IEmailService _emailService;
        private readonly ILoggingService _logger;
        private readonly CancellationTokenSource _cancellationTokenSource;
        private Task _processingTask;
        private bool _disposed;
        private int _started;  // 0=no iniciado, 1=iniciado — Interlocked para evitar doble Start
        private int _stopped;  // 0=no detenido, 1=detenido — Interlocked para evitar doble Stop

        // Configuración de reintentos con backoff exponencial
        private const int DefaultMaxIntentos = 3;
        private static readonly TimeSpan[] RetryDelays = new[]
        {
            TimeSpan.FromMinutes(1),
            TimeSpan.FromMinutes(5),
            TimeSpan.FromMinutes(15)
        };

        private static readonly TimeSpan IdleDelay = TimeSpan.FromSeconds(10);
        private static readonly TimeSpan ErrorDelay = TimeSpan.FromSeconds(30);

        public EmailQueueProcessor(
            IEmailQueueService queueService,
            IEmailService emailService)
        {
            _queueService = queueService;
            _emailService = emailService;
            _logger = LoggingServiceFactory.Create();
            _cancellationTokenSource = new CancellationTokenSource();
        }

        public void Start()
        {
            if (System.Threading.Interlocked.CompareExchange(ref _started, 1, 0) != 0)
            {
                _logger.LogWarning("EmailQueueProcessor.Start() ignorado: procesador ya iniciado (doble Start prevenido).");
                return;
            }

            _logger.LogInfo(
                string.Format(
                    "EmailQueueProcessor arrancando. ThreadId={0}; Idle={1}s; ErrorRetry={2}s; MaxIntentos={3}",
                    System.Threading.Thread.CurrentThread.ManagedThreadId,
                    IdleDelay.TotalSeconds,
                    ErrorDelay.TotalSeconds,
                    DefaultMaxIntentos));

            _logger.LogInfo("Iniciando procesador de cola de correos");

            _processingTask = Task.Run(() => ProcessQueueAsync(_cancellationTokenSource.Token));

            _logger.LogInfo(
                string.Format(
                    "EmailQueueProcessor tarea de procesamiento lanzada. TaskId={0}",
                    _processingTask.Id));
        }

        public void Stop()
        {
            if (System.Threading.Interlocked.CompareExchange(ref _stopped, 1, 0) != 0)
            {
                _logger.LogWarning("EmailQueueProcessor.Stop() ignorado: procesador ya detenido (doble Stop prevenido).");
                return;
            }

            _logger.LogInfo("Deteniendo procesador de cola de correos");
            _logger.LogInfo(
                string.Format(
                    "EmailQueueProcessor iniciando shutdown. TokenCancelado={0}",
                    _cancellationTokenSource.IsCancellationRequested));

            _cancellationTokenSource.Cancel();

            try
            {
                _processingTask?.Wait(TimeSpan.FromSeconds(30));
                _logger.LogInfo("EmailQueueProcessor tarea de procesamiento terminada correctamente.");
            }
            catch (AggregateException ex) when (ex.InnerExceptions.All(e => e is TaskCanceledException || e is OperationCanceledException))
            {
                _logger.LogInfo("EmailQueueProcessor detenido por cancelacion (comportamiento esperado).");
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, new LogContext { ErrorCode = "EMAIL_QUEUE_STOP_ERROR" });
            }
        }

        private async Task ProcessQueueAsync(CancellationToken cancellationToken)
        {
            _logger.LogInfo("EmailQueueProcessor loop principal iniciado.");

            while (!cancellationToken.IsCancellationRequested)
            {
                int procesados = 0;
                int fallidos = 0;

                try
                {
                    _logger.LogInfo("EmailQueueProcessor ciclo: consultando pendientes en cola.");

                    var item = await _queueService.ObtenerSiguienteAsync();

                    if (item != null)
                    {
                        _logger.LogInfo(
                            string.Format(
                                "EmailQueueProcessor pendiente encontrado. QueueId={0}; Para={1}; Asunto={2}; Estado={3}",
                                item.Id,
                                item.Para ?? "N/A",
                                item.Asunto ?? "N/A",
                                item.Estado ?? "N/A"));

                        bool ok = await ProcessItemAsync(item);
                        if (ok) procesados++;
                        else fallidos++;

                        _logger.LogInfo(
                            string.Format(
                                "EmailQueueProcessor fin de ciclo. Procesados={0}; Fallidos={1}",
                                procesados,
                                fallidos));
                    }
                    else
                    {
                        _logger.LogInfo(
                            string.Format(
                                "EmailQueueProcessor sin pendientes. Esperando {0}s para proximo ciclo.",
                                IdleDelay.TotalSeconds));

                        await Task.Delay(IdleDelay, cancellationToken);
                    }
                }
                catch (OperationCanceledException)
                {
                    _logger.LogInfo("EmailQueueProcessor loop cancelado por token de cancelacion.");
                    break;
                }
                catch (Exception ex)
                {
                    _logger.LogError(
                        string.Format(
                            "EmailQueueProcessor excepcion en loop principal. Reintentando en {0}s. Error={1}",
                            ErrorDelay.TotalSeconds,
                            ex.Message),
                        new LogContext { ErrorCode = "EMAIL_QUEUE_LOOP_ERROR" });
                    _logger.LogError(ex, new LogContext { ErrorCode = "EMAIL_QUEUE_LOOP_ERROR" });

                    try
                    {
                        await Task.Delay(ErrorDelay, cancellationToken);
                    }
                    catch (OperationCanceledException)
                    {
                        _logger.LogInfo("EmailQueueProcessor loop cancelado durante espera de error.");
                        break;
                    }
                }
            }

            _logger.LogInfo("EmailQueueProcessor loop principal finalizado.");
        }

        private async Task<bool> ProcessItemAsync(EmailQueueItem item)
        {
            var context = new LogContext
            {
                CorrelationId = item.CorrelationId,
                NumeroOrden = item.NumeroOrden,
                ErrorCode = "EMAIL_QUEUE_ITEM"
            };

            _logger.LogInfo(
                string.Format(
                    "EmailQueueProcessor procesando item. QueueId={0}; Para={1}; Asunto={2}; TipoEvento={3}; Intento#={4}",
                    item.Id,
                    item.Para ?? "N/A",
                    item.Asunto ?? "N/A",
                    item.TipoNotificacion ?? "N/A",
                    CalcularIntentosDesdeProximoIntento(item) + 1),
                context);

            try
            {
                _logger.LogInfo(
                    string.Format("EmailQueueProcessor iniciando envio SMTP. QueueId={0}; Destinatario={1}", item.Id, item.Para ?? "N/A"),
                    context);

                byte[] adjuntoContenido = item.AdjuntoContenido;
                string adjuntoNombre = item.AdjuntoNombre;

                if ((adjuntoContenido == null || adjuntoContenido.Length == 0) &&
                    item.Adjuntos != null && item.Adjuntos.Count > 0)
                {
                    string attachmentError;
                    if (!TryLoadAttachment(item.Adjuntos[0], out adjuntoContenido, out adjuntoNombre, out attachmentError))
                    {
                        _logger.LogError(
                            string.Format(
                                "EmailQueueProcessor adjunto invalido. QueueId={0}; Error={1}. Marcando ERROR.",
                                item.Id,
                                attachmentError),
                            context);
                        await _queueService.ActualizarEstadoAsync(item.Id, "ERROR", attachmentError);
                        return false;
                    }
                }

                var result = await _emailService.EnviarAsync(
                    item.Para,
                    item.ParaNombre,
                    item.Asunto,
                    item.Cuerpo,
                    adjuntoContenido,
                    adjuntoNombre);

                if (result.Success)
                {
                    await _queueService.MarcarEnviadoAsync(item.Id, result.MessageId);
                    _logger.LogInfo(
                        string.Format(
                            "EmailQueueProcessor correo enviado. QueueId={0}; Destinatario={1}; MessageId={2}",
                            item.Id,
                            item.Para ?? "N/A",
                            result.MessageId ?? "N/A"),
                        context);
                    return true;
                }
                else
                {
                    _logger.LogWarning(
                        string.Format(
                            "EmailQueueProcessor SMTP fallo. QueueId={0}; Destinatario={1}; Error={2}",
                            item.Id,
                            item.Para ?? "N/A",
                            result.Error ?? "N/A"),
                        context);
                    await HandleFailureAsync(item, result.Error, context);
                    return false;
                }
            }
            catch (Exception ex)
            {
                _logger.LogError(
                    string.Format(
                        "EmailQueueProcessor excepcion procesando item. QueueId={0}; Destinatario={1}; Error={2}",
                        item.Id,
                        item.Para ?? "N/A",
                        ex.Message),
                    context);
                _logger.LogError(ex, context);
                await HandleFailureAsync(item, ex.Message, context);
                return false;
            }
        }

        private async Task HandleFailureAsync(EmailQueueItem item, string error, LogContext context)
        {
            int intentosEstimados = CalcularIntentosDesdeProximoIntento(item);
            int maxIntentos = item.MaxIntentos > 0 ? item.MaxIntentos : DefaultMaxIntentos;

            _logger.LogWarning(
                string.Format(
                    "EmailQueueProcessor error en item. QueueId={0}; IntentosEstimados={1}; MaxIntentos={2}; Error={3}",
                    item.Id,
                    intentosEstimados,
                    maxIntentos,
                    error ?? "N/A"),
                context);

            if (intentosEstimados >= maxIntentos)
            {
                await _queueService.ActualizarEstadoAsync(item.Id, "ERROR", error);
                _logger.LogError(
                    string.Format(
                        "EmailQueueProcessor max reintentos alcanzado. QueueId={0}; Intentos={1}; Marcado=ERROR",
                        item.Id,
                        intentosEstimados),
                    context);
            }
            else
            {
                var delayIndex = Math.Min(intentosEstimados, RetryDelays.Length - 1);
                var delay = RetryDelays[delayIndex];
                await _queueService.ReprogramarReintentoAsync(item.Id, delay);
                _logger.LogWarning(
                    string.Format(
                        "EmailQueueProcessor reintento programado. QueueId={0}; Intento={1}; ProximoIntento={2:HH:mm:ss}",
                        item.Id,
                        intentosEstimados + 1,
                        DateTime.Now.Add(delay)),
                    context);
            }
        }

        private int CalcularIntentosDesdeProximoIntento(EmailQueueItem item)
        {
            if (!item.ProximoIntento.HasValue || item.ProximoIntento.Value <= item.FechaCreacion)
                return 1;

            var tiempoTranscurrido = item.ProximoIntento.Value - item.FechaCreacion;

            if (tiempoTranscurrido.TotalMinutes < 2)
                return 1;
            else if (tiempoTranscurrido.TotalMinutes < 10)
                return 2;
            else
                return 3;
        }

        private bool TryLoadAttachment(
            EmailAttachmentItem attachment,
            out byte[] content,
            out string fileName,
            out string error)
        {
            content = null;
            fileName = null;
            error = null;

            if (attachment == null)
            {
                error = "Adjunto no especificado.";
                return false;
            }

            var resolvedPath = ResolveAttachmentPath(attachment.FilePath);
            if (string.IsNullOrWhiteSpace(resolvedPath))
            {
                error = "Adjunto sin ruta configurada.";
                return false;
            }

            if (!File.Exists(resolvedPath))
            {
                error = string.Format("No se encontró el archivo adjunto: {0}", resolvedPath);
                return false;
            }

            try
            {
                content = File.ReadAllBytes(resolvedPath);
                if (content == null || content.Length == 0)
                {
                    error = string.Format("El archivo adjunto está vacío: {0}", resolvedPath);
                    return false;
                }

                fileName = !string.IsNullOrWhiteSpace(attachment.FileName)
                    ? attachment.FileName
                    : Path.GetFileName(resolvedPath);

                return true;
            }
            catch (Exception ex)
            {
                error = "Error leyendo adjunto: " + ex.Message;
                return false;
            }
        }

        private string ResolveAttachmentPath(string filePath)
        {
            if (string.IsNullOrWhiteSpace(filePath))
            {
                return null;
            }

            try
            {
                if (Path.IsPathRooted(filePath))
                {
                    return Path.GetFullPath(filePath);
                }

                if (filePath.StartsWith("~"))
                {
                    var mapped = HostingEnvironment.MapPath(filePath);
                    if (!string.IsNullOrWhiteSpace(mapped))
                    {
                        return Path.GetFullPath(mapped);
                      }
                }

                var cleaned = filePath.TrimStart('~', '/', '\\').Replace('/', Path.DirectorySeparatorChar);
                return Path.GetFullPath(Path.Combine(AppDomain.CurrentDomain.BaseDirectory, cleaned));
            }
            catch
            {
                return null;
            }
        }

        public void Dispose()
        {
            if (!_disposed)
            {
                _disposed = true;
                Stop();
                _cancellationTokenSource.Dispose();
            }
        }
    }

