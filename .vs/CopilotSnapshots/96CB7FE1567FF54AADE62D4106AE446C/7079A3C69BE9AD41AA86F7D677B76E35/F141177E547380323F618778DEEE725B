@inherits System.Web.Mvc.WebViewPage<CapaPresentacion.Models.ViewModels.OrdenRecaudacionViewModel>
@using CapaModelo
@using System.Web.Mvc
@using System.Web.Mvc.Html
@using System.Net
@{
    ViewBag.Title = "Detalle de Orden de recaudación";
    Layout = "~/Views/Shared/_LayoutAOCR.cshtml";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <h4>@ViewBag.Title</h4>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-3">Número de Orden</dt>
                        <dd class="col-sm-9">@Model.NumeroOrden</dd>

                        <dt class="col-sm-3">Fecha de Creación</dt>
                        <dd class="col-sm-9">@Model.FechaCreacion.ToString("dd/MM/yyyy")</dd>

                        <dt class="col-sm-3">Estado</dt>
                        <dd class="col-sm-9">@Html.Encode(WebUtility.HtmlDecode(Model.Estado))</dd>

                        <dt class="col-sm-3">Subtotal</dt>
                        <dd class="col-sm-9">@Model.Subtotal.ToString("N2") USD</dd>

                        <dt class="col-sm-3">Administración</dt>
                        <dd class="col-sm-9">@Model.Admin.ToString("N2") USD</dd>

                        <dt class="col-sm-3">Total</dt>
                        <dd class="col-sm-9">@Model.Total.ToString("N2") USD</dd>
                    </dl>

                    <a href="@Url.Action("MisOrdenes", "Orden")" class="btn btn-secondary">Volver a Mis Órdenes</a>
                </div>
            </div>
        </div>
    </div>
</div>


