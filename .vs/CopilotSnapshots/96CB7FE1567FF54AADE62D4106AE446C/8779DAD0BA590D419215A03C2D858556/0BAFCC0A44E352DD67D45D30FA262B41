                                        <td>@Html.Encode(item.EstadoAnterior)</td>
                                        <td>@Html.Encode(item.EstadoNuevo)</td>
                                        <td>@Html.Raw(System.Web.HttpUtility.HtmlEncode(item.Observaciones).Replace("\n", "<br/>"))</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
