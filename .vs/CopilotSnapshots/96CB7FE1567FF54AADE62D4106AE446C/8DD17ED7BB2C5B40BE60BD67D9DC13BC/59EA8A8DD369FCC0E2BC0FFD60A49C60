@inherits System.Web.Mvc.WebViewPage<List<CapaPresentacion.Models.OrdenValidacionFinancieraVM>>
@using CapaModelo
@using CapaNegocio.Services
@using System.Web.Mvc
@using System.Web.Mvc.Html

@{
    ViewBag.Title = "Dashboard Financiero";
    var as400FacturacionHabilitada = FacturacionAS400Service.IsEnabled();
}

<style>
    .acciones-cell {
        min-width: 150px;
    }

    .acciones-orden {
        display: flex;
        align-items: center;
        gap: .35rem;
        flex-wrap: wrap;
    }

    .acciones-orden form {
        margin: 0;
    }

    .btn-accion {
        width: 32px;
        height: 32px;
        padding: 0;
        border-radius: 8px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        line-height: 1;
    }

    .btn-pdf {
        width: 30px;
        height: 30px;
        padding: 0;
        border-radius: 8px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }
</style>

<h2>Financiero – Validación de Órdenes</h2>
<hr />

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}
@if (ViewBag.SinResultadosConFiltro == true)
{
    <div class="alert alert-warning">
        No se encontraron órdenes con el estado seleccionado. Se muestran todas las órdenes disponibles (Total: @ViewBag.TotalSinFiltro).
    </div>
}

<div class="row mb-3">
    <div class="col-md-12 text-end">
        <button type="button" class="btn btn-outline-secondary btn-sm" id="btnHealthPostgres">
            <i class="fas fa-database"></i> Probar PostgreSQL/DB2
        </button>
        <span id="healthResult" class="ms-2 text-muted"></span>
    </div>
</div>

<div class="d-flex justify-content-end mb-3">
    <form method="get" class="d-flex align-items-center gap-2">
        <label class="mb-0 text-muted">Estado:</label>
        <select name="estado" class="form-select form-select-sm" onchange="this.form.submit()">
<option value="PROCESADA" @(ViewBag.EstadoFiltro == "PROCESADA" ? "selected" : "")>En revisión</option>
<option value="PENDIENTE" @(ViewBag.EstadoFiltro == "PENDIENTE" ? "selected" : "")>Pendiente</option>
<option value="FACTURADA" @(ViewBag.EstadoFiltro == "FACTURADA" ? "selected" : "")>Facturada</option>
<option value="COMPLETADA" @(ViewBag.EstadoFiltro == "COMPLETADA" ? "selected" : "")>Completada</option>
<option value="ANULADA" @(ViewBag.EstadoFiltro == "ANULADA" ? "selected" : "")>Anulada</option>
<option value="TODAS" @(ViewBag.EstadoFiltro == "TODAS" ? "selected" : "")>Todas</option>
        </select>
    </form>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>#</th>
            <th>Orden</th>
            <th>Compañía</th>
            <th>Fecha</th>
            <th>Monto</th>
            <th>Estado</th>
            <th>FR3</th>
            <th>Comprobante</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            int i = 1;
            foreach (var item in Model)
            {
                var orden = item.Orden;
                var pago = item.Pago;
                var estadoNorm = orden != null ? ((orden.Estado ?? "").Trim().ToUpperInvariant().Replace(" ", "_")) : "";
                var esPendiente = !string.IsNullOrWhiteSpace(estadoNorm) && estadoNorm.StartsWith("PENDIENTE");
                var puedeGestionarPorEstado = (estadoNorm == "PROCESADA" || esPendiente);
        <tr>
            <td>@Html.Encode(i)</td>
            <td>@Html.Encode(orden != null ? orden.NumeroOrden : "-")</td>
            <td>@Html.Encode(orden != null ? (orden.NombreContribuyente ?? orden.Compania) : "-")</td>
            <td>@Html.Encode(orden != null ? orden.FechaCreacion.ToString("dd/MM/yyyy") : "")</td>
            <td>@Html.Encode(orden != null ? orden.Total.ToString("N2") : "0.00")</td>
            <td>@Html.Encode(orden != null ? orden.Estado : "")</td>
            <td>
                @if (!string.IsNullOrWhiteSpace(item.Fr3Numero))
                {
                    <span class="badge bg-success">@Html.Encode(item.Fr3Numero)</span>
                }
                else if (!string.IsNullOrWhiteSpace(item.Fr3Estado))
                {
                    var cssFr3 = item.Fr3Estado.Equals("FR3_ERROR", StringComparison.OrdinalIgnoreCase) ? "bg-danger" : "bg-secondary";
                    <span class="badge @cssFr3">@Html.Encode(item.Fr3Estado)</span>
                    if (!string.IsNullOrWhiteSpace(item.Fr3Error))
                    {
                        var fr3ErrorDisplay = System.Web.HttpUtility.HtmlDecode(item.Fr3Error);
                        <div><small class="text-danger">@fr3ErrorDisplay</small></div>
                    }
                }
                else
                {
                    <span class="text-muted">Pendiente</span>
                }
            </td>
            <td>
                @if (orden != null)
                {
                    <a href="@Url.Action("DescargarPdf", "OrdenRecaudacion", new { id = orden.Id })"
                       target="_blank"
                       class="btn btn-outline-secondary btn-sm btn-pdf"
                       title="Ver PDF de la orden">
                        <i class="fas fa-file-pdf"></i>
                    </a>
                }
                else
                {
                    <span class="text-muted">Sin orden</span>
                }
            </td>
            <td class="acciones-cell">
                @if (orden != null)
                {
                    <div class="acciones-orden">
                        <a href="@Url.Action("Detalles", "OrdenRecaudacion", new { id = orden.Id })"
                           class="btn btn-outline-primary btn-sm btn-accion"
                           title="Ver detalles">
                            <i class="fas fa-eye"></i>
                        </a>

                        @if (puedeGestionarPorEstado)
                        {
                            <button type="button"
                                    class="btn btn-success btn-sm btn-accion js-abrir-modal-factura"
                                    title="Aprobar pago"
                                    data-orden-id="@orden.Id"
                                    data-pago-id="@(pago != null ? pago.CodigoPago.ToString() : string.Empty)"
                                    data-numero-orden="@Html.Encode(orden.NumeroOrden)"
                                    data-monto="@((orden.Total).ToString("0.00", System.Globalization.CultureInfo.InvariantCulture))">
                                <i class="fas fa-check"></i>
                            </button>

                            <button class="btn btn-danger btn-sm btn-accion" type="button"
                                    title="Rechazar"
                                    data-bs-toggle="modal" data-bs-target="#modalRechazo-@orden.Id">
                                <i class="fas fa-times"></i>
                            </button>
                            <div class="modal fade" id="modalRechazo-@orden.Id" tabindex="-1" aria-hidden="true">
                                <div class="modal-dialog">
                                    <div class="modal-content">
                                        <div class="modal-header">
                                            <h5 class="modal-title">Rechazar Orden</h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                        </div>
                                        <form method="post" action="@Url.Action("RechazarOrden", "Financiero")">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@orden.Id" />
                                            <div class="modal-body">
                                                <label class="form-label">Motivo</label>
                                                <textarea name="motivo" class="form-control" rows="3" required></textarea>
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                                                <button type="submit" class="btn btn-danger">Rechazar</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        }

                        @if (item.PuedeReintentarFr3)
                        {
                            <button type="button"
                                    class="btn btn-warning btn-sm btn-accion js-retry-fr3"
                                    title="Reintentar FR3"
                                    data-orden-id="@orden.Id">
                                <i class="fas fa-sync"></i>
                            </button>
                        }
                    </div>
                }
            </td>
        </tr>
                i++;
            }
        }
        else
        {
            <tr>
                <td colspan="9" class="text-center">
                    No hay registros para el estado seleccionado.
                </td>
            </tr>
        }
    </tbody>
</table>

<div class="modal fade" id="modalAprobarPagoFactura" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Aprobar y Enviar AS400</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <form id="formAprobarPagoFactura" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="factura_orden_id" name="ordenId" />
                <div class="modal-body">
                    <div class="mb-3">
                        <small class="text-muted">Orden:</small>
                        <div><strong id="factura_numero_orden">-</strong></div>
                    </div>
                    <div class="mb-3">
                        <small class="text-muted">Monto:</small>
                        <div><strong id="factura_monto_orden">-</strong></div>
                    </div>

                    <div id="facturaModalAlert" class="alert d-none" role="alert"></div>

                    <div class="alert alert-info py-2" role="alert">
                        <i class="fas fa-info-circle me-1"></i>
                        Se aprobará la orden y se enviará la facturación FR3 al AS400.
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" id="btnAprobarConFactura" class="btn btn-success">
                        <i class="fas fa-paper-plane me-1"></i>Enviar AS400
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
(function () {
    var modalElement = document.getElementById('modalAprobarPagoFactura');
    if (!modalElement || !window.bootstrap) {
        return;
    }

    var modal = new bootstrap.Modal(modalElement);
    var form = document.getElementById('formAprobarPagoFactura');
    var alertBox = document.getElementById('facturaModalAlert');
    var submitButton = document.getElementById('btnAprobarConFactura');
    var numeroOrdenLabel = document.getElementById('factura_numero_orden');
    var montoOrdenLabel = document.getElementById('factura_monto_orden');
    var inputOrdenId = document.getElementById('factura_orden_id');
    var tokenInput = form ? form.querySelector('input[name="__RequestVerificationToken"]') : null;
    var isSubmitting = false;

    if (!form || !alertBox || !submitButton) {
        return;
    }

    if (form.dataset.facturaSubmitBound === '1') {
        return;
    }
    form.dataset.facturaSubmitBound = '1';

    function showAlert(type, message) {
        alertBox.className = 'alert alert-' + type;
        alertBox.textContent = message;
        alertBox.classList.remove('d-none');
    }

    function clearAlert() {
        alertBox.className = 'alert d-none';
        alertBox.textContent = '';
    }

    function setSubmitting(val) {
        submitButton.disabled = val;
        submitButton.innerHTML = val
            ? '<i class="fas fa-spinner fa-spin me-1"></i>Procesando...'
            : '<i class="fas fa-paper-plane me-1"></i>Enviar AS400';
    }

    function setInFlight(value) {
        isSubmitting = value === true;
        setSubmitting(isSubmitting);
    }

    function getCsrfToken() {
        if (tokenInput && tokenInput.value) {
            return tokenInput.value;
        }

        var layoutTokenInput = document.querySelector('#__AjaxAntiForgeryForm input[name="__RequestVerificationToken"]');
        if (layoutTokenInput && layoutTokenInput.value) {
            return layoutTokenInput.value;
        }

        var anyTokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
        return anyTokenInput && anyTokenInput.value ? anyTokenInput.value : '';
    }

    function getCookieValue(name) {
        if (!name || !document.cookie) {
            return '';
        }

        var encodedName = encodeURIComponent(name) + '=';
        var rawCookies = document.cookie.split(';');
        for (var i = 0; i < rawCookies.length; i++) {
            var cookie = rawCookies[i].trim();
            if (cookie.indexOf(encodedName) === 0) {
                return decodeURIComponent(cookie.substring(encodedName.length));
            }
        }
        return '';
    }

    function getCsrfCookieToken() {
        var preferredNames = ['__AOCR_RequestVerificationToken', '__RequestVerificationToken'];
        for (var i = 0; i < preferredNames.length; i++) {
            var preferredValue = getCookieValue(preferredNames[i]);
            if (preferredValue) {
                return preferredValue;
            }
        }

        if (!document.cookie) {
            return '';
        }

        var rawCookies = document.cookie.split(';');
        for (var j = 0; j < rawCookies.length; j++) {
            var part = rawCookies[j].trim();
            var separator = part.indexOf('=');
            if (separator <= 0) {
                continue;
            }

            var key = decodeURIComponent(part.substring(0, separator));
            if (/RequestVerificationToken/i.test(key)) {
                return decodeURIComponent(part.substring(separator + 1));
            }
        }
        return '';
    }

    function buildAjaxHeaders(csrfToken) {
        var headers = {
            'X-Requested-With': 'XMLHttpRequest',
            'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
            'Accept': 'application/json, text/plain, */*'
        };

        if (!csrfToken) {
            return headers;
        }

        var cookieToken = getCsrfCookieToken();
        var headerToken = cookieToken ? (cookieToken + ':' + csrfToken) : csrfToken;
        headers['RequestVerificationToken'] = headerToken;
        headers['__RequestVerificationToken'] = csrfToken;
        return headers;
    }

    function buildFormBody(values) {
        var params = new URLSearchParams();
        Object.keys(values || {}).forEach(function (key) {
            params.append(key, values[key] == null ? '' : String(values[key]));
        });
        return params.toString();
    }

    function openModalFromButton(button) {
        var ordenId = button.getAttribute('data-orden-id') || '';
        var numeroOrden = button.getAttribute('data-numero-orden') || '-';
        var monto = button.getAttribute('data-monto') || '';

        form.reset();
        inputOrdenId.value = ordenId;
        numeroOrdenLabel.textContent = numeroOrden;
        montoOrdenLabel.textContent = monto ? ('$' + monto) : '-';

        clearAlert();
        setInFlight(false);
        modal.show();
    }

    if (!document.body.dataset.facturaModalClickBound) {
        document.body.dataset.facturaModalClickBound = '1';
        document.addEventListener('click', function (event) {
            var button = event.target.closest('.js-abrir-modal-factura');
            if (!button) {
                return;
            }

            if (isSubmitting) {
                return;
            }

            event.preventDefault();
            openModalFromButton(button);
        });
    }

    form.addEventListener('submit', function (event) {
        event.preventDefault();

        if (isSubmitting) {
            return;
        }

        clearAlert();
        setInFlight(true);
        var shouldUnlock = true;
        var ordenId = (inputOrdenId.value || '').trim();
        if (!/^\d+$/.test(ordenId)) {
            shouldUnlock = true;
            setInFlight(false);
            showAlert('danger', 'No se pudo identificar la orden. Cierre y vuelva a abrir el modal.');
            return;
        }

        var csrfToken = getCsrfToken();
        if (!csrfToken) {
            shouldUnlock = true;
            setInFlight(false);
            showAlert('danger', 'La sesion expiro. Recargue la pagina e intente nuevamente.');
            return;
        }

        var actionUrl = '@Url.Action("AprobarYEnviarAS400", "Financiero")';
        var body = buildFormBody({
            ordenId: ordenId,
            id: ordenId,
            __RequestVerificationToken: csrfToken
        });

        fetch(actionUrl, {
            method: 'POST',
            body: body,
            credentials: 'same-origin',
            headers: buildAjaxHeaders(csrfToken)
        })
        .then(function (response) {
            return response.text().then(function (text) {
                var payload = null;
                try {
                    payload = text ? JSON.parse(text) : null;
                } catch (e) {
                    payload = null;
                }
                return { response: response, payload: payload, rawText: text };
            });
        })
        .then(function (result) {
            var payload = result.payload || {};
            if (!result.response.ok || payload.ok !== true) {
                var errorMessage = payload.message || '';
                if (!errorMessage && result.rawText) {
                    errorMessage = result.rawText.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();
                }
                if (!errorMessage) {
                    errorMessage = 'Error al enviar a AS400 (HTTP ' + result.response.status + ').';
                }
                var httpError = new Error(errorMessage);
                httpError.httpStatus = result.response.status;
                throw httpError;
            }

            var finalMessage = payload.warning
                ? (payload.message + ' ' + payload.warning)
                : payload.message;
            showAlert('success', finalMessage || 'Enviado a AS400 correctamente.');
            shouldUnlock = false;

            setTimeout(function () {
                modal.hide();
                window.location.reload();
            }, 700);
        })
        .catch(function (error) {
            var message = error && error.message ? error.message : 'No se pudo completar la operación.';
            if (error && error.httpStatus === 400 && /bad request|antifals|forgery|token/i.test(message)) {
                showAlert('danger', 'La sesion o el token de seguridad expiraron. Se recargara la pagina para reintentar.');
                setTimeout(function () { window.location.reload(); }, 900);
                return;
            }
            showAlert('danger', message);
        })
        .finally(function () {
            if (shouldUnlock) {
                setInFlight(false);
            }
        });
    });

    document.addEventListener('click', function (event) {
        var retryButton = event.target.closest('.js-retry-fr3');
        if (!retryButton) {
            return;
        }

        event.preventDefault();
        var ordenId = retryButton.getAttribute('data-orden-id');
        if (!ordenId || !/^\d+$/.test(String(ordenId).trim())) {
            return;
        }

        if (!confirm('¿Reintentar generación FR3 para esta orden?')) {
            return;
        }

        retryButton.disabled = true;
        var csrfToken = getCsrfToken();
        if (!csrfToken) {
            retryButton.disabled = false;
            alert('La sesion expiro. Recargue la pagina e intente nuevamente.');
            return;
        }

        var body = buildFormBody({
            ordenId: String(ordenId).trim(),
            id: String(ordenId).trim(),
            __RequestVerificationToken: csrfToken
        });

        fetch('@Url.Action("ReintentarFr3", "Financiero")', {
            method: 'POST',
            body: body,
            credentials: 'same-origin',
            headers: buildAjaxHeaders(csrfToken)
        })
        .then(function (r) {
            return r.text().then(function (t) {
                try { return JSON.parse(t); } catch (e) { return { ok: false, message: t || 'Error no controlado.' }; }
            });
        })
        .then(function (payload) {
            if (!payload || payload.ok !== true) {
                throw new Error(payload && payload.message ? payload.message : 'No se pudo reintentar FR3.');
            }
            alert(payload.message || 'FR3 reintentado correctamente.');
            window.location.reload();
        })
        .catch(function (e) {
            alert(e && e.message ? e.message : 'Error al reintentar FR3.');
        })
        .finally(function () {
            retryButton.disabled = false;
        });
    });

    var btnHealth = document.getElementById('btnHealthPostgres');
    var healthResult = document.getElementById('healthResult');
    if (btnHealth && healthResult) {
        btnHealth.addEventListener('click', function () {
            btnHealth.disabled = true;
            healthResult.className = 'ms-2 text-muted';
            healthResult.textContent = 'Validando...';

            fetch('@Url.Action("HealthFinanciero", "Financiero")', { credentials: 'same-origin' })
                .then(function (r) { return r.json(); })
                .then(function (payload) {
                    if (payload && payload.ok) {
                        healthResult.className = 'ms-2 text-success';
                        healthResult.textContent = 'PostgreSQL y DB2: OK';
                    } else {
                        var db2Msg = payload && payload.db2 ? (payload.db2.message || 'DB2 no disponible') : 'Error de health check';
                        healthResult.className = 'ms-2 text-danger';
                        healthResult.textContent = 'Error: ' + db2Msg;
                    }
                })
                .catch(function () {
                    healthResult.className = 'ms-2 text-danger';
                    healthResult.textContent = 'No se pudo ejecutar health check.';
                })
                .finally(function () {
                    btnHealth.disabled = false;
                });
        });
    }
})();
</script>
}
