@inherits System.Web.Mvc.WebViewPage
@using CapaModelo
@using System.Web.Mvc
@using System.Web.Mvc.Html
@{
    ViewBag.Title = "Operador";
    Layout = "~/Views/Shared/_LayoutAOCR.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="@Url.Content("~/Content/css/dgac-theme.css")" />
}

<div class="aocr-module-header">
    <div class="aocr-module-header-left">
        <h2 class="aocr-module-header-title">Tablero de Control</h2>
        <p class="aocr-module-header-subtitle">Gestión de Certificados AOCR</p>
    </div>
    <div class="aocr-module-header-right">
        <div class="btn-group">
            <button type="button"
                    class="btn-aocr-primary dropdown-toggle"
                    data-bs-toggle="dropdown"
                    aria-expanded="false">
                <i class="fas fa-plus"></i> Nueva Solicitud
            </button>
            <div class="dropdown-menu dropdown-menu-end aocr-dropdown-menu">
                <div class="aocr-dropdown-header">Seleccione Trámite</div>
                <a id="btnEmisionAOCR" class="dropdown-item" href="#">
                    <i class="fas fa-file-alt text-primary me-2"></i> Emisión AOCR
                </a>
                <a class="dropdown-item" href="@Url.Action("Modificacion", "Operador")">
                    <i class="fas fa-edit text-info me-2"></i> Modificación
                </a>
                <div class="dropdown-divider"></div>
                <a class="dropdown-item" href="/Ambitos/Formulario_Actualizacion?oidSol=-1">
                    <i class="fas fa-sync text-warning me-2"></i> Renovación
                </a>
            </div>
        </div>
    </div>
</div>

<section class="content pt-4 px-3">
    <div class="container-fluid">

        <div class="aocr-toolbar aocr-action-toolbar mb-3">
            <div class="aocr-toolbar-left">
                <div class="aocr-filter-tabs" id="filterContainer">
                    <div class="aocr-filter-tab filter-tab active" data-filter="all">Todos</div>
                    <div class="aocr-filter-tab filter-tab" data-filter="tramite"><i class="fas fa-hourglass-half me-1"></i> En Trámite</div>
                    <div class="aocr-filter-tab filter-tab" data-filter="aprobado"><i class="fas fa-check-circle me-1"></i> Aprobados</div>
                    <div class="aocr-filter-tab filter-tab" data-filter="observado"><i class="fas fa-exclamation-circle me-1"></i> Observados</div>
                </div>
            </div>
            <div class="aocr-toolbar-right">
                <div class="aocr-search-bar" style="min-width:260px;">
                    <i class="fas fa-search"></i>
                    <input type="text" id="searchInput" placeholder="Buscar solicitud..." />
                </div>
            </div>
        </div>

        <div class="aocr-table-container">
            <table id="tablaSolicitudes" class="table table-dgac mb-0 text-nowrap w-100">
                <thead>
                    <tr>
                        <th style="width:60px;">ID</th>
                        <th>Fecha</th>
                        <th>Tipo</th>
                        <th class="text-start">Compañía</th>
                        <th class="text-start">Inspector</th>
                        <th>Estado</th>
                        <th class="text-end">Viáticos</th>
                        <th style="width:80px;">Acción</th>
                    </tr>
                </thead>
                <tbody id="cuerpoTabla"></tbody>
            </table>
            <div id="noResults" class="aocr-no-results" style="display:none;">
                <i class="fas fa-search"></i>
                <p class="mb-0">No se encontraron resultados para la búsqueda.</p>
            </div>
        </div>

    </div>
</section>

<!-- Modal para crear/editar solicitud AOCR (solo se declara aquí porque el layout no lo incluye) -->
<div class="modal fade" id="modalFormulario" tabindex="-1" aria-labelledby="modalFormularioLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="modalFormularioLabel">
                    <i class="bi bi-clipboard-check me-2"></i> Solicitud AOCR
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0" id="contenidoModal">
                <div class="d-flex flex-column align-items-center justify-content-center py-5">
                    <div class="spinner-border text-primary mb-3" role="status"></div>
                    <p class="text-muted mb-0">Cargando formulario...</p>
                </div>
            </div>
        </div>
    </div>
  </div>

@section scripts {
    <script>
    $(document).ready(function () {

        // Abrir modal de inmediato si llega con ?abrir=nueva
        const urlParams = new URLSearchParams(window.location.search);
        if (urlParams.get('abrir') === 'nueva') {
            setTimeout(function () { cargarFormulario(null); }, 150);
        }

        // Variable global para almacenar datos
        var datosGlobales = [];

        // Cargar datos reales desde la base de datos
        cargarSolicitudesDesdeDB();

        function cargarSolicitudesDesdeDB() {
            $.ajax({
                url: '@Url.Action("ObtenerMisSolicitudes", "SolicitudAOCR")',
                type: 'GET',
                dataType: 'json',
                success: function(response) {
                    if (response.success) {
                        datosGlobales = response.data;
                        renderTable(datosGlobales);
                    } else {
                        console.error('Error al cargar solicitudes:', response.message);
                        // Mostrar mensaje de error en la tabla de forma segura
                        var $row = $('<tr>');
                        var $cell = $('<td>').attr('colspan', 8).addClass('text-center text-danger py-4');
                        $cell.append($('<i>').addClass('bi bi-exclamation-triangle h3'));
                        $cell.append($('<p>').text(response.message || 'Error al cargar solicitudes'));
                        $row.append($cell);
                        $('#cuerpoTabla').empty().append($row);
                    }
                },
                error: function(xhr, status, error) {
                    console.error('Error AJAX:', error);
                    var $row = $('<tr>');
                    var $cell = $('<td>').attr('colspan', 8).addClass('text-center text-danger py-4');
                    $cell.append($('<i>').addClass('bi bi-x-circle h3'));
                    $cell.append($('<p>').text('Error de conexión. Por favor, recargue la página.'));
                    $row.append($cell);
                    $('#cuerpoTabla').empty().append($row);
                }
            });
        }

        $('.filter-tab').click(function() {
            $('.filter-tab').removeClass('active');
            $(this).addClass('active');
            filtrarDatos();
        });

        $('#searchInput').on('keyup', filtrarDatos);

        function filtrarDatos() {
            var filtro = $('.filter-tab.active').data('filter');
            var texto = ($('#searchInput').val() || '').toLowerCase();

            var resultados = datosGlobales.filter(function(item) {
                var matchEstado = (filtro === 'all') || (item.cat === filtro);
                var matchTexto = (item.comp || '').toLowerCase().includes(texto) || item.id.toString().includes(texto);
                return matchEstado && matchTexto;
            });

            renderTable(resultados);
        }

        function renderTable(datos) {
            if (!datos || datos.length === 0) {
                $('#cuerpoTabla').empty();
                $('#noResults').show();
                return;
            }
            $('#noResults').hide();

            // Build rows using safe DOM creation instead of template literals with HTML
            var $tbody = $('#cuerpoTabla');
            $tbody.empty();

            $.each(datos, function (i, item) {
                var badgeClass = 'bg-tramite';
                if (item.cat === 'aprobado') badgeClass = 'bg-aprobado';
                if (item.cat === 'observado') badgeClass = 'bg-observado';

                var $tr = $('<tr>');
                $tr.append($('<td>').addClass('text-center fw-bold text-primary').text(String(item.id)));
                $tr.append($('<td>').addClass('text-center').text(String(item.fecha)));
                $tr.append($('<td>').addClass('text-center').append($('<span>').addClass('badge text-bg-light border').text(String(item.tipo))));
                $tr.append($('<td>').addClass('text-start ps-4 fw-bold text-dark').text(String(item.comp)));
                $tr.append($('<td>').addClass('text-start ps-4 text-muted small').text(String(item.insp)));
                $tr.append($('<td>').addClass('text-center').append($('<span>').addClass('badge-pill-custom ' + badgeClass).text(String(item.st))));
                $tr.append($('<td>').addClass('text-end pe-4 fw-bold').css('font-family','monospace').text('$ ' + Number(item.viat).toFixed(2)));

                var $btn = $('<a>').addClass('btn btn-sm btn-outline-primary')
                    .attr('title','Ver Detalle')
                    .attr('href', '@Url.Action("Detalle", "SolicitudAOCR")/' + Number(item.id))
                    .css({ display: 'inline-flex', alignItems: 'center', gap: '4px' });
                $btn.append($('<i>').addClass('fas fa-eye'));

                $tr.append($('<td>').addClass('text-center').append($btn));

                $tbody.append($tr);
            });
        }

        $('#btnEmisionAOCR').on('click', function (e) {
            e.preventDefault();
            cargarFormulario(null);
        });

        window.consultarSolicitud = function (id) {
            cargarFormulario(id);
        };

        function cargarFormulario(idSolicitud) {
            // Modal está en el Layout (BS5)
            const modalEl = document.getElementById('modalFormulario');
            const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
            modal.show();

            $('#contenidoModal').html(`
                <div class="d-flex flex-column align-items-center justify-content-center h-100 py-5">
                    <div class="spinner-border text-primary mb-3" role="status"></div>
                    <h6 class="text-secondary fw-bold">Cargando formulario...</h6>
                </div>
            `);

            $.ajax({
                url: '@Url.Action("FormularioEmisionAOCR", "SolicitudAOCR")',
                type: 'GET',
                data: { oid: idSolicitud },
                success: function (data) {
                    $('#contenidoModal').hide().html(data).fadeIn(200);
                },
                error: function (xhr) {
                    $('#contenidoModal').html('<div class="alert alert-danger m-3">Error de conexión</div>');
                    console.error(xhr.responseText);
                }
            });
        }
    });
    </script>
}


