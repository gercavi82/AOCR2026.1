/*
 * aocr-institucional.css
 * Sistema Visual Institucional AOCR - DGAC Ecuador
 * Versión 1.0
 */

/* ============================================================
   VARIABLES RAÍZ
   ============================================================ */
:root {
    --aocr-primary:      #0f4d7a;
    --aocr-secondary:    #0f6a7f;
    --aocr-accent:       #1f7ea8;
    --aocr-surface:      #ffffff;
    --aocr-surface-soft: #f4f8fb;
    --aocr-border:       #dbe5ee;
    --aocr-text:         #17324a;
    --aocr-muted:        #627b90;
    --aocr-success:      #1f6a3a;
    --aocr-warning:      #8a6500;
    --aocr-danger:       #a22834;
    --aocr-info:         #194c93;
    --aocr-shadow-sm:    0 6px 16px rgba(13,46,69,0.08);
    --aocr-shadow-md:    0 14px 28px rgba(13,46,69,0.13);
    --aocr-radius-sm:    10px;
    --aocr-radius-md:    14px;
    --aocr-radius-lg:    18px;
}

/* ============================================================
   A. ESTRUCTURA GENERAL
   ============================================================ */
.aocr-main-wrapper,
.content-wrapper {
    background: linear-gradient(180deg, #f7fbff 0%, #f2f7fb 100%);
}

.aocr-page,
.aocr-shell {
    padding: 0.35rem 0 1.2rem;
}

.aocr-content-shell {
    background: transparent;
}

.aocr-section {
    margin-bottom: 1rem;
}

.aocr-card,
.aocr-content-card,
.aocr-section-card,
.aocr-form-card,
.aocr-table-card,
.aocr-panel-detail {
    background: var(--aocr-surface);
    border: 1px solid var(--aocr-border);
    border-radius: var(--aocr-radius-md);
    box-shadow: var(--aocr-shadow-sm);
}

.aocr-card-soft,
.aocr-empty {
    background: var(--aocr-surface-soft);
    border: 1px solid #e8eff5;
    border-radius: var(--aocr-radius-md);
}

.aocr-card-bordered {
    background: var(--aocr-surface);
    border: 1px solid #cfdcea;
    border-radius: var(--aocr-radius-md);
}

.aocr-content-card > .card-body,
.aocr-section-card > .card-body,
.aocr-form-card > .card-body,
.aocr-table-card > .card-body,
.aocr-card > .card-body {
    padding: 1.15rem;
}

.aocr-section-title,
.aocr-form-section-title {
    color: var(--aocr-primary);
    font-size: 1.05rem;
    font-weight: 700;
    margin-bottom: 0.9rem;
}

.aocr-form-section {
    margin-bottom: 1.1rem;
}

.aocr-field-label,
.aocr-form-card .form-label {
    font-size: 0.82rem;
    color: #32556f;
    font-weight: 700;
    margin-bottom: 0.35rem;
}

.aocr-field-help {
    font-size: 0.78rem;
    color: var(--aocr-muted);
}

.aocr-summary-strip {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
    gap: 0.75rem;
}

/* ============================================================
   B. BREADCRUMB / PAGE HEADER
   ============================================================ */
.aocr-page-header {
    background: transparent;
    padding: 0.35rem 0 0.25rem;
}

.aocr-page-title {
    color: var(--aocr-text);
    font-size: 1.6rem;
    font-weight: 700;
    line-height: 1.15;
}

.aocr-page-subtitle {
    color: #587084;
    font-size: 0.9rem;
}

.aocr-breadcrumb-wrap {
    display: flex;
    justify-content: flex-end;
    align-items: center;
}

.aocr-breadcrumb,
.aocr-page-breadcrumb {
    background: #fff;
    border: 1px solid var(--aocr-border);
    border-radius: 999px;
    box-shadow: 0 4px 10px rgba(13,46,69,0.06);
    padding: 0.38rem 0.78rem;
    margin: 0;
    display: inline-flex;
    align-items: center;
    gap: 0;
    list-style: none;
}

.aocr-breadcrumb .breadcrumb-item + .breadcrumb-item::before,
.aocr-page-breadcrumb .breadcrumb-item + .breadcrumb-item::before {
    content: ">";
    color: #7790a3;
    padding: 0 0.35rem;
    float: none;
}

.aocr-breadcrumb-item,
.aocr-breadcrumb .breadcrumb-item {
    color: #2d4d66;
    font-size: 0.83rem;
}

.aocr-breadcrumb .breadcrumb-item a,
.aocr-page-breadcrumb .breadcrumb-item a {
    color: var(--aocr-primary);
    text-decoration: none;
    font-weight: 600;
}

.aocr-breadcrumb .breadcrumb-item.active,
.aocr-page-breadcrumb .breadcrumb-item.active {
    color: #264b62;
    font-weight: 700;
}

/* ============================================================
   C. HERO INSTITUCIONAL
   ============================================================ */
.aocr-hero,
.aocr-hero-panel {
    background: linear-gradient(118deg, #0d3f63 0%, #0f6a7f 55%, #f2f8fc 55%, #f2f8fc 100%);
    border: 0;
    border-radius: var(--aocr-radius-lg);
    box-shadow: var(--aocr-shadow-md);
    overflow: hidden;
}

.aocr-hero .card-body,
.aocr-hero-panel .card-body {
    padding: 1.35rem 1.4rem;
}

.aocr-hero-kicker,
.aocr-hero-overline {
    color: #d0e7f5;
    letter-spacing: 1px;
    text-transform: uppercase;
    font-size: 0.73rem;
    font-weight: 700;
}

.aocr-hero-title {
    color: #ffffff;
    font-size: 1.58rem;
    font-weight: 700;
    margin: 0.25rem 0 0;
}

.aocr-hero-subtitle,
.aocr-hero-description {
    color: #d8e8f3;
}

.aocr-hero-description {
    margin: 0.5rem 0 0;
    max-width: 70ch;
}

.aocr-hero-metric {
    min-width: 136px;
    border: 1px solid #dce8f2;
    border-radius: var(--aocr-radius-sm);
    background: #ffffff;
    box-shadow: 0 4px 12px rgba(17,49,72,0.08);
    padding: 0.65rem 0.8rem;
    text-align: center;
    flex-shrink: 0;
}

.aocr-hero-metric-value {
    color: #0b3f66;
    font-size: 1.7rem;
    font-weight: 700;
    line-height: 1;
    display: block;
}

.aocr-hero-metric-label {
    color: #4d6475;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    margin-top: 4px;
    display: block;
}

/* ============================================================
   D. MÉTRICAS
   ============================================================ */
.aocr-metric-card {
    border: 1px solid var(--aocr-border);
    border-left: 4px solid var(--aocr-primary);
    border-radius: var(--aocr-radius-sm);
    background: #fff;
    box-shadow: 0 4px 12px rgba(17,49,72,0.08);
}

.aocr-metric-card .card-body {
    padding: 0.8rem 0.95rem;
}

.aocr-metric-label {
    color: var(--aocr-muted);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    margin-bottom: 0.3rem;
    font-weight: 700;
}

.aocr-metric-value {
    color: var(--aocr-text);
    font-size: 1.4rem;
    font-weight: 700;
    line-height: 1.1;
}

.aocr-metric-card.metric-success { border-left-color: #198754; }
.aocr-metric-card.metric-warning { border-left-color: #d89f00; }
.aocr-metric-card.metric-danger  { border-left-color: #dc3545; }
.aocr-metric-card.metric-info    { border-left-color: #0d6efd; }

/* ============================================================
   E. TOOLBAR
   ============================================================ */
.aocr-toolbar,
.aocr-action-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.8rem;
    flex-wrap: wrap;
    margin-bottom: 0.9rem;
}

.aocr-toolbar-left {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
}

.aocr-toolbar-right {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.55rem;
    flex-wrap: wrap;
}

.aocr-filter-bar {
    display: flex;
    gap: 0.55rem;
    flex-wrap: wrap;
    align-items: center;
}

/* ============================================================
   F. EMPTY STATE
   ============================================================ */
.aocr-empty,
.aocr-empty-state {
    border: 1px solid var(--aocr-border);
    border-radius: var(--aocr-radius-md);
    background: radial-gradient(circle at top right, rgba(15,106,127,0.1), transparent 45%), #ffffff;
    padding: 2rem 1rem;
    text-align: center;
}

.aocr-empty-icon,
.aocr-empty-state-icon {
    width: 76px;
    height: 76px;
    border-radius: 50%;
    margin: 0 auto 0.9rem;
    color: #fff;
    background: linear-gradient(145deg, var(--aocr-primary), var(--aocr-secondary));
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.75rem;
}

.aocr-empty-title {
    color: #1f3f57;
    font-weight: 700;
    margin-bottom: 0.45rem;
}

.aocr-empty-text {
    color: var(--aocr-muted);
    margin: 0;
}

/* ============================================================
   G. FORMULARIOS
   ============================================================ */
.aocr-form-card .form-control,
.aocr-form-card .form-select {
    border-radius: 9px;
    border-color: #cad7e3;
    min-height: 40px;
}

.aocr-form-card .form-control:focus,
.aocr-form-card .form-select:focus {
    border-color: #5c9fc4;
    box-shadow: 0 0 0 0.2rem rgba(15,106,127,0.15);
}

/* ============================================================
   H. TABLAS
   ============================================================ */
.aocr-table-wrap {
    width: 100%;
    overflow-x: auto;
}

.aocr-table,
.aocr-table-card .table {
    margin-bottom: 0;
}

.aocr-table thead th,
.aocr-table-card thead th {
    background: #f0f6fb;
    color: #2a4b63;
    font-weight: 700;
    border-bottom: 1px solid #d8e5ef;
    white-space: nowrap;
    font-size: 0.84rem;
}

.aocr-table tbody tr:hover,
.aocr-table-card tbody tr:hover {
    background: #f8fbfe;
}

.aocr-table .aocr-badge,
.aocr-table .aocr-status-badge {
    vertical-align: middle;
}

/* ============================================================
   I. DETALLES
   ============================================================ */
.aocr-detail-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 0.9rem;
}

.aocr-detail-item {
    border: 1px solid #e1ebf4;
    border-radius: 10px;
    background: #f8fbff;
    padding: 0.8rem 0.9rem;
}

.aocr-detail-label {
    color: #5c768c;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: 0.3rem;
}

.aocr-detail-value {
    color: #18364f;
    font-weight: 600;
}

/* ============================================================
   J. ESTADOS / BADGES
   ============================================================ */
.aocr-badge,
.aocr-status-badge {
    display: inline-flex;
    align-items: center;
    border-radius: 999px;
    padding: 0.32rem 0.68rem;
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.2px;
    white-space: nowrap;
}

.aocr-badge-pendiente,
.aocr-status-badge.status-pendiente {
    background: #fff3cd;
    color: var(--aocr-warning);
}

.aocr-badge-aprobado,
.aocr-status-badge.status-aprobado {
    background: #dcf4e4;
    color: var(--aocr-success);
}

.aocr-badge-observado,
.aocr-status-badge.status-observado {
    background: #fce2e5;
    color: #8c2131;
}

.aocr-badge-enrevision,
.aocr-status-badge.status-en-revision {
    background: #dbeafe;
    color: var(--aocr-info);
}

.aocr-badge-subsanado,
.aocr-status-badge.status-subsanado {
    background: #dff6ea;
    color: var(--aocr-success);
}

.aocr-badge-rechazado,
.aocr-status-badge.status-rechazado {
    background: #ffe1e3;
    color: var(--aocr-danger);
}

.aocr-badge-legalizado,
.aocr-status-badge.status-legalizado {
    background: #dcf4e4;
    color: var(--aocr-success);
}

.aocr-badge-completado,
.aocr-status-badge.status-completado {
    background: #d4edda;
    color: #155724;
}

.aocr-badge-facturada,
.aocr-status-badge.status-facturada {
    background: #cce5ff;
    color: #004085;
}

.aocr-badge-anulado,
.aocr-status-badge.status-anulado {
    background: #f8d7da;
    color: #721c24;
}

/* ============================================================
   K. SIDEBAR / LAYOUT HELPERS
   ============================================================ */
.aocr-sidebar-section-title,
.aocr-sidebar .section-title {
    font-size: 0.74rem;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    font-weight: 700;
    color: #8fb9d3;
    margin-bottom: 0.45rem;
}

.aocr-nav-link-enhanced,
.aocr-sidebar .aocr-link,
.sidebar .nav-link {
    border-radius: 10px;
    transition: all 0.2s ease;
}

.aocr-nav-link-enhanced:hover,
.aocr-sidebar .aocr-link:hover,
.sidebar .nav-link:hover {
    background: rgba(255,255,255,0.09);
    transform: translateX(2px);
}

.aocr-footer {
    background: linear-gradient(180deg, #f9fbfc 0%, #f1f6f9 100%);
}

.aocr-footer .footer-title {
    color: #153a57;
    font-weight: 700;
}

.aocr-footer .footer-subtitle,
.aocr-footer .footer-meta {
    color: #557183;
}

/* ============================================================
   CARD SOLICITUD (patrón reutilizable)
   ============================================================ */
.aocr-solicitud-card {
    border-left: 4px solid var(--aocr-secondary);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    border-radius: var(--aocr-radius-md);
    background: var(--aocr-surface);
    border-top: 1px solid var(--aocr-border);
    border-right: 1px solid var(--aocr-border);
    border-bottom: 1px solid var(--aocr-border);
    box-shadow: var(--aocr-shadow-sm);
}

.aocr-solicitud-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--aocr-shadow-md);
}

.aocr-solicitud-kicker {
    color: #507089;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    font-size: 0.76rem;
    font-weight: 700;
    margin-bottom: 0.3rem;
    display: block;
}

.aocr-solicitud-metadata {
    margin: 0;
}

.aocr-solicitud-metadata > div {
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: 6px;
    padding: 5px 0;
    border-bottom: 1px dashed #e3eaf0;
}

.aocr-solicitud-metadata > div:last-child {
    border-bottom: 0;
}

.aocr-solicitud-metadata dt {
    margin: 0;
    color: #597184;
    font-size: 0.83rem;
    font-weight: 600;
}

.aocr-solicitud-metadata dd {
    margin: 0;
    color: #1d2e3f;
    font-weight: 600;
}

/* ============================================================
   RESPONSIVE
   ============================================================ */
@media (max-width: 768px) {
    .aocr-hero,
    .aocr-hero-panel {
        background: linear-gradient(165deg, #0d3f63 0%, #0f6a7f 100%);
    }

    .aocr-page-title {
        font-size: 1.36rem;
    }

    .aocr-toolbar-right {
        width: 100%;
        justify-content: flex-start;
    }

    .aocr-solicitud-metadata > div {
        grid-template-columns: 1fr;
        gap: 2px;
    }

    .aocr-hero-metric {
        width: 100%;
    }
}
