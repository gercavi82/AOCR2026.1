@* Views/Shared/_PageHeader.cshtml
   Uso:
   ViewBag.PageHeaderTitle    = "Título principal"
   ViewBag.PageHeaderSubtitle = "Subtítulo opcional"
   ViewBag.PageHeaderBreadcrumbs = lista de { Text, Url } — si se omite usa controller/acción
   @section PageHeaderActions { ... botones ... }  — opcional
*@
@{
    var titulo    = ViewBag.PageHeaderTitle    as string ?? ViewBag.Title as string ?? string.Empty;
    var subtitulo = ViewBag.PageHeaderSubtitle as string ?? ViewBag.PageSubtitle as string ?? string.Empty;

    var controllerName = ViewContext.RouteData.Values["controller"] as string ?? string.Empty;
    var controllerLabel = controllerName;
    if (string.Equals(controllerName, "CoordinacionJefatura", StringComparison.OrdinalIgnoreCase))
        controllerLabel = "Coordinación y Jefatura";
    else if (string.Equals(controllerName, "SolicitudAOCR", StringComparison.OrdinalIgnoreCase))
        controllerLabel = "Solicitudes AOCR";
    else if (string.Equals(controllerName, "Direccion", StringComparison.OrdinalIgnoreCase))
        controllerLabel = "Dirección";
    else if (string.Equals(controllerName, "OrdenRecaudacion", StringComparison.OrdinalIgnoreCase))
        controllerLabel = "Órdenes de Recaudación";
    else if (string.Equals(controllerName, "Financiero", StringComparison.OrdinalIgnoreCase))
        controllerLabel = "Financiero";

    var breadcrumbs = ViewBag.PageHeaderBreadcrumbs as IEnumerable<dynamic>;
}
<div class="aocr-page-header mb-3">
    <div class="d-flex flex-wrap align-items-start justify-content-between gap-2">
        <div>
            @if (!string.IsNullOrWhiteSpace(titulo))
            {
                <h1 class="aocr-page-title mb-0">@titulo</h1>
            }
            @if (!string.IsNullOrWhiteSpace(subtitulo))
            {
                <div class="aocr-page-subtitle mt-1">@subtitulo</div>
            }
        </div>

        <div class="d-flex align-items-center gap-2 flex-wrap">
            @RenderSection("PageHeaderActions", required: false)

            <nav aria-label="Ruta de navegación">
                <ol class="aocr-breadcrumb breadcrumb mb-0">
                    <li class="breadcrumb-item">
                        <a href="@Url.Action("Index", "Home")">
                            <i class="fas fa-home"></i>
                        </a>
                    </li>
                    @if (breadcrumbs != null)
                    {
                        foreach (var bc in breadcrumbs)
                        {
                            if (!string.IsNullOrWhiteSpace((string)bc.Url))
                            {
                                <li class="breadcrumb-item"><a href="@bc.Url">@bc.Text</a></li>
                            }
                            else
                            {
                                <li class="breadcrumb-item active" aria-current="page">@bc.Text</li>
                            }
                        }
                    }
                    else
                    {
                        if (!string.IsNullOrWhiteSpace(controllerLabel) &&
                            !string.Equals(controllerName, "Home", StringComparison.OrdinalIgnoreCase))
                        {
                            <li class="breadcrumb-item">@controllerLabel</li>
                        }
                        if (!string.IsNullOrWhiteSpace(titulo))
                        {
                            <li class="breadcrumb-item active" aria-current="page">@titulo</li>
                        }
                    }
                </ol>
            </nav>
        </div>
    </div>
</div>
