@model IEnumerable<CapaModelo.SolicitudAOCR>
@using CapaModelo
@using System.Web.Mvc
@using System.Web.Mvc.Html

@{
    ViewBag.Title = "Asignación de Inspectores";
    Layout = "~/Views/Shared/_LayoutAOCR.cshtml";
}

<div class="aocr-module-header mb-3">
    <div class="aocr-module-header-left">
        <h2 class="aocr-module-header-title">Asignación de Inspectores</h2>
        <p class="aocr-module-header-subtitle">Gestión Técnica — Solicitudes pendientes de asignación</p>
    </div>
</div>


@if (TempData["Success"] != null)
{
    <div class="alert alert-aocr alert-success alert-dismissible fade show mb-3" role="alert">
        <i class="fas fa-check-circle me-1"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-aocr alert-danger alert-dismissible fade show mb-3" role="alert">
        <i class="fas fa-exclamation-circle me-1"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Info"] != null)
{
    <div class="alert alert-aocr alert-info alert-dismissible fade show mb-3" role="alert">
        <i class="fas fa-info-circle me-1"></i> @TempData["Info"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}


<div class="card aocr-table-card">
<div class="card-body p-0">
    @if (Model != null && Model.Any())
    {
        <div class="aocr-table-wrap">
            <table class="table table-dgac mb-0">
                <thead>
                    <tr>
                        <th style="width:110px;">Código</th>
                        <th>N° Solicitud</th>
                        <th>Operador</th>
                        <th>Fecha Solicitud</th>
                        <th>Estado</th>
                        <th style="width:140px;" class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model)
                    {
                        <tr>
                            <td class="fw-bold text-primary">@Html.Encode(s.CodigoSolicitud)</td>
                            <td>@Html.Encode(s.NumeroSolicitud)</td>
                            <td>@Html.Encode(s.NombreOperador)</td>
                            <td>@Html.Encode(s.FechaSolicitud.HasValue ? s.FechaSolicitud.Value.ToString("dd/MM/yyyy") : "-")</td>
                            <td>
                                @Html.Partial("_StatusBadge", new ViewDataDictionary { { "Estado", s.Estado } })
                            </td>
                            <td class="text-center">
                                <a href="@Url.Action("AsignarInspector", "Tecnico", new { solicitudId = s.CodigoSolicitud })"
                                   class="btn btn-sm btn-primary" title="Asignar Inspector">
                                    <i class="fas fa-user-check me-1"></i> Asignar
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="p-3">
            @Html.Partial("_EmptyState", new ViewDataDictionary {
                { "Icon",        "fas fa-user-check" },
                { "Title",       "Sin solicitudes pendientes" },
                { "Description", "No hay solicitudes pendientes de asignación de inspector en este momento." }
            })
            </div>
        }
    </div>
</div>



