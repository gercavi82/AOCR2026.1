@model List<CapaModelo.SolicitudAOCR>
@using CapaModelo
@using System.Web.Mvc
@using System.Web.Mvc.Html

@{
    ViewBag.Title = "Solicitudes Pendientes de Revisión";
    Layout = "~/Views/Shared/_LayoutAOCR.cshtml";
}

<div class="aocr-module-header mb-3">
    <div class="aocr-module-header-left">
        <h2 class="aocr-module-header-title">Solicitudes Pendientes de Revisión</h2>
        <p class="aocr-module-header-subtitle">Gestión Técnica — Bandeja de revisión de solicitudes</p>
    </div>
    <nav>
        <ol class="aocr-breadcrumb breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")"><i class="fas fa-home"></i></a></li>
            <li class="breadcrumb-item">Solicitudes AOCR</li>
            <li class="breadcrumb-item active">Revisar</li>
        </ol>
    </nav>
</div>

<div class="card aocr-table-card">
    <div class="card-body p-0">
        @if (Model != null && Model.Any())
        {
            <div class="aocr-table-wrap">
                <table class="table table-dgac mb-0">
                    <thead>
                        <tr>
                            <th>Código</th>
                            <th>Operador</th>
                            <th>Fecha Solicitud</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-bold text-primary">@Html.Encode(item.CodigoSolicitud)</td>
                                <td>@Html.Encode(item.NombreOperador)</td>
                                <td>@(item.FechaSolicitud.HasValue ? item.FechaSolicitud.Value.ToString("dd/MM/yyyy") : "")</td>
                                <td><span class="badge-pill-custom bg-tramite">@Html.Encode(item.Estado)</span></td>
                                <td>
                                    @Html.ActionLink("Revisar", "Detalle", "SolicitudAOCR",
                                        new { id = item.CodigoSolicitud },
                                        new { @class = "btn btn-sm btn-aocr-primary" })
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="aocr-no-results">
                <i class="fas fa-inbox"></i>
                <p class="mb-0">No hay solicitudes pendientes de revisión.</p>
            </div>
        }
    </div>
</div>




