@inherits System.Web.Mvc.WebViewPage<List<CapaModelo.SolicitudAOCR>>
@using CapaModelo
@using System.Web.Mvc
@using System.Web.Mvc.Html

@{
    ViewBag.Title = "Validación por Jefatura Técnica";
    Layout = "~/Views/Shared/_LayoutAOCR.cshtml";
}

<div class="aocr-module-header mb-3">
    <div class="aocr-module-header-left">
        <h2 class="aocr-module-header-title">Validación por Jefatura Técnica</h2>
        <p class="aocr-module-header-subtitle">Solicitudes pendientes de validación</p>
    </div>
    <nav>
        <ol class="aocr-breadcrumb breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")"><i class="fas fa-home"></i></a></li>
            <li class="breadcrumb-item">Solicitudes AOCR</li>
            <li class="breadcrumb-item active">Revisar por Jefatura</li>
        </ol>
    </nav>
</div>

<div class="card aocr-table-card">
    <div class="card-body p-0">
        <div class="aocr-table-wrap">
            <table class="table table-dgac mb-0">
                <thead>
                    <tr>
                        <th>Código</th>
                        <th>Operador</th>
                        <th>Fecha</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var sol in Model)
                    {
                        <tr>
                            <td class="fw-bold text-primary">@Html.Encode(sol.CodigoSolicitud)</td>
                            <td>@Html.Encode(sol.NombreOperador)</td>
                            <td>@Html.Encode(sol.FechaSolicitud.HasValue ? sol.FechaSolicitud.Value.ToString("dd/MM/yyyy") : "")</td>
                            <td><span class="badge-pill-custom bg-tramite">@Html.Encode(sol.Estado)</span></td>
                            <td>
                                @Html.ActionLink("Ver Detalle", "Detalle", "SolicitudAOCR",
                                    new { id = sol.CodigoSolicitud },
                                    new { @class = "btn btn-sm btn-aocr-primary" })
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>




