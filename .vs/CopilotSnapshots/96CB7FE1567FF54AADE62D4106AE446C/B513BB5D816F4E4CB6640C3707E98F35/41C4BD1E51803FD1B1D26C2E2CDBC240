@inherits System.Web.Mvc.WebViewPage<List<CapaModelo.SolicitudAOCR>>
@using CapaModelo
@using System.Web.Mvc
@using System.Web.Mvc.Html
@using System.Linq

@{
    ViewBag.Title = "Aprobación de Solicitudes AOCR";
    ViewBag.PageSubtitle = "Dirección / Jefatura";
    Layout = "~/Views/Shared/_LayoutAOCR.cshtml";

    var totalPendientes = Model != null ? Model.Count : 0;
}

@* ── PAGE HEADER ──────────────────────────────────────────── *@
<div class="aocr-page-header mb-3">
    <div class="d-flex flex-wrap align-items-start justify-content-between gap-2">
        <div>
            <h1 class="aocr-page-title mb-0">Aprobación de Solicitudes AOCR</h1>
            <div class="aocr-page-subtitle mt-1">Dirección / Jefatura — flujo institucional AOCR</div>
        </div>
        <nav aria-label="Ruta de navegación">
            <ol class="aocr-breadcrumb breadcrumb mb-0">
                <li class="breadcrumb-item">
                    <a href="@Url.Action("Index", "Home")"><i class="fas fa-home"></i></a>
                </li>
                <li class="breadcrumb-item">Dirección / Jefatura</li>
                <li class="breadcrumb-item active" aria-current="page">Aprobación de Solicitudes</li>
            </ol>
        </nav>
    </div>
</div>

@* ── HERO PANEL ───────────────────────────────────────────── *@
<div class="card aocr-hero aocr-hero-panel mb-4">
    <div class="card-body">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div>
                <p class="aocr-hero-kicker aocr-hero-overline mb-1">
                    <i class="fas fa-landmark me-1"></i> Sistema Institucional DGAC
                </p>
                <h2 class="aocr-hero-title mb-1">Aprobación de Solicitudes AOCR</h2>
                <p class="aocr-hero-subtitle mb-0">Dirección / Jefatura</p>
                <p class="aocr-hero-description mb-0">
                    Revise y formalice la decisión de cada solicitud en cumplimiento del flujo institucional AOCR.
                </p>
            </div>
            <div class="aocr-hero-metric">
                <span class="aocr-hero-metric-value">@totalPendientes</span>
                <span class="aocr-hero-metric-label">Pendientes</span>
            </div>
        </div>
    </div>
</div>

@* ── ALERTAS ──────────────────────────────────────────────── *@
@if (TempData["success"] != null)
{
    <div class="alert alert-success shadow-sm border-0 mb-3">
        <i class="fas fa-check-circle me-1"></i> @TempData["success"]
    </div>
}
@if (TempData["error"] != null)
{
    <div class="alert alert-danger shadow-sm border-0 mb-3">
        <i class="fas fa-exclamation-circle me-1"></i> @TempData["error"]
    </div>
}

@* ── CONTENIDO PRINCIPAL ──────────────────────────────────── *@
@if (Model != null && Model.Any())
{
    <div class="row g-3">
        @foreach (var solicitud in Model)
        {
            var estadoRaw = (solicitud.Estado ?? string.Empty).Trim().ToUpperInvariant();
            var numeroSolicitudTexto = !string.IsNullOrWhiteSpace(solicitud.NumeroSolicitud)
                ? solicitud.NumeroSolicitud
                : solicitud.CodigoSolicitud.ToString();

            <div class="col-12 col-lg-6 d-flex">
                <article class="aocr-solicitud-card p-3 w-100 d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-start mb-2 gap-2 flex-wrap">
                        <div>
                            <span class="aocr-solicitud-kicker">Solicitud AOCR</span>
                            <h5 class="mb-0 text-primary fw-bold">#@Html.Encode(numeroSolicitudTexto)</h5>
                        </div>
                        @Html.Partial("_StatusBadge", new ViewDataDictionary { { "Estado", solicitud.Estado } })
                    </div>

                    <dl class="aocr-solicitud-metadata mb-3">
                        <div>
                            <dt>Compañía</dt>
                            <dd>@Html.Encode(string.IsNullOrWhiteSpace(solicitud.NombreOperador) ? "No especificada" : solicitud.NombreOperador)</dd>
                        </div>
                        <div>
                            <dt>Código OACI</dt>
                            <dd>@Html.Encode(string.IsNullOrWhiteSpace(solicitud.CodigoOaci) ? "No registrado" : solicitud.CodigoOaci)</dd>
                        </div>
                        <div>
                            <dt>Representante Técnico</dt>
                            <dd>@Html.Encode(string.IsNullOrWhiteSpace(solicitud.RepresentanteLegal) ? "No registrado" : solicitud.RepresentanteLegal)</dd>
                        </div>
                        <div>
                            <dt>Fecha de solicitud</dt>
                            <dd>@Html.Encode(solicitud.FechaSolicitud.HasValue ? solicitud.FechaSolicitud.Value.ToString("dd/MM/yyyy") : "No registrada")</dd>
                        </div>
                    </dl>

                    <div class="mt-auto d-flex flex-wrap gap-2">
                        @Html.ActionLink("Revisar solicitud", "Detalle", "SolicitudAOCR",
                            new { id = solicitud.CodigoSolicitud },
                            new { @class = "btn btn-primary btn-sm" })

                        @if (User.IsInRole("JefaturaTecnica") || User.IsInRole("Administrador"))
                        {
                            @Html.ActionLink("Validar Jefatura", "RevisarPorJefatura", "SolicitudAOCR",
                                null,
                                new { @class = "btn btn-outline-warning btn-sm" })
                        }

                        @if (User.IsInRole("CoordinacionLegal") || User.IsInRole("Administrador") || User.IsInRole("DirectorGeneral"))
                        {
                            @Html.ActionLink("Revisión Legal", "RevisarLegalizacion", "SolicitudAOCR",
                                null,
                                new { @class = "btn btn-outline-success btn-sm" })
                        }
                    </div>
                </article>
            </div>
        }
    </div>
}
else
{
    @Html.Partial("_EmptyState", new ViewDataDictionary {
        { "Icon",        "fas fa-clipboard-check" },
        { "Title",       "No hay solicitudes pendientes de aprobación" },
        { "Description", "Cuando existan solicitudes en estado AOCR En Revisión o Validado, aparecerán aquí para revisión por Dirección o Jefatura." }
    })
}


