@inherits System.Web.Mvc.WebViewPage<List<CapaModelo.InspeccionInformeTecnico>>
@using System.Web.Mvc
@using System.Web.Mvc.Html
@using CapaModelo

@{
    ViewBag.Title = "Gestión de Informes";
    var informes = Model ?? new List<InspeccionInformeTecnico>();
    var totalInformes = informes.Count;
    var informesSatisfactorios = informes.Count(x => string.Equals((x.Resultado ?? string.Empty).Trim(), "SATISFACTORIO", StringComparison.OrdinalIgnoreCase));
    var informesInsatisfactorios = informes.Count(x => string.Equals((x.Resultado ?? string.Empty).Trim(), "INSATISFACTORIO", StringComparison.OrdinalIgnoreCase));
    var informesConPdf = informes.Count(x => !string.IsNullOrWhiteSpace(x.RutaDocumentoFirmado) || !string.IsNullOrWhiteSpace(x.RutaPdf));
}

@section Styles {
    <style>
        .informes-page {
            color: #172b3a;
            padding-bottom: 24px;
        }

        .informes-header {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 16px;
            margin: 12px 0 18px;
        }

        .informes-title h2 {
            color: #102f46;
            font-size: 1.55rem;
            font-weight: 700;
            line-height: 1.2;
            margin: 0;
        }

        .informes-title p {
            color: #64748b;
            margin: 6px 0 0;
        }

        .informes-primary-action {
            border: 0;
            border-radius: 6px;
            box-shadow: 0 8px 18px rgba(15, 118, 150, .16);
            font-weight: 700;
            white-space: nowrap;
        }

        .informes-summary {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 12px;
            margin-bottom: 16px;
        }

        .informes-stat {
            background: #fff;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            padding: 12px 14px;
        }

        .informes-stat span {
            color: #64748b;
            display: block;
            font-size: .76rem;
            font-weight: 700;
            letter-spacing: .02em;
            text-transform: uppercase;
        }

        .informes-stat strong {
            color: #0f2f46;
            display: block;
            font-size: 1.35rem;
            line-height: 1.15;
            margin-top: 4px;
        }

        .informes-panel {
            background: #fff;
            border: 1px solid #dbe5ee;
            border-radius: 8px;
            box-shadow: 0 12px 28px rgba(15, 23, 42, .08);
            overflow: hidden;
        }

        .informes-panel-heading {
            align-items: center;
            background: #0f5a7b;
            color: #fff;
            display: flex;
            justify-content: space-between;
            padding: 14px 18px;
        }

        .informes-panel-heading h5 {
            font-size: 1rem;
            font-weight: 700;
            margin: 0;
        }

        .informes-panel-heading small {
            color: rgba(255, 255, 255, .78);
            font-weight: 600;
        }

        .informes-filters {
            border-bottom: 1px solid #e2e8f0;
            display: grid;
            grid-template-columns: minmax(180px, 1.2fr) minmax(160px, 1fr) minmax(160px, 1fr) auto;
            gap: 12px;
            padding: 16px 18px;
        }

        .informes-filter label {
            color: #526579;
            display: block;
            font-size: .73rem;
            font-weight: 700;
            margin-bottom: 6px;
            text-transform: uppercase;
        }

        .informes-filter .form-control {
            border-color: #cbd5e1;
            border-radius: 6px;
            min-height: 38px;
        }

        .informes-filter-actions {
            align-self: end;
            display: flex;
            gap: 8px;
        }

        .informes-table-wrap {
            padding: 16px 18px 18px;
        }

        #tablaInformes {
            border-collapse: separate !important;
            border-spacing: 0;
            margin: 0 !important;
            width: 100% !important;
        }

        #tablaInformes thead th {
            background: #174e70;
            border: 0;
            color: #fff;
            font-size: .73rem;
            letter-spacing: .02em;
            padding: 13px 12px;
            text-transform: uppercase;
            vertical-align: middle;
            white-space: nowrap;
        }

        #tablaInformes tbody td {
            border-top: 1px solid #e5edf3;
            color: #172b3a;
            padding: 12px;
            vertical-align: middle;
        }

        #tablaInformes tbody tr:hover td {
            background: #f7fbfd;
        }

        .informe-title-cell strong {
            display: block;
            font-size: .86rem;
            line-height: 1.25;
        }

        .informe-title-cell small {
            color: #64748b;
            display: block;
            margin-top: 2px;
        }

        .informe-badge {
            border-radius: 999px;
            display: inline-flex;
            font-size: .7rem;
            font-weight: 800;
            line-height: 1;
            padding: 6px 9px;
            text-transform: uppercase;
            white-space: nowrap;
        }

        .informe-badge-ok { background: #dff4e8; color: #17643a; }
        .informe-badge-alert { background: #fde2e5; color: #9b1c31; }
        .informe-badge-muted { background: #e8edf2; color: #475569; }
        .informe-badge-state { background: #dbeff6; color: #14516d; }

        .informes-actions {
            display: inline-flex;
            gap: 4px;
            white-space: nowrap;
        }

        .informes-actions .btn {
            align-items: center;
            border: 0;
            border-radius: 6px;
            display: inline-flex;
            height: 31px;
            justify-content: center;
            padding: 0;
            width: 34px;
        }

        .informes-actions .btn.disabled {
            cursor: not-allowed;
            opacity: .45;
            pointer-events: none;
        }

        .informes-table-wrap .dataTables_wrapper .dataTables_filter {
            margin-bottom: 12px;
        }

        .informes-table-wrap .dataTables_wrapper .dataTables_filter input {
            border: 1px solid #cbd5e1;
            border-radius: 6px;
            margin-left: 8px;
            min-height: 34px;
            padding: 6px 10px;
        }

        .informes-table-wrap .dataTables_wrapper .dataTables_info {
            color: #64748b;
            font-size: .82rem;
            padding-top: 14px;
        }

        .informes-table-wrap .dataTables_wrapper .dataTables_paginate {
            padding-top: 10px;
        }

        @@media (max-width: 991.98px) {
            .informes-header {
                align-items: stretch;
                flex-direction: column;
            }

            .informes-summary {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            .informes-filters {
                grid-template-columns: 1fr 1fr;
            }

            .informes-filter-actions {
                grid-column: 1 / -1;
            }
        }

        @@media (max-width: 575.98px) {
            .informes-summary,
            .informes-filters {
                grid-template-columns: 1fr;
            }

            .informes-primary-action,
            .informes-filter-actions .btn {
                width: 100%;
            }
        }
    </style>
}

<div class="container-fluid informes-page">
    <div class="d-none">
        @Html.AntiForgeryToken()
    </div>

    <div class="informes-header">
        <div class="informes-title">
            <h2><i class="fas fa-file-alt mr-2"></i>Gestión de Informes</h2>
            <p>Seguimiento de informes técnicos generados, firmados y revisados.</p>
        </div>
        <div>
            <a href="@Url.Action("Crear", "Informe")" class="btn btn-info informes-primary-action">
                <i class="fas fa-plus"></i> Generar Informe
            </a>
        </div>
    </div>

    <div class="informes-summary">
        <div class="informes-stat">
            <span>Total</span>
            <strong>@totalInformes</strong>
        </div>
        <div class="informes-stat">
            <span>Satisfactorios</span>
            <strong>@informesSatisfactorios</strong>
        </div>
        <div class="informes-stat">
            <span>Insatisfactorios</span>
            <strong>@informesInsatisfactorios</strong>
        </div>
        <div class="informes-stat">
            <span>Con PDF</span>
            <strong>@informesConPdf</strong>
        </div>
    </div>

    <div class="informes-panel">
        <div class="informes-panel-heading">
            <h5><i class="fas fa-list mr-2"></i>Lista de informes</h5>
            <small>@totalInformes registros</small>
        </div>

        <div class="informes-filters">
            <div class="informes-filter">
                <label for="filtroTipo">Resultado</label>
                <select class="form-control" id="filtroTipo">
                    <option value="">Todos los resultados</option>
                    <option value="SATISFACTORIO">Satisfactorio</option>
                    <option value="INSATISFACTORIO">Insatisfactorio</option>
                </select>
            </div>
            <div class="informes-filter">
                <label for="filtroFechaInicio">Desde</label>
                <input type="date" class="form-control" id="filtroFechaInicio">
            </div>
            <div class="informes-filter">
                <label for="filtroFechaFin">Hasta</label>
                <input type="date" class="form-control" id="filtroFechaFin">
            </div>
            <div class="informes-filter-actions">
                <button class="btn btn-primary" id="btnFiltrar" type="button">
                    <i class="fas fa-filter"></i> Filtrar
                </button>
                <button class="btn btn-outline-secondary" id="btnLimpiarFiltros" type="button">
                    <i class="fas fa-times"></i> Limpiar
                </button>
            </div>
        </div>

        <div class="informes-table-wrap">
            <div class="table-responsive">
                <table id="tablaInformes" class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Informe</th>
                            <th>Inspección</th>
                            <th>Fecha Generación</th>
                            <th>Usuario ID</th>
                            <th>Resultado</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (informes.Any())
                        {
                            foreach (var informe in informes)
                            {
                                var id = informe.CodigoInforme;
                                var titulo = !string.IsNullOrWhiteSpace(informe.Titulo) ? informe.Titulo : "Informe Técnico de Inspección";
                                var checklist = informe.CodigoInspeccion;
                                var fecha = informe.FechaFinalizacion ?? informe.FechaFirma2 ?? informe.FechaFirma1 ?? informe.UpdatedAt ?? informe.CreatedAt ?? DateTime.Now;
                                var usuario = informe.UpdatedBy ?? informe.CreatedBy;
                                var estado = !string.IsNullOrWhiteSpace(informe.EstadoInforme) ? informe.EstadoInforme : (informe.Finalizado ? "FINALIZADO" : "BORRADOR");
                                var resultado = !string.IsNullOrWhiteSpace(informe.Resultado) ? informe.Resultado.Trim().ToUpperInvariant() : "SIN RESULTADO";
                                var resultadoBadgeClass = resultado == "INSATISFACTORIO" ? "informe-badge-alert" : (resultado == "SATISFACTORIO" ? "informe-badge-ok" : "informe-badge-muted");
                                var tienePdf = !string.IsNullOrWhiteSpace(informe.RutaDocumentoFirmado) || !string.IsNullOrWhiteSpace(informe.RutaPdf);
                                var fechaOrden = fecha.ToString("yyyyMMddHHmmss");
                                var fechaFiltro = fecha.ToString("yyyy-MM-dd");
                                var estadoVisual = estado.Replace("_", " ");

                                <tr>
                                    <td>@id</td>
                                    <td class="informe-title-cell">
                                        <strong>@titulo</strong>
                                        <small>Versión @informe.Version</small>
                                    </td>
                                    <td>@checklist</td>
                                    <td data-order="@fechaOrden" data-date="@fechaFiltro">@fecha.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>@(usuario.HasValue ? usuario.Value.ToString() : "-")</td>
                                    <td>
                                        <span class="informe-badge @resultadoBadgeClass">@resultado</span>
                                    </td>
                                    <td>
                                        <span class="informe-badge informe-badge-state">@estadoVisual</span>
                                    </td>
                                    <td>
                                        <div class="informes-actions" role="group">
                                            <a href="@Url.Action("Detalle", "Inspeccion", new { id = checklist })"
                                               class="btn btn-sm btn-info" title="Abrir inspección">
                                                <i class="fas fa-eye"></i>
                                            </a>

                                            <a href="@Url.Action("VerInforme", "Inspeccion", new { id = checklist })"
                                               class="btn btn-sm btn-secondary @(tienePdf ? "" : "disabled")"
                                               target="_blank"
                                               rel="noopener"
                                               title="Ver PDF">
                                                <i class="fas fa-file-pdf"></i>
                                            </a>

                                            <a href="@Url.Action("DescargarInforme", "Inspeccion", new { id = checklist })"
                                               class="btn btn-sm btn-success @(tienePdf ? "" : "disabled")"
                                               title="Descargar PDF">
                                                <i class="fas fa-download"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {

            var $tablaInformes = $('#tablaInformes');
            var columnasEsperadas = $tablaInformes.find('thead th').length;

            $tablaInformes.find('tbody tr').each(function () {
                var $fila = $(this);
                var tieneColspan = $fila.find('td[colspan], th[colspan]').length > 0;
                var columnasFila = $fila.children('td, th').length;

                if (tieneColspan || columnasFila !== columnasEsperadas) {
                    $fila.remove();
                }
            });

            $.fn.dataTable.ext.search.push(function (settings, data, dataIndex) {
                if (settings.nTable !== $tablaInformes[0]) {
                    return true;
                }

                var desde = $('#filtroFechaInicio').val();
                var hasta = $('#filtroFechaFin').val();

                if (!desde && !hasta) {
                    return true;
                }

                var row = settings.aoData[dataIndex] ? settings.aoData[dataIndex].nTr : null;
                var fecha = $(row).find('td').eq(3).data('date');

                if (!fecha) {
                    return false;
                }

                if (desde && fecha < desde) {
                    return false;
                }

                if (hasta && fecha > hasta) {
                    return false;
                }

                return true;
            });

            var table = $tablaInformes.DataTable({
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/es-ES.json'
                },
                order: [[0, 'desc']],
                columnDefs: [
                    { orderable: false, targets: 7 }
                ]
            });

            function aplicarFiltros() {
                var resultado = $('#filtroTipo').val();
                table.column(5).search(resultado).draw();
            }

            $('#btnFiltrar').on('click', aplicarFiltros);

            $('#filtroTipo, #filtroFechaInicio, #filtroFechaFin').on('change', aplicarFiltros);

            $('#btnLimpiarFiltros').on('click', function () {
                $('#filtroTipo').val('');
                $('#filtroFechaInicio').val('');
                $('#filtroFechaFin').val('');
                table.column(5).search('').draw();
            });

        });
    </script>
}

