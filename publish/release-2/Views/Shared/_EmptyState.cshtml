@inherits System.Web.Mvc.WebViewPage
@using System.Web
@{
    var icon = ViewData["Icon"] as string ?? "fas fa-inbox";
    var title = ViewData["Title"] as string ?? "Sin registros";
    var description = ViewData["Description"] as string ?? string.Empty;
    var actionText = ViewData["ActionText"] as string ?? string.Empty;
    var actionUrl = ViewData["ActionUrl"] as string ?? string.Empty;
    var actionClass = ViewData["ActionClass"] as string ?? "btn-aocr-primary";
}
<div class="aocr-empty-state">
    <div class="aocr-empty-icon"><i class="@icon"></i></div>
    <h5 class="aocr-empty-title">@Html.Raw(HttpUtility.HtmlEncode(title))</h5>
    @if (!string.IsNullOrWhiteSpace(description))
    {
        <p class="aocr-empty-text">@Html.Raw(HttpUtility.HtmlEncode(description))</p>
    }
    @if (!string.IsNullOrWhiteSpace(actionText) && !string.IsNullOrWhiteSpace(actionUrl))
    {
        <div class="mt-3">
            <a href="@actionUrl" class="btn @actionClass"><i class="fas fa-arrow-right"></i><span>@actionText</span></a>
        </div>
    }
</div>
