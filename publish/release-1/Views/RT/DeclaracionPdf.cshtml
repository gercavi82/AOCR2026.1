@inherits System.Web.Mvc.WebViewPage<CapaModelo.RT.ViewModels.DeclaracionPdfVM>
@{
    Layout = "~/Views/Shared/_PdfLayoutDGAC.cshtml";
}

@section PdfHead {
    <style>
        body {
            font-family: Arial, sans-serif;
            font-size: 12pt;
            color: #111;
        }

        .titulo {
            font-size: 16pt;
            font-weight: bold;
            margin-bottom: 10px;
        }

        .subtitulo {
            font-size: 11pt;
            color: #444;
            margin-bottom: 20px;
        }

        .texto {
            white-space: pre-wrap;
            line-height: 1.5;
        }

        .firma {
            margin-top: 40px;
        }

        .linea {
            border-top: 1px solid #000;
            width: 240px;
            margin-top: 40px;
        }

        .meta {
            margin-top: 6px;
            font-size: 10pt;
            color: #555;
        }
    </style>
}

<div class="titulo">Declaracion de Responsabilidad</div>
<div class="subtitulo">Responsable Tecnico (RT)</div>

<div class="texto">@Model.TextoDeclaracion</div>

<div class="firma">
    <div>Nombre: <strong>@Model.NombreCompleto</strong></div>
    <div>Compania: <strong>@Model.Compania</strong></div>
    <div class="linea"></div>
    <div class="meta">Firma del Responsable Tecnico</div>
    <div class="meta">Fecha emision: @Model.FechaEmision.ToString("dd/MM/yyyy")</div>
</div>
