@inherits System.Web.Mvc.WebViewPage<CapaModelo.SolicitudAOCR>
@using System.Collections.Generic
@using System.Linq

@{
    Layout = null;
    var fechaFirma = ViewBag.AceptacionFechaFirma != null
        ? (System.DateTime)ViewBag.AceptacionFechaFirma
        : System.DateTime.Now;
    var firmante = (ViewBag.AceptacionFirmante as string ?? "Coordinacion AOCR").Trim();
    var observacion = (ViewBag.AceptacionObservacion as string ?? "Aceptacion documental firmada por coordinación.").Trim();
    var documentos = ViewBag.AceptacionDocumentos as IEnumerable<string> ?? Enumerable.Empty<string>();
    var operador = !string.IsNullOrWhiteSpace(Model != null ? Model.RazonSocial : null)
        ? Model.RazonSocial
        : (Model != null ? (Model.NombreOperador ?? Model.NombreComercial) : string.Empty);
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Aceptacion Documental AOCR</title>
    <style>
        body {
            font-family: Arial, Helvetica, sans-serif;
            color: #16365f;
            margin: 32px;
            font-size: 13px;
            line-height: 1.45;
        }

        .header {
            border-bottom: 2px solid #16365f;
            padding-bottom: 12px;
            margin-bottom: 24px;
        }

        .eyebrow {
            text-transform: uppercase;
            letter-spacing: 0.08em;
            font-size: 11px;
            color: #4f6f92;
            margin-bottom: 8px;
        }

        h1 {
            margin: 0;
            font-size: 24px;
        }

        .meta {
            margin-top: 10px;
            color: #445b77;
        }

        .panel {
            border: 1px solid #d8e2ef;
            border-radius: 10px;
            padding: 16px 18px;
            margin-bottom: 18px;
        }

        .panel h2 {
            margin: 0 0 10px;
            font-size: 16px;
            color: #16365f;
        }

        .grid {
            width: 100%;
            border-collapse: collapse;
        }

        .grid td {
            padding: 6px 0;
            vertical-align: top;
        }

        .grid td:first-child {
            width: 220px;
            color: #4f6f92;
            font-weight: bold;
        }

        ul {
            margin: 8px 0 0 18px;
            padding: 0;
        }

        .signature {
            margin-top: 28px;
            padding-top: 18px;
            border-top: 1px solid #d8e2ef;
        }

        .signature strong {
            display: block;
            margin-top: 28px;
            font-size: 14px;
        }

        .footnote {
            margin-top: 24px;
            color: #5d7088;
            font-size: 11px;
        }
    </style>
</head>
<body>
    <div class="header">
        <div class="eyebrow">Direccion General de Aviacion Civil del Ecuador</div>
        <h1>Aceptacion Documental AOCR</h1>
        <div class="meta">Solicitud #@(Model != null ? Model.CodigoSolicitud.ToString() : "0")</div>
    </div>

    <div class="panel">
        <h2>Constancia</h2>
        <p>
            Por medio del presente se deja constancia de que la documentacion presentada dentro del tramite AOCR fue revisada
            y aceptada para cierre de la fase documental.
        </p>
        <table class="grid">
            <tr>
                <td>Operador / compania</td>
                <td>@(string.IsNullOrWhiteSpace(operador) ? "No registrado" : operador)</td>
            </tr>
            <tr>
                <td>Numero de solicitud</td>
                <td>@(Model != null ? (Model.NumeroSolicitud ?? ("AOCR-" + Model.CodigoSolicitud)) : string.Empty)</td>
            </tr>
            <tr>
                <td>Representante tecnico</td>
                <td>@(Model != null ? (Model.RepresentanteLegal ?? Model.TecnicoResponsableNombre ?? "No registrado") : "No registrado")</td>
            </tr>
            <tr>
                <td>Fecha de firma</td>
                <td>@fechaFirma.ToString("dd/MM/yyyy HH:mm")</td>
            </tr>
        </table>
    </div>

    <div class="panel">
        <h2>Documentos aceptados</h2>
        @if (documentos.Any())
        {
            <ul>
                @foreach (var documento in documentos)
                {
                    <li>@documento</li>
                }
            </ul>
        }
        else
        {
            <p>No se encontraron documentos aceptados registrados para esta constancia.</p>
        }
    </div>

    <div class="panel">
        <h2>Observacion de cierre</h2>
        <p>@(string.IsNullOrWhiteSpace(observacion) ? "Sin observaciones adicionales." : observacion)</p>
    </div>

    <div class="signature">
        <div>Firmado por coordinación AOCR:</div>
        <strong>@firmante</strong>
        <div>@fechaFirma.ToString("dd/MM/yyyy HH:mm")</div>
    </div>

    <div class="footnote">
        Documento generado por el sistema AOCR para descarga del expediente documental.
    </div>
</body>
</html>
