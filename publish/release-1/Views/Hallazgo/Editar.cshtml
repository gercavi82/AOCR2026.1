@inherits System.Web.Mvc.WebViewPage<CapaModelo.Hallazgo>
@using CapaModelo
@using System.Web.Mvc
@using System.Web.Mvc.Html
@using System.Web.Optimization

@{
    ViewBag.Title = "Editar Hallazgo";
}

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col-12">
            <h2 class="mb-0">Editar Hallazgo</h2>
            <small class="text-muted">Actualiza la información del hallazgo de forma segura.</small>
        </div>
    </div>

    @if (Model == null)
    {
        <div class="alert alert-danger">No se pudo cargar el hallazgo.</div>
        <a href="@Url.Action("Index", "Hallazgo")" class="btn btn-secondary">Volver</a>
    }
    else
    {
        using (Html.BeginForm("Editar", "Hallazgo", FormMethod.Post, new { autocomplete = "off" }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.CodigoHallazgo)
            @Html.HiddenFor(m => m.CodigoInspeccion)

            @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="mb-3">
                        @Html.LabelFor(m => m.Descripcion, htmlAttributes: new { @class = "form-label" })
                        @Html.TextAreaFor(m => m.Descripcion, new { @class = "form-control", rows = 4, maxlength = "1000", required = "required" })
                        <div class="form-text">Máximo 1000 caracteres.</div>
                        @Html.ValidationMessageFor(m => m.Descripcion, "", new { @class = "text-danger" })
                    </div>

                    <div class="mb-3">
                        @Html.LabelFor(m => m.Criticidad, htmlAttributes: new { @class = "form-label" })
                        @Html.DropDownListFor(m => m.Criticidad,
                            new SelectList(new[] { "LEVE", "MODERADA", "CRITICA" }, Model.Criticidad),
                            "Seleccione...",
                            new { @class = "form-select", required = "required" })
                        @Html.ValidationMessageFor(m => m.Criticidad, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="card-footer d-flex justify-content-end gap-2">
                    <a href="@Url.Action("Index", "Hallazgo", new { inspeccionId = Model.CodigoInspeccion })" class="btn btn-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-primary">Actualizar</button>
                </div>
            </div>
        }
    }
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}


