@model CapaModelo.NoConformidad
@{
    ViewBag.Title = "Subsanación documental";
    Layout = "~/Views/Shared/_LayoutAOCR.cshtml";
}

<div class="container mt-4">
    <div class="alert alert-warning shadow-sm">
        <h4><i class="fas fa-exclamation-triangle"></i> Formulario retirado</h4>
        <p>La carga de un PDF general ya no está habilitada. Debe cargar una nueva versión para cada documento observado.</p>
        <a class="btn btn-warning" href="@Url.Action("Subsanar", "SolicitudAOCR", new { id = Model.CodigoSolicitud })">
            Ir a subsanación individual
        </a>
    </div>
</div>
