@model CapaModelo.DocumentosFinalesViewModel
@{ ViewBag.Title = "Documentos finales"; Layout = "~/Views/Shared/_LayoutAOCR.cshtml"; }
<style>
    .ac12-card{border:1px solid #d9e2ec;border-radius:8px;padding:16px;margin-bottom:14px;background:#fff}
    .ac12-card:focus-within{outline:3px solid #2b6cb0;outline-offset:2px}.ac12-download{min-height:44px}
    @@media(max-width:767px){.ac12-table{display:none}.ac12-download{display:block;width:100%;margin-top:12px}}
    @@media(min-width:768px){.ac12-cards{display:none}}
</style>
<section aria-labelledby="titulo-documentos-finales">
    <h2 id="titulo-documentos-finales">Documentos finales</h2>
    <p class="text-muted">Los estados de disponibilidad y correo se muestran por separado.</p>
    @if (Model == null || Model.Documentos == null || Model.Documentos.Count == 0) { <div class="alert alert-info" role="status">No existen documentos finales disponibles para la compañía activa.</div> }
    else {
        <div class="table-responsive ac12-table"><table class="table table-striped"><thead><tr><th>Solicitud</th><th>Compañía</th><th>Documento</th><th>Versión</th><th>Firma</th><th>Disponibilidad</th><th></th></tr></thead><tbody>
        @foreach(var d in Model.Documentos){<tr><td>@d.NumeroSolicitud</td><td>@d.Compania</td><td>@d.TipoDocumento</td><td>@d.Version</td><td>@d.RolFirmante<br/><small>@(d.FechaFirma.HasValue?d.FechaFirma.Value.ToString("dd/MM/yyyy HH:mm"):"")</small></td><td>@d.EstadoEntrega<br/><small>Correo: @d.EstadoCorreo</small></td><td><a class="btn btn-primary ac12-download" href="@Url.Action("DescargarFinal","Documento",new{documentoId=d.DocumentoId})">Descargar PDF</a></td></tr>}
        </tbody></table></div>
        <div class="ac12-cards">@foreach(var d in Model.Documentos){<article class="ac12-card"><h3>@d.TipoDocumento <small>v@d.Version</small></h3><p><strong>@d.NumeroSolicitud</strong><br/>@d.Compania</p><p>@d.EstadoEntrega<br/><small>Correo: @d.EstadoCorreo</small></p><a class="btn btn-primary ac12-download" href="@Url.Action("DescargarFinal","Documento",new{documentoId=d.DocumentoId})">Descargar PDF</a></article>}</div>
    }
</section>
