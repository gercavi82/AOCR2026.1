@inherits System.Web.Mvc.WebViewPage
@using System.Collections
@using System.Collections.Generic
@using System.Web
@{
    var title = ViewData["Title"] as string ?? ViewBag.PageHeaderTitle as string ?? ViewBag.Title as string ?? string.Empty;
    var subtitle = ViewData["Subtitle"] as string ?? ViewBag.PageHeaderSubtitle as string ?? ViewBag.PageSubtitle as string ?? string.Empty;
    var kicker = ViewData["Kicker"] as string ?? ViewBag.PageHeaderKicker as string ?? string.Empty;
    var breadcrumbs = ViewData["Breadcrumbs"] as IEnumerable ?? ViewBag.PageHeaderBreadcrumbs as IEnumerable;
    var actionsHtml = ViewData["ActionsHtml"] as IHtmlString ?? ViewBag.PageHeaderActions as IHtmlString;
    var controllerName = ViewContext.RouteData.Values["controller"] as string ?? string.Empty;
    var controllerLabel = controllerName;
    Func<object, string, string> getBreadcrumbValue = (source, propertyName) =>
    {
        if (source == null || string.IsNullOrWhiteSpace(propertyName))
        {
            return string.Empty;
        }

        var dictionaryString = source as IDictionary<string, string>;
        if (dictionaryString != null && dictionaryString.ContainsKey(propertyName))
        {
            return dictionaryString[propertyName] ?? string.Empty;
        }

        var dictionaryObject = source as IDictionary<string, object>;
        if (dictionaryObject != null && dictionaryObject.ContainsKey(propertyName))
        {
            return dictionaryObject[propertyName] != null ? dictionaryObject[propertyName].ToString() : string.Empty;
        }

        var property = source.GetType().GetProperty(propertyName);
        if (property == null)
        {
            return string.Empty;
        }

        var value = property.GetValue(source, null);
        return value != null ? value.ToString() : string.Empty;
    };

    if (string.Equals(controllerName, "CoordinacionJefatura", StringComparison.OrdinalIgnoreCase)) { controllerLabel = "Coordinacion y Jefatura"; }
    else if (string.Equals(controllerName, "SolicitudAOCR", StringComparison.OrdinalIgnoreCase)) { controllerLabel = "Solicitudes AOCR"; }
    else if (string.Equals(controllerName, "Direccion", StringComparison.OrdinalIgnoreCase)) { controllerLabel = "Direccion / Jefatura"; }
    else if (string.Equals(controllerName, "Tecnico", StringComparison.OrdinalIgnoreCase)) { controllerLabel = "Asignacion de Inspector"; }
    else if (string.Equals(controllerName, "Financiero", StringComparison.OrdinalIgnoreCase)) { controllerLabel = "Financiero"; }
    else if (string.Equals(controllerName, "Dashboard", StringComparison.OrdinalIgnoreCase)) { controllerLabel = "Dashboard"; }
}
<div class="aocr-page-header aocr-module-header">
    <div class="aocr-page-header__main aocr-module-header-left">
        @if (!string.IsNullOrWhiteSpace(kicker))
        {
            <div class="aocr-page-kicker"><i class="fas fa-landmark"></i><span>@kicker</span></div>
        }
        @if (!string.IsNullOrWhiteSpace(title))
        {
            <h1 class="aocr-page-title aocr-module-header-title">@Html.Raw(HttpUtility.HtmlEncode(title))</h1>
        }
        @if (!string.IsNullOrWhiteSpace(subtitle))
        {
            <p class="aocr-page-subtitle aocr-module-header-subtitle">@Html.Raw(HttpUtility.HtmlEncode(subtitle))</p>
        }
    </div>
    <div class="aocr-page-header__meta aocr-module-header-right">
        @if (actionsHtml != null)
        {
            <div class="aocr-page-actions">@actionsHtml</div>
        }
        <div class="aocr-breadcrumb-wrap">
            <ol class="aocr-page-breadcrumb aocr-breadcrumb breadcrumb mb-0" aria-label="Ruta de navegacion">
                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")"><i class="fas fa-home"></i></a></li>
                @if (breadcrumbs != null)
                {
                    foreach (var crumb in breadcrumbs)
                    {
                        var text = getBreadcrumbValue(crumb, "Text");
                        var url = getBreadcrumbValue(crumb, "Url");
                        if (!string.IsNullOrWhiteSpace(url))
                        {
                            <li class="breadcrumb-item"><a href="@url">@text</a></li>
                        }
                        else if (!string.IsNullOrWhiteSpace(text))
                        {
                            <li class="breadcrumb-item active" aria-current="page">@text</li>
                        }
                    }
                }
                else
                {
                    if (!string.IsNullOrWhiteSpace(controllerLabel) && !string.Equals(controllerName, "Home", StringComparison.OrdinalIgnoreCase))
                    {
                        <li class="breadcrumb-item">@controllerLabel</li>
                    }
                    if (!string.IsNullOrWhiteSpace(title))
                    {
                        <li class="breadcrumb-item active" aria-current="page">@title</li>
                    }
                }
            </ol>
        </div>
    </div>
</div>
