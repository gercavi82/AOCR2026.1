@using CapaNegocio.Helpers

@{
    Layout = null;

    var assets = PdfBrandingHelper.ResolveAssets("Views/Shared/_PdfBrandingFooter.cshtml");
    var appPath = (Request != null && Request.ApplicationPath != null && Request.ApplicationPath != "/")
        ? Request.ApplicationPath.TrimEnd('/')
        : string.Empty;
    var baseUrl = (Request != null && Request.Url != null)
        ? Request.Url.Scheme + "://" + Request.Url.Authority + appPath
        : null;

    var footerSrc = baseUrl != null
        ? baseUrl + "/Content/assets/imganes/pdf/footer.png"
        : assets.FooterDataUri;

    if (string.IsNullOrWhiteSpace(footerSrc) && assets.FooterExists)
    {
        footerSrc = "file:///" + (assets.FooterPhysicalPath ?? string.Empty).Replace('\\', '/');
    }
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <style>
        html, body {
            margin: 0;
            padding: 0;
            background: transparent;
        }

        .pdf-footer {
            width: 100%;
            text-align: center;
            line-height: 0;
        }

        .pdf-footer img {
            display: block;
            width: 210mm;
            max-width: 210mm;
            height: auto;
            margin: 0 auto;
        }
    </style>
</head>
<body>
    <div class="pdf-footer">
        @if (!string.IsNullOrWhiteSpace(footerSrc))
        {
            <img src="@footerSrc" alt="Footer institucional DGAC" />
        }
    </div>
</body>
</html>
