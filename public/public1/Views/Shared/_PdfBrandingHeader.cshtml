@using CapaNegocio.Helpers

@{
    Layout = null;

    var assets = PdfBrandingHelper.ResolveAssets("Views/Shared/_PdfBrandingHeader.cshtml");
    var appPath = (Request != null && Request.ApplicationPath != null && Request.ApplicationPath != "/")
        ? Request.ApplicationPath.TrimEnd('/')
        : string.Empty;
    var baseUrl = (Request != null && Request.Url != null)
        ? Request.Url.Scheme + "://" + Request.Url.Authority + appPath
        : null;

    var headerSrc = baseUrl != null
        ? baseUrl + "/Content/assets/imganes/pdf/header.png"
        : assets.HeaderDataUri;

    if (string.IsNullOrWhiteSpace(headerSrc) && assets.HeaderExists)
    {
        headerSrc = "file:///" + (assets.HeaderPhysicalPath ?? string.Empty).Replace('\\', '/');
    }
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <style>
        html, body {
            margin: 0;
            padding: 0;
            background: transparent;
        }

        .pdf-header {
            width: 100%;
            text-align: center;
            line-height: 0;
        }

        .pdf-header img {
            display: block;
            width: 210mm;
            max-width: 210mm;
            height: auto;
            margin: 0 auto;
        }
    </style>
</head>
<body>
    <div class="pdf-header">
        @if (!string.IsNullOrWhiteSpace(headerSrc))
        {
            <img src="@headerSrc" alt="Header institucional DGAC" />
        }
    </div>
</body>
</html>
