@model System.Collections.Generic.List<CapaModelo.SolicitudAOCR>
@{ ViewBag.Title="Documentos finales por revisar"; Layout="~/Views/Shared/_LayoutAOCR.cshtml"; }
<div class="container-fluid py-3">
    <h1>Revisión del Coordinador</h1>
    <p>Revise las LV, informes firmados y documentos CL y AOCR antes de remitir el paquete a DCAV.</p>
    @if(Model.Count==0) { <div class="alert alert-info">No hay paquetes pendientes de revisión.</div> }
    @foreach(var s in Model) {
        <div class="card mb-3"><div class="card-body">
            <strong>@s.NumeroSolicitud</strong> <span>@s.RazonSocial</span>
            <a class="btn btn-primary" href="@Url.Action("Index",new{solicitudId=s.CodigoSolicitud})">Revisar CL y AOCR</a>
        </div></div>
    }
</div>
