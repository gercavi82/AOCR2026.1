@inherits System.Web.Mvc.WebViewPage<System.Collections.Generic.List<CapaPresentacion.Models.CoordinacionJefaturaInspeccionSeguimientoItemViewModel>>
@using System
@using System.Linq
@using System.Web.Mvc
@using System.Web.Mvc.Html
@{
    var items = Model ?? new System.Collections.Generic.List<CapaPresentacion.Models.CoordinacionJefaturaInspeccionSeguimientoItemViewModel>();
    var puedeDecidirRevision = (bool)(ViewData["puedeDecidirRevision"] ?? false);
    var puedeAsignarInspectorRevision = (bool)(ViewData["puedeAsignarInspectorRevision"] ?? false);
    var puedeVerDetalleInspeccion = (bool)(ViewData["puedeVerDetalleInspeccion"] ?? false);
    var returnUrlRevision = (string)(ViewData["returnUrlRevision"] ?? "");

    // Conteos por estado para los chips
    Func<string, int> cont = (estado) => items.Count(x =>
        string.Equals((x.EstadoNormalizado ?? "").Trim(), estado, StringComparison.OrdinalIgnoreCase));
    var cntAceptada = cont(CapaDatos.Constants.EstadosInspeccion.ACEPTADA);
    var cntObservada = cont(CapaDatos.Constants.EstadosInspeccion.OBSERVADA);
    var cntEnInspeccion = cont(CapaDatos.Constants.EstadosInspeccion.EN_INSPECCION);
    var cntInforme = cont(CapaDatos.Constants.EstadosInspeccion.INFORME_ELABORADO);
}

<div class="rv-pane-header">
    <div>
        <h3 class="rv-pane-title"><i class="fas fa-user-check"></i> Inspecciones en seguimiento</h3>
        <p class="rv-pane-sub">Seguimiento coordinado de inspecciones asociadas al flujo AOCR institucional.</p>
    </div>
    @Html.Partial("_StatusBadge", null, new ViewDataDictionary { { "Estado", items.Any() ? "En seguimiento" : "Completado" } })
</div>

@if (!items.Any())
{
    @Html.Partial("_EmptyState", null, new ViewDataDictionary {
        { "Icon", "fas fa-user-check" },
        { "Title", "Sin inspecciones en seguimiento" },
        { "Description", "No existen inspecciones activas en la bandeja de coordinación y jefatura." }
    })
}
else
{
    <!-- Filtros rápidos por estado -->
    <div class="rv-quick-filters mb-3" role="group" aria-label="Filtros rápidos por estado">
        <button type="button" class="rv-chip active" data-rv-filter="ALL">
            <i class="fas fa-layer-group"></i> Todas <span class="rv-chip__count">@items.Count</span>
        </button>
        <button type="button" class="rv-chip rv-chip--success" data-rv-filter="@CapaDatos.Constants.EstadosInspeccion.ACEPTADA">
            <i class="fas fa-check-circle"></i> Aceptada <span class="rv-chip__count">@cntAceptada</span>
        </button>
        <button type="button" class="rv-chip rv-chip--danger" data-rv-filter="@CapaDatos.Constants.EstadosInspeccion.OBSERVADA">
            <i class="fas fa-circle-exclamation"></i> Observada <span class="rv-chip__count">@cntObservada</span>
        </button>
        <button type="button" class="rv-chip rv-chip--info" data-rv-filter="@CapaDatos.Constants.EstadosInspeccion.EN_INSPECCION">
            <i class="fas fa-clipboard-check"></i> En inspección <span class="rv-chip__count">@cntEnInspeccion</span>
        </button>
        <button type="button" class="rv-chip rv-chip--primary" data-rv-filter="@CapaDatos.Constants.EstadosInspeccion.INFORME_ELABORADO">
            <i class="fas fa-file-lines"></i> Informe elaborado <span class="rv-chip__count">@cntInforme</span>
        </button>
    </div>

<style>
#tblInspeccionesSeguimiento { width:100%!important; min-width:1150px; table-layout:fixed; }
#tblInspeccionesSeguimiento th:nth-child(1) { width:25%!important; }
#tblInspeccionesSeguimiento th:nth-child(2) { width:18%!important; }
#tblInspeccionesSeguimiento th:nth-child(3) { width:15%!important; }
#tblInspeccionesSeguimiento th:nth-child(4) { width:20%!important; }
#tblInspeccionesSeguimiento th:nth-child(5) { width:22%!important; text-align:center!important; }
#tblInspeccionesSeguimiento td:last-child { text-align:center!important; }
#tblInspeccionesSeguimiento .rv-row-actions, #tblInspeccionesSeguimiento .rv-row-actions * { box-sizing:border-box; }
#tblInspeccionesSeguimiento .rv-row-actions { max-width:280px; margin-inline:auto!important; }
#tblInspeccionesSeguimiento .rv-row-actions .btn { flex:none!important; -webkit-text-fill-color:currentColor!important; }
#tblInspeccionesSeguimiento .rv-reference { margin-top:10px; padding-top:8px; border-top:1px solid #dce6ef; font-size:13px; }
#tblInspeccionesSeguimiento .rv-reference-label { font-size:11px; color:#425a70; display:block; margin-bottom:3px; }
#tblInspeccionesSeguimiento tbody tr:hover td { background:#f3f7fb; }
#tblInspeccionesSeguimiento td { padding:14px 12px!important; vertical-align:middle; white-space:normal!important; overflow-wrap:anywhere; color:#163c59; }
#tblInspeccionesSeguimiento td .text-muted { color:#425a70!important; -webkit-text-fill-color:#425a70!important; }
#tblInspeccionesSeguimiento .rv-context { display:block; max-height:none; -webkit-line-clamp:unset; overflow:visible; color:#344b60; line-height:1.5; }
#tblInspeccionesSeguimiento .rv-row-actions { display:grid!important; grid-template-columns:repeat(2,minmax(0,1fr)); gap:6px; width:100%; margin:0; }
#tblInspeccionesSeguimiento .rv-row-actions form { display:block!important; width:100%!important; max-width:none!important; margin:0!important; }
#tblInspeccionesSeguimiento .rv-row-actions .btn { display:flex!important; align-items:center; justify-content:center; gap:5px; width:100%!important; min-width:0; min-height:34px; margin:0!important; border-radius:6px!important; padding:6px!important; font-size:12px; white-space:normal; }
#tblInspeccionesSeguimiento .rv-row-actions .btn i { color:inherit!important; -webkit-text-fill-color:currentColor!important; }
#tblInspeccionesSeguimiento .rv-row-actions .btn-outline-info { color:#09677d!important; background:#fff; border-color:#09677d; }
#tblInspeccionesSeguimiento .rv-row-actions .btn-outline-primary { color:#0752a0!important; background:#fff; border-color:#0752a0; }
#tblInspeccionesSeguimiento .rv-row-actions .btn-outline-success { color:#087647!important; background:#fff; border-color:#087647; }
#tblInspeccionesSeguimiento .rv-row-actions .btn-outline-danger { color:#b42337!important; background:#fff; border-color:#b42337; }
#tblInspeccionesSeguimiento .rv-row-actions .btn-outline-dark { color:#344b5f!important; background:#fff; border-color:#344b5f; }
</style>
    <div class="table-responsive aocr-table-wrap">
        <table id="tblInspeccionesSeguimiento" class="table aocr-table aocr-datatable align-middle mb-0" style="width:100%">
            <thead>
                <tr>
                    <th>Inspección / solicitud</th>
                    <th style="width:14%">Etapa</th>
                    <th style="width:12%">Inspector</th>
                    <th style="width:22%">Contexto</th>
                    <th style="width:20%" class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in items)
                {
                    var inspeccion = item.Inspeccion;
                    if (inspeccion == null) { continue; }
                    var hayAccionesFila = (puedeDecidirRevision && (item.PuedeAceptarSolicitud || item.PuedeObservar || item.PuedeCerrar));
                    var estadoNorm = (item.EstadoNormalizado ?? "").Trim().ToUpperInvariant();
                    var inspectorPendienteAsignacion = string.Equals(item.InspectorAsignado, "No asignado", StringComparison.OrdinalIgnoreCase);
                    var urlDetalle = Url.Action("Detalle", "Inspeccion", new { id = inspeccion.CodigoInspeccion });
                    <tr data-rv-estado="@estadoNorm">
                        <td>
                            <div class="fw-semibold text-primary">@item.NumeroInspeccion</div>
                            <small class="text-muted">Código @inspeccion.CodigoInspeccion</small>
                            <div class="rv-reference">
                                <span class="rv-reference-label">Solicitud / compañía</span>
                                <div class="fw-semibold">@item.NumeroSolicitud</div>
                                <small class="text-muted">@item.OperadorNombre</small>
                            </div>
                        </td>
                        <td>
                            @Html.Partial("_StatusBadge", null, new ViewDataDictionary { { "Estado", item.EtapaActual } })
                            <div class="small text-muted mt-1">@item.EstadoNormalizado</div>
                        </td>
                        <td>
                            @if (inspectorPendienteAsignacion)
                            {
                                <div class="text-warning fw-semibold">Pendiente de asignación</div>
                                if (puedeAsignarInspectorRevision && item.PuedeAsignarInspector)
                                {
                                    <small class="text-muted">Gestione la asignación desde el menú Coordinador &gt; Asignación de Inspectores.</small>
                                }
                            }
                            else
                            {
                                <div class="fw-semibold">@item.InspectorAsignado</div>
                            }
                        </td>
                        <td>
                            <div class="rv-context" title="@CapaPresentacion.Helpers.VisibleTextHelper.Normalize(item.MensajeOperativo)">@CapaPresentacion.Helpers.VisibleTextHelper.Normalize(item.MensajeOperativo)</div>
                            @if (!string.IsNullOrWhiteSpace(item.ResumenAcciones))
                            {
                                <div class="small text-primary mt-1">@CapaPresentacion.Helpers.VisibleTextHelper.Normalize(item.ResumenAcciones)</div>
                            }
                        </td>
                        <td class="text-end">
                            <div class="btn-group btn-group-sm rv-row-actions" role="group">
                                @if (puedeDecidirRevision && item.PuedeAceptarSolicitud)
                                {
                                    using (Html.BeginForm("CambiarEstado", "Inspeccion", FormMethod.Post, new { @class = "d-inline" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        @Html.Hidden("id", inspeccion.CodigoInspeccion)
                                        @Html.Hidden("estado", CapaDatos.Constants.EstadosInspeccion.ACEPTADA)
                                        @Html.Hidden("returnUrl", returnUrlRevision)
                                        <button type="submit" class="btn btn-outline-success" title="Aceptar"><i class="fas fa-check" aria-hidden="true"></i> Aceptar</button>
                                    }
                                }
                                @if (puedeDecidirRevision && item.PuedeObservar)
                                {
                                    using (Html.BeginForm("CambiarEstado", "Inspeccion", FormMethod.Post, new { @class = "d-inline" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        @Html.Hidden("id", inspeccion.CodigoInspeccion)
                                        @Html.Hidden("estado", CapaDatos.Constants.EstadosInspeccion.OBSERVADA)
                                        @Html.Hidden("returnUrl", returnUrlRevision)
                                        <button type="submit" class="btn btn-outline-danger" title="Observar"><i class="fas fa-circle-exclamation" aria-hidden="true"></i> Observar</button>
                                    }
                                }
                                @if (puedeDecidirRevision && item.PuedeCerrar)
                                {
                                    using (Html.BeginForm("CambiarEstado", "Inspeccion", FormMethod.Post, new { @class = "d-inline" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        @Html.Hidden("id", inspeccion.CodigoInspeccion)
                                        @Html.Hidden("estado", CapaDatos.Constants.EstadosInspeccion.CERRADA)
                                        @Html.Hidden("returnUrl", returnUrlRevision)
                                        <button type="submit" class="btn btn-outline-dark" title="Cerrar"><i class="fas fa-xmark" aria-hidden="true"></i> Cerrar</button>
                                    }
                                }
                                <button type="button" class="btn btn-outline-info rv-quick-view"
                                        title="Vista rápida"
                                        data-bs-toggle="offcanvas"
                                        data-bs-target="#rvInspeccionPanel"
                                        data-insp-numero="@item.NumeroInspeccion"
                                        data-insp-codigo="@inspeccion.CodigoInspeccion"
                                        data-insp-solicitud="@item.NumeroSolicitud"
                                        data-insp-operador="@item.OperadorNombre"
                                        data-insp-etapa="@item.EtapaActual"
                                        data-insp-estado="@item.EstadoNormalizado"
                                        data-insp-inspector="@item.InspectorAsignado"
                                        data-insp-mensaje="@CapaPresentacion.Helpers.VisibleTextHelper.Normalize(item.MensajeOperativo)"
                                        data-insp-resumen="@CapaPresentacion.Helpers.VisibleTextHelper.Normalize(item.ResumenAcciones)"
                                        data-insp-detalle-url="@urlDetalle">
                                    <i class="fas fa-bolt" aria-hidden="true"></i> Vista rápida
                                </button>
                                @if (puedeVerDetalleInspeccion)
                                {
                                    <a class="btn btn-outline-primary" title="Ver detalle" href="@urlDetalle"><i class="fas fa-eye" aria-hidden="true"></i> Detalle</a>
                                }
                            </div>
                            @if (!hayAccionesFila && !puedeVerDetalleInspeccion)
                            {
                                <div class="small text-muted mt-1">@CapaPresentacion.Helpers.VisibleTextHelper.Normalize(item.MensajeSinAcciones)</div>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
