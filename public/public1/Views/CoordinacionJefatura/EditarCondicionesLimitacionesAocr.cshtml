@inherits System.Web.Mvc.WebViewPage<CapaPresentacion.Models.AocrDocumentoEdicionViewModel>
@using System.Collections.Generic
@using CapaPresentacion.Models
@using System.Web.Mvc
@using System.Web.Mvc.Html

@{
    Layout = "~/Views/Shared/_LayoutAOCR.cshtml";
    ViewBag.Title = "Completar Condiciones y Limitaciones AOCR";
    var filas = Model != null ? Model.AeronavesCondiciones ?? new List<AocrCondicionAeronaveFilaViewModel>() : new List<AocrCondicionAeronaveFilaViewModel>();
    var puedeFirmarDigitalmente = User.IsInRole("Administrador")
        || User.IsInRole("DIRDAC")
        || User.IsInRole("Direccion")
        || User.IsInRole("DirectorGeneral")
        || User.IsInRole("DireccionJefaturaTecnica")
        || User.IsInRole("JefaturaTecnica");
    var urlGenerarDocumento = Url.Action("GenerarDocumentoValidacionAocr", "CoordinacionJefatura");
    var urlFirmarDocumento = Url.Action("FirmarCondiciones", "CoordinacionJefatura", new { solicitudId = Model.SolicitudId });
}

@* ── Page toolbar ── *@
<div class="aocr-section-card card shadow-sm border-0 mb-3">
    <div class="card-body d-flex flex-column flex-lg-row justify-content-between gap-3 align-items-lg-center py-3">
        <div>
            <h2 class="h4 fw-bold mb-1">Completar Condiciones y Limitaciones AOCR</h2>
            <p class="text-muted mb-0 small">Edite las condiciones operativas y luego genere el PDF para su revisión y firma.</p>
        </div>
        <div class="d-flex gap-2 flex-shrink-0 flex-wrap">
            <a class="btn btn-outline-secondary btn-sm" href="@Url.Action("ValidarAocr", "CoordinacionJefatura", new { solicitudId = Model.SolicitudId })">
                <i class="fas fa-arrow-left me-1"></i>Volver a la bandeja
            </a>
            <a class="btn btn-outline-dark btn-sm" href="@Url.Action("Detalle", "SolicitudAOCR", new { id = Model.SolicitudId })">
                <i class="fas fa-folder-open me-1"></i>Abrir trámite
            </a>
        </div>
    </div>
</div>

@using (Html.BeginForm("FirmarCondiciones", "CoordinacionJefatura", FormMethod.Post, new { enctype = "multipart/form-data", id = "frmFirmarAocr", data_generar_action = urlGenerarDocumento, data_firmar_action = urlFirmarDocumento }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.SolicitudId)
    @Html.HiddenFor(m => m.InspeccionId)
    @Html.HiddenFor(m => m.TipoDocumento)
    @Html.HiddenFor(m => m.NumeroAocr)
    @Html.HiddenFor(m => m.NombreDocumento)
    @Html.HiddenFor(m => m.UsaPosicionFirmaPersonalizada)
    @Html.HiddenFor(m => m.NumeroPaginaFirma)
    @Html.HiddenFor(m => m.PosicionFirmaX)
    @Html.HiddenFor(m => m.PosicionFirmaY)
    @Html.HiddenFor(m => m.AnchoFirma)
    @Html.HiddenFor(m => m.AltoFirma)

    @* ── Datos operativos ── *@
    <div class="aocr-form-card card shadow-sm border-0 mb-3">
        <div class="card-header bg-white border-bottom-0 pt-3 pb-0">
            <h5 class="fw-semibold mb-0"><i class="fas fa-clipboard-list text-primary me-2"></i>Datos operativos</h5>
        </div>
        <div class="card-body pt-2">
            <div class="row g-3 mb-3">
                <div class="col-xl-3 col-lg-3 col-md-6">
                    <label class="form-label fw-semibold">Número AOCR</label>
                    @Html.TextBoxFor(m => m.NumeroAocr, new { @class = "form-control", @readonly = "readonly" })
                </div>
                <div class="col-xl-3 col-lg-3 col-md-6">
                    <label class="form-label fw-semibold">Fecha emisión documento</label>
                    @Html.TextBoxFor(m => m.FechaEmisionDocumento, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                </div>
                <div class="col-xl-3 col-lg-3 col-md-6">
                    <label class="form-label fw-semibold">Fecha renovación</label>
                    @Html.TextBoxFor(m => m.FechaRenovacion, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                </div>
                <div class="col-xl-3 col-lg-3 col-md-6">
                    <label class="form-label fw-semibold">Fecha vencimiento</label>
                    @Html.TextBoxFor(m => m.FechaVencimiento, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                </div>
            </div>
            <div class="row g-3 mb-3">
                <div class="col-lg-4 col-md-6">
                    <label class="form-label fw-semibold">Representante técnico</label>
                    @Html.TextBoxFor(m => m.RepresentanteTecnico, new { @class = "form-control" })
                </div>
                <div class="col-lg-8 col-md-6">
                    <label class="form-label fw-semibold">Condición base de operación</label>
                    @Html.TextAreaFor(m => m.CondicionBaseOperacion, new { @class = "form-control", rows = "2" })
                </div>
            </div>
            <div class="row g-3 mb-3">
                <div class="col-lg-6 col-md-6">
                    <label class="form-label fw-semibold">Restricciones / condiciones</label>
                    @Html.TextAreaFor(m => m.RestriccionesCondiciones, new { @class = "form-control", rows = "4" })
                </div>
                <div class="col-lg-6 col-md-6">
                    <label class="form-label fw-semibold">Condiciones adicionales</label>
                    @Html.TextAreaFor(m => m.CondicionesAdicionales, new { @class = "form-control", rows = "4" })
                </div>
            </div>
            <div class="row g-3">
                <div class="col-12">
                    <label class="form-label fw-semibold">Observaciones de validación final</label>
                    @Html.TextAreaFor(m => m.ObservacionesValidacionFinal, new { @class = "form-control", rows = "3", placeholder = "Conformidad interna, oficio, limitaciones finales o notas para la firma." })
                </div>
            </div>
        </div>
    </div>

    @* ── Flota habilitada ── *@
    <div class="aocr-table-card card shadow-sm border-0 mb-3">
        <div class="card-header bg-white border-bottom-0 pt-3 pb-0">
            <h5 class="fw-semibold mb-0"><i class="fas fa-plane text-primary me-2"></i>Flota habilitada</h5>
        </div>
        <div class="card-body pt-2">
            <div class="table-responsive">
                <table class="table table-bordered align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Modelo y tipo</th>
                            <th>Matrícula</th>
                            <th>Serie</th>
                            <th>UIO</th>
                            <th>GYE</th>
                            <th>MEC</th>
                            <th>LTX</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (var i = 0; i < filas.Count; i++)
                        {
                            <tr>
                                <td>@Html.TextBoxFor(m => m.AeronavesCondiciones[i].ModeloTipo, new { @class = "form-control form-control-sm" })</td>
                                <td>@Html.TextBoxFor(m => m.AeronavesCondiciones[i].Matricula, new { @class = "form-control form-control-sm" })</td>
                                <td>@Html.TextBoxFor(m => m.AeronavesCondiciones[i].Serie, new { @class = "form-control form-control-sm" })</td>
                                <td>@Html.TextBoxFor(m => m.AeronavesCondiciones[i].Uio, new { @class = "form-control form-control-sm text-center" })</td>
                                <td>@Html.TextBoxFor(m => m.AeronavesCondiciones[i].Gye, new { @class = "form-control form-control-sm text-center" })</td>
                                <td>@Html.TextBoxFor(m => m.AeronavesCondiciones[i].Mec, new { @class = "form-control form-control-sm text-center" })</td>
                                <td>@Html.TextBoxFor(m => m.AeronavesCondiciones[i].Ltx, new { @class = "form-control form-control-sm text-center" })</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @* ── Firmas y responsables ── *@
    <div class="aocr-form-card card shadow-sm border-0 mb-3">
        <div class="card-header bg-white border-bottom-0 pt-3 pb-0">
            <h5 class="fw-semibold mb-0"><i class="fas fa-signature text-primary me-2"></i>Firmas y responsables</h5>
        </div>
        <div class="card-body pt-2">
            <div class="row g-3">
                <div class="col-xl-3 col-md-6">
                    <label class="form-label fw-semibold">Fecha expedición</label>
                    @Html.TextBoxFor(m => m.FechaExpedicion, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                </div>
                <div class="col-xl-3 col-md-6">
                    <label class="form-label fw-semibold">Elaborado por</label>
                    @Html.TextBoxFor(m => m.ElaboradoPor, new { @class = "form-control" })
                </div>
                <div class="col-xl-3 col-md-6">
                    <label class="form-label fw-semibold">Revisado por</label>
                    @Html.TextBoxFor(m => m.RevisadoPor, new { @class = "form-control" })
                </div>
                <div class="col-xl-3 col-md-6">
                    <label class="form-label fw-semibold">Firmante final</label>
                    @Html.TextBoxFor(m => m.FirmanteNombre, new { @class = "form-control" })
                </div>
                <div class="col-lg-6 col-md-12">
                    <label class="form-label fw-semibold">Cargo firmante</label>
                    @Html.TextBoxFor(m => m.FirmanteCargo, new { @class = "form-control" })
                </div>
            </div>
            <hr class="my-3" />
            <div class="row g-3">
                <div class="col-lg-5 col-md-6">
                    <label class="form-label fw-semibold">Certificado digital (.p12 / .pfx)</label>
                    <input type="file" name="certificadoDigital" id="certificadoDigital" class="form-control" accept=".p12,.pfx" />
                </div>
                <div class="col-lg-4 col-md-6">
                    <label class="form-label fw-semibold">Contraseña del certificado</label>
                    <input type="password" name="passwordCertificado" id="passwordCertificado" class="form-control" autocomplete="off" />
                </div>
                <div class="col-lg-3 col-md-12 d-flex align-items-end">
                    <button type="button" class="btn btn-outline-info w-100" id="btnCargarFirmaDigital">
                        <i class="fas fa-key me-1"></i>Cargar certificado
                    </button>
                </div>
                <div class="col-12">
                    <div id="firmaDigitalStatus" class="alert alert-secondary mb-0 small">
                        <i class="fas fa-info-circle me-1"></i>Cargue el archivo .p12/.pfx y su contraseña para autocompletar el firmante o firmar digitalmente el PDF. Si hay un certificado institucional configurado, puede dejar vacíos estos campos y el sistema lo usará al firmar.
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* ── Firma por puntero ── *@
    <div class="aocr-section-card card shadow-sm border-0 mb-3">
        <div class="card-header bg-white border-bottom-0 pt-3 pb-0">
            <h5 class="fw-semibold mb-0"><i class="fas fa-crosshairs text-primary me-2"></i>Firma por puntero</h5>
        </div>
        <div class="card-body pt-2">
            <p class="text-muted small mb-3">Use la vista previa del documento real para mover el bloque de firma. El sistema conservará la posición guardada para este documento AOCR.</p>
            <div class="row g-4 align-items-start">
                <div class="col-lg-7">
                    <div class="aocr-sign-preview-wrap">
                        <div class="aocr-sign-preview-stage" id="firmaPreviewStage">
                            <iframe src="@Url.Action("PreviewDocumentoValidacionAocr", "CoordinacionJefatura", new { solicitudId = Model.SolicitudId, tipo = Model.TipoDocumento })" class="aocr-sign-preview-frame" title="Vista previa firma AOCR"></iframe>
                            <div class="aocr-sign-preview-overlay" id="firmaPreviewOverlay">
                                <div class="aocr-sign-stamp" id="firmaStampProxy">
                                    <div>QR</div>
                                    <small>Firma autorizada</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-5">
                    <div class="row g-3">
                        <div class="col-12">
                            <div id="firmaPosicionStatus" class="alert alert-secondary mb-0 small">La posición inicial replica la configuración fija actual. Puede dejarla así o moverla antes de firmar.</div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Ancho del bloque</label>
                            <input type="range" class="form-range" id="firmaWidthRange" min="0.55" max="1.00" step="0.01" />
                            <div class="small text-muted" id="firmaWidthValue"></div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Alto del bloque</label>
                            <input type="range" class="form-range" id="firmaHeightRange" min="0.45" max="1.00" step="0.01" />
                            <div class="small text-muted" id="firmaHeightValue"></div>
                        </div>
                        <div class="col-12 d-flex flex-column flex-md-row gap-2">
                            <button type="button" class="btn btn-outline-primary btn-sm" id="btnGuardarPosicionFirma">
                                <i class="fas fa-save me-1"></i>Guardar posición
                            </button>
                            <button type="button" class="btn btn-outline-secondary btn-sm" id="btnRestablecerPosicionFirma">
                                <i class="fas fa-undo me-1"></i>Restablecer ubicación fija
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* ── Acciones finales ── *@
    <div class="d-flex flex-column flex-md-row gap-2 justify-content-end mb-4">
        <button type="submit" name="accion" value="VISUALIZAR" class="btn btn-outline-primary" formaction="@urlGenerarDocumento" formtarget="_blank">
            <i class="fas fa-eye me-1"></i>Vista previa PDF
        </button>
        <button type="submit" name="accion" value="DESCARGAR" class="btn btn-outline-success" formaction="@urlGenerarDocumento" formtarget="_blank">
            <i class="fas fa-download me-1"></i>Descargar PDF
        </button>
        <button type="submit"
                id="btnFirmarAocr"
                name="accion"
                value="FIRMAR_DESCARGAR"
                class="btn btn-dark"
                formaction="@urlFirmarDocumento"
                @(puedeFirmarDigitalmente ? null : Html.Raw("disabled=\"disabled\" title=\"Solo los roles institucionales autorizados pueden firmar digitalmente este documento.\""))>
            <i class="fas fa-file-signature me-1"></i>Firmar oficialmente AOCR
        </button>
    </div>

    if (!puedeFirmarDigitalmente)
    {
        <div class="alert alert-info">
            Puede preparar y descargar la plantilla para revisión interna. La firma digital final queda habilitada solo para los roles institucionales de DCAV/DGAC.
        </div>
    }
}

<script>
    (function () {
        var style = document.createElement('style');
        style.textContent = '.aocr-sign-preview-wrap{max-width:480px}.aocr-sign-preview-stage{position:relative;width:100%;aspect-ratio:210/297;border:1px solid #cfd6de;border-radius:12px;overflow:hidden;background:#f3f5f7}.aocr-sign-preview-frame{width:100%;height:100%;border:0;background:#fff}.aocr-sign-preview-overlay{position:absolute;top:0;left:0;bottom:0;right:16px;cursor:crosshair}.aocr-sign-stamp{position:absolute;left:0;top:0;border:2px dashed #0d6efd;background:rgba(13,110,253,.12);border-radius:10px;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;color:#0d3b8c;font-size:11px;font-weight:600;user-select:none;cursor:move;box-shadow:0 8px 18px rgba(13,110,253,.18)}.aocr-sign-stamp small{font-size:10px;font-weight:500}';
        document.head.appendChild(style);

        var boton = document.getElementById('btnCargarFirmaDigital');
        if (!boton) {
            return;
        }

        var status = document.getElementById('firmaDigitalStatus');
        var form = document.getElementById('frmFirmarAocr');
        var archivo = document.getElementById('certificadoDigital');
        var password = document.getElementById('passwordCertificado');
        var firmante = document.getElementById('FirmanteNombre');
        var cargoFirmante = document.getElementById('FirmanteCargo');
        var btnFirmar = document.getElementById('btnFirmarAocr');
        var previewFrame = document.querySelector('.aocr-sign-preview-frame');
        var overlay = document.getElementById('firmaPreviewOverlay');
        var stage = document.getElementById('firmaPreviewStage');
        var stamp = document.getElementById('firmaStampProxy');
        var savePositionButton = document.getElementById('btnGuardarPosicionFirma');
        var resetPositionButton = document.getElementById('btnRestablecerPosicionFirma');
        var positionStatus = document.getElementById('firmaPosicionStatus');
        var widthRange = document.getElementById('firmaWidthRange');
        var heightRange = document.getElementById('firmaHeightRange');
        var widthValue = document.getElementById('firmaWidthValue');
        var heightValue = document.getElementById('firmaHeightValue');
        var useCustomField = document.getElementById('UsaPosicionFirmaPersonalizada');
        var pageField = document.getElementById('NumeroPaginaFirma');
        var xField = document.getElementById('PosicionFirmaX');
        var yField = document.getElementById('PosicionFirmaY');
        var widthField = document.getElementById('AnchoFirma');
        var heightField = document.getElementById('AltoFirma');
        var fixedState = {
            page: 2,
            x: 0.02,
            y: 0.06,
            width: 0.94,
            height: 0.82
        };
        var defaultState = {
            page: parseInt(pageField.value || fixedState.page, 10) || fixedState.page,
            x: parseFloat(xField.value || fixedState.x),
            y: parseFloat(yField.value || fixedState.y),
            width: parseFloat(widthField.value || fixedState.width),
            height: parseFloat(heightField.value || fixedState.height)
        };
        var dragState = null;

        function cloneState(state) {
            return {
                page: state.page,
                x: state.x,
                y: state.y,
                width: state.width,
                height: state.height
            };
        }

        function mostrarEstado(css, mensaje) {
            status.className = 'alert mb-0 ' + css;
            status.textContent = mensaje;
        }

        function mostrarEstadoPosicion(css, mensaje) {
            if (!positionStatus) {
                return;
            }
            positionStatus.className = 'alert mb-0 ' + css;
            positionStatus.textContent = mensaje;
        }

        function clamp(value, min, max) {
            return Math.max(min, Math.min(max, value));
        }

        function getPreviewScrollTarget() {
            if (!previewFrame || !previewFrame.contentWindow || !previewFrame.contentWindow.document) {
                return null;
            }

            var doc = previewFrame.contentWindow.document;
            return doc.scrollingElement || doc.documentElement || doc.body;
        }

        function getPreviewMetrics() {
            if (!stage) {
                return null;
            }

            var rect = stage.getBoundingClientRect();
            var target = getPreviewScrollTarget();
            var viewportWidth = Math.max(rect.width, 1);
            var viewportHeight = Math.max(rect.height, 1);

            if (!target) {
                return {
                    viewportWidth: viewportWidth,
                    viewportHeight: viewportHeight,
                    pageWidth: viewportWidth,
                    pageHeight: viewportHeight,
                    contentWidth: viewportWidth,
                    contentHeight: viewportHeight,
                    scrollLeft: 0,
                    scrollTop: 0,
                    totalPages: 1
                };
            }

            return {
                viewportWidth: viewportWidth,
                viewportHeight: viewportHeight,
                pageWidth: viewportWidth,
                pageHeight: viewportHeight,
                contentWidth: Math.max(target.scrollWidth, target.clientWidth, viewportWidth),
                contentHeight: Math.max(target.scrollHeight, target.clientHeight, viewportHeight),
                scrollLeft: Math.max(target.scrollLeft || 0, 0),
                scrollTop: Math.max(target.scrollTop || 0, 0),
                totalPages: Math.max(1, Math.ceil(Math.max(target.scrollHeight, target.clientHeight, viewportHeight) / viewportHeight))
            };
        }

        function getSignatureSlotElement() {
            if (!previewFrame || !previewFrame.contentWindow || !previewFrame.contentWindow.document) {
                return null;
            }

            return previewFrame.contentWindow.document.querySelector('.signature-slot');
        }

        function getSignatureSlotMetrics() {
            var slot = getSignatureSlotElement();
            if (!slot) {
                return null;
            }

            var rect = slot.getBoundingClientRect();
            return {
                left: rect.left,
                top: rect.top,
                width: Math.max(rect.width, 1),
                height: Math.max(rect.height, 1)
            };
        }

        function scrollPreviewToPage(pageNumber) {
            var target = getPreviewScrollTarget();
            var slot = getSignatureSlotElement();
            if (!target || !slot) {
                return;
            }

            target.scrollTop = Math.max((slot.offsetTop || 0) - 48, 0);
        }

        function readState() {
            return {
                page: fixedState.page,
                x: clamp(parseFloat(xField.value || defaultState.x), 0, 1),
                y: clamp(parseFloat(yField.value || defaultState.y), 0, 1),
                width: clamp(parseFloat(widthField.value || defaultState.width), parseFloat(widthRange.min), parseFloat(widthRange.max)),
                height: clamp(parseFloat(heightField.value || defaultState.height), parseFloat(heightRange.min), parseFloat(heightRange.max))
            };
        }

        function writeState(state, markCustom) {
            if (markCustom === true) {
                useCustomField.value = 'true';
            } else if (markCustom === false) {
                useCustomField.value = 'false';
            }
            pageField.value = (state.page || fixedState.page).toString();
            xField.value = state.x.toFixed(6);
            yField.value = state.y.toFixed(6);
            widthField.value = state.width.toFixed(6);
            heightField.value = state.height.toFixed(6);
            widthRange.value = state.width.toFixed(6);
            heightRange.value = state.height.toFixed(6);
            widthValue.textContent = 'Ancho relativo: ' + Math.round(state.width * 100) + '%';
            heightValue.textContent = 'Alto relativo: ' + Math.round(state.height * 100) + '%';
        }

        function renderStamp() {
            if (!stage || !stamp) {
                return;
            }

            var state = readState();
            var slot = getSignatureSlotMetrics();
            if (!slot) {
                return;
            }

            var widthPx = slot.width * state.width;
            var heightPx = slot.height * state.height;
            var leftPx = slot.left + ((slot.width - widthPx) * state.x);
            var topPx = slot.top + ((slot.height - heightPx) * state.y);
            stamp.style.width = widthPx + 'px';
            stamp.style.height = heightPx + 'px';
            stamp.style.left = leftPx + 'px';
            stamp.style.top = topPx + 'px';
        }

        function scrollPreview(deltaY) {
            var target = getPreviewScrollTarget();
            if (!target) {
                return false;
            }

            target.scrollTop += deltaY;
            renderStamp();
            return true;
        }

        function placeStampFromPointer(clientX, clientY) {
            if (!stage) {
                return;
            }

            var rect = stage.getBoundingClientRect();
            var slot = getSignatureSlotMetrics();
            if (!slot) {
                return;
            }

            var state = readState();
            var widthPx = slot.width * state.width;
            var heightPx = slot.height * state.height;
            var leftPx = clamp((clientX - rect.left) - slot.left - (widthPx / 2), 0, slot.width - widthPx);
            var topPx = clamp((clientY - rect.top) - slot.top - (heightPx / 2), 0, slot.height - heightPx);
            state.page = fixedState.page;
            state.x = slot.width > widthPx ? (leftPx / (slot.width - widthPx)) : 0;
            state.y = slot.height > heightPx ? (topPx / (slot.height - heightPx)) : 0;
            writeState(state, true);
            renderStamp();
            mostrarEstadoPosicion('alert-info', 'Posicion actualizada. Puede guardar la configuracion o firmar directamente con esta ubicacion.');
        }

        function guardarPosicion(stateOverride, markCustom, successMessage) {
            var state = stateOverride ? cloneState(stateOverride) : readState();
            writeState(state, markCustom !== false);

            var data = new FormData();
            data.append('__RequestVerificationToken', form.querySelector('input[name="__RequestVerificationToken"]').value);
            data.append('SolicitudId', document.getElementById('SolicitudId').value);
            data.append('InspeccionId', document.getElementById('InspeccionId').value || '');
            data.append('TipoDocumento', document.getElementById('TipoDocumento').value);
            data.append('RolFirmante', 'AOCR_FIRMANTE');
            data.append('NumeroPaginaFirma', pageField.value || '1');
            data.append('PosicionFirmaX', state.x.toFixed(6));
            data.append('PosicionFirmaY', state.y.toFixed(6));
            data.append('AnchoFirma', state.width.toFixed(6));
            data.append('AltoFirma', state.height.toFixed(6));

            mostrarEstadoPosicion('alert-info', 'Guardando posicion de firma...');

            fetch('@Url.Action("GuardarPosicionFirmaAocr", "CoordinacionJefatura")', {
                method: 'POST',
                body: data,
                credentials: 'same-origin'
            })
            .then(function (response) {
                return response.json().then(function (json) {
                    if (!response.ok || !json.ok) {
                        throw new Error(json.mensaje || 'No se pudo guardar la posicion de firma.');
                    }
                    return json;
                });
            })
            .then(function (json) {
                defaultState = cloneState(state);
                mostrarEstadoPosicion('alert-success', successMessage || json.mensaje || 'La posicion de firma fue guardada.');
            })
            .catch(function (error) {
                mostrarEstadoPosicion('alert-danger', error.message || 'No se pudo guardar la posicion de firma.');
            });
        }

        if (overlay && stage && stamp) {
            writeState(readState(), false);
            renderStamp();

            overlay.addEventListener('wheel', function (event) {
                if (scrollPreview(event.deltaY)) {
                    event.preventDefault();
                }
            }, { passive: false });

            overlay.addEventListener('click', function (event) {
                if (dragState && dragState.moved) {
                    dragState = null;
                    return;
                }

                if (event.target === stamp || stamp.contains(event.target)) {
                    return;
                }

                placeStampFromPointer(event.clientX, event.clientY);
            });

            stamp.addEventListener('mousedown', function (event) {
                event.preventDefault();
                var stampRect = stamp.getBoundingClientRect();
                dragState = {
                    offsetX: event.clientX - stampRect.left,
                    offsetY: event.clientY - stampRect.top,
                    moved: false
                };
            });

            document.addEventListener('mousemove', function (event) {
                if (!dragState) {
                    return;
                }

                dragState.moved = true;
                var rect = stage.getBoundingClientRect();
                var slot = getSignatureSlotMetrics();
                if (!slot) {
                    return;
                }

                var state = readState();
                var widthPx = slot.width * state.width;
                var heightPx = slot.height * state.height;
                var leftPx = clamp((event.clientX - rect.left) - slot.left - dragState.offsetX, 0, slot.width - widthPx);
                var topPx = clamp((event.clientY - rect.top) - slot.top - dragState.offsetY, 0, slot.height - heightPx);
                state.page = fixedState.page;
                state.x = slot.width > widthPx ? (leftPx / (slot.width - widthPx)) : 0;
                state.y = slot.height > heightPx ? (topPx / (slot.height - heightPx)) : 0;
                writeState(state, true);
                renderStamp();
            });

            document.addEventListener('mouseup', function () {
                if (dragState && dragState.moved) {
                    mostrarEstadoPosicion('alert-info', 'Posicion actualizada. Puede guardar la configuracion o firmar directamente con esta ubicacion.');
                }
                dragState = null;
            });

            window.addEventListener('resize', renderStamp);
            previewFrame.addEventListener('load', function () {
                var target = getPreviewScrollTarget();
                if (target) {
                    target.addEventListener('scroll', renderStamp);
                }
                scrollPreviewToPage(readState().page || fixedState.page);
                renderStamp();
            });
        }

        if (widthRange) {
            widthRange.addEventListener('input', function () {
                var state = readState();
                state.width = parseFloat(widthRange.value);
                writeState(state, true);
                renderStamp();
            });
        }

        if (heightRange) {
            heightRange.addEventListener('input', function () {
                var state = readState();
                state.height = parseFloat(heightRange.value);
                writeState(state, true);
                renderStamp();
            });
        }

        if (savePositionButton) {
            savePositionButton.addEventListener('click', function () {
                guardarPosicion(null, true, 'La posicion de firma fue guardada correctamente y quedara fija para este documento.');
            });
        }

        if (resetPositionButton) {
            resetPositionButton.addEventListener('click', function () {
                writeState(fixedState, false);
                scrollPreviewToPage(fixedState.page);
                renderStamp();
                guardarPosicion(fixedState, false, 'La ubicacion fija fue restablecida y guardada correctamente.');
            });
        }

        var ultimoSubmitter = null;
        Array.prototype.forEach.call(form.querySelectorAll('button[type="submit"]'), function (button) {
            button.addEventListener('click', function () {
                ultimoSubmitter = button;
            });
        });

        form.addEventListener('submit', function (event) {
            var submitter = event.submitter || ultimoSubmitter;
            if (!submitter || submitter.value !== 'FIRMAR_DESCARGAR') {
                return;
            }

            event.preventDefault();

            if (btnFirmar.dataset.loading === 'true') {
                return;
            }

            var state = readState();
            writeState(state, true);

            var formData = new FormData(form);
            formData.set('accion', 'FIRMAR_DESCARGAR');
            formData.set('tipoDocumento', document.getElementById('TipoDocumento').value);
            formData.set('paginaFirma', pageField.value || '1');
            formData.set('posicionX', xField.value || '');
            formData.set('posicionY', yField.value || '');
            formData.set('anchoFirma', widthField.value || '');
            formData.set('altoFirma', heightField.value || '');
            formData.set('nombreFirmante', firmante ? firmante.value : '');
            formData.set('cargoFirmante', cargoFirmante ? cargoFirmante.value : '');

            if (!formData.get('SolicitudId')) {
                mostrarEstado('alert-warning', 'No se encontro la solicitud.');
                return;
            }

            var certificado = formData.get('certificadoDigital');
            if (!certificado || !certificado.size) {
                mostrarEstado('alert-warning', 'Debe seleccionar el certificado digital .p12 o .pfx.');
                return;
            }

            if (!formData.get('passwordCertificado')) {
                mostrarEstado('alert-warning', 'Debe ingresar la contrasena del certificado.');
                return;
            }

            if (!formData.get('posicionX') || !formData.get('posicionY') || !formData.get('anchoFirma') || !formData.get('altoFirma')) {
                mostrarEstado('alert-warning', 'Debe guardar la posicion de la firma antes de continuar.');
                return;
            }

            btnFirmar.dataset.loading = 'true';
            btnFirmar.disabled = true;
            mostrarEstado('alert-info', 'Firmando digitalmente el documento AOCR...');

            fetch(btnFirmar.getAttribute('formaction') || form.getAttribute('data-firmar-action') || form.action, {
                method: 'POST',
                body: formData,
                credentials: 'same-origin'
            })
            .then(function (response) {
                return response.json().catch(function () { return null; }).then(function (json) {
                    if (!response.ok || !json || !json.ok) {
                        throw new Error((json && json.message) || 'No se pudo firmar el documento AOCR.');
                    }
                    return json;
                });
            })
            .then(function (json) {
                mostrarEstado('alert-success', json.message || 'Documento AOCR firmado correctamente.');
                if (json.data && json.data.urlDescarga) {
                    window.location.href = json.data.urlDescarga;
                } else if (json.data && json.data.redirectUrl) {
                    window.location.href = json.data.redirectUrl;
                } else {
                    window.location.reload();
                }
            })
            .catch(function (error) {
                console.error('[AOCR][FIRMAR_AOCR][ERROR]', error);
                mostrarEstado('alert-danger', error.message || 'Ocurrio un error al firmar digitalmente el documento AOCR.');
            })
            .finally(function () {
                btnFirmar.dataset.loading = 'false';
                btnFirmar.disabled = false;
            });
        });

        boton.addEventListener('click', function () {
            if (!archivo.files || !archivo.files.length) {
                mostrarEstado('alert-warning', 'Seleccione un certificado digital .p12 o .pfx.');
                return;
            }

            if (!password.value) {
                mostrarEstado('alert-warning', 'Ingrese la contraseña del certificado digital.');
                return;
            }

            var data = new FormData();
            data.append('__RequestVerificationToken', form.querySelector('input[name="__RequestVerificationToken"]').value);
            data.append('certificadoDigital', archivo.files[0]);
            data.append('passwordCertificado', password.value);

            mostrarEstado('alert-info', 'Leyendo certificado digital...');

            fetch('@Url.Action("CargarDatosFirmaDigitalAocr", "CoordinacionJefatura")', {
                method: 'POST',
                body: data,
                credentials: 'same-origin'
            })
            .then(function (response) {
                return response.json().then(function (json) {
                    if (!response.ok || !json.ok) {
                        throw new Error(json.mensaje || 'No se pudo leer el certificado digital.');
                    }
                    return json;
                });
            })
            .then(function (json) {
                if (firmante && (!firmante.value || firmante.value === 'USU_ADMIN')) {
                    firmante.value = json.nombreTitular || firmante.value;
                }
                mostrarEstado('alert-success', 'Certificado cargado: ' + (json.nombreTitular || 'Titular no identificado') + '. Vigente hasta ' + (json.vigenteHasta || 'N/D') + '.');
            })
            .catch(function (error) {
                mostrarEstado('alert-danger', error.message || 'No se pudo leer el certificado digital.');
            });
        });
    })();
</script>
