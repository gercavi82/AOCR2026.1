@inherits System.Web.Mvc.WebViewPage<Informe>
@using CapaModelo
@using System.Web.Mvc
@using System.Web.Mvc.Html
@{
    ViewBag.Title = "Generar Informe";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card shadow">
                <div class="card-header bg-info text-white">
                    <h4 class="mb-0"><i class="fas fa-file-invoice"></i> Generar Nuevo Informe</h4>
                </div>
                <div class="card-body">
                    @using (Html.BeginForm("Crear", "Informe", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            @Html.LabelFor(m => m.ResumenEjecutivo, "Resumen Ejecutivo *", new { @class = "form-label" })
                            @Html.TextAreaFor(m => m.ResumenEjecutivo, new { @class = "form-control", rows = 4, placeholder = "Resumen ejecutivo del informe..." })
                            @Html.ValidationMessageFor(m => m.ResumenEjecutivo, "", new { @class = "text-danger" })
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(m => m.Hallazgos, "Hallazgos", new { @class = "form-label" })
                            @Html.TextAreaFor(m => m.Hallazgos, new { @class = "form-control", rows = 4, placeholder = "Hallazgos encontrados..." })
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(m => m.Conclusiones, "Conclusiones", new { @class = "form-label" })
                            @Html.TextAreaFor(m => m.Conclusiones, new { @class = "form-control", rows = 4, placeholder = "Conclusiones del informe..." })
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(m => m.Recomendaciones, "Recomendaciones", new { @class = "form-label" })
                            @Html.TextAreaFor(m => m.Recomendaciones, new { @class = "form-control", rows = 4, placeholder = "Recomendaciones..." })
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(m => m.AccionesCorrectivas, "Acciones Correctivas", new { @class = "form-label" })
                            @Html.TextAreaFor(m => m.AccionesCorrectivas, new { @class = "form-control", rows = 3, placeholder = "Acciones correctivas..." })
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                @Html.LabelFor(m => m.Resultado, "Resultado", new { @class = "form-label" })
                                <select name="Resultado" class="form-select">
                                    <option value="">Seleccione...</option>
                                    <option value="APROBADO">Aprobado</option>
                                    <option value="RECHAZADO">Rechazado</option>
                                    <option value="PENDIENTE">Pendiente</option>
                                    <option value="OBSERVADO">Observado</option>
                                </select>
                            </div>
                            <div class="col-md-6 mb-3">
                                @Html.LabelFor(m => m.FechaEmision, "Fecha de Emisión", new { @class = "form-label" })
                                @Html.TextBoxFor(m => m.FechaEmision, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                            </div>
                        </div>

                        <div class="alert alert-info">
                            <i class="fas fa-info-circle"></i>
                            El informe se generará con la fecha actual y podrá ser descargado en formato PDF.
                        </div>

                        <hr />

                        <div class="d-flex justify-content-between">
                            <a href="@Url.Action("Index", "Informe")" class="btn btn-secondary">
                                <i class="fas fa-arrow-left"></i> Cancelar
                            </a>
                            <button type="submit" class="btn btn-info">
                                <i class="fas fa-save"></i> Generar Informe
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

