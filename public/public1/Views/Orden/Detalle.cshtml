@inherits System.Web.Mvc.WebViewPage<CapaPresentacion.Models.ViewModels.OrdenRecaudacionViewModel>
@using CapaModelo
@using System.Web.Mvc
@using System.Web.Mvc.Html
@using System.Net
@{
    ViewBag.Title = "Detalle de Orden de recaudación";
    Layout = "~/Views/Shared/_LayoutAOCR.cshtml";
}

@Html.Partial("_PageHeader", null, new ViewDataDictionary {
    { "Title", "Detalle de Orden de Recaudación" },
    { "Subtitle", "Orden #" + Model.NumeroOrden }
})

@Html.Partial("_ActionToolbar", null, new ViewDataDictionary {
    { "VolverUrl", Url.Action("MisOrdenes", "Orden") }
})

<div class="card aocr-card">
    <div class="card-body">
        <div class="aocr-detail-grid">
            <div class="aocr-detail-item">
                <div class="aocr-detail-label">Número de Orden</div>
                <div class="aocr-detail-value">@Model.NumeroOrden</div>
            </div>
            <div class="aocr-detail-item">
                <div class="aocr-detail-label">Fecha de Creación</div>
                <div class="aocr-detail-value">@Model.FechaCreacion.ToString("dd/MM/yyyy")</div>
            </div>
            <div class="aocr-detail-item">
                <div class="aocr-detail-label">Estado</div>
                <div class="aocr-detail-value">@Html.Partial("_StatusBadge", new ViewDataDictionary { { "Estado", WebUtility.HtmlDecode(Model.Estado) } })</div>
            </div>
            <div class="aocr-detail-item">
                <div class="aocr-detail-label">Subtotal</div>
                <div class="aocr-detail-value">@Model.Subtotal.ToString("N2") USD</div>
            </div>
            <div class="aocr-detail-item">
                <div class="aocr-detail-label">Administración</div>
                <div class="aocr-detail-value">@Model.Admin.ToString("N2") USD</div>
            </div>
            <div class="aocr-detail-item">
                <div class="aocr-detail-label">Total</div>
                <div class="aocr-detail-value fw-bold" style="font-size:1.2rem; color:var(--aocr-primary);">@Model.Total.ToString("N2") USD</div>
            </div>
        </div>
    </div>
</div>



