@inherits System.Web.Mvc.WebViewPage<IEnumerable<CapaDatos.Models.CorreoInstitucionalModel>>
@using System.Linq
@using System.Web.Mvc
@using System.Web.Mvc.Html

@{
    ViewBag.Title = "Configuración de correos institucionales";
}

@Html.Partial("_PageHeader", null, new ViewDataDictionary {
    { "Title", "Configuración de correos institucionales" },
    { "Subtitle", "Administración de destinatarios institucionales usados por el flujo AOCR" }
})

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="d-flex justify-content-end mb-3">
    <a class="btn btn-primary" href="@Url.Action("Crear")">
        <i class="fas fa-plus mr-1"></i> Nuevo correo institucional
    </a>
</div>

<div class="card">
    <div class="card-body table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Área / rol institucional</th>
                    <th>Código interno</th>
                    <th>Correo principal</th>
                    <th>CC</th>
                    <th>BCC</th>
                    <th>Activo</th>
                    <th>Última actualización</th>
                    <th>Actualizado por</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <strong>@item.NombreArea</strong>
                                @if (!string.IsNullOrWhiteSpace(item.Descripcion))
                                {
                                    <div class="text-muted small">@item.Descripcion</div>
                                }
                            </td>
                            <td><code>@item.CodigoArea</code></td>
                            <td>@item.CorreoPrincipal</td>
                            <td>@(string.IsNullOrWhiteSpace(item.CorreosCc) ? "-" : item.CorreosCc)</td>
                            <td>@(string.IsNullOrWhiteSpace(item.CorreosBcc) ? "-" : item.CorreosBcc)</td>
                            <td>
                                <span class="badge @(item.Activo ? "bg-success" : "bg-secondary")">
                                    @(item.Activo ? "Sí" : "No")
                                </span>
                            </td>
                            <td>@((item.UpdatedAt ?? item.CreatedAt).ToString("dd/MM/yyyy HH:mm"))</td>
                            <td>@(string.IsNullOrWhiteSpace(item.UpdatedBy) ? item.CreatedBy : item.UpdatedBy)</td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-primary" href="@Url.Action("Editar", new { id = item.CodigoCorreo })">
                                    Editar
                                </a>
                                <a class="btn btn-sm btn-outline-secondary" href="@Url.Action("Historial", new { id = item.CodigoCorreo })">
                                    Historial
                                </a>
                                @using (Html.BeginForm("CambiarEstado", "CorreoInstitucional", FormMethod.Post, new { @class = "d-inline" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.CodigoCorreo" />
                                    <input type="hidden" name="activo" value="@(!item.Activo)" />
                                    <button type="submit" class="btn btn-sm @(item.Activo ? "btn-outline-danger" : "btn-outline-success")">
                                        @(item.Activo ? "Inactivar" : "Activar")
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9" class="text-muted text-center">No existen correos institucionales configurados.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
