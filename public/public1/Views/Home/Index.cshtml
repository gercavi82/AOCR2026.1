@inherits System.Web.Mvc.WebViewPage<CapaPresentacion.Models.DashboardViewModel>
@using CapaModelo
@using System.Web.Mvc
@using System.Web.Mvc.Html

@{
    ViewBag.Title = "Inicio - Sistema AOCR";
    Layout = "~/Views/Shared/_LayoutAOCR.cshtml";
    ViewBag.AocrHeaderUserName = Model.NombreUsuario;
    ViewBag.AocrHeaderRole = Model.RolUsuario;
    ViewBag.AocrHeaderSubtitle = "Panel ergonómico para seguimiento operativo, control institucional y acceso directo a las acciones del sistema AOCR.";
    ViewBag.AocrHeaderContextBadge = "Inicio";
    ViewBag.AocrHeaderDateValue = DateTime.Now.ToString("dd/MM/yyyy");
    ViewBag.AocrHeaderDateText = "Resumen habilitado para navegación y seguimiento diario";
}

@section Styles {
    <style>
        .aocr-home-section {
            margin-bottom: 1.1rem;
        }

        .aocr-home-section__header {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            gap: 1rem;
            margin-bottom: 0.75rem;
        }

        .aocr-home-section__header p {
            margin: 0.25rem 0 0;
            color: #516f88;
            font-size: 0.92rem;
        }

        .aocr-home-chip {
            display: inline-flex;
            align-items: center;
            gap: 0.45rem;
            padding: 0.38rem 0.72rem;
            border-radius: 999px;
            font-size: 0.74rem;
            font-weight: 700;
            letter-spacing: 0;
            text-transform: uppercase;
            background: rgba(27, 79, 114, 0.08);
            color: #1b4f72;
        }

        .aocr-home-dashboard-card {
            display: flex;
            gap: 0.9rem;
            min-height: 100%;
            padding: 1rem;
            border-radius: 8px;
            text-decoration: none;
            background: #ffffff;
            border: 1px solid #d8e4ee;
            box-shadow: 0 8px 18px rgba(17, 74, 113, 0.07);
            transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
            color: inherit;
        }

        .aocr-home-dashboard-card:hover {
            transform: translateY(-1px);
            box-shadow: 0 12px 28px rgba(17, 74, 113, 0.11);
            border-color: rgba(12, 124, 134, 0.28);
            color: inherit;
            text-decoration: none;
        }

        .aocr-home-dashboard-card__icon {
            width: 52px;
            height: 52px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.15rem;
            flex: 0 0 auto;
            color: #fff;
        }

        .aocr-home-dashboard-card__icon--primary { background: linear-gradient(135deg, #1b4f72, #247ba0); }
        .aocr-home-dashboard-card__icon--success { background: linear-gradient(135deg, #0f766e, #14b8a6); }
        .aocr-home-dashboard-card__icon--info { background: linear-gradient(135deg, #1d4ed8, #38bdf8); }
        .aocr-home-dashboard-card__icon--warning { background: linear-gradient(135deg, #d97706, #f59e0b); }
        .aocr-home-dashboard-card__icon--secondary { background: linear-gradient(135deg, #475569, #64748b); }
        .aocr-home-dashboard-card__icon--dark { background: linear-gradient(135deg, #1f2937, #334155); }

        .aocr-home-dashboard-card__body {
            min-width: 0;
        }

        .aocr-home-dashboard-card__title {
            display: block;
            font-size: 0.98rem;
            font-weight: 800;
            margin-bottom: 0.28rem;
            color: #0e2e47;
        }

        .aocr-home-dashboard-card__text {
            display: block;
            color: #5d778d;
            line-height: 1.45;
            font-size: 0.9rem;
        }
    </style>
}

<div class="aocr-view">
    <div class="row g-3 mb-4">
        <div class="col-12 col-md-6 col-xl-4">
            @Html.Partial("_MetricCard", null, new ViewDataDictionary { { "Label", Model.ResumenPrimarioTitulo }, { "Value", Model.SolicitudesPendientes }, { "Modifier", "warning" }, { "Icon", "fas fa-inbox" }, { "Caption", Model.ResumenPrimarioCaption } })
        </div>
        <div class="col-12 col-md-6 col-xl-4">
            @Html.Partial("_MetricCard", null, new ViewDataDictionary { { "Label", Model.ResumenSecundarioTitulo }, { "Value", Model.TramitesEnCurso }, { "Modifier", "info" }, { "Icon", "fas fa-gears" }, { "Caption", Model.ResumenSecundarioCaption } })
        </div>
        <div class="col-12 col-md-6 col-xl-4">
            @Html.Partial("_MetricCard", null, new ViewDataDictionary { { "Label", Model.ResumenTerciarioTitulo }, { "Value", Model.NotificacionesNuevas }, { "Modifier", "success" }, { "Icon", "fas fa-bell" }, { "Caption", Model.ResumenTerciarioCaption } })
        </div>
    </div>

    @if (ViewBag.RtFlujoEstado != null)
    {
        var estadoRt = (CapaNegocio.Services.AocrRtFlujoEstadoViewModel)ViewBag.RtFlujoEstado;
        var urlDestinoRt = Url.Content("~/" + (estadoRt.UrlDestino ?? string.Empty).TrimStart('~', '/'));
        <div class="card aocr-card mb-4 border-start border-4 @(estadoRt.PagoAprobado || estadoRt.SolicitudAocrHabilitada ? "border-success" : (estadoRt.TieneOrdenVigente ? "border-warning" : "border-primary"))">
            <div class="card-body p-4">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-circle p-3 @(estadoRt.PagoAprobado || estadoRt.SolicitudAocrHabilitada ? "bg-success text-white" : (estadoRt.TieneOrdenVigente ? "bg-warning text-dark" : "bg-primary text-white")) fs-4">
                            <i class="@(estadoRt.PagoAprobado || estadoRt.SolicitudAocrHabilitada ? "fas fa-check-circle" : (estadoRt.TieneOrdenVigente ? "fas fa-clock" : "fas fa-file-invoice-dollar"))"></i>
                        </div>
                        <div>
                            @if (!estadoRt.TieneOrdenVigente)
                            {
                                <h5 class="mb-1 text-primary font-weight-bold">Orden de Recaudación requerida</h5>
                                <p class="mb-0 text-muted">Para iniciar su trámite AOCR debe generar la Orden de Recaudación correspondiente.</p>
                            }
                            else if (estadoRt.SolicitudAocrCreada)
                            {
                                <h5 class="mb-1 text-info font-weight-bold">Solicitud AOCR en proceso</h5>
                                <p class="mb-0 text-muted">Continúe con el registro o seguimiento de su solicitud AOCR.</p>
                            }
                            else if (estadoRt.PagoAprobado || estadoRt.SolicitudAocrHabilitada)
                            {
                                <h5 class="mb-1 text-success font-weight-bold">Solicitud AOCR habilitada</h5>
                                <p class="mb-0 text-muted">Su pago fue aprobado. Ya puede completar la Solicitud AOCR.</p>
                            }
                            else
                            {
                                <h5 class="mb-1 text-warning font-weight-bold">Pago pendiente de aprobación</h5>
                                <p class="mb-0 text-muted">@estadoRt.MensajeUsuario</p>
                            }
                        </div>
                    </div>
                    <div>
                        <a href="@urlDestinoRt" class="btn @(estadoRt.PagoAprobado || estadoRt.SolicitudAocrHabilitada ? "btn-success" : (estadoRt.TieneOrdenVigente ? "btn-warning" : "btn-primary")) px-4 font-weight-bold">
                            @if (!estadoRt.TieneOrdenVigente)
                            {
                                <span><i class="fas fa-plus-circle me-1"></i> Generar Orden de Recaudación</span>
                            }
                            else if (estadoRt.SolicitudAocrCreada)
                            {
                                <span><i class="fas fa-arrow-right me-1"></i> Continuar Solicitud AOCR</span>
                            }
                            else if (estadoRt.PagoAprobado || estadoRt.SolicitudAocrHabilitada)
                            {
                                <span><i class="fas fa-file-signature me-1"></i> Abrir Solicitud AOCR</span>
                            }
                            else
                            {
                                <span><i class="fas fa-eye me-1"></i> Ver Orden de Recaudación</span>
                            }
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }

    <section class="aocr-home-section">
        <div class="aocr-home-section__header">
            <div>
                <h5 class="aocr-section-title"><i class="fas fa-chart-pie me-2"></i> Dashboards institucionales</h5>
                <p>Entrada central a todos los paneles del sistema según el rol activo en sesión.</p>
            </div>
            <span class="aocr-home-chip"><i class="fas fa-link"></i> Navegación unificada</span>
        </div>

        <div class="row g-3">
            @foreach (var item in Model.AccesosDashboards)
            {
                <div class="col-12 col-md-6 col-xl-4">
                    <a class="aocr-home-dashboard-card" href="@Url.Action(item.Accion, item.Controlador)">
                        <span class="aocr-home-dashboard-card__icon aocr-home-dashboard-card__icon--@item.Estilo">
                            <i class="@item.Icono"></i>
                        </span>
                        <span class="aocr-home-dashboard-card__body">
                            <strong class="aocr-home-dashboard-card__title">@item.Titulo</strong>
                            <span class="aocr-home-dashboard-card__text">@item.Descripcion</span>
                        </span>
                    </a>
                </div>
            }
        </div>
    </section>

    <div class="card aocr-card">
        <div class="card-body">
            <div class="aocr-home-section__header">
                <div>
                    <h5 class="aocr-section-title"><i class="fas fa-bolt me-2"></i> Acciones rápidas</h5>
                    <p>Operaciones frecuentes vinculadas al rol activo y al flujo institucional.</p>
                </div>
            </div>

            <div class="row g-3">
                @foreach (var item in Model.AccionesInstitucionales)
                {
                    if (item.Titulo == "Crear Solicitud")
                    {
                        <div class="col-md-4 col-sm-6">
                            <button type="button"
                                    class="aocr-quick-action w-100 border-0 text-start"
                                    onclick="window.cargarFormulario(null)">
                                <span class="aocr-quick-action__icon">
                                    <i class="@item.Icono"></i>
                                </span>
                                <span class="aocr-quick-action__body">
                                    <strong class="aocr-quick-action__title">@item.Titulo</strong>
                                    <span class="aocr-quick-action__text">@item.Descripcion</span>
                                </span>
                            </button>
                        </div>
                    }
                    else
                    {
                        <div class="col-md-4 col-sm-6">
                            <a class="aocr-quick-action w-100"
                               href="@Url.Action(item.Accion, item.Controlador)">
                                <span class="aocr-quick-action__icon">
                                    <i class="@item.Icono"></i>
                                </span>
                                <span class="aocr-quick-action__body">
                                    <strong class="aocr-quick-action__title">@item.Titulo</strong>
                                    <span class="aocr-quick-action__text">@item.Descripcion</span>
                                </span>
                            </a>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        (function () {
            window.cargarFormulario = function (idSolicitud) {
                var modalEl = document.getElementById('modalFormulario');
                if (!modalEl || !window.bootstrap) {
                    window.location.href = '@Url.Action("Index", "SolicitudAOCR")';
                    return;
                }

                var modal = bootstrap.Modal.getOrCreateInstance(modalEl);
                modal.show();

                var contenido = document.getElementById('contenidoModal');
                if (!contenido) {
                    window.location.href = '@Url.Action("Index", "SolicitudAOCR")';
                    return;
                }

                contenido.innerHTML = ''
                    + '<div class="text-center p-5">'
                    + '    <div class="spinner-border text-primary" role="status"></div>'
                    + '    <p class="mt-3 mb-0 text-muted fw-semibold">Cargando formulario AOCR...</p>'
                    + '</div>';

                $.ajax({
                    url: '@Url.Action("FormularioEmisionAOCR", "SolicitudAOCR")',
                    type: 'GET',
                    data: { oid: idSolicitud },
                    dataType: 'html',
                    timeout: 15000,
                    success: function (data) {
                        contenido.style.display = 'none';
                        contenido.innerHTML = data;
                        $(contenido).fadeIn(180);
                    },
                    error: function (xhr) {
                        console.error('Error al cargar FormularioEmisionAOCR', xhr);
                        contenido.innerHTML = ''
                            + '<div class="alert alert-danger m-3 mb-0">'
                            + '    No se pudo cargar el formulario en este momento.'
                            + '</div>';
                    }
                });
            };
        })();
    </script>
}
