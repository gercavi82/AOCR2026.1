@inherits System.Web.Mvc.WebViewPage<CapaPresentacion.Models.ViewModels.ReportesFinancierosViewModel>
@using System.Linq

@{
    var r = (Model != null && Model.Resumen != null)
        ? Model.Resumen
        : new CapaModelo.ReportesFinancieros.ReporteResumenDTO();
}

<div class="card dashboard-card shadow-sm mb-3">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <strong>Reporte detallado de ordenes</strong>
        <span class="badge bg-secondary">@Model.Ordenes.Count registro(s)</span>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table id="tablaReportes" class="table table-striped table-bordered table-sm">
                <thead class="table-light">
                    <tr>
                        <th>Orden</th>
                        <th>Solicitante</th>
                        <th>Fecha creacion</th>
                        <th>Estado</th>
                        <th>Tramite</th>
                        <th>Unidad</th>
                        <th class="text-end">Subtotal</th>
                        <th class="text-end">Admin</th>
                        <th class="text-end">Total</th>
                        <th class="text-end">Pagado</th>
                        <th class="text-end">Saldo</th>
                        <th>Accion</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Ordenes != null && Model.Ordenes.Any())
                    {
                        foreach (var item in Model.Ordenes)
                        {
                            <tr>
                                <td>@item.NumeroOrden</td>
                                <td>@item.UsuarioSolicitante</td>
                                <td>@item.FechaCreacion.ToString("dd/MM/yyyy")</td>
                                <td>@item.Estado</td>
                                <td>@item.TipoTramite</td>
                                <td>@item.Unidad</td>
                                <td class="text-end">$@item.Subtotal.ToString("N2")</td>
                                <td class="text-end">$@item.Administracion.ToString("N2")</td>
                                <td class="text-end">$@item.Total.ToString("N2")</td>
                                <td class="text-end text-success">$@item.MontoPagado.ToString("N2")</td>
                                <td class="text-end text-danger">$@item.SaldoPendiente.ToString("N2")</td>
                                <td class="text-center">
                                    <a href="@Url.Action("Detalles", "OrdenRecaudacion", new { id = item.OrdenId })"
                                       class="btn btn-outline-primary btn-sm"
                                       title="Ver detalle">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="12" class="text-center text-muted">No existen datos para el filtro aplicado.</td>
                        </tr>
                    }
                </tbody>
                <tfoot class="table-light">
                    <tr>
                        <th colspan="6" class="text-end">Totales filtrados:</th>
                        <th class="text-end">$@r.SubtotalFiltrado.ToString("N2")</th>
                        <th class="text-end">$@r.AdministracionFiltrada.ToString("N2")</th>
                        <th class="text-end">$@r.TotalFiltrado.ToString("N2")</th>
                        <th colspan="3"></th>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>

<div class="card dashboard-card shadow-sm mb-3">
    <div class="card-header bg-white">
        <strong>Reporte de anulaciones</strong>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-sm mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Orden</th>
                        <th>Fecha</th>
                        <th>Unidad</th>
                        <th>Rol que anulo</th>
                        <th>Motivo</th>
                        <th>Observaciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (r.Anulaciones != null && r.Anulaciones.Any())
                    {
                        foreach (var an in r.Anulaciones)
                        {
                            <tr>
                                <td>@an.NumeroOrden</td>
                                <td>@an.Fecha.ToString("dd/MM/yyyy")</td>
                                <td>@an.Unidad</td>
                                <td>@an.RolGestion</td>
                                <td>@an.Motivo</td>
                                <td>@an.Observaciones</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted">No hay anulaciones para el filtro aplicado.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
