@inherits System.Web.Mvc.WebViewPage<CapaPresentacion.Models.ViewModels.ReportesFinancierosViewModel>
@using System.Linq

@{
    var r = (Model != null && Model.Resumen != null)
        ? Model.Resumen
        : new CapaModelo.ReportesFinancieros.ReporteResumenDTO();
}

<div class="row g-3 mb-3">
    <div class="col-lg-8">
        <div class="card dashboard-card shadow-sm h-100">
            <div class="card-header bg-white">
                <strong>Ingresos por mes</strong>
            </div>
            <div class="card-body" style="height: 320px;">
                @if (r.IngresosPorMes != null && r.IngresosPorMes.Any())
                {
                    <canvas id="chartIngresos"></canvas>
                }
                else
                {
                    <div class="text-muted text-center pt-5">No hay datos para el periodo seleccionado.</div>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card dashboard-card shadow-sm h-100">
            <div class="card-header bg-white">
                <strong>Distribucion por estado</strong>
            </div>
            <div class="card-body" style="height: 320px;">
                @if (r.TotalesPorEstado != null && r.TotalesPorEstado.Any())
                {
                    <canvas id="chartEstados"></canvas>
                }
                else
                {
                    <div class="text-muted text-center pt-5">No hay datos para el periodo seleccionado.</div>
                }
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-lg-6">
        <div class="card dashboard-card shadow-sm h-100">
            <div class="card-header bg-white">
                <strong>Recaudacion por tipo de tramite</strong>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-sm mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Tramite</th>
                                <th class="text-end">Cantidad</th>
                                <th class="text-end">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (r.RecaudacionPorTramite != null && r.RecaudacionPorTramite.Any())
                            {
                                foreach (var item in r.RecaudacionPorTramite)
                                {
                                    <tr>
                                        <td>@item.Tramite</td>
                                        <td class="text-end">@item.Cantidad.ToString("N0")</td>
                                        <td class="text-end">$@item.Total.ToString("N2")</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr><td colspan="3" class="text-center text-muted">Sin datos</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card dashboard-card shadow-sm h-100">
            <div class="card-header bg-white">
                <strong>Recaudacion por unidad</strong>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-sm mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Unidad</th>
                                <th class="text-end">Cantidad</th>
                                <th class="text-end">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (r.RecaudacionPorUnidad != null && r.RecaudacionPorUnidad.Any())
                            {
                                foreach (var item in r.RecaudacionPorUnidad)
                                {
                                    <tr>
                                        <td>@item.Unidad</td>
                                        <td class="text-end">@item.Cantidad.ToString("N0")</td>
                                        <td class="text-end">$@item.Total.ToString("N2")</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr><td colspan="3" class="text-center text-muted">Sin datos</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
