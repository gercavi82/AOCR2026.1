@inherits System.Web.Mvc.WebViewPage
@using System.Collections.Generic
@using System.Web
@using CapaPresentacion.Helpers
@{
    Layout = "~/Views/Shared/_LayoutAOCR.cshtml";
    ViewBag.Title = "Dashboard";
    var usuarioActual = ((Session["NombreUsuario"] as string) ?? "Usuario AOCR").Trim();
    var rolActual = RoleGroupingHelper.ToDisplayName((Session["Rol"] as string) ?? "Perfil institucional");
    var fechaActual = DateTime.Now.ToString("dd/MM/yyyy");
    ViewBag.AocrHeaderSubtitle = "Panel ergonómico para seguimiento operativo, control de órdenes y accesos directos del ecosistema AOCR.";
    ViewBag.AocrHeaderContextBadge = "Dashboard operativo";
    ViewBag.AocrHeaderDateValue = fechaActual;
    ViewBag.AocrHeaderDateText = "Panel habilitado para seguimiento y decisiones rápidas";

    var pageHeaderData = new ViewDataDictionary
    {
        { "Kicker", "Inicio" },
        { "Title", "Dashboard Institucional" },
        { "Subtitle", "Vista ejecutiva del sistema AOCR con accesos directos, estado operativo y seguimiento de órdenes en tiempo real." },
        { "Breadcrumbs", new[]
            {
                new { Text = "Dashboard", Url = string.Empty }
            }
        }
    };
}

<div class="aocr-view aocr-dashboard-view">
    @Html.Partial("_PageHeader", null, pageHeaderData)

    <div class="row g-3 mb-4">
        <div class="col-12 col-md-6 col-xl-3">
            @Html.Partial("_MetricCard", null, new ViewDataDictionary { { "Label", "Pendientes" }, { "Value", 0 }, { "ValueId", "ordenesPendientes" }, { "Modifier", "warning" }, { "Icon", "fas fa-clipboard-list" }, { "Caption", "Bandeja por atender" } })
        </div>
        <div class="col-12 col-md-6 col-xl-3">
            @Html.Partial("_MetricCard", null, new ViewDataDictionary { { "Label", "Completadas" }, { "Value", 0 }, { "ValueId", "ordenesCompletadas" }, { "Modifier", "success" }, { "Icon", "fas fa-circle-check" }, { "Caption", "Órdenes cerradas correctamente" } })
        </div>
        <div class="col-12 col-md-6 col-xl-3">
            @Html.Partial("_MetricCard", null, new ViewDataDictionary { { "Label", "Recaudación" }, { "Value", "$0.00" }, { "ValueId", "totalRecaudado" }, { "Modifier", "info" }, { "Icon", "fas fa-dollar-sign" }, { "Caption", "Valor acumulado del período" } })
        </div>
        <div class="col-12 col-md-6 col-xl-3">
            @Html.Partial("_MetricCard", null, new ViewDataDictionary { { "Label", "Última orden" }, { "Value", "N/A" }, { "ValueId", "ultimaOrden" }, { "Modifier", "primary" }, { "Icon", "fas fa-calendar-check" }, { "Caption", "Último registro actualizado" } })
        </div>
    </div>

    <section class="aocr-quick-actions">
        <div class="row g-3">
            <div class="col-12 col-md-6 col-xl-3">
                <a href="@Url.Action("Index", "SolicitudAOCR", new { abrir = "nueva" })" class="aocr-quick-action">
                    <span class="aocr-quick-action__icon"><i class="fas fa-file-circle-plus"></i></span>
                    <span class="aocr-quick-action__body">
                        <strong class="aocr-quick-action__title">Crear solicitud</strong>
                        <span class="aocr-quick-action__text">Inicie una nueva solicitud AOCR desde la bandeja institucional.</span>
                    </span>
                </a>
            </div>
            <div class="col-12 col-md-6 col-xl-3">
                <a href="@Url.Action("Index", "SolicitudAOCR")" class="aocr-quick-action">
                    <span class="aocr-quick-action__icon"><i class="fas fa-folder-open"></i></span>
                    <span class="aocr-quick-action__body">
                        <strong class="aocr-quick-action__title">Mis solicitudes</strong>
                        <span class="aocr-quick-action__text">Revise el estado de sus trámites, observaciones y documentación.</span>
                    </span>
                </a>
            </div>
            <div class="col-12 col-md-6 col-xl-3">
                <a href="@Url.Action("Nueva", "OrdenRecaudacion")" class="aocr-quick-action">
                    <span class="aocr-quick-action__icon"><i class="fas fa-receipt"></i></span>
                    <span class="aocr-quick-action__body">
                        <strong class="aocr-quick-action__title">Nueva orden</strong>
                        <span class="aocr-quick-action__text">Genere una orden de recaudación y continúe el flujo financiero.</span>
                    </span>
                </a>
            </div>
            <div class="col-12 col-md-6 col-xl-3">
                <a href="@Url.Action("Index", "Reportes")" class="aocr-quick-action">
                    <span class="aocr-quick-action__icon"><i class="fas fa-chart-column"></i></span>
                    <span class="aocr-quick-action__body">
                        <strong class="aocr-quick-action__title">Reportes</strong>
                        <span class="aocr-quick-action__text">Acceda a reportes operativos y métricas clave del sistema.</span>
                    </span>
                </a>
            </div>
        </div>
    </section>

    <div class="row g-4">
        <div class="col-12 col-xl-8">
            <div class="card aocr-content-card aocr-table-card h-100">
                <div class="card-body">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                        <div>
                            <h3 class="aocr-section-title mb-1"><i class="fas fa-clock-rotate-left"></i> Órdenes recientes</h3>
                            <p class="text-muted mb-0">Seguimiento en línea de las órdenes más recientes y sus estados operativos.</p>
                        </div>
                        <div id="loadingOrdenes" class="text-muted d-none">
                            <i class="fas fa-spinner fa-spin"></i> Cargando...
                        </div>
                    </div>

                    <div class="table-responsive aocr-table-wrap">
                        <table class="table aocr-table align-middle mb-0" id="tablaOrdenes" width="100%">
                            <thead>
                                <tr>
                                    <th>Número</th>
                                    <th>Fecha</th>
                                    <th>Estado</th>
                                    <th>Total</th>
                                    <th style="width:140px;">Acciones</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                    <small class="text-muted d-block mt-3">La tabla conserva DataTables y los scripts existentes del módulo.</small>
                </div>
            </div>
        </div>

        <div class="col-12 col-xl-4">
            <div class="card aocr-content-card h-100">
                <div class="card-body d-flex flex-column">
                    <div class="mb-3">
                        <h3 class="aocr-section-title mb-1"><i class="fas fa-bolt"></i> Resumen de sesión</h3>
                        <p class="text-muted mb-0">Identidad activa, contexto institucional y accesos auxiliares del dashboard.</p>
                    </div>

                    <div class="aocr-dashboard-aside mt-auto">
                        <div class="aocr-dashboard-aside__item">
                            <span class="aocr-dashboard-aside__label">Usuario</span>
                            <strong class="aocr-dashboard-aside__value">@usuarioActual</strong>
                        </div>
                        <div class="aocr-dashboard-aside__item">
                            <span class="aocr-dashboard-aside__label">Rol</span>
                            <strong class="aocr-dashboard-aside__value">@rolActual</strong>
                        </div>
                        <div class="aocr-dashboard-aside__item">
                            <span class="aocr-dashboard-aside__label">Fecha</span>
                            <strong class="aocr-dashboard-aside__value">@fechaActual</strong>
                        </div>

                        <div class="d-grid gap-2 mt-3">
                            <a href="@Url.Action("Obligatoria", "OrdenRecaudacion")" class="btn btn-aocr-secondary w-100">
                                <i class="fas fa-list"></i><span>Mis órdenes</span>
                            </a>
                            <a href="@Url.Action("Logout", "Account")" class="btn btn-aocr-secondary w-100">
                                <i class="fas fa-sign-out-alt"></i><span>Cerrar sesión</span>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
(function () {
    'use strict';

    var dt = null;

    function escapeHtml(text) {
        if (text === null || text === undefined) return '';
        return String(text).replace(/[&<>\"']/g, function (m) { return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',"'":'&#039;'}[m]; });
    }

    function onDataTablesReady(callback) {
        if (window.jQuery && window.jQuery.fn && window.jQuery.fn.DataTable) {
            callback();
            return;
        }
        var handler = function () {
            document.removeEventListener('AOCR.DataTablesReady', handler);
            callback();
        };
        document.addEventListener('AOCR.DataTablesReady', handler);
    }

    function showLoading(show) {
        var el = document.getElementById('loadingOrdenes');
        if (!el) return;
        el.classList.toggle('d-none', !show);
    }

    function badgeEstado(estado) {
        var e = String(estado || '').toUpperCase();
        var safe = escapeHtml(e || 'N/D');

        if (e === 'BORRADOR')   { var _s = document.createElement('span'); _s.className = 'badge text-bg-warning'; _s.textContent = 'BORRADOR'; return _s.outerHTML; }
        if (e === 'COMPLETADA') { var _s = document.createElement('span'); _s.className = 'badge text-bg-success'; _s.textContent = 'COMPLETADA'; return _s.outerHTML; }
        if (e === 'PAGADA')     { var _s = document.createElement('span'); _s.className = 'badge text-bg-primary'; _s.textContent = 'PAGADA'; return _s.outerHTML; }
        var _s = document.createElement('span'); _s.className = 'badge text-bg-secondary'; _s.textContent = safe; return _s.outerHTML;
    }

    function formatFecha(data) {
        if (!data) return 'N/D';
        var d = new Date(data);
        if (isNaN(d.getTime())) return 'N/D';
        return d.toLocaleDateString('es-EC');
    }

    function formatMoney(v) {
        var n = Number(v || 0);
        return new Intl.NumberFormat('es-EC', { style: 'currency', currency: 'USD' }).format(n);
    }

    var detalleBase = '@Url.Action("Detalle", "Orden")';
    var descargarBase = '@Url.Action("DescargarPdf", "OrdenRecaudacion")';

    function initTable() {
        if (!window.jQuery) {
            console.error("jQuery NO está cargado -> '$ is not defined'. Revisa Layout/Bundles/CSP.");
            return false;
        }
        if (!$.fn || !$.fn.DataTable) {
            console.error("DataTables NO está cargado -> 'DataTable is not a function'. Revisa bundles/datatables.");
            return false;
        }

        if ($.fn.DataTable.isDataTable('#tablaOrdenes')) {
            dt = $('#tablaOrdenes').DataTable();
            return true;
        }

        dt = $('#tablaOrdenes').DataTable({
            language: { url: '@Url.Content("~/Content/plugins/datatables/i18n/Spanish.json")' },
            order: [[1, 'desc']],
            autoWidth: false,
            responsive: true,
            processing: true,
            columns: [
                { data: 'numeroOrden', defaultContent: '', render: function(data) { return escapeHtml(data || ''); } },
                {
                    data: 'fechaCreacion',
                    defaultContent: '',
                    render: function (data) { return formatFecha(data); }
                },
                {
                    data: 'estado',
                    defaultContent: 'N/D',
                    render: function (estado) { return badgeEstado(estado); }
                },
                {
                    data: 'total',
                    defaultContent: 0,
                    render: function (t) { return formatMoney(t); }
                },
                {
                    data: null,
                    orderable: false,
                    searchable: false,
                    render: function (row) {
                        var id = row && row.id ? Number(row.id) : 0;
                        var detalleUrl = detalleBase + '/' + encodeURIComponent(id);
                        var pdfUrl = descargarBase + '/' + encodeURIComponent(id);
                        var previewUrl = pdfUrl + '?vistaPrevia=true';

                        var container = document.createElement('div');

                        var linkDetalle = document.createElement('a');
                        linkDetalle.setAttribute('href', detalleUrl);
                        linkDetalle.setAttribute('class', 'btn btn-sm btn-info text-white me-1');
                        linkDetalle.setAttribute('title', 'Ver Detalle');
                        var iDet = document.createElement('i'); iDet.className = 'fas fa-eye';
                        linkDetalle.appendChild(iDet);

                        var linkPreview = document.createElement('a');
                        linkPreview.setAttribute('href', previewUrl);
                        linkPreview.setAttribute('class', 'btn btn-sm btn-outline-secondary me-1');
                        linkPreview.setAttribute('target', '_blank');
                        linkPreview.setAttribute('title', 'Vista previa PDF');
                        var iPreview = document.createElement('i'); iPreview.className = 'fas fa-eye';
                        linkPreview.appendChild(iPreview);

                        var linkPdf = document.createElement('a');
                        linkPdf.setAttribute('href', pdfUrl);
                        linkPdf.setAttribute('class', 'btn btn-sm btn-primary');
                        linkPdf.setAttribute('target', '_blank');
                        linkPdf.setAttribute('title', 'Descargar PDF');
                        var iPdf = document.createElement('i'); iPdf.className = 'fas fa-download';
                        linkPdf.appendChild(iPdf);

                        container.appendChild(linkDetalle);
                        container.appendChild(linkPreview);
                        container.appendChild(linkPdf);

                        return container.innerHTML;
                    }
                }
            ]
        });

        return true;
    }

    function cargarDatosDashboard() {
        if (!dt) return;

        showLoading(true);

        $.ajax({
            url: '@Url.Action("ObtenerDatosDashboard", "Dashboard")',
            type: 'GET',
            dataType: 'json',
            cache: false,
            success: function (data) {
                if (!data || !data.success) return;

                $('#ordenesPendientes').text(data.ordenesPendientes || 0);
                $('#ordenesCompletadas').text(data.ordenesCompletadas || 0);
                $('#totalRecaudado').text(formatMoney(data.totalRecaudado || 0));
                $('#ultimaOrden').text(data.ultimaOrden || 'N/A');

                var ordenes = data.ordenesRecientes || [];
                dt.clear().rows.add(ordenes).draw();
            },
            error: function (xhr) {
                console.log('Error al cargar datos del dashboard', xhr && xhr.status);
            },
            complete: function () {
                showLoading(false);
            }
        });
    }

    $(function () {
        onDataTablesReady(function () {
            if (initTable()) {
                cargarDatosDashboard();
            }
        });
    });

})();
    </script>
}

