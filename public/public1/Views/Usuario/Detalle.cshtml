@inherits System.Web.Mvc.WebViewPage<CapaModelo.Direccion>
@using CapaModelo
@using System.Web.Mvc
@using System.Web.Mvc.Html
@{
    ViewBag.Title = "Detalle Dirección";
}

<h2 class="mt-3">📘 Detalle de Dirección</h2>

<table class="table table-bordered">
    <tr><th>ID</th><td>@Html.Encode(Model.CodigoDireccion)</td></tr>
    <tr><th>Calle</th><td>@Html.Encode(Model.Calle)</td></tr>
    <tr><th>Ciudad</th><td>@Html.Encode(Model.Ciudad)</td></tr>
    <tr><th>Provincia</th><td>@Html.Encode(Model.Provincia)</td></tr>
    <tr><th>País</th><td>@Html.Encode(Model.Pais)</td></tr>
</table>

<a href="@Url.Action("Index")" class="btn btn-secondary">Volver</a>
<a href="@Url.Action("Editar", new { id = Model.CodigoDireccion })" class="btn btn-warning">Editar</a>
@using (Html.BeginForm("Eliminar", "Usuario", FormMethod.Post, new { @class = "d-inline" }))
{
    @Html.AntiForgeryToken()
    @Html.Hidden("id", Model.CodigoDireccion)
    <button type="submit" class="btn btn-danger btn-eliminar" data-nombre="@Html.Encode(Model.Calle)">Eliminar</button>
}

@section Scripts {
    <script>
        $(function(){
            $(document).on('click', '.btn-eliminar', function(e){
                e.preventDefault();
                var btn = $(this);
                var form = btn.closest('form');
                var nombre = btn.data('nombre') || '';
                Swal.fire({
                    title: '¿Eliminar elemento? ⚠️',
                    text: nombre,
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'Eliminar',
                    cancelButtonText: 'Cancelar'
                }).then(function(res){ if (res.isConfirmed) form.submit(); });
            });
        });
    </script>
}


