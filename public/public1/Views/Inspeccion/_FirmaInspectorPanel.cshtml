@* ============================================================
   Partial: Panel de firma del Inspector — rediseño ergonómico
   ============================================================ *@
@inherits System.Web.Mvc.WebViewPage<CapaPresentacion.Models.ViewModels.FirmaInspectorPanelVm>
@using System.Web.Mvc
@using System.Web.Mvc.Html
@{
    var vm = Model ?? new CapaPresentacion.Models.ViewModels.FirmaInspectorPanelVm();
    var informeTecnico = vm.InformeTecnico;
    var codigoInspeccion = vm.CodigoInspeccion;
    var usaFlujoListaVerificacionEae = vm.UsaFlujoListaVerificacionEae;
    var puedeFirmarInspector = vm.PuedeFirmarInspector;
    var puedeEnviarADirdac = vm.PuedeEnviarADirdac;
    var puedeReintentarNotificacionDirdac = vm.PuedeReintentarNotificacionDirdac;
    var requiereNoConformidad = vm.RequiereNoConformidad;
    var puedeFirmarNoConformidad = vm.PuedeFirmarNoConformidad;
    var informeEnviadoADirdac = vm.InformeEnviadoADirdac;
    var informeEnviadoACoordinador = informeTecnico != null
        && string.Equals(vm.EstadoInformeTecnico ?? "BORRADOR", "ENVIADO_A_COORDINADOR", StringComparison.OrdinalIgnoreCase);
    var informeDevueltoCoordinador = vm.InformeDevueltoCoordinador;
    var informeDevueltoDireccion = vm.InformeDevueltoDireccion;
    var informeAprobadoDireccion = vm.InformeAprobadoDireccion;
    var estadoInformeTecnico = vm.EstadoInformeTecnico ?? "BORRADOR";
    var tieneRutaPdf = informeTecnico != null
        && (!string.IsNullOrWhiteSpace(informeTecnico.RutaPdf) || !string.IsNullOrWhiteSpace(informeTecnico.RutaDocumentoFirmado));
    var urlVerPdf = codigoInspeccion > 0
        ? Url.Action("VerInforme", "Inspeccion", new { id = codigoInspeccion })
        : "#";

    // Etiquetas de estado
    string estadoLabel;
    string estadoClass;
    switch (estadoInformeTecnico)
    {
        case "BORRADOR": estadoLabel = "Borrador"; estadoClass = ""; break;
        case "GENERADO": estadoLabel = "PDF generado"; estadoClass = "info"; break;
        case "FIRMADO_INSPECTOR": estadoLabel = "Firmado por inspector"; estadoClass = "ok"; break;
        case "PENDIENTE_REVISION_DIRDAC": estadoLabel = "Pendiente revisión · DIRDAC"; estadoClass = "warn"; break;
        case "ENVIADO_A_COORDINADOR": estadoLabel = "En revisión · Coordinación (legado)"; estadoClass = "info"; break;
        case "ENVIADO_A_DIRDAC": estadoLabel = "En revisión · DIRDAC"; estadoClass = "warn"; break;
        case "APROBADO_COORDINADOR": estadoLabel = "Aprobado por Coordinación (legado)"; estadoClass = "ok"; break;
        case "APROBADO_DIRECCION": estadoLabel = "Decisión final registrada"; estadoClass = "ok"; break;
        case "DEVUELTO_COORDINADOR": estadoLabel = "Devuelto · Coordinación"; estadoClass = "danger"; break;
        case "DEVUELTO_DIRECCION":
        case "RECHAZADO_DIRDAC": estadoLabel = "Devuelto · Dirección"; estadoClass = "danger"; break;
        case "FIRMADO_FINAL": estadoLabel = "Firmado · Final"; estadoClass = "ok"; break;
        default: estadoLabel = estadoInformeTecnico; estadoClass = ""; break;
    }

    // Cálculo de pasos
    var pasoGenerado = informeTecnico != null && informeTecnico.Finalizado && !string.IsNullOrWhiteSpace(informeTecnico.RutaPdf);
    var pasoFirmado = informeTecnico != null && informeTecnico.FirmadoInspector;
    var pasoDirdac = informeEnviadoADirdac || informeAprobadoDireccion || informeDevueltoDireccion;
    var pasoDecisionFinal = informeAprobadoDireccion || informeDevueltoDireccion;
    var pasoActivo1 = !pasoGenerado;
    var pasoActivo2 = pasoGenerado && !pasoFirmado;
    var pasoActivo3 = pasoFirmado && !pasoDirdac;
    var pasoActivo4 = pasoDirdac && !pasoDecisionFinal;
}

@if (codigoInspeccion <= 0)
{
    <div class="it-alert warn">
        <i class="fas fa-exclamation-triangle"></i>
        <div>No hay contexto de inspección disponible para el panel de firma.</div>
    </div>
}
else if (informeTecnico != null)
{
    @Html.Partial("_InformeFirmaStyles")

    <div class="it-hero">
        <div class="it-hero-row">
            <div>
                <h3><i class="fas fa-file-signature"></i> Firma del Inspector DGAC</h3>
                <p class="sub">
                    Versión <strong>@informeTecnico.Version</strong> · Inspección #@codigoInspeccion
                    @if (usaFlujoListaVerificacionEae)
                    {
                        <text> · Flujo EAE con revisión final DIRDAC</text>
                    }
                </p>
            </div>
            <div>
                <span class="it-pill @estadoClass">
                    @if (estadoClass == "ok") { <i class="fas fa-check-circle"></i> }
                    else if (estadoClass == "warn") { <i class="fas fa-hourglass-half"></i> }
                    else if (estadoClass == "danger") { <i class="fas fa-undo"></i> }
                    else if (estadoClass == "info") { <i class="fas fa-paper-plane"></i> }
                    else { <i class="fas fa-circle"></i> }
                    @estadoLabel
                </span>
            </div>
        </div>

        <div class="it-steps">
            <div class="it-step @(pasoGenerado ? "done" : (pasoActivo1 ? "active" : ""))">
                <span class="n">1</span> PDF generado
            </div>
            <div class="it-step @(pasoFirmado ? "done" : (pasoActivo2 ? "active" : ""))">
                <span class="n">2</span> Firma inspector
            </div>
            <div class="it-step @(pasoDirdac ? "done" : (pasoActivo3 ? "active" : ""))">
                <span class="n">3</span> Revisión DIRDAC
            </div>
            <div class="it-step @(pasoDecisionFinal ? "done" : (pasoActivo4 ? "active" : ""))">
                <span class="n">4</span> Decisión final / RT
            </div>
        </div>
    </div>

    @* ── Observación de devolución ── *@
    if (!string.IsNullOrWhiteSpace(informeTecnico.ObservacionDevolucion) && (informeDevueltoCoordinador || informeDevueltoDireccion))
    {
        <div class="it-obs">
            <h6><i class="fas fa-comment-dots"></i> Informe devuelto para corrección</h6>
            <p>@CapaPresentacion.Helpers.VisibleTextHelper.Normalize(informeTecnico.ObservacionDevolucion)</p>
            @if (informeTecnico.FechaDevolucion.HasValue)
            {
                <small>
                    @informeTecnico.FechaDevolucion.Value.ToString("dd/MM/yyyy HH:mm")
                    @(!string.IsNullOrWhiteSpace(informeTecnico.UsuarioDevolucion) ? " · " + informeTecnico.UsuarioDevolucion : "")
                </small>
            }
        </div>
    }

    @* ── Panel de firma activa ── *@
    if (puedeFirmarInspector)
    {
        <div class="it-panel">
            <h4><i class="fas fa-signature"></i> Aplicar firma digital</h4>
            <p class="hint">Cargue su certificado digital personal (.p12 / .pfx) y la contraseña para firmar el informe técnico.</p>

            @using (Html.BeginForm("FirmarInformeInspector", "Inspeccion", FormMethod.Post, new { enctype = "multipart/form-data", id = "frmFirmaInspector" }))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@codigoInspeccion" />
                <input type="hidden" name="codigoInspeccion" value="@codigoInspeccion" />

                <div class="it-field">
                    <label for="fileCertInspector">Certificado digital (.p12 / .pfx)</label>
                    <input type="file" name="CertificadoInspector" id="fileCertInspector"
                           class="it-input" accept=".p12,.pfx" required="required" />
                </div>

                <div class="it-field">
                    <label for="pwdCertInspector">Contraseña del certificado</label>
                    <input type="password" name="passwordCertificado" id="pwdCertInspector"
                           class="it-input" autocomplete="off" required="required" placeholder="•••••••••••" />
                    <button type="button" class="it-toggle" onclick="itTogglePwd('pwdCertInspector', this)" title="Mostrar / ocultar">
                        <i class="far fa-eye"></i>
                    </button>
                </div>

                <button type="submit" class="it-btn success full" id="btnFirmarInspector">
                    <i class="fas fa-shield-alt"></i> Firmar informe
                </button>
            }

            <div class="it-info">
                <i class="fas fa-lock"></i>
                <div>Solo usted conoce la contraseña. El archivo del certificado se procesa en memoria y no se guarda.</div>
            </div>
        </div>
    }
    else if (informeTecnico.FirmadoInspector)
    {
        <div class="it-panel">
            <div class="it-done">
                <div class="icon"><i class="fas fa-check"></i></div>
                <h5>Informe firmado digitalmente</h5>
                <p>
                    Firmado por <strong>@(!string.IsNullOrWhiteSpace(informeTecnico.UsuarioFirma1) ? informeTecnico.UsuarioFirma1 : "—")</strong>
                    el <strong>@(informeTecnico.FechaFirma1.HasValue ? informeTecnico.FechaFirma1.Value.ToString("dd/MM/yyyy HH:mm") : "—")</strong>.
                </p>
                @if (tieneRutaPdf)
                {
                    <a class="it-btn success full" href="@urlVerPdf" target="_blank" rel="noopener">
                        <i class="fas fa-file-pdf"></i> Ver PDF firmado
                    </a>
                }
            </div>
        </div>
    }
    else
    {
        var alertClass = (!informeTecnico.Finalizado || string.IsNullOrWhiteSpace(informeTecnico.RutaPdf)) ? "warn" : "info";
        <div class="it-alert @alertClass">
            @if (!informeTecnico.Finalizado || string.IsNullOrWhiteSpace(informeTecnico.RutaPdf))
            {
                <i class="fas fa-info-circle"></i>
                <div>
                    <strong>Falta finalizar el informe.</strong> Complete y finalice el informe técnico para generar el PDF; después podrá firmarlo digitalmente.
                </div>
            }
            else if (informeEnviadoADirdac)
            {
                <i class="fas fa-hourglass-half"></i>
                <div>El informe ya fue firmado por el inspector y se encuentra en revisión de DIRDAC / Dirección - Jefatura.</div>
            }
            else if (usaFlujoListaVerificacionEae)
            {
                <i class="fas fa-info-circle"></i>
                <div>En el flujo EAE la firma del inspector queda disponible cuando el PDF del informe ya fue generado y la LV/EAE está firmada. Después, el documento pasa a DIRDAC.</div>
            }
            else
            {
                <i class="fas fa-user-lock"></i>
                <div>La firma del inspector no está disponible para su usuario en el estado actual del informe.</div>
            }
        </div>

        if (!informeTecnico.Finalizado || string.IsNullOrWhiteSpace(informeTecnico.RutaPdf))
        {
            using (Html.BeginForm("FinalizarInformeTecnico", "Inspeccion", FormMethod.Post, new { @class = "mb-2" }))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@codigoInspeccion" />
                <button type="submit" class="it-btn primary">
                    <i class="fas fa-file-pdf"></i> Finalizar informe y generar PDF
                </button>
            }
        }
    }

    @* ── Panel de firma de No Conformidad ── *@
    if (requiereNoConformidad && pasoFirmado && puedeFirmarNoConformidad)
    {
        <div class="it-panel" style="margin-top: 20px; border-left-color: #e53935;">
            <h4><i class="fas fa-exclamation-triangle" style="color: #e53935;"></i> Generar y Firmar No Conformidad</h4>
            <p class="hint">El informe técnico tiene resultado insatisfactorio. Debe definir la ruta a seguir y firmar digitalmente la No Conformidad.</p>

            <div class="it-actions" style="margin-bottom: 15px;">
                <a href="@Url.Action("VistaPreviaNcPdf", "Inspeccion", new { id = codigoInspeccion })" target="_blank" class="it-btn it-btn-secondary">
                    <i class="fas fa-search"></i> Vista previa de la NC (Borrador)
                </a>
            </div>

            @using (Html.BeginForm("FirmarNcInspector", "Inspeccion", FormMethod.Post, new { enctype = "multipart/form-data", id = "frmFirmaNc" }))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@codigoInspeccion" />

                <div class="it-field">
                    <label for="tipoRutaNc">Ruta obligatoria requerida</label>
                    <select name="tipoRuta" id="tipoRutaNc" class="it-input" required="required">
                        <option value="">-- Seleccione la ruta a seguir --</option>
                        <option value="SIN_INSPECCION">Requiere Subsanación Documental (Sin nueva inspección in-situ)</option>
                        <option value="CON_INSPECCION">Requiere Nueva Inspección In-situ</option>
                    </select>
                </div>

                <div class="it-field">
                    <label for="fileCertNc">Certificado digital (.p12 / .pfx)</label>
                    <input type="file" name="CertificadoInspector" id="fileCertNc"
                           class="it-input" accept=".p12,.pfx" required="required" />
                </div>

                <div class="it-field">
                    <label for="pwdCertNc">Contraseña del certificado</label>
                    <input type="password" name="passwordCertificado" id="pwdCertNc"
                           class="it-input" autocomplete="off" required="required" placeholder="•••••••••••" />
                    <button type="button" class="it-toggle" onclick="itTogglePwd('pwdCertNc', this)" title="Mostrar / ocultar">
                        <i class="far fa-eye"></i>
                    </button>
                </div>

                <div class="it-actions">
                    <button type="submit" class="it-btn it-btn-primary" onclick="return confirm('¿Está seguro de generar y firmar digitalmente esta No Conformidad? Se enviará al Coordinador.')">
                        <i class="fas fa-signature"></i> Firmar y Generar NC
                    </button>
                </div>
            }
        </div>
    }
    else if (requiereNoConformidad && pasoFirmado && !puedeFirmarNoConformidad)
    {
        <div class="it-panel" style="margin-top: 20px; border-left-color: #4caf50;">
            <h4><i class="fas fa-check-circle" style="color: #4caf50;"></i> No Conformidad Generada</h4>
            <p>La No Conformidad (NC) ha sido generada y firmada.</p>
            <div class="it-actions">
                <a href="@Url.Action("VerInforme", "Inspeccion", new { id = codigoInspeccion })" target="_blank" class="it-btn it-btn-secondary">
                    <i class="far fa-file-pdf"></i> Descargar NC Firmada
                </a>
            </div>
        </div>
    }

    @* ── Enviar a DIRDAC ── *@
    if (puedeEnviarADirdac || puedeReintentarNotificacionDirdac)
    {
        <div class="it-panel" style="padding: 14px 16px;">
            @if (puedeReintentarNotificacionDirdac)
            {
                <div class="it-alert warn" style="margin-bottom: 10px;">
                    <i class="fas fa-envelope-open-text"></i>
                    <div>El documento ya está en bandeja DIRDAC pero la notificación por correo falló. Puede reintentarla.</div>
                </div>
            }
            else
            {
                <h4 style="color:#0b3d78;"><i class="fas fa-paper-plane"></i> Remitir a DIRDAC para revisión</h4>
                <p class="hint">Envíe el PDF generado a la bandeja de DIRDAC / Dirección - Jefatura para la revisión institucional.</p>
            }

            @using (Html.BeginForm("EnviarADirdac", "Inspeccion", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@codigoInspeccion" />
                <button type="submit" class="it-btn primary full">
                    <i class="fas fa-@(puedeReintentarNotificacionDirdac ? "redo" : "paper-plane")"></i>
                    @(puedeReintentarNotificacionDirdac ? "Reintentar notificación DIRDAC" : "Enviar a DIRDAC")
                </button>
            }
        </div>
    }

    @* ── Timeline de estados informativos ── *@
    if (informeEnviadoACoordinador)
    {
        <div class="it-alert info">
            <i class="fas fa-user-check"></i>
            <div><strong>Informe en Coordinación (legado).</strong> Este estado pertenece al flujo anterior y solo se mantiene para expedientes ya encaminados.</div>
        </div>
    }
    else if (informeEnviadoADirdac && !informeAprobadoDireccion)
    {
        <div class="it-alert warn">
            <i class="fas fa-paper-plane"></i>
            <div>
                <strong>Informe en revisión DIRDAC.</strong>
                @if (informeTecnico.FechaEnvioDirdac.HasValue)
                {
                    <text>Enviado el @informeTecnico.FechaEnvioDirdac.Value.ToString("dd/MM/yyyy HH:mm") @(!string.IsNullOrWhiteSpace(informeTecnico.UsuarioEnvioDirdac) ? "por " + informeTecnico.UsuarioEnvioDirdac : "").</text>
                }
            </div>
        </div>
    }
    else if (string.Equals(estadoInformeTecnico, "APROBADO_COORDINADOR", StringComparison.OrdinalIgnoreCase))
    {
        <div class="it-alert success">
            <i class="fas fa-pen-nib"></i>
            <div><strong>Aprobado por Coordinación (legado).</strong> Este estado solo se conserva para expedientes del flujo anterior.</div>
        </div>
    }
    else if (informeAprobadoDireccion && informeTecnico.FirmadoInspector)
    {
        <div class="it-alert success">
            <i class="fas fa-check-double"></i>
            <div><strong>Informe finalizado.</strong> La decisión institucional final ya fue registrada@(informeTecnico.NotificadoRt ? " y la notificación al RT fue encolada." : ".");</div>
        </div>
    }

    <script>
        function itTogglePwd(id, btn) {
            var i = document.getElementById(id);
            if (!i) return;
            var icon = btn.querySelector('i');
            if (i.type === 'password') { i.type = 'text'; icon.className = 'far fa-eye-slash'; }
            else { i.type = 'password'; icon.className = 'far fa-eye'; }
        }
        (function () {
            var f = document.getElementById('frmFirmaInspector');
            if (!f) return;
            f.addEventListener('submit', function () {
                var b = document.getElementById('btnFirmarInspector');
                if (b) { b.setAttribute('disabled', 'disabled'); b.innerHTML = '<i class="fas fa-circle-notch fa-spin"></i> Firmando...'; }
            });
        })();
    </script>
}
