@inherits System.Web.Mvc.WebViewPage<Checklist>
@using CapaModelo
@using System.Web.Mvc
@using System.Web.Mvc.Html
@{
    ViewBag.Title = "Crear Checklist";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card shadow">
                <div class="card-header bg-success text-white">
                    <h4 class="mb-0"><i class="fas fa-clipboard-list"></i> Crear Nuevo Checklist</h4>
                </div>
                <div class="card-body">
                    @using (Html.BeginForm("Crear", "Checklist", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                @Html.LabelFor(m => m.Seccion, "Sección *", new { @class = "form-label" })
                                @Html.TextBoxFor(m => m.Seccion, new { @class = "form-control", required = "required", placeholder = "Ej: Seguridad Operacional" })
                                @Html.ValidationMessageFor(m => m.Seccion, "", new { @class = "text-danger" })
                            </div>
                            <div class="col-md-6 mb-3">
                                @Html.LabelFor(m => m.ItemNumero, "Número de Item", new { @class = "form-label" })
                                @Html.TextBoxFor(m => m.ItemNumero, new { @class = "form-control", placeholder = "Ej: 1.1" })
                            </div>
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(m => m.Descripcion, "Descripción *", new { @class = "form-label" })
                            @Html.TextAreaFor(m => m.Descripcion, new { @class = "form-control", rows = 4, required = "required", placeholder = "Descripción detallada del item del checklist..." })
                            @Html.ValidationMessageFor(m => m.Descripcion, "", new { @class = "text-danger" })
                        </div>

                        <div class="row">
                            <div class="col-md-4 mb-3">
                                @Html.LabelFor(m => m.Cumple, "Cumple", new { @class = "form-label" })
                                <select name="Cumple" class="form-select">
                                    <option value="">Seleccione...</option>
                                    <option value="Si">Sí</option>
                                    <option value="No">No</option>
                                    <option value="N/A">N/A</option>
                                </select>
                            </div>
                            <div class="col-md-4 mb-3">
                                @Html.LabelFor(m => m.Criticidad, "Criticidad", new { @class = "form-label" })
                                <select name="Criticidad" class="form-select">
                                    <option value="">Seleccione...</option>
                                    <option value="Alta">Alta</option>
                                    <option value="Media">Media</option>
                                    <option value="Baja">Baja</option>
                                </select>
                            </div>
                            <div class="col-md-4 mb-3">
                                @Html.LabelFor(m => m.CodigoSolicitud, "Código Solicitud", new { @class = "form-label" })
                                @Html.TextBoxFor(m => m.CodigoSolicitud, new { @class = "form-control", type = "number" })
                            </div>
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(m => m.Observaciones, "Observaciones", new { @class = "form-label" })
                            @Html.TextAreaFor(m => m.Observaciones, new { @class = "form-control", rows = 3, placeholder = "Observaciones..." })
                        </div>

                        <hr />

                        <div class="d-flex justify-content-between">
                            <a href="@Url.Action("Index", "Checklist")" class="btn btn-secondary">
                                <i class="fas fa-arrow-left"></i> Cancelar
                            </a>
                            <button type="submit" class="btn btn-success">
                                <i class="fas fa-save"></i> Guardar Checklist
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Html.Partial("_ValidationScriptsPartial")
}

