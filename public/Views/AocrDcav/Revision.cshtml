@inherits System.Web.Mvc.WebViewPage<IEnumerable<CapaNegocio.Services.AocrDcavRevisionItem>>
@using System.Linq

@{
    Layout = "~/Views/Shared/_LayoutAOCR.cshtml";
    ViewBag.Title = "Revision DCAV";
    var items = Model != null ? Model.ToList() : new System.Collections.Generic.List<CapaNegocio.Services.AocrDcavRevisionItem>();
    var informesPendientes = items.Where(i => i != null && i.TipoRevision == "INFORME_TECNICO" && (i.Estado ?? string.Empty).IndexOf("OBSERVADO", StringComparison.OrdinalIgnoreCase) < 0).ToList();
    var documentosPendientes = items.Where(i => i != null && i.TipoRevision == "DOCUMENTOS_AOCR" && (i.Estado ?? string.Empty).IndexOf("OBSERVADO", StringComparison.OrdinalIgnoreCase) < 0).ToList();
    var observados = items.Where(i => i != null && (i.Estado ?? string.Empty).IndexOf("OBSERVADO", StringComparison.OrdinalIgnoreCase) >= 0).ToList();
    var resumen = ViewBag.ResumenBandejaDcav as CapaNegocio.Services.AocrDcavBandejaResumen
        ?? new CapaNegocio.Services.AocrDcavBandejaResumen();
    var fase = Convert.ToString(ViewBag.FaseDcav ?? string.Empty).ToLowerInvariant();
    var titulo = fase == "informe" ? "Informes técnicos pendientes de revisión"
        : fase == "documentos" ? "AOCR y Condiciones pendientes de revisión"
        : "Revisión DCAV";
}

@helper RenderFila(CapaNegocio.Services.AocrDcavRevisionItem item)
{
    <tr>
        <td><strong>@item.NumeroSolicitud</strong><div class="small text-muted">SolicitudId @item.SolicitudId</div></td>
        <td>@(string.IsNullOrWhiteSpace(item.NumeroAocr) ? "Pendiente" : item.NumeroAocr)</td>
        <td>@item.NombreExplotador</td>
        <td>@item.TipoTramite</td>
        <td>@item.InspectorResponsable</td>
        <td>@item.CoordinadorResponsable</td>
        <td>@(item.FechaEnvioDcav.HasValue ? item.FechaEnvioDcav.Value.ToString("dd/MM/yyyy HH:mm") : "-")</td>
        <td>@item.TipoRevision</td>
        <td><span class="badge bg-warning text-dark">@item.Estado</span></td>
        <td>
            <a class="btn btn-sm btn-primary" href="@Url.Action("Detalle", "AocrDcav", new { solicitudId = item.SolicitudId })">Ver expediente</a>
            @if (item.TipoRevision == "DOCUMENTOS_AOCR")
            {
                <a class="btn btn-sm btn-outline-secondary" href="@Url.Action("VerDocumentoEnviado", "AocrDcav", new { solicitudId = item.SolicitudId, tipoDocumento = "RECONOCIMIENTO" })" target="_blank">Ver AOCR</a>
                <a class="btn btn-sm btn-outline-secondary" href="@Url.Action("VerDocumentoEnviado", "AocrDcav", new { solicitudId = item.SolicitudId, tipoDocumento = "CONDICIONES_LIMITACIONES" })" target="_blank">Ver Condiciones</a>
            }
        </td>
    </tr>
}

<div class="container-fluid mt-4">
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body d-flex justify-content-between align-items-center">
            <div>
                <span class="badge bg-primary-subtle text-primary mb-2">Director de Certificaciones DCAV</span>
                <h2 class="mb-1">@titulo</h2>
                <p class="text-muted mb-0">@(fase == "informe" ? "Informes técnicos firmados pendientes de aprobación DCAV." : fase == "documentos" ? "AOCR y Condiciones enviados por el Inspector pendientes de aprobación DCAV." : "Expedientes pendientes de decisión del Director de Certificaciones DCAV.")</p>
            </div>
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (!items.Any() && resumen.InformesGeneradosSinFirma > 0)
    {
        <div class="alert alert-warning d-flex align-items-start gap-2">
            <i class="fas fa-file-signature mt-1"></i>
            <div>
                <strong>No existen informes firmados pendientes de DCAV.</strong>
                Hay @resumen.InformesGeneradosSinFirma informe(s) con PDF generado que todavia requieren la firma digital del Inspector. Esos expedientes no pueden ingresar a revision DCAV hasta completar la firma.
            </div>
        </div>
    }

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Numero de solicitud</th>
                            <th>Numero de AOCR</th>
                            <th>Explotador</th>
                            <th>Tipo de tramite</th>
                            <th>Inspector</th>
                            <th>Coordinador</th>
                            <th>Envio a DCAV</th>
                            <th>Revision</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!items.Any())
                        {
                            <tr>
                                <td colspan="10" class="text-center text-muted py-4">
                                    @(resumen.InformesGeneradosSinFirma > 0
                                        ? "No existen informes firmados pendientes. Hay informes generados esperando firma del Inspector."
                                        : fase == "documentos" ? "No existen AOCR y Condiciones enviados por el Inspector pendientes de revisión DCAV."
                                        : fase == "informe" ? "No existen informes técnicos pendientes de revisión DCAV."
                                        : "No existen expedientes pendientes de revision DCAV.")
                                </td>
                            </tr>
                        }
                        @if (informesPendientes.Any())
                        {
                            <tr class="table-primary"><td colspan="10"><strong>Informes Tecnicos pendientes</strong></td></tr>
                            foreach (var item in informesPendientes)
                            {
                                @RenderFila(item)
                            }
                        }
                        @if (documentosPendientes.Any())
                        {
                            <tr class="table-info"><td colspan="10"><strong>AOCR y Condiciones pendientes</strong></td></tr>
                            foreach (var item in documentosPendientes)
                            {
                                @RenderFila(item)
                            }
                        }
                        @if (observados.Any())
                        {
                            <tr class="table-warning"><td colspan="10"><strong>Expedientes observados o devueltos</strong></td></tr>
                            foreach (var item in observados)
                            {
                                @RenderFila(item)
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
