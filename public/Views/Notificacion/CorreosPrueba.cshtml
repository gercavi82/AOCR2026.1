@inherits System.Web.Mvc.WebViewPage<CapaPresentacion.Models.CorreoPruebaViewModel>
@using System.Web.Mvc
@using System.Web.Mvc.Html
@{
    ViewBag.Title = "Correos de Prueba";
    Layout = "~/Views/Shared/_LayoutAOCR.cshtml";
}

<div class="content-wrapper">
    <section class="content-header">
        <h1>
            <i class="fa fa-envelope"></i> Correos de Prueba
            <small>Envío manual de plantillas reales a un buzón sandbox</small>
        </h1>
        <ol class="breadcrumb">
            <li><a href="@Url.Action("Index", "Home")"><i class="fa fa-dashboard"></i> Inicio</a></li>
            <li><a href="@Url.Action("Index", "Notificacion")">Notificaciones</a></li>
            <li class="active">Correos de prueba</li>
        </ol>
    </section>

    <section class="content">
        <div class="row">
            <div class="col-md-8">
                <div class="box box-primary">
                    <div class="box-header with-border">
                        <h3 class="box-title"><i class="fa fa-paper-plane"></i> Enviar correo de prueba</h3>
                    </div>
                    <div class="box-body">
                        @if (Model.ResultadoExitoso.HasValue)
                        {
                            <div class="alert @(Model.ResultadoExitoso.Value ? "alert-success" : "alert-danger")">
                                @Model.ResultadoMensaje
                            </div>
                        }

                        @Html.ValidationSummary(false, "Revise la información antes de enviar el correo.", new { @class = "alert alert-warning" })

                        @using (Html.BeginForm("CorreosPrueba", "Notificacion", FormMethod.Post))
                        {
                            @Html.AntiForgeryToken()

                            <div class="form-group">
                                @Html.LabelFor(m => m.Plantilla)
                                @Html.DropDownListFor(
                                    m => m.Plantilla,
                                    Model.PlantillasDisponibles,
                                    "Seleccione una plantilla",
                                    new { @class = "form-control" })
                            </div>

                            <div class="row">
                                <div class="col-md-7">
                                    <div class="form-group">
                                        @Html.LabelFor(m => m.CorreoDestino)
                                        @Html.TextBoxFor(m => m.CorreoDestino, new { @class = "form-control", placeholder = "qa.aocr@dominio.local" })
                                    </div>
                                </div>
                                <div class="col-md-5">
                                    <div class="form-group">
                                        @Html.LabelFor(m => m.NombreDestino)
                                        @Html.TextBoxFor(m => m.NombreDestino, new { @class = "form-control", placeholder = "Usuario QA" })
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-4">
                                    <div class="form-group">
                                        @Html.LabelFor(m => m.SolicitudId)
                                        @Html.TextBoxFor(m => m.SolicitudId, new { @class = "form-control", type = "number", min = "1", placeholder = "101" })
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-group">
                                        @Html.LabelFor(m => m.InspeccionId)
                                        @Html.TextBoxFor(m => m.InspeccionId, new { @class = "form-control", type = "number", min = "1", placeholder = "55" })
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-group">
                                        @Html.LabelFor(m => m.OrdenId)
                                        @Html.TextBoxFor(m => m.OrdenId, new { @class = "form-control", type = "number", min = "1", placeholder = "125" })
                                    </div>
                                </div>
                            </div>

                            <div class="form-group">
                                @Html.LabelFor(m => m.Observacion)
                                @Html.TextAreaFor(m => m.Observacion, 4, 1, new { @class = "form-control", placeholder = "Observación opcional que se incluirá en la plantilla cuando aplique." })
                            </div>

                            <div class="form-group">
                                <button type="submit" class="btn btn-primary">
                                    <i class="fa fa-send"></i> Enviar correo de prueba
                                </button>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="box box-info">
                    <div class="box-header with-border">
                        <h3 class="box-title"><i class="fa fa-info-circle"></i> Uso</h3>
                    </div>
                    <div class="box-body">
                        <ul class="mb-0">
                            <li>Use un correo sandbox para evitar envíos a destinatarios reales.</li>
                            <li>`Solicitud AOCR` es obligatoria para plantillas `LEGACY`, `GENERIC` y `SOLICITUD`.</li>
                            <li>`Inspección` es obligatoria para plantillas `INSPECCION`.</li>
                            <li>`Orden de recaudación` es obligatoria para plantillas `ORDEN`.</li>
                            <li>Si informa `Nombre destino`, ese nombre se mostrará en el saludo del correo de prueba.</li>
                            <li>La observación se usa como texto adicional cuando la plantilla la incorpora.</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>
