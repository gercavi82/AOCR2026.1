@inherits System.Web.Mvc.WebViewPage<IEnumerable<System.Tuple<CapaModelo.Inspeccion, CapaModelo.SolicitudAOCR, CapaModelo.InspeccionInformeTecnico>>>
@using System.Linq
@using System.Collections.Generic
@using System.Web.Mvc
@using System.Web.Mvc.Html

@{
    Layout = "~/Views/Shared/_LayoutAOCR.cshtml";
    ViewBag.Title = "Informes Pendientes de Revisión DIRDAC";
    var items = Model != null ? Model.ToList() : new List<System.Tuple<CapaModelo.Inspeccion, CapaModelo.SolicitudAOCR, CapaModelo.InspeccionInformeTecnico>>();
}

<div class="container-fluid mt-4">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="aocr-breadcrumb breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="@Url.Action("DashboardInspeccion", "CoordinacionJefatura")">Dashboard Inspección</a></li>
            <li class="breadcrumb-item active" aria-current="page">Informes Pendientes de Revisión DIRDAC</li>
        </ol>
    </nav>
    <div class="card shadow-sm border-0">
        <div class="card-body">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
                <div>
                    <h2 class="mb-1">Informes pendientes de revisión DIRDAC</h2>
                    <p class="text-muted mb-0">Bandeja exclusiva de informes técnicos listos para la decisión institucional final de DIRDAC / Dirección - Jefatura.</p>
                </div>
                <a class="btn btn-outline-secondary" href="@Url.Action("DashboardInspeccion", "CoordinacionJefatura")">Volver al dashboard</a>
            </div>

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">@TempData["Error"]</div>
            }

            @if (!items.Any())
            {
                <div class="alert alert-info mb-0">No existen informes tecnicos pendientes de revision institucional.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Inspeccion</th>
                                <th>Solicitud</th>
                                <th>Compania</th>
                                <th>Estado informe</th>
                                <th>Notificacion formal</th>
                                <th>Inspector</th>
                                <th>Enviado a Direccion</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in items)
                            {
                                var inspeccion = item.Item1;
                                var solicitud = item.Item2;
                                var informe = item.Item3;
                                var numeroSolicitud = !string.IsNullOrWhiteSpace(solicitud != null ? solicitud.NumeroSolicitud : null)
                                    ? solicitud.NumeroSolicitud
                                    : ("DGAC-GOP-2026-AOCR" + inspeccion.CodigoSolicitud);
                                <tr>
                                    <td>@inspeccion.CodigoInspeccion</td>
                                    <td>@numeroSolicitud</td>
                                    <td>@(solicitud != null ? (solicitud.RazonSocial ?? solicitud.NombreOperador ?? "-") : "-")</td>
                                    <td>@(informe != null ? informe.EstadoInforme : "-")</td>
                                    <td>
                                        @if (informe != null && informe.CorreoEnviado)
                                        {
                                            <span class="badge bg-success">Correo enviado</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">Pendiente reintento</span>
                                        }
                                    </td>
                                    <td>@(!string.IsNullOrWhiteSpace(informe != null ? informe.UsuarioFirma1 : null) ? informe.UsuarioFirma1 : "Pendiente")</td>
                                    <td>@(informe != null && informe.FechaEnvioDirdac.HasValue ? informe.FechaEnvioDirdac.Value.ToString("yyyy-MM-dd HH:mm") : "Pendiente")</td>
                                    <td>
                                        <div class="d-flex gap-2 flex-wrap">
                                            <a class="btn btn-sm btn-outline-primary" href="@Url.Action("Detalle", "Inspeccion", new { id = inspeccion.CodigoInspeccion })">Abrir detalle</a>
                                            <a class="btn btn-sm btn-outline-success" href="@Url.Action("VerInforme", "Inspeccion", new { id = inspeccion.CodigoInspeccion })" target="_blank" rel="noopener">Ver PDF</a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
