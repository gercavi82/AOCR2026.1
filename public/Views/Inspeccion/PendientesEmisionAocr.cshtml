@model CapaPresentacion.Models.ViewModels.PendienteEmisionAocrViewModel

@{
    ViewBag.Title = "Generar AOCR y Condiciones";
    Layout = "~/Views/Shared/_LayoutAOCR.cshtml";
}

<div class="aocr-page-header">
    <div class="row align-items-center">
        <div class="col-md-9">
            <h1 class="aocr-page-title text-success">
                <i class="fas fa-certificate mr-2"></i> Generar AOCR y Condiciones
            </h1>
            <p class="aocr-page-subtitle">Expedientes aprobados por DIRDAC que requieren preparar sus documentos finales.</p>
        </div>
    </div>
</div>

<div class="aocr-card">
    <div class="aocr-card-body p-0">
        <div class="table-responsive">
            <table class="table aocr-table aocr-table-hover mb-0">
                <thead>
                    <tr>
                        <th>SOLICITUD</th>
                        <th>COMPAÑÍA</th>
                        <th>INSPECCIÓN</th>
                        <th>TIPO DE TRÁMITE</th>
                        <th>INSPECTOR ASIGNADO</th>
                        <th>APROBACIÓN DIRDAC</th>
                        <th>ESTADO AOCR</th>
                        <th>ESTADO CONDICIONES</th>
                        <th class="text-right">ACCIONES</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Inspecciones != null && Model.Inspecciones.Any())
                    {
                        foreach (var fila in Model.Inspecciones)
                        {
                            <tr>
                                <td>
                                    <span class="font-weight-bold">@fila.NumeroSolicitud</span>
                                </td>
                                <td>
                                    <div class="font-weight-bold">@fila.CompaniaNombre</div>
                                    <div class="text-muted small">RUC: @fila.CompaniaRuc</div>
                                </td>
                                <td>@fila.NumeroInspeccion</td>
                                <td><span class="badge badge-light border">@fila.TipoTramite</span></td>
                                <td>@fila.InspectorAsignado</td>
                                <td>@(fila.FechaAprobacionDirdac.HasValue ? fila.FechaAprobacionDirdac.Value.ToString("dd/MM/yyyy HH:mm") : "Sin fecha")</td>
                                <td>
                                    @if (fila.GenerarAocr)
                                    {
                                        <span class="badge badge-info">@fila.EstadoAocr</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-secondary">NO APLICA</span>
                                    }
                                </td>
                                <td>
                                    @if (fila.GenerarCondiciones)
                                    {
                                        <span class="badge badge-info">@fila.EstadoCondiciones</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-secondary">NO APLICA</span>
                                    }
                                </td>
                                <td class="text-right text-nowrap">
                                    @if (fila.GenerarCondiciones)
                                    {
                                        <a href="@Url.Action("RedactarEspecificaciones", "Inspeccion", new { inspeccionId = fila.InspeccionId })"
                                           class="btn btn-sm btn-outline-primary" title="Redactar Condiciones y Limitaciones">
                                            <i class="fas fa-edit"></i> Redactar
                                        </a>
                                    }
                                    <a href="@Url.Action("Index", "FirmaAocr", new { solicitudId = fila.SolicitudId })"
                                       class="btn btn-sm btn-success ml-1" title="Gestionar documentos finales">
                                        <i class="fas fa-file-signature"></i> Gestionar documentos
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center text-muted py-4">
                                <i class="fas fa-inbox fa-3x mb-3 d-block opacity-50"></i>
                                No hay expedientes aprobados pendientes de documentos finales.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
