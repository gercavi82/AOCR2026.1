    .fin-orders-page td {
        color: #102033;
    }

    .fin-orders-page {
        padding: 18px 8px 28px;
    }

    .fo-header {
        display: flex;
        justify-content: space-between;
        gap: 18px;
        align-items: flex-start;
        background: #ffffff;
        border: 1px solid #d9e3ea;
        border-left: 5px solid #0b6f86;
        border-radius: 8px;
