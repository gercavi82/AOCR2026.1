    }

    .fo-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        background: #ffffff;
        border: 1px solid #d9e3ea;
        border-radius: 8px 8px 0 0;
        padding: 12px 14px;
    }

    .fo-filter-form {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
        margin: 0;
    }

    .fo-filter-form label {
        font-size: .82rem;
        font-weight: 800;
        color: #40576d !important;
        margin: 0;
    }

    .fo-filter-form select {
        min-width: 220px;
        border-color: #b8cbd8;
        color: #102033;
        font-weight: 700;
    }

    .fo-table-shell {
        background: #ffffff;
        border: 1px solid #d9e3ea;
        border-top: 0;
        border-radius: 0 0 8px 8px;
        box-shadow: 0 12px 26px rgba(16, 32, 51, .08);
        padding: 12px 14px 16px;
    }

    .fo-table-wrap {
        overflow-x: auto;
    }

    #dataTable {
        width: 100% !important;
        margin: 0 !important;
        border-collapse: separate;
        border-spacing: 0;
    }

    #dataTable thead th {
        background: #155676;
        color: #ffffff !important;
        border-color: #155676;
        font-size: .76rem;
        text-transform: uppercase;
