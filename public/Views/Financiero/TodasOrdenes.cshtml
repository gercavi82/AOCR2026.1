@inherits System.Web.Mvc.WebViewPage<List<CapaDatos.Models.OrdenRecaudacionModel>>
@using CapaDatos.Constants
@using CapaDatos.Models
@using CapaPresentacion.Helpers
@using System.Linq
@using System.Web.Mvc
@using System.Web.Mvc.Html
@functions {
    public static string NormalizarEstadoVisual(string estado)
    {
        var actual = EstadoOrden.NormalizarEstado(estado);
        if (actual == EstadoOrden.Pendiente || actual == EstadoOrden.Generada)
        {
            return EstadoOrden.Generada;
        }

        return actual;
    }

    public static string GetTextoEstado(string estado)
    {
        if (string.IsNullOrWhiteSpace(estado))
        {
            return "SIN ESTADO";
        }

        var est = NormalizarEstadoVisual(estado);
        switch (est)
        {
            case EstadoOrden.Generada: return "GENERADA";
            case EstadoOrden.Enviada: return "ENVIADA";
            case EstadoOrden.EnRevisionFinanciera: return "EN REVISION FINANCIERA";
            case EstadoOrden.Devuelta: return "DEVUELTA";
            case EstadoOrden.Facturada: return "FACTURADA";
            case EstadoOrden.Completada: return "COMPLETADA";
            case EstadoOrden.Pagada: return "PAGADA";
            case EstadoOrden.Anulada: return "ANULADA";
            default: return est;
        }
    }

    public static string GetTextoTramite(string estado)
    {
        if (string.IsNullOrWhiteSpace(estado))
        {
            return "SIN ESTADO";
        }

        var est = NormalizarEstadoVisual(estado);
        switch (est)
        {
            case EstadoOrden.Borrador: return "Borrador";
            case EstadoOrden.Generada: return "Generada / pendiente de pago";
            case EstadoOrden.Enviada: return "Enviada a financiero";
            case EstadoOrden.EnRevisionFinanciera: return "En revision financiera";
            case EstadoOrden.Devuelta: return "Devuelta para correccion";
            case EstadoOrden.Facturada: return "Factura generada";
            case EstadoOrden.Completada: return "Completada";
            case EstadoOrden.Pagada: return "Pagada";
            case EstadoOrden.Anulada: return "Anulada";
            default: return est;
        }
    }

    public static string GetBadgeEstado(string estado)
    {
        switch (NormalizarEstadoVisual(estado))
        {
            case EstadoOrden.Facturada:
            case EstadoOrden.Completada:
            case EstadoOrden.Pagada:
                return "fo-badge fo-badge-success";
            case EstadoOrden.Anulada:
            case EstadoOrden.Devuelta:
                return "fo-badge fo-badge-danger";
            case EstadoOrden.EnRevisionFinanciera:
                return "fo-badge fo-badge-primary";
            case EstadoOrden.Enviada:
                return "fo-badge fo-badge-info";
            case EstadoOrden.Generada:
                return "fo-badge fo-badge-warning";
            default:
                return "fo-badge fo-badge-muted";
        }
    }
}

@{
    ViewBag.Title = "Todas las Órdenes de recaudación";
    var ordenes = Model ?? new List<OrdenRecaudacionModel>();
    var estadoFiltro = (ViewBag.EstadoFiltro as string) ?? "TODAS";
    var totalSinFiltro = ordenes.Count;
    if (ViewBag.TotalSinFiltro != null)
    {
        totalSinFiltro = Convert.ToInt32(ViewBag.TotalSinFiltro);
    }
    var totalOrdenes = ordenes.Count;
    var totalMonto = ordenes.Sum(o => o != null ? o.Total : 0m);
    var facturadas = ordenes.Count(o => o != null && NormalizarEstadoVisual(o.Estado) == EstadoOrden.Facturada);
    var revision = ordenes.Count(o => o != null && NormalizarEstadoVisual(o.Estado) == EstadoOrden.EnRevisionFinanciera);
    var observadas = ordenes.Count(o => o != null && NormalizarEstadoVisual(o.Estado) == EstadoOrden.Devuelta);
    var anuladas = ordenes.Count(o => o != null && NormalizarEstadoVisual(o.Estado) == EstadoOrden.Anulada);
}

<style>
