@inherits System.Web.Mvc.WebViewPage
@{
    ViewBag.Title = "Health Dashboard";
    Layout = "~/Views/Shared/_LayoutAOCR.cshtml";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <h1 class="mt-4"><i class="fas fa-heartbeat text-danger"></i> Health Dashboard</h1>
            <p class="lead">Estado del sistema AOCR en tiempo real</p>
            <hr />
        </div>
    </div>

    <!-- Status Cards Row -->
    <div class="row" id="statusCards">
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-start shadow h-100 py-2" id="cardApp">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-uppercase small fw-bold mb-1">Aplicación</div>
                        <div class="h5 mb-0 fw-bold" id="appStatus">Verificando...</div>
                    </div>
                    <i class="fas fa-server fa-2x text-secondary opacity-50"></i>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-start shadow h-100 py-2" id="cardPg">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-uppercase small fw-bold mb-1">PostgreSQL</div>
                        <div class="h5 mb-0 fw-bold" id="pgStatus">Verificando...</div>
                    </div>
                    <i class="fas fa-database fa-2x text-secondary opacity-50"></i>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-start shadow h-100 py-2" id="cardAs400">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-uppercase small fw-bold mb-1">AS400 / DB2</div>
                        <div class="h5 mb-0 fw-bold" id="as400Status">Verificando...</div>
                    </div>
                    <i class="fas fa-network-wired fa-2x text-secondary opacity-50"></i>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-start shadow h-100 py-2" id="cardFr3">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-uppercase small fw-bold mb-1">Facturación FR3</div>
                        <div class="h5 mb-0 fw-bold" id="fr3Status">Verificando...</div>
                    </div>
                    <i class="fas fa-file-invoice-dollar fa-2x text-secondary opacity-50"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- AS400 Details -->
        <div class="col-lg-6 mb-4">
            <div class="card shadow">
                <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                    <span><i class="fas fa-network-wired me-2"></i>AS400 / DB2 - Detalle</span>
                    <button class="btn btn-sm btn-outline-light" onclick="refreshAs400()">
                        <i class="fas fa-sync-alt"></i>
                    </button>
                </div>
                <div class="card-body" id="as400Details">
                    <div class="text-center py-3">
                        <div class="spinner-border text-primary" role="status"></div>
                        <p class="mt-2 text-muted">Verificando conexión AS400...</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Circuit Breakers -->
        <div class="col-lg-6 mb-4">
            <div class="card shadow">
                <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                    <span><i class="fas fa-shield-alt me-2"></i>Circuit Breakers</span>
                    <button class="btn btn-sm btn-outline-light" onclick="refreshCircuitBreakers()">
                        <i class="fas fa-sync-alt"></i>
                    </button>
                </div>
                <div class="card-body" id="cbDetails">
                    <div class="text-center py-3">
                        <div class="spinner-border text-primary" role="status"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Sync & Retry Stats -->
        <div class="col-lg-6 mb-4">
            <div class="card shadow">
                <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                    <span><i class="fas fa-sync me-2"></i>Sincronización FR3</span>
                    <button class="btn btn-sm btn-outline-light" onclick="refreshSyncStats()">
                        <i class="fas fa-sync-alt"></i>
                    </button>
                </div>
                <div class="card-body" id="syncDetails">
                    <div class="text-center py-3">
                        <div class="spinner-border text-primary" role="status"></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- FR3 Retry Queue -->
        <div class="col-lg-6 mb-4">
            <div class="card shadow">
                <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                    <span><i class="fas fa-redo me-2"></i>Cola de Reintentos FR3</span>
                    <div>
                        <button class="btn btn-sm btn-warning me-1" onclick="processFr3Retries()" id="btnProcessRetries">
                            <i class="fas fa-play"></i> Procesar
                        </button>
                        <button class="btn btn-sm btn-outline-light" onclick="refreshSyncStats()">
                            <i class="fas fa-sync-alt"></i>
                        </button>
                    </div>
                </div>
                <div class="card-body" id="retryDetails">
                    <div class="text-center py-3">
                        <div class="spinner-border text-primary" role="status"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- General Health -->
    <div class="row">
        <div class="col-12 mb-4">
            <div class="card shadow">
                <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                    <span><i class="fas fa-stethoscope me-2"></i>Health Check General</span>
                    <button class="btn btn-sm btn-outline-light" onclick="refreshGeneral()">
                        <i class="fas fa-sync-alt"></i>
                    </button>
                </div>
                <div class="card-body" id="generalDetails">
                    <div class="text-center py-3">
                        <div class="spinner-border text-primary" role="status"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12 mb-4">
            <div class="card shadow">
                <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                    <span><i class="fas fa-tools me-2"></i>Resincronizar AOCR legacy</span>
                    <div>
                        <button class="btn btn-sm btn-outline-light me-2" onclick="previewLegacyAocrCandidates()" id="btnPreviewLegacyAocr">
                            <i class="fas fa-search"></i> Consultar candidatas
                        </button>
                        <button class="btn btn-sm btn-warning" onclick="resyncLegacyAocrCases()" id="btnResyncLegacyAocr">
                            <i class="fas fa-wrench"></i> Ejecutar resincronización
                        </button>
                    </div>
                </div>
                <div class="card-body" id="legacyAocrDetails">
                    <p class="text-muted mb-2">Repara solicitudes antiguas aprobadas por Dirección que quedaron en Aceptación Documental o Documentación Completa antes de entrar al flujo AOCR.</p>
                    <div class="small text-muted">La consulta lista solo lectura las candidatas reales. La resincronización mueve únicamente los casos con informe técnico institucional aprobado a AOCR En Elaboración.</div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12 text-muted small text-end mb-3">
            Última actualización: <span id="lastUpdate">-</span>
            &nbsp;|&nbsp;
            <a href="#" onclick="refreshAll(); return false;"><i class="fas fa-sync-alt"></i> Refrescar todo</a>
        </div>
    </div>
</div>

@section scripts {
<script>
    var antiForgeryToken = '@Html.AntiForgeryToken()';
    var tokenVal = $(antiForgeryToken).val();

    function setCardStatus(cardId, statusId, text, color) {
        var colors = { green: 'border-success', red: 'border-danger', yellow: 'border-warning', blue: 'border-info', gray: 'border-secondary' };
        var textColors = { green: 'text-success', red: 'text-danger', yellow: 'text-warning', blue: 'text-info', gray: 'text-secondary' };
        var card = document.getElementById(cardId);
        var status = document.getElementById(statusId);

        // Remove all border classes
        Object.values(colors).forEach(function (c) { card.classList.remove(c); });
        card.classList.add(colors[color] || colors.gray);

        // Remove all text colors
        Object.values(textColors).forEach(function (c) { status.classList.remove(c); });
        status.classList.add(textColors[color] || textColors.gray);
        status.textContent = text;
    }

    function refreshAs400() {
        document.getElementById('as400Details').innerHTML = '<div class="text-center py-3"><div class="spinner-border text-primary" role="status"></div></div>';
        $.getJSON('@Url.Action("As400", "Health")', function (data) {
            var statusColor = data.status === 'healthy' ? 'green' : (data.status === 'degraded' ? 'yellow' : 'red');
            setCardStatus('cardAs400', 'as400Status', data.status === 'healthy' ? 'Saludable' : (data.status === 'degraded' ? 'Degradado' : 'No disponible'), statusColor);

            var html = '<table class="table table-sm table-bordered mb-0">';
            html += '<tr><td class="fw-bold" width="40%">Estado</td><td>' + (data.status_badge || data.status) + '</td></tr>';
            html += '<tr><td class="fw-bold">Servidor</td><td>' + (data.server || 'N/A') + '</td></tr>';
            html += '<tr><td class="fw-bold">Base de Datos</td><td>' + (data.database || 'N/A') + '</td></tr>';
            html += '<tr><td class="fw-bold">Facturación Habilitada</td><td>' + (data.facturacion_enabled ? '<span class="badge bg-success">Sí</span>' : '<span class="badge bg-secondary">No</span>') + '</td></tr>';
            html += '<tr><td class="fw-bold">Tiempo Respuesta</td><td>' + (data.response_time_ms || '?') + ' ms</td></tr>';

            if (data.connection) {
                html += '<tr><td class="fw-bold">Conexión</td><td>' + (data.connection.success ? '<span class="badge bg-success">OK</span>' : '<span class="badge bg-danger">Error: ' + (data.connection.error || '') + '</span>') + '</td></tr>';
            }
            if (data.circuit_breaker) {
                html += '<tr><td class="fw-bold">Circuit Breaker</td><td>' + (data.circuit_breaker.state_badge || data.circuit_breaker.state) + '</td></tr>';
            }
            if (data.tables && data.tables.length > 0) {
                html += '<tr><td class="fw-bold">Tablas FR3</td><td>';
                data.tables.forEach(function (t) {
                    var icon = t.Accessible ? '<i class="fas fa-check-circle text-success"></i>' : '<i class="fas fa-times-circle text-danger"></i>';
                    html += icon + ' ' + t.TableName + '&nbsp;&nbsp;';
                });
                html += '</td></tr>';
            }
            html += '</table>';
            document.getElementById('as400Details').innerHTML = html;
        }).fail(function () {
            setCardStatus('cardAs400', 'as400Status', 'Error', 'red');
            document.getElementById('as400Details').innerHTML = '<div class="alert alert-danger mb-0">No se pudo verificar AS400</div>';
        });
    }

    function refreshCircuitBreakers() {
        document.getElementById('cbDetails').innerHTML = '<div class="text-center py-3"><div class="spinner-border text-primary" role="status"></div></div>';
        $.getJSON('@Url.Action("CircuitBreakers", "Health")', function (data) {
            if (!data.circuit_breakers || data.circuit_breakers.length === 0) {
                document.getElementById('cbDetails').innerHTML = '<p class="text-muted mb-0">No hay circuit breakers registrados.</p>';
                return;
            }
            var html = '<table class="table table-sm table-bordered mb-0"><thead><tr><th>Nombre</th><th>Estado</th><th>Fallas</th><th>Disponible</th><th>Acción</th></tr></thead><tbody>';
            data.circuit_breakers.forEach(function (cb) {
                var badge = cb.state_badge || cb.state;
                var available = cb.is_available ? '<span class="badge bg-success">Sí</span>' : '<span class="badge bg-danger">No</span>';
                var resetBtn = !cb.is_available ? '<button class="btn btn-sm btn-outline-warning" onclick="resetCB(\'' + cb.name + '\')"><i class="fas fa-undo"></i></button>' : '-';
                html += '<tr><td>' + cb.name + '</td><td>' + badge + '</td><td>' + cb.failure_count + '/' + cb.max_failures + '</td><td>' + available + '</td><td>' + resetBtn + '</td></tr>';
            });
            html += '</tbody></table>';
            document.getElementById('cbDetails').innerHTML = html;
        }).fail(function () {
            document.getElementById('cbDetails').innerHTML = '<div class="alert alert-danger mb-0">Error al consultar circuit breakers</div>';
        });
    }

    function resetCB(name) {
        if (!confirm('¿Resetear circuit breaker "' + name + '"?')) return;
        $.ajax({
            url: '@Url.Action("ResetCircuitBreaker", "Health")',
            type: 'POST',
            data: { name: name, __RequestVerificationToken: tokenVal },
            success: function (r) {
                alert(r.message);
                refreshCircuitBreakers();
                refreshAs400();
            },
            error: function () { alert('Error al resetear.'); }
        });
    }

    function refreshSyncStats() {
        var syncEl = document.getElementById('syncDetails');
        var retryEl = document.getElementById('retryDetails');
        syncEl.innerHTML = '<div class="text-center py-3"><div class="spinner-border text-primary" role="status"></div></div>';
        retryEl.innerHTML = '<div class="text-center py-3"><div class="spinner-border text-primary" role="status"></div></div>';

        $.getJSON('@Url.Action("SyncStats", "Health")', function (data) {
            // Facturación status
            var fr3Enabled = data.facturacion_enabled;
            setCardStatus('cardFr3', 'fr3Status', fr3Enabled ? 'Habilitada' : 'Deshabilitada', fr3Enabled ? 'green' : 'gray');

            // Sync details
            var s = data.sync;
            var html = '<table class="table table-sm table-bordered mb-0">';
            html += '<tr><td class="fw-bold" width="45%">Total Operaciones</td><td>' + (s.total || 0) + '</td></tr>';
            html += '<tr><td class="fw-bold">Completados</td><td><span class="badge bg-success">' + (s.completados || 0) + '</span></td></tr>';
            html += '<tr><td class="fw-bold">Errores</td><td><span class="badge bg-danger">' + (s.errores || 0) + '</span></td></tr>';
            html += '<tr><td class="fw-bold">Reintentando</td><td><span class="badge bg-warning">' + (s.reintentando || 0) + '</span></td></tr>';
            html += '<tr><td class="fw-bold">Tasa Éxito</td><td>' + (s.tasa_exito || 0).toFixed(1) + '%</td></tr>';
            html += '<tr><td class="fw-bold">Duración Promedio</td><td>' + (s.duracion_promedio_ms || 0) + ' ms</td></tr>';
            if (s.ultimo_registro) {
                html += '<tr><td class="fw-bold">Último Registro</td><td>' + new Date(s.ultimo_registro).toLocaleString('es-EC') + '</td></tr>';
            }
            html += '</table>';
            syncEl.innerHTML = html;

            // Retry queue
            var r = data.retry_queue;
            var rHtml = '<table class="table table-sm table-bordered mb-0">';
            rHtml += '<tr><td class="fw-bold" width="45%">Pendientes</td><td><span class="badge bg-warning">' + (r.pendientes || 0) + '</span></td></tr>';
            rHtml += '<tr><td class="fw-bold">En Proceso</td><td><span class="badge bg-info">' + (r.en_proceso || 0) + '</span></td></tr>';
            rHtml += '<tr><td class="fw-bold">Completados</td><td><span class="badge bg-success">' + (r.completados || 0) + '</span></td></tr>';
            rHtml += '<tr><td class="fw-bold">Fallidos</td><td><span class="badge bg-danger">' + (r.fallidos || 0) + '</span></td></tr>';
            rHtml += '<tr><td class="fw-bold">Total</td><td>' + (r.total || 0) + '</td></tr>';
            if (r.proximo_intento) {
                rHtml += '<tr><td class="fw-bold">Próximo Intento</td><td>' + new Date(r.proximo_intento).toLocaleString('es-EC') + '</td></tr>';
            }
            rHtml += '</table>';
            retryEl.innerHTML = rHtml;

            // Show/hide process button
            document.getElementById('btnProcessRetries').style.display = (r.pendientes > 0) ? '' : 'none';

        }).fail(function () {
            syncEl.innerHTML = '<div class="alert alert-warning mb-0">No se pudieron obtener estadísticas de sincronización. Tablas posiblemente no creadas.</div>';
            retryEl.innerHTML = '<div class="alert alert-warning mb-0">No se pudieron obtener estadísticas de reintentos.</div>';
            setCardStatus('cardFr3', 'fr3Status', 'Sin datos', 'gray');
        });
    }

    function processFr3Retries() {
        if (!confirm('¿Procesar reintentos FR3 pendientes?')) return;
        document.getElementById('btnProcessRetries').disabled = true;
        $.ajax({
            url: '@Url.Action("ProcessFr3Retries", "Health")',
            type: 'POST',
            data: { __RequestVerificationToken: tokenVal },
            success: function (r) {
                var msg = r.success
                    ? 'Exitosos: ' + r.exitosos + ', Fallidos: ' + r.fallidos + ', En cola: ' + r.total_en_cola
                    : 'Error: ' + r.mensaje;
                alert(msg);
                document.getElementById('btnProcessRetries').disabled = false;
                refreshSyncStats();
            },
            error: function () {
                alert('Error al procesar reintentos.');
                document.getElementById('btnProcessRetries').disabled = false;
            }
        });
    }

    function resyncLegacyAocrCases() {
        if (!confirm('¿Resincronizar solicitudes legacy aprobadas por Dirección al flujo AOCR?')) return;

        var btn = document.getElementById('btnResyncLegacyAocr');
        var previewBtn = document.getElementById('btnPreviewLegacyAocr');
        var details = document.getElementById('legacyAocrDetails');
        btn.disabled = true;
        previewBtn.disabled = true;
        details.innerHTML = '<div class="text-center py-3"><div class="spinner-border text-primary" role="status"></div><p class="mt-2 text-muted">Resincronizando casos legacy AOCR...</p></div>';

        $.ajax({
            url: '@Url.Action("ResyncLegacyAocrCases", "Health")',
            type: 'POST',
            data: { limit: 200, __RequestVerificationToken: tokenVal },
            success: function (r) {
                var html = '<div class="alert ' + (r.success ? 'alert-success' : 'alert-danger') + ' mb-3">' + (r.message || 'Sin respuesta del servidor.') + '</div>';
                html += '<table class="table table-sm table-bordered mb-0">';
                html += '<tr><td class="fw-bold" width="40%">Límite aplicado</td><td>' + (r.limit || 0) + '</td></tr>';
                html += '<tr><td class="fw-bold">Candidatas</td><td>' + (r.candidateCount || 0) + '</td></tr>';
                html += '<tr><td class="fw-bold">Sincronizadas</td><td><span class="badge bg-success">' + (r.syncedCount || 0) + '</span></td></tr>';
                html += '<tr><td class="fw-bold">Ya generadas</td><td>' + (r.alreadyGeneratedCount || 0) + '</td></tr>';
                html += '<tr><td class="fw-bold">Sin informe aprobado</td><td>' + (r.missingApprovedReportCount || 0) + '</td></tr>';
                html += '<tr><td class="fw-bold">Errores</td><td><span class="badge ' + ((r.errorCount || 0) > 0 ? 'bg-danger' : 'bg-secondary') + '">' + (r.errorCount || 0) + '</span></td></tr>';
                html += '</table>';

                if (r.syncedIds && r.syncedIds.length > 0) {
                    html += '<div class="mt-3"><strong>Solicitudes sincronizadas:</strong> ' + r.syncedIds.join(', ') + '</div>';
                }

                if (r.errors && r.errors.length > 0) {
                    html += '<div class="mt-3"><strong>Errores reportados:</strong><ul class="mb-0">';
                    r.errors.forEach(function (error) {
                        html += '<li>' + error + '</li>';
                    });
                    html += '</ul></div>';
                }

                details.innerHTML = html;
                btn.disabled = false;
                previewBtn.disabled = false;
            },
            error: function () {
                details.innerHTML = '<div class="alert alert-danger mb-0">No se pudo ejecutar la resincronización AOCR legacy.</div>';
                btn.disabled = false;
                previewBtn.disabled = false;
            }
        });
    }

    function previewLegacyAocrCandidates() {
        var btn = document.getElementById('btnPreviewLegacyAocr');
        var resyncBtn = document.getElementById('btnResyncLegacyAocr');
        var details = document.getElementById('legacyAocrDetails');
        btn.disabled = true;
        resyncBtn.disabled = true;
        details.innerHTML = '<div class="text-center py-3"><div class="spinner-border text-primary" role="status"></div><p class="mt-2 text-muted">Consultando candidatas legacy AOCR...</p></div>';

        $.ajax({
            url: '@Url.Action("PreviewLegacyAocrCandidates", "Health")',
            type: 'POST',
            data: { limit: 200, __RequestVerificationToken: tokenVal },
            success: function (r) {
                var html = '<div class="alert ' + (r.success ? 'alert-info' : 'alert-danger') + ' mb-3">' + (r.message || 'Sin respuesta del servidor.') + '</div>';
                html += '<table class="table table-sm table-bordered mb-0">';
                html += '<tr><td class="fw-bold" width="40%">Límite aplicado</td><td>' + (r.limit || 0) + '</td></tr>';
                html += '<tr><td class="fw-bold">Legacy en pre-AOCR</td><td>' + (r.legacyPendingCount || 0) + '</td></tr>';
                html += '<tr><td class="fw-bold">Listas para resincronizar</td><td><span class="badge bg-info">' + (r.readyCount || 0) + '</span></td></tr>';
                html += '<tr><td class="fw-bold">Ya generadas</td><td>' + (r.alreadyGeneratedCount || 0) + '</td></tr>';
                html += '<tr><td class="fw-bold">Sin informe aprobado</td><td>' + (r.missingApprovedReportCount || 0) + '</td></tr>';
                html += '</table>';

                if (r.candidates && r.candidates.length > 0) {
                    html += '<div class="table-responsive mt-3">';
                    html += '<table class="table table-sm table-striped table-bordered mb-0">';
                    html += '<thead><tr><th>Solicitud</th><th>Número</th><th>Estado solicitud</th><th>Inspección</th><th>Informe</th><th>Estado informe</th></tr></thead><tbody>';
                    r.candidates.forEach(function (candidate) {
                        html += '<tr>';
                        html += '<td>' + candidate.solicitudId + '</td>';
                        html += '<td>' + (candidate.numeroSolicitud || '-') + '</td>';
                        html += '<td>' + (candidate.estadoSolicitud || '-') + '</td>';
                        html += '<td>' + (candidate.inspeccionId || '-') + '</td>';
                        html += '<td>' + (candidate.informeId || '-') + '</td>';
                        html += '<td>' + (candidate.estadoInforme || '-') + '</td>';
                        html += '</tr>';
                    });
                    html += '</tbody></table></div>';
                }

                details.innerHTML = html;
                btn.disabled = false;
                resyncBtn.disabled = false;
            },
            error: function () {
                details.innerHTML = '<div class="alert alert-danger mb-0">No se pudo consultar el inventario AOCR legacy.</div>';
                btn.disabled = false;
                resyncBtn.disabled = false;
            }
        });
    }

    function refreshGeneral() {
        document.getElementById('generalDetails').innerHTML = '<div class="text-center py-3"><div class="spinner-border text-primary" role="status"></div></div>';
        $.getJSON('@Url.Action("Details", "Health")', function (data) {
            var overall = data.status === 'healthy';
            setCardStatus('cardApp', 'appStatus', overall ? 'Saludable' : 'Problemas detectados', overall ? 'green' : 'red');

            // PG status
            if (data.checks && data.checks.postgresql) {
                setCardStatus('cardPg', 'pgStatus', data.checks.postgresql.healthy ? 'Saludable' : 'Error', data.checks.postgresql.healthy ? 'green' : 'red');
            }

            var html = '<table class="table table-sm table-bordered mb-0"><thead><tr><th>Componente</th><th>Estado</th><th>Detalle</th></tr></thead><tbody>';
            if (data.checks) {
                for (var key in data.checks) {
                    var check = data.checks[key];
                    var badge = check.healthy ? '<span class="badge bg-success">OK</span>' : '<span class="badge bg-danger">Error</span>';
                    html += '<tr><td class="fw-bold">' + key + '</td><td>' + badge + '</td><td>' + (check.message || '-') + '</td></tr>';
                }
            }
            html += '</tbody></table>';
            html += '<div class="text-muted small mt-2">Versión: ' + (data.version || 'N/A') + ' | Uptime: ' + (data.uptime || 'N/A') + '</div>';
            document.getElementById('generalDetails').innerHTML = html;
        }).fail(function () {
            setCardStatus('cardApp', 'appStatus', 'Error', 'red');
            setCardStatus('cardPg', 'pgStatus', 'Error', 'red');
            document.getElementById('generalDetails').innerHTML = '<div class="alert alert-danger mb-0">No se pudo obtener el estado general</div>';
        });
    }

    function refreshAll() {
        refreshGeneral();
        refreshAs400();
        refreshCircuitBreakers();
        refreshSyncStats();
        document.getElementById('lastUpdate').textContent = new Date().toLocaleString('es-EC');
    }

    // Auto-refresh on load
    $(document).ready(function () {
        refreshAll();
        // Auto-refresh every 45 minutes
        setInterval(refreshAll, 45 * 60 * 1000);
    });
</script>
}
