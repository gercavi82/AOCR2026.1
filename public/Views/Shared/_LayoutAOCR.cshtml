    <!-- 1.1b DataTables: defaults institucionales AOCR (aplicados a todas las tablas del proyecto) -->
    <!--     Paginacion global fija: 5 registros por pagina. -->
    <script>
    $(function () {
        if (!$.fn || !$.fn.dataTable) return;
        $.extend(true, $.fn.dataTable.defaults, {
            language: {
                processing:     'Procesando...',
                search:         'Buscar:',
                lengthMenu:     'Mostrar _MENU_ registros',
                info:           'Mostrando _START_ a _END_ de _TOTAL_ registros',
                infoEmpty:      'Mostrando 0 a 0 de 0 registros',
                infoFiltered:   '(filtrado de _MAX_ registros en total)',
                infoPostFix:    '',
                loadingRecords: 'Cargando...',
                zeroRecords:    'No se encontraron resultados',
                emptyTable:     'No hay datos disponibles en esta tabla',
                paginate: {
                    first:    'Primero',
                    previous: 'Anterior',
                    next:     'Siguiente',
                    last:     'Ultimo'
                },
                aria: {
                    sortAscending:  ': activar para ordenar ascendentemente',
                    sortDescending: ': activar para ordenar descendentemente'
                }
            },
            pageLength:  5,
            lengthChange: false,
            responsive:  true,
            autoWidth:   false,
            processing:  true,
            pagingType:  'simple_numbers',
            // Estandar institucional: buscador a la derecha, info y paginacion abajo (sin selector de longitud)
            dom: '<"row align-items-center mb-2"<"col-sm-12 text-end"f>>' +
                 '<"row"<"col-12"tr>>' +
                 '<"row align-items-center mt-2"<"col-sm-5"i><"col-sm-7 d-flex justify-content-end"p>>',
            initComplete: function () {
                var $wrap = $(this).closest('.dataTables_wrapper');
                $wrap.addClass('aocr-datatable-wrap');
                $wrap.find('.dataTables_filter input')
                    .addClass('form-control form-control-sm')
                    .attr('placeholder', 'Buscar...');
            }
        });

        // Institucional enforcement: cualquier vista que llame
        //   $('#id').DataTable({ pageLength: 10, language: { url: ... } })
        // queda normalizada (override fuerte) para mantener el estandar global.
        try {
            var _DT = $.fn.DataTable;
            var _dt = $.fn.dataTable;
            function _aocrNormalize(opts) {
                if (!opts || typeof opts !== 'object') return opts;
                // Forzar 5 registros (global)
                opts.pageLength = 5;
                opts.lengthChange = false;
                // Si la vista especifica una URL remota de idioma, descartarla para usar
                // los strings en espanol inline de los defaults institucionales.
                if (opts.language && typeof opts.language === 'object' && opts.language.url) {
                    delete opts.language.url;
                }
                // Asegurar paginacion estandar si la vista fijo otro pagingType
                if (!opts.pagingType) { opts.pagingType = 'simple_numbers'; }
                // Responsive por defecto salvo opt-out explicito
                if (opts.responsive === undefined) { opts.responsive = true; }
                return opts;
            }
            $.fn.DataTable = function (opts) {
                _aocrNormalize(opts);
                return _DT.apply(this, arguments);
            };
            $.each(_DT, function (k, v) { $.fn.DataTable[k] = v; });
            $.fn.dataTable = function (opts) {
                _aocrNormalize(opts);
                return _dt.apply(this, arguments);
            };
            $.each(_dt, function (k, v) { $.fn.dataTable[k] = v; });
        } catch (e) {
            if (window.console) console.warn('[AOCR] No se pudo instalar el override institucional de DataTables:', e);
        }
    });
    </script>

    <!-- 1.2 jQuery Validate (necesario para validación cliente en vistas MVC) -->
    <script src="@jqueryValidateUrl"></script>
    <script src="@jqueryValidateUnobtrusiveUrl"></script>
    <script>
        (function () {
            function loadScript(src) {
                var s = document.createElement('script');
                s.src = src;
                s.async = false;
                document.head.appendChild(s);
            }

            function ensureValidationPlugins(retries) {
                if (!window.jQuery) {
                    if ((retries || 0) < 40) {
                        setTimeout(function () {
                            ensureValidationPlugins((retries || 0) + 1);
                        }, 50);
                    }
                    return;
                }

                if (!window.jQuery.fn || typeof window.jQuery.fn.validate !== 'function') {
                    loadScript('https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js');
                }

                if (!window.jQuery.validator || !window.jQuery.validator.unobtrusive) {
                    loadScript('https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js');
                }
            }

            ensureValidationPlugins(0);
        })();
    </script>

    <!-- 2. Bootstrap 5 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-w76AqPfDkMBDXo30jS1Sgez6pr3x5MlQ1ZAGC+nuZB+EYdgRZgiwxhTBTkF7CXvN"
            crossorigin="anonymous"></script>
    <script src="@aocrUtilsUrl"></script>

    <!-- 3. Loader optimizado que espera jQuery -->
    <script>
    // ✅ CARGA SEGURA DE DEPENDENCIAS
    (function initScriptLoader() {
        // Estado de carga
        var loadedScripts = {
            jquery: false,
            bootstrap: false,
            datatables: false,
            sweetalert: false,
            adminlte: false
        };

        // Verificar si jQuery ya está listo
        function checkJQuery() {
            if (window.jQuery && typeof jQuery !== 'undefined') {
                loadedScripts.jquery = true;
                // Asegurar que $ esté disponible globalmente
                if (typeof window.$ === 'undefined') {
                    window.$ = jQuery;
                }
                checkBootstrap();
            } else {
                setTimeout(checkJQuery, 50);
            }
        }

        // Verificar si Bootstrap está listo
        function checkBootstrap() {
            if (window.bootstrap && typeof bootstrap !== 'undefined') {
                loadedScripts.bootstrap = true;
                loadDataTables();
            } else {
                setTimeout(checkBootstrap, 50);
            }
        }

        // Iniciar chequeo
        checkJQuery();

        function loadDataTables() {
            // DataTables ya se carga estáticamente en <head> — solo notificar que está listo
            if (window.jQuery && $.fn.dataTable) {
                loadedScripts.datatables = true;
                document.dispatchEvent(new Event('AOCR.DataTablesReady'));
                if (window.AOCR) { window.AOCR.dataTablesLoaded = true; }
                loadSweetAlert();
            } else {
                // Fallback: cargar dinámicamente si por alguna razón no está
                var dtScripts = [
                    'https://cdn.datatables.net/1.13.4/js/jquery.dataTables.min.js',
                    'https://cdn.datatables.net/1.13.4/js/dataTables.bootstrap5.min.js',
                    'https://cdn.datatables.net/responsive/2.4.1/js/dataTables.responsive.min.js',
                    'https://cdn.datatables.net/responsive/2.4.1/js/responsive.bootstrap5.min.js'
                ];
                function loadNextScript(index) {
                    if (index >= dtScripts.length) {
                        loadedScripts.datatables = true;
                        document.dispatchEvent(new Event('AOCR.DataTablesReady'));
                        if (window.AOCR) { window.AOCR.dataTablesLoaded = true; }
                        loadSweetAlert();
                        return;
                    }
                    var script = document.createElement('script');
                    script.src = dtScripts[index];
                    script.async = false;
                    script.onload = function () { loadNextScript(index + 1); };
                    script.onerror = function () { loadNextScript(index + 1); };
                    document.body.appendChild(script);
                }
                loadNextScript(0);
            }
        }

        function loadSweetAlert() {
            var script = document.createElement('script');
            script.src = 'https://cdn.jsdelivr.net/npm/sweetalert2@11';
            script.async = false;

            script.onload = function () {
                loadedScripts.sweetalert = true;
                loadAdminLTE();
            };

            script.onerror = function () {
                console.warn('⚠️ SweetAlert no se pudo cargar');
                loadedScripts.sweetalert = false;
                loadAdminLTE();
            };

            document.body.appendChild(script);
        }

        function loadAdminLTE() {
            var script = document.createElement('script');
            script.src = '@adminLteLocalUrl';
            script.async = false;

            script.onload = function () {
                loadedScripts.adminlte = true;
                loadLocalScripts();
            };

            script.onerror = function () {
                console.warn('⚠️ AdminLTE no se pudo cargar');
                loadedScripts.adminlte = false;
                loadLocalScripts();
            };

            document.body.appendChild(script);
        }

        function loadLocalScripts() {
            // Cargar site.js
            var siteScript = document.createElement('script');
            siteScript.src = '@siteJsUrl';
            siteScript.async = false;
            siteScript.onload = function() {
                loadAppJS();
            };
            siteScript.onerror = function() {
                console.warn('⚠️ site.js no se pudo cargar');
                loadAppJS();
            };
            document.body.appendChild(siteScript);
        }

        function loadAppJS() {
            // Cargar app.js
            var appScript = document.createElement('script');
            appScript.src = '@appJsUrl';
            appScript.async = false;
            appScript.onload = function() {
                loadSidebarJS();
            };
            appScript.onerror = function() {
                console.warn('⚠️ app.js no se pudo cargar');
                loadSidebarJS();
            };
            document.body.appendChild(appScript);
        }

        function loadSidebarJS() {
            var sidebarScript = document.createElement('script');
            sidebarScript.src = '@sidebarJsUrl';
            sidebarScript.async = false;
            sidebarScript.onload = function() {
                initializeAOCRSystem();
            };
            sidebarScript.onerror = function() {
                console.warn('⚠️ aocr-sidebar.js no se pudo cargar');
                initializeAOCRSystem();
            };
            document.body.appendChild(sidebarScript);
        }

        function initializeAOCRSystem() {
            // Verificar dependencias mínimas
            if (!loadedScripts.jquery) {
                console.error('❌ jQuery no cargado - abortando inicialización');
                return;
            }

            $(document).ready(function () {
                // Configuración global
                window.AOCR_CONFIG = {
                    apiBaseUrl: '@Url.Content("~/")',
                    loginUrl: '@Url.Action("Login", "Account")',
                    debug: @(HttpContext.Current.IsDebuggingEnabled ? "true" : "false"),
                    uploadMaxSize: 10 * 1024 * 1024,
                    sessionTimeout: @(CapaPresentacion.Helpers.SessionTimeoutHelper.GetTimeoutMinutes()) * 60 * 1000,
                    user: {
                        id: '@(Session["UserId"] ?? "")',
                        name: '@(Session["NombreUsuario"] ?? "")',
                        role: '@(RoleGroupingHelper.NormalizeSelectedRole(Session["Rol"] as string ?? string.Empty))'
                    }
                };

                if (window.AOCR && typeof window.AOCR.installGlobalHttpHandlers === 'function') {
                    window.AOCR.installGlobalHttpHandlers();
                }

                // Ocultar loader global
                $('#global-loader').fadeOut(300, function () {
                    $(this).remove();
                });

                // Inicializar componentes globales
                initGlobalComponents();
                initSessionManagement();
                setupAjaxDefaults();

                // Integración con site.js y app.js
                integrateWithSiteJS();
            });
        }

        function initGlobalComponents() {
            // Tooltips de Bootstrap 5
            if (window.bootstrap && bootstrap.Tooltip) {
                try {
                    var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
                    tooltipTriggerList.forEach(function (el) {
                        try {
                            // Solo crear si no existe
                            if (!el._tooltip) {
                                new bootstrap.Tooltip(el);
                            }
                        } catch (e) {
                            console.warn('Tooltip error:', e);
                        }
                    });
                } catch (e) {
                    console.error('Error inicializando tooltips:', e);
                }
            }

            // Alertas auto-ocultantes
            $('.alert-auto-hide').delay(5000).fadeOut(400);
        }

        function initSessionManagement() {
            // Tu código existente de gestión de sesión
            var sessionTimer, warningTimer, countdownTimer;
            var WARNING_TIME = @(CapaPresentacion.Helpers.SessionTimeoutHelper.GetWarningMinutes()) * 60 * 1000;
            var TOTAL_TIMEOUT = @(CapaPresentacion.Helpers.SessionTimeoutHelper.GetTimeoutMinutes()) * 60 * 1000;

            function resetSessionTimers() {
                clearTimeout(sessionTimer);
                clearTimeout(warningTimer);

                warningTimer = setTimeout(showSessionWarning, TOTAL_TIMEOUT - WARNING_TIME);
                sessionTimer = setTimeout(function () {
                    window.location.href = '@Url.Action("Logout", "Account")?timeout=true';
                }, TOTAL_TIMEOUT);
            }

            function showSessionWarning() {
                if (!window.bootstrap || !bootstrap.Modal) {
                    console.warn('Bootstrap Modal no disponible para advertencia de sesión');
                    return;
                }

                try {
                    var modalElement = document.getElementById('session-timeout-warning');
                    if (!modalElement) return;

                    var modal = new bootstrap.Modal(modalElement);
                    var timeLeft = @(CapaPresentacion.Helpers.SessionTimeoutHelper.GetWarningMinutes()) * 60;
                    var countdownEl = document.getElementById('session-countdown');

                    function updateCountdown() {
                        var minutes = Math.floor(timeLeft / 60);
                        var seconds = timeLeft % 60;
                        if (countdownEl) {
                            countdownEl.textContent = minutes + ':' + (seconds < 10 ? '0' : '') + seconds;
                        }
                        timeLeft--;

                        if (timeLeft >= 0) {
                            countdownTimer = setTimeout(updateCountdown, 1000);
                        } else {
                            modal.hide();
                            window.location.href = '@Url.Action("Logout", "Account")?timeout=true';
                        }
                    }

                    if (window.getSelection) {
                        var selection = window.getSelection();
                        if (selection && selection.removeAllRanges) {
                            selection.removeAllRanges();
                        }
                    }

                    modal.show();
                    updateCountdown();

                    $('#btn-extend-session').off('click').on('click', function () {
                        if (countdownTimer) {
                            clearTimeout(countdownTimer);
                            countdownTimer = null;
                        }
                        var token = $('#__AjaxAntiForgeryForm input[name="__RequestVerificationToken"]').val();
                        $.post('@Url.Action("ExtenderSesion", "Account")', {
                                __RequestVerificationToken: token
                            })
                            .done(function () {
                                modal.hide();
                                resetSessionTimers();
                                // Usar Site.notify si existe, o AOCR.showAlert
                                if (window.Site && Site.notify) {
                                    Site.notify('Sesión extendida exitosamente', 'success');
                                } else if (window.AOCR) {
                                    AOCR.showAlert('Éxito', 'Sesión extendida', 'success');
                                }
                            })
                            .fail(function () {
                                window.location.href = '@Url.Action("Logout", "Account")';
                            });
                    });

                    $('#btn-logout-now').off('click').on('click', function () {
                        if (countdownTimer) {
                            clearTimeout(countdownTimer);
                            countdownTimer = null;
                        }
                        window.location.href = '@Url.Action("Logout", "Account")';
                    });

                } catch (error) {
                    console.error('Error en advertencia de sesión:', error);
                }
            }

            resetSessionTimers();
            $(document).on('click keypress mousemove', resetSessionTimers);
        }

        function setupAjaxDefaults() {
            $.ajaxSetup({
                beforeSend: function (xhr) {
                    var token = $('#__AjaxAntiForgeryForm input[name="__RequestVerificationToken"]').val();
                    if (token) {
                        xhr.setRequestHeader('RequestVerificationToken', token);
                    }
                    $('body').addClass('waiting');
                },
                complete: function () {
                    $('body').removeClass('waiting');
                },
                error: function (xhr) {
                    var message = 'Error en la comunicación con el servidor';

                    if (xhr.status === 401) {
                        window.location.href = window.AOCR && typeof window.AOCR.buildLoginUrl === 'function'
                            ? window.AOCR.buildLoginUrl()
                            : '@Url.Action("Login", "Account")';
                        return;
                    }
                    if (xhr.status === 403) message = 'Acceso no autorizado';
                    if (xhr.status === 404) message = 'Recurso no encontrado';
                    if (xhr.status === 500) message = 'Error interno del servidor';

                    // Usar Site.notify si existe, o alert
                    if (window.Site && Site.notify) {
                        Site.notify(message, 'error');
                    } else {
                        alert('Error: ' + message);
                    }
                }
            });
        }

        function integrateWithSiteJS() {
            // Combinar funcionalidades de Site y AOCR
            if (!window.AOCR) window.AOCR = {};

            // Si Site.notify existe, usarlo para AOCR.showAlert
            if (window.Site && Site.notify) {
                window.AOCR.showAlert = function(title, message, type) {
                    Site.notify(title + ': ' + message, type);
                };
            } else {
                window.AOCR.showAlert = function(title, message, type) {
                    if (window.Swal) {
                        Swal.fire({ icon: type || 'info', title: title, text: message });
                    } else {
                        alert(title + ': ' + message);
                    }
                };
            }

            // Funciones de utilidad
            window.AOCR.formatCurrency = function (amount) {
                return '$ ' + parseFloat(amount).toFixed(2).replace(/\d(?=(\d{3})+\.)/g, '$&,');
            };

            window.AOCR.formatDate = function (dateStr) {
                if (!dateStr) return '';
                var date = new Date(dateStr);
                return date.toLocaleDateString('es-EC');
            };
        }
    })();
    </script>

    <!-- ✅ ÚNICA LLAMADA A RenderSection("Scripts") -->
    <script src="@responsiveJsUrl"></script>
    @RenderSection("Scripts", required: false)
