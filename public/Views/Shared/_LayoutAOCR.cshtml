@inherits System.Web.Mvc.WebViewPage
@using CapaModelo
@using CapaPresentacion.Helpers
@using System.Web.Mvc.Html
@using System.Web.Optimization
<!DOCTYPE html>
<html lang="es" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content="Sistema AOCR - Dirección General de Aviación Civil Ecuador" />
    <meta name="author" content="DGAC Ecuador" />
    <meta name="keywords" content="DGAC, Aviación Civil, Ecuador, AOCR, Órdenes de Recaudación" />

    <!-- CSP simplificado (compatible con DataTables y plugins) -->
    <meta http-equiv="Content-Security-Policy"
          content="default-src 'self' https:;
                   script-src 'self' 'unsafe-inline' 'unsafe-eval'
                             https://cdn.jsdelivr.net https://code.jquery.com https://cdnjs.cloudflare.com https://cdn.datatables.net;
                   style-src  'self' 'unsafe-inline'
                             https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://cdn.datatables.net;
                   img-src    'self' data: https:;
                   font-src   'self' data: https://cdnjs.cloudflare.com https://cdn.jsdelivr.net;
                   worker-src 'self' blob:;
                   connect-src 'self' https:;" />

    <!-- Preconexiones para mejorar performance -->
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
    <link rel="dns-prefetch" href="https://cdn.jsdelivr.net">

    @{
        var pageTitle = ViewBag.Title != null
            ? System.Web.HttpUtility.HtmlDecode(System.Web.HttpUtility.HtmlDecode(Convert.ToString(ViewBag.Title)))
            : "";
        var frontVersion = AssetVersionHelper.GetFrontVersion();
        var faviconVersion = "1";
        var siteCssHref = AssetVersionHelper.VersionedContent(Url, "~/Content/Site.css");
        var aocrCssInstHref = AssetVersionHelper.VersionedContent(Url, "~/Content/aocr-institucional.css");
        var aocrCssDtHref = AssetVersionHelper.VersionedContent(Url, "~/Content/aocr-datatables.css");
        var aocrCssResponsiveHref = AssetVersionHelper.VersionedContent(Url, "~/Content/aocr-responsive.css");
        var aocrCssDocumentCardsHref = AssetVersionHelper.VersionedContent(Url, "~/Content/aocr-document-cards.css");
        var aocrModalsCssHref = string.Empty;
        try
        {
            var aocrModalsCssPath = Server.MapPath("~/Content/aocr-modals.css");
            if (!string.IsNullOrWhiteSpace(aocrModalsCssPath) && System.IO.File.Exists(aocrModalsCssPath))
            {
                aocrModalsCssHref = Url.Content("~/Content/aocr-modals.css") + "?v=" + frontVersion;
            }
        }
        catch
        {
        }
        var aocrSidebarCssHref = AssetVersionHelper.VersionedContent(Url, "~/Content/aocr-sidebar.css");
        var aocrContrastCssHref = AssetVersionHelper.VersionedContent(Url, "~/Content/aocr-contrast.css");
        var aocrContrastFixCssHref = AssetVersionHelper.VersionedContent(Url, "~/Content/css/aocr-contrast-fix.css");
        var aocrHeadersCssHref = AssetVersionHelper.VersionedContent(Url, "~/Content/aocr-headers.css");
        var aocrPdfViewerCssHref = AssetVersionHelper.VersionedContent(Url, "~/Content/aocr-pdf-viewer/aocr-pdf-viewer.css");
        var jqueryLocalUrl = AssetVersionHelper.VersionedContent(Url, "~/Scripts/jquery-3.6.4.min.js");
        var dataTablesInitUrl = AssetVersionHelper.VersionedContent(Url, "~/Scripts/aocr-datatables.js");
        var jqueryValidateUrl = AssetVersionHelper.VersionedContent(Url, "~/Scripts/jquery.validate.min.js");
        var jqueryValidateUnobtrusiveUrl = AssetVersionHelper.VersionedContent(Url, "~/Scripts/jquery.validate.unobtrusive.min.js");
        var aocrUtilsUrl = AssetVersionHelper.VersionedContent(Url, "~/Scripts/aocr-utils.js");
        var adminLteLocalUrl = AssetVersionHelper.VersionedContent(Url, "~/Content/dist/js/adminlte.js");
        var siteJsUrl = AssetVersionHelper.VersionedContent(Url, "~/Scripts/site.js");
        var appJsUrl = AssetVersionHelper.VersionedContent(Url, "~/Scripts/app.js");
        var sidebarJsUrl = AssetVersionHelper.VersionedContent(Url, "~/Scripts/aocr-sidebar.js");
        var responsiveJsUrl = AssetVersionHelper.VersionedContent(Url, "~/Scripts/aocr-responsive.js");
        var pdfViewerJsUrl = AssetVersionHelper.VersionedContent(Url, "~/Content/aocr-pdf-viewer/aocr-pdf-viewer.js");
        var pdfLibUrl = AssetVersionHelper.VersionedContent(Url, "~/Content/aocr-pdf-viewer/pdf.min.js");
        var pdfWorkerUrl = AssetVersionHelper.VersionedContent(Url, "~/Content/aocr-pdf-viewer/pdf.worker.min.js");
        try
        {
            var faviconPath = Server.MapPath("~/Content/imganes/logo1.png");
            if (System.IO.File.Exists(faviconPath))
            {
                faviconVersion = System.IO.File.GetLastWriteTimeUtc(faviconPath).Ticks.ToString();
            }
        }
        catch
        {
        }
    }

    <title>@pageTitle - DGAC Sistema AOCR</title>

    <!-- FontAwesome desde CDN compatible con CSP -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Favicon con múltiples formatos y fallbacks -->
    <link rel="shortcut icon" href="@Url.Content("~/Content/imganes/logo1.png?v=" + faviconVersion)" type="image/png" />
    <link rel="icon" href="@Url.Content("~/Content/imganes/logo1.png?v=" + faviconVersion)" type="image/png" />
    <link rel="apple-touch-icon" href="@Url.Content("~/Content/imganes/logo1.png?v=" + faviconVersion)" />

    <!-- AdminLTE CSS (siempre desde CDN — el archivo local no existe) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/admin-lte@3.2/dist/css/adminlte.min.css">

    <!-- DataTables CSS -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.4/css/dataTables.bootstrap5.min.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/responsive/2.4.1/css/responsive.bootstrap5.min.css">

    <!-- CSS Personalizado -->
    <meta name="aocr-front-version" content="@frontVersion" />
    <link href="@siteCssHref" rel="stylesheet" />
    <link href="@aocrCssInstHref" rel="stylesheet" />
    <link href="@aocrCssDtHref" rel="stylesheet" />
    <link href="@aocrCssResponsiveHref" rel="stylesheet" />
    <link href="@aocrCssDocumentCardsHref" rel="stylesheet" />
    @if (!string.IsNullOrWhiteSpace(aocrModalsCssHref))
    {
        <link href="@aocrModalsCssHref" rel="stylesheet" type="text/css" />
    }
    <link href="@aocrSidebarCssHref" rel="stylesheet" />
    <link href="@aocrContrastFixCssHref" rel="stylesheet" />
    <link href="@aocrHeadersCssHref" rel="stylesheet" />
    <link href="@aocrPdfViewerCssHref" rel="stylesheet" />

    <!-- Estilos personalizados criticos (inline para performance) -->
    <style>
        :root {
            --dgac-primary: #1B4F72;
            --dgac-secondary: #0C7C86;
            --dgac-success: #28a745;
            --dgac-warning: #ffc107;
            --dgac-danger: #dc3545;
            --dgac-light: #f8f9fa;
            --dgac-dark: #343a40;
            --transition-fast: 0.2s ease;
        }

        /* Loader global critico */
        #global-loader {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: white;
            z-index: 9999;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-direction: column;
        }

        .loader-spinner {
            width: 50px;
            height: 50px;
            border: 5px solid #f3f3f3;
            border-top: 5px solid var(--dgac-primary);
            border-radius: 50%;
            animation: spin 1s linear infinite;
        }

        @@keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        /* Fallback para imagenes */
        .img-fallback {
            background: linear-gradient(135deg, var(--dgac-primary), var(--dgac-secondary));
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            text-transform: uppercase;
        }

        /* Estado de carga */
        body.waiting { cursor: wait !important; }
        body.waiting::after {
            content: '';
            position: fixed;
            top: 0; left: 0;
            width: 100%; height: 100%;
            background: rgba(255, 255, 255, 0.7);
            z-index: 9998;
        }

        /* Accesibilidad */
        @@media (prefers-reduced-motion: reduce) {
            * {
                animation-duration: 0.01ms !important;
                animation-iteration-count: 1 !important;
                transition-duration: 0.01ms !important;
            }
        }

        .sr-only {
            position: absolute;
            width: 1px; height: 1px;
            padding: 0; margin: -1px;
            overflow: hidden;
            clip: rect(0, 0, 0, 0);
            white-space: nowrap; border: 0;
        }
    </style>

    @RenderSection("Styles", required: false)
    <link href="@aocrContrastCssHref" rel="stylesheet" />
    <style>
        /* Modales AOCR — inline obligatorio (evita error MIME/404 si el CSS externo no está publicado en IIS) */
        :root {
            --aocr-modal-z-backdrop: 10490;
            --aocr-modal-z-modal: 10500;
            --aocr-modal-sidebar-offset: var(--aocr-sidebar-width, 260px);
            --aocr-modal-sidebar-mini-offset: 4.6rem;
        }

        body.aocr-body .main-sidebar.aocr-sidebar,
        body.aocr-body .main-sidebar,
        body.aocr-body .sidebar {
            z-index: 1050 !important;
        }

        body.aocr-body .aocr-sidebar-backdrop {
            z-index: 1040 !important;
        }

        body.aocr-body .main-header.navbar,
        body.aocr-body .aocr-topbar {
            z-index: 1010 !important;
        }

        body.aocr-body .modal-backdrop,
        body.aocr-body .modal-backdrop.show {
            z-index: var(--aocr-modal-z-backdrop) !important;
        }

        body.aocr-body .modal,
        body.aocr-body .modal.show {
            z-index: var(--aocr-modal-z-modal) !important;
        }

        @@media (min-width: 992px) {
            body.aocr-body .modal {
                padding-left: var(--aocr-modal-sidebar-offset);
            }

            body.aocr-body.sidebar-mini.sidebar-collapse .modal,
            body.aocr-body.sidebar-collapse .modal {
                padding-left: var(--aocr-modal-sidebar-mini-offset);
            }
        }

        body.aocr-body .modal-dialog {
            margin: 1.75rem auto !important;
            max-width: 980px;
            width: calc(100% - 2rem);
        }

        body.aocr-body .modal-dialog-centered {
            min-height: calc(100% - 3.5rem);
        }

        body.aocr-body .modal-content {
            border: 0;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 18px 45px rgba(0, 0, 0, 0.25);
        }

        body.aocr-body .modal-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 18px 22px;
        }

        body.aocr-body .modal-header .modal-title {
            margin: 0;
            font-size: 20px;
            font-weight: 800;
        }

        body.aocr-body .modal-body {
            padding: 22px;
        }

        body.aocr-body .modal-footer {
            padding: 16px 22px;
            display: flex;
            justify-content: flex-end;
            gap: 10px;
            flex-wrap: wrap;
        }

        body.aocr-body .modal textarea.form-control {
            width: 100%;
            min-height: 110px;
            resize: vertical;
        }

        body.aocr-body .aocr-modal-anulacion .alert-warning {
            margin-bottom: 0;
        }

        @@media (max-width: 991.98px) {
            body.aocr-body .modal {
                padding-left: 0 !important;
            }
        }

        @@media (max-width: 768px) {
            body.aocr-body .modal-dialog {
                width: calc(100% - 1rem);
                margin: 0.75rem auto !important;
            }

            body.aocr-body .modal-footer {
                flex-direction: column-reverse;
            }

            body.aocr-body .modal-footer .btn {
                width: 100%;
            }
        }
    </style>
</head>

<body class="hold-transition sidebar-mini layout-fixed layout-navbar-fixed aocr-body">

    <!-- ✅ CORRECCIÓN: AntiForgeryToken para AJAX (FORMA CORRECTA) -->
    <!-- (no lo pongas dentro de value="", porque Html.AntiForgeryToken() devuelve un input completo) -->
    <form id="__AjaxAntiForgeryForm" style="display:none;">
        @System.Web.Helpers.AntiForgery.GetHtml()
    </form>

    <!-- Global Loader -->
    <div id="global-loader">
        <div class="loader-spinner"></div>
        <div class="mt-3 text-muted">Cargando sistema AOCR...</div>
    </div>

    <!-- Session timeout warning -->
    <div id="session-timeout-warning" class="modal fade aocr-session-timeout-modal" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-warning">
                    <h5 class="modal-title"><i class="fas fa-clock me-2"></i>Sesión por expirar</h5>
                </div>
                <div class="modal-body text-center">
                    <p>Su sesión expirará en <span id="session-countdown" class="fw-bold">5:00</span> minutos.</p>
                    <p>¿Desea extender la sesión?</p>
                </div>
                <div class="modal-footer justify-content-center">
                    <button type="button" class="btn btn-outline-secondary me-2" id="btn-logout-now">
                        <i class="fas fa-sign-out-alt me-1"></i> Cerrar Sesión
                    </button>
                    <button type="button" class="btn btn-primary" id="btn-extend-session">
                        <i class="fas fa-sync-alt me-1"></i> Extender Sesión
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="wrapper aocr-app-shell">
        <div id="aocrSidebarBackdrop" class="aocr-sidebar-backdrop" aria-hidden="true"></div>
        <!-- Navbar Principal -->
        <nav class="main-header navbar navbar-expand navbar-white navbar-light border-bottom aocr-topbar shadow-sm">
            <!-- Botón sidebar -->
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link" data-widget="pushmenu" href="#" role="button"
                       aria-label="Alternar menú lateral">
                        <i class="fas fa-bars"></i>
                    </a>
                </li>
                <li class="nav-item d-none d-sm-inline-block">
                    <span class="nav-link text-dark fw-bold aocr-topbar-brand">
                        <span class="aocr-topbar-brand__icon">
                            <i class="fas fa-plane"></i>
                        </span>
                        <span class="aocr-topbar-brand__copy">
                            <span class="aocr-topbar-brand__title" id="org-name">Dirección General de Aviación Civil - Ecuador</span>
                            <small class="aocr-topbar-brand__subtitle">AOCR · Plataforma institucional</small>
                        </span>
                    </span>
                </li>
            </ul>

            <!-- Controles derecho -->
            <ul class="navbar-nav ms-auto">
                <!-- Notificaciones -->
                @Html.Partial("_NotificacionesBadge")

                <!-- Menú Usuario -->
                <li class="nav-item dropdown user-menu">
                    <a href="#" class="nav-link dropdown-toggle" data-bs-toggle="dropdown"
                       aria-haspopup="true" aria-expanded="false">
                        @{
                            var avatarUrl = Url.Content("~/Content/imganes/user.png");
                            var nombreUsuarioSidebar = (Session["NombreUsuario"] as string ?? string.Empty).Trim();
                            var avatarAlt = !string.IsNullOrWhiteSpace(nombreUsuarioSidebar) ? nombreUsuarioSidebar : "Usuario";
                            var defaultAvatar = Url.Content("~/Content/imganes/user.png");
                            var rolSidebar = RoleGroupingHelper.NormalizeSelectedRole(Session["Rol"] as string ?? string.Empty);
                            var rolesSidebarRaw = RoleGroupingHelper.ExtractRoles(Session["RolesRaw"] ?? Session["Roles"], Session["Rol"] as string);
                            var rolUsuarioSidebar = RoleGroupingHelper.ToDisplayName(rolSidebar);
                            var empresaNombreSidebar = (Session["EmpresaNombre"] as string ?? string.Empty).Trim();
                            var empresaCodigoSidebar = (Session["EmpresaCodigo"] as string ?? string.Empty).Trim();
                            var mostrarEmpresaEnSidebar = RoleGroupingHelper.IsSolicitante(rolSidebar);
                            var esSidebarSolicitanteRt = mostrarEmpresaEnSidebar
                                || RoleGroupingHelper.HasAnyRawRole(rolesSidebarRaw, "RepresentanteTecnico", "Representante Técnico", "RepresentanteLegal", "RT");
                            var subtituloSidebar = rolUsuarioSidebar;
                            if (mostrarEmpresaEnSidebar)
                            {
                                subtituloSidebar = !string.IsNullOrWhiteSpace(empresaNombreSidebar)
                                    ? empresaNombreSidebar
                                    : (!string.IsNullOrWhiteSpace(empresaCodigoSidebar) ? empresaCodigoSidebar : rolSidebar);
                            }
                        }
                        <img src="@avatarUrl"
                             class="user-image img-circle elevation-1"
                             alt="@avatarAlt"
                             width="32" height="32"
                             onerror="this.onerror=null; this.src='@defaultAvatar';">
                        <span class="d-none d-md-inline ms-2" id="user-display-name">@avatarAlt</span>
                    </a>
                    <div class="dropdown-menu dropdown-menu-lg dropdown-menu-end">
                        <div class="user-header bg-light p-3 text-center">
                            <img src="@avatarUrl"
                                 class="img-circle elevation-2 mb-2"
                                 alt="@avatarAlt"
                                 width="90" height="90"
                                 onerror="this.onerror=null; this.src='@defaultAvatar';">
                            <p class="mb-0">
                                <span id="user-fullname" class="d-block">@avatarAlt</span>
                                <small id="user-role" class="text-muted">@rolUsuarioSidebar</small>
                            </p>
                        </div>
                        <div class="user-footer p-3">
                            <div class="row">
                                <div class="col-6">
                                    <a class="btn btn-default btn-block" href="@Url.Action("MiPerfil", "Usuario")">
                                        <i class="fas fa-user me-1"></i> Perfil
                                    </a>
                                </div>
                                <div class="col-6">
                                    <a class="btn btn-danger btn-block" href="@Url.Action("Logout", "Account")"
                                       id="logout-link">
                                        <i class="fas fa-sign-out-alt me-1"></i> Salir
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </li>
            </ul>
        </nav>

        <!-- Sidebar -->
        <aside class="main-sidebar sidebar-dark-primary elevation-4 aocr-sidebar">
                <!-- Información usuario sidebar (fijo, no se desplaza) -->
                @{
                    var rolSidebarResumen = RoleGroupingHelper.NormalizeSelectedRole(Session["Rol"] as string ?? string.Empty);
                    var ocultarResumenSidebar = RoleGroupingHelper.IsSolicitante(rolSidebarResumen);
                }
                @if (!ocultarResumenSidebar)
                {
                    <div class="user-panel d-flex align-items-center compact-user-panel aocr-sidebar-summary aocr-sidebar-summary--sticky">
                        <div class="image aocr-sidebar-summary__avatar">
                            <span class="aocr-sidebar-summary__status-dot"></span>
                            <img src="@avatarUrl"
                                 class="img-circle elevation-2"
                                 alt="@avatarAlt"
                                 width="40" height="40"
                                 onerror="this.onerror=null; this.src='@defaultAvatar';">
                        </div>
                        <div class="info aocr-sidebar-summary__info">
                            <span class="aocr-sidebar-summary__eyebrow">Acceso institucional</span>
                            <a href="@Url.Action("MiPerfil", "Usuario")" class="d-block aocr-sidebar-summary__name">@avatarAlt</a>
                            <small class="aocr-sidebar-summary__role" title="@subtituloSidebar">@subtituloSidebar</small>
                            <span class="aocr-sidebar-summary__badge">
                                <i class="fas fa-circle-check"></i>
                                Usuario activo
                            </span>
                        </div>
                    </div>
                }

            <div class="sidebar">
                <!-- Menu Sidebar -->
                @Html.Partial("_SideBar")
            </div>
        </aside>

        <!-- Contenido Principal -->
        <div class="content-wrapper aocr-main-wrapper">
            <!-- Contenido -->
            <section class="content aocr-content-shell px-3 pb-4 pt-3">
                <div class="container-fluid aocr-page">
                    @{
                        var shouldRenderHeaderHero =
                            Session["NombreUsuario"] != null || Session["Rol"] != null;
                    }

                    @if (shouldRenderHeaderHero)
                    {
                        @Html.Partial("_AOCRHeaderHero")
                    }

                    @RenderBody()
                </div>
            </section>
        </div>

        <!-- Footer -->
        <footer class="main-footer aocr-footer text-center border-top pt-3 no-print">
            <div class="container-fluid">
                <div class="row">
                    <div class="col-md-6 text-md-start">
                        @{
                            var appSettings = System.Configuration.ConfigurationManager.AppSettings;
                            var nombreSistema = appSettings["AOCR:UI:NombreSistema"];
                            var nombreOrganizacion = appSettings["AOCR:UI:NombreOrganizacion"];
                            var versionSistema = appSettings["AOCR:UI:Version"];
                            var ensambladoAplicacion = typeof(CapaPresentacion.MvcApplication).Assembly;
                            string fechaCompilacion;

                            if (string.IsNullOrWhiteSpace(nombreSistema))
                            {
                                nombreSistema = "Sistema AOCR";
                            }

                            if (string.IsNullOrWhiteSpace(nombreOrganizacion))
                            {
                                nombreOrganizacion = "Dirección General de Aviación Civil - Ecuador";
                            }

                            if (string.IsNullOrWhiteSpace(versionSistema))
                            {
                                versionSistema = ensambladoAplicacion.GetName().Version.ToString();
                            }

                            versionSistema = versionSistema.Trim();
                            if (versionSistema.StartsWith("v", StringComparison.OrdinalIgnoreCase))
                            {
                                versionSistema = versionSistema.Substring(1);
                            }

                            try
                            {
                                var compilacionConfigurada = appSettings["AOCR:UI:Compilacion"];
                                if (!string.IsNullOrWhiteSpace(compilacionConfigurada))
                                {
                                    fechaCompilacion = compilacionConfigurada.Trim();
                                }
                                else
                                {
                                    fechaCompilacion = System.IO.File.GetLastWriteTime(ensambladoAplicacion.Location).ToString("dd/MM/yyyy HH:mm");
                                }
                            }
                            catch
                            {
                                fechaCompilacion = DateTime.Now.ToString("dd/MM/yyyy HH:mm");
                            }
                        }
                        <div class="footer-title">@nombreSistema</div>
                        <small class="d-block footer-subtitle">
                            @nombreOrganizacion
                        </small>
                        <small class="d-block footer-meta">
                            Versión 1.0.0.0
                            · Compilación @fechaCompilacion
                        </small>
                    </div>
                    <div class="col-md-6 text-md-end">
                        <small class="footer-meta">
                            <i class="fas fa-shield-alt"></i>
                            @(HttpContext.Current.IsDebuggingEnabled ? "Desarrollo" : "Producción")
                            · Último acceso <span id="last-access-time">@DateTime.Now.ToString("dd/MM/yyyy HH:mm")</span>
                        </small>
                    </div>
                </div>
            </div>
        </footer>
    </div>

    @RenderSection("PageModals", required: false)

    <!-- Diagnostico global: no silencia promesas, registra causa y contexto. -->
    <script>
    window.addEventListener('unhandledrejection', function(e) {
        var r = e.reason;
        var details = {
            reason: r,
            type: typeof r,
            message: r && r.message ? r.message : (typeof r === 'string' ? r : ''),
            status: r && r.status ? r.status : null,
            responseText: r && r.responseText ? String(r.responseText).substring(0, 500) : '',
            stack: r && r.stack ? r.stack : '',
            keys: [],
            url: window.location.href
        };

        try {
            details.keys = r && typeof r === 'object' ? Object.keys(r).slice(0, 20) : [];
        } catch (ignore) {
        }

        window.__AOCR_LAST_UNHANDLED_REJECTION__ = details;

        if (window.console && typeof window.console.error === 'function') {
            window.console.error('[AOCR][UNHANDLED_PROMISE]', details);
        }
    });

    window.addEventListener('error', function(event) {
        if (window.console && typeof window.console.error === 'function') {
            window.console.error('[AOCR][JS_ERROR]', {
                message: event.message,
                source: event.filename,
                line: event.lineno,
                column: event.colno,
                error: event.error,
                url: window.location.href
            });
        }
    });

    window.__aocrGlobalDiagnosticsInstalled = true;
    </script>

