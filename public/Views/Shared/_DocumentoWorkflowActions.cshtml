@inherits System.Web.Mvc.WebViewPage<CapaPresentacion.Models.ViewModels.DocumentoWorkflowActionsVm>

@{
    var vm = Model ?? new CapaPresentacion.Models.ViewModels.DocumentoWorkflowActionsVm();
    var target = vm.AbrirEnNuevaPestana ? "_blank" : null;
    var rel = vm.AbrirEnNuevaPestana ? "noopener" : null;
    var clasesContenedor = string.IsNullOrWhiteSpace(vm.ContainerClass)
        ? "aocr-document-workflow"
        : "aocr-document-workflow " + vm.ContainerClass.Trim();
    var renderizarEstilos = ViewContext.HttpContext.Items["AocrDocumentoWorkflowActionsStyles"] == null;

    if (renderizarEstilos)
    {
        ViewContext.HttpContext.Items["AocrDocumentoWorkflowActionsStyles"] = true;
    }
}

@if (renderizarEstilos)
{
    <style>
        .aocr-document-workflow {
            display: grid;
            gap: 0.65rem;
        }

        .aocr-document-workflow__btn {
            display: inline-flex;
            flex-direction: column;
            align-items: flex-start;
            justify-content: center;
            gap: 0.25rem;
            width: 100%;
            min-height: 58px;
            padding: 0.9rem 1rem;
            border-radius: 14px;
            text-align: left;
            font-weight: 700;
        }

        .aocr-document-workflow__title {
            display: inline-flex;
            align-items: center;
            gap: 0.6rem;
            line-height: 1.2;
        }

        .aocr-document-workflow__hint {
            display: block;
            margin-left: 1.8rem;
            font-size: 0.78rem;
            line-height: 1.4;
            opacity: 0.84;
            font-weight: 500;
        }
    </style>
}

<div class="@clasesContenedor">
    @if (!string.IsNullOrWhiteSpace(vm.UrlVerDocumentacion))
    {
        <a href="@vm.UrlVerDocumentacion"
           class="btn btn-outline-primary aocr-document-workflow__btn"
           target="@target"
           rel="@rel">
            <span class="aocr-document-workflow__title">
                <i class="fas fa-file-alt"></i>
                @vm.TextoAccesoConsulta
            </span>
            <span class="aocr-document-workflow__hint">@vm.TextoAyudaConsulta</span>
        </a>
    }

    @if (vm.MostrarRevisionDocumental)
    {
        if (vm.PuedeAbrirRevisionDocumental && !string.IsNullOrWhiteSpace(vm.UrlRevisionDocumental))
        {
            <a href="@vm.UrlRevisionDocumental"
               class="btn btn-outline-success aocr-document-workflow__btn"
               target="@target"
               rel="@rel">
                <span class="aocr-document-workflow__title">
                    <i class="fas fa-file-circle-check"></i>
                    @vm.TextoAccesoRevision
                </span>
                <span class="aocr-document-workflow__hint">@vm.TextoAyudaRevision</span>
            </a>
        }
        else
        {
            <button type="button"
                    class="btn btn-outline-secondary aocr-document-workflow__btn"
                    disabled="disabled"
                    title="@vm.TituloBloqueoRevisionDocumental"
                    style="opacity: 0.6; cursor: not-allowed;">
                <span class="aocr-document-workflow__title">
                    <i class="fas fa-file-circle-check"></i>
                    @vm.TextoAccesoRevisionBloqueada
                </span>
                <span class="aocr-document-workflow__hint">@vm.TextoAyudaRevisionBloqueada</span>
            </button>
        }
    }
</div>
