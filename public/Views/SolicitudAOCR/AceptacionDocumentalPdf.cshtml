@inherits System.Web.Mvc.WebViewPage<CapaModelo.SolicitudAOCR>
@using System
@using System.Collections.Generic
@using System.Linq

@{
    Layout = "~/Views/Shared/_PdfLayoutDGAC.cshtml";
    ViewBag.UseInlinePdfBranding = true;
    var fecha = ViewBag.AceptacionFechaFirma != null ? (DateTime)ViewBag.AceptacionFechaFirma : DateTime.Now;
    var numeroOficio = (ViewBag.AceptacionNumeroOficio as string ?? ("DGAC-AOCR-" + (Model != null ? Model.CodigoSolicitud.ToString() : "0"))).Trim();
    var firmante = (ViewBag.AceptacionFirmante as string ?? "Coordinacion AOCR").Trim();
    var estado = (ViewBag.AceptacionEstado as string ?? string.Empty).Trim();
    var observacion = (ViewBag.AceptacionObservacion as string ?? string.Empty).Trim();
    var inspector = (ViewBag.AceptacionInspector as string ?? (Model != null ? Model.TecnicoResponsableNombre : string.Empty) ?? string.Empty).Trim();
    var documentos = ViewBag.AceptacionDocumentos as IEnumerable<string> ?? Enumerable.Empty<string>();
    var estaciones = ViewBag.AceptacionEstaciones as IEnumerable<string> ?? Enumerable.Empty<string>();
    var operador = Model == null ? string.Empty : (!string.IsNullOrWhiteSpace(Model.RazonSocial) ? Model.RazonSocial : (Model.NombreOperador ?? Model.NombreComercial));
    var representante = Model == null ? string.Empty : (Model.RepresentanteLegal ?? string.Empty);
    var numeroSolicitud = Model == null ? string.Empty : (!string.IsNullOrWhiteSpace(Model.NumeroSolicitud) ? Model.NumeroSolicitud : ("AOCR-" + Model.CodigoSolicitud));
    var aceptada = estado.Equals("ACEPTADA_POR_COORDINADOR", StringComparison.OrdinalIgnoreCase);
}

@section PdfHead {
    <style>
        .oficio { font-family: Arial, Helvetica, sans-serif; font-size: 11.5px; line-height: 1.52; color: #202020; }
        .oficio-meta { text-align: right; margin: 2mm 0 8mm; }
        .oficio-meta strong { display: block; font-size: 12px; }
        .oficio-asunto { margin: 0 0 7mm; }
        .oficio-destinatario { margin-bottom: 7mm; }
        .oficio p { text-align: justify; margin: 0 0 4mm; }
        .oficio ul { margin: 2mm 0 5mm 7mm; padding-left: 5mm; }
        .firma { margin-top: 12mm; page-break-inside: avoid; }
        .firma-espacio { height: 19mm; }
        .firma strong { display: block; text-transform: uppercase; }
        .referencia { font-size: 9.5px; margin-top: 9mm; color: #444; }
        .anexos h3 { font-size: 12px; margin: 0 0 5mm; }
        .anexos li { margin-bottom: 2mm; }
        .estado-borrador { border: 1px solid #a5a5a5; background: #f4f4f4; padding: 3mm; margin-bottom: 6mm; font-weight: bold; text-align: center; }
    </style>
}

<div class="oficio">
    <div class="oficio-meta">
        <strong>Oficio Nro. @numeroOficio</strong>
        <span>Quito, @fecha.ToString("dd 'de' MMMM 'de' yyyy", new System.Globalization.CultureInfo("es-EC"))</span>
    </div>

    @if (!aceptada)
    {
        <div class="estado-borrador">DOCUMENTO PENDIENTE DE REVISION Y FIRMA DE COORDINACION</div>
    }

    <div class="oficio-asunto"><strong>Asunto:</strong> Aceptacion de revision documental y designacion de inspector para tramite AOCR.</div>

    <div class="oficio-destinatario">
        <strong>Se&ntilde;or(a)</strong><br />
        <strong>@(string.IsNullOrWhiteSpace(representante) ? "Representante Tecnico" : representante)</strong><br />
        @(string.IsNullOrWhiteSpace(operador) ? "Operador Aereo Extranjero" : operador)<br />
        <strong>En su despacho</strong>
    </div>

    <p>De mi consideracion:</p>
    <p>
        En referencia a la solicitud <strong>@numeroSolicitud</strong>, presentada por el Operador Aereo Extranjero
        <strong>@(string.IsNullOrWhiteSpace(operador) ? "no registrado" : operador)</strong>, esta Coordinacion informa que la documentacion
        revisada por el Inspector asignado ha sido verificada conforme al procedimiento aplicable al tramite AOCR.
    </p>

    @if (aceptada)
    {
        <p>La revision documental se acoge favorablemente, por lo que se autoriza continuar con la etapa de Lista de Verificacion e Informe Tecnico.</p>
    }
    else
    {
        <p>La revision fue finalizada por el Inspector y se remite a Coordinacion para su decision. Este documento no habilita la Lista de Verificacion ni el Informe Tecnico mientras no conste la aceptacion correspondiente.</p>
    }

    <p>Para dicho efecto, se @(aceptada ? "mantiene/designa" : "propone mantener/designar") al inspector <strong>@(string.IsNullOrWhiteSpace(inspector) ? "por confirmar" : inspector)</strong> para continuar con las actividades correspondientes.</p>

    <p>La inspeccion se realizara conforme el siguiente detalle:</p>
    @if (estaciones.Any())
    {
        <ul>
            @foreach (var estacion in estaciones) { <li>@estacion: fecha conforme planificacion aprobada.</li> }
        </ul>
    }
    else
    {
        <p>Las fechas y estaciones seran registradas conforme la planificacion aprobada.</p>
    }

    <p>Los gastos de traslado aereo y terrestre, asi como los viaticos del inspector cuando correspondan, se gestionaran mediante las ordenes de recaudacion y comprobantes vigentes asociados al tramite.</p>

    @if (!string.IsNullOrWhiteSpace(observacion))
    {
        <p><strong>Observacion general de la revision documental:</strong> @observacion</p>
    }

    <p>Con sentimientos de distinguida consideracion.</p>
    <div class="firma">
        <p>Atentamente,</p>
        <div class="firma-espacio"></div>
        <strong>@firmante</strong>
        <span>Coordinacion de Operaciones / AOCR<br />Direccion General de Aviacion Civil</span>
    </div>

    <div class="referencia"><strong>Referencia:</strong> Solicitud @numeroSolicitud. Documento generado con trazabilidad en el Sistema AOCR.</div>

    @if (documentos.Any())
    {
        <div class="page-break anexos">
            <div class="oficio-meta">
                <strong>Oficio Nro. @numeroOficio</strong>
                <span>Quito, @fecha.ToString("dd 'de' MMMM 'de' yyyy", new System.Globalization.CultureInfo("es-EC"))</span>
            </div>
            <h3>Anexos</h3>
            <ul>
                @foreach (var documento in documentos) { <li>@documento</li> }
            </ul>
            <h3>Copia</h3>
            <ul>
                <li>@(string.IsNullOrWhiteSpace(inspector) ? "Inspector asignado" : inspector) - Inspector</li>
                <li>@(string.IsNullOrWhiteSpace(representante) ? "Representante Tecnico" : representante) - RT</li>
                <li>Expediente digital AOCR</li>
            </ul>
        </div>
    }
</div>
