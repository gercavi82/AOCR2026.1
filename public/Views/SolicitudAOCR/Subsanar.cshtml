@inherits System.Web.Mvc.WebViewPage<CapaPresentacion.Models.SubsanacionViewModel>
@using System
@using CapaDatos.Constants
@using CapaPresentacion.Helpers
@using System.Linq
@using System.Web.Mvc
@using System.Web.Mvc.Html

@{
    ViewBag.Title = "Subsanar Documentación";
    Layout = "~/Views/Shared/_LayoutAOCR.cshtml";
    var documentosPendientesSubsanacion = (Model.DocumentosObservados ?? Enumerable.Empty<CapaPresentacion.Models.DocumentoSubsanacionVM>())
        .Where(doc => doc != null)
        .ToList();
    var documentosBloqueados = (Model.DocumentosBloqueados ?? Enumerable.Empty<CapaPresentacion.Models.DocumentoSubsanacionVM>())
        .Where(doc => doc != null)
        .ToList();
}

<style>
    .subsanar-container { max-width: 980px; margin: 0 auto; }
    .obs-card { border-left: 4px solid #ffc107 !important; }
    .blocked-card { border-left: 4px solid #6c757d !important; }
    .obs-item { background: #fffbea; border-radius: 8px; padding: 1rem 1.25rem; margin-bottom: 0.75rem; }
    .obs-item:last-child { margin-bottom: 0; }
    .doc-upload-card { border: 2px dashed #dee2e6; border-radius: 10px; padding: 1.25rem; transition: border-color 0.2s; }
    .doc-upload-card:hover { border-color: #0d6efd; }
    .doc-upload-card.has-file { border-color: #198754; border-style: solid; background: #f0fdf4; }
    .doc-readonly-card { border: 1px solid #dee2e6; border-radius: 10px; padding: 1rem 1.25rem; background: #f8f9fa; }
    .doc-badge-current { font-size: 0.75rem; }
    .file-name-display { font-size: 0.85rem; color: #198754; font-weight: 600; margin-top: 0.5rem; word-break: break-word; }
    .summary-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 0.75rem; }
    .summary-item label { font-size: 0.78rem; color: #6c757d; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 0.15rem; }
    .summary-item .value { font-size: 0.95rem; font-weight: 600; color: #212529; word-break: break-word; }
    .step-number { width: 36px; height: 36px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; font-weight: 700; font-size: 1rem; flex-shrink: 0; }
    .doc-actions-inline { display: flex; flex-wrap: wrap; gap: 0.5rem; }
    .doc-actions-inline .btn { flex: 1 1 auto; min-width: 120px; }
    @@media (max-width: 767.98px) {
        .doc-actions-inline .btn { width: 100%; }
    }
</style>

@Html.Partial("_PageHeader", null, new ViewDataDictionary {
    { "Title", "Subsanar Documentación" },
    { "Subtitle", "Corrija las observaciones y reenvíe los documentos solicitados" }
})

<div class="subsanar-container py-4">

    @Html.Partial("_ActionToolbar", null, new ViewDataDictionary {
        { "VolverUrl", Url.Action("Detalle", "SolicitudAOCR", new { id = Model.CodigoSolicitud }) }
    })


    @* ══════════════════════════════════════════════════════════════
       BLOQUE 1 — RESUMEN DE LA SOLICITUD
       ══════════════════════════════════════════════════════════════ *@
    <div class="card shadow-sm mb-4">
        <div class="card-body p-4">
            <div class="d-flex align-items-center gap-2 mb-3">
                <span class="step-number bg-primary text-white">1</span>
                <h5 class="mb-0 fw-bold">Resumen de la Solicitud</h5>
            </div>

            <div class="summary-grid">
                <div class="summary-item">
                    <label>Solicitud Nro.</label>
                    <div class="value">
                        <i class="fas fa-hashtag text-primary me-1"></i>@(Model.CodigoSolicitud)
                        @if (!string.IsNullOrWhiteSpace(Model.NumeroSolicitud))
                        {
                            <small class="text-muted ms-1">(@Model.NumeroSolicitud)</small>
                        }
                    </div>
                </div>
                <div class="summary-item">
                    <label>Compañía</label>
                    <div class="value"><i class="fas fa-building text-secondary me-1"></i>@(Model.Compania ?? "—")</div>
                </div>
                <div class="summary-item">
                    <label>Fecha de Solicitud</label>
                    <div class="value">
                        <i class="fas fa-calendar-alt text-secondary me-1"></i>@(Model.FechaSolicitud.HasValue ? Model.FechaSolicitud.Value.ToString("dd/MM/yyyy") : "—")
                    </div>
                </div>
                <div class="summary-item">
                    <label>Estado</label>
                    <div class="value"><span class="badge bg-warning text-dark"><i class="fas fa-eye me-1"></i>OBSERVADA</span></div>
                </div>
                <div class="summary-item">
                    <label>Inspector Asignado</label>
                    <div class="value"><i class="fas fa-user-tie text-secondary me-1"></i>@(Model.InspectorNombre ?? "Sin asignar")</div>
                </div>
            </div>
        </div>
    </div>

    @* ══════════════════════════════════════════════════════════════
       BLOQUE 2 — OBSERVACIONES DEL INSPECTOR
       ══════════════════════════════════════════════════════════════ *@
    <div class="card shadow-sm mb-4 obs-card">
        <div class="card-body p-4">
            <div class="d-flex align-items-center gap-2 mb-3">
                <span class="step-number bg-warning text-dark">2</span>
                <h5 class="mb-0 fw-bold">Observaciones del Inspector</h5>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.ObservacionesInspector))
            {
                <div class="obs-item">
                    <div class="d-flex align-items-start gap-2">
                        <i class="fas fa-exclamation-triangle text-warning mt-1"></i>
                        <div>
                            <p class="mb-0" style="white-space: pre-line;">@CapaPresentacion.Helpers.VisibleTextHelper.Normalize(Model.ObservacionesInspector)</p>
                        </div>
                    </div>
                </div>
            }

            @if (Model.HistorialObservaciones != null && Model.HistorialObservaciones.Any())
            {
                <h6 class="fw-semibold mt-3 mb-2"><i class="fas fa-history text-muted me-1"></i>Historial de Observaciones</h6>
                foreach (var obs in Model.HistorialObservaciones)
                {
                    <div class="obs-item">
                        <div class="d-flex justify-content-between align-items-start mb-1">
                            <small class="text-muted">
                                <i class="fas fa-user-circle me-1"></i>@(obs.Usuario ?? "Inspector")
                            </small>
                            <small class="text-muted">
                                <i class="fas fa-clock me-1"></i>@(obs.Fecha.HasValue ? obs.Fecha.Value.ToString("dd/MM/yyyy HH:mm") : "—")
                            </small>
                        </div>
                        <p class="mb-0" style="white-space: pre-line;">@CapaPresentacion.Helpers.VisibleTextHelper.Normalize(obs.Observacion)</p>
                    </div>
                }
            }

            @if (string.IsNullOrWhiteSpace(Model.ObservacionesInspector) && (Model.HistorialObservaciones == null || !Model.HistorialObservaciones.Any()))
            {
                <div class="text-center py-3 text-muted">
                    <i class="fas fa-check-circle fa-2x mb-2 d-block"></i>
                    No se encontraron observaciones registradas.
                </div>
            }
        </div>
    </div>

    @* ══════════════════════════════════════════════════════════════
       BLOQUE 3 — CORRECCIÓN DE DOCUMENTOS
       ══════════════════════════════════════════════════════════════ *@
    <form method="post" action="@Url.Action("EnviarSubsanacionAlInspector", "SolicitudAOCR")" enctype="multipart/form-data" id="formSubsanar">
        @Html.AntiForgeryToken()
        <input type="hidden" name="codigoSolicitud" value="@Model.CodigoSolicitud" />

        <div class="card shadow-sm mb-4">
            <div class="card-body p-4">
                <div class="d-flex align-items-center gap-2 mb-3">
                    <span class="step-number bg-success text-white">3</span>
                    <h5 class="mb-0 fw-bold">Corrección de Documentos</h5>
                </div>
                <p class="text-muted mb-3">
                    <i class="fas fa-info-circle me-1"></i>Solo se encuentran habilitados para subsanación los documentos devueltos por el Inspector. Los documentos aceptados o sin observaciones permanecen bloqueados para garantizar la trazabilidad del expediente.
                </p>
                <div class="alert alert-warning border mb-3" role="alert">
                    <i class="fas fa-list-check me-1"></i>
                    Documentos devueltos pendientes de subsanación: <strong>@documentosPendientesSubsanacion.Count</strong>.
                </div>

                @if (documentosPendientesSubsanacion.Any())
                {
                    foreach (var doc in documentosPendientesSubsanacion)
                    {
                        <div class="doc-upload-card mb-3" id="docCard_@doc.CodigoDocumento">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <h6 class="mb-1 fw-semibold">
                                        <i class="fas fa-file-alt text-primary me-1"></i>@doc.TipoDocumento
                                    </h6>
                                    <small class="text-muted">
                                        Archivo actual: <strong>@doc.NombreArchivo</strong>
                                        @if (doc.FechaCarga.HasValue)
                                        {
                                            <span class="ms-2"><i class="fas fa-clock"></i> @doc.FechaCarga.Value.ToString("dd/MM/yyyy")</span>
                                        }
                                    </small>
                                </div>
                                <div>
                                    @if (!string.IsNullOrWhiteSpace(doc.Estado))
                                    {
                                        var badgeClass = RevisionDocumentalDisplayHelper.GetBadgeClass(doc.Estado, true) + " doc-badge-current";
                                        var estadoVisible = RevisionDocumentalDisplayHelper.GetVisibleStateLabel(doc.Estado);
                                        <span class="@badgeClass">@estadoVisible</span>
                                    }
                                </div>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(doc.Observaciones))
                            {
                                <div class="alert alert-warning py-2 px-3 mb-2" style="font-size: 0.85rem;">
                                    <i class="fas fa-comment-dots me-1"></i>@CapaPresentacion.Helpers.VisibleTextHelper.Normalize(doc.Observaciones)
                                </div>
                            }

                            <div class="doc-actions-inline mb-2">
                                <a href="@Url.Action("Descargar", "Documento", new { id = doc.CodigoDocumento, vistaPrevia = true })"
                                   class="btn btn-sm btn-outline-secondary">
                                    <i class="fas fa-eye"></i> Ver anterior
                                </a>
                                <a href="@Url.Action("Descargar", "Documento", new { id = doc.CodigoDocumento })"
                                   class="btn btn-sm btn-aocr-primary">
                                    <i class="fas fa-download"></i> Descargar anterior
                                </a>
                            </div>

                            <div class="mt-2">
                                <label class="form-label fw-semibold mb-1" style="font-size: 0.85rem;">
                                    <i class="fas fa-upload me-1"></i>Subsanar documento
                                </label>
                                <input type="hidden" name="docIds" value="@doc.CodigoDocumento" />
                                <input type="hidden" name="docTipos" value="@doc.TipoDocumento" />
                                <input type="file" class="form-control form-control-sm doc-file-input"
                                       name="archivos_@doc.CodigoDocumento"
                                       accept=".pdf,.doc,.docx,.xls,.xlsx,.jpg,.jpeg,.png"
                                       multiple
                                       data-card="docCard_@doc.CodigoDocumento" />
                                <div class="file-name-display d-none" id="fileName_@doc.CodigoDocumento"></div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center py-4 text-muted">
                        <i class="fas fa-folder-open fa-2x mb-2 d-block"></i>
                        No se encontraron documentos pendientes de subsanación para esta solicitud.
                    </div>
                }

                <div class="mt-4 pt-3 border-top">
                    <label class="form-label fw-semibold" for="comentarioSubsanacion">
                        <i class="fas fa-comment me-1"></i>Comentario adicional <small class="text-muted">(opcional)</small>
                    </label>
                    <textarea class="form-control" id="comentarioSubsanacion" name="comentario" rows="3"
                              placeholder="Describa brevemente las correcciones realizadas..."></textarea>
                </div>

                @* ── BOTONES DE ACCIÓN ── *@
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-stretch align-items-md-center gap-2 mb-5">
                    <a href="@Url.Action("Detalle", "SolicitudAOCR", new { id = Model.CodigoSolicitud })" class="btn btn-outline-secondary">
                        <i class="fas fa-times me-1"></i>Cancelar
                    </a>
                    @if (documentosPendientesSubsanacion.Any())
                    {
                        <button type="submit" class="btn btn-success btn-lg" id="btnReenviar">
                            <i class="fas fa-paper-plane me-2"></i>Enviar subsanación al Inspector
                        </button>
                    }
                </div>
            </div>
        </div>

        @if (documentosBloqueados.Any())
        {
            <div class="card shadow-sm mb-4 blocked-card">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <span class="step-number bg-secondary text-white">4</span>
                        <h5 class="mb-0 fw-bold">Documentos aceptados o sin observaciones — Solo consulta</h5>
                    </div>
                    <p class="text-muted mb-3">Estos documentos permanecen bloqueados. Solo puede visualizarlos o descargarlos.</p>

                    @foreach (var doc in documentosBloqueados)
                    {
                        <div class="doc-readonly-card mb-3">
                            <div class="d-flex flex-column flex-md-row justify-content-between align-items-start gap-2 mb-2">
                                <div class="flex-grow-1">
                                    <h6 class="mb-1 fw-semibold">
                                        <i class="fas fa-lock text-secondary me-1"></i>@doc.TipoDocumento
                                    </h6>
                                    <small class="text-muted d-block" style="overflow-wrap:anywhere;">
                                        Archivo: <strong>@doc.NombreArchivo</strong>
                                        @if (doc.Version.HasValue)
                                        {
                                            <span class="ms-2">Versión @doc.Version</span>
                                        }
                                    </small>
                                </div>
                                <span class="badge bg-success doc-badge-current">Aceptado / Bloqueado</span>
                            </div>
                            <div class="doc-actions-inline">
                                <a href="@Url.Action("Descargar", "Documento", new { id = doc.CodigoDocumento, vistaPrevia = true })"
                                   class="btn btn-sm btn-outline-secondary">
                                    <i class="fas fa-eye"></i> Ver
                                </a>
                                <a href="@Url.Action("Descargar", "Documento", new { id = doc.CodigoDocumento })"
                                   class="btn btn-sm btn-aocr-primary">
                                    <i class="fas fa-download"></i> Descargar
                                </a>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </form>
</div>

@section scripts {
<script>
    $(document).ready(function () {
        // Resaltar tarjeta al seleccionar archivo
        $('.doc-file-input').on('change', function () {
            var cardId = $(this).data('card');
            var card = $('#' + cardId);
            var docId = cardId.replace('docCard_', '');
            var display = $('#fileName_' + docId);

            if (this.files && this.files.length > 0) {
                card.addClass('has-file');
                var nombres = Array.prototype.slice.call(this.files).map(function (file) {
                    return file.name;
                });
                display.text('\u2713 ' + nombres.length + ' archivo(s): ' + nombres.join(', ')).removeClass('d-none');
            } else {
                card.removeClass('has-file');
                display.addClass('d-none');
            }
        });

        // Confirmación antes de enviar
        $('#formSubsanar').on('submit', function (e) {
            var archivosSeleccionados = 0;
            $('.doc-file-input').each(function () {
                if (this.files && this.files.length > 0) archivosSeleccionados++;
            });

            var totalDevueltos = $('.doc-file-input').length;
            if (archivosSeleccionados < totalDevueltos) {
                e.preventDefault();
                Swal.fire({
                    title: 'Subsanación incompleta',
                    text: 'Debe cargar la subsanación de todos los documentos devueltos por el Inspector antes de enviar nuevamente a revisión.',
                    icon: 'warning',
                    confirmButtonText: 'Entendido'
                });
                return false;
            }

            if (archivosSeleccionados === 0) {
                e.preventDefault();
                Swal.fire({
                    title: 'Sin documentos',
                    text: 'Debe subir al menos un documento corregido para reenviar la subsanación.',
                    icon: 'warning',
                    confirmButtonText: 'Entendido'
                });
                return false;
            }

            e.preventDefault();
            var form = this;
            Swal.fire({
                title: '\u00bfReenviar corrección?',
                html: 'Se subirán <strong>' + archivosSeleccionados + '</strong> documento(s) corregido(s) y la solicitud pasará a revisión nuevamente.',
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#198754',
                cancelButtonColor: '#6c757d',
                confirmButtonText: '<i class="fas fa-paper-plane me-1"></i> Sí, reenviar',
                cancelButtonText: 'Cancelar'
            }).then(function (result) {
                if (result.isConfirmed) {
                    Swal.fire({ title: 'Enviando corrección...', allowOutsideClick: false, didOpen: function () { Swal.showLoading(); } });
                    form.submit();
                }
            });
        });
    });
</script>
}
