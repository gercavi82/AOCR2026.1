@inherits System.Web.Mvc.WebViewPage<Parametro>
@using CapaModelo
@using System.Web.Mvc
@using System.Web.Mvc.Html
@{
    ViewBag.Title = "Editar Parámetro";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-warning text-dark">
                    <h4 class="mb-0"><i class="fas fa-edit"></i> Editar Parámetro</h4>
                </div>
                <div class="card-body">
                    @using (Html.BeginForm("Editar", "Parametro", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        @Html.HiddenFor(m => m.CodigoParametro)

                        <div class="mb-3">
                            @Html.LabelFor(m => m.Clave, new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.Clave, new { @class = "form-control", @readonly = "readonly" })
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(m => m.Valor, new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.Valor, new { @class = "form-control", required = "required" })
                            @Html.ValidationMessageFor(m => m.Valor, "", new { @class = "text-danger" })
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(m => m.Descripcion, new { @class = "form-label" })
                            @Html.TextAreaFor(m => m.Descripcion, new { @class = "form-control", rows = 3 })
                            @Html.ValidationMessageFor(m => m.Descripcion, "", new { @class = "text-danger" })
                        </div>

                        <div class="alert alert-warning">
                            <i class="fas fa-exclamation-triangle"></i>
                            Modificar parámetros del sistema puede afectar el funcionamiento de la aplicación.
                        </div>

                        <hr />

                        <div class="d-flex justify-content-between">
                            <a href="@Url.Action("Index", "Parametro")" class="btn btn-secondary">
                                <i class="fas fa-arrow-left"></i> Cancelar
                            </a>
                            <button type="submit" class="btn btn-warning">
                                <i class="fas fa-save"></i> Actualizar Parámetro
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

