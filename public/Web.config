    <mailSettings>
      <smtp from="no_reply@aviacioncivil.gob.ec">
        <network host="mail.aviacioncivil.gob.ec" port="25" enableSsl="false" />
        <!-- Si el servidor requiere autenticación, descomentar y configurar:
