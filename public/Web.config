  <!--
    Para obtener una descripción de los cambios de web.config, vea http://go.microsoft.com/fwlink/?LinkId=235367.

    Los siguientes atributos se pueden establecer en la etiqueta <httpRuntime>.
      <system.Web>
        <httpRuntime targetFramework="4.6.1" />
      </system.Web>
  -->
  <system.web>
    <!-- El servidor tiene .NET 4.6.2 (Release 394806). Debe coincidir con TargetFrameworkVersion del csproj. -->
    <compilation targetFramework="4.6.2">
      <assemblies>
        <add assembly="System.Web.Mvc" />
        <add assembly="System.Web.Razor" />
        <add assembly="System.Web.WebPages" />
        <add assembly="System.Web.WebPages.Razor" />
        <add assembly="System.Web.Helpers" />
        <add assembly="netstandard, Version=2.0.0.0, Culture=neutral, PublicKeyToken=cc7b13ffcd2ddd51" />
      </assemblies>
    </compilation>
    <httpRuntime targetFramework="4.6.2" maxRequestLength="51200" executionTimeout="300" />
    <!-- Clave fija para que FormsAuth y antiforgery sigan siendo válidos tras reciclados/reinicios de la app o publicación en IIS. -->
    <machineKey validationKey="3F0D83C9D0E531D431F2F085EEBF1A23C11175DFA6CB75251CE47FC2B4B62A2C12B405AFE86D5D9CC95AAEB0D3AF6B5157FF2E6D10FB60769680D465EA2C69CA" decryptionKey="67C71299BB7D020714B08BF2E0C40A61C12D78AB89EE72F778A5356579A7C591" validation="HMACSHA256" decryption="AES" />
    <authentication mode="Forms">
      <forms loginUrl="~/Account/Login" timeout="60" slidingExpiration="true" protection="All" />
    </authentication>
    <authorization>
      <deny users="?" />
    </authorization>
    <customErrors mode="RemoteOnly" defaultRedirect="~/Error">
      <error statusCode="404" redirect="~/Error/NotFound" />
      <error statusCode="403" redirect="~/Error/AccessDenied" />
      <error statusCode="500" redirect="~/Error" />
    </customErrors>
    <!-- Desactivar trace en producción -->
    <trace enabled="false" localOnly="true" />
    <globalization culture="es-EC" uiCulture="es-EC" requestEncoding="utf-8" responseEncoding="utf-8" fileEncoding="utf-8" />
    <pages validateRequest="true" />
    <httpModules>
      <add name="TelemetryCorrelationHttpModule" type="Microsoft.AspNet.TelemetryCorrelation.TelemetryCorrelationHttpModule, Microsoft.AspNet.TelemetryCorrelation" />
    </httpModules>
  </system.web>
