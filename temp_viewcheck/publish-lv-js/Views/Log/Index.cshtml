@model List<CapaModelo.Log>
@{
    ViewData["Title"] = "Logs del Sistema";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-md-8">
            <h2><i class="fas fa-history"></i> Logs del Sistema</h2>
            <p class="text-muted">Registro de actividades y eventos del sistema</p>
        </div>
        <div class="col-md-4 text-end">
            <button class="btn btn-danger" id="btnLimpiarLogs">
                <i class="fas fa-trash-alt"></i> Limpiar Logs
            </button>
            <button class="btn btn-success" id="btnExportarLogs">
                <i class="fas fa-download"></i> Exportar
            </button>
        </div>
    </div>

    <!-- Filtros Avanzados -->
    <div class="card shadow mb-4">
        <div class="card-header bg-dark text-white">
            <h5 class="mb-0"><i class="fas fa-filter"></i> Filtros de Búsqueda</h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-3 mb-3">
                    <label class="form-label">Nivel</label>
                    <select class="form-select" id="filtroNivel">
                        <option value="">Todos</option>
                        <option value="INFO">INFO</option>
                        <option value="WARNING">WARNING</option>
                        <option value="ERROR">ERROR</option>
                        <option value="CRITICAL">CRITICAL</option>
                    </select>
                </div>
                <div class="col-md-3 mb-3">
                    <label class="form-label">Módulo</label>
                    <select class="form-select" id="filtroModulo">
                        <option value="">Todos</option>
                        <option value="Usuario">Usuario</option>
                        <option value="Rol">Rol</option>
                        <option value="Checklist">Checklist</option>
                        <option value="Informe">Informe</option>
                        <option value="Sistema">Sistema</option>
                    </select>
                </div>
                <div class="col-md-3 mb-3">
                    <label class="form-label">Fecha Inicio</label>
                    <input type="date" class="form-control" id="filtroFechaInicio">
                </div>
                <div class="col-md-3 mb-3">
                    <label class="form-label">Fecha Fin</label>
                    <input type="date" class="form-control" id="filtroFechaFin">
                </div>
            </div>
            <div class="row">
                <div class="col-md-9 mb-3">
                    <label class="form-label">Buscar en Mensaje</label>
                    <input type="text" class="form-control" id="filtroBusqueda"
                           placeholder="Buscar por mensaje, usuario, IP...">
                </div>
                <div class="col-md-3 mb-3">
                    <label class="form-label">&nbsp;</label>
                    <button class="btn btn-primary w-100" id="btnAplicarFiltros">
                        <i class="fas fa-search"></i> Buscar
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Estadísticas Rápidas -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card text-center bg-info text-white">
                <div class="card-body">
                    <h3>@Model.Count</h3>
                    <p class="mb-0">Total Registros</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center bg-success text-white">
                <div class="card-body">
                    <h3>@Model.Count(l => l.Nivel == "INFO")</h3>
                    <p class="mb-0">INFO</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center bg-warning text-white">
                <div class="card-body">
                    <h3>@Model.Count(l => l.Nivel == "WARNING")</h3>
                    <p class="mb-0">WARNING</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center bg-danger text-white">
                <div class="card-body">
                    <h3>@Model.Count(l => l.Nivel == "ERROR")</h3>
                    <p class="mb-0">ERROR</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabla de Logs -->
    <div class="card shadow">
        <div class="card-header bg-dark text-white">
            <h5 class="mb-0"><i class="fas fa-list"></i> Registro de Logs</h5>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table id="tablaLogs" class="table table-sm table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th width="5%">ID</th>
                            <th width="12%">Fecha/Hora</th>
                            <th width="8%">Nivel</th>
                            <th width="10%">Módulo</th>
                            <th width="10%">Usuario</th>
                            <th width="35%">Mensaje</th>
                            <th width="10%">IP</th>
                            <th width="10%">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in Model)
                        {
                            <tr>
                                <td>@log.CodigoLog</td>
                                <td>
                                    @if (log.FechaRegistro.HasValue)
                                    {
                                        <small>@log.FechaRegistro.Value.ToString("dd/MM/yyyy")</small><br />
                                        <small class="text-muted">@log.FechaRegistro.Value.ToString("HH:mm:ss")</small>
                                    }
                                    else
                                    {
                                        <small class="text-muted">Sin fecha</small>
                                    }
                                </td>
                                <td>
                                    @if (log.Nivel == "INFO")
                                    {
                                        <span class="badge bg-info">INFO</span>
                                    }
                                    else if (log.Nivel == "WARNING")
                                    {
                                        <span class="badge bg-warning">WARNING</span>
                                    }
                                    else if (log.Nivel == "ERROR")
                                    {
                                        <span class="badge bg-danger">ERROR</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-dark">@log.Nivel</span>
                                    }
                                </td>
                                <td>@log.Categoria</td>
                                <td>
                                    @if (log.CodigoUsuario.HasValue)
                                    {
                                        <span>Usuario #@log.CodigoUsuario</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Sistema</span>
                                    }
                                </td>
                                <td>
                                    <small>@log.Mensaje</small>
                                </td>
                                <td><small>@log.IpAddress</small></td>
                                <td>
                                    <button class="btn btn-sm btn-info btnVerDetalle"
                                            data-id="@log.CodigoLog" title="Ver Detalle">
                                        <i class="fas fa-eye"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal Detalle Log -->
<div class="modal fade" id="modalDetalleLog" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title"><i class="fas fa-info-circle"></i> Detalle del Log</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="detalleLogContenido">
                <!-- Contenido dinámico -->
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            var table = $('#tablaLogs').DataTable({
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/es-ES.json'
                },
                order: [[0, 'desc']],
                pageLength: 5,
                lengthMenu: [[5, 10, 25, 50, -1], [5, 10, 25, 50, 'Todos']],
                columnDefs: [
                    { orderable: false, targets: 7 }
                ]
            });

            // Aplicar filtros
            $('#btnAplicarFiltros').on('click', function() {
                var nivel = $('#filtroNivel').val();
                var modulo = $('#filtroModulo').val();
                var busqueda = $('#filtroBusqueda').val();

                table.column(2).search(nivel);
                table.column(3).search(modulo);
                table.search(busqueda).draw();
            });

            // Ver detalle
            $(document).on('click', '.btnVerDetalle', function() {
                var id = $(this).data('id');

                // Simular carga de detalle
                var contenido = `
                    <dl class="row">
                        <dt class="col-sm-3">ID:</dt>
                        <dd class="col-sm-9">${AOCR.escapeHtml(String(id))}</dd>

                        <dt class="col-sm-3">Fecha/Hora:</dt>
                        <dd class="col-sm-9">08/12/2024 15:30:45</dd>

                        <dt class="col-sm-3">Nivel:</dt>
                        <dd class="col-sm-9"><span class="badge bg-info">INFO</span></dd>

                        <dt class="col-sm-3">Módulo:</dt>
                        <dd class="col-sm-9">Usuario</dd>

                        <dt class="col-sm-3">Usuario:</dt>
                        <dd class="col-sm-9">admin</dd>

                        <dt class="col-sm-3">Dirección IP:</dt>
                        <dd class="col-sm-9">192.168.1.100</dd>

                        <dt class="col-sm-3">Mensaje:</dt>
                        <dd class="col-sm-9">Usuario creado exitosamente</dd>

                        <dt class="col-sm-3">Stack Trace:</dt>
                        <dd class="col-sm-9">
                            <pre class="bg-light p-2">
at UsuarioController.Crear()
at Microsoft.AspNetCore.Mvc.Infrastructure.ActionMethodExecutor
                            </pre>
                        </dd>
                    </dl>
                `;

                $('#detalleLogContenido').html(contenido);
                $('#modalDetalleLog').modal('show');
            });

            // Limpiar logs
            $('#btnLimpiarLogs').on('click', function() {
                Swal.fire({
                    title: '¿Limpiar logs?',
                    html: `
                        <p>Seleccione el rango a eliminar:</p>
                        <select class="form-select" id="rangoLimpieza">
                            <option value="7">Últimos 7 días</option>
                            <option value="30">Últimos 30 días</option>
                            <option value="90">Últimos 90 días</option>
                            <option value="all">Todos los logs</option>
                        </select>
                    `,
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Sí, limpiar',
                    cancelButtonText: 'Cancelar'
                }).then((result) => {
                    if (result.isConfirmed) {
                        Swal.fire('Limpiado', 'Los logs han sido eliminados', 'success')
                            .then(() => location.reload());
                    }
                });
            });

            // Exportar logs
            $('#btnExportarLogs').on('click', function() {
                Swal.fire({
                    title: 'Exportar Logs',
                    html: `
                        <div class="mb-3">
                            <label class="form-label">Formato:</label>
                            <select class="form-select" id="formatoExport">
                                <option value="csv">CSV</option>
                                <option value="excel">Excel</option>
                                <option value="json">JSON</option>
                                <option value="txt">TXT</option>
                            </select>
                        </div>
                    `,
                    showCancelButton: true,
                    confirmButtonText: 'Exportar',
                    cancelButtonText: 'Cancelar'
                }).then((result) => {
                    if (result.isConfirmed) {
                        Swal.fire('Exportando...', 'Generando archivo', 'info');
                    }
                });
            });
        });
    </script>
}