    private static IList<int> IndicesOficialPanel(params int[] indices)
    {
        return (indices ?? new int[0]).Distinct().ToList();
    }

    private static string ObtenerCodigoPreguntaOficialPanel(ListaVerificacionOperacionalEaeItem item)
    {
        if (item == null)
        {
            return string.Empty;
        }

        var codigoPregunta = (item.CodigoPregunta ?? string.Empty).Trim();
        if (!string.IsNullOrWhiteSpace(codigoPregunta))
        {
            return codigoPregunta;
        }

        var codigo = (item.Codigo ?? string.Empty).Trim();

        if (string.IsNullOrWhiteSpace(codigo))
        {
            return string.Empty;
        }

        var indiceUltimoGuion = codigo.LastIndexOf('-');
        if (indiceUltimoGuion > 0)
        {
            int sufijo;
            if (int.TryParse(codigo.Substring(indiceUltimoGuion + 1), out sufijo))
            {
                return codigo.Substring(0, indiceUltimoGuion).Trim();
            }
        }

        return codigo;
    }

    private static IDictionary<string, List<ListaVerificacionOperacionalEaeItem>> ConstruirMapaRespuestasOficialPanel(IEnumerable<ListaVerificacionOperacionalEaeItem> items)
    {
        return (items ?? Enumerable.Empty<ListaVerificacionOperacionalEaeItem>())
            .Where(item => item != null)
            .GroupBy(ObtenerCodigoPreguntaOficialPanel, StringComparer.OrdinalIgnoreCase)
            .Where(group => !string.IsNullOrWhiteSpace(group.Key))
            .ToDictionary(group => group.Key, group => group.OrderBy(item => item.Orden).ToList(), StringComparer.OrdinalIgnoreCase);
    }

    private static IList<ListaVerificacionOperacionalEaeItem> ObtenerItemsFilaOficialPanel(IDictionary<string, List<ListaVerificacionOperacionalEaeItem>> respuestasPorCodigo, string codigoPregunta, IEnumerable<int> indices)
    {
        List<ListaVerificacionOperacionalEaeItem> respuestas;
        if (respuestasPorCodigo == null
            || string.IsNullOrWhiteSpace(codigoPregunta)
            || !respuestasPorCodigo.TryGetValue(codigoPregunta, out respuestas)
            || respuestas == null)
        {
            return new List<ListaVerificacionOperacionalEaeItem>();
        }

        return (indices ?? Enumerable.Empty<int>())
            .Where(indice => indice >= 0 && indice < respuestas.Count)
            .Select(indice => respuestas[indice])
            .Where(item => item != null)
            .ToList();
    }

    private static IList<string> ObtenerCodigosRequisitoOficialPanel(IDictionary<string, List<ListaVerificacionOperacionalEaeItem>> respuestasPorCodigo, string codigoPregunta)
    {
        List<ListaVerificacionOperacionalEaeItem> respuestas;
        if (respuestasPorCodigo == null
            || string.IsNullOrWhiteSpace(codigoPregunta)
            || !respuestasPorCodigo.TryGetValue(codigoPregunta, out respuestas)
            || respuestas == null)
        {
            return new List<string>();
        }

        return respuestas
            .Where(item => item != null && !item.EsNotaOrientacion && !string.IsNullOrWhiteSpace(item.Codigo))
            .Select(item => item.Codigo.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private static IList<string> ObtenerCodigosFilaOficialPanel(IDictionary<string, List<ListaVerificacionOperacionalEaeItem>> respuestasPorCodigo, string codigoPregunta, IEnumerable<int> indices)
    {
        return ObtenerItemsFilaOficialPanel(respuestasPorCodigo, codigoPregunta, indices)
            .Where(item => item != null && !item.EsNotaOrientacion && !string.IsNullOrWhiteSpace(item.Codigo))
            .Select(item => item.Codigo.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private static string ObtenerEstadoCumplimientoOficialPanel(IDictionary<string, List<ListaVerificacionOperacionalEaeItem>> respuestasPorCodigo, string codigoPregunta)
    {
        List<ListaVerificacionOperacionalEaeItem> respuestas;
        if (respuestasPorCodigo == null
            || string.IsNullOrWhiteSpace(codigoPregunta)
            || !respuestasPorCodigo.TryGetValue(codigoPregunta, out respuestas)
            || respuestas == null)
        {
            return string.Empty;
        }

        return respuestas
            .Where(item => item != null && !item.EsNotaOrientacion)
            .Select(item => (item.EstadoCumplimiento ?? string.Empty).Trim())
            .FirstOrDefault(valor => !string.IsNullOrWhiteSpace(valor)) ?? string.Empty;
    }

    private static string ObtenerEstadoImplementacionOficialPanel(IDictionary<string, List<ListaVerificacionOperacionalEaeItem>> respuestasPorCodigo, string codigoPregunta, IEnumerable<int> indices)
    {
        return ObtenerItemsFilaOficialPanel(respuestasPorCodigo, codigoPregunta, indices)
            .Where(item => item != null && !item.EsNotaOrientacion)
            .Select(item => (item.EstadoImplementacion ?? string.Empty).Trim())
            .FirstOrDefault(valor => !string.IsNullOrWhiteSpace(valor)) ?? string.Empty;
    }

    private static string ObtenerComentariosOficialPanel(IDictionary<string, List<ListaVerificacionOperacionalEaeItem>> respuestasPorCodigo, string codigoPregunta, IEnumerable<int> indices)
    {
        return ObtenerItemsFilaOficialPanel(respuestasPorCodigo, codigoPregunta, indices)
            .Where(item => item != null && !item.EsNotaOrientacion)
            .Select(item => (item.PruebasNotasComentarios ?? string.Empty).Trim())
            .FirstOrDefault(valor => !string.IsNullOrWhiteSpace(valor)) ?? string.Empty;
    }

