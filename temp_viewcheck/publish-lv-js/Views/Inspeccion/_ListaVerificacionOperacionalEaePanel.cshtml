@{
    var vm = Model ?? new ListaVerificacionOperacionalEaePanelVm();
    var solicitud = vm.Solicitud ?? new SolicitudAOCR();
    var lista = vm.ListaVerificacion ?? new ListaVerificacionOperacionalEae();
    var items = (lista.Items ?? new List<ListaVerificacionOperacionalEaeItem>()).OrderBy(item => item.Orden).ToList();
    var respuestasPorCodigoOficial = ConstruirMapaRespuestasOficialPanel(items);
    var filasOficiales = ObtenerFilasOficialesPanel();
    var tieneLv = lista.CodigoListaVerificacion > 0 || items.Any(item => !string.IsNullOrWhiteSpace(item.EstadoCumplimiento) || !string.IsNullOrWhiteSpace(item.EstadoImplementacion) || !string.IsNullOrWhiteSpace(item.PruebasNotasComentarios));
    var tienePdf = !string.IsNullOrWhiteSpace(vm.UrlVisualizacion);
    var firmada = vm.EstaFirmada || (lista.Finalizado && lista.FirmadoTecnico);
    var finalizada = lista.Finalizado;
    var estado = (lista.EstadoLista ?? "LV_BORRADOR").ToUpperInvariant();
    var operadorArchivoLv = PdfFileNameHelper.PrimerValorNoVacio(
        lista.NombreEae,
        PdfFileNameHelper.CombinarSegmentos(solicitud.Ruc, solicitud.NombreOperador),
        PdfFileNameHelper.CombinarSegmentos(solicitud.Ruc, solicitud.NombreComercial),
        PdfFileNameHelper.CombinarSegmentos(solicitud.Ruc, solicitud.RazonSocial),
        solicitud.NombreOperador,
        solicitud.NombreComercial,
        solicitud.RazonSocial,
        solicitud.Ruc);
    var nombreArchivoLvPdf = vm.CodigoInspeccion > 0
        ? PdfFileNameHelper.CrearNombreListaVerificacionEae(operadorArchivoLv, vm.CodigoInspeccion, lista.FechaFirma ?? lista.FechaFinalizacion ?? lista.UpdatedAt ?? lista.FechaLista ?? lista.CreatedAt)
        : string.Empty;

    string estadoLabel;
    string estadoClass;
    switch (estado)
    {
        case "LV_FIRMADA":
        case "FIRMADA":
            estadoLabel = "LV firmada";
            estadoClass = "success";
            break;
        case "LV_COMPLETADA":
        case "FINALIZADA":
        case "COMPLETA":
            estadoLabel = "LV completada";
            estadoClass = "primary";
            break;
        default:
            estadoLabel = tieneLv ? "LV borrador" : "Sin LV";
            estadoClass = tieneLv ? "secondary" : "warning";
            break;
    }
}

