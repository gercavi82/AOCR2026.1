        <div class="section-heading">
            <div class="section-icon">
                <i class="fas fa-clipboard-check"></i>
            </div>
            <div>
                <h2 class="section-title">LISTA DE VERIFICACIÓN OPERACIONAL (LV)</h2>
                <p class="section-copy">Evaluación técnica de un explotador de servicios aéreos extranjero (EAE) - RDAC 129</p>
            </div>
        </div>

        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-3">
            <div>
                <span class="badge bg-@estadoClass">@estadoLabel</span>
                <span class="ms-2 text-muted">Resultado general: <strong>@(string.IsNullOrWhiteSpace(lista.ResultadoGeneral) ? "PENDIENTE" : lista.ResultadoGeneral)</strong></span>
            </div>
            <div class="d-flex flex-column flex-md-row gap-2">
                @if (tienePdf)
                {
                    <a class="btn btn-outline-primary" href="@vm.UrlVisualizacion" target="_blank" rel="noopener">
                        <i class="fas fa-file-pdf me-1"></i> Vista previa LV
                    </a>
                    <a class="btn btn-outline-secondary" href="@vm.UrlDescarga" target="_blank" rel="noopener">
                        <i class="fas fa-download me-1"></i> Descargar LV
                    </a>
                }
            </div>
        </div>

        @if (!tieneLv)
        {
            <div class="alert alert-warning alert-inline mb-3">
                Antes de generar el informe técnico debe completar la Lista de Verificación Operacional (LV).
            </div>
        }
        else if (firmada)
        {
            <div class="alert alert-success alert-inline mb-3">
                La Lista de Verificación Operacional ya fue firmada. Ahora puede generar el informe técnico.
                Flujo simplificado activo: LV firmada + informe técnico firmado por técnico / inspector.
            </div>
        }
        else if (finalizada)
        {
            <div class="alert alert-info alert-inline mb-3">
                La Lista de Verificación Operacional fue completada correctamente. Proceda con la firma del técnico / inspector.
            </div>
        }
        else
        {
            <div class="alert alert-warning alert-inline mb-3">
                Informe técnico bloqueado. Primero complete y firme la Lista de Verificación Operacional (LV).
            </div>
        }

        @if (finalizada && !firmada && vm.PuedeFirmar)
        {
            <div class="card mt-4 border-0 bg-light mb-3" data-lv-signature-section="true">
                <div class="card-body">
                    <h5 class="mb-3"><i class="fas fa-signature me-2"></i>Firma del técnico / inspector responsable de la LV</h5>
                    @using (Html.BeginForm("FirmarListaVerificacionOperacionalEae", "Inspeccion", FormMethod.Post, new { enctype = "multipart/form-data", data_lv_signature_form = "true" }))
                    {
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@vm.CodigoInspeccion" />
                        <input type="hidden" name="codigoInspeccion" value="@vm.CodigoInspeccion" />

                        <div class="row g-3">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Certificado digital (.p12 / .pfx)</label>
                                <input type="file" name="CertificadoInspector" class="form-control" accept=".p12,.pfx" required="required" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Contrasena del certificado</label>
                                <input type="password" name="passwordCertificado" class="form-control" autocomplete="off" required="required" />
                            </div>
                        </div>
                        <div class="lv-signature-actions">
                            <button type="submit" class="btn btn-success">
                                <i class="fas fa-shield-alt me-1"></i> Firmar Lista de Verificacion LV
                            </button>
                        </div>
                    }
                </div>
            </div>
        }

        @if (tienePdf)
        {
            @Html.Partial("~/Views/Shared/_AocrPdfViewer.cshtml", new AocrPdfViewerViewModel
            {
                PdfUrl = vm.UrlVisualizacion,
                DescargarUrl = vm.UrlDescarga,
                Titulo = "Lista de Verificación Operacional (LV)",
                Subtitulo = nombreArchivoLvPdf,
                EstadoDocumento = lista.EstadoLista ?? "LV_BORRADOR",
                MensajeAyuda = firmada ? "LV firmada por el técnico / inspector responsable." : "Revise el PDF generado antes de aplicar la firma digital.",
                PermitirDescarga = true,
                PermitirImpresion = true,
                MostrarToolbar = true,
                ContenedorId = "viewerListaVerificacionOperacionalEae",
                PantallaCompleta = false
            })
        }
        else if (finalizada || firmada)
        {
            <div class="alert alert-warning alert-inline mb-3">
                El registro de la LV/EAE existe, pero el PDF asociado no está disponible en el servidor. Debe regenerarse o volver a finalizarse antes de abrir la vista previa.
            </div>
        }

        @if (!vm.PuedeEditar && !firmada)
        {
            <div class="alert alert-warning alert-inline mb-3">
                @(!string.IsNullOrWhiteSpace(vm.MensajeBloqueoEdicion)
                    ? vm.MensajeBloqueoEdicion
                    : "La lista de verificación operacional se encuentra disponible solo en modo consulta para su rol o en el estado actual del trámite.")
            </div>

            <div class="d-flex flex-column flex-md-row gap-2 mb-3">
                <div class="w-100">
                    @Html.Partial("_DocumentoWorkflowActions", vm.AccesosDocumentales)
                </div>

                @if (vm.PuedeConfirmarRevisionDocumental)
                {
                    using (Html.BeginForm("ConfirmarRevisionDocumentalInspector", "Inspeccion", FormMethod.Post, new { @class = "mb-0" }))
                    {
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@vm.CodigoInspeccion" />
                        <button type="submit" class="btn btn-warning">
                            <i class="fas fa-check-double me-1"></i> Confirmar cierre documental
                        </button>
                    }
                }
            </div>

            <div class="alert alert-light alert-inline mb-3">
                Cuando la revisión documental esté confirmada, esta misma ventana mostrará la cabecera completa de la LV/EAE, la tabla de criterios y los botones para guardar, finalizar o firmar.
            </div>
        }

        @if (vm.PuedeEditar && !firmada)
        {
            using (Html.BeginForm("GuardarListaVerificacionOperacionalEae", "Inspeccion", FormMethod.Post, new { @class = "mt-4", novalidate = "novalidate" }))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@vm.CodigoInspeccion" />
                <input type="hidden" name="codigoInspeccion" value="@vm.CodigoInspeccion" />
                <input type="hidden" name="lvSubmitAction" value="guardar" />
                <div class="alert alert-warning alert-inline lv-validation-message d-none mb-3" data-lv-validation-message="true" role="alert"></div>

                <div class="lv-hidden-sync-fields" style="display:none;">
                    @foreach (var itemSync in items.Where(item => item != null && !item.EsNotaOrientacion && !string.IsNullOrWhiteSpace(item.Codigo)))
                    {
                        <input type="hidden" class="lv-server-field" data-item-code="@itemSync.Codigo" data-field="cumplimiento" name="@("lvItem_" + itemSync.Codigo + "_cumplimiento")" value="@(itemSync.EstadoCumplimiento ?? string.Empty)" />
                        <input type="hidden" class="lv-server-field" data-item-code="@itemSync.Codigo" data-field="implementacion" name="@("lvItem_" + itemSync.Codigo + "_implementacion")" value="@(itemSync.EstadoImplementacion ?? string.Empty)" />
                        <input type="hidden" class="lv-server-field" data-item-code="@itemSync.Codigo" data-field="comentarios" name="@("lvItem_" + itemSync.Codigo + "_comentarios")" value="@(itemSync.PruebasNotasComentarios ?? string.Empty)" />
                    }
                </div>

                <div class="aocr-lv-document-header">
                    <div class="aocr-lv-official-header">
                        <div class="aocr-lv-official-top">Parte II - Explotadores de servicios aéreos</div>
                        <div class="aocr-lv-official-center">Volumen VII – Vigilancia de explotadores extranjeros en operaciones de transporte aéreo comercial<br />Capítulo 2 – Solicitud, evaluación y aprobación de un explotador extranjero</div>
                        <div class="aocr-lv-official-bottom">Manual del Inspector de Operaciones Ecuador</div>
                    </div>
                    <div class="aocr-lv-title-box-main">DIRECCIÓN GENERAL DE AVIACIÓN CIVIL</div>
                    <div class="aocr-lv-title-box-sub">Evaluación técnica de un explotador de servicios aéreos extranjero (EAE)<br />RDAC 129</div>
                    <div class="aocr-lv-field-stack mb-3">
                        <div class="aocr-lv-field-row first">
                            <label class="aocr-lv-field-label" for="lvNombreEae">1. Nombre del EAE / Nombre comercial del EAE:</label>
                            <input id="lvNombreEae" class="aocr-lv-field-input" name="lvNombreEae" value="@(lista.NombreEae ?? string.Empty)" required="required" />
                        </div>
                        <div class="aocr-lv-field-row">
                            <label class="aocr-lv-field-label" for="lvNumeroAocFechaValidez">2. N° AOC / Fecha de expedición / Validez:</label>
                            <input id="lvNumeroAocFechaValidez" class="aocr-lv-field-input" name="lvNumeroAocFechaValidez" value="@(lista.NumeroAocFechaValidez ?? string.Empty)" required="required" />
                        </div>
                        <div class="aocr-lv-field-row">
                            <label class="aocr-lv-field-label" for="lvDireccionEstadoExplotador">3. Dirección del EAE y datos de contacto de la gerencia de operaciones en el Estado del explotador:</label>
                            <textarea id="lvDireccionEstadoExplotador" class="aocr-lv-field-textarea" name="lvDireccionEstadoExplotador" rows="2" required="required">@(lista.DireccionEstadoExplotador ?? string.Empty)</textarea>
                        </div>
                        <div class="aocr-lv-field-row">
                            <label class="aocr-lv-field-label" for="lvDireccionEstadoReconocimiento">4. Dirección del EAE y datos de contacto en el Estado que emite el reconocimiento:</label>
                            <textarea id="lvDireccionEstadoReconocimiento" class="aocr-lv-field-textarea" name="lvDireccionEstadoReconocimiento" rows="2" required="required">@(lista.DireccionEstadoReconocimiento ?? string.Empty)</textarea>
                        </div>
                        <div class="aocr-lv-field-row">
                            <label class="aocr-lv-field-label" for="lvTiposAeronaves">5. Tipo/s de aeronave/s (marca, modelo, número de serie):</label>
                            <textarea id="lvTiposAeronaves" class="aocr-lv-field-textarea" name="lvTiposAeronaves" rows="2" required="required">@(lista.TiposAeronaves ?? string.Empty)</textarea>
                        </div>
                        <div class="aocr-lv-field-row">
                            <label class="aocr-lv-field-label" for="lvTipoOperacion">6. Tipo de operación:</label>
                            <input id="lvTipoOperacion" class="aocr-lv-field-input" name="lvTipoOperacion" value="@(lista.TipoOperacion ?? string.Empty)" required="required" />
                        </div>
                        <div class="aocr-lv-field-row">
                            <label class="aocr-lv-field-label" for="lvFecha">7. Fecha:</label>
                            <input id="lvFecha" class="aocr-lv-field-date" type="date" name="lvFecha" value="@(lista.FechaLista.HasValue ? lista.FechaLista.Value.ToString("yyyy-MM-dd") : DateTime.Now.ToString("yyyy-MM-dd"))" required="required" />
                        </div>
                        <div class="aocr-lv-field-row">
                            <label class="aocr-lv-field-label" for="lvInspectorResponsable">8. Inspector responsable de la aprobación:</label>
                            <input id="lvInspectorResponsable" class="aocr-lv-field-input" name="lvInspectorResponsable" value="@(lista.InspectorResponsable ?? string.Empty)" required="required" />
                        </div>
                    </div>
                    <input type="hidden" name="lvCargoInspector" value="@(string.IsNullOrWhiteSpace(lista.CargoInspector) ? "Tecnico / Inspector responsable" : lista.CargoInspector)" />
                </div>

                <div class="aocr-lv-scroll-container">
                    <table class="lv-operacional-table aocr-lv-table aocr-lv-eae-table">
                        <colgroup>
                            <col class="aocr-lv-col-ref" />
                            <col class="aocr-lv-col-pregunta" />
                            <col class="aocr-lv-col-cumplimiento" />
                            <col class="aocr-lv-col-orientacion" />
                            <col class="aocr-lv-col-implementacion" />
                            <col class="aocr-lv-col-comentarios" />
                        </colgroup>
                        <thead>
                            <tr>
                                <th><span class="aocr-lv-th-number">9.</span>Referencia</th>
                                <th><span class="aocr-lv-th-number">10.</span>Pregunta del requisito</th>
                                <th><span class="aocr-lv-th-number">11.</span>Estado de cumplimiento del requisito</th>
                                <th><span class="aocr-lv-th-number">12.</span>Orientación para el examen de pruebas o evidencias</th>
                                <th><span class="aocr-lv-th-number">13.</span>Estado de implementación</th>
                                <th><span class="aocr-lv-th-number">14.</span>Pruebas / Notas / Comentarios</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var fila in filasOficiales)
                            {
                                var codigosRequisito = fila.ShowCompliance
                                    ? ObtenerCodigosRequisitoOficialPanel(respuestasPorCodigoOficial, fila.RequirementCode)
                                    : new List<string>();
                                var codigosFila = ObtenerCodigosFilaOficialPanel(respuestasPorCodigoOficial, fila.RequirementCode, fila.ResponseIndices);
                                var estadoCumplimiento = fila.ShowCompliance
                                    ? ObtenerEstadoCumplimientoOficialPanel(respuestasPorCodigoOficial, fila.RequirementCode)
                                    : string.Empty;
                                var estadoImplementacion = fila.ShowImplementation
                                    ? ObtenerEstadoImplementacionOficialPanel(respuestasPorCodigoOficial, fila.RequirementCode, fila.ResponseIndices)
                                    : string.Empty;
                                var comentariosFila = codigosFila.Any()
                                    ? ObtenerComentariosOficialPanel(respuestasPorCodigoOficial, fila.RequirementCode, fila.ResponseIndices)
                                    : string.Empty;
                                var targetRequisito = string.Join("|", codigosRequisito);
                                var targetFila = string.Join("|", codigosFila);
                                var etiquetaFila = (fila.RequirementCode + " - " + (fila.OrientationLines.FirstOrDefault() != null ? fila.OrientationLines.First().Texto : string.Empty)).Trim();
                                if (etiquetaFila.Length > 160)
                                {
                                    etiquetaFila = etiquetaFila.Substring(0, 157).TrimEnd() + "...";
                                }
                                <tr class="lv-official-edit-row" data-lv-requirement-code="@fila.RequirementCode" data-lv-row-key="@fila.RowKey">
                                    <td class="aocr-lv-col-ref @(fila.ReferenceLines.Any() ? string.Empty : "lv-empty-cell")" data-column-label="Referencia">
                                        @if (fila.ReferenceLines.Any())
                                        {
                                            foreach (var lineaReferencia in fila.ReferenceLines)
                                            {
                                                <div class="@(string.IsNullOrWhiteSpace(lineaReferencia.CssClass) ? null : lineaReferencia.CssClass)">@lineaReferencia.Texto</div>
                                            }
                                        }
                                        else
                                        {
                                            @Html.Raw("&nbsp;")
                                        }
                                    </td>
                                    <td class="aocr-lv-col-pregunta @(fila.QuestionLines.Any() ? string.Empty : "lv-empty-cell")" data-column-label="Pregunta del requisito">
                                        @if (fila.QuestionLines.Any())
                                        {
                                            foreach (var lineaPregunta in fila.QuestionLines)
                                            {
                                                <div class="@(string.IsNullOrWhiteSpace(lineaPregunta.CssClass) ? null : lineaPregunta.CssClass)">@lineaPregunta.Texto</div>
                                            }
                                        }
                                        else
                                        {
                                            @Html.Raw("&nbsp;")
                                        }
                                    </td>
                                    <td class="aocr-lv-col-cumplimiento @(fila.ShowCompliance ? string.Empty : "lv-empty-cell")" data-column-label="Estado de cumplimiento">
                                        @if (fila.ShowCompliance)
                                        {
                                            <div class="lv-check-group lv-visible-compliance-group" data-target-codes="@targetRequisito" data-requirement-code="@fila.RequirementCode">
                                                <label class="lv-choice">
                                                    <input type="radio" class="lv-visible-cumplimiento lv-toggle-radio" name="@("lvVisible_" + fila.RequirementCode + "_cumplimiento")" value="SATISFACTORIO" @(string.Equals(estadoCumplimiento, "SATISFACTORIO", StringComparison.OrdinalIgnoreCase) ? "checked=\"checked\"" : null) />
                                                    <span class="lv-choice-box" aria-hidden="true"></span>
                                                    <span class="lv-choice-text">Satisfactorio</span>
                                                </label>
                                                <label class="lv-choice">
                                                    <input type="radio" class="lv-visible-cumplimiento lv-toggle-radio" name="@("lvVisible_" + fila.RequirementCode + "_cumplimiento")" value="NO_SATISFACTORIO" @(string.Equals(estadoCumplimiento, "NO_SATISFACTORIO", StringComparison.OrdinalIgnoreCase) ? "checked=\"checked\"" : null) />
                                                    <span class="lv-choice-box" aria-hidden="true"></span>
                                                    <span class="lv-choice-text">No satisfactorio</span>
                                                </label>
                                                <label class="lv-choice">
                                                    <input type="radio" class="lv-visible-cumplimiento lv-toggle-radio" name="@("lvVisible_" + fila.RequirementCode + "_cumplimiento")" value="NO_APLICABLE" @(string.Equals(estadoCumplimiento, "NO_APLICABLE", StringComparison.OrdinalIgnoreCase) ? "checked=\"checked\"" : null) />
                                                    <span class="lv-choice-box" aria-hidden="true"></span>
                                                    <span class="lv-choice-text">No aplicable</span>
                                                </label>
                                            </div>
                                        }
                                        else
                                        {
                                            @Html.Raw("&nbsp;")
                                        }
                                    </td>
                                    <td class="aocr-lv-col-orientacion" data-column-label="Orientación para evidencias">
                                        <div class="lv-guidance-stack">
                                            @foreach (var lineaOrientacion in fila.OrientationLines)
                                            {
                                                <div class="lv-guidance-entry lv-guidance-text @(string.IsNullOrWhiteSpace(lineaOrientacion.CssClass) ? string.Empty : lineaOrientacion.CssClass)">@lineaOrientacion.Texto</div>
                                            }
                                        </div>
                                    </td>
                                    <td class="aocr-lv-col-implementacion @(fila.ShowImplementation ? string.Empty : "lv-empty-cell")" data-column-label="Estado de implementación">
                                        @if (fila.ShowImplementation)
                                        {
                                            <div class="lv-check-group lv-visible-implementation-group" data-target-codes="@targetFila" data-sync-key="@targetFila" data-row-label="@etiquetaFila">
                                                <label class="lv-choice">
                                                    <input type="radio" class="lv-visible-implementacion lv-toggle-radio" name="@("lvVisible_" + fila.RowKey + "_implementacion")" value="IMPLEMENTADO" @(string.Equals(estadoImplementacion, "IMPLEMENTADO", StringComparison.OrdinalIgnoreCase) ? "checked=\"checked\"" : null) />
                                                    <span class="lv-choice-box" aria-hidden="true"></span>
                                                    <span class="lv-choice-text">Implementado</span>
                                                </label>
                                                <label class="lv-choice">
                                                    <input type="radio" class="lv-visible-implementacion lv-toggle-radio" name="@("lvVisible_" + fila.RowKey + "_implementacion")" value="NO_IMPLEMENTADO" @(string.Equals(estadoImplementacion, "NO_IMPLEMENTADO", StringComparison.OrdinalIgnoreCase) ? "checked=\"checked\"" : null) />
                                                    <span class="lv-choice-box" aria-hidden="true"></span>
                                                    <span class="lv-choice-text">No implementado</span>
                                                </label>
                                                <label class="lv-choice">
                                                    <input type="radio" class="lv-visible-implementacion lv-toggle-radio" name="@("lvVisible_" + fila.RowKey + "_implementacion")" value="NO_APLICABLE" @(string.Equals(estadoImplementacion, "NO_APLICABLE", StringComparison.OrdinalIgnoreCase) ? "checked=\"checked\"" : null) />
                                                    <span class="lv-choice-box" aria-hidden="true"></span>
                                                    <span class="lv-choice-text">No aplicable</span>
                                                </label>
                                            </div>
                                        }
                                        else
                                        {
                                            @Html.Raw("&nbsp;")
                                        }
                                    </td>
                                    <td class="aocr-lv-col-comentarios @(codigosFila.Any() ? string.Empty : "lv-empty-cell")" data-column-label="Pruebas / Notas / Comentarios">
                                        @if (codigosFila.Any())
                                        {
                                            <textarea class="lv-visible-comentarios lv-observacion" data-target-codes="@targetFila" data-sync-key="@targetFila" data-row-label="@etiquetaFila" name="@("lvVisible_" + fila.RowKey + "_comentarios")" rows="4">@comentariosFila</textarea>
                                        }
                                        else
                                        {
                                            @Html.Raw("&nbsp;")
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="d-flex flex-column flex-md-row gap-2 mt-3 lv-operacional-actions aocr-lv-actions">
                    <button type="submit" class="btn btn-outline-primary" data-lv-submit-action="guardar">
                        <i class="fas fa-save me-1"></i> Guardar LV
                    </button>
                    <button type="submit" class="btn btn-primary" name="finalizar" value="true" data-lv-submit-action="finalizar">
                        <i class="fas fa-file-pdf me-1"></i> Finalizar LV
                    </button>
                </div>
            }
        }

        </div>
    </div>
</div>

<script>
(function () {
    function parseCodes(value) {
        return (value || '')
            .split('|')
            .map(function (item) { return item.trim(); })
            .filter(function (item) { return item.length > 0; });
    }

    function setHiddenValue(form, code, field, value) {
        if (!form || !code || !field) {
            return;
        }

        var selector = '.lv-server-field[data-item-code="' + code + '"][data-field="' + field + '"]';
        var input = form.querySelector(selector);
        if (input) {
            input.value = value || '';
        }
    }

    function setSubmitAction(form, action) {
        if (!form || !form.elements || !form.elements['lvSubmitAction']) {
            return;
        }

        form.elements['lvSubmitAction'].value = action || 'guardar';
    }

    function clearValidationTarget(form) {
        if (!form) {
            return;
        }

        var highlighted = form.querySelectorAll('.lv-missing-target');
        for (var index = 0; index < highlighted.length; index++) {
            highlighted[index].classList.remove('lv-missing-target');
            highlighted[index].removeAttribute('data-lv-missing-cue');
        }
    }

    function showFloatingValidationNotice(message) {
        if (!message) {
            return;
        }

        if (window.Site && typeof window.Site.notify === 'function') {
            try {
                window.Site.notify(message, 'warning');
                return;
            } catch (error) {
            }
        }

        if (window.toastr && typeof window.toastr.warning === 'function') {
            window.toastr.warning(message);
            return;
        }

        if (window.Swal && typeof window.Swal.fire === 'function') {
            window.Swal.fire({
                icon: 'warning',
                title: message,
                toast: true,
                position: 'top-end',
                showConfirmButton: false,
                timer: 3500
            });
            return;
        }

        window.alert(message);
    }

    function normalizeValidationLabel(text) {
        return (text || '')
            .replace(/\s+/g, ' ')
            .replace(/^\d+\.\s*/, '')
            .replace(/\s*:\s*$/, '')
            .trim();
    }

    function truncateValidationCueText(text, maxLength) {
        var normalized = normalizeValidationLabel(text);
        var limit = typeof maxLength === 'number' && maxLength > 0 ? maxLength : 72;
        if (normalized.length <= limit) {
            return normalized;
        }

        return normalized.substring(0, limit - 3).trimEnd() + '...';
    }

    function getHeaderFieldLabel(field) {
        if (!field) {
            return 'este campo';
        }

        var scope = field.form || document;
        var label = field.id
            ? scope.querySelector('label[for="' + escapeAttributeValue(field.id) + '"]')
            : null;
        var labelText = label ? normalizeValidationLabel(label.textContent) : '';
        if (labelText) {
            return labelText;
        }

        return normalizeValidationLabel(field.getAttribute('aria-label') || field.getAttribute('placeholder') || field.name || 'este campo');
    }

    function getValidationCueText(target) {
        if (!target || !target.classList) {
            return 'Complete aqui';
        }

        if (target.classList.contains('lv-visible-cumplimiento')) {
            return 'Seleccione cumplimiento aqui';
        }

        if (target.classList.contains('lv-visible-implementacion')) {
            return 'Seleccione implementación aquí';
        }

        if (target.classList.contains('lv-visible-comentarios')) {
            return 'Complete la observación aquí';
        }

        return 'Complete ' + truncateValidationCueText(getHeaderFieldLabel(target), 68);
    }

    function getMissingHeaderField(form) {
        if (!form) {
            return null;
        }

        var requiredFields = form.querySelectorAll('input[required], textarea[required], select[required]');
        for (var index = 0; index < requiredFields.length; index++) {
            var field = requiredFields[index];
            if (!field || field.disabled || field.type === 'hidden') {
                continue;
            }

            if (field.type === 'checkbox' && !field.checked) {
                return field;
            }

            if (field.type === 'radio') {
                if (field.name && !form.querySelector('input[type="radio"][name="' + escapeAttributeValue(field.name) + '"]:checked')) {
                    return field;
                }
                continue;
            }

            if (!field.value || !field.value.trim()) {
                return field;
            }
        }

        return null;
    }

    function getValidationDisplayTarget(target) {
        if (!target) {
            return null;
        }

        if (target.classList && target.classList.contains('lv-visible-cumplimiento')) {
            return target.closest('.lv-check-group') || target.closest('.aocr-lv-col-cumplimiento') || target.closest('.lv-official-edit-row') || target;
        }

        if (target.classList && target.classList.contains('lv-visible-implementacion')) {
            return target.closest('.lv-check-group') || target.closest('.aocr-lv-col-implementacion') || target.closest('.lv-official-edit-row') || target;
        }

        if (target.classList && target.classList.contains('lv-visible-comentarios')) {
            return target.closest('.aocr-lv-col-comentarios') || target.closest('.lv-official-edit-row') || target;
        }

        return target.closest('.aocr-lv-field-row') || target.closest('.lv-official-edit-row') || target;
    }

    function scrollAndHighlightValidationTarget(form, target) {
        var displayTarget = getValidationDisplayTarget(target);
        if (!displayTarget) {
            return;
        }

        clearValidationTarget(form);
        displayTarget.classList.add('lv-missing-target');
        displayTarget.setAttribute('data-lv-missing-cue', getValidationCueText(target));

        if (typeof displayTarget.scrollIntoView === 'function') {
            displayTarget.scrollIntoView({ behavior: 'smooth', block: 'center', inline: 'nearest' });
        }
    }

    function focusValidationTarget(target) {
        if (!target || typeof target.focus !== 'function') {
            return;
        }

        try {
            target.focus({ preventScroll: true });
        } catch (error) {
            target.focus();
        }
    }

    function reportValidationAtField(target, message) {
        if (!target
            || target.type === 'radio'
            || typeof target.setCustomValidity !== 'function'
            || typeof target.reportValidity !== 'function') {
            return false;
        }

        target.setCustomValidity(message || 'Campo requerido.');
        target.reportValidity();
        target.setCustomValidity('');
        return true;
    }

    function clearValidationMessage(form) {
        if (!form) {
            return;
        }

        clearValidationTarget(form);

        var box = form.querySelector('[data-lv-validation-message="true"]');
        if (!box) {
            return;
        }

        box.textContent = '';
        box.classList.add('d-none');
    }

    function showValidationMessage(form, message, focusTarget) {
        if (!form) {
            return false;
        }

        var box = form.querySelector('[data-lv-validation-message="true"]');
        if (box) {
            box.textContent = message;
            box.classList.remove('d-none');
        }

        showFloatingValidationNotice(message);

        if (focusTarget) {
            scrollAndHighlightValidationTarget(form, focusTarget);
            focusValidationTarget(focusTarget);
            reportValidationAtField(focusTarget, message);
        } else if (box && typeof box.scrollIntoView === 'function') {
            box.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }

        return false;
    }

    function escapeAttributeValue(value) {
        return (value || '').replace(/\\/g, '\\\\').replace(/"/g, '\\"');
    }

    function obtenerCumplimientoSeleccionado(form, requirementCode) {
        if (!form || !requirementCode) {
            return null;
        }

        var selector = '.lv-visible-compliance-group[data-requirement-code="' + escapeAttributeValue(requirementCode) + '"]';
        var group = form.querySelector(selector);
        return group ? group.querySelector('.lv-visible-cumplimiento:checked') : null;
    }

    function obtenerComentariosRequisito(form, requirementCode) {
        if (!form || !requirementCode) {
            return [];
        }

        var selector = '.lv-official-edit-row[data-lv-requirement-code="' + escapeAttributeValue(requirementCode) + '"] .lv-visible-comentarios';
        return Array.prototype.slice.call(form.querySelectorAll(selector));
    }

    function requisitoTieneComentario(form, requirementCode) {
        var comentarios = obtenerComentariosRequisito(form, requirementCode);
        for (var index = 0; index < comentarios.length; index++) {
            if (comentarios[index].value && comentarios[index].value.trim()) {
                return true;
            }
        }

        return false;
    }

    function bindToggleableRadio(radio) {
        if (!radio || radio.getAttribute('data-lv-toggle-bound') === 'true') {
            return;
        }

        radio.setAttribute('data-lv-toggle-bound', 'true');

        var rememberState = function () {
            radio.setAttribute('data-lv-was-checked', radio.checked ? 'true' : 'false');
        };

        radio.addEventListener('pointerdown', rememberState);
        radio.addEventListener('keydown', function (event) {
            if (event.key === ' ' || event.key === 'Spacebar' || event.key === 'Enter') {
                rememberState();
            }
        });

        radio.addEventListener('click', function () {
            if (radio.getAttribute('data-lv-was-checked') !== 'true') {
                return;
            }

            radio.checked = false;
            radio.setAttribute('data-lv-was-checked', 'false');
            radio.dispatchEvent(new Event('change', { bubbles: true }));
        });
    }

    function syncComplianceGroup(form, group) {
        if (!form || !group) {
            return;
        }

        var selected = group.querySelector('.lv-visible-cumplimiento:checked');
        var value = selected ? selected.value : '';
        parseCodes(group.getAttribute('data-target-codes')).forEach(function (code) {
            setHiddenValue(form, code, 'cumplimiento', value);
        });
    }

    function syncImplementationGroup(form, group) {
        if (!form || !group) {
            return;
        }

        var selected = group.querySelector('.lv-visible-implementacion:checked');
        var value = selected ? selected.value : '';
        parseCodes(group.getAttribute('data-target-codes')).forEach(function (code) {
            setHiddenValue(form, code, 'implementacion', value);
        });
    }

    function syncCommentsField(form, field) {
        if (!form || !field) {
            return;
        }

        var value = field.value || '';
        parseCodes(field.getAttribute('data-target-codes')).forEach(function (code) {
            setHiddenValue(form, code, 'comentarios', value);
        });
    }

    function mirrorImplementationRows(form, source) {
        if (!form || !source) {
            return;
        }

        var syncKey = source.getAttribute('data-sync-key') || '';
        if (!syncKey) {
            return;
        }

        var selected = source.querySelector('.lv-visible-implementacion:checked');
        var selectedValue = selected ? selected.value : '';
        var groups = form.querySelectorAll('.lv-visible-implementation-group[data-sync-key="' + syncKey + '"]');
        for (var i = 0; i < groups.length; i++) {
            var group = groups[i];
            if (group === source) {
                continue;
            }

            var radios = group.querySelectorAll('.lv-visible-implementacion');
            for (var j = 0; j < radios.length; j++) {
                radios[j].checked = radios[j].value === selectedValue && !!selectedValue;
            }
        }
    }

    function mirrorCommentsFields(form, source) {
        if (!form || !source) {
            return;
        }

        var syncKey = source.getAttribute('data-sync-key') || '';
        if (!syncKey) {
            return;
        }

        var fields = form.querySelectorAll('.lv-visible-comentarios[data-sync-key="' + syncKey + '"]');
        for (var i = 0; i < fields.length; i++) {
            if (fields[i] !== source) {
                fields[i].value = source.value;
            }
        }
    }

    function sincronizarCamposLvEae(form) {
        if (!form) {
            return;
        }

        var complianceGroups = form.querySelectorAll('.lv-visible-compliance-group');
        for (var i = 0; i < complianceGroups.length; i++) {
            syncComplianceGroup(form, complianceGroups[i]);
        }

        var implementationGroups = form.querySelectorAll('.lv-visible-implementation-group');
        for (var j = 0; j < implementationGroups.length; j++) {
            syncImplementationGroup(form, implementationGroups[j]);
        }

        var commentsFields = form.querySelectorAll('.lv-visible-comentarios');
        for (var k = 0; k < commentsFields.length; k++) {
            syncCommentsField(form, commentsFields[k]);
        }
    }

    window.validarComentariosLvEae = function (form, requiereConfirmacion) {
        if (!form) {
            return true;
        }

        clearValidationMessage(form);
        sincronizarCamposLvEae(form);

        if (!requiereConfirmacion) {
            return true;
        }

        var missingHeaderField = getMissingHeaderField(form);
        if (missingHeaderField) {
            return showValidationMessage(form, 'Falta completar el campo "' + getHeaderFieldLabel(missingHeaderField) + '" antes de finalizar la LV/EAE.', missingHeaderField);
        }

        var implementationGroups = form.querySelectorAll('.lv-visible-implementation-group');
        for (var i = 0; i < implementationGroups.length; i++) {
            var implementationGroup = implementationGroups[i];
            var row = implementationGroup.closest('.lv-official-edit-row');
            if (!row) {
                continue;
            }

            var requirementCode = row.getAttribute('data-lv-requirement-code') || '';
            var rowLabel = implementationGroup.getAttribute('data-row-label') || requirementCode || ('fila ' + (i + 1));
            var complianceSelected = obtenerCumplimientoSeleccionado(form, requirementCode);
            var implementationSelected = implementationGroup.querySelector('.lv-visible-implementacion:checked');
            var commentField = row.querySelector('.lv-visible-comentarios');
            var commentValue = commentField && commentField.value ? commentField.value.trim() : '';

            if ((!complianceSelected || !implementationSelected) && !commentValue) {
                var focusTarget = commentField || implementationGroup.querySelector('.lv-visible-implementacion') || (obtenerCumplimientoSeleccionado(form, requirementCode) ? null : form.querySelector('.lv-visible-compliance-group[data-requirement-code="' + escapeAttributeValue(requirementCode) + '"] .lv-visible-cumplimiento'));
                return showValidationMessage(form, 'Debe seleccionar el estado de cumplimiento/implementación o registrar una observación en la columna 14 para ' + rowLabel + '.', focusTarget);
            }

            if (implementationSelected && implementationSelected.value === 'NO_IMPLEMENTADO' && !commentValue) {
                return showValidationMessage(form, 'Debe registrar una observación en la columna 14 para ' + rowLabel + ' cuando el estado de implementación sea No implementado.', commentField || implementationGroup.querySelector('.lv-visible-implementacion'));
            }
        }

        var complianceGroups = form.querySelectorAll('.lv-visible-compliance-group');
        for (var j = 0; j < complianceGroups.length; j++) {
            var complianceGroup = complianceGroups[j];
            var complianceSelected = complianceGroup.querySelector('.lv-visible-cumplimiento:checked');
            var requirementCode = complianceGroup.getAttribute('data-requirement-code') || ('requisito ' + (j + 1));
            if (complianceSelected && complianceSelected.value === 'NO_SATISFACTORIO' && !requisitoTieneComentario(form, requirementCode)) {
                var requirementRows = obtenerComentariosRequisito(form, requirementCode);
                return showValidationMessage(form, 'Debe registrar una observación en la columna 14 para el requisito ' + requirementCode + ' cuando el estado de cumplimiento sea No satisfactorio.', requirementRows.length > 0 ? requirementRows[0] : complianceGroup.querySelector('.lv-visible-cumplimiento'));
            }
        }

        clearValidationMessage(form);
        return !requiereConfirmacion || confirm('Confirma que desea finalizar la Lista de Verificacion Operacional (LV) y generar el PDF?');
    };

    var forms = document.querySelectorAll('#bloqueListaVerificacionOperacionalEae form[action*="GuardarListaVerificacionOperacionalEae"]');
    for (var formIndex = 0; formIndex < forms.length; formIndex++) {
        var form = forms[formIndex];
        if (form.getAttribute('data-lv-sync-bound') === 'true') {
            continue;
        }

        form.setAttribute('data-lv-sync-bound', 'true');

        var submitButtons = form.querySelectorAll('[data-lv-submit-action]');
        for (var buttonIndex = 0; buttonIndex < submitButtons.length; buttonIndex++) {
            submitButtons[buttonIndex].addEventListener('click', function () {
                var action = this.getAttribute('data-lv-submit-action') || 'guardar';
                form.setAttribute('data-lv-last-action', action);
                setSubmitAction(form, action);
            });
        }

        form.addEventListener('pointerdown', function (event) {
            if (!event.target || !event.target.closest) {
                return;
            }

            var choice = event.target.closest('.lv-choice');
            var radio = choice
                ? choice.querySelector('.lv-toggle-radio')
                : (event.target.matches('.lv-toggle-radio') ? event.target : null);

            if (radio) {
                radio.setAttribute('data-lv-was-checked', radio.checked ? 'true' : 'false');
            }
        });

        form.addEventListener('submit', function (event) {
            var submitter = event && event.submitter ? event.submitter : null;
            var action = submitter && submitter.getAttribute('data-lv-submit-action')
                ? submitter.getAttribute('data-lv-submit-action')
                : (form.getAttribute('data-lv-last-action') || (form.elements['lvSubmitAction'] ? form.elements['lvSubmitAction'].value : 'guardar') || 'guardar');

            setSubmitAction(this, action);
            if (!window.validarComentariosLvEae(this, action === 'finalizar')) {
                event.preventDefault();
            }
        });

        var toggleRadios = form.querySelectorAll('.lv-toggle-radio');
        for (var radioIndex = 0; radioIndex < toggleRadios.length; radioIndex++) {
            bindToggleableRadio(toggleRadios[radioIndex]);
        }

        var complianceRadios = form.querySelectorAll('.lv-visible-cumplimiento');
        for (var c = 0; c < complianceRadios.length; c++) {
            complianceRadios[c].addEventListener('change', function () {
                clearValidationMessage(form);
                var group = this.closest('.lv-visible-compliance-group');
                syncComplianceGroup(form, group);
            });
        }

        var implementationRadios = form.querySelectorAll('.lv-visible-implementacion');
        for (var r = 0; r < implementationRadios.length; r++) {
            implementationRadios[r].addEventListener('change', function () {
                clearValidationMessage(form);
                var group = this.closest('.lv-visible-implementation-group');
                mirrorImplementationRows(form, group);
                syncImplementationGroup(form, group);
            });
        }

        var commentFields = form.querySelectorAll('.lv-visible-comentarios');
        for (var t = 0; t < commentFields.length; t++) {
            commentFields[t].addEventListener('input', function () {
                clearValidationMessage(form);
                mirrorCommentsFields(form, this);
                syncCommentsField(form, this);
            });
        }

        var requiredHeaderFields = form.querySelectorAll('input[required], textarea[required], select[required]');
        for (var h = 0; h < requiredHeaderFields.length; h++) {
            requiredHeaderFields[h].addEventListener('input', function () {
                clearValidationMessage(form);
            });

            requiredHeaderFields[h].addEventListener('change', function () {
                clearValidationMessage(form);
            });
        }

        sincronizarCamposLvEae(form);
    }
})();
</script>
