@inherits System.Web.Mvc.WebViewPage<List<CapaPresentacion.Models.OrdenValidacionFinancieraVM>>
@using CapaDatos.Constants
@using CapaModelo
@using CapaNegocio.Services
@using System.Linq
@using System.Web.Mvc
@using System.Web.Mvc.Html

@{
    ViewBag.Title = "Dashboard Financiero";
    var as400FacturacionHabilitada = FacturacionAS400Service.IsEnabled();
    var registros = Model ?? new List<CapaPresentacion.Models.OrdenValidacionFinancieraVM>();

    Func<string, string> normalizarEstado = estado =>
    {
        var actual = EstadoOrden.NormalizarEstado(estado);
        return actual == EstadoOrden.Pendiente || actual == EstadoOrden.Generada
            ? EstadoOrden.Generada
            : actual;
    };

    Func<string, string> textoEstado = estado =>
    {
        switch (normalizarEstado(estado))
        {
            case EstadoOrden.Generada:
                return "GENERADA";
            case EstadoOrden.Enviada:
                return "ENVIADA";
            case EstadoOrden.EnRevisionFinanciera:
                return "EN REVISION FINANCIERA";
            case EstadoOrden.Devuelta:
                return "DEVUELTA";
            case EstadoOrden.Facturada:
                return "FACTURADA";
            case EstadoOrden.Completada:
                return "COMPLETADA";
            case EstadoOrden.Pagada:
                return "PAGADA";
            case EstadoOrden.Anulada:
                return "ANULADA";
            case EstadoOrden.Borrador:
                return "BORRADOR";
            default:
                return normalizarEstado(estado);
        }
    };

    var totalOrdenes = registros.Count;
    var montoTotal = registros.Sum(x => x != null && x.Orden != null ? x.Orden.Total : 0m);
    var generadas = registros.Count(x =>
    {
        var estado = x != null && x.Orden != null ? normalizarEstado(x.Orden.Estado) : string.Empty;
        return estado == EstadoOrden.Generada;
    });
    var enRevision = registros.Count(x =>
    {
        var estado = x != null && x.Orden != null ? normalizarEstado(x.Orden.Estado) : string.Empty;
        return estado == EstadoOrden.EnRevisionFinanciera;
    });
    var devueltas = registros.Count(x =>
    {
        var estado = x != null && x.Orden != null ? normalizarEstado(x.Orden.Estado) : string.Empty;
        return estado == EstadoOrden.Devuelta;
    });
    var facturadas = registros.Count(x =>
    {
        var estado = x != null && x.Orden != null ? normalizarEstado(x.Orden.Estado) : string.Empty;
        return estado == EstadoOrden.Facturada;
    });
    var completadas = registros.Count(x =>
    {
        var estado = x != null && x.Orden != null ? normalizarEstado(x.Orden.Estado) : string.Empty;
        return estado == EstadoOrden.Completada;
    });
    var anuladas = registros.Count(x =>
    {
        var estado = x != null && x.Orden != null ? normalizarEstado(x.Orden.Estado) : string.Empty;
        return estado == EstadoOrden.Anulada;
    });

    var fr3Ok = registros.Count(x => !string.IsNullOrWhiteSpace(x != null ? x.Fr3Numero : null));
    var fr3Error = registros.Count(x => string.Equals(x != null ? x.Fr3Estado : null, "FR3_ERROR", StringComparison.OrdinalIgnoreCase));
    var fr3Pendiente = totalOrdenes - fr3Ok - fr3Error;
    if (fr3Pendiente < 0)
    {
        fr3Pendiente = 0;
    }

    var porcentajeFr3Ok = totalOrdenes > 0 ? Math.Round((decimal)fr3Ok * 100m / totalOrdenes, 0) : 0m;
    var porcentajeCompletadas = totalOrdenes > 0 ? Math.Round((decimal)completadas * 100m / totalOrdenes, 0) : 0m;

    var companias = registros
        .Where(x => x != null && x.Orden != null)
        .GroupBy(x => !string.IsNullOrWhiteSpace(x.Orden.NombreContribuyente) ? x.Orden.NombreContribuyente : (x.Orden.Compania ?? "Sin compañía"))
        .Select(g => new
        {
            Nombre = g.Key,
            Cantidad = g.Count(),
            Monto = g.Sum(item => item.Orden.Total)
        })
        .OrderByDescending(x => x.Monto)
        .Take(5)
        .ToList();

    var recientes = registros
        .Where(x => x != null && x.Orden != null)
        .OrderByDescending(x => x.Orden.FechaCreacion)
        .Take(5)
        .ToList();
}

<style>
    .fin-dashboard {
        --fin-bg: linear-gradient(180deg, #f4f6f8 0%, #e8edf1 100%);
        --fin-panel: #ffffff;
        --fin-border: rgba(12, 37, 54, 0.08);
        --fin-text: #173042;
        --fin-muted: #748491;
        --fin-accent: #53b7cf;
        --fin-accent-2: #9fcb52;
        --fin-accent-3: #f2c94c;
        --fin-accent-4: #f38b63;
        --fin-accent-5: #d98dc5;
        --fin-shadow: 0 14px 34px rgba(24, 44, 62, 0.08);
        background: var(--fin-bg);
        border: 1px solid var(--fin-border);
        border-radius: 24px;
        padding: 24px;
        color: var(--fin-text);
    }

    .fin-dashboard-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 16px;
        margin-bottom: 18px;
    }

    .fin-dashboard-title {
        margin: 0;
        font-size: 1.9rem;
        font-weight: 800;
        letter-spacing: -0.03em;
    }

    .fin-dashboard-subtitle {
        margin: 6px 0 0;
        color: var(--fin-muted);
        font-size: 0.98rem;
    }

    .fin-dashboard-actions {
        display: flex;
        gap: 10px;
        align-items: center;
        flex-wrap: wrap;
    }

    .fin-filters {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
        margin-bottom: 18px;
    }

    .fin-filter-form {
        display: flex;
        gap: 10px;
        align-items: center;
        flex-wrap: wrap;
    }

    .fin-kpi-grid,
    .fin-chart-grid {
        display: grid;
        gap: 14px;
        margin-bottom: 14px;
    }

    .fin-kpi-grid {
        grid-template-columns: 0.95fr 1.45fr 1.45fr 0.95fr;
    }

    .fin-chart-grid {
        grid-template-columns: 0.95fr 1.45fr 1.45fr 0.95fr;
    }

    .fin-card {
        background: var(--fin-panel);
        border-radius: 18px;
        border: 1px solid var(--fin-border);
        box-shadow: var(--fin-shadow);
        padding: 18px;
        position: relative;
        overflow: hidden;
    }

    .fin-card.tall {
        min-height: 206px;
    }

    .fin-metric-label {
        color: var(--fin-muted);
        font-size: 0.78rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.08em;
    }

    .fin-metric-value {
        margin-top: 10px;
        font-size: 2rem;
        line-height: 1;
        font-weight: 800;
    }

    .fin-metric-sub {
        margin-top: 10px;
        color: var(--fin-muted);
        font-size: 0.85rem;
    }

    .fin-stat-accent {
        position: absolute;
        inset: auto -20px -30px auto;
        width: 92px;
        height: 92px;
        border-radius: 50%;
        opacity: 0.12;
        background: currentColor;
    }

    .fin-metric-positive { color: #79b93d; }
    .fin-metric-info { color: #53b7cf; }
    .fin-metric-warn { color: #f2c94c; }
    .fin-metric-danger { color: #f38b63; }
    .fin-metric-soft { color: #d98dc5; }

    .fin-ring-wrap {
        display: flex;
        gap: 18px;
        align-items: center;
        min-height: 170px;
    }

    .fin-ring {
        --size: 132px;
        --thickness: 16px;
        width: var(--size);
        height: var(--size);
        border-radius: 50%;
        background: conic-gradient(var(--ring-color, #53b7cf) calc(var(--ring-percent, 0) * 1%), #eaf0f4 0);
        display: grid;
        place-items: center;
        flex-shrink: 0;
    }

    .fin-ring::before {
        content: "";
        width: calc(var(--size) - var(--thickness) * 2);
        height: calc(var(--size) - var(--thickness) * 2);
        border-radius: 50%;
        background: #fff;
        box-shadow: inset 0 0 0 1px rgba(12, 37, 54, 0.05);
    }

    .fin-ring-center {
        position: absolute;
        text-align: center;
    }

    .fin-ring-center strong {
        display: block;
        font-size: 1.7rem;
        line-height: 1;
    }

    .fin-ring-center span {
        display: block;
        margin-top: 6px;
        color: var(--fin-muted);
        font-size: 0.78rem;
    }

    .fin-legend {
        list-style: none;
        margin: 0;
        padding: 0;
        width: 100%;
    }

    .fin-legend li {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        padding: 7px 0;
        border-bottom: 1px solid rgba(12, 37, 54, 0.06);
        font-size: 0.88rem;
    }

    .fin-legend li:last-child {
        border-bottom: 0;
    }

    .fin-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        display: inline-block;
        margin-right: 8px;
        flex-shrink: 0;
    }

    .fin-bars {
        display: flex;
        align-items: end;
        justify-content: space-between;
        gap: 10px;
        min-height: 132px;
        margin-top: 12px;
    }

    .fin-bar-item {
        flex: 1;
        text-align: center;
    }

    .fin-bar-stack {
        height: 120px;
        display: flex;
        align-items: end;
        justify-content: center;
        gap: 5px;
    }

    .fin-bar {
        width: 12px;
        border-radius: 10px 10px 0 0;
        min-height: 8px;
    }

    .fin-bar-generadas { background: #f2c94c; }
    .fin-bar-revision { background: #53b7cf; }
    .fin-bar-devueltas { background: #f38b63; }
    .fin-bar-facturadas { background: #9fcb52; }

    .fin-bar-label {
        display: block;
        margin-top: 8px;
        color: var(--fin-muted);
        font-size: 0.78rem;
    }

    .fin-line-chart {
        position: relative;
        height: 155px;
        margin-top: 10px;
    }

    .fin-line-chart svg {
        width: 100%;
        height: 100%;
    }

    .fin-mini-note {
        display: flex;
        justify-content: space-between;
        color: var(--fin-muted);
        font-size: 0.78rem;
        margin-top: 8px;
    }

    .fin-list {
        list-style: none;
        margin: 14px 0 0;
        padding: 0;
    }

    .fin-list li {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        padding: 10px 0;
        border-bottom: 1px solid rgba(12, 37, 54, 0.06);
    }

    .fin-list li:last-child {
        border-bottom: 0;
    }

    .fin-list-title {
        font-weight: 700;
        font-size: 0.92rem;
    }

    .fin-list-sub {
        color: var(--fin-muted);
        font-size: 0.8rem;
    }

    .fin-table-card {
        margin-top: 18px;
        background: #fff;
        border-radius: 18px;
        border: 1px solid var(--fin-border);
        box-shadow: var(--fin-shadow);
        overflow: hidden;
    }

    .fin-table-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        padding: 16px 18px;
        border-bottom: 1px solid rgba(12, 37, 54, 0.07);
        background: linear-gradient(180deg, #fff 0%, #f7fafc 100%);
    }

    .fin-table-header h3 {
        margin: 0;
        font-size: 1rem;
        font-weight: 800;
    }

    .fin-chip {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        border-radius: 999px;
        padding: 6px 10px;
        font-size: 0.78rem;
        font-weight: 700;
        background: #eff5f7;
        color: #4a6778;
    }

    @@media (max-width: 1200px) {
        .fin-kpi-grid,
        .fin-chart-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 768px) {
        .fin-dashboard {
            padding: 16px;
            border-radius: 18px;
        }

        .fin-dashboard-header,
        .fin-ring-wrap,
        .fin-filters,
        .fin-table-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .fin-kpi-grid,
        .fin-chart-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="fin-dashboard">
    <div class="fin-dashboard-header">
        <div>
            <h2 class="fin-dashboard-title">Dashboard Financiero</h2>
            <p class="fin-dashboard-subtitle">Panel de control para validación de órdenes, seguimiento de facturación FR3 y estado operativo del área financiera.</p>
        </div>
        <div class="fin-dashboard-actions">
            <button type="button" class="btn btn-outline-secondary btn-sm" id="btnHealthPostgres">
                <i class="fas fa-database me-1"></i> Probar PostgreSQL/DB2
            </button>
            <span id="healthResult" class="text-muted small"></span>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-aocr alert-success mb-3"><i class="fas fa-check-circle me-1"></i> @TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-aocr alert-danger mb-3"><i class="fas fa-exclamation-circle me-1"></i> @TempData["Error"]</div>
    }
    @if (ViewBag.SinResultadosConFiltro == true)
    {
        <div class="alert alert-aocr alert-warning mb-3">
            <i class="fas fa-filter me-1"></i> No se encontraron órdenes con el estado seleccionado. Se muestran todas las órdenes disponibles (Total: @ViewBag.TotalSinFiltro).
        </div>
    }

    <div class="fin-filters">
        <div>
            <span class="fin-chip"><i class="fas fa-wave-square"></i> AS400 @(as400FacturacionHabilitada ? "habilitado" : "deshabilitado")</span>
            <span class="fin-chip"><i class="fas fa-layer-group"></i> @totalOrdenes órdenes visibles</span>
        </div>
        <form method="get" class="fin-filter-form">
            <label class="mb-0 aocr-field-label">Estado:</label>
            <select name="estado" class="form-select form-select-sm" onchange="this.form.submit()" style="min-width:180px;">
                <option value="EN_REVISION_FINANCIERA" @(ViewBag.EstadoFiltro == "EN_REVISION_FINANCIERA" ? "selected" : "")>En revision financiera</option>
                <option value="GENERADA" @(ViewBag.EstadoFiltro == "GENERADA" ? "selected" : "")>Generada</option>
                <option value="DEVUELTA" @(ViewBag.EstadoFiltro == "DEVUELTA" ? "selected" : "")>Devuelta</option>
                <option value="FACTURADA" @(ViewBag.EstadoFiltro == "FACTURADA" ? "selected" : "")>Facturada</option>
                <option value="COMPLETADA" @(ViewBag.EstadoFiltro == "COMPLETADA" ? "selected" : "")>Completada</option>
                <option value="ANULADA" @(ViewBag.EstadoFiltro == "ANULADA" ? "selected" : "")>Anulada</option>
                <option value="TODAS" @(ViewBag.EstadoFiltro == "TODAS" ? "selected" : "")>Todas</option>
            </select>
        </form>
    </div>

    <div class="fin-kpi-grid">
        <div class="fin-card fin-metric-info">
            <div class="fin-metric-label">Órdenes Totales</div>
            <div class="fin-metric-value">@totalOrdenes</div>
            <div class="fin-metric-sub">Volumen operativo actual del tablero.</div>
            <span class="fin-stat-accent"></span>
        </div>

        <div class="fin-card tall">
            <div class="fin-metric-label">Monto Consolidado</div>
            <div class="fin-ring-wrap" style="position:relative;">
                <div class="fin-ring" style="--ring-percent:@porcentajeCompletadas; --ring-color:#9fcb52;"></div>
                <div class="fin-ring-center">
                    <strong>@montoTotal.ToString("N2")</strong>
                    <span>Total USD</span>
                </div>
                <ul class="fin-legend">
                    <li><span><span class="fin-dot" style="background:#9fcb52;"></span>Completadas</span><strong>@completadas</strong></li>
                    <li><span><span class="fin-dot" style="background:#53b7cf;"></span>Facturadas</span><strong>@facturadas</strong></li>
                    <li><span><span class="fin-dot" style="background:#f2c94c;"></span>En revisión</span><strong>@enRevision</strong></li>
                    <li><span><span class="fin-dot" style="background:#f38b63;"></span>Devueltas</span><strong>@devueltas</strong></li>
                </ul>
            </div>
        </div>

        <div class="fin-card tall">
            <div class="fin-metric-label">Cumplimiento FR3</div>
            <div class="fin-ring-wrap" style="position:relative;">
                <div class="fin-ring" style="--ring-percent:@porcentajeFr3Ok; --ring-color:#34b44a;"></div>
                <div class="fin-ring-center">
                    <strong>@fr3Ok</strong>
                    <span>FR3 emitidos</span>
                </div>
                <ul class="fin-legend">
                    <li><span><span class="fin-dot" style="background:#34b44a;"></span>Emitidos</span><strong>@fr3Ok</strong></li>
                    <li><span><span class="fin-dot" style="background:#f2c94c;"></span>Pendientes</span><strong>@fr3Pendiente</strong></li>
                    <li><span><span class="fin-dot" style="background:#f05a4f;"></span>Error</span><strong>@fr3Error</strong></li>
                </ul>
            </div>
        </div>

        <div class="fin-card fin-metric-soft">
            <div class="fin-metric-label">Rendimiento</div>
            <div class="fin-metric-value">@porcentajeFr3Ok%</div>
            <div class="fin-metric-sub">Cobertura de FR3 sobre las órdenes visibles.</div>
            <span class="fin-stat-accent"></span>
        </div>
    </div>

    <div class="fin-chart-grid">
        <div class="fin-card">
            <div class="fin-metric-label">Estados Clave</div>
            <div class="fin-metric-value">@enRevision</div>
            <div class="fin-metric-sub">Órdenes que requieren gestión o revisión.</div>
            <ul class="fin-list">
                <li><div><div class="fin-list-title">Generadas</div><div class="fin-list-sub">Ordenes emitidas pendientes de pago</div></div><strong>@generadas</strong></li>
                <li><div><div class="fin-list-title">En revision financiera</div><div class="fin-list-sub">Carga activa del equipo</div></div><strong>@enRevision</strong></li>
                <li><div><div class="fin-list-title">Devueltas al RT</div><div class="fin-list-sub">Requieren correccion y reenvio</div></div><strong>@devueltas</strong></li>
                <li><div><div class="fin-list-title">Anuladas</div><div class="fin-list-sub">Casos cerrados por reverso</div></div><strong>@anuladas</strong></li>
            </ul>
        </div>

        <div class="fin-card">
            <div class="d-flex justify-content-between align-items-center">
                <div class="fin-metric-label">Distribución por Estado</div>
                <strong class="small text-muted">@totalOrdenes total</strong>
            </div>
            @{
                var alturaGeneradas = Math.Max(12, totalOrdenes > 0 ? (int)Math.Round((decimal)generadas * 100m / totalOrdenes) : 0);
                var alturaRevision = Math.Max(12, totalOrdenes > 0 ? (int)Math.Round((decimal)enRevision * 100m / totalOrdenes) : 0);
                var alturaDevueltas = Math.Max(12, totalOrdenes > 0 ? (int)Math.Round((decimal)devueltas * 100m / totalOrdenes) : 0);
                var alturaFacturadas = Math.Max(12, totalOrdenes > 0 ? (int)Math.Round((decimal)facturadas * 100m / totalOrdenes) : 0);
            }
            <div class="fin-bars">
                <div class="fin-bar-item">
                    <div class="fin-bar-stack"><div class="fin-bar fin-bar-generadas" data-height="@alturaGeneradas"></div></div>
                    <span class="fin-bar-label">Generadas</span>
                </div>
                <div class="fin-bar-item">
                    <div class="fin-bar-stack"><div class="fin-bar fin-bar-revision" data-height="@alturaRevision"></div></div>
                    <span class="fin-bar-label">Revision</span>
                </div>
                <div class="fin-bar-item">
                    <div class="fin-bar-stack"><div class="fin-bar fin-bar-devueltas" data-height="@alturaDevueltas"></div></div>
                    <span class="fin-bar-label">Devueltas</span>
                </div>
                <div class="fin-bar-item">
                    <div class="fin-bar-stack"><div class="fin-bar fin-bar-facturadas" data-height="@alturaFacturadas"></div></div>
                    <span class="fin-bar-label">Facturadas</span>
                </div>
            </div>
        </div>

        <div class="fin-card">
            <div class="fin-metric-label">Tendencia Operativa</div>
            <div class="fin-line-chart">
                <svg viewBox="0 0 300 150" preserveAspectRatio="none" aria-hidden="true">
                    <line x1="0" y1="128" x2="300" y2="128" stroke="#e8edf1" stroke-width="2"></line>
                    <polyline fill="none" stroke="#53b7cf" stroke-width="4" points="10,112 55,108 95,62 135,100 175,88 215,42 255,52 290,16"></polyline>
                    <circle cx="95" cy="62" r="5" fill="#53b7cf"></circle>
                    <circle cx="215" cy="42" r="5" fill="#53b7cf"></circle>
                    <circle cx="290" cy="16" r="5" fill="#53b7cf"></circle>
                </svg>
            </div>
            <div class="fin-mini-note"><span>Inicio</span><span>Pico actual de actividad</span></div>
        </div>

        <div class="fin-card">
            <div class="fin-metric-label">Salud del Flujo</div>
            <div class="fin-ring-wrap" style="position:relative; justify-content:center;">
                <div class="fin-ring" style="--ring-percent:@porcentajeCompletadas; --ring-color:#d98dc5;"></div>
                <div class="fin-ring-center">
                    <strong>@porcentajeCompletadas%</strong>
                    <span>Completadas</span>
                </div>
            </div>
        </div>
    </div>

    <div class="fin-chart-grid">
        <div class="fin-card">
            <div class="fin-metric-label">Top Compañías</div>
            <ul class="fin-list">
                @if (companias.Any())
                {
                    foreach (var compania in companias)
                    {
                        <li>
                            <div>
                                <div class="fin-list-title">@Html.Encode(compania.Nombre)</div>
                                <div class="fin-list-sub">@compania.Cantidad órdenes</div>
                            </div>
                            <strong>@compania.Monto.ToString("N2")</strong>
                        </li>
                    }
                }
                else
                {
                    <li>
                        <div>
                            <div class="fin-list-title">Sin datos</div>
                            <div class="fin-list-sub">No hay compañías para mostrar en este filtro.</div>
                        </div>
                    </li>
                }
            </ul>
        </div>

        <div class="fin-card" style="grid-column: span 3;">
            <div class="fin-metric-label">Actividad Reciente</div>
            <ul class="fin-list">
                @if (recientes.Any())
                {
                    foreach (var reciente in recientes)
                    {
                        var ordenReciente = reciente.Orden;
                        <li>
                            <div>
                                <div class="fin-list-title">@Html.Encode(ordenReciente.NumeroOrden)</div>
                                <div class="fin-list-sub">@Html.Encode(!string.IsNullOrWhiteSpace(ordenReciente.NombreContribuyente) ? ordenReciente.NombreContribuyente : ordenReciente.Compania) · @ordenReciente.FechaCreacion.ToString("dd/MM/yyyy")</div>
                            </div>
                            <div class="text-end">
                                <div class="fin-list-title">@ordenReciente.Total.ToString("N2")</div>
                                <div class="fin-list-sub">@Html.Encode(textoEstado(ordenReciente.Estado))</div>
                            </div>
                        </li>
                    }
                }
                else
                {
                    <li>
                        <div>
                            <div class="fin-list-title">Sin actividad reciente</div>
                            <div class="fin-list-sub">Aplique otro filtro o genere nuevas órdenes.</div>
                        </div>
                    </li>
                }
            </ul>
        </div>
    </div>

    <div class="fin-table-card">
        <div class="fin-table-header">
            <div>
                <h3>Gestión de órdenes</h3>
                <div class="text-muted small">Operación detallada para revisar, aprobar, rechazar o reintentar FR3.</div>
            </div>
            <span class="fin-chip"><i class="fas fa-table"></i> Vista operativa</span>
        </div>
        <div class="aocr-table-container">
<table class="table table-dgac mb-0" id="tablaGestionOrdenes">
    <thead>
        <tr>
            <th>#</th>
            <th>Órden</th>
            <th>Compañía</th>
            <th>Fecha</th>
            <th>Monto</th>
            <th>Estado</th>
            <th>FR3</th>
            <th>Comprobante</th>
            <th class="text-center">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            int i = 1;
            foreach (var item in Model)
            {
                var orden = item.Orden;
                var pago = item.Pago;
                var estadoNorm = orden != null ? normalizarEstado(orden.Estado) : string.Empty;
                var puedeGestionarPorEstado = estadoNorm == EstadoOrden.EnRevisionFinanciera;
        <tr>
            <td>@Html.Encode(i)</td>
            <td>@Html.Encode(orden != null ? orden.NumeroOrden : "-")</td>
            <td>@Html.Encode(orden != null ? (orden.NombreContribuyente ?? orden.Compania) : "-")</td>
            <td>@Html.Encode(orden != null ? orden.FechaCreacion.ToString("dd/MM/yyyy") : "")</td>
            <td>@Html.Encode(orden != null ? orden.Total.ToString("N2") : "0.00")</td>
            <td>
                @if (orden != null)
                {
                    var badgeCss = "bg-secondary";
                    switch (estadoNorm)
                    {
                        case EstadoOrden.Completada:
                        case EstadoOrden.Pagada:
                            badgeCss = "bg-success";
                            break;
                        case EstadoOrden.Facturada:
                            badgeCss = "bg-info text-dark";
                            break;
                        case EstadoOrden.Anulada:
                            badgeCss = "bg-danger";
                            break;
                        case EstadoOrden.Devuelta:
                            badgeCss = "bg-danger";
                            break;
                        case EstadoOrden.EnRevisionFinanciera:
                            badgeCss = "bg-primary";
                            break;
                        case EstadoOrden.Enviada:
                            badgeCss = "bg-info text-dark";
                            break;
                        case EstadoOrden.Generada:
                            badgeCss = "bg-warning text-dark";
                            break;
                    }
                    <span class="badge @badgeCss">@Html.Encode(textoEstado(orden.Estado))</span>
                }
            </td>
            <td>
                @if (!string.IsNullOrWhiteSpace(item.Fr3Numero))
                {
                    <span class="badge bg-success">@Html.Encode(item.Fr3Numero)</span>
                }
                else if (!string.IsNullOrWhiteSpace(item.Fr3Estado))
                {
                    var cssFr3 = item.Fr3Estado.Equals("FR3_ERROR", StringComparison.OrdinalIgnoreCase) ? "bg-danger" : "bg-secondary";
                    <span class="badge @cssFr3">@Html.Encode(item.Fr3Estado)</span>
                    if (!string.IsNullOrWhiteSpace(item.Fr3Error))
                    {
                        var fr3ErrorDisplay = System.Web.HttpUtility.HtmlDecode(item.Fr3Error);
                        <div><small class="text-danger">@fr3ErrorDisplay</small></div>
                    }
                }
                else
                {
                    <span class="text-muted">Pendiente</span>
                }
            </td>
            <td>
                @if (orden != null)
                {
                    <a href="@Url.Action("DescargarPdf", "OrdenRecaudacion", new { id = orden.Id, vistaPrevia = true })"
                       target="_blank"
                       class="btn btn-outline-secondary btn-sm btn-pdf"
                       title="Vista previa PDF de la orden">
                        <i class="fas fa-eye"></i>
                    </a>
                    <a href="@Url.Action("DescargarPdf", "OrdenRecaudacion", new { id = orden.Id })"
                       target="_blank"
                       class="btn btn-outline-success btn-sm btn-pdf"
                       title="Descargar PDF de la orden">
                        <i class="fas fa-download"></i>
                    </a>
                }
                else
                {
                    <span class="text-muted">Sin orden</span>
                }
            </td>
            <td class="acciones-cell">
                @if (orden != null)
                {
                    <div class="acciones-orden">
                        <a href="@Url.Action("Detalles", "OrdenRecaudacion", new { id = orden.Id })"
                           class="btn btn-outline-primary btn-sm btn-accion"
                           title="Ver detalles">
                            <i class="fas fa-eye"></i>
                        </a>

                        @if (puedeGestionarPorEstado)
                        {
                            <button type="button"
                                    class="btn btn-success btn-sm btn-accion js-abrir-modal-factura"
                                    title="Aprobar pago"
                                    data-orden-id="@orden.Id"
                                    data-pago-id="@(pago != null ? pago.CodigoPago.ToString() : string.Empty)"
                                    data-numero-orden="@Html.Encode(orden.NumeroOrden)"
                                    data-monto="@((orden.Total).ToString("0.00", System.Globalization.CultureInfo.InvariantCulture))">
                                <i class="fas fa-check"></i>
                            </button>

                            <button class="btn btn-danger btn-sm btn-accion js-abrir-modal-rechazo" type="button"
                                    title="Rechazar"
                                    data-orden-id="@orden.Id"
                                    data-numero-orden="@Html.Encode(orden.NumeroOrden)">
                                <i class="fas fa-times"></i>
                            </button>
                        }

                        @if (item.PuedeReintentarFr3)
                        {
                            <button type="button"
                                    class="btn btn-warning btn-sm btn-accion js-retry-fr3"
                                    title="Reintentar FR3"
                                    data-orden-id="@orden.Id">
                                <i class="fas fa-sync"></i>
                            </button>
                        }
                    </div>
                }
            </td>
        </tr>
                i++;
            }
        }
        else
        {
            <tr>
                <td colspan="9" class="text-center aocr-no-results">
                    <i class="fas fa-inbox" style="font-size:1.5rem;display:block;margin-bottom:0.4rem;opacity:0.4;"></i>
                    No hay registros para el estado seleccionado.
                </td>
            </tr>
        }
    </tbody>
</table>
</div>
    </div>
</div>


<div class="modal fade" id="modalRechazarOrden" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Devolver Orden</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="formRechazarOrden" method="post" action="@Url.Action("RechazarOrden", "Financiero")">
                @Html.AntiForgeryToken()
                <input type="hidden" id="rechazo_orden_id" name="id" />
                <div class="modal-body">
                    <div class="mb-3">
                        <small class="text-muted">Orden:</small>
                        <div><strong id="rechazo_numero_orden">-</strong></div>
                    </div>
                    <label class="form-label">Motivo de devolucion</label>
                    <textarea name="motivo" class="form-control" rows="3" required></textarea>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-danger"><i class="fas fa-times me-1"></i>Devolver</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="modalAprobarPagoFactura" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Aprobar y Enviar AS400</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <form id="formAprobarPagoFactura" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="factura_orden_id" name="ordenId" />
                <div class="modal-body">
                    <div class="mb-3">
                        <small class="text-muted">Orden:</small>
                        <div><strong id="factura_numero_orden">-</strong></div>
                    </div>
                    <div class="mb-3">
                        <small class="text-muted">Monto:</small>
                        <div><strong id="factura_monto_orden">-</strong></div>
                    </div>

                    <div id="facturaModalAlert" class="alert d-none" role="alert"></div>

                    <div class="alert alert-info py-2" role="alert">
                        <i class="fas fa-info-circle me-1"></i>
                        Se aprobara la orden y se enviara la facturacion FR3 al AS400 solo despues de validar el comprobante de pago.
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" id="btnAprobarConFactura" class="btn btn-success">
                        <i class="fas fa-paper-plane me-1"></i>Enviar AS400
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.4.2/css/buttons.bootstrap5.min.css" />
    <style>
        #tablaGestionOrdenes_wrapper .dt-buttons { margin-bottom: 0.5rem; }
        #tablaGestionOrdenes_wrapper .dataTables_filter { margin-bottom: 0.5rem; }
        .fin-table-card .dataTables_wrapper { padding: 12px 18px 18px; }
        .fin-table-card .dataTables_wrapper .table { margin-top: 0.5rem !important; }
    </style>
}

@section Scripts {
<script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js"></script>
<script src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js"></script>
<script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.html5.min.js"></script>
<script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.print.min.js"></script>
<script>
(function () {
    function applyBarHeights() {
        var bars = document.querySelectorAll('.fin-bar[data-height]');
        for (var i = 0; i < bars.length; i++) {
            var rawHeight = parseInt(bars[i].getAttribute('data-height'), 10);
            if (!isNaN(rawHeight) && rawHeight > 0) {
                bars[i].style.height = rawHeight + 'px';
            }
        }
    }

    applyBarHeights();

    // =============================================
    // DataTables — Gestión de órdenes
    // =============================================
    function initGestionOrdenesDT() {
        var $tabla = $('#tablaGestionOrdenes');
        if (!$tabla.length || !$.fn.DataTable) return;
        if ($.fn.DataTable.isDataTable($tabla)) return;

        $tabla.DataTable({
            language: {
                url: '@Url.Content("~/Content/plugins/datatables/i18n/Spanish.json")'
            },
            responsive: true,
            autoWidth: false,
            pageLength: 5,
            lengthMenu: [[5, 10, 25, 50, -1], [5, 10, 25, 50, 'Todos']],
            order: [[0, 'asc']],
            dom: "<'row'<'col-sm-12 col-md-6'B><'col-sm-12 col-md-6'f>>" +
                 "<'row'<'col-sm-12'tr>>" +
                 "<'row'<'col-sm-12 col-md-5'i><'col-sm-12 col-md-7'p>>",
            buttons: [
                {
                    extend: 'excelHtml5',
                    text: '<i class="fas fa-file-excel me-1"></i> Excel',
                    className: 'btn btn-sm btn-outline-success',
                    exportOptions: { columns: [0, 1, 2, 3, 4, 5, 6] }
                },
                {
                    extend: 'pdfHtml5',
                    text: '<i class="fas fa-file-pdf me-1"></i> PDF',
                    className: 'btn btn-sm btn-outline-danger',
                    orientation: 'landscape',
                    pageSize: 'A4',
                    exportOptions: { columns: [0, 1, 2, 3, 4, 5, 6] }
                },
                {
                    extend: 'print',
                    text: '<i class="fas fa-print me-1"></i> Imprimir',
                    className: 'btn btn-sm btn-outline-secondary',
                    exportOptions: { columns: [0, 1, 2, 3, 4, 5, 6] }
                },
                {
                    extend: 'copyHtml5',
                    text: '<i class="fas fa-copy me-1"></i> Copiar',
                    className: 'btn btn-sm btn-outline-info',
                    exportOptions: { columns: [0, 1, 2, 3, 4, 5, 6] }
                }
            ],
            columnDefs: [
                { orderable: false, searchable: false, targets: [7, 8] },
                { className: 'text-center', targets: [0, 7, 8] },
                { className: 'text-end', targets: [4] }
            ],
            drawCallback: function () {
                setTimeout(function () {
                    if ($.fn.tooltip) {
                        $('[data-bs-toggle="tooltip"]').tooltip();
                    }
                }, 50);
            }
        });
    }

    // Listen for layout's lazy DataTables load
    if (window.AOCR && window.AOCR.dataTablesLoaded) {
        initGestionOrdenesDT();
    } else {
        document.addEventListener('AOCR.DataTablesReady', initGestionOrdenesDT);
        // Fallback: if DataTables is already available
        $(function () {
            if ($.fn.DataTable) initGestionOrdenesDT();
        });
    }

    // =============================================
    // Modal Rechazar Orden (compartido)
    // =============================================
    var rechazoModalEl = document.getElementById('modalRechazarOrden');
    if (rechazoModalEl && window.bootstrap) {
        var rechazoModal = new bootstrap.Modal(rechazoModalEl);
        document.addEventListener('click', function (e) {
            var btn = e.target.closest('.js-abrir-modal-rechazo');
            if (!btn) return;
            e.preventDefault();
            document.getElementById('rechazo_orden_id').value = btn.getAttribute('data-orden-id') || '';
            document.getElementById('rechazo_numero_orden').textContent = btn.getAttribute('data-numero-orden') || '-';
            rechazoModalEl.querySelector('textarea[name="motivo"]').value = '';
            rechazoModal.show();
        });
    }

    // =============================================
    // Modal Aprobar + Enviar AS400
    // =============================================
    var modalElement = document.getElementById('modalAprobarPagoFactura');
    if (!modalElement || !window.bootstrap) {
        return;
    }

    var modal = new bootstrap.Modal(modalElement);
    var form = document.getElementById('formAprobarPagoFactura');
    var alertBox = document.getElementById('facturaModalAlert');
    var submitButton = document.getElementById('btnAprobarConFactura');
    var numeroOrdenLabel = document.getElementById('factura_numero_orden');
    var montoOrdenLabel = document.getElementById('factura_monto_orden');
    var inputOrdenId = document.getElementById('factura_orden_id');
    var tokenInput = form ? form.querySelector('input[name="__RequestVerificationToken"]') : null;
    var isSubmitting = false;

    if (!form || !alertBox || !submitButton) {
        return;
    }

    if (form.dataset.facturaSubmitBound === '1') {
        return;
    }
    form.dataset.facturaSubmitBound = '1';

    function showAlert(type, message) {
        alertBox.className = 'alert alert-' + type;
        alertBox.textContent = message;
        alertBox.classList.remove('d-none');
    }

    function clearAlert() {
        alertBox.className = 'alert d-none';
        alertBox.textContent = '';
    }

    function setSubmitting(val) {
        submitButton.disabled = val;
        submitButton.innerHTML = val
            ? '<i class="fas fa-spinner fa-spin me-1"></i>Procesando...'
            : '<i class="fas fa-paper-plane me-1"></i>Enviar AS400';
    }

    function setInFlight(value) {
        isSubmitting = value === true;
        setSubmitting(isSubmitting);
    }

    function getCsrfToken() {
        if (tokenInput && tokenInput.value) {
            return tokenInput.value;
        }

        var layoutTokenInput = document.querySelector('#__AjaxAntiForgeryForm input[name="__RequestVerificationToken"]');
        if (layoutTokenInput && layoutTokenInput.value) {
            return layoutTokenInput.value;
        }

        var anyTokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
        return anyTokenInput && anyTokenInput.value ? anyTokenInput.value : '';
    }

    function getCookieValue(name) {
        if (!name || !document.cookie) {
            return '';
        }

        var encodedName = encodeURIComponent(name) + '=';
        var rawCookies = document.cookie.split(';');
        for (var i = 0; i < rawCookies.length; i++) {
            var cookie = rawCookies[i].trim();
            if (cookie.indexOf(encodedName) === 0) {
                return decodeURIComponent(cookie.substring(encodedName.length));
            }
        }
        return '';
    }

    function getCsrfCookieToken() {
        var preferredNames = ['__AOCR_RequestVerificationToken', '__RequestVerificationToken'];
        for (var i = 0; i < preferredNames.length; i++) {
            var preferredValue = getCookieValue(preferredNames[i]);
            if (preferredValue) {
                return preferredValue;
            }
        }

        if (!document.cookie) {
            return '';
        }

        var rawCookies = document.cookie.split(';');
        for (var j = 0; j < rawCookies.length; j++) {
            var part = rawCookies[j].trim();
            var separator = part.indexOf('=');
            if (separator <= 0) {
                continue;
            }

            var key = decodeURIComponent(part.substring(0, separator));
            if (/RequestVerificationToken/i.test(key)) {
                return decodeURIComponent(part.substring(separator + 1));
            }
        }
        return '';
    }

    function buildAjaxHeaders(csrfToken) {
        var headers = {
            'X-Requested-With': 'XMLHttpRequest',
            'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
            'Accept': 'application/json, text/plain, */*'
        };

        if (!csrfToken) {
            return headers;
        }

        var cookieToken = getCsrfCookieToken();
        var headerToken = cookieToken ? (cookieToken + ':' + csrfToken) : csrfToken;
        headers['RequestVerificationToken'] = headerToken;
        headers['__RequestVerificationToken'] = csrfToken;
        return headers;
    }

    function buildFormBody(values) {
        var params = new URLSearchParams();
        Object.keys(values || {}).forEach(function (key) {
            params.append(key, values[key] == null ? '' : String(values[key]));
        });
        return params.toString();
    }

    function openModalFromButton(button) {
        var ordenId = button.getAttribute('data-orden-id') || '';
        var numeroOrden = button.getAttribute('data-numero-orden') || '-';
        var monto = button.getAttribute('data-monto') || '';

        form.reset();
        inputOrdenId.value = ordenId;
        numeroOrdenLabel.textContent = numeroOrden;
        montoOrdenLabel.textContent = monto ? ('$' + monto) : '-';

        clearAlert();
        setInFlight(false);
        modal.show();
    }

    if (!document.body.dataset.facturaModalClickBound) {
        document.body.dataset.facturaModalClickBound = '1';
        document.addEventListener('click', function (event) {
            var button = event.target.closest('.js-abrir-modal-factura');
            if (!button) {
                return;
            }

            if (isSubmitting) {
                return;
            }

            event.preventDefault();
            openModalFromButton(button);
        });
    }

    form.addEventListener('submit', function (event) {
        event.preventDefault();

        if (isSubmitting) {
            return;
        }

        clearAlert();
        setInFlight(true);
        var shouldUnlock = true;
        var ordenId = (inputOrdenId.value || '').trim();
        if (!/^\d+$/.test(ordenId)) {
            shouldUnlock = true;
            setInFlight(false);
            showAlert('danger', 'No se pudo identificar la orden. Cierre y vuelva a abrir el modal.');
            return;
        }

        var csrfToken = getCsrfToken();
        if (!csrfToken) {
            shouldUnlock = true;
            setInFlight(false);
            showAlert('danger', 'La sesion expiro. Recargue la pagina e intente nuevamente.');
            return;
        }

        var actionUrl = '@Url.Action("AprobarYEnviarAS400", "Financiero")';
        var body = buildFormBody({
            ordenId: ordenId,
            id: ordenId,
            __RequestVerificationToken: csrfToken
        });

        fetch(actionUrl, {
            method: 'POST',
            body: body,
            credentials: 'same-origin',
            headers: buildAjaxHeaders(csrfToken)
        })
        .then(function (response) {
            return response.text().then(function (text) {
                var payload = null;
                try {
                    payload = text ? JSON.parse(text) : null;
                } catch (e) {
                    payload = null;
                }
                return { response: response, payload: payload, rawText: text };
            });
        })
        .then(function (result) {
            var payload = result.payload || {};
            if (!result.response.ok || payload.ok !== true) {
                var errorMessage = payload.message || '';
                if (!errorMessage && result.rawText) {
                    errorMessage = result.rawText.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();
                }
                if (!errorMessage) {
                    errorMessage = 'Error al enviar a AS400 (HTTP ' + result.response.status + ').';
                }
                var httpError = new Error(errorMessage);
                httpError.httpStatus = result.response.status;
                throw httpError;
            }

            var finalMessage = payload.warning
                ? (payload.message + ' ' + payload.warning)
                : payload.message;
            showAlert('success', finalMessage || 'Enviado a AS400 correctamente.');
            shouldUnlock = false;

            setTimeout(function () {
                modal.hide();
                window.location.reload();
            }, 700);
        })
        .catch(function (error) {
            var message = error && error.message ? error.message : 'No se pudo completar la operación.';
            if (error && error.httpStatus === 400 && /bad request|antifals|forgery|token/i.test(message)) {
                showAlert('danger', 'La sesion o el token de seguridad expiraron. Se recargara la pagina para reintentar.');
                setTimeout(function () { window.location.reload(); }, 900);
                return;
            }
            showAlert('danger', message);
        })
        .finally(function () {
            if (shouldUnlock) {
                setInFlight(false);
            }
        });
    });

    document.addEventListener('click', function (event) {
        var retryButton = event.target.closest('.js-retry-fr3');
        if (!retryButton) {
            return;
        }

        event.preventDefault();
        var ordenId = retryButton.getAttribute('data-orden-id');
        if (!ordenId || !/^\d+$/.test(String(ordenId).trim())) {
            return;
        }

        if (!confirm('¿Reintentar generación FR3 para esta orden?')) {
            return;
        }

        retryButton.disabled = true;
        var csrfToken = getCsrfToken();
        if (!csrfToken) {
            retryButton.disabled = false;
            alert('La sesion expiro. Recargue la pagina e intente nuevamente.');
            return;
        }

        var body = buildFormBody({
            ordenId: String(ordenId).trim(),
            id: String(ordenId).trim(),
            __RequestVerificationToken: csrfToken
        });

        fetch('@Url.Action("ReintentarFr3", "Financiero")', {
            method: 'POST',
            body: body,
            credentials: 'same-origin',
            headers: buildAjaxHeaders(csrfToken)
        })
        .then(function (r) {
            return r.text().then(function (t) {
                try { return JSON.parse(t); } catch (e) { return { ok: false, message: t || 'Error no controlado.' }; }
            });
        })
        .then(function (payload) {
            if (!payload || payload.ok !== true) {
                throw new Error(payload && payload.message ? payload.message : 'No se pudo reintentar FR3.');
            }
            alert(payload.message || 'FR3 reintentado correctamente.');
            window.location.reload();
        })
        .catch(function (e) {
            alert(e && e.message ? e.message : 'Error al reintentar FR3.');
        })
        .finally(function () {
            retryButton.disabled = false;
        });
    });

    var btnHealth = document.getElementById('btnHealthPostgres');
    var healthResult = document.getElementById('healthResult');
    if (btnHealth && healthResult) {
        btnHealth.addEventListener('click', function () {
            btnHealth.disabled = true;
            healthResult.className = 'ms-2 text-muted';
            healthResult.textContent = 'Validando...';

            fetch('@Url.Action("HealthFinanciero", "Financiero")', { credentials: 'same-origin' })
                .then(function (r) { return r.json(); })
                .then(function (payload) {
                    if (payload && payload.ok) {
                        healthResult.className = 'ms-2 text-success';
                        healthResult.textContent = 'PostgreSQL y DB2: OK';
                    } else {
                        var db2Msg = payload && payload.db2 ? (payload.db2.message || 'DB2 no disponible') : 'Error de health check';
                        healthResult.className = 'ms-2 text-danger';
                        healthResult.textContent = 'Error: ' + db2Msg;
                    }
                })
                .catch(function () {
                    healthResult.className = 'ms-2 text-danger';
                    healthResult.textContent = 'No se pudo ejecutar health check.';
                })
                .finally(function () {
                    btnHealth.disabled = false;
                });
        });
    }
})();
</script>
}
