@model CapaModelo.RT.ViewModels.DesignacionUploadVM
@{
    Layout = "~/Views/Shared/_LayoutAOCR.cshtml";
    ViewBag.Title = "Designación RT";
    var estado = (Model.Estado ?? ViewBag.EstadoRt as string ?? "BORRADOR").Trim().ToUpperInvariant();
    var observacionCoordinador = (ViewBag.ObservacionCoordinadorRt as string ?? string.Empty).Trim();
    var tieneConstanciaRt = ViewBag.TieneConstanciaRt != null && (bool)ViewBag.TieneConstanciaRt;
    bool bloqueado = !(string.Equals(estado, "BORRADOR", System.StringComparison.OrdinalIgnoreCase)
        || string.Equals(estado, "DEVUELTO_CON_OBSERVACIONES", System.StringComparison.OrdinalIgnoreCase));
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">Designación RT Firmada</h4>
        </div>
        <div class="card-body">
            @if (TempData["Ok"] != null)
            {
                <div class="alert alert-success">@TempData["Ok"]</div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">@TempData["Error"]</div>
            }

            @if (string.Equals(estado, "ENVIADO", System.StringComparison.OrdinalIgnoreCase)
                || string.Equals(estado, "EN_REVISION_COORDINADOR", System.StringComparison.OrdinalIgnoreCase))
            {
                <div class="alert alert-info">
                    La solicitud ya fue enviada y está en revisión por Coordinador.
                </div>
            }
            else if (string.Equals(estado, "DEVUELTO_CON_OBSERVACIONES", System.StringComparison.OrdinalIgnoreCase))
            {
                <div class="alert alert-warning">
                    <strong>Solicitud devuelta.</strong>
                    @if (!string.IsNullOrWhiteSpace(observacionCoordinador))
                    {
                        <span> Observación de coordinación: @observacionCoordinador</span>
                    }
                </div>
            }
            else if (string.Equals(estado, "FINALIZADO", System.StringComparison.OrdinalIgnoreCase)
                || string.Equals(estado, "FIRMADO", System.StringComparison.OrdinalIgnoreCase)
                || string.Equals(estado, "APROBADO", System.StringComparison.OrdinalIgnoreCase))
            {
                <div class="alert alert-success d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-2">
                    <div>La solicitud RT fue aprobada y el expediente ya está finalizado.</div>
                    @if (tieneConstanciaRt)
                    {
                        <a class="btn btn-outline-success btn-sm" href="@Url.Action("DescargarConstancia", "RT")">
                            Descargar constancia
                        </a>
                    }
                </div>
            }

            @using (Html.BeginForm("SubirDesignacion", "RT", FormMethod.Post, new { enctype = "multipart/form-data" }))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.SolicitudId)
                @Html.HiddenFor(m => m.Estado)

                <div class="mb-3">
                    <label class="form-label">PDF de declaración firmada</label>
                    if (bloqueado)
                    {
                        @Html.TextBoxFor(m => m.ArchivoPdf, new { type = "file", @class = "form-control", accept = ".pdf", disabled = "disabled" })
                    }
                    else
                    {
                        @Html.TextBoxFor(m => m.ArchivoPdf, new { type = "file", @class = "form-control", accept = ".pdf" })
                    }
                    @Html.ValidationMessageFor(m => m.ArchivoPdf, "", new { @class = "text-danger" })
                    <small class="text-muted">Suba el PDF descargado y firmado. Solo PDF. Tamaño máximo configurable.</small>
                </div>

                if (!string.IsNullOrWhiteSpace(Model.NombreArchivoActual))
                {
                    <div class="alert alert-secondary">
                        Documento actual: <strong>@Model.NombreArchivoActual</strong>
                    </div>
                }

                <div class="d-flex justify-content-between">
                    <span class="badge bg-secondary">Estado: @estado</span>
                    if (bloqueado)
                    {
                        <button type="submit" class="btn btn-outline-primary" disabled="disabled">
                            Subir PDF
                        </button>
                    }
                    else
                    {
                        <button type="submit" class="btn btn-outline-primary">
                            Subir PDF
                        </button>
                    }
                </div>
            }

            <hr />

            @using (Html.BeginForm("Enviar", "RT", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.SolicitudId)
                if (bloqueado)
                {
                    <button type="submit" class="btn btn-success" disabled="disabled">
                        Enviar solicitud
                    </button>
                }
                else
                {
                    <button type="submit" class="btn btn-success">
                        Enviar solicitud
                    </button>
                }
            }
        </div>
    </div>
</div>
