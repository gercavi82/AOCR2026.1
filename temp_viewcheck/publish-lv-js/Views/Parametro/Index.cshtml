@inherits System.Web.Mvc.WebViewPage<List<Parametro>>
@using System.Linq
@using CapaModelo
@{
    ViewBag.Title = "Gestion de Parametros";

    var lista = Model ?? new List<Parametro>();
    var clavesTarifas = new[]
    {
        "TARIFA_EMI_AOCR",
        "TARIFA_REN_AOCR",
        "TARIFA_MOD_AOCR_INC",
        "TARIFA_MOD_AOCR_SIN_INC",
        "TARIFA_INSPECCION_EXT",
        "TARIFA_VIATICOS_INSPECTOR",
        "PORCENTAJE_ADMIN_VIATICOS"
    };

    var tarifas = lista
        .Where(p => p != null && p.DeletedAt == null && clavesTarifas.Contains((p.Clave ?? string.Empty).Trim(), System.StringComparer.OrdinalIgnoreCase))
        .OrderBy(p => p.Clave)
        .ToList();

    var otros = lista
        .Where(p => p != null && p.DeletedAt == null && !clavesTarifas.Contains((p.Clave ?? string.Empty).Trim(), System.StringComparer.OrdinalIgnoreCase))
        .OrderBy(p => p.Clave)
        .ToList();
}

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col-md-8">
            <h2>Gestion de Parametros del Sistema</h2>
            <p class="text-muted">Configuracion editable de tarifas AOCR y parametros generales.</p>
        </div>
        <div class="col-md-4 text-right">
            <a href="@Url.Action("Crear", "Parametro")" class="btn btn-primary">
                Nuevo Parametro
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="panel panel-default">
        <div class="panel-heading">
            <strong>Tarifas AOCR Oficiales</strong>
        </div>
        <div class="panel-body">
            <p>
                Emision AOCR: 3300.00 | Renovacion AOCR: 3300.00 | Modificacion AOCR (incluye aeronaves): 1600.00 |
                Modificacion AOCR (sin incremento): 80.00 | Inspeccion por estacion: 500.00 |
                Viaticos por dia: 80.00 | Gastos administrativos viaticos: 8.00%
            </p>

            @using (Html.BeginForm("AplicarTarifasAocrOficiales", "Parametro", FormMethod.Post, new { style = "display:inline-block;margin-bottom:12px;" }))
            {
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-success" onclick="return confirm('Aplicar/actualizar tarifas AOCR oficiales?');">
                    Aplicar tarifas AOCR oficiales
                </button>
            }

            @using (Html.BeginForm("SincronizarConceptosAocr", "Parametro", FormMethod.Post, new { style = "display:inline-block;margin-left:8px;margin-bottom:12px;" }))
            {
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-info" onclick="return confirm('Sincronizar conceptos AOCR para reflejar valores en el combo?');">
                    Sincronizar conceptos AOCR
                </button>
            }

            <div class="table-responsive">
                <table class="table table-striped table-bordered">
                    <thead>
                        <tr>
                            <th>Clave</th>
                            <th>Valor</th>
                            <th>Descripcion</th>
                            <th>Activo</th>
                            <th>Accion</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (tarifas.Any())
                        {
                            foreach (var p in tarifas)
                            {
                                <tr>
                                    <td><strong>@p.Clave</strong></td>
                                    <td>@p.Valor</td>
                                    <td>@p.Descripcion</td>
                                    <td>@(p.Activo ? "SI" : "NO")</td>
                                    <td>
                                        <a class="btn btn-warning btn-xs" href="@Url.Action("EditarPorClave", "Parametro", new { clave = p.Clave })">Editar</a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5">No existen parametros de tarifas AOCR cargados aun.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="panel panel-default">
        <div class="panel-heading">
            <strong>Todos los parametros activos</strong>
        </div>
        <div class="panel-body">
            <div class="table-responsive">
                <table class="table table-hover table-bordered">
                    <thead>
                        <tr>
                            <th>Clave</th>
                            <th>Valor</th>
                            <th>Descripcion</th>
                            <th>Activo</th>
                            <th>Accion</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (otros.Any())
                        {
                            foreach (var p in otros)
                            {
                                <tr>
                                    <td>@p.Clave</td>
                                    <td>@p.Valor</td>
                                    <td>@p.Descripcion</td>
                                    <td>@(p.Activo ? "SI" : "NO")</td>
                                    <td>
                                        <a class="btn btn-default btn-xs" href="@Url.Action("EditarPorClave", "Parametro", new { clave = p.Clave })">Editar</a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5">No existen otros parametros activos.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
