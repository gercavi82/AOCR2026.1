@inherits System.Web.Mvc.WebViewPage<IEnumerable<CapaModelo.SolicitudAOCR>>
@using System
@using System.Linq
@using System.Web.Mvc
@using System.Web.Mvc.Html
@using CapaModelo
@{
    Layout = "~/Views/Shared/_LayoutAOCR.cshtml";
    ViewBag.Title = "Bandeja de Coordinación - Asignación de Inspector";
}
@functions {
    public string NumeroSolicitud(SolicitudAOCR solicitud)
    {
        if (solicitud == null)
        {
            return "N/D";
        }

        return string.IsNullOrWhiteSpace(solicitud.NumeroSolicitud)
            ? solicitud.CodigoSolicitud.ToString()
            : solicitud.NumeroSolicitud.Trim();
    }

    public string Operador(SolicitudAOCR solicitud)
    {
        if (solicitud == null)
        {
            return "No disponible";
        }

        if (!string.IsNullOrWhiteSpace(solicitud.NombreOperador))
        {
            return solicitud.NombreOperador.Trim();
        }

        if (!string.IsNullOrWhiteSpace(solicitud.RazonSocial))
        {
            return solicitud.RazonSocial.Trim();
        }

        return "No disponible";
    }

    public string InspectorPrincipal(SolicitudAOCR solicitud)
    {
        if (solicitud == null)
        {
            return "Sin asignar";
        }

        if (!string.IsNullOrWhiteSpace(solicitud.TecnicoResponsableNombre) && !string.IsNullOrWhiteSpace(solicitud.TecnicoResponsableCedula))
        {
            return solicitud.TecnicoResponsableNombre.Trim() + " - " + solicitud.TecnicoResponsableCedula.Trim();
        }

        if (!string.IsNullOrWhiteSpace(solicitud.TecnicoResponsableNombre))
        {
            return solicitud.TecnicoResponsableNombre.Trim();
        }

        if (!string.IsNullOrWhiteSpace(solicitud.TecnicoResponsableCedula))
        {
            return solicitud.TecnicoResponsableCedula.Trim();
        }

        return "Sin asignar";
    }

    public string InspectorApoyo(SolicitudAOCR solicitud)
    {
        if (solicitud == null)
        {
            return "Sin apoyo";
        }

        if (!string.IsNullOrWhiteSpace(solicitud.InspectorApoyoNombre) && !string.IsNullOrWhiteSpace(solicitud.InspectorApoyoCedula))
        {
            return solicitud.InspectorApoyoNombre.Trim() + " - " + solicitud.InspectorApoyoCedula.Trim();
        }

        if (!string.IsNullOrWhiteSpace(solicitud.InspectorApoyoNombre))
        {
            return solicitud.InspectorApoyoNombre.Trim();
        }

        if (!string.IsNullOrWhiteSpace(solicitud.InspectorApoyoCedula))
        {
            return solicitud.InspectorApoyoCedula.Trim();
        }

        return "Sin apoyo";
    }

    public bool TieneAsignado(SolicitudAOCR solicitud)
    {
        if (solicitud == null)
        {
            return false;
        }

        return !string.IsNullOrWhiteSpace(solicitud.TecnicoResponsableCedula)
            || !string.IsNullOrWhiteSpace(solicitud.TecnicoResponsableNombre);
    }

    public string TipoInspector(SolicitudAOCR solicitud)
    {
        if (solicitud == null)
        {
            return "OPS";
        }

        if (!string.IsNullOrWhiteSpace(solicitud.TecnicoResponsableTipo))
        {
            return solicitud.TecnicoResponsableTipo.Trim().ToUpperInvariant();
        }

        if (!string.IsNullOrWhiteSpace(solicitud.InspectorApoyoTipo))
        {
            return solicitud.InspectorApoyoTipo.Trim().ToUpperInvariant();
        }

        return "OPS";
    }

    public string FechaVisible(SolicitudAOCR solicitud)
    {
        if (solicitud == null)
        {
            return "Sin fecha";
        }

        DateTime? fecha = solicitud.FechaSolicitud;
        if (!fecha.HasValue && solicitud.CreatedAt.HasValue)
        {
            fecha = solicitud.CreatedAt.Value;
        }
        if (!fecha.HasValue && solicitud.FechaCreacion > DateTime.MinValue)
        {
            fecha = solicitud.FechaCreacion;
        }

        return fecha.HasValue ? fecha.Value.ToString("dd/MM/yyyy") : "Sin fecha";
    }
}
<style>
    .tecnico-index-hero {
        background: linear-gradient(135deg, var(--aocr-blue-700) 0%, var(--aocr-teal-600) 100%);
        color: #ffffff;
        border-radius: 18px;
        padding: 1.5rem 2rem;
        margin-bottom: 24px;
        box-shadow: 0 10px 30px rgba(15, 77, 122, 0.2);
    }
    .tecnico-index-hero h1 { margin: 8px 0 10px; font-size: 30px; font-weight: 800; color: #ffffff; }
    .tecnico-index-hero p { color: rgba(255, 255, 255, 0.85); margin: 0; }
    .tecnico-index-eyebrow { display: inline-block; padding: 6px 12px; border-radius: 999px; background: rgba(255, 255, 255, 0.15); font-size: 12px; font-weight: 700; text-transform: uppercase; color: #ffffff; }
    .tecnico-index-card { background:#fff; border:1px solid rgba(24,59,89,.12); border-radius:20px; box-shadow:0 14px 32px rgba(15,45,64,.08); overflow:hidden; }
    .tecnico-index-card-head { padding:20px 24px; border-bottom:1px solid rgba(24,59,89,.08); display:flex; justify-content:space-between; gap:16px; align-items:center; }
    .tecnico-index-card-head h2 { margin:0 0 4px; font-size:22px; font-weight:800; color:#19354c; }
    .tecnico-index-card-head p { margin:0; color:#6c7b86; }
    .tecnico-index-badge { display:inline-flex; align-items:center; gap:8px; padding:10px 14px; border-radius:999px; background:#eef5f9; color:#1b4f72; font-weight:700; }
    .tecnico-index-wrap { padding:0 24px 24px; overflow-x:auto; }
    .tecnico-index-table { width:100%; border-collapse:separate; border-spacing:0; }
    .tecnico-index-table th, .tecnico-index-table td { padding:16px 12px; vertical-align:top; border-bottom:1px solid rgba(24,59,89,.08); }
    .tecnico-index-table thead th { font-size:12px; font-weight:800; letter-spacing:.04em; text-transform:uppercase; color:#6c7b86; }
    .tecnico-index-table tbody tr:last-child td { border-bottom:0; }
    .tecnico-index-numero { display:block; font-size:16px; font-weight:800; color:#1b4f72; }
    .tecnico-index-sub { display:block; margin-top:4px; font-size:12px; color:#6c7b86; }
    .tecnico-index-assign span { display:block; margin-bottom:4px; }
    .tecnico-index-actions { display:flex; flex-wrap:wrap; gap:8px; }
    .tecnico-index-actions a { display:inline-flex; align-items:center; gap:8px; padding:10px 14px; border-radius:12px; text-decoration:none; font-weight:700; }
    .tecnico-index-primary { background:#1b4f72; color:#fff; }
    .tecnico-index-primary span, .tecnico-index-primary i { color:#fff; }
    .tecnico-index-primary:hover, .tecnico-index-primary:focus { color:#fff; background:#153d58; text-decoration:none; }
    .tecnico-index-secondary { background:#eef5f9; color:#1b4f72; }
    .tecnico-index-secondary span, .tecnico-index-secondary i { color:#1b4f72; }
    .tecnico-index-secondary:hover, .tecnico-index-secondary:focus { color:#153d58; background:#e2edf4; text-decoration:none; }
</style>
<div class="tecnico-index-shell">
    <section class="tecnico-index-hero aocr-bg-dark">
        <span class="tecnico-index-eyebrow"><i class="fas fa-user-check"></i> Coordinación operativa</span>
        <h1>Bandeja de Coordinación</h1>
        <p>Gestione la asignación y reasignación institucional de inspectores AOCR sin cambiar la ruta heredada /Técnico.</p>
    </section>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success"><i class="fas fa-circle-check"></i> @TempData["Success"]</div>
    }
    @if (TempData["Info"] != null)
    {
        <div class="alert alert-info"><i class="fas fa-circle-info"></i> @TempData["Info"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger"><i class="fas fa-circle-exclamation"></i> @TempData["Error"]</div>
    }

    <section class="tecnico-index-card">
        <div class="tecnico-index-card-head">
            <div>
                <h2>Gestion de asignaciones</h2>
                <p>Abra la solicitud y designe el inspector principal o de apoyo desde la bandeja de coordinacion.</p>
            </div>
            <span class="tecnico-index-badge"><i class="fas fa-list-check"></i> @(ViewBag.TotalPendientes is int ? (int)ViewBag.TotalPendientes : (Model == null ? 0 : Model.Count())) registros</span>
        </div>

        @if (Model == null || !Model.Any())
        {
            <div class="p-4">
                @Html.Partial("~/Views/Shared/_EmptyState.cshtml", null, new ViewDataDictionary
                {
                    { "Icon", "fas fa-user-clock" },
                    { "Title", "No hay solicitudes pendientes de asignacion" },
                    { "Description", "Cuando exista una solicitud AOCR pendiente de coordinacion, aparecera aqui para asignar o reasignar inspectores." }
                })
            </div>
        }
        else
        {
            <div class="tecnico-index-wrap">
                <table class="tecnico-index-table">
                    <thead>
                        <tr>
                            <th>Solicitud</th>
                            <th>Operador</th>
                            <th>Estado</th>
                            <th>Fecha</th>
                            <th>Asignacion actual</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.OrderByDescending(x => x.FechaSolicitud ?? x.CreatedAt ?? x.FechaCreacion).ThenByDescending(x => x.CodigoSolicitud))
                        {
                            <tr>
                                <td>
                                    <span class="tecnico-index-numero">@NumeroSolicitud(item)</span>
                                    <span class="tecnico-index-sub">ID @item.CodigoSolicitud</span>
                                </td>
                                <td>
                                    <strong>@Operador(item)</strong>
                                    @if (!string.IsNullOrWhiteSpace(item.CodigoOaci))
                                    {
                                        <span class="tecnico-index-sub">OACI @item.CodigoOaci.Trim()</span>
                                    }
                                </td>
                                <td>
                                    @Html.Partial("~/Views/Shared/_StatusBadge.cshtml", null, new ViewDataDictionary { { "Estado", item.Estado } })
                                </td>
                                <td>@FechaVisible(item)</td>
                                <td>
                                    <div class="tecnico-index-assign">
                                        <span><strong>Principal:</strong> @InspectorPrincipal(item)</span>
                                        <span><strong>Apoyo:</strong> @InspectorApoyo(item)</span>
                                    </div>
                                </td>
                                <td>
                                    <div class="tecnico-index-actions">
                                        <a href="@Url.Action("AsignarInspector", "Tecnico", new { solicitudId = item.CodigoSolicitud, tipoInspector = TipoInspector(item) })" class="tecnico-index-primary">
                                            <i class="fas fa-user-pen"></i>
                                            <span>@(TieneAsignado(item) ? "Reasignar inspector" : "Asignar inspector")</span>
                                        </a>
                                        <a href="@Url.Action("Detalle", "SolicitudAOCR", new { id = item.CodigoSolicitud })" class="tecnico-index-secondary">
                                            <i class="fas fa-file-lines"></i>
                                            <span>Ver detalle</span>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>
