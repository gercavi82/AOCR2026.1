@model CapaPresentacion.Models.AocrDocumentoPdfViewModel
@using System.Globalization
@using System.Linq

@{
    Layout = "~/Views/Shared/_PdfLayoutDGACAocr.cshtml";
    var solicitud = Model != null ? Model.Solicitud : null;
    var informe = Model != null ? Model.Informe : null;
    var certificado = Model != null ? Model.Certificado : null;
    var fechaDoc = Model != null ? Model.FechaEmisionDocumento : DateTime.Now;
    var cultura = new CultureInfo("es-EC");

    Func<string, string> normalizarTextoVisible = CapaPresentacion.Helpers.VisibleTextHelper.Normalize;
    Func<string, string> textoCampo = value => !string.IsNullOrWhiteSpace(normalizarTextoVisible(value)) ? normalizarTextoVisible(value) : "PENDIENTE DE COMPLETAR";
    Func<DateTime?, string> fechaCampo = value => value.HasValue ? value.Value.ToString("dd/MM/yyyy", cultura) : "PENDIENTE DE COMPLETAR";
    Func<string, string> claseCampo = value => !string.IsNullOrWhiteSpace(value) ? "field-value" : "field-value pending";

    var operador = Model != null ? Model.NombreExplotador : null;
    var contacto = Model != null ? Model.PuntoContactoEcuador : null;
    var telefonoCorreo = Model != null ? string.Join(" / ", new[] { Model.CorreoExplotador, Model.TelefonoExplotador }.Where(x => !string.IsNullOrWhiteSpace(x))) : null;
    var direccionCompleta = Model != null ? Model.DireccionExplotador : null;
    var baseLegal = Model != null ? Model.BaseLegalReferencia : null;
    var observaciones = Model != null ? Model.ObservacionesReconocimiento : null;
    var elaboradoPor = Model != null ? Model.ElaboradoPor : null;
    var revisadoPor = Model != null ? Model.RevisadoPor : null;
    var firmadoPor = Model != null ? Model.FirmanteFinal : null;
    var cargoFirmante = Model != null ? Model.CargoFirmante : null;
}

@section PdfHead {
    <style>
        body { font-family: Arial, Helvetica, sans-serif; font-size: 10pt; color: #111; }
        .sheet { border: 2px solid #1f1f1f; padding: 18px; }
        .head-table, .grid, .footer-table, .signature-table { width: 100%; border-collapse: collapse; }
        .head-table td, .grid td, .grid th, .footer-table td, .signature-table td { border: 1px solid #222; padding: 6px; vertical-align: top; }
        .title { text-align: center; font-weight: bold; font-size: 13pt; letter-spacing: .4px; }
        .title-block { max-width: 86%; margin: 0 auto; line-height: 1.08; }
        .subtitle { text-align: center; font-size: 10pt; }
        .small { font-size: 8pt; color: #444; }
        .center { text-align: center; }
        .label { font-weight: bold; }
        .spacer { height: 14px; }
        .section-title { font-weight: bold; font-size: 10.5pt; background: #e9eef5; padding: 7px 8px; border: 1px solid #222; }
        .field-label { display: block; font-weight: bold; font-size: 8.5pt; margin-bottom: 4px; text-transform: uppercase; }
        .field-value { display: block; min-height: 20px; padding: 4px 6px; border: 1px dashed #666; background: #fbfbfb; }
        .field-value.pending { color: #7a4d00; font-style: italic; background: #fff8e8; }
        .note-box { border: 1px solid #222; background: #f7fafc; padding: 10px 12px; }
        .signature-line { height: 34px; border-bottom: 1px solid #222; margin-bottom: 6px; }
        .signature-role { font-weight: bold; text-transform: uppercase; font-size: 8.5pt; }
        .checklist { margin: 0; padding-left: 18px; }
        .checklist li { margin-bottom: 4px; }
        .signature-table { page-break-inside: avoid; break-inside: avoid; }
        .signature-slot { height: 120px; min-height: 120px; border: 1px dashed #999; background: #fff; margin-top: 6px; overflow: hidden; position: relative; }
        .firma-anchor { font-size: 1px; color: #fff; line-height: 1px; height: 1px; overflow: hidden; display: block; }
    </style>
}

<div class="sheet">
    <table class="head-table">
        <tr>
            <td colspan="3" class="title">
                <div class="title-block">
                    RECONOCIMIENTO DE CERTIFICADO DE<br />
                    EXPLOTADOR DE SERVICIOS AEREOS
                </div>
            </td>
        </tr>
        <tr>
            <td colspan="3" class="subtitle">AIR OPERATOR CERTIFICATE RECOGNIZED</td>
        </tr>
        <tr>
            <td class="center" style="width:33%;"><strong>REPUBLICA DEL ECUADOR</strong><br /><span class="small">REPUBLIC OF ECUADOR</span></td>
            <td class="center" style="width:34%;"><strong>DIRECCION GENERAL DE AVIACION CIVIL</strong><br /><span class="small">CIVIL AVIATION GENERAL DIRECTORATE</span></td>
            <td class="center" style="width:33%;"><strong>PERMISO OPERACION CNAC</strong><br /><span class="small">CNAC OPERATION PERMIT</span></td>
        </tr>
    </table>

    <div class="spacer"></div>

    <div class="section-title">I. Datos generales del reconocimiento AOCR</div>

    <table class="grid">
        <tr>
            <td style="width:33%;"><span class="field-label">AOCR #</span><span class="@claseCampo(Model != null ? Model.NumeroAocr : null)">@textoCampo(Model != null ? Model.NumeroAocr : null)</span></td>
            <td style="width:34%;"><span class="field-label">Nombre del explotador</span><span class="@claseCampo(operador)">@textoCampo(operador)</span></td>
            <td style="width:33%;"><span class="field-label">Punto de contacto en Ecuador</span><span class="@claseCampo(contacto)">@textoCampo(contacto)</span></td>
        </tr>
        <tr>
            <td><span class="field-label">Fecha de emision</span><span class="field-value">@fechaDoc.ToString("dd/MM/yyyy", cultura)</span></td>
            <td><span class="field-label">Estado del explotador</span><span class="@claseCampo(Model != null ? Model.EstadoExplotador : null)">@textoCampo(Model != null ? Model.EstadoExplotador : null)</span></td>
            <td><span class="field-label">Correo / Telefono</span><span class="@claseCampo(telefonoCorreo)">@textoCampo(telefonoCorreo)</span></td>
        </tr>
        <tr>
            <td><span class="field-label">Direccion operacional</span><span class="@claseCampo(direccionCompleta)">@textoCampo(direccionCompleta)</span></td>
            <td><span class="field-label">Numero certificado original</span><span class="@claseCampo(Model != null ? Model.AocOriginalNumero : null)">@textoCampo(Model != null ? Model.AocOriginalNumero : null)</span></td>
            <td><span class="field-label">Representante tecnico</span><span class="@claseCampo(Model != null ? Model.RepresentanteTecnico : null)">@textoCampo(Model != null ? Model.RepresentanteTecnico : null)</span></td>
        </tr>
        <tr>
            <td><span class="field-label">Estado otorgante</span><span class="@claseCampo(Model != null ? Model.EstadoOtorgante : null)">@textoCampo(Model != null ? Model.EstadoOtorgante : null)</span></td>
            <td><span class="field-label">Razon social</span><span class="@claseCampo(Model != null ? Model.RazonSocial : null)">@textoCampo(Model != null ? Model.RazonSocial : null)</span></td>
            <td><span class="field-label">Vigencia sugerida hasta</span><span class="field-value @(Model != null && Model.FechaVencimiento.HasValue ? string.Empty : "pending")">@fechaCampo(Model != null ? Model.FechaVencimiento : null)</span></td>
        </tr>
    </table>

    <div class="spacer"></div>

    <div class="section-title">II. Campos a completar por Coordinacion / Jefatura</div>

    <table class="grid">
        <tr>
            <td style="width:50%;">
                <span class="field-label">Base legal / referencia institucional</span>
                <span class="@claseCampo(baseLegal)">@textoCampo(baseLegal)</span>
            </td>
            <td style="width:50%;">
                <span class="field-label">Numero de solicitud / tramite base</span>
                <span class="@claseCampo(solicitud != null ? solicitud.NumeroSolicitud : null)">@textoCampo(solicitud != null ? solicitud.NumeroSolicitud : null)</span>
            </td>
        </tr>
        <tr>
            <td colspan="2">
                <span class="field-label">Puntos de contacto operacionales</span>
                <span class="@claseCampo(Model != null ? Model.PuntosContactoOperacionales : null)">@Html.Raw((textoCampo(Model != null ? Model.PuntosContactoOperacionales : null) ?? string.Empty).Replace(Environment.NewLine, "<br />"))</span>
            </td>
        </tr>
        <tr>
            <td colspan="2">
                <span class="field-label">Observaciones del reconocimiento</span>
                <span class="@claseCampo(observaciones)">@textoCampo(observaciones)</span>
            </td>
        </tr>
    </table>

    <div class="spacer"></div>

    <div class="note-box">
        <strong>Uso de la plantilla</strong>
        <ol class="checklist">
            <li>Verificar que todos los campos institucionales del expediente esten completos.</li>
            <li>Completar manualmente o desde sistema los campos marcados como pendientes.</li>
            <li>Confirmar coherencia entre operador, vigencia, aeronaves y condiciones operativas.</li>
            <li>Una vez validado el contenido, registrar la firma correspondiente de Coordinacion/Jefatura.</li>
        </ol>
    </div>

    <div class="spacer"></div>

    <div class="section-title">III. Revision y firmas</div>

    <table class="signature-table" style="margin-top:12px;">
        <tr>
            <td style="width:33%;">
                <div class="signature-line"></div>
                <div class="signature-role">Elaborado por</div>
                <div class="@claseCampo(elaboradoPor)">@textoCampo(elaboradoPor)</div>
                <div class="small">Coordinacion / Jefatura Tecnica</div>
            </td>
            <td style="width:33%;">
                <div class="signature-line"></div>
                <div class="signature-role">Revisado por</div>
                <div class="@claseCampo(revisadoPor)">@textoCampo(revisadoPor)</div>
                <div class="small">Fecha revision: @fechaCampo(informe != null ? informe.FechaFirma2 : null)</div>
            </td>
            <td style="width:34%;" data-firma-rol="AOCR_FIRMANTE">
                <div class="signature-role">FIRMA DE AUTORIZACION AOCR</div>
                <div class="small">Firma digital autorizada.</div>
                <div class="signature-slot">
                    <span class="firma-anchor">ANCLA_FIRMA_AUTORIZACION_AOCR</span>
                </div>
            </td>
        </tr>
        <tr>
            <td colspan="2"><span class="field-label">Observaciones de validacion final</span><span class="@(string.IsNullOrWhiteSpace(Model != null ? Model.ObservacionesValidacionFinal : null) ? "field-value pending" : "field-value")">@textoCampo(Model != null ? Model.ObservacionesValidacionFinal : null)</span></td>
            <td><span class="field-label">Validacion de firma</span><span class="field-value pending">La firma digital se inserta automaticamente en el recuadro al firmar.</span></td>
        </tr>
    </table>
</div>
