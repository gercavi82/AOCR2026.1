  <connectionStrings>
    <add name="AOCRConnection" connectionString="Host=172.20.16.55;Port=5432;Database=dgac_des;Username=root;Password=control;Pooling=true;Minimum Pool Size=1;Maximum Pool Size=20;Timeout=15;CommandTimeout=60;" providerName="Npgsql" />
    <add name="PostgreSQL" connectionString="Host=172.20.16.55;Port=5432;Database=dgac_des;Username=root;Password=control;Pooling=true;Minimum Pool Size=1;Maximum Pool Size=20;Timeout=15;CommandTimeout=60;" providerName="Npgsql" />
    <add name="PostgresMirror" connectionString="" providerName="Npgsql" />
    <add name="P9ConnectionString" connectionString="DataSource=172.20.16.14;UserID=DGAC;Password=DGAC2024;DefaultCollection=DGACSYS;LibraryList=DGACSYS;Pooling=true;" providerName="IBM.Data.DB2.iSeries" />
    <add name="As400Odbc" connectionString="" providerName="System.Data.Odbc" />
  </connectionStrings>
  <appSettings>
    <add key="webpages:Enabled" value="false" />
    <!-- REMEDIACIÓN: Startup class no existe. Si OWIN Host está en GAC del servidor,
         esta clave provoca 500 al arranque. Comentada hasta crear la clase.
    <add key="owin:AppStartup" value="CapaPresentacion.Startup" />
    -->
    <add key="SmtpHost" value="172.20.16.21" />
    <add key="SmtpPort" value="25" />
    <add key="SmtpEnableSsl" value="false" />
    <!-- SMTP: configurar en variables de entorno (SMTP_USERNAME / SMTP_PASSWORD)
         o en machine.config / Web.Release.config, NUNCA hardcodeado aqui. -->
    <add key="SmtpUsername" value="" />
    <add key="SmtpPassword" value="" />
    <add key="FromEmail" value="sistema@dgac.gob.ec" />
    <add key="FromName" value="Sistema AOCR - DGAC Ecuador" />
    <add key="AdminEmails" value="admin1@dgac.gob.ec;admin2@dgac.gob.ec" />
    <add key="UploadPath" value="~/Uploads/" />
    <add key="MaxUploadSize" value="10485760" />
    <add key="SessionTimeout" value="20" />
    <add key="RT_MaxFileSizeMb" value="10" />
    <add key="RT_BasePathStorage" value="~/App_Data/AOCR" />
    <add key="RT_FileStorageRoot" value="" />
    <!-- Configuración de correo (fallback si no hay variables de entorno) -->
    <add key="SmtpServer" value="172.20.16.21" />
    <add key="EmailFrom" value="no_reply@aviacioncivil.gob.ec" />
    <add key="EmailFromName" value="Sistema AOCR" />
    <!-- Configuración de autenticación SMTP (si el servidor lo requiere) -->
    <add key="Email:SmtpServer" value="172.20.16.21" />
    <!-- ============================================ -->
    <!-- Configuración AS/400 para CIAARC (Empresas) -->
    <!-- ============================================ -->
    <add key="AS400:Server" value="190.152.8.185" />
    <add key="AS400:Database" value="S10a1a05" />
