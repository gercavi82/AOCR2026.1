    <!-- AS400 mirror sync (desactivado por defecto; activar luego de desplegar scripts SQL) -->
    <add key="Sync:Enabled" value="false" />
    <add key="Sync:DryRun" value="false" />
    <add key="Sync:Schedule" value="*/10 * * * *" />
    <add key="Sync:BatchSize" value="1000" />
    <add key="Sync:MaxRetries" value="2" />
    <add key="Sync:RetryBackoffMs" value="1500" />
    <add key="Sync:As400ConnectionTimeoutSeconds" value="30" />
    <add key="Sync:As400TimeoutSeconds" value="60" />
    <add key="Sync:PostgresTimeoutSeconds" value="60" />
    <add key="Sync:As400OdbcDriver" value="iSeries Access ODBC Driver" />
