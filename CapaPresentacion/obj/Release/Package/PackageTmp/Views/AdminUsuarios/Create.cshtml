@model CapaPresentacion.Models.AdminUsuarios.AdminUsuarioFormViewModel

@{
    ViewBag.Title = "Administracion - Crear usuario";
}

<h2>Crear usuario</h2>
<p class="text-muted">Registre un usuario interno y asigne sus roles iniciales.</p>

@using (Html.BeginForm("Create", "AdminUsuarios", FormMethod.Post, new { autocomplete = "off" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

    @Html.Partial("_UserForm", Model, new ViewDataDictionary { { "EsEdicion", false } })

    <div class="d-flex justify-content-end mt-3">
        <a class="btn btn-outline-secondary mr-2" href="@Url.Action("Index", "AdminUsuarios")">Cancelar</a>
        <button type="submit" class="btn btn-success">Guardar usuario</button>
    </div>
}

@section Scripts {
    <script src="~/Scripts/admin-usuarios.js"></script>
}
