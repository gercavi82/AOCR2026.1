@model CapaPresentacion.Models.ViewModels.InspectorDashboardViewModel
@using System
@using System.Linq
@{
    Layout = "~/Views/Shared/_LayoutAOCR.cshtml";
    ViewBag.Title = "Dashboard Inspector";

    var ultimas = Model.UltimasInspecciones ?? new System.Collections.Generic.List<CapaPresentacion.Models.ViewModels.InspectorInspeccionItemViewModel>();
    var alertas = Model.AlertasUrgentes ?? new System.Collections.Generic.List<CapaPresentacion.Models.ViewModels.InspectorAlertaViewModel>();

    var totalOperativo = Math.Max(1, Model.InspeccionesAsignadas);
    var porcentajePendientes = Math.Round((decimal)Model.InspeccionesPendientes * 100m / totalOperativo, 0);
    var porcentajeCerradas = Math.Round((decimal)Model.InspeccionesCerradas * 100m / totalOperativo, 0);
    var porcentajeNc = Math.Round((decimal)Model.InspeccionesConNc * 100m / totalOperativo, 0);
    var porcentajeRequierenNueva = Math.Round((decimal)Model.InspeccionesRequierenNueva * 100m / totalOperativo, 0);
    var porcentajeDocsPendientes = Math.Round((decimal)Model.DocumentosPendientesRevision * 100m / totalOperativo, 0);

    Func<int, int> calcularAltura = valor =>
    {
        if (totalOperativo <= 0)
        {
            return 12;
        }

        return Math.Max(12, (int)Math.Round((decimal)valor * 100m / totalOperativo));
    };
}

<style>
    .insp-dashboard {
        --insp-bg: linear-gradient(180deg, #eef4f7 0%, #e3ebf1 100%);
        --insp-panel: #ffffff;
        --insp-border: rgba(17, 52, 73, 0.08);
        --insp-text: #183246;
        --insp-muted: #718594;
        --insp-blue: #47b3df;
        --insp-green: #7bc043;
        --insp-yellow: #f5c84b;
        --insp-red: #f06a5f;
        --insp-pink: #d892ca;
        --insp-shadow: 0 16px 36px rgba(20, 43, 62, 0.08);
        background: var(--insp-bg);
        border: 1px solid var(--insp-border);
        border-radius: 24px;
        padding: 24px;
        color: var(--insp-text);
    }

    .insp-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 16px;
        margin-bottom: 18px;
    }

    .insp-title {
        margin: 0;
        font-size: 1.9rem;
        font-weight: 800;
        letter-spacing: -0.03em;
    }

    .insp-subtitle {
        margin: 6px 0 0;
        color: var(--insp-muted);
        font-size: 0.97rem;
    }

    .insp-filter-card,
    .insp-card,
    .insp-table-card {
        background: var(--insp-panel);
        border-radius: 18px;
        border: 1px solid var(--insp-border);
        box-shadow: var(--insp-shadow);
    }

    .insp-filter-card {
        padding: 18px;
        margin-bottom: 16px;
    }

    .insp-grid,
    .insp-grid-secondary,
    .insp-grid-tertiary {
        display: grid;
        gap: 14px;
        margin-bottom: 14px;
    }

    .insp-grid {
        grid-template-columns: 0.95fr 1.45fr 1.45fr 0.95fr;
    }

    .insp-grid-secondary {
        grid-template-columns: 0.95fr 1.45fr 1.45fr 0.95fr;
    }

    .insp-grid-tertiary {
        grid-template-columns: 1.15fr 1.85fr;
    }

    .insp-card {
        padding: 18px;
        position: relative;
        overflow: hidden;
    }

    .insp-card.tall {
        min-height: 206px;
    }

    .insp-label {
        color: var(--insp-muted);
        font-size: 0.78rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.08em;
    }

    .insp-value {
        margin-top: 10px;
        font-size: 2rem;
        line-height: 1;
        font-weight: 800;
    }

    .insp-note {
        margin-top: 10px;
        color: var(--insp-muted);
        font-size: 0.85rem;
    }

    .insp-accent {
        position: absolute;
        inset: auto -22px -32px auto;
        width: 96px;
        height: 96px;
        border-radius: 50%;
        opacity: 0.12;
        background: currentColor;
    }

    .insp-blue { color: var(--insp-blue); }
    .insp-green { color: var(--insp-green); }
    .insp-yellow { color: var(--insp-yellow); }
    .insp-red { color: var(--insp-red); }
    .insp-pink { color: var(--insp-pink); }

    .insp-ring-wrap {
        display: flex;
        gap: 18px;
        align-items: center;
        min-height: 170px;
        position: relative;
    }

    .insp-ring {
        --size: 132px;
        --thickness: 16px;
        width: var(--size);
        height: var(--size);
        border-radius: 50%;
        background: conic-gradient(var(--ring-color, #47b3df) calc(var(--ring-percent, 0) * 1%), #e8eef3 0);
        display: grid;
        place-items: center;
        flex-shrink: 0;
    }

    .insp-ring::before {
        content: "";
        width: calc(var(--size) - var(--thickness) * 2);
        height: calc(var(--size) - var(--thickness) * 2);
        border-radius: 50%;
        background: #fff;
        box-shadow: inset 0 0 0 1px rgba(17, 52, 73, 0.05);
    }

    .insp-ring-center {
        position: absolute;
        text-align: center;
        left: 34px;
        top: 48px;
        width: 64px;
    }

    .insp-ring-center strong {
        display: block;
        font-size: 1.55rem;
        line-height: 1;
    }

    .insp-ring-center span {
        display: block;
        margin-top: 6px;
        color: var(--insp-muted);
        font-size: 0.74rem;
        line-height: 1.2;
    }

    .insp-legend,
    .insp-list {
        list-style: none;
        margin: 0;
        padding: 0;
        width: 100%;
    }

    .insp-legend li,
    .insp-list li {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        padding: 8px 0;
        border-bottom: 1px solid rgba(17, 52, 73, 0.06);
        font-size: 0.88rem;
    }

    .insp-legend li:last-child,
    .insp-list li:last-child {
        border-bottom: 0;
    }

    .insp-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        display: inline-block;
        margin-right: 8px;
        flex-shrink: 0;
    }

    .insp-bars {
        display: flex;
        align-items: end;
        justify-content: space-between;
        gap: 10px;
        min-height: 132px;
        margin-top: 12px;
    }

    .insp-bar-item {
        flex: 1;
        text-align: center;
    }

    .insp-bar-stack {
        height: 120px;
        display: flex;
        align-items: end;
        justify-content: center;
    }

    .insp-bar {
        width: 16px;
        border-radius: 10px 10px 0 0;
        min-height: 8px;
    }

    .insp-bar-label {
        display: block;
        margin-top: 8px;
        color: var(--insp-muted);
        font-size: 0.78rem;
    }

    .insp-line-chart {
        position: relative;
        height: 155px;
        margin-top: 10px;
    }

    .insp-line-chart svg {
        width: 100%;
        height: 100%;
    }

    .insp-mini-note {
        display: flex;
        justify-content: space-between;
        color: var(--insp-muted);
        font-size: 0.78rem;
        margin-top: 8px;
    }

    .insp-list-title {
        font-weight: 700;
        font-size: 0.92rem;
    }

    .insp-list-sub {
        color: var(--insp-muted);
        font-size: 0.8rem;
    }

    .insp-table-card {
        overflow: hidden;
    }

    .insp-table-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        padding: 16px 18px;
        border-bottom: 1px solid rgba(17, 52, 73, 0.07);
        background: linear-gradient(180deg, #fff 0%, #f7fafc 100%);
    }

    .insp-table-header h3 {
        margin: 0;
        font-size: 1rem;
        font-weight: 800;
    }

    .insp-chip {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        border-radius: 999px;
        padding: 6px 10px;
        font-size: 0.78rem;
        font-weight: 700;
        background: #eef4f7;
        color: #4d6b7e;
    }

    .insp-alert {
        border: 1px solid rgba(17, 52, 73, 0.08);
        border-radius: 14px;
        padding: 12px;
        margin-bottom: 10px;
        background: #fbfdfe;
    }

    .insp-alert:last-child {
        margin-bottom: 0;
    }

    @@media (max-width: 1200px) {
        .insp-grid,
        .insp-grid-secondary,
        .insp-grid-tertiary {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 768px) {
        .insp-dashboard {
            padding: 16px;
            border-radius: 18px;
        }

        .insp-header,
        .insp-ring-wrap,
        .insp-table-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .insp-grid,
        .insp-grid-secondary,
        .insp-grid-tertiary {
            grid-template-columns: 1fr;
        }

        .insp-ring-center {
            left: 34px;
        }
    }
</style>

<div class="insp-dashboard">
    <div class="insp-header">
        <div>
            <h2 class="insp-title">Dashboard Técnico / Inspector</h2>
            <p class="insp-subtitle">Seguimiento operativo de inspecciones, carga activa, no conformidades y alertas prioritarias del flujo técnico.</p>
        </div>
        <div>
            <a class="btn btn-outline-primary" href="@Url.Action("Index", "Inspeccion")">
                <i class="fas fa-list"></i> Ver inspecciones
            </a>
        </div>
    </div>

    <div class="insp-filter-card mb-3">
        @using (Html.BeginForm("Inspector", "Dashboard", System.Web.Mvc.FormMethod.Get, new { @class = "row g-2" }))
        {
            <div class="col-md-2">
                <label class="form-label">Desde</label>
                <input type="date" name="fechaDesde" value="@(Model.FechaDesde.HasValue ? Model.FechaDesde.Value.ToString("yyyy-MM-dd") : "")" class="form-control" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Hasta</label>
                <input type="date" name="fechaHasta" value="@(Model.FechaHasta.HasValue ? Model.FechaHasta.Value.ToString("yyyy-MM-dd") : "")" class="form-control" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Estado</label>
                <input type="text" name="estado" value="@Model.Estado" class="form-control" placeholder="Ej: EN_INSPECCION" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Compañía</label>
                <input type="text" name="compania" value="@Model.Compania" class="form-control" placeholder="OACI o nombre" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Solicitud</label>
                <input type="number" name="codigoSolicitud" value="@(Model.CodigoSolicitud.HasValue ? Model.CodigoSolicitud.Value.ToString() : "")" class="form-control" />
            </div>
            <div class="col-md-1 d-flex align-items-end">
                <button type="submit" class="btn btn-primary w-100">Filtrar</button>
            </div>
        }
    </div>

    <div class="insp-grid">
        <div class="insp-card insp-blue">
            <div class="insp-label">Asignadas</div>
            <div class="insp-value">@Model.InspeccionesAsignadas</div>
            <div class="insp-note">Carga total bajo responsabilidad del inspector.</div>
            <span class="insp-accent"></span>
        </div>

        <div class="insp-card tall">
            <div class="insp-label">Ejecución Activa</div>
            <div class="insp-ring-wrap">
                <div class="insp-ring" style="--ring-percent:@porcentajePendientes; --ring-color:#47b3df;"></div>
                <div class="insp-ring-center">
                    <strong>@Model.InspeccionesPendientes</strong>
                    <span>Pendientes</span>
                </div>
                <ul class="insp-legend">
                    <li><span><span class="insp-dot" style="background:#47b3df;"></span>Pendientes</span><strong>@Model.InspeccionesPendientes</strong></li>
                    <li><span><span class="insp-dot" style="background:#7bc043;"></span>Cerradas</span><strong>@Model.InspeccionesCerradas</strong></li>
                    <li><span><span class="insp-dot" style="background:#f06a5f;"></span>Con NC</span><strong>@Model.InspeccionesConNc</strong></li>
                    <li><span><span class="insp-dot" style="background:#d892ca;"></span>Nueva insp.</span><strong>@Model.InspeccionesRequierenNueva</strong></li>
                </ul>
            </div>
        </div>

        <div class="insp-card tall">
            <div class="insp-label">Riesgo Técnico</div>
            <div class="insp-ring-wrap">
                <div class="insp-ring" style="--ring-percent:@porcentajeNc; --ring-color:#f06a5f;"></div>
                <div class="insp-ring-center">
                    <strong>@Model.InspeccionesConNc</strong>
                    <span>Con NC</span>
                </div>
                <ul class="insp-legend">
                    <li><span><span class="insp-dot" style="background:#f06a5f;"></span>No conformidades</span><strong>@Model.InspeccionesConNc</strong></li>
                    <li><span><span class="insp-dot" style="background:#f5c84b;"></span>Docs pendientes</span><strong>@Model.DocumentosPendientesRevision</strong></li>
                    <li><span><span class="insp-dot" style="background:#d892ca;"></span>Requieren nueva</span><strong>@Model.InspeccionesRequierenNueva</strong></li>
                </ul>
            </div>
        </div>

        <div class="insp-card insp-green">
            <div class="insp-label">Cerradas</div>
            <div class="insp-value">@Model.InspeccionesCerradas</div>
            <div class="insp-note">Casos finalizados dentro del período visible.</div>
            <span class="insp-accent"></span>
        </div>
    </div>

    <div class="insp-grid-secondary">
        <div class="insp-card insp-yellow">
            <div class="insp-label">Requieren Nueva Inspección</div>
            <div class="insp-value">@Model.InspeccionesRequierenNueva</div>
            <div class="insp-note">Casos que volvieron a ciclo de revisión técnica.</div>
            <span class="insp-accent"></span>
        </div>

        <div class="insp-card">
            <div class="d-flex justify-content-between align-items-center">
                <div class="insp-label">Distribución Operativa</div>
                <strong class="small text-muted">@Model.InspeccionesAsignadas total</strong>
            </div>
            <div class="insp-bars">
                <div class="insp-bar-item">
                    <div class="insp-bar-stack"><div class="insp-bar" style="height:@(calcularAltura(Model.InspeccionesPendientes))px;background:#47b3df;"></div></div>
                    <span class="insp-bar-label">Pend.</span>
                </div>
                <div class="insp-bar-item">
                    <div class="insp-bar-stack"><div class="insp-bar" style="height:@(calcularAltura(Model.InspeccionesConNc))px;background:#f06a5f;"></div></div>
                    <span class="insp-bar-label">NC</span>
                </div>
                <div class="insp-bar-item">
                    <div class="insp-bar-stack"><div class="insp-bar" style="height:@(calcularAltura(Model.InspeccionesCerradas))px;background:#7bc043;"></div></div>
                    <span class="insp-bar-label">Cerr.</span>
                </div>
                <div class="insp-bar-item">
                    <div class="insp-bar-stack"><div class="insp-bar" style="height:@(calcularAltura(Model.InspeccionesRequierenNueva))px;background:#d892ca;"></div></div>
                    <span class="insp-bar-label">Nueva</span>
                </div>
                <div class="insp-bar-item">
                    <div class="insp-bar-stack"><div class="insp-bar" style="height:@(calcularAltura(Model.DocumentosPendientesRevision))px;background:#f5c84b;"></div></div>
                    <span class="insp-bar-label">Docs</span>
                </div>
            </div>
        </div>

        <div class="insp-card">
            <div class="insp-label">Tendencia de Atención</div>
            <div class="insp-line-chart">
                <svg viewBox="0 0 300 150" preserveAspectRatio="none" aria-hidden="true">
                    <line x1="0" y1="128" x2="300" y2="128" stroke="#e8eef3" stroke-width="2"></line>
                    <polyline fill="none" stroke="#47b3df" stroke-width="4" points="10,112 55,92 95,98 135,62 175,76 215,44 255,36 290,24"></polyline>
                    <circle cx="135" cy="62" r="5" fill="#47b3df"></circle>
                    <circle cx="215" cy="44" r="5" fill="#47b3df"></circle>
                    <circle cx="290" cy="24" r="5" fill="#47b3df"></circle>
                </svg>
            </div>
            <div class="insp-mini-note"><span>Ciclo reciente</span><span>Mejor desempeño operativo</span></div>
        </div>

        <div class="insp-card insp-pink">
            <div class="insp-label">Tiempo Promedio</div>
            <div class="insp-value">@Model.TiempoPromedioAtencionHoras.ToString("0.00")</div>
            <div class="insp-note">Horas promedio invertidas en la atención de inspecciones.</div>
            <span class="insp-accent"></span>
        </div>
    </div>

    <div class="insp-grid-tertiary">
        <div class="insp-card">
            <div class="insp-label">Alertas Urgentes</div>
            @if (!alertas.Any())
            {
                <p class="insp-note mb-0">No existen alertas urgentes en este momento.</p>
            }
            else
            {
                foreach (var alerta in alertas.Take(5))
                {
                    <div class="insp-alert">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <strong>@alerta.Titulo</strong>
                            <span class="badge @(alerta.Severidad == "ALTA" ? "bg-danger" : "bg-warning text-dark")">@alerta.Severidad</span>
                        </div>
                        <div class="small text-muted">@alerta.Mensaje</div>
                        <div class="small text-muted mb-1">@alerta.Fecha.ToString("dd/MM/yyyy HH:mm")</div>
                        <a href="@alerta.UrlDestino" class="small">Ir al detalle</a>
                    </div>
                }
            }
        </div>

        <div class="insp-table-card">
            <div class="insp-table-header">
                <div>
                    <h3>Últimas inspecciones trabajadas</h3>
                    <div class="text-muted small">Seguimiento operativo de solicitudes, estado y actividad reciente.</div>
                </div>
                <span class="insp-chip"><i class="fas fa-clipboard-check"></i> Vista operativa</span>
            </div>
            <div class="table-responsive">
                <table class="table table-striped mb-0">
                    <thead>
                        <tr>
                            <th>Inspección</th>
                            <th>Solicitud</th>
                            <th>Estado</th>
                            <th>Operador</th>
                            <th>Fecha</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!ultimas.Any())
                        {
                            <tr><td colspan="6" class="text-center text-muted">Sin datos para los filtros seleccionados.</td></tr>
                        }
                        else
                        {
                            foreach (var item in ultimas)
                            {
                                <tr>
                                    <td>@item.NumeroInspeccion</td>
                                    <td>@item.CodigoSolicitud</td>
                                    <td>
                                        <span class="badge bg-secondary">@item.Estado</span>
                                        @if (item.TieneNoConformidadAbierta)
                                        {
                                            <span class="badge bg-danger ms-1">CON_NC</span>
                                        }
                                    </td>
                                    <td>@item.Operador</td>
                                    <td>@(item.UltimaActualizacion.HasValue ? item.UltimaActualizacion.Value.ToString("dd/MM/yyyy HH:mm") : "-")</td>
                                    <td>
                                        <a class="btn btn-sm btn-outline-primary" href="@Url.Action("Detalle", "Inspeccion", new { id = item.CodigoInspeccion })">Ver</a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
