@inherits System.Web.Mvc.WebViewPage<IEnumerable<CapaModelo.Direccion>>
@using CapaModelo
@using System.Web.Mvc
@using System.Web.Mvc.Html
@{
    ViewBag.Title = "Listado de Direcciones";
}

<h2 class="mt-3">📍 Listado de Direcciones</h2>

@if (TempData["msg"] != null)
{
    <div class="alert alert-success">@TempData["msg"]</div>
}

@if (TempData["error"] != null)
{
    <div class="alert alert-danger">@TempData["error"]</div>
}

<p>
    <a href="@Url.Action("Crear")" class="btn btn-primary">➕ Nueva Dirección</a>
</p>

<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Calle</th>
            <th>Ciudad</th>
            <th>Provincia</th>
            <th>País</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var d in Model)
        {
            <tr>
                <td>@Html.Encode(d.CodigoDireccion)</td>
                <td>@Html.Encode(d.Calle)</td>
                <td>@Html.Encode(d.Ciudad)</td>
                <td>@Html.Encode(d.Provincia)</td>
                <td>@Html.Encode(d.Pais)</td>
                <td>
                    <a class="btn btn-info btn-sm" href="@Url.Action("Detalle", new { id = d.CodigoDireccion })" title="Ver" aria-label="Ver dirección @Html.Encode(d.CodigoDireccion)">Ver</a>
                    <a class="btn btn-warning btn-sm" href="@Url.Action("Editar", new { id = d.CodigoDireccion })" title="Editar" aria-label="Editar dirección @Html.Encode(d.CodigoDireccion)">Editar</a>
                    @using (Html.BeginForm("Eliminar", "Direccion", FormMethod.Post, new { @class = "d-inline" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.Hidden("id", d.CodigoDireccion)
                        <button type="submit" class="btn btn-danger btn-sm btn-eliminar" data-id="@Html.Encode(d.CodigoDireccion)" data-nombre="@Html.Encode(d.Calle)" title="Eliminar" aria-label="Eliminar dirección @Html.Encode(d.CodigoDireccion)">Eliminar</button>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script>
        (function(){
            'use strict';
            $(function(){
                $(document).on('click', '.btn-eliminar', function(e){
                    e.preventDefault();
                    var btn = $(this);
                    var form = btn.closest('form');
                    var nombre = btn.data('nombre') || '';

                    Swal.fire({
                        title: '¿Eliminar dirección?🎯',
                        text: nombre,
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonText: 'Eliminar',
                        cancelButtonText: 'Cancelar',
                        reverseButtons: true
                    }).then(function(result){
                        if (result.isConfirmed) form.submit();
                    });
                });
            });
        })();
    </script>
}


