@inherits System.Web.Mvc.WebViewPage<System.Collections.Generic.List<CapaModelo.Parametro>>
@using System.Linq
@{
    ViewBag.Title = "Configuración del Sistema";
    Layout = "~/Views/Shared/_LayoutAOCR.cshtml";
}

<div class="container-fluid py-3">
    <h3 class="mb-3"><i class="fas fa-cogs"></i> @ViewBag.Title</h3>
    <p class="text-muted">Parámetros operativos del proceso AOCR visibles para Dirección/Jefatura.</p>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">No existen parámetros configurados.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-bordered">
                <thead>
                    <tr>
                        <th>Código</th>
                        <th>Nombre</th>
                        <th>Valor</th>
                        <th>Descripción</th>
                        <th>Estado</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td>@p.CodigoParametro</td>
                        <td>@Html.Encode(p.Clave)</td>
                        <td>@Html.Encode(p.Valor)</td>
                        <td>@Html.Encode(p.Descripcion)</td>
                        <td>@(p.Activo ? "Activo" : "Inactivo")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }

    @if (User.IsInRole("Administrador"))
    {
        <a class="btn btn-primary" href="@Url.Action("Index", "Parametro")">Administrar parámetros</a>
    }
</div>
