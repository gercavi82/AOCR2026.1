@inherits System.Web.Mvc.WebViewPage<CapaPresentacion.Models.SolicitudAOCRViewModel>
@using CapaModelo
@using System.Linq
@using System.Web.Mvc
@using System.Web.Mvc.Html
@using System.Web
@{
    Layout = null;
    var sol = Model != null ? Model.Solicitud : null;
    var codigoSolicitud = sol != null ? sol.CodigoSolicitud : 0;
    var usuario = Model != null ? Model.Usuario : null;
    var nombreRepresentanteTecnico = Model != null ? (Model.NombreRepresentanteTecnico ?? "") : "";
    if (string.IsNullOrWhiteSpace(nombreRepresentanteTecnico) && sol != null)
    {
        nombreRepresentanteTecnico = sol.RepresentanteLegal ?? "";
    }
    var identificacionUsuario = Model != null ? (Model.IdentificacionUsuario ?? "") : "";
    var companiaActivaCodigo = Model != null ? (Model.CompaniaActivaCodigo ?? "") : "";
    var companiaActivaNombre = Model != null ? (Model.CompaniaActivaNombre ?? "") : "";
    var companiaSeleccionadaRaw = !string.IsNullOrWhiteSpace(companiaActivaCodigo)
        ? companiaActivaCodigo
        : (((sol != null ? sol.CompaniasSeleccionadas : "") ?? "")
            .Split(new[] { ',', ';', '|' }, StringSplitOptions.RemoveEmptyEntries)
            .Select(v => (v ?? string.Empty).Trim())
            .FirstOrDefault(v => !string.IsNullOrWhiteSpace(v)) ?? "");
    var companiaActivaTexto = !string.IsNullOrWhiteSpace(companiaActivaNombre)
        ? companiaActivaNombre
        : companiaActivaCodigo;
    var codigoOaciInicial = !string.IsNullOrWhiteSpace(sol != null ? sol.CodigoOaci : null)
        ? sol.CodigoOaci
        : companiaSeleccionadaRaw;
    var correoRepresentanteTecnico = !string.IsNullOrWhiteSpace(sol != null ? sol.CorreoRepresentanteTecnico : null)
        ? sol.CorreoRepresentanteTecnico
        : (usuario != null ? usuario.Email : (sol != null ? sol.Email : ""));
    var aprobacionesEspecialesSet = new HashSet<string>(
        ((sol != null ? sol.AprobacionesEspeciales : "") ?? "")
            .Split(new[] { ',', ';', '|'}, StringSplitOptions.RemoveEmptyEntries)
            .Select(v => v.Trim().ToUpperInvariant()),
        StringComparer.OrdinalIgnoreCase);
    var aeropuertosEcuadorSet = new HashSet<string>(
        ((sol != null ? sol.AeropuertosEcuador : "") ?? "")
            .Split(new[] { ',', ';', '|'}, StringSplitOptions.RemoveEmptyEntries)
            .Select(v => v.Trim().ToUpperInvariant()),
        StringComparer.OrdinalIgnoreCase);
    var tipoOperacionNormalizado = ((sol != null ? sol.TipoOperacion : "") ?? "").ToUpperInvariant();
    var marcaOpsRegulares = tipoOperacionNormalizado.Contains("REGULAR");
    var marcaOpsNoRegulares = tipoOperacionNormalizado.Contains("NO REGULAR");
    var marcaPasajeros = tipoOperacionNormalizado.Contains("PASAJEROS");
    var marcaCarga = tipoOperacionNormalizado.Contains("CARGA");
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">

<style>
    .aocr-wizard {
        background-color: #f4f7fa;
        border-radius: 12px;
        padding-top: 0.75rem;
    }

    .aocr-wizard .wizard-sidebar {
        border: 0;
        border-radius: 12px;
        box-shadow: 0 4px 14px rgba(15, 23, 42, 0.08);
        position: sticky;
        top: 10px;
    }

    .aocr-wizard .list-group {
        gap: 6px;
    }

    .aocr-wizard .wizard-step {
        border: 0;
        border-radius: 10px !important;
        color: #4b5563;
        font-weight: 600;
        padding: 0.8rem 0.9rem;
        transition: all .25s ease;
    }

    .aocr-wizard .wizard-step i {
        width: 20px;
        margin-right: 8px;
        text-align: center;
        color: #6b7280;
    }

    .aocr-wizard .wizard-step:hover {
        background: #eaf2ff;
        color: #1b4f72;
    }

    .aocr-wizard .wizard-step.active {
        background: linear-gradient(135deg, #0c7c86 0%, #1b4f72 100%);
        color: #fff;
        box-shadow: 0 8px 18px rgba(12, 124, 134, 0.22);
    }

    .aocr-wizard .wizard-step.active i {
        color: #fff;
    }

    .aocr-wizard .card-custom {
        border: 0;
        border-radius: 12px;
        box-shadow: 0 4px 14px rgba(15, 23, 42, 0.08);
        background-color: #fff;
        margin-bottom: 1rem;
    }

    .aocr-wizard .card-header-custom {
        background: #fff;
        border-bottom: 1px solid #e5e7eb;
        padding: 1rem 1.25rem;
    }

    .aocr-wizard .card-body-custom {
        padding: 1.25rem;
    }

    .aocr-wizard h5.font-weight-bold {
        color: #1f2937;
        border-left: 4px solid #1b4f72;
        padding-left: 10px;
    }

    .aocr-wizard .form-control {
        border-radius: 8px;
        border: 1px solid #d1d5db;
    }

    .aocr-wizard .form-control:focus {
        border-color: #1b4f72;
        box-shadow: 0 0 0 0.2rem rgba(27, 79, 114, 0.15);
    }

    .aocr-wizard .anexo-item {
        background-color: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        padding: 14px;
        margin-bottom: 12px;
        transition: border-color .2s ease, box-shadow .2s ease;
    }

    .aocr-wizard .anexo-item:hover {
        border-color: #93c5fd;
        box-shadow: 0 6px 16px rgba(37, 99, 235, 0.08);
    }

    .aocr-wizard .anexo-item .badge {
        background-color: #1b4f72;
        border-radius: 6px;
    }

    .aocr-wizard .aocr-actions-bar {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 10px;
        margin-top: 14px;
        padding: 14px 0 4px 0;
        border-top: 1px solid #e5e7eb;
    }

    .aocr-wizard .mr-2 {
        margin-right: .5rem !important;
    }

    .aocr-wizard .ml-1 {
        margin-left: .25rem !important;
    }

    @@media (max-width: 991.98px) {
        .aocr-wizard .wizard-sidebar {
            position: static;
        }

        .aocr-wizard .aocr-actions-bar {
            justify-content: center;
            flex-wrap: wrap;
        }
    }
</style>

<div class="container-fluid py-4 aocr-wizard">
    <div class="row">
        <div class="col-md-3 mb-4">
            <div class="card shadow-sm wizard-sidebar">
                <div class="card-body p-2">
                    <div class="list-group" id="list-tab" role="tablist">
                        <a class="list-group-item list-group-item-action wizard-step active" id="list-explotador-list" data-bs-toggle="list" href="#explotador" role="tab" aria-controls="explotador">
                            <i class="fas fa-user-tie"></i> 1. Explotador-Solicitante
                        </a>
                        <a class="list-group-item list-group-item-action wizard-step" id="list-aeronaves-list" data-bs-toggle="list" href="#aeronaves" role="tab" aria-controls="aeronaves">
                            <i class="fas fa-plane"></i> 2. Informacion de Aeronaves
                        </a>
                        <a class="list-group-item list-group-item-action wizard-step" id="list-operaciones-list" data-bs-toggle="list" href="#operaciones" role="tab" aria-controls="operaciones">
                            <i class="fas fa-globe-americas"></i> 3. Operaciones EAE
                        </a>
                        <a class="list-group-item list-group-item-action wizard-step" id="list-comprobante-list" data-bs-toggle="list" href="#comprobante" role="tab" aria-controls="comprobante">
                            <i class="fas fa-receipt"></i> 4. Comprobante
                        </a>
                        <a class="list-group-item list-group-item-action wizard-step" id="list-anexos-list" data-bs-toggle="list" href="#anexos" role="tab" aria-controls="anexos">
                            <i class="fas fa-paperclip"></i> 5. Anexos
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-9">
            <div class="tab-content" id="nav-tabContent">

                <div class="tab-pane fade show active" id="explotador" role="tabpanel" aria-labelledby="list-explotador-list">

                    <div class="card card-custom">
                        <div class="card-header-custom">
                            <h5 class="mb-0 font-weight-bold">Datos del Explotador-Solicitante</h5>
                        </div>
                        <div class="card-body card-body-custom">
                            <div id="contenidoModal">
                                <div style="max-height: 65vh; overflow-y: auto; padding: 5px;">
                                    <form id="formExplotador">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" id="codigoSolicitud" name="Solicitud.CodigoSolicitud" value="@codigoSolicitud" />
                                        <input type="hidden" id="nombreOperador" value="@HttpUtility.HtmlEncode(sol != null ? sol.NombreOperador : "")" />
                                        <input type="hidden" id="telefonoOperador" value="@HttpUtility.HtmlEncode(sol != null ? sol.Telefono : "")" />
                                        <input type="hidden" id="rucOperador" value="@HttpUtility.HtmlEncode(sol != null ? sol.Ruc : "")" />
                                        <input type="hidden" id="razonSocial" value="@HttpUtility.HtmlEncode(sol != null ? sol.RazonSocial : "")" />
                                        <input type="hidden" id="tipoOperacion" value="@HttpUtility.HtmlEncode(sol != null ? sol.TipoOperacion : "")" />
                                        <input type="hidden" id="descripcionOperacion" value="@HttpUtility.HtmlEncode(sol != null ? sol.DescripcionOperacion : "")" />
                                        <input type="hidden" id="observacionesGenerales" value="@HttpUtility.HtmlEncode(sol != null ? sol.ObservacionesGenerales : "")" />
                                        <input type="hidden" id="companiasSeleccionadasRaw" value="@HttpUtility.HtmlEncode(companiaSeleccionadaRaw)" />

                                        <div class="bg-light p-3 rounded mb-4 border">
                                            <h6 class="text-primary font-weight-bold mb-3"><i class="fas fa-user-shield"></i> Representante Técnico en Ecuador</h6>

                                            <div class="form-row">
                                                <div class="form-group col-md-6">
                                                    <label for="nombreRepresentante">Nombre del Representante Técnico</label>
                                                    <input type="text" class="form-control" id="nombreRepresentante" placeholder="Ingrese nombre del representante técnico" value="@HttpUtility.HtmlEncode(nombreRepresentanteTecnico)" >
                                                </div>
                                                <div class="form-group col-md-6">
                                                    <label for="rucRepresentante">Cédula / RUC</label>
                                                    <input type="text" class="form-control" id="rucRepresentante" placeholder="Cédula o RUC del usuario" value="@HttpUtility.HtmlEncode(identificacionUsuario)" readonly>
                                                </div>
                                            </div>

                                            <div class="form-group">
                                                <label for="direccionEcuador">Direccion en Ecuador</label>
                                                <div class="input-group">
                                                    <div class="input-group-prepend">
                                                        <span class="input-group-text"><i class="fas fa-home"></i></span>
                                                    </div>
                                                    <input type="text" class="form-control" id="direccionEcuador" placeholder="Ingrese direccion en Ecuador" value="@HttpUtility.HtmlEncode(sol != null ? sol.Direccion : "")" >
                                                </div>
                                            </div>

                                            <div class="form-row">
                                                <div class="form-group col-md-6">
                                                    <label for="telefonoEcuador">Telefono en Ecuador</label>
                                                    <input type="text" class="form-control" id="telefonoEcuador" placeholder="Ingrese telefono en Ecuador" value="@HttpUtility.HtmlEncode(sol != null ? sol.Telefono : "")" inputmode="numeric" pattern="[0-9]*" maxlength="15" >
                                                </div>
                                                <div class="form-group col-md-6">
                                                    <label for="emailEcuador">Correo del Representante Técnico</label>
                                                    <input type="email" class="form-control" id="emailEcuador" placeholder="Ingrese correo del representante técnico" value="@HttpUtility.HtmlEncode(correoRepresentanteTecnico)" >
                                                </div>
                                            </div>
                                        </div>

                                        <div class="card shadow-sm mb-4">
                                            <div class="card-body">
                                                <h6 class="text-primary font-weight-bold mb-3"><i class="fas fa-building"></i> Compañía activa del trámite</h6>

                                                <div class="form-group mb-3">
                                                    <label for="companiaActivaVista">Compañía seleccionada</label>
                                                    <input type="text"
                                                           class="form-control"
                                                           id="companiaActivaVista"
                                                           value="@HttpUtility.HtmlEncode(companiaActivaTexto)"
                                                           readonly />
                                                </div>

                                                <div class="form-group mb-0">
                                                    <label for="companiaActivaCodigoVista">Código de compañía (OACI)</label>
                                                    <input type="text"
                                                           class="form-control"
                                                           id="companiaActivaCodigoVista"
                                                           value="@HttpUtility.HtmlEncode(codigoOaciInicial)"
                                                           readonly />
                                                </div>
                                                <input type="hidden"
                                                       id="codigoOaci"
                                                       value="@HttpUtility.HtmlEncode(codigoOaciInicial)" />
                                            </div>
                                        </div>

                                        <div class="bg-light p-3 rounded border">
                                            <h6 class="text-primary font-weight-bold mb-3">Datos de la Compania Principal</h6>
                                            <div class="form-group">
                                                <label for="razonSocialCompania">Razon social de la compania *</label>
                                                <input type="text" class="form-control" id="razonSocialCompania" placeholder="Ingrese razon social de la compania" value="@HttpUtility.HtmlEncode(sol != null ? sol.RazonSocial : "")" >
                                            </div>

                                            <div class="form-group">
                                                <label for="nombreCompania">Nombre comercial de la compania *</label>
                                                <input type="text" class="form-control" id="nombreCompania" placeholder="Ingrese nombre comercial de la compania" value="@HttpUtility.HtmlEncode(sol != null ? (sol.NombreComercial ?? sol.NombreOperador) : companiaActivaTexto)" >
                                                <small class="form-text text-muted mt-2">
                                                    Los datos de la compania no son correctos?
                                                    <a href="#" id="btnInformacionCompania" class="text-danger font-weight-bold ml-1"><i class="fas fa-exclamation-triangle"></i> Reportar aqui</a>
                                                </small>
                                            </div>

                                            <div class="form-group">
                                                <label for="direccionCompania">Direccion de la Compania</label>
                                                <input type="text" class="form-control" id="direccionCompania" placeholder="Ingrese direccion de la compania" value="@HttpUtility.HtmlEncode(sol != null ? sol.Direccion : "")" >
                                            </div>

                                            <div class="form-row">
                                                <div class="form-group col-md-6">
                                                    <label for="telefonoCompania">Telefono</label>
                                                    <input type="text" class="form-control" id="telefonoCompania" placeholder="Ingrese telefono" value="@HttpUtility.HtmlEncode(sol != null ? sol.Telefono : "")" inputmode="numeric" pattern="[0-9]*" maxlength="15" >
                                                </div>
                                                <div class="form-group col-md-6">
                                                    <label for="correoCompania">Correo Electronico</label>
                                                    <input type="email" class="form-control" id="correoCompania" placeholder="Ingrese correo" value="@HttpUtility.HtmlEncode(sol != null ? sol.Email : "")" >
                                                </div>
                                            </div>
                                        </div>

                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="tab-pane fade" id="aeronaves" role="tabpanel" aria-labelledby="list-aeronaves-list">
                    <div class="card card-custom">
                        <div class="card-header-custom d-flex justify-content-between align-items-center">
                            <h5 class="mb-0 font-weight-bold">Informacion de las Aeronaves</h5>
                        </div>
                        <div class="card-body card-body-custom">
                            <div style="max-height: 65vh; overflow-y: auto; padding-right: 5px;">
                                <div class="alert alert-info mb-3">
                                    <i class="fas fa-info-circle mr-1"></i>
                                    La informacion de aeronaves debe registrarse completa y esta sujeta a confirmacion de matriculas por la autoridad.
                                </div>

                                <div class="mb-4 p-3 bg-light rounded border">
                                    <h6 class="text-muted mb-3"><small>Gestion de Flota</small></h6>
                                    <div class="d-flex flex-wrap align-items-center">
                                        <button class="btn btn-success shadow-sm mr-2 mb-2" id="btnAgregarAeronave">
                                            <i class="fas fa-plus-circle"></i> Agregar Manualmente
                                        </button>

                                        <button class="btn btn-primary shadow-sm mr-2 mb-2" id="btnCargarArchivo">
                                            <i class="fas fa-file-upload"></i> Cargar CSV
                                        </button>

                                        <div class="btn-group mb-2 mr-2">
                                            <a href="@Url.Content("~/Content/documents/Formato_Aeronaves.xlsx")" download class="btn btn-outline-secondary">
                                                <i class="fas fa-download"></i> Descargar Formato
                                            </a>
                                            <button class="btn btn-outline-secondary" onclick="window.open('@Url.Content("~/Content/documents/Formato_Aeronaves.xlsx")', '_blank')" title="Ver instrucciones">
                                                <i class="fas fa-question-circle"></i>
                                            </button>
                                        </div>

                                        <input type="file" id="inputArchivo" accept=".csv" style="display: none;">
                                    </div>
                                    <small class="text-muted mt-2 d-block">
                                        <i class="fas fa-info-circle text-info"></i>
                                        Solo se permite formato <strong>.csv</strong> (separado por <code>;</code>).
                                    </small>
                                </div>

                                <div class="table-responsive shadow-sm rounded mb-3">
                                    <table class="table table-bordered table-hover mb-0" id="tablaAeronaves" style="font-size: 14px;">
                                        <thead class="bg-dark text-white text-center">
                                            <tr>
                                                <th>Fabricante</th>
                                                <th>Modelo</th>
                                                <th>Serie</th>
                                                <th>Matricula</th>
                                                <th>Config.</th>
                                                <th>Etapa Ruido</th>
                                                <th>Peso</th>
                                                <th>OACI</th>
                                                <th><i class="fas fa-cogs"></i></th>
                                            </tr>
                                        </thead>
                                        <tbody></tbody>
                                    </table>
                                </div>

                                <div class="form-group mt-3">
                                    <label for="contadorAeronaves" class="font-weight-bold text-secondary">Resumen de Flota</label>
                                    <textarea class="form-control" id="contadorAeronaves" rows="3" readonly disabled style="background-color: #e9ecef; border:none; color: #495057;"></textarea>
                                </div>

                                <div class="bg-light p-3 rounded border mb-3">
                                    <label class="font-weight-bold d-block mb-2">Aprobaciones especiales aplicables en operaciones en Ecuador</label>
                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="custom-control custom-checkbox mb-2">
                                                <input class="custom-control-input aprobacion-especial" type="checkbox" id="aprobacionRVSM" value="RVSM" @(aprobacionesEspecialesSet.Contains("RVSM") ? "checked" : "")>
                                                <label class="custom-control-label" for="aprobacionRVSM">RVSM</label>
                                            </div>
                                            <div class="custom-control custom-checkbox mb-2">
                                                <input class="custom-control-input aprobacion-especial" type="checkbox" id="aprobacionPBN" value="PBN" @(aprobacionesEspecialesSet.Contains("PBN") ? "checked" : "")>
                                                <label class="custom-control-label" for="aprobacionPBN">PBN</label>
                                            </div>
                                            <div class="custom-control custom-checkbox mb-2">
                                                <input class="custom-control-input aprobacion-especial" type="checkbox" id="aprobacionMNPS" value="MNPS" @(aprobacionesEspecialesSet.Contains("MNPS") ? "checked" : "")>
                                                <label class="custom-control-label" for="aprobacionMNPS">MNPS</label>
                                            </div>
                                            <div class="custom-control custom-checkbox mb-2">
                                                <input class="custom-control-input aprobacion-especial" type="checkbox" id="aprobacionCATIIIII" value="CAT II-III" @(aprobacionesEspecialesSet.Contains("CAT II-III") ? "checked" : "")>
                                                <label class="custom-control-label" for="aprobacionCATIIIII">CAT II-III</label>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="custom-control custom-checkbox mb-2">
                                                <input class="custom-control-input aprobacion-especial" type="checkbox" id="aprobacionETOPS" value="ETOPS" @(aprobacionesEspecialesSet.Contains("ETOPS") ? "checked" : "")>
                                                <label class="custom-control-label" for="aprobacionETOPS">ETOPS</label>
                                            </div>
                                            <div class="custom-control custom-checkbox mb-2">
                                                <input class="custom-control-input aprobacion-especial" type="checkbox" id="aprobacionMERPEL" value="MERPEL" @(aprobacionesEspecialesSet.Contains("MERPEL") ? "checked" : "")>
                                                <label class="custom-control-label" for="aprobacionMERPEL">MERPEL</label>
                                            </div>
                                            <div class="custom-control custom-checkbox mb-2">
                                                <input class="custom-control-input aprobacion-especial" type="checkbox" id="aprobacionOTROS" value="OTROS" @(aprobacionesEspecialesSet.Contains("OTROS") ? "checked" : "")>
                                                <label class="custom-control-label" for="aprobacionOTROS">OTROS</label>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group mb-0 mt-2" id="aprobacionOtrosContenedor" style="display:none;">
                                        <label for="aprobacionOtrosDetalle">Detalle otros</label>
                                        <input type="text" class="form-control" id="aprobacionOtrosDetalle" maxlength="250" value="@HttpUtility.HtmlEncode(sol != null ? sol.AprobacionesEspecialesOtros : "")" placeholder="Detalle de aprobaciones especiales adicionales" />
                                    </div>
                                </div>

                                <div class="text-right mt-4">
                                    <button type="button" class="btn btn-lg btn-primary shadow" id="btnGuardarListadoAeronaves">
                                        <i class="fas fa-save"></i> Guardar Flota
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="tab-pane fade" id="operaciones" role="tabpanel" aria-labelledby="list-operaciones-list">
                    <div class="card card-custom">
                        <div class="card-header-custom">
                            <h5 class="mb-0 font-weight-bold">Operaciones en el Ecuador</h5>
                        </div>
                        <div class="card-body card-body-custom">

                            <div class="form-group row">
                                <label for="fechaInicioOperaciones" class="col-sm-4 col-form-label font-weight-bold">Fecha propuesta inicio:</label>
                                <div class="col-sm-8">
                                    <input type="date" class="form-control" id="fechaInicioOperaciones">
                                </div>
                            </div>

                            <div class="card mb-3 border-info">
                                <div class="card-header bg-white text-info font-weight-bold">
                                    <i class="fas fa-list-ul"></i> Tipos de Operacion
                                </div>
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="custom-control custom-checkbox mb-2">
                                                <input class="custom-control-input" type="checkbox" id="opsRegulares" @(marcaOpsRegulares ? "checked" : "")>
                                                <label class="custom-control-label" for="opsRegulares">Operaciones Regulares</label>
                                            </div>
                                            <div class="custom-control custom-checkbox mb-2">
                                                <input class="custom-control-input" type="checkbox" id="opsNoRegulares" @(marcaOpsNoRegulares ? "checked" : "")>
                                                <label class="custom-control-label" for="opsNoRegulares">Operaciones No Regulares</label>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="custom-control custom-checkbox mb-2">
                                                <input class="custom-control-input" type="checkbox" id="pasajeros" @(marcaPasajeros ? "checked" : "")>
                                                <label class="custom-control-label" for="pasajeros">Pasajeros/Carga/Correo</label>
                                            </div>
                                            <div class="custom-control custom-checkbox mb-2">
                                                <input class="custom-control-input" type="checkbox" id="carga" @(marcaCarga ? "checked" : "")>
                                                <label class="custom-control-label" for="carga">Carga solamente</label>
                                            </div>
                                        </div>
                                    </div>
