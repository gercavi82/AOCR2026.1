  function validarDocumentosObligatorios() {
    const obligatorios = [
      { id: 'archivoFacturaPago', nombre: 'Comprobante de pago' },
      { id: 'archivoAOC', nombre: 'Copia de AOC valida' },
      { id: 'archivoOpSpecs', nombre: 'OpSpecs' },
      { id: 'archivoManualOperaciones', nombre: 'Manual de Operaciones' },
      { id: 'archivoPermisoOperacion', nombre: 'Permiso Operacion C.N.A.C' },
      { id: 'archivoCertificadoRuido', nombre: 'Certificado de Ruido de Aeronaves' },
      { id: 'archivoCertificadoAeronavegabilidad', nombre: 'Certificado de Aeronavegabilidad' },
      { id: 'archivoPoderRepresentante', nombre: 'Copia certificada del poder del representante legal en Ecuador' }
    ];

    const faltantes = obligatorios.filter(function (item) {
      const input = document.getElementById(item.id);
      return !input || !input.files || input.files.length === 0;
    });

    if (faltantes.length > 0) {
      Swal.fire({
        title: 'Documentos obligatorios pendientes',
        text: 'Faltan: ' + faltantes.map(function (f) { return f.nombre; }).join(', '),
        icon: 'warning',
        confirmButtonText: 'OK'
      });
      return false;
    }

    return true;
  }

