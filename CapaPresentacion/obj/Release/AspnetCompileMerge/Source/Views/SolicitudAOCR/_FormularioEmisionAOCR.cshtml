<script>
  function guardarFlota() {
    const codigoSolicitud = parseInt($('#codigoSolicitud').val() || '0', 10) || 0;
    const aeronaves = obtenerAeronavesDesdeTabla();

    if (codigoSolicitud <= 0) {
      Swal.fire({
        title: 'Guardar Flota',
        text: 'Primero debe guardar la solicitud para obtener un codigo valido.',
        icon: 'warning',
        confirmButtonText: 'OK'
      });
      return;
    }

    if (aeronaves.length === 0) {
      Swal.fire({
        title: 'Guardar Flota',
        text: 'Debe ingresar al menos una aeronave valida antes de guardar.',
        icon: 'warning',
        confirmButtonText: 'OK'
      });
      return;
    }

    const token = $('input[name="__RequestVerificationToken"]').val();
    const payload = {
      CodigoSolicitud: codigoSolicitud,
      Aeronaves: aeronaves
    };

    $('#btnGuardarListadoAeronaves').prop('disabled', true);
    Swal.fire({ title: 'Guardando flota...', allowOutsideClick: false, didOpen: function () { Swal.showLoading(); } });

    $.ajax({
      url: '@Url.Action("GuardarFlota", "SolicitudAOCR")',
      type: 'POST',
      data: JSON.stringify(payload),
      contentType: 'application/json; charset=utf-8',
      dataType: 'json',
      timeout: 30000,
      beforeSend: function (xhr) {
        if (token) {
          xhr.setRequestHeader('RequestVerificationToken', token);
        }
      }
    }).done(function (response) {
      if (response && response.success) {
        Swal.fire({
          title: 'Flota guardada',
          text: response.message || 'La flota se guardo correctamente.',
          icon: 'success',
          confirmButtonText: 'OK'
        });
      } else {
        Swal.fire({
          title: 'No se pudo guardar la flota',
          text: (response && response.message) ? response.message : 'Error no controlado.',
          icon: 'error',
          confirmButtonText: 'OK'
        });
      }
    }).fail(function (xhr, status, error) {
      const mensaje = status === 'timeout'
        ? 'La solicitud tardo demasiado tiempo. Intente nuevamente.'
        : ('Error al guardar flota: ' + (error || xhr.statusText || 'desconocido'));
      Swal.fire({
        title: 'Error',
        text: mensaje,
        icon: 'error',
        confirmButtonText: 'OK'
      });
    }).always(function () {
      $('#btnGuardarListadoAeronaves').prop('disabled', false);
      Swal.close();
    });
  }

  function guardarFormulario(){
    var aeronaves = obtenerAeronavesDesdeTabla();

        if (!esTelefonoNumericoValido($('#telefonoEcuador').val() || $('#telefonoCompania').val())) {
            Swal.fire({
                title: 'Validacion',
                text: 'El telefono debe contener solo numeros y tener entre 6 y 15 digitos.',
                icon: 'warning',
                confirmButtonText: 'OK'
            });
            return;
        }
    
    // Validacion: debe haber al menos una aeronave
    if (aeronaves.length === 0) {
      Swal.fire({
        title: 'Validacion',
        text: 'Por favor, agregue al menos una aeronave. Puede cargar un CSV o agregar manualmente.',
        icon: 'warning',
        confirmButtonText: 'OK'
      });
      return;
    }

    if (!validarDocumentosObligatorios()) {
      return;
    }
    
    // Mapear campos de UI a valores
    var datosMapeados = mapearCamposVM();
    console.log('Datos mapeados:', datosMapeados);
    
    // Actualizar array global
    window.aeronavesSeleccionadas = aeronaves;
    
    // Obtener codigo de solicitud (si existe)
    var codigoSolicitud = 0;
    var solInput = $('input[name="Solicitud.CodigoSolicitud"], #codigoSolicitud');
    if (solInput.length > 0 && solInput.val()) {
      codigoSolicitud = parseInt(solInput.val()) || 0;
    } else if (@codigoSolicitud > 0) {
      codigoSolicitud = @codigoSolicitud;
    }
    
    // Construir viewmodel completo
    const vm = {
      Solicitud: {
        CodigoSolicitud: codigoSolicitud,
        NombreOperador: datosMapeados.NombreOperador || '',
                CodigoOaci: datosMapeados.CodigoOaci || '',
        RepresentanteLegal: datosMapeados.RepresentanteLegal || '',
        CedulaRepresentante: datosMapeados.CedulaRepresentante || '',
        CorreoRepresentanteTecnico: datosMapeados.CorreoRepresentanteTecnico || '',
        Direccion: datosMapeados.Direccion || '',
        Telefono: datosMapeados.Telefono || '',
        Email: datosMapeados.Email || '',
        Ruc: datosMapeados.Ruc || '',
        RazonSocial: datosMapeados.RazonSocial || '',
        NombreComercial: datosMapeados.NombreComercial || '',
        TipoOperacion: datosMapeados.TipoOperacion || '',
        DescripcionOperacion: datosMapeados.DescripcionOperacion || '',
        ResumenOperacionesEae: datosMapeados.ResumenOperacionesEae || '',
        AprobacionesEspeciales: datosMapeados.AprobacionesEspeciales || '',
        AprobacionesEspecialesOtros: datosMapeados.AprobacionesEspecialesOtros || '',
        AeropuertosEcuador: datosMapeados.AeropuertosEcuador || '',
        AeropuertosEcuadorOtros: datosMapeados.AeropuertosEcuadorOtros || '',
        CompaniasSeleccionadas: datosMapeados.CompaniasSeleccionadas || '',
        ObservacionesGenerales: datosMapeados.ObservacionesGenerales || '',
        Estado: 'BORRADOR',
        TipoSolicitud: 1
      },
      Banco: $('#banco').val() || '',
      NumeroComprobante: $('#numeroComprobante').val() || '',
      DocumentosCarga: construirMetadatosDocumentos(),
      Aeronaves: aeronaves
    };
    
    // Interceptar XHR para debugging (solo si window.AOCR_DEBUG === true)
    if (window.AOCR_DEBUG) {
        const originalXHR = window.XMLHttpRequest;
        function createInterceptingXHR() {
            const xhr = new originalXHR();
            const originalSend = xhr.send;
            xhr.send = function (data) {
                console.log('=== XHR ENVIANDO ===', { data: data });
                const originalOnReadyStateChange = this.onreadystatechange;
                this.onreadystatechange = function () {
                    if (this.readyState === 4) {
                        console.log('=== XHR RESPUESTA CRUDA ===');
                        console.log('Status:', this.status);
                        console.log('Status Text:', this.statusText);
                        try { console.log('Response Headers:', this.getAllResponseHeaders()); } catch (e) { }
                        try { console.log('Response Text (primeros 1000 chars):', this.responseText ? this.responseText.substring(0, 1000) : ''); } catch (e) { }
                        if (this.responseText && (this.responseText.indexOf('<!DOCTYPE') !== -1 || this.responseText.indexOf('<html') !== -1)) {
                            console.error('SERVIDOR DEVOLVIENDO HTML EN LUGAR DE JSON!');
                        }
                    }
                    if (originalOnReadyStateChange) originalOnReadyStateChange.apply(this, arguments);
                };
                return originalSend.apply(this, arguments);
            };
            return xhr;
        }
        window.XMLHttpRequest = createInterceptingXHR;
    }
    
    // Log para debugging
    console.log('Enviando datos:', vm);
    console.log('Total de aeronaves:', aeronaves.length);
    
    // Obtener token antiforgery (se añade automáticamente en cabecera por $.ajaxSetup)

    var vmJson = null;
    try {
        vmJson = JSON.stringify(vm);
    } catch (e) {
        console.error('Error serializando datos:', e);
        Swal.fire('Error', 'No se pudo preparar los datos para el envio.', 'error');
        return;
    }

    if (vmJson.length > 5 * 1024 * 1024) { // 5MB
        Swal.fire('Error', 'Los datos a enviar son demasiado grandes. Reduzca la cantidad de aeronaves o archivos.', 'error');
        return;
    }

    const token = $('input[name="__RequestVerificationToken"]').val() || '';
    const formData = new FormData();
    formData.append('__RequestVerificationToken', token);
    formData.append('vmJson', vmJson);
    // Fallback de binder para campos críticos (si vmJson no se parsea por cualquier motivo).
    formData.append('Solicitud.CodigoSolicitud', String(vm.Solicitud.CodigoSolicitud || 0));
    formData.append('Solicitud.RazonSocial', vm.Solicitud.RazonSocial || '');
    formData.append('Solicitud.NombreComercial', vm.Solicitud.NombreComercial || '');
    formData.append('Solicitud.NombreOperador', vm.Solicitud.NombreOperador || '');
    formData.append('Solicitud.CompaniasSeleccionadas', vm.Solicitud.CompaniasSeleccionadas || '');

    const inputsArchivos = [
      'archivoAOC',
      'archivoOpSpecs',
      'archivoManualOperaciones',
      'archivoPermisoOperacion',
      'archivoCertificadoRuido',
      'archivoCertificadoAeronavegabilidad',
      'archivoPoderRepresentante',
      'archivoFacturaPago',
      'archivoOtro'
    ];
    inputsArchivos.forEach(function (inputId) {
      const input = document.getElementById(inputId);
      if (input && input.files && input.files.length > 0) {
        formData.append(inputId, input.files[0]);
      }
    });

    // Mostrar loading y deshabilitar boton
    $('#btnGuardarListadoAeronaves').prop('disabled', true);
    Swal.fire({ title: 'Guardando...', allowOutsideClick: false, didOpen: () => Swal.showLoading() });

    $.ajax({
      url: '@Url.Action("FormularioCompleto", "SolicitudAOCR")',
      type: 'POST',
      data: formData,
      processData: false,
      contentType: false,
      dataType: 'json',
      timeout: 30000,
      beforeSend: function () {
          $('#btnGuardarListadoAeronaves').prop('disabled', true);
      },
      success: function (r, textStatus, xhr) {
        console.log('=== RESPUESTA EXITOSA ===');
        console.log('Status:', xhr.status);
        console.log('Content-Type:', xhr.getResponseHeader('Content-Type'));
        console.log('Response Headers:', xhr.getAllResponseHeaders());
        console.log('Raw Response:', xhr.responseText);
        console.log('Parsed Response:', r);

        if (typeof r === 'object' && r !== null) {
          if (r.success === true) {
            Swal.fire({
              title: 'Exito',
              text: r.mensaje || 'Solicitud guardada correctamente',
              icon: 'success',
              confirmButtonText: 'OK'
            }).then(() => {
              if (r.id && r.id > 0) {
                window.location.href = '@Url.Action("Detalle", "SolicitudAOCR")/' + r.id;
              } else {
                window.location.href = '@Url.Action("MisSolicitudes", "SolicitudAOCR")';
              }
            });
          } else {
            console.log('Success es false:', r.mensaje);
            Swal.fire({ title: 'Error', text: r.mensaje || 'Error al guardar la solicitud', icon: 'error' });
          }
        } else {
          console.error('Respuesta no es JSON valido:', typeof r, r);
          Swal.fire('Error', 'El servidor respondio con un formato invalido.', 'error');
        }
      },
      error: function (xhr, status, error) {
        console.error('Error AJAX:', { status: xhr.status, statusText: xhr.statusText, error: error });
        console.error('Respuesta del servidor:', xhr.responseText);

        let payload = null;
        if (xhr && xhr.responseJSON && typeof xhr.responseJSON === 'object') {
          payload = xhr.responseJSON;
        } else if (xhr && xhr.responseText) {
          try {
            payload = JSON.parse(xhr.responseText);
          } catch (e) {
            payload = null;
          }
        }

        let mensajeError = payload && payload.mensaje
          ? payload.mensaje
          : 'No se pudo guardar la solicitud.';

        if (status === 'timeout') {
          mensajeError = 'La solicitud tardo demasiado tiempo. Intente nuevamente.';
        } else if (xhr.status === 0) {
          mensajeError = 'Error de conexion. Verifique su conexion a internet.';
        } else if (xhr.status === 401) {
          if (!payload || !payload.mensaje) {
            mensajeError = 'Su sesion ha expirado. Por favor, inicie sesion nuevamente.';
          }
          setTimeout(() => window.location.href = '@Url.Action("Login", "Account")', 2000);
        } else if (xhr.status === 403) {
          if (!payload || !payload.mensaje) {
            mensajeError = 'No tiene permisos para realizar esta accion.';
          }
        } else if (xhr.status === 500) {
          if (!payload || !payload.mensaje) {
            mensajeError = 'Error interno del servidor. Intente mas tarde.';
          }
          console.error('Respuesta completa del servidor:', xhr.responseText);
          if (xhr.responseText && (xhr.responseText.includes('<html') || xhr.responseText.includes('<!DOCTYPE'))) {
            console.error('RESPUESTA HTML RECIBIDA - Primeros 1000 caracteres:', xhr.responseText.substring(0, 1000));
          }
        } else if (error === 'parsererror') {
          mensajeError = 'El servidor respondio con un formato invalido. Contacte al administrador.';
          console.error('Error de parseo JSON:', xhr.responseText ? xhr.responseText.substring(0, 500) : 'sin respuesta');
        } else if (!payload || !payload.mensaje) {
          mensajeError = 'Error: ' + (error || 'Desconocido');
        }

        if (payload && payload.sqlState) {
          console.error('SQLSTATE backend:', payload.sqlState);
        }

        Swal.fire('Error', mensajeError, 'error');
      },
      complete: function () {
        $('#btnGuardarListadoAeronaves').prop('disabled', false);
        Swal.close();
      }
    });
  }
</script>































