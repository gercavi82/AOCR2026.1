        Serie: $tr.find('td').eq(2).text().trim(),
        Matricula: $tr.find('td').eq(3).text().trim(),
        Configuracion: $tr.find('td').eq(4).text().trim(),
        EtapaRuido: $tr.find('td').eq(5).text().trim()
      };

