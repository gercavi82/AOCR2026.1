@inherits System.Web.Mvc.WebViewPage<CapaDatos.Entidades.ControlFR3>
@using System.Web.Mvc
@using System.Web.Mvc.Html
@{
    ViewBag.Title = "Nuevo Control FR3";
    Layout = "~/Views/Shared/_LayoutAOCR.cshtml";
}

<div class="container-fluid px-4 mt-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3 class="fw-bold text-primary mb-0">
                <i class="fas fa-plus-circle me-2"></i>Nuevo Control FR3
            </h3>
            <small class="text-muted">Complete los datos del vuelo charter/especial</small>
        </div>
        <a href="@Url.Action("Index")" class="btn btn-outline-secondary btn-sm">
            <i class="fas fa-arrow-left me-1"></i> Volver
        </a>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            @Html.ValidationSummary(true)
        </div>
    }

    @using (Html.BeginForm("Nuevo", "ControlFR3", FormMethod.Post, new { @class = "needs-validation", novalidate = "novalidate" }))
    {
        @Html.AntiForgeryToken()

        <div class="row">
            <!-- Datos del vuelo -->
            <div class="col-md-6 mb-3">
                <div class="card shadow-sm">
                    <div class="card-header bg-primary text-white py-2">
                        <i class="fas fa-plane me-1"></i> Datos del Vuelo
                    </div>
                    <div class="card-body">
                        <div class="row g-2">
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Aeropuerto <span class="text-danger">*</span></label>
                                @Html.DropDownListFor(m => m.Aeropuerto, ViewBag.Aeropuertos as IEnumerable<SelectListItem>, new { @class = "form-select form-select-sm", required = "required" })
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Año</label>
                                @Html.TextBoxFor(m => m.Anio, new { @class = "form-control form-control-sm", maxlength = 4, @readonly = "readonly" })
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Matrícula <span class="text-danger">*</span></label>
                                @Html.TextBoxFor(m => m.Matricula, new { @class = "form-control form-control-sm", required = "required", placeholder = "HC-XXXX" })
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Modelo</label>
                                @Html.TextBoxFor(m => m.Modelo, new { @class = "form-control form-control-sm", placeholder = "Boeing 737" })
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Peso Matrícula (kg)</label>
                                @Html.TextBoxFor(m => m.PesoMatricula, new { @class = "form-control form-control-sm", type = "number", step = "0.01" })
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Callsign</label>
                                @Html.TextBoxFor(m => m.Callsign, new { @class = "form-control form-control-sm" })
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Tipo Operación</label>
                                @Html.DropDownListFor(m => m.TipoOperacion, ViewBag.TiposOperacion as IEnumerable<SelectListItem>, new { @class = "form-select form-select-sm" })
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Nacional/Internacional</label>
                                @Html.DropDownListFor(m => m.NacInter, ViewBag.NacInter as IEnumerable<SelectListItem>, new { @class = "form-select form-select-sm" })
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-bold">Origen</label>
                                @Html.TextBoxFor(m => m.Origen, new { @class = "form-control form-control-sm", placeholder = "UIO" })
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-bold">Destino</label>
                                @Html.TextBoxFor(m => m.Destino, new { @class = "form-control form-control-sm", placeholder = "GYE" })
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-bold">Retorno</label>
                                @Html.TextBoxFor(m => m.Retorno, new { @class = "form-control form-control-sm" })
                            </div>
                            <div class="col-md-12">
                                <label class="form-label small fw-bold">Ruta Total Plan de Vuelo</label>
                                @Html.TextBoxFor(m => m.RutaTotalPlanVlo, new { @class = "form-control form-control-sm", placeholder = "UIO-GYE-UIO" })
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Fecha Control Vuelo</label>
                                @Html.TextBoxFor(m => m.FechaControlVuelo, new { @class = "form-control form-control-sm", type = "date" })
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">No. Aterrizajes País</label>
                                @Html.TextBoxFor(m => m.NumAterrizaPais, new { @class = "form-control form-control-sm", type = "number", min = 0 })
                            </div>
                            <div class="col-md-12">
                                <label class="form-label small fw-bold">Autorización</label>
                                @Html.TextBoxFor(m => m.Autorizacion, new { @class = "form-control form-control-sm" })
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Datos del cliente -->
            <div class="col-md-6 mb-3">
                <div class="card shadow-sm">
                    <div class="card-header bg-success text-white py-2">
                        <i class="fas fa-building me-1"></i> Datos del Cliente
                    </div>
                    <div class="card-body">
                        <div class="row g-2">
                            <div class="col-md-12">
                                <label class="form-label small fw-bold">Compañía</label>
                                @Html.TextBoxFor(m => m.NombreCia, new { @class = "form-control form-control-sm" })
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Código OACI</label>
                                @Html.TextBoxFor(m => m.CodigoOACICia, new { @class = "form-control form-control-sm" })
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">RUC <span class="text-danger">*</span></label>
                                @Html.TextBoxFor(m => m.Ruc, new { @class = "form-control form-control-sm", required = "required", maxlength = 13 })
                            </div>
                            <div class="col-md-12">
                                <label class="form-label small fw-bold">Nombre Cliente</label>
                                @Html.TextBoxFor(m => m.NombreCliente, new { @class = "form-control form-control-sm" })
                            </div>
                            <div class="col-md-12">
                                <label class="form-label small fw-bold">Dirección</label>
                                @Html.TextBoxFor(m => m.Direccion, new { @class = "form-control form-control-sm" })
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Teléfono</label>
                                @Html.TextBoxFor(m => m.Telefono, new { @class = "form-control form-control-sm", inputmode = "numeric", pattern = "[0-9]*", maxlength = "15", autocomplete = "off", oninput = "this.value=this.value.replace(/\\D/g,'').slice(0,15);" })
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Email</label>
                                @Html.TextBoxFor(m => m.Email, new { @class = "form-control form-control-sm", type = "email" })
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Datos económicos -->
                <div class="card shadow-sm mt-3">
                    <div class="card-header bg-warning py-2">
                        <i class="fas fa-dollar-sign me-1"></i> Datos Económicos
                    </div>
                    <div class="card-body">
                        <div class="row g-2">
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Valor Charter</label>
                                @Html.TextBoxFor(m => m.ValorCharter, new { @class = "form-control form-control-sm", type = "number", step = "0.01", min = 0 })
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">SubTotal</label>
                                @Html.TextBoxFor(m => m.SubTotal, new { @class = "form-control form-control-sm", type = "number", step = "0.01", min = 0 })
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Total</label>
                                @Html.TextBoxFor(m => m.Total, new { @class = "form-control form-control-sm", type = "number", step = "0.01", min = 0 })
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Gran Total <span class="text-danger">*</span></label>
                                @Html.TextBoxFor(m => m.GranTotal, new { @class = "form-control form-control-sm", type = "number", step = "0.01", min = 0.01, required = "required" })
                            </div>
                            <div class="col-md-12">
                                <label class="form-label small fw-bold">Gran Total en Letras</label>
                                @Html.TextBoxFor(m => m.GranTotalLetras, new { @class = "form-control form-control-sm" })
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Forma de Pago</label>
                                @Html.DropDownListFor(m => m.FormaPago, ViewBag.FormasPago as IEnumerable<SelectListItem>, new { @class = "form-select form-select-sm" })
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Código Banco</label>
                                @Html.TextBoxFor(m => m.CodigoBanco, new { @class = "form-control form-control-sm" })
                            </div>
                            <div class="col-md-12">
                                <label class="form-label small fw-bold">Observación</label>
                                @Html.TextAreaFor(m => m.Observacion, new { @class = "form-control form-control-sm", rows = 2 })
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Botones -->
        <div class="d-flex gap-2 mb-4">
            <button type="submit" class="btn btn-primary">
                <i class="fas fa-save me-1"></i> Guardar Control FR3
            </button>
            <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
                <i class="fas fa-times me-1"></i> Cancelar
            </a>
        </div>
    }
</div>
