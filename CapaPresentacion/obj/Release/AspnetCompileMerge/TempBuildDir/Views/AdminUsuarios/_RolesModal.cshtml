@model CapaPresentacion.Models.AdminUsuarios.AdminUsuarioRolesViewModel

<div class="modal fade" id="rolesModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Roles del usuario @Model.CodigoUsuario</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <p class="text-muted mb-2">@Model.NombreCompleto</p>
                <div class="row">
                    @foreach (var rol in Model.RolesDisponibles)
                    {
                        <div class="col-md-4 mb-2">
                            <div class="form-check">
                                <input class="form-check-input"
                                       type="checkbox"
                                       disabled="disabled"
                                       @(rol.Selected ? "checked" : null) />
                                <label class="form-check-label">@rol.Text</label>
                            </div>
                        </div>
                    }
                </div>
            </div>
            <div class="modal-footer">
                <a class="btn btn-primary" href="@Url.Action("Roles", "AdminUsuarios", new { id = Model.IdUsuario })">Editar roles</a>
            </div>
        </div>
    </div>
</div>
