@inherits System.Web.Mvc.WebViewPage<CapaModelo.Certificado>
@using CapaModelo
@using System.Web.Mvc
@using System.Web.Mvc.Html

<h2>Certificado AOCR</h2>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}
@if (TempData["OK"] != null)
{
    <div class="alert alert-success">@TempData["OK"]</div>
}

<div class="mb-3">
    <a class="btn btn-success" href="@Url.Action("GenerarCertificadoPdf", new { solicitudId = ViewBag.SolicitudId })" target="_blank">
        <i class="fas fa-file-pdf"></i> Generar PDF Certificado
    </a>
    <a class="btn btn-outline-secondary" href="@Url.Action("VistaPreviaCertificado", new { solicitudId = ViewBag.SolicitudId })" target="_blank">
        <i class="fas fa-eye"></i> Vista Previa
    </a>
</div>

@if (Model == null)
{
    <div class="alert alert-info">
        No existe registro de certificado en BD.
        <a class="btn btn-sm btn-primary" href="@Url.Action("Generar", new { solicitudId = ViewBag.SolicitudId })">
            Crear Registro
        </a>
        <small class="text-muted d-block mt-1">Nota: El PDF se genera directamente desde los datos de la solicitud, no requiere registro previo.</small>
    </div>
}
else
{
    <table class="table table-bordered">
        <tr><th>Número</th><td>@Model.NumeroCertificado</td></tr>
        <tr><th>Emitido</th><td>@Model.FechaEmision</td></tr>
        <tr><th>Vence</th><td>@Model.FechaVencimiento</td></tr>
        <tr><th>Vigencia (años)</th><td>@Model.VigenciaAnios</td></tr>
        <tr><th>Estado</th><td>@Model.Estado</td></tr>
        <tr><th>Firmado Por</th><td>@Model.FirmadoPor</td></tr>
        <tr><th>Condiciones</th><td>@Model.Observaciones</td></tr>
        <tr><th>Código Verificación</th><td>@Model.CodigoVerificacion</td></tr>
        <tr>
            <th>PDF</th>
            <td>
                @if (!string.IsNullOrEmpty(Model.RutaPdf))
                {
                    <a class="btn btn-primary" href="@Url.Action("DescargarPDF", new { id = Model.CodigoCertificado })">
                        Descargar PDF
                    </a>
                }
                else
                {
                    <span class="text-warning">No cargado</span>
                }
            </td>
        </tr>
    </table>

    <hr />

    <h4>Subir PDF</h4>
    <form action="@Url.Action("SubirPDF", "Certificado")" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.CodigoCertificado" />
        <input type="hidden" name="solicitudId" value="@Model.CodigoSolicitud" />

        <input type="file" name="archivo" class="form-control" />
        <br />
        <button class="btn btn-success" type="submit">Subir</button>
    </form>
}


