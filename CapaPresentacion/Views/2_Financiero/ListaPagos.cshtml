@model List<CapaModelo.Pago>

@{
    ViewBag.Title = "Pagos Pendientes de Validación";
}

<h2><i class="glyphicon glyphicon-list-alt"></i> Pagos Pendientes</h2>
<hr />

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}
@if (TempData["Warning"] != null)
{
    <div class="alert alert-warning">
        @TempData["Warning"]
    </div>
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

<table class="table table-bordered table-hover table-striped">
    <thead class="thead-dark">
        <tr>
            <th>#</th>
            <th>Solicitud N°</th>
            <th>Operador</th>
            <th>Monto</th>
            <th>Fecha de Pago</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Count > 0)
        {
            int contador = 1;
            foreach (var pago in Model)
            {
                <tr>
                    <td>@contador</td>
                    <td>@pago.Solicitud?.NumeroSolicitud</td>
                    <td>@pago.Solicitud?.NombreOperador</td>
                    <td>$@pago.Monto.ToString("N2")</td>
                    <td>@pago.FechaPago?.ToString("dd/MM/yyyy")</td>
                    <td>@pago.Estado</td>
                    <td>
                        <a href="@Url.Action("ValidarPago", "Financiero", new { id = pago.CodigoPago })" class="btn btn-sm btn-primary">
                            <i class="glyphicon glyphicon-check"></i> Validar
                        </a>
                    </td>
                </tr>
                contador++;
            }
        }
        else
        {
            <tr>
                <td colspan="7" class="text-center">No hay pagos pendientes por validar.</td>
            </tr>
        }
    </tbody>
</table>
