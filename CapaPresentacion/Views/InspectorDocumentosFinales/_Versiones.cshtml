@model System.Collections.Generic.IList<CapaPresentacion.Models.VersionDocumentoViewModel>
<details class="mt-3"><summary><strong>Consultar versiones (@Model.Count)</strong></summary><div class="table-responsive mt-2"><table class="table table-sm"><thead><tr><th>Versión</th><th>Estado</th><th>Fecha</th><th>Vigente</th><th></th></tr></thead><tbody>@foreach(var v in Model){<tr><td>v@v.Version</td><td>@v.Estado</td><td>@v.Fecha.ToString("dd/MM/yyyy HH:mm")</td><td>@(v.Vigente?"Sí":"No")</td><td>@if(!string.IsNullOrWhiteSpace(v.UrlPdf)){<a target="_blank" rel="noopener" href="@v.UrlPdf">Ver PDF</a>}</td></tr>}</tbody></table></div></details>
