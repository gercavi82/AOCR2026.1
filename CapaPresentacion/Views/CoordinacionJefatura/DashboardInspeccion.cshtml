@model CapaPresentacion.Models.DashboardInspeccionViewModel
@using System
@using System.Linq
@using System.Web
@using CapaPresentacion.Helpers
@{
    Layout = "~/Views/Shared/_LayoutAOCR.cshtml";
    ViewBag.Title = "Gestión Integral AOCR";
    ViewBag.HideGlobalHeaderHero = true;

    var vm = Model ?? new CapaPresentacion.Models.DashboardInspeccionViewModel();
    var gestionIntegral = vm.GestionIntegralAocr ?? new System.Collections.Generic.List<CapaPresentacion.Models.DashboardGestionIntegralItemViewModel>();
    var firmas = vm.PendientesFirma ?? new System.Collections.Generic.List<CapaPresentacion.Models.DashboardInspeccionFirmaItemViewModel>();
    var ncs = vm.ObservacionesNc ?? new System.Collections.Generic.List<CapaPresentacion.Models.DashboardInspeccionNcItemViewModel>();
    var quickFilter = string.IsNullOrWhiteSpace(vm.QuickFilter) ? "TODOS" : vm.QuickFilter;
    var tablero = vm.TableroAocr ?? new CapaPresentacion.Models.TableroAocrViewModel();
    const int kanbanPreviewLimit = 5;
    var puedeGestionarAsignacion = User.IsInRole("Administrador") || User.IsInRole("Coordinador") || User.IsInRole("CoordinadorInspecciones");
    var puedeVerPendientesDirdac = User.IsInRole("Administrador") || User.IsInRole("DIRDAC") || User.IsInRole("Direccion") || User.IsInRole("Director") || User.IsInRole("JefaturaTecnica") || User.IsInRole("Jefe");
    var puedeValidarAocr = User.IsInRole("Administrador") || User.IsInRole("DIRDAC") || User.IsInRole("Direccion") || User.IsInRole("JefaturaTecnica") || User.IsInRole("DirectorGeneral");

    Func<string, string, string> quickFilterUrl = (value, label) => Url.Action("DashboardInspeccion", "CoordinacionJefatura", new
    {
        compania = vm.CompaniaFiltro,
        inspector = vm.InspectorFiltro,
        estado = vm.EstadoFiltro,
        quickFilter = value
    });

    var hoy = DateTime.Now;
    var saludoHora = hoy.Hour < 12 ? "Buenos días" : (hoy.Hour < 18 ? "Buenas tardes" : "Buenas noches");
    var nombreUsuario = (Session["NombreUsuario"] as string ?? "Usuario").Split(' ')[0];
}

@* ── Kanban column helper (v4 redesign) ── *@
@helper RenderKanbanColumn(string columnKey, string title, string icon, string accentClass, System.Collections.Generic.IEnumerable<CapaPresentacion.Models.DashboardGestionIntegralItemViewModel> items, int previewLimit)
{
    var itemList = (items ?? Enumerable.Empty<CapaPresentacion.Models.DashboardGestionIntegralItemViewModel>()).ToList();
    var total = itemList.Count;
    var visibleInitial = Math.Min(previewLimit, total);

    <div class="di3-col @accentClass" data-column="@columnKey" data-expanded="false" data-preview-limit="@previewLimit">
        <div class="di3-col__head">
            <div class="di3-col__accent"></div>
            <span class="di3-col__icon"><i class="@icon"></i></span>
            <div class="di3-col__htext">
                <span class="di3-col__title">@title</span>
                <span class="di3-col__subtitle">@total trámite@(total != 1 ? "s" : "")</span>
            </div>
            <span class="di3-col__badge">@total</span>
        </div>
        <div class="di3-col__body">
            @if (!itemList.Any())
            {
                <div class="di3-empty">
                    <div class="di3-empty__circle"><i class="fas fa-inbox"></i></div>
                    <span>Sin trámites en esta etapa</span>
                </div>
            }
            else
            {
                foreach (var item in itemList)
                {
                    var badgeGeneral = DashboardInspeccionBadgeHelper.GetBadgeEstado(item.EstadoGeneral, "GENERAL");
                    var badgeInspeccion = DashboardInspeccionBadgeHelper.GetBadgeEstado(item.EstadoInspeccion, "INSPECCION");
                    var mostrarAccionPrincipal = !string.IsNullOrWhiteSpace(item.UrlAccionPrincipal)
                        && !string.Equals(item.UrlAccionPrincipal, item.UrlDetalle, StringComparison.OrdinalIgnoreCase)
                        && !string.Equals(item.TextoAccionPrincipal, "Ver", StringComparison.OrdinalIgnoreCase);
                    var searchIndex = string.Join(" ", new[] { item.NumeroSolicitud, item.Compania, item.Tipo, item.EstadoGeneral, item.EstadoDocumental, item.EstadoInspeccion, item.Inspector, item.EtapaActual, item.ResumenKanban }.Where(x => !string.IsNullOrWhiteSpace(x)));

                    <article class="di3-card di3-card--@item.ColorKanban @(item.EsUrgente ? "di3-card--urgent" : null)"
                             data-search="@searchIndex.ToLowerInvariant()" title="@item.ResumenKanban">
                        <div class="di3-card__head">
                            <button type="button" class="di3-card__id js-open-detail-modal" data-url="@item.UrlDetalle" data-title="@item.NumeroSolicitud - @item.Compania">@item.NumeroSolicitud</button>
                            <span class="di3-chip">@item.Tipo</span>
                        </div>
                        <div class="di3-card__company">@item.Compania</div>
                        <div class="di3-card__status">
                            <span class="@badgeGeneral.CssClass">@badgeGeneral.Text</span>
                            <span class="@badgeInspeccion.CssClass">@badgeInspeccion.Text</span>
                        </div>
                        <div class="di3-card__info">
                            <span class="di3-card__meta-item"><i class="fas fa-user-check"></i> @item.Inspector</span>
                            <span class="di3-card__meta-item"><i class="fas fa-calendar-days"></i> @(item.Fecha.HasValue ? item.Fecha.Value.ToString("dd/MM/yyyy") : "—")</span>
                        </div>
                        <div class="di3-card__bottom">
                            <div class="di3-card__sigs">
                                <span class="di3-sig"><span class="di3-dot @(item.FirmaInspector ? "di3-dot--ok" : "")"></span> Insp</span>
                                <span class="di3-sig"><span class="di3-dot @(item.FirmaDirdac ? "di3-dot--ok" : "")"></span> DIR</span>
                            </div>
                            <div class="di3-card__acts">
                                <button type="button" class="di3-act js-open-detail-modal" data-url="@item.UrlDetalle" data-title="@item.NumeroSolicitud - @item.Compania" title="Ver detalle"><i class="fas fa-eye"></i></button>
                                @if (mostrarAccionPrincipal)
                                {
                                    <a class="di3-act di3-act--go" href="@item.UrlAccionPrincipal" title="@item.TextoAccionPrincipal"><i class="fas fa-arrow-right"></i></a>
                                }
                            </div>
                        </div>
                    </article>
                }
            }
        </div>
        <div class="di3-col__foot @(total > previewLimit ? "" : "d-none")">
            <span class="di3-col__summary"><strong class="js-kanban-visible">@visibleInitial</strong> de @total</span>
            <button type="button" class="di3-btn-toggle js-kanban-toggle" data-column="@columnKey">Ver más</button>
        </div>
    </div>
}

@* ================================================================
   STYLES — Dashboard v3 redesign
   ================================================================ *@
<style>
/* ============================================================
   DESIGN TOKENS v3
   ============================================================ */
.di3-shell {
    --c-primary: #0f4d7a;
    --c-primary-soft: #e8f1f8;
    --c-primary-glow: rgba(15,77,122,.06);
    --c-teal: #0f6a7f;
    --c-ink: #14293d;
    --c-text: #1e3a52;
    --c-muted: #6e8799;
    --c-border: rgba(14,46,71,.08);
    --c-border-strong: rgba(14,46,71,.14);
    --c-surface: #ffffff;
    --c-surface-alt: #f8fafb;
    --c-bg: #f3f6f9;
    --c-success: #1a7a46;
    --c-success-soft: #e8f5ee;
    --c-warning: #b78312;
    --c-warning-soft: #fef9ec;
    --c-danger: #c0392b;
    --c-danger-soft: #fdeeed;
    --c-info: #1976d2;
    --c-info-soft: #e3f2fd;
    --r-sm: 10px;
    --r-md: 14px;
    --r-lg: 20px;
    --r-xl: 24px;
    --shadow-card: 0 1px 3px rgba(14,46,71,.04), 0 6px 20px rgba(14,46,71,.04);
    --shadow-hover: 0 4px 12px rgba(14,46,71,.1);
    --shadow-panel: 0 1px 4px rgba(14,46,71,.03), 0 10px 30px rgba(14,46,71,.05);
    --transition: .2s ease;
}

/* ============================================================
   SHELL / LAYOUT
   ============================================================ */
.di3-shell {
    display: grid;
    gap: 0;
    color: var(--c-text);
    font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
    -webkit-font-smoothing: antialiased;
}

/* ============================================================
   LEVEL 1 — HERO HEADER
   ============================================================ */
.di3-hero {
    background: linear-gradient(135deg, #0e3a5c 0%, #145a82 40%, #0f6a7f 100%);
    color: #fff;
    padding: 28px 32px 24px;
    border-radius: var(--r-xl);
    position: relative;
    overflow: hidden;
    margin-bottom: 24px;
}
.di3-hero::before {
    content: '';
    position: absolute;
    top: -40%;
    right: -10%;
    width: 420px;
    height: 420px;
    background: radial-gradient(circle, rgba(255,255,255,.06) 0%, transparent 70%);
    pointer-events: none;
}
.di3-hero::after {
    content: '';
    position: absolute;
    bottom: -30%;
    left: 10%;
    width: 300px;
    height: 300px;
    background: radial-gradient(circle, rgba(255,255,255,.04) 0%, transparent 70%);
    pointer-events: none;
}
.di3-hero__inner {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 20px;
    flex-wrap: wrap;
    position: relative;
    z-index: 1;
}
.di3-hero__crumb {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: .78rem;
    opacity: .7;
    margin-bottom: 8px;
}
.di3-hero__crumb a { color: rgba(255,255,255,.85); text-decoration: none; }
.di3-hero__crumb a:hover { color: #fff; }
.di3-hero__title {
    font-size: 1.55rem;
    font-weight: 800;
    letter-spacing: -.02em;
    margin: 0 0 4px;
    line-height: 1.2;
}
.di3-hero__sub {
    font-size: .88rem;
    opacity: .75;
    margin: 0;
    line-height: 1.4;
}
.di3-hero__greeting {
    font-size: .82rem;
    opacity: .6;
    margin-top: 6px;
}
.di3-hero__actions {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    align-items: flex-start;
    padding-top: 4px;
}
.di3-hero__actions .btn {
    font-size: .8rem;
    font-weight: 600;
    padding: 7px 14px;
    border-radius: var(--r-sm);
    border: 1px solid rgba(255,255,255,.25);
    color: #fff;
    background: rgba(255,255,255,.08);
    backdrop-filter: blur(6px);
    transition: var(--transition);
    white-space: nowrap;
}
.di3-hero__actions .btn:hover {
    background: rgba(255,255,255,.18);
    border-color: rgba(255,255,255,.4);
    color: #fff;
}
.di3-hero__actions .btn-primary {
    background: rgba(255,255,255,.2);
    border-color: rgba(255,255,255,.35);
}
.di3-hero__actions .btn-primary:hover {
    background: rgba(255,255,255,.3);
}

/* ============================================================
   ALERTS
   ============================================================ */
.di3-alerts { display: grid; gap: 8px; margin-bottom: 24px; }
.di3-alerts:empty { display: none; }

/* ============================================================
   LEVEL 2 — KPI METRICS
   ============================================================ */
.di3-kpis {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 16px;
    margin-bottom: 28px;
}
.di3-kpi {
    background: var(--c-surface);
    border-radius: var(--r-md);
    padding: 20px 20px 18px;
    box-shadow: var(--shadow-card);
    border-left: 3px solid transparent;
    transition: transform var(--transition), box-shadow var(--transition);
    position: relative;
}
.di3-kpi:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-hover);
}
.di3-kpi__number {
    font-size: 1.75rem;
    font-weight: 800;
    line-height: 1;
    color: var(--c-ink);
    letter-spacing: -.03em;
}
.di3-kpi__label {
    font-size: .76rem;
    color: var(--c-muted);
    margin-top: 6px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: .04em;
}
.di3-kpi__icon {
    position: absolute;
    top: 16px;
    right: 16px;
    width: 32px;
    height: 32px;
    border-radius: 8px;
    display: grid;
    place-items: center;
    font-size: .8rem;
    color: #fff;
    opacity: .85;
}
.di3-kpi--total  { border-left-color: var(--c-primary); }
.di3-kpi--total .di3-kpi__icon  { background: var(--c-primary); }
.di3-kpi--total .di3-kpi__number { color: var(--c-primary); }
.di3-kpi--pend   { border-left-color: var(--c-warning); }
.di3-kpi--pend .di3-kpi__icon   { background: var(--c-warning); }
.di3-kpi--proc   { border-left-color: var(--c-info); }
.di3-kpi--proc .di3-kpi__icon   { background: var(--c-info); }
.di3-kpi--obs    { border-left-color: var(--c-danger); }
.di3-kpi--obs .di3-kpi__icon    { background: var(--c-danger); }
.di3-kpi--firma  { border-left-color: var(--c-teal); }
.di3-kpi--firma .di3-kpi__icon  { background: var(--c-teal); }
.di3-kpi--done   { border-left-color: var(--c-success); }
.di3-kpi--done .di3-kpi__icon   { background: var(--c-success); }

/* ============================================================
   LEVEL 3 — FILTER & TOOLBAR
   ============================================================ */
.di3-toolbar {
    background: var(--c-surface);
    border-radius: var(--r-lg);
    padding: 16px 24px;
    box-shadow: var(--shadow-card);
    margin-bottom: 24px;
}
.di3-toolbar__form {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    align-items: flex-end;
}
.di3-field {
    display: flex;
    flex-direction: column;
    gap: 4px;
    flex: 1;
    min-width: 160px;
    max-width: 240px;
}
.di3-field label {
    font-size: .7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .06em;
    color: var(--c-muted);
}
.di3-field select,
.di3-field input[type="text"] {
    height: 38px;
    font-size: .85rem;
    border-radius: var(--r-sm);
    border: 1px solid var(--c-border-strong);
    padding: 0 12px;
    background: var(--c-surface-alt);
    color: var(--c-text);
    transition: border-color var(--transition), box-shadow var(--transition);
}
.di3-field select:focus,
.di3-field input[type="text"]:focus {
    outline: none;
    border-color: var(--c-primary);
    box-shadow: 0 0 0 3px var(--c-primary-glow);
}
.di3-toolbar__btns {
    display: flex;
    gap: 8px;
    align-self: flex-end;
}
.di3-toolbar__btns .btn {
    height: 38px;
    font-size: .82rem;
    font-weight: 700;
    padding: 0 18px;
    border-radius: var(--r-sm);
    display: inline-flex;
    align-items: center;
    gap: 6px;
}
.di3-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 14px;
    padding-top: 14px;
    border-top: 1px solid var(--c-border);
}
.di3-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    border-radius: 999px;
    font-size: .78rem;
    font-weight: 700;
    text-decoration: none;
    color: var(--c-text);
    background: var(--c-surface-alt);
    border: 1px solid var(--c-border);
    transition: all var(--transition);
}
.di3-pill:hover { background: var(--c-primary-soft); color: var(--c-primary); border-color: transparent; text-decoration: none; }
.di3-pill.active { background: var(--c-primary); color: #fff; border-color: transparent; }
.di3-pill.active:hover { background: #0b3d62; color: #fff; }

/* ============================================================
   LEVEL 4 — NAVIGATION TABS
   ============================================================ */
.di3-nav {
    display: flex;
    gap: 0;
    border-bottom: 2px solid var(--c-border);
    margin-bottom: 24px;
}
.di3-nav__tab {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 20px;
    border: none;
    background: transparent;
    color: var(--c-muted);
    font-weight: 700;
    font-size: .88rem;
    cursor: pointer;
    border-bottom: 2px solid transparent;
    margin-bottom: -2px;
    transition: color var(--transition), border-color var(--transition);
}
.di3-nav__tab:hover { color: var(--c-text); }
.di3-nav__tab.active {
    color: var(--c-primary);
    border-bottom-color: var(--c-primary);
}
.di3-nav__count {
    min-width: 22px;
    height: 22px;
    padding: 0 7px;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: .72rem;
    font-weight: 800;
    background: rgba(14,46,71,.06);
}
.di3-nav__tab.active .di3-nav__count {
    background: var(--c-primary-soft);
    color: var(--c-primary);
}

/* pane visibility */
.di3-pane { display: none; }
.di3-pane.active { display: block; }

/* ============================================================
   PANEL (wraps tables & kanban)
   ============================================================ */
.di3-panel {
    background: var(--c-surface);
    border-radius: var(--r-lg);
    box-shadow: var(--shadow-panel);
    overflow: hidden;
}
.di3-panel__head {
    padding: 20px 24px;
    border-bottom: 1px solid var(--c-border);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
}
.di3-panel__title {
    margin: 0;
    font-size: 1.1rem;
    font-weight: 800;
    color: var(--c-ink);
}
.di3-panel__sub {
    margin: 2px 0 0;
    color: var(--c-muted);
    font-size: .82rem;
}
.di3-panel__body { padding: 0; }

/* ============================================================
   SEARCH
   ============================================================ */
.di3-search {
    position: relative;
    max-width: 280px;
    flex-shrink: 0;
}
.di3-search i {
    position: absolute;
    top: 50%;
    left: 12px;
    transform: translateY(-50%);
    color: var(--c-muted);
    font-size: .82rem;
}
.di3-search input {
    padding-left: 36px;
    height: 38px;
    width: 100%;
    font-size: .85rem;
    border-radius: var(--r-sm);
    border: 1px solid var(--c-border-strong);
    background: var(--c-surface-alt);
    transition: border-color var(--transition), box-shadow var(--transition);
}
.di3-search input:focus {
    outline: none;
    border-color: var(--c-primary);
    box-shadow: 0 0 0 3px var(--c-primary-glow);
}

/* ============================================================
   TABLES
   ============================================================ */
.di3-panel__body .table { margin: 0; }
.di3-panel__body .table thead th {
    font-size: .72rem;
    text-transform: uppercase;
    letter-spacing: .06em;
    color: var(--c-muted);
    font-weight: 700;
    border-top: 0;
    white-space: nowrap;
    padding: 12px 16px;
    background: var(--c-surface-alt);
    border-bottom: 1px solid var(--c-border);
}
.di3-panel__body .table tbody td {
    padding: 12px 16px;
    vertical-align: middle;
    font-size: .86rem;
    border-bottom: 1px solid var(--c-border);
}
.di3-panel__body .table tbody tr:hover {
    background: rgba(15,77,122,.02);
}
.di3-panel__body .table tbody tr:last-child td { border-bottom: 0; }
.di3-panel__body .table .btn { white-space: nowrap; font-size: .78rem; }

/* signatures inline */
.di3-sigs-inline { display: flex; gap: 12px; }
.di3-dot { width: 9px; height: 9px; border-radius: 50%; display: inline-block; background: #c8d3da; }
.di3-dot--ok { background: var(--c-success); }
.di3-sig { display: inline-flex; align-items: center; gap: 4px; font-size: .76rem; color: var(--c-muted); }

/* chip */
.di3-chip {
    font-size: .66rem;
    padding: 2px 8px;
    border-radius: 999px;
    background: var(--c-surface-alt);
    border: 1px solid var(--c-border);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .03em;
    color: var(--c-muted);
}

/* empty states */
.di3-empty-lg {
    text-align: center;
    padding: 56px 24px;
    color: var(--c-muted);
}
.di3-empty-lg i {
    font-size: 2.2rem;
    display: block;
    margin-bottom: 12px;
    opacity: .4;
}
.di3-empty-lg p { margin: 6px 0 0; font-size: .9rem; }

/* ============================================================
   KANBAN BOARD — Control Center v4
   ============================================================ */

/* Board: immersive panel header */
.di3-panel--kb { overflow: visible; }
.di3-panel--kb > .di3-panel__head {
    background: linear-gradient(135deg, #0e3a5c 0%, #145a82 55%, #0f6a7f 100%);
    color: #fff;
    padding: 22px 28px;
    border-bottom: none;
    border-radius: var(--r-lg) var(--r-lg) 0 0;
    position: relative;
    overflow: hidden;
}
.di3-panel--kb > .di3-panel__head::after {
    content: '';
    position: absolute;
    top: -60%;
    right: -8%;
    width: 260px;
    height: 260px;
    background: radial-gradient(circle, rgba(255,255,255,.06), transparent 70%);
    pointer-events: none;
}
.di3-panel--kb .di3-panel__title { color: #fff; font-size: 1.15rem; }
.di3-panel--kb .di3-panel__sub { color: rgba(255,255,255,.6); }
.di3-panel--kb .di3-search input {
    background: rgba(255,255,255,.1);
    border-color: rgba(255,255,255,.18);
    color: #fff;
}
.di3-panel--kb .di3-search input::placeholder { color: rgba(255,255,255,.45); }
.di3-panel--kb .di3-search input:focus {
    background: rgba(255,255,255,.16);
    border-color: rgba(255,255,255,.35);
    box-shadow: 0 0 0 3px rgba(255,255,255,.08);
}
.di3-panel--kb .di3-search i { color: rgba(255,255,255,.45); }
.di3-panel--kb .di3-kb-stats { font-size: .78rem; color: rgba(255,255,255,.5); margin-top: 4px; }

/* Kanban grid */
.di3-kanban {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(300px, 1fr);
    gap: 20px;
    overflow-x: auto;
    padding: 28px;
    background: linear-gradient(180deg, #edf2f6 0%, var(--c-bg) 100%);
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    border-radius: 0 0 var(--r-lg) var(--r-lg);
}
.di3-kanban::-webkit-scrollbar { height: 6px; }
.di3-kanban::-webkit-scrollbar-track { background: transparent; }
.di3-kanban::-webkit-scrollbar-thumb { background: rgba(14,46,71,.12); border-radius: 3px; }

/* Column */
.di3-col {
    background: var(--c-surface);
    border-radius: 16px;
    display: flex;
    flex-direction: column;
    min-height: 380px;
    box-shadow: 0 2px 8px rgba(14,46,71,.04), 0 10px 28px rgba(14,46,71,.04);
    scroll-snap-align: start;
    transition: box-shadow var(--transition);
    overflow: hidden;
    border: none;
}
.di3-col:hover { box-shadow: 0 4px 14px rgba(14,46,71,.07), 0 14px 36px rgba(14,46,71,.06); }

/* Column header */
.di3-col__head {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 18px 20px 16px;
    position: relative;
    border-bottom: 1px solid var(--c-border);
    background: var(--c-surface);
}
.di3-col__accent {
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 4px;
}
.di3-col__icon {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    display: grid;
    place-items: center;
    font-size: .82rem;
    color: #fff;
    flex-shrink: 0;
}
.di3-col__htext { flex: 1; min-width: 0; }
.di3-col__title {
    display: block;
    font-weight: 800;
    font-size: .92rem;
    color: var(--c-ink);
    line-height: 1.2;
}
.di3-col__subtitle {
    display: block;
    font-size: .72rem;
    color: var(--c-muted);
    font-weight: 600;
    margin-top: 2px;
}
.di3-col__badge {
    min-width: 34px;
    height: 34px;
    padding: 0 10px;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: .92rem;
    flex-shrink: 0;
}

/* Column body */
.di3-col__body {
    padding: 14px;
    display: grid;
    gap: 12px;
    align-content: start;
    flex: 1;
    overflow-y: auto;
    max-height: 560px;
}
.di3-col__body::-webkit-scrollbar { width: 3px; }
.di3-col__body::-webkit-scrollbar-track { background: transparent; }
.di3-col__body::-webkit-scrollbar-thumb { background: rgba(14,46,71,.1); border-radius: 2px; }

/* Column footer */
.di3-col__foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 20px;
    border-top: 1px solid var(--c-border);
    font-size: .78rem;
    color: var(--c-muted);
    background: var(--c-surface-alt);
}

/* Empty state */
.di3-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 120px;
    color: var(--c-muted);
    font-size: .82rem;
    padding: 28px 16px;
}
.di3-empty__circle {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: var(--c-surface-alt);
    border: 1px dashed var(--c-border-strong);
    display: grid;
    place-items: center;
    font-size: 1.2rem;
    opacity: .5;
}

/* ── Column accent themes ── */
.di3-col--gray .di3-col__accent   { background: linear-gradient(90deg, #8c99a4, #a4b0ba); }
.di3-col--gray .di3-col__icon     { background: linear-gradient(135deg, #8c99a4, #6b7985); }
.di3-col--gray .di3-col__badge    { background: #f0f2f4; color: #5d6d7a; }

.di3-col--blue .di3-col__accent   { background: linear-gradient(90deg, #2980b9, #5ba3d4); }
.di3-col--blue .di3-col__icon     { background: linear-gradient(135deg, #3498db, #2471a3); }
.di3-col--blue .di3-col__badge    { background: #e8f4fd; color: #1a6ba0; }

.di3-col--yellow .di3-col__accent { background: linear-gradient(90deg, #d4a017, #e8c04a); }
.di3-col--yellow .di3-col__icon   { background: linear-gradient(135deg, #f0c040, #c89510); }
.di3-col--yellow .di3-col__badge  { background: #fef6e0; color: #8a6500; }

.di3-col--red .di3-col__accent    { background: linear-gradient(90deg, #c0392b, #e05a4d); }
.di3-col--red .di3-col__icon      { background: linear-gradient(135deg, #e74c3c, #a93226); }
.di3-col--red .di3-col__badge     { background: #fde8e8; color: #a93226; }

.di3-col--green .di3-col__accent  { background: linear-gradient(90deg, #27ae60, #5dc98a); }
.di3-col--green .di3-col__icon    { background: linear-gradient(135deg, #2ecc71, #1e8449); }
.di3-col--green .di3-col__badge   { background: #e8f8ef; color: #1a7a42; }

/* ============================================================
   KANBAN CARDS — Premium v4
   ============================================================ */
.di3-card {
    border-radius: 12px;
    background: var(--c-surface);
    padding: 18px 20px 16px;
    display: grid;
    gap: 10px;
    border: none;
    border-left: 4px solid transparent;
    box-shadow: 0 1px 3px rgba(14,46,71,.05), 0 4px 12px rgba(14,46,71,.03);
    position: relative;
    transition: transform var(--transition), box-shadow var(--transition);
}
.di3-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(14,46,71,.1);
}
.di3-card--secondary { border-left-color: #8c99a4; }
.di3-card--info      { border-left-color: #2980b9; }
.di3-card--warning   { border-left-color: #d4a017; }
.di3-card--danger    { border-left-color: #c0392b; }
.di3-card--success   { border-left-color: #27ae60; }
.di3-card--urgent {
    border-left-color: #c0392b;
    box-shadow: 0 0 0 1px rgba(192,57,43,.1), 0 2px 8px rgba(192,57,43,.08);
}
.di3-card--urgent::before {
    content: '';
    position: absolute;
    top: 12px;
    right: 14px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #e74c3c;
    animation: di3Pulse 2s ease-in-out infinite;
}
@@keyframes di3Pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: .4; transform: scale(1.4); }
}

/* Card head */
.di3-card__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
}
.di3-card__id {
    border: 0;
    background: transparent;
    padding: 0;
    font-weight: 800;
    color: var(--c-primary);
    font-size: .88rem;
    text-align: left;
    cursor: pointer;
    letter-spacing: -.01em;
}
.di3-card__id:hover { text-decoration: underline; color: #0b3d62; }

/* Company */
.di3-card__company {
    font-size: .82rem;
    font-weight: 600;
    color: var(--c-ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    line-height: 1.3;
}

/* Status row */
.di3-card__status { display: flex; flex-wrap: wrap; gap: 5px; }
.di3-card__status .dash-badge { font-size: .65rem; padding: 3px 9px; border-radius: 6px; }

/* Info row */
.di3-card__info {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    padding-top: 8px;
    border-top: 1px solid var(--c-border);
}
.di3-card__meta-item {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: .74rem;
    color: var(--c-muted);
}
.di3-card__meta-item i { font-size: .68rem; opacity: .65; }

/* Bottom bar */
.di3-card__bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
}
.di3-card__sigs { display: flex; gap: 10px; }
.di3-card__acts {
    display: flex;
    gap: 5px;
    opacity: .35;
    transition: opacity var(--transition);
}
.di3-card:hover .di3-card__acts { opacity: 1; }

/* Action buttons */
.di3-act {
    width: 28px;
    height: 28px;
    border: 1px solid var(--c-border);
    border-radius: 8px;
    background: var(--c-surface-alt);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: .72rem;
    color: var(--c-primary);
    cursor: pointer;
    transition: all var(--transition);
    text-decoration: none;
}
.di3-act:hover { background: var(--c-primary-soft); border-color: var(--c-primary); }
.di3-act--go { color: var(--c-success); }
.di3-act--go:hover { background: var(--c-success-soft); border-color: var(--c-success); }

/* Toggle button */
.di3-btn-toggle {
    border: none;
    border-radius: 6px;
    background: transparent;
    padding: 5px 14px;
    font-size: .76rem;
    font-weight: 700;
    color: var(--c-primary);
    cursor: pointer;
    transition: all var(--transition);
}
.di3-btn-toggle:hover { background: var(--c-primary-soft); }

/* ============================================================
   DETAIL MODAL
   ============================================================ */
.di3-modal .modal-dialog { max-width: 1200px; }
.di3-modal .modal-content { border-radius: var(--r-lg); overflow: hidden; border: 0; box-shadow: var(--shadow-panel); }
.di3-modal .modal-header { border-bottom: 1px solid var(--c-border); padding: 16px 24px; }
.di3-modal .modal-footer { border-top: 1px solid var(--c-border); padding: 12px 24px; }
.di3-modal__frame { width: 100%; min-height: 70vh; border: 0; background: #fff; }

/* ============================================================
   BADGE SYSTEM (override .dash-badge for v3)
   ============================================================ */
.di3-shell .dash-badge {
    display: inline-flex;
    align-items: center;
    padding: 3px 10px;
    border-radius: 999px;
    font-size: .68rem;
    font-weight: 700;
    letter-spacing: .02em;
}
.di3-shell .dash-badge-neutral   { background: #f0f3f5; color: #5d778d; }
.di3-shell .dash-badge-gray      { background: #eef1f3; color: #5d778d; }
.di3-shell .dash-badge-blue      { background: var(--c-info-soft); color: var(--c-info); }
.di3-shell .dash-badge-yellow    { background: var(--c-warning-soft); color: #8a6500; }
.di3-shell .dash-badge-orange    { background: #fef4e8; color: #ad5c00; }
.di3-shell .dash-badge-red       { background: var(--c-danger-soft); color: var(--c-danger); }
.di3-shell .dash-badge-green     { background: var(--c-success); color: #fff; }
.di3-shell .dash-badge-green-soft { background: var(--c-success-soft); color: var(--c-success); }

/* ============================================================
   RESPONSIVE
   ============================================================ */
@@media (max-width: 1399.98px) {
    .di3-kpis { grid-template-columns: repeat(3, 1fr); }
}
@@media (max-width: 1199.98px) {
    .di3-hero { padding: 22px 24px 20px; }
    .di3-hero__title { font-size: 1.35rem; }
    .di3-kpis { grid-template-columns: repeat(3, 1fr); }
    .di3-kanban { grid-auto-columns: minmax(270px, 1fr); }
}
@@media (max-width: 991.98px) {
    .di3-kpis { grid-template-columns: repeat(2, 1fr); }
    .di3-kanban { grid-auto-columns: minmax(85vw, 1fr); }
    .di3-hero__inner { flex-direction: column; }
    .di3-hero__actions { width: 100%; }
    .di3-toolbar__form { flex-direction: column; }
    .di3-field { max-width: 100%; }
    .di3-panel__head { flex-direction: column; align-items: flex-start; }
    .di3-search { max-width: 100%; }
}
@@media (max-width: 575.98px) {
    .di3-kpis { grid-template-columns: 1fr; }
    .di3-hero { padding: 18px 16px 16px; border-radius: var(--r-md); }
    .di3-hero__title { font-size: 1.15rem; }
    .di3-toolbar { padding: 14px 16px; }
    .di3-nav__tab { padding: 10px 14px; font-size: .82rem; }
}
</style>

@* ================================================================
   HTML
   ================================================================ *@
<div class="di3-shell">

    @* ── LEVEL 1: HERO ── *@
    <div class="di3-hero">
        <div class="di3-hero__inner">
            <div>
                <div class="di3-hero__crumb">
                    <a href="@Url.Action("Index", "Home")"><i class="fas fa-home"></i></a>
                    <span>/</span>
                    <span>Coordinación y Jefatura</span>
                    <span>/</span>
                    <strong>Gestión Integral</strong>
                </div>
                <h1 class="di3-hero__title"><i class="fas fa-tachometer-alt" style="opacity:.7;margin-right:6px;"></i> Gestión Integral AOCR</h1>
                <p class="di3-hero__sub">Tablero operativo unificado — seguimiento kanban, bandeja de trámites y firma de documentos</p>
                <p class="di3-hero__greeting">@saludoHora, @nombreUsuario · @hoy.ToString("dddd d 'de' MMMM, yyyy", new System.Globalization.CultureInfo("es-EC"))</p>
            </div>
            <div class="di3-hero__actions">
                <a href="@Url.Action("RevisionVerificacion", "CoordinacionJefatura")" class="btn"><i class="fas fa-arrow-left"></i> Revisión Documental</a>
                @if (puedeVerPendientesDirdac)
                {
                    <a href="@Url.Action("PendientesDireccion", "Inspeccion")" class="btn"><i class="fas fa-signature"></i> Informes Dirección</a>
                }
                @if (puedeValidarAocr)
                {
                    <a href="@Url.Action("ValidarAocr", "CoordinacionJefatura")" class="btn btn-primary"><i class="fas fa-stamp"></i> Validar AOCR</a>
                }
            </div>
        </div>
    </div>

    @* ── ALERTS ── *@
    <div class="di3-alerts">
        @if (TempData["Success"] != null) { <div class="alert alert-success mb-0" role="alert">@TempData["Success"]</div> }
        @if (TempData["Warning"] != null) { <div class="alert alert-warning mb-0" role="alert">@TempData["Warning"]</div> }
        @if (TempData["Info"] != null) { <div class="alert alert-info mb-0" role="alert">@TempData["Info"]</div> }
        @if (TempData["Error"] != null) { <div class="alert alert-danger mb-0" role="alert">@TempData["Error"]</div> }
    </div>

    @* ── LEVEL 2: KPI METRICS ── *@
    <div class="di3-kpis">
        <div class="di3-kpi di3-kpi--total">
            <div class="di3-kpi__number">@vm.TotalTramites</div>
            <div class="di3-kpi__label">Total trámites</div>
            <div class="di3-kpi__icon"><i class="fas fa-layer-group"></i></div>
        </div>
        <div class="di3-kpi di3-kpi--pend">
            <div class="di3-kpi__number">@vm.TotalPendientes</div>
            <div class="di3-kpi__label">Pendientes</div>
            <div class="di3-kpi__icon"><i class="fas fa-hourglass-half"></i></div>
        </div>
        <div class="di3-kpi di3-kpi--proc">
            <div class="di3-kpi__number">@vm.TotalEnProceso</div>
            <div class="di3-kpi__label">En proceso</div>
            <div class="di3-kpi__icon"><i class="fas fa-spinner"></i></div>
        </div>
        <div class="di3-kpi di3-kpi--obs">
            <div class="di3-kpi__number">@vm.TotalObservadas</div>
            <div class="di3-kpi__label">Observadas</div>
            <div class="di3-kpi__icon"><i class="fas fa-triangle-exclamation"></i></div>
        </div>
        <div class="di3-kpi di3-kpi--firma">
            <div class="di3-kpi__number">@vm.TotalListosFirma</div>
            <div class="di3-kpi__label">Listos para firma</div>
            <div class="di3-kpi__icon"><i class="fas fa-signature"></i></div>
        </div>
        <div class="di3-kpi di3-kpi--done">
            <div class="di3-kpi__number">@vm.TotalFinalizadas</div>
            <div class="di3-kpi__label">Finalizadas</div>
            <div class="di3-kpi__icon"><i class="fas fa-circle-check"></i></div>
        </div>
    </div>

    @* ── LEVEL 3: FILTER TOOLBAR ── *@
    <div class="di3-toolbar">
        @using (Html.BeginForm("DashboardInspeccion", "CoordinacionJefatura", FormMethod.Get, new { @class = "di3-toolbar__form" }))
        {
            <input type="hidden" name="quickFilter" value="@quickFilter" />
            <div class="di3-field">
                <label for="compania">Compañía</label>
                <select id="compania" name="compania">
                    <option value="">Todas</option>
                    @foreach (var c in vm.CompaniasDisponibles) { <option value="@c" @(string.Equals(c, vm.CompaniaFiltro, StringComparison.OrdinalIgnoreCase) ? "selected" : null)>@c</option> }
                </select>
            </div>
            <div class="di3-field">
                <label for="inspector">Inspector</label>
                <select id="inspector" name="inspector">
                    <option value="">Todos</option>
                    @foreach (var ins in vm.InspectoresDisponibles) { <option value="@ins" @(string.Equals(ins, vm.InspectorFiltro, StringComparison.OrdinalIgnoreCase) ? "selected" : null)>@ins</option> }
                </select>
            </div>
            <div class="di3-field">
                <label for="estado">Estado</label>
                <select id="estado" name="estado">
                    <option value="">Todos</option>
                    @foreach (var e in vm.EstadosDisponibles) { <option value="@e" @(string.Equals(e, vm.EstadoFiltro, StringComparison.OrdinalIgnoreCase) ? "selected" : null)>@e.Replace("_", " ")</option> }
                </select>
            </div>
            <div class="di3-toolbar__btns">
                <button type="submit" class="btn btn-primary"><i class="fas fa-filter"></i> Filtrar</button>
                <a href="@Url.Action("DashboardInspeccion", "CoordinacionJefatura")" class="btn btn-outline-secondary"><i class="fas fa-rotate-left"></i> Limpiar</a>
            </div>
        }
        <div class="di3-pills">
            <a class="di3-pill @(quickFilter == "TODOS" ? "active" : null)" href="@quickFilterUrl("TODOS", "Todos")"><i class="fas fa-border-all"></i> Todos</a>
            <a class="di3-pill @(quickFilter == "PENDIENTES" ? "active" : null)" href="@quickFilterUrl("PENDIENTES", "Pendientes")"><i class="fas fa-hourglass-half"></i> Pendientes</a>
            <a class="di3-pill @(quickFilter == "EN_PROCESO" ? "active" : null)" href="@quickFilterUrl("EN_PROCESO", "En proceso")"><i class="fas fa-spinner"></i> En proceso</a>
            <a class="di3-pill @(quickFilter == "OBSERVADOS" ? "active" : null)" href="@quickFilterUrl("OBSERVADOS", "Observados")"><i class="fas fa-triangle-exclamation"></i> Observados</a>
            <a class="di3-pill @(quickFilter == "LISTOS_FIRMA" ? "active" : null)" href="@quickFilterUrl("LISTOS_FIRMA", "Listos firma")"><i class="fas fa-signature"></i> Listos firma</a>
        </div>
    </div>

    @* ── LEVEL 4: NAVIGATION TABS ── *@
    <div class="di3-nav" id="diTabs" role="tablist">
        <button class="di3-nav__tab active" id="tab-kanban" data-pane="pane-kanban" type="button" role="tab" aria-selected="true">
            <i class="fas fa-grip"></i> Tablero <span class="di3-nav__count">@gestionIntegral.Count</span>
        </button>
        <button class="di3-nav__tab" id="tab-bandeja" data-pane="pane-bandeja" type="button" role="tab" aria-selected="false">
            <i class="fas fa-table-columns"></i> Bandeja <span class="di3-nav__count">@gestionIntegral.Count</span>
        </button>
        <button class="di3-nav__tab" id="tab-firmas" data-pane="pane-firmas" type="button" role="tab" aria-selected="false">
            <i class="fas fa-signature"></i> Firmas <span class="di3-nav__count">@firmas.Count</span>
        </button>
        <button class="di3-nav__tab" id="tab-observaciones" data-pane="pane-observaciones" type="button" role="tab" aria-selected="false">
            <i class="fas fa-triangle-exclamation"></i> Observaciones <span class="di3-nav__count">@ncs.Count</span>
        </button>
    </div>

    @* ── PANE: KANBAN ── *@
    <div class="di3-pane active" id="pane-kanban" role="tabpanel">
        <div class="di3-panel di3-panel--kb">
            <div class="di3-panel__head">
                <div>
                    <h3 class="di3-panel__title"><i class="fas fa-grip" style="opacity:.5;margin-right:6px;"></i>Tablero Operativo AOCR</h3>
                    <p class="di3-panel__sub">Detecte bloqueos, priorice acciones y visualice el flujo completo</p>
                    <p class="di3-kb-stats">@gestionIntegral.Count trámite@(gestionIntegral.Count != 1 ? "s" : "") · 6 columnas</p>
                </div>
                <div class="di3-search">
                    <i class="fas fa-search"></i>
                    <input type="text" id="kanbanSearch" placeholder="Buscar en tablero…" autocomplete="off" />
                </div>
            </div>
            <div class="di3-panel__body">
                @if (!gestionIntegral.Any())
                {
                    <div class="di3-empty-lg"><i class="fas fa-grip"></i><p>Sin trámites para el tablero con los filtros actuales.</p></div>
                }
                else
                {
                    <div class="di3-kanban" id="aocrKanbanBoard">
                        @RenderKanbanColumn("PENDIENTES", "Pendientes", "fas fa-hourglass-half", "di3-col--gray", tablero.Pendientes, kanbanPreviewLimit)
                        @RenderKanbanColumn("EN_REVISION", "En revisión", "fas fa-magnifying-glass", "di3-col--blue", tablero.EnRevision, kanbanPreviewLimit)
                        @RenderKanbanColumn("EN_INSPECCION", "En inspección", "fas fa-user-check", "di3-col--yellow", tablero.EnInspeccion, kanbanPreviewLimit)
                        @RenderKanbanColumn("OBSERVADOS", "Observados", "fas fa-triangle-exclamation", "di3-col--red", tablero.Observados, kanbanPreviewLimit)
                        @RenderKanbanColumn("LISTOS_FIRMA", "Listos firma", "fas fa-signature", "di3-col--green", tablero.ListosFirma, kanbanPreviewLimit)
                        @RenderKanbanColumn("FINALIZADOS", "Finalizados", "fas fa-circle-check", "di3-col--green", tablero.Finalizados, kanbanPreviewLimit)
                    </div>
                }
            </div>
        </div>
    </div>

    @* ── PANE: BANDEJA (TABLE) ── *@
    <div class="di3-pane" id="pane-bandeja" role="tabpanel">
        <div class="di3-panel">
            <div class="di3-panel__head">
                <div>
                    <h3 class="di3-panel__title"><i class="fas fa-table-columns" style="opacity:.5;margin-right:6px;"></i>Bandeja principal AOCR</h3>
                    <p class="di3-panel__sub">Tabla unificada para auditoría, búsqueda avanzada y trazabilidad</p>
                </div>
            </div>
            <div class="di3-panel__body">
                @if (!gestionIntegral.Any())
                {
                    <div class="di3-empty-lg"><i class="fas fa-table-columns"></i><p>Sin trámites en la bandeja con los filtros actuales.</p></div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 js-dashboard-table" id="tablaGestionIntegralAocr">
                            <thead>
                                <tr>
                                    <th>N° Solicitud</th>
                                    <th>Compañía</th>
                                    <th>Tipo</th>
                                    <th>Estado</th>
                                    <th>Inspección</th>
                                    <th>Inspector</th>
                                    <th>Etapa</th>
                                    <th>Firmas</th>
                                    <th>Fecha</th>
                                    <th class="text-end">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in gestionIntegral)
                                {
                                    var badgeGeneral = DashboardInspeccionBadgeHelper.GetBadgeEstado(item.EstadoGeneral, "GENERAL");
                                    var badgeInspeccion = DashboardInspeccionBadgeHelper.GetBadgeEstado(item.EstadoInspeccion, "INSPECCION");
                                    var mostrarAccionPrincipal = !string.IsNullOrWhiteSpace(item.UrlAccionPrincipal)
                                        && !string.Equals(item.UrlAccionPrincipal, item.UrlDetalle, StringComparison.OrdinalIgnoreCase)
                                        && !string.Equals(item.TextoAccionPrincipal, "Ver", StringComparison.OrdinalIgnoreCase);
                                    <tr>
                                        <td>
                                            <a href="@item.UrlDetalle" class="fw-bold text-primary text-decoration-none">@item.NumeroSolicitud</a>
                                            <div class="text-muted" style="font-size:.72rem;">@(item.CodigoInspeccion.HasValue ? "Insp. " + item.CodigoInspeccion.Value : "Solicitud")</div>
                                        </td>
                                        <td>@item.Compania</td>
                                        <td><span class="di3-chip">@item.Tipo</span></td>
                                        <td><span class="@badgeGeneral.CssClass">@badgeGeneral.Text</span></td>
                                        <td><span class="@badgeInspeccion.CssClass">@badgeInspeccion.Text</span></td>
                                        <td>@item.Inspector</td>
                                        <td>@Html.Partial("_StatusBadge", null, new ViewDataDictionary { { "Estado", item.EtapaActual } })</td>
                                        <td>
                                            <div class="di3-sigs-inline">
                                                <span class="di3-sig"><span class="di3-dot @(item.FirmaInspector ? "di3-dot--ok" : "")"></span> Insp</span>
                                                <span class="di3-sig"><span class="di3-dot @(item.FirmaDirdac ? "di3-dot--ok" : "")"></span> DIR</span>
                                            </div>
                                        </td>
                                        <td>@(item.Fecha.HasValue ? item.Fecha.Value.ToString("dd/MM/yyyy") : "—")</td>
                                        <td class="text-end">
                                            <div class="d-flex flex-nowrap justify-content-end gap-1">
                                                <button type="button" class="btn btn-sm btn-outline-primary js-open-detail-modal" data-url="@item.UrlDetalle" data-title="@item.NumeroSolicitud - @item.Compania"><i class="fas fa-eye"></i></button>
                                                @if (mostrarAccionPrincipal)
                                                {
                                                    <a class="btn btn-sm btn-outline-success" href="@item.UrlAccionPrincipal" title="@item.TextoAccionPrincipal"><i class="fas fa-bolt"></i></a>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(item.UrlVerDocumento))
                                                {
                                                    <a class="btn btn-sm btn-outline-secondary" href="@item.UrlVerDocumento" target="_blank" title="Vista previa PDF"><i class="fas fa-eye"></i></a>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(item.UrlDescargarPdf))
                                                {
                                                    <a class="btn btn-sm btn-outline-secondary" href="@item.UrlDescargarPdf" title="Descargar PDF"><i class="fas fa-download"></i></a>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

    @* ── PANE: FIRMAS ── *@
    <div class="di3-pane" id="pane-firmas" role="tabpanel">
        <div class="di3-panel">
            <div class="di3-panel__head">
                <div>
                    <h3 class="di3-panel__title"><i class="fas fa-signature" style="opacity:.5;margin-right:6px;"></i>Pendientes de firma</h3>
                    <p class="di3-panel__sub">Documentos que requieren firma de inspector o DIRDAC</p>
                </div>
            </div>
            <div class="di3-panel__body">
                @if (!firmas.Any())
                {
                    <div class="di3-empty-lg"><i class="fas fa-signature"></i><p>Sin pendientes de firma.</p></div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 js-dashboard-table" id="tablaDashboardFirmas">
                            <thead>
                                <tr>
                                    <th>N° Solicitud</th>
                                    <th>Documento</th>
                                    <th>Firmante</th>
                                    <th>Estado</th>
                                    <th class="text-end">Acción</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in firmas)
                                {
                                    var badge = DashboardInspeccionBadgeHelper.GetBadgeEstado(item.Estado, "FIRMA");
                                    <tr>
                                        <td>
                                            <div class="fw-bold text-primary">@item.NumeroSolicitud</div>
                                            <div class="text-muted" style="font-size:.72rem;">@item.Compania</div>
                                        </td>
                                        <td>@item.Documento</td>
                                        <td>@item.FirmanteRequerido</td>
                                        <td><span class="@badge.CssClass">@badge.Text</span></td>
                                        <td class="text-end">
                                            <a class="btn btn-sm btn-outline-success" href="@item.UrlAccion"><i class="fas fa-arrow-right"></i> @item.TextoAccion</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

    @* ── PANE: OBSERVACIONES ── *@
    <div class="di3-pane" id="pane-observaciones" role="tabpanel">
        <div class="di3-panel">
            <div class="di3-panel__head">
                <div>
                    <h3 class="di3-panel__title"><i class="fas fa-triangle-exclamation" style="opacity:.5;margin-right:6px;"></i>Observaciones / NC</h3>
                    <p class="di3-panel__sub">Hallazgos, no conformidades y casos pendientes de subsanación</p>
                </div>
            </div>
            <div class="di3-panel__body">
                @if (!ncs.Any())
                {
                    <div class="di3-empty-lg"><i class="fas fa-triangle-exclamation"></i><p>Sin observaciones activas.</p></div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 js-dashboard-table" id="tablaDashboardNc">
                            <thead>
                                <tr>
                                    <th>N° Solicitud</th>
                                    <th>Tipo</th>
                                    <th>Estado</th>
                                    <th>Responsable</th>
                                    <th class="text-end">Acción</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in ncs)
                                {
                                    var badge = DashboardInspeccionBadgeHelper.GetBadgeEstado(item.Estado, "NC");
                                    <tr>
                                        <td>
                                            <div class="fw-bold text-primary">@item.NumeroSolicitud</div>
                                            <div class="text-muted" style="font-size:.72rem;">@item.Compania</div>
                                        </td>
                                        <td>@item.TipoNc</td>
                                        <td><span class="@badge.CssClass">@badge.Text</span></td>
                                        <td>@item.Responsable</td>
                                        <td class="text-end">
                                            <a class="btn btn-sm btn-outline-primary" href="@item.UrlAccion"><i class="fas fa-eye"></i> Ver detalle</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

    @* ── Detail Modal ── *@
    <div class="modal fade di3-modal" id="modalDetalleAocr" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalDetalleAocrTitulo">Detalle del trámite</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" data-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-0">
                    <iframe id="modalDetalleAocrFrame" class="di3-modal__frame" loading="lazy" title="Detalle AOCR"></iframe>
                </div>
                <div class="modal-footer">
                    <a id="modalDetalleAocrLink" href="#" target="_blank" rel="noopener" class="btn btn-outline-secondary"><i class="fas fa-arrow-up-right-from-square"></i> Abrir completa</a>
                    <button type="button" class="btn btn-primary" data-bs-dismiss="modal" data-dismiss="modal">Cerrar</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
(function ($) {
    var bound = false;

    function langConfig() {
        return {
            search: 'Buscar:', lengthMenu: 'Mostrar _MENU_ registros',
            info: 'Mostrando _START_ a _END_ de _TOTAL_', infoEmpty: '0 registros',
            zeroRecords: 'Sin registros', emptyTable: 'Sin registros',
            infoFiltered: '(de _MAX_ total)',
            paginate: { first: 'Primero', last: 'Último', next: 'Sig.', previous: 'Ant.' }
        };
    }

    function initTable(el) {
        if (!$.fn.DataTable || !el.length) return;
        if ($.fn.DataTable.isDataTable(el)) el.DataTable().destroy();
        el.DataTable({ pageLength: 5, lengthMenu: [[5, 10, 25, 50, -1], [5, 10, 25, 50, 'Todos']], order: [], autoWidth: false, language: langConfig(), responsive: true });
    }

    function kanbanVisibility($col, forceExpand) {
        var limit = parseInt($col.attr('data-preview-limit'), 10) || 5;
        var expanded = typeof forceExpand === 'boolean' ? forceExpand : $col.attr('data-expanded') === 'true';
        var $cards = $col.find('.di3-card').filter(function () { return $(this).attr('data-match') !== 'false'; });
        $col.find('.di3-card').addClass('d-none');
        if (expanded) { $cards.removeClass('d-none'); } else { $cards.slice(0, limit).removeClass('d-none'); }
        $col.attr('data-expanded', expanded ? 'true' : 'false');
        $col.find('.js-kanban-visible').text($cards.length > limit && !expanded ? limit : $cards.length);
        var $foot = $col.find('.di3-col__foot');
        if ($cards.length > limit) { $foot.removeClass('d-none'); $foot.find('.js-kanban-toggle').text(expanded ? 'Ver menos' : 'Ver más'); }
        else { $foot.addClass('d-none'); }
    }

    function filterKanban(text) {
        var q = (text || '').toLowerCase().trim();
        $('.di3-col').each(function () {
            var $col = $(this);
            $col.find('.di3-card').each(function () {
                var match = !q || ($(this).attr('data-search') || '').indexOf(q) >= 0;
                $(this).attr('data-match', match ? 'true' : 'false');
            });
            kanbanVisibility($col);
        });
    }

    function openModal(url, title) {
        if (!url) return;
        var $m = $('#modalDetalleAocr');
        $('#modalDetalleAocrTitulo').text(title || 'Detalle del trámite');
        $('#modalDetalleAocrFrame').attr('src', url);
        $('#modalDetalleAocrLink').attr('href', url);
        if (window.bootstrap && window.bootstrap.Modal) { window.bootstrap.Modal.getOrCreateInstance($m[0]).show(); }
        else if (typeof $m.modal === 'function') { $m.modal('show'); }
    }

    function activateTab(paneId) {
        if (!paneId) return;
        $('#diTabs .di3-nav__tab').each(function () {
            var isActive = $(this).attr('data-pane') === paneId;
            $(this).toggleClass('active', isActive).attr('aria-selected', isActive ? 'true' : 'false');
        });
        $('.di3-pane').each(function () { $(this).toggleClass('active', $(this).attr('id') === paneId); });
        $('.js-dashboard-table').each(function () {
            if ($.fn.DataTable && $.fn.DataTable.isDataTable(this)) $(this).DataTable().columns.adjust();
        });
    }

    function bindEvents() {
        if (bound) return;
        bound = true;
        $(document).on('click.di', '.js-kanban-toggle', function () {
            var $col = $('.di3-col[data-column="' + $(this).attr('data-column') + '"]');
            kanbanVisibility($col, $col.attr('data-expanded') !== 'true');
        });
        $('#kanbanSearch').on('input.di', function () { filterKanban($(this).val()); });
        $(document).on('click.di', '.js-open-detail-modal', function () { openModal($(this).attr('data-url'), $(this).attr('data-title')); });
        $('#diTabs .di3-nav__tab').on('click.di', function () { activateTab($(this).attr('data-pane')); });
        $('#modalDetalleAocr').on('hidden.bs.modal.di hidden.di', function () { $('#modalDetalleAocrFrame').attr('src', 'about:blank'); });
    }

    function initState() {
        $('.js-dashboard-table').each(function () { initTable($(this)); });
        $('.di3-col').each(function () { $(this).find('.di3-card').attr('data-match', 'true'); kanbanVisibility($(this), false); });
        activateTab('pane-kanban');
    }

    $(function () {
        bindEvents();
        initState();
        document.addEventListener('AOCR.DataTablesReady', function () { initState(); });
        if (window.AOCR && window.AOCR.dataTablesLoaded) initState();
    });
})(jQuery);
</script>
}
