@inherits System.Web.Mvc.WebViewPage<System.Collections.Generic.List<CapaModelo.SolicitudAOCR>>
@using System
@using System.Linq
@using System.Web.Mvc
@using System.Web.Mvc.Html
@{
    var solicitudes = Model ?? new System.Collections.Generic.List<CapaModelo.SolicitudAOCR>();
    var puedeValidarAocrRevision = (bool)(ViewData["puedeValidarAocrRevision"] ?? false);
    var puedeLegalizar = User.IsInRole("CoordinacionLegal")
        || User.IsInRole("CoordinadorLegal")
        || User.IsInRole("DirectorGeneral")
        || User.IsInRole("Administrador");
}

<div class="rv-pane-header">
    <div>
        <h3 class="rv-pane-title"><i class="fas fa-file-signature"></i> AOCR en revisión</h3>
        <p class="rv-pane-sub">Documentos listos para validación institucional, legalización o cierre formal.</p>
    </div>
    @Html.Partial("_StatusBadge", null, new ViewDataDictionary { { "Estado", solicitudes.Any() ? "En revisión" : "Completado" } })
</div>

@if (!solicitudes.Any())
{
    @Html.Partial("_EmptyState", null, new ViewDataDictionary {
        { "Icon", "fas fa-file-contract" },
        { "Title", "Sin AOCR pendientes de revisión" },
        { "Description", "No existen AOCR listos para validar, legalizar o cerrar en esta bandeja." }
    })
}
else
{
    <div class="table-responsive aocr-table-wrap">
        <table id="tblAocrRevision" class="table aocr-table aocr-datatable align-middle mb-0" style="width:100%">
            <thead>
                <tr>
                    <th>Solicitud</th>
                    <th>Operador</th>
                    <th>Estado</th>
                    <th>Fecha</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in solicitudes)
                {
                    var numeroSolicitud = !string.IsNullOrWhiteSpace(item.NumeroSolicitud) ? item.NumeroSolicitud : item.CodigoSolicitud.ToString();
                    <tr>
                        <td>
                            <div class="fw-semibold text-primary">@numeroSolicitud</div>
                            <small class="text-muted">Código @item.CodigoSolicitud</small>
                        </td>
                        <td>@(string.IsNullOrWhiteSpace(item.NombreOperador) ? "No especificado" : item.NombreOperador)</td>
                        <td>@Html.Partial("_StatusBadge", null, new ViewDataDictionary { { "Estado", item.Estado } })</td>
                        <td>@(item.FechaSolicitud.HasValue ? item.FechaSolicitud.Value.ToString("dd/MM/yyyy") : "No registrada")</td>
                        <td class="text-end">
                            <div class="btn-group btn-group-sm" role="group">
                                <a class="btn btn-outline-primary" title="Ver detalle" href="@Url.Action("Detalle", "SolicitudAOCR", new { id = item.CodigoSolicitud })">
                                    <i class="fas fa-eye"></i>
                                </a>
                                @if (puedeValidarAocrRevision)
                                {
                                    <a class="btn btn-outline-warning" title="Validar" href="@Url.Action("ValidarAocr", "CoordinacionJefatura")">
                                        <i class="fas fa-stamp"></i>
                                    </a>
                                }
                                @if (puedeLegalizar)
                                {
                                    <a class="btn btn-outline-success" title="Legalizar" href="@Url.Action("RevisarLegalizacion", "SolicitudAOCR")">
                                        <i class="fas fa-scale-balanced"></i>
                                    </a>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
