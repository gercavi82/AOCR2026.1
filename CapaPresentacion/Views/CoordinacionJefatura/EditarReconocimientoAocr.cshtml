@inherits System.Web.Mvc.WebViewPage<CapaPresentacion.Models.AocrDocumentoEdicionViewModel>
@using System.Collections.Generic
@using System.Web.Mvc
@using System.Web.Mvc.Html

@{
    Layout = "~/Views/Shared/_LayoutAOCR.cshtml";
    ViewBag.Title = "Completar Reconocimiento AOCR";
}

<style>
    .aocr-editor-page {
        padding-bottom: 1.75rem;
        background:
            radial-gradient(circle at top left, rgba(13, 79, 154, 0.08), transparent 22%),
            linear-gradient(180deg, #f4f8fc 0%, #eef4f8 22%, #f8fbfd 100%);
    }

    .aocr-editor-shell {
        max-width: 1520px;
        margin: 0 auto;
    }

    .aocr-editor-hero,
    .aocr-editor-card,
    .aocr-editor-footer {
        border: 1px solid rgba(212, 222, 232, 0.92);
        border-radius: 22px;
        box-shadow: 0 16px 36px rgba(15, 40, 70, 0.07);
        overflow: hidden;
    }

    .aocr-editor-hero {
        background: linear-gradient(135deg, #fdfefe 0%, #f2f7fb 55%, #eaf2f8 100%);
    }

    .aocr-editor-card {
        background: rgba(255, 255, 255, 0.96);
    }

    .aocr-editor-footer {
        background: linear-gradient(180deg, #fbfdff 0%, #f3f8fc 100%);
    }

    .aocr-editor-hero .card-body,
    .aocr-editor-card .card-body,
    .aocr-editor-footer .card-body {
        padding: 1.45rem 1.55rem;
    }

    .aocr-editor-kicker {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        padding: 0.35rem 0.75rem;
        border-radius: 999px;
        background: rgba(13, 110, 253, 0.08);
        color: #0d4f9a;
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.03em;
        text-transform: uppercase;
    }

    .aocr-editor-hero-layout {
        display: grid;
        grid-template-columns: minmax(0, 1.65fr) minmax(300px, 0.95fr);
        gap: 1.5rem;
        align-items: stretch;
    }

    .aocr-editor-hero-main {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .aocr-editor-title {
        margin: 0.95rem 0 0.35rem;
        font-size: 2.15rem;
        font-weight: 700;
        color: #15324b;
        letter-spacing: -0.02em;
    }

    .aocr-editor-subtitle {
        margin: 0;
        max-width: 780px;
        color: #5d7184;
        font-size: 1rem;
        line-height: 1.55;
    }

    .aocr-editor-hero-meta {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 0.85rem;
        margin-top: 0.15rem;
    }

    .aocr-editor-meta-card {
        padding: 0.85rem 0.95rem;
        border: 1px solid rgba(202, 214, 225, 0.9);
        border-radius: 16px;
        background: rgba(255, 255, 255, 0.78);
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.65);
    }

    .aocr-editor-meta-label {
        display: block;
        margin-bottom: 0.28rem;
        color: #6c8093;
        font-size: 0.73rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        text-transform: uppercase;
    }

    .aocr-editor-meta-value {
        display: block;
        color: #18354e;
        font-size: 0.95rem;
        font-weight: 700;
        line-height: 1.3;
        word-break: break-word;
    }

    .aocr-editor-hero-side {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 1rem;
        padding: 1rem;
        border: 1px solid rgba(206, 217, 227, 0.92);
        border-radius: 18px;
        background: rgba(255, 255, 255, 0.8);
    }

    .aocr-editor-hero-side-copy {
        margin: 0;
        color: #667b8e;
        font-size: 0.9rem;
        line-height: 1.55;
    }

    .aocr-editor-top-actions {
        display: flex;
        flex-wrap: wrap;
        justify-content: flex-end;
        gap: 0.75rem;
    }

    .aocr-editor-top-actions .btn {
        min-width: 200px;
        border-radius: 12px;
        font-weight: 600;
    }

    .aocr-editor-card .card-header {
        padding: 1.2rem 1.55rem 0.85rem;
        background: #fff;
        border: 0;
        border-bottom: 1px solid #edf2f6;
    }

    .aocr-editor-section-title {
        margin: 0;
        font-size: 1.12rem;
        font-weight: 700;
        color: #19364f;
        letter-spacing: -0.01em;
    }

    .aocr-editor-section-copy {
        margin: 0.42rem 0 0;
        max-width: 860px;
        color: #73879a;
        font-size: 0.92rem;
        line-height: 1.55;
    }

    .aocr-editor-grid {
        row-gap: 1rem;
    }

    .aocr-editor-grid + .aocr-editor-grid {
        margin-top: 0.15rem;
    }

    .aocr-editor-stack {
        display: grid;
        gap: 1rem;
        height: 100%;
    }

    .aocr-editor-stack-fit {
        height: auto;
        align-content: start;
    }

    .aocr-editor-card .card-body > .aocr-editor-stack {
        gap: 1.2rem;
    }

    .aocr-editor-field {
        display: flex;
        flex-direction: column;
        gap: 0.45rem;
        height: 100%;
    }

    .aocr-editor-field .form-label {
        margin-bottom: 0;
        font-size: 0.84rem;
        font-weight: 700;
        color: #24425d;
    }

    .aocr-editor-field .form-control,
    .aocr-editor-field .form-select {
        min-height: 44px;
        border-radius: 12px;
        border-color: #d7e0ea;
        box-shadow: none;
        background: #fbfdff;
        transition: border-color 0.2s ease, box-shadow 0.2s ease, background-color 0.2s ease;
    }

    .aocr-editor-field .form-control:focus,
    .aocr-editor-field .form-select:focus {
        border-color: #7fa8d0;
        box-shadow: 0 0 0 0.18rem rgba(13, 79, 154, 0.12);
        background: #fff;
    }

    .aocr-editor-field textarea.form-control {
        min-height: 110px;
        resize: vertical;
    }

    .aocr-editor-field-sm textarea.form-control {
        min-height: 88px;
    }

    .aocr-editor-field-lg textarea.form-control {
        min-height: 140px;
    }

    .aocr-editor-field-xl textarea.form-control {
        min-height: 280px;
    }

    .aocr-editor-cluster-grid {
        display: grid;
        gap: 1rem;
    }

    .aocr-editor-split-grid {
        display: grid;
        grid-template-columns: minmax(0, 1.45fr) minmax(290px, 0.9fr);
        gap: 1rem;
        align-items: stretch;
    }

    .aocr-editor-side-stack {
        display: grid;
        gap: 1rem;
        height: 100%;
    }

    .aocr-editor-cluster {
        height: 100%;
        padding: 1.05rem 1.05rem 1.1rem;
        border: 1px solid #e1e8ef;
        border-radius: 18px;
        background: linear-gradient(180deg, #fcfeff 0%, #f6f9fc 100%);
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.74);
    }

    .aocr-editor-cluster-head {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 0.95rem;
    }

    .aocr-editor-cluster-title {
        margin: 0;
        color: #1e3a54;
        font-size: 0.92rem;
        font-weight: 700;
    }

    .aocr-editor-cluster-copy {
        margin: 0.25rem 0 0;
        color: #728597;
        font-size: 0.82rem;
        line-height: 1.5;
    }

    .aocr-editor-cluster-badge {
        display: inline-flex;
        align-items: center;
        padding: 0.3rem 0.62rem;
        border-radius: 999px;
        background: #edf5ff;
        color: #0d4f9a;
        font-size: 0.72rem;
        font-weight: 700;
        white-space: nowrap;
    }

    .aocr-editor-firmas-grid {
        row-gap: 1.2rem;
    }

    .aocr-editor-firmas-grid > [class*="col-"] {
        display: flex;
    }

    .aocr-editor-firmas-box {
        height: 100%;
        width: 100%;
        padding: 1.1rem 1.1rem 1.15rem;
        border: 1px solid #e0e8ef;
        border-radius: 18px;
        background: linear-gradient(180deg, #fbfdff 0%, #f4f8fb 100%);
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.72);
    }

    .aocr-editor-box-title {
        margin: 0;
        font-size: 0.96rem;
        font-weight: 700;
        color: #1f3b55;
    }

    .aocr-editor-box-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 1rem;
        margin-bottom: 0.95rem;
    }

    .aocr-editor-box-copy {
        margin: 0.28rem 0 0;
        color: #708396;
        font-size: 0.83rem;
        line-height: 1.5;
    }

    .aocr-editor-box-badge {
        display: inline-flex;
        align-items: center;
        padding: 0.32rem 0.65rem;
        border-radius: 999px;
        background: #e9f3ff;
        color: #0d4f9a;
        font-size: 0.72rem;
        font-weight: 700;
        white-space: nowrap;
    }

    .aocr-editor-status {
        border-radius: 16px;
        border: 1px solid #dde5ed;
        padding: 1rem 1.1rem;
        background: linear-gradient(180deg, #fbfdff 0%, #f4f8fb 100%);
        color: #4a6176;
    }

    .aocr-pointer-copy {
        margin: 0;
        color: #6d8092;
        font-size: 0.93rem;
    }

    .aocr-pointer-shell {
        align-items: stretch;
    }

    .aocr-pointer-stage-card,
    .aocr-pointer-controls {
        height: 100%;
        border: 1px solid #dbe5ee;
        border-radius: 20px;
        background: linear-gradient(180deg, #fdfefe 0%, #f4f8fb 100%);
        padding: 1.15rem;
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.78);
    }

    .aocr-pointer-stage-header,
    .aocr-pointer-controls-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 1rem;
        margin-bottom: 0.9rem;
    }

    .aocr-pointer-stage-title,
    .aocr-pointer-controls-title {
        margin: 0;
        font-size: 0.95rem;
        font-weight: 700;
        color: #1d3b56;
    }

    .aocr-pointer-stage-note,
    .aocr-pointer-controls-note {
        margin: 0.25rem 0 0;
        color: #718496;
        font-size: 0.84rem;
    }

    .aocr-pointer-stage-frame {
        padding: 1rem;
        border: 1px solid #e2e9f1;
        border-radius: 18px;
        background: linear-gradient(180deg, #f5f8fc 0%, #edf3f8 100%);
    }

    .aocr-pointer-badge {
        display: inline-flex;
        align-items: center;
        padding: 0.38rem 0.7rem;
        border-radius: 999px;
        background: #eaf3ff;
        color: #0d4f9a;
        font-size: 0.76rem;
        font-weight: 700;
        white-space: nowrap;
    }

    .aocr-pointer-controls-grid {
        row-gap: 1rem;
    }

    .aocr-pointer-sidebar-hint {
        padding: 0.95rem 1rem;
        border: 1px solid #dde7f0;
        border-radius: 16px;
        background: #fff;
    }

    .aocr-pointer-sidebar-hint-title {
        margin: 0 0 0.35rem;
        color: #1f3b55;
        font-size: 0.86rem;
        font-weight: 700;
    }

    .aocr-pointer-sidebar-hint-copy {
        margin: 0;
        color: #708396;
        font-size: 0.82rem;
        line-height: 1.55;
    }

    .aocr-pointer-slider-card {
        height: 100%;
        padding: 0.95rem 1rem;
        border: 1px solid #dde6ef;
        border-radius: 16px;
        background: #fff;
    }

    .aocr-pointer-slider-card .form-label {
        margin-bottom: 0;
        font-size: 0.85rem;
        font-weight: 700;
        color: #23435f;
    }

    .aocr-pointer-slider-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 0.75rem;
        margin-bottom: 0.7rem;
    }

    .aocr-pointer-slider-value {
        color: #5d7489;
        font-size: 0.77rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.02em;
    }

    .aocr-pointer-slider-card .form-range {
        margin-bottom: 0;
    }

    .aocr-pointer-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin-top: 0.15rem;
    }

    .aocr-pointer-actions .btn {
        flex: 1 1 220px;
        min-height: 46px;
        border-radius: 12px;
        font-weight: 600;
    }

    .aocr-editor-footer .card-body {
        display: grid;
        grid-template-columns: minmax(0, 1.15fr) minmax(380px, 0.95fr);
        gap: 1.15rem;
        align-items: center;
    }

    .aocr-editor-footer-lead {
        display: grid;
        gap: 0.55rem;
    }

    .aocr-editor-footer-title {
        margin: 0;
        color: #19364f;
        font-size: 1rem;
        font-weight: 700;
    }

    .aocr-editor-footer-copy {
        margin: 0;
        color: #6f8294;
        font-size: 0.92rem;
        line-height: 1.55;
    }

    .aocr-editor-footer-actions {
        display: flex;
        flex-wrap: wrap;
        justify-content: flex-end;
        gap: 0.75rem;
    }

    .aocr-editor-footer-actions .btn {
        flex: 1 1 180px;
        min-height: 48px;
        border-radius: 12px;
        font-weight: 600;
    }

    .aocr-btn-priority {
        box-shadow: 0 12px 24px rgba(25, 54, 79, 0.16);
    }

    @@media (max-width: 991.98px) {
        .aocr-editor-hero-layout,
        .aocr-editor-footer .card-body,
        .aocr-editor-split-grid {
            grid-template-columns: 1fr;
        }

        .aocr-editor-title {
            font-size: 1.7rem;
        }

        .aocr-editor-hero-meta {
            grid-template-columns: 1fr;
        }

        .aocr-editor-top-actions,
        .aocr-editor-footer-actions {
            justify-content: stretch;
        }

        .aocr-editor-top-actions .btn,
        .aocr-editor-footer-actions .btn,
        .aocr-pointer-actions .btn {
            width: 100%;
        }
    }

    @@media (max-width: 767.98px) {
        .aocr-editor-card .card-header,
        .aocr-editor-hero .card-body,
        .aocr-editor-card .card-body,
        .aocr-editor-footer .card-body {
            padding-left: 1.1rem;
            padding-right: 1.1rem;
        }

        .aocr-pointer-stage-card,
        .aocr-pointer-controls,
        .aocr-editor-firmas-box,
        .aocr-editor-hero-side,
        .aocr-editor-cluster {
            padding: 1rem;
        }
    }
</style>

<div class="container-fluid mt-4 aocr-editor-page">
    <div class="aocr-editor-shell">
    <div class="card aocr-editor-hero mb-4">
        <div class="card-body">
            <div class="aocr-editor-hero-layout">
                <div class="aocr-editor-hero-main">
                    <div>
                        <span class="aocr-editor-kicker">Gestion documental AOCR</span>
                        <h1 class="aocr-editor-title">Completar Reconocimiento AOCR</h1>
                        <p class="aocr-editor-subtitle">Organice la información institucional, prepare los datos de firma y ajuste la ubicación del bloque autorizado antes de generar el PDF final con una composición clara, controlada y lista para firma digital.</p>
                    </div>
                    <div class="aocr-editor-hero-meta">
                        <div class="aocr-editor-meta-card">
                            <span class="aocr-editor-meta-label">Documento</span>
                            <span class="aocr-editor-meta-value">@(!string.IsNullOrWhiteSpace(Model.NumeroAocr) ? Model.NumeroAocr : "Pendiente de numeracion")</span>
                        </div>
                        <div class="aocr-editor-meta-card">
                            <span class="aocr-editor-meta-label">Estado otorgante</span>
                            <span class="aocr-editor-meta-value">@(!string.IsNullOrWhiteSpace(Model.EstadoOtorgante) ? Model.EstadoOtorgante : "Por completar")</span>
                        </div>
                        <div class="aocr-editor-meta-card">
                            <span class="aocr-editor-meta-label">Solicitud</span>
                            <span class="aocr-editor-meta-value">#@Model.SolicitudId</span>
                        </div>
                    </div>
                </div>
                <div class="aocr-editor-hero-side">
                    <p class="aocr-editor-hero-side-copy">Utilice este módulo para consolidar la información del reconocimiento, validar los responsables institucionales y dejar lista la ubicación de la firma autorizada antes de descargar el PDF.</p>
                    <div class="aocr-editor-top-actions">
                        <a class="btn btn-outline-secondary" href="@Url.Action("ValidarAocr", "CoordinacionJefatura")">Volver a la bandeja</a>
                        <a class="btn btn-outline-dark" href="@Url.Action("Detalle", "SolicitudAOCR", new { id = Model.SolicitudId })">Abrir tramite</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @using (Html.BeginForm("GenerarDocumentoValidacionAocr", "CoordinacionJefatura", FormMethod.Post, new { target = "_blank", enctype = "multipart/form-data", id = "formDocumentoAocr" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.SolicitudId)
        @Html.HiddenFor(m => m.InspeccionId)
        @Html.HiddenFor(m => m.TipoDocumento)
        @Html.HiddenFor(m => m.NumeroAocr)
        @Html.HiddenFor(m => m.NombreDocumento)
        @Html.HiddenFor(m => m.UsaPosicionFirmaPersonalizada)
        @Html.HiddenFor(m => m.NumeroPaginaFirma)
        @Html.HiddenFor(m => m.PosicionFirmaX)
        @Html.HiddenFor(m => m.PosicionFirmaY)
        @Html.HiddenFor(m => m.AnchoFirma)
        @Html.HiddenFor(m => m.AltoFirma)

        <div class="card aocr-editor-card mb-4">
            <div class="card-header">
                <h2 class="aocr-editor-section-title">Datos generales</h2>
                <p class="aocr-editor-section-copy">Identificación principal del reconocimiento, datos del explotador y estado base del documento.</p>
            </div>
            <div class="card-body">
                <div class="aocr-editor-cluster-grid">
                    <div class="aocr-editor-cluster">
                        <div class="aocr-editor-cluster-head">
                            <div>
                                <h3 class="aocr-editor-cluster-title">Identificación documental</h3>
                                <p class="aocr-editor-cluster-copy">Datos base del reconocimiento y referencia institucional del documento.</p>
                            </div>
                            <span class="aocr-editor-cluster-badge">Base</span>
                        </div>
                        <div class="row aocr-editor-grid">
                            <div class="col-xl-3 col-md-6">
                                <div class="aocr-editor-field">
                                    <label class="form-label">Numero AOCR</label>
                                    @Html.TextBoxFor(m => m.NumeroAocr, new { @class = "form-control", @readonly = "readonly" })
                                </div>
                            </div>
                            <div class="col-xl-3 col-md-6">
                                <div class="aocr-editor-field">
                                    <label class="form-label">Numero certificado original</label>
                                    @Html.TextBoxFor(m => m.AocOriginalNumero, new { @class = "form-control" })
                                </div>
                            </div>
                            <div class="col-xl-3 col-md-6">
                                <div class="aocr-editor-field">
                                    <label class="form-label">Estado otorgante</label>
                                    @Html.TextBoxFor(m => m.EstadoOtorgante, new { @class = "form-control" })
                                </div>
                            </div>
                            <div class="col-xl-3 col-md-6">
                                <div class="aocr-editor-field">
                                    <label class="form-label">Fecha de emisión del documento</label>
                                    @Html.TextBoxFor(m => m.FechaEmisionDocumento, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="aocr-editor-cluster">
                        <div class="aocr-editor-cluster-head">
                            <div>
                                <h3 class="aocr-editor-cluster-title">Datos del explotador</h3>
                                <p class="aocr-editor-cluster-copy">Información del titular del reconocimiento y sus canales de contacto principales.</p>
                            </div>
                            <span class="aocr-editor-cluster-badge">Operador</span>
                        </div>
                        <div class="aocr-editor-split-grid">
                            <div class="aocr-editor-side-stack">
                                <div class="row aocr-editor-grid">
                                    <div class="col-md-6">
                                        <div class="aocr-editor-field">
                                            <label class="form-label">Nombre del explotador</label>
                                            @Html.TextBoxFor(m => m.NombreExplotador, new { @class = "form-control" })
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="aocr-editor-field">
                                            <label class="form-label">Razón social</label>
                                            @Html.TextBoxFor(m => m.RazonSocial, new { @class = "form-control" })
                                        </div>
                                    </div>
                                </div>
                                <div class="aocr-editor-field aocr-editor-field-lg">
                                    <label class="form-label">Dirección del explotador</label>
                                    @Html.TextAreaFor(m => m.DireccionExplotador, new { @class = "form-control", rows = "4" })
                                </div>
                            </div>
                            <div class="aocr-editor-side-stack">
                                <div class="aocr-editor-field">
                                    <label class="form-label">Estado del explotador</label>
                                    @Html.TextBoxFor(m => m.EstadoExplotador, new { @class = "form-control" })
                                </div>
                                <div class="aocr-editor-field">
                                    <label class="form-label">Teléfono</label>
                                    @Html.TextBoxFor(m => m.TelefonoExplotador, new { @class = "form-control" })
                                </div>
                                <div class="aocr-editor-field">
                                    <label class="form-label">Correo</label>
                                    @Html.TextBoxFor(m => m.CorreoExplotador, new { @class = "form-control" })
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card aocr-editor-card mb-4">
            <div class="card-header">
                <h2 class="aocr-editor-section-title">Contacto en Ecuador y soporte operacional</h2>
                <p class="aocr-editor-section-copy">Información de soporte local, contacto operativo y referencias institucionales del representante técnico.</p>
            </div>
            <div class="card-body">
                <div class="row aocr-editor-grid">
                    <div class="col-lg-5 col-md-12">
                        <div class="aocr-editor-cluster">
                            <div class="aocr-editor-cluster-head">
                                <div>
