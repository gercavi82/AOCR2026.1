@model CapaPresentacion.Models.ValidarAocrViewModel
@using CapaPresentacion.Models
@using CapaDatos.Constants
@using System.Linq

@{
    Layout = "~/Views/Shared/_LayoutAOCR.cshtml";
    ViewBag.Title = "Validar AOCR";
    var items = Model != null ? Model.Items ?? new List<ValidarAocrSolicitudItemViewModel>() : new List<ValidarAocrSolicitudItemViewModel>();
    var puedeValidar = User.IsInRole("Administrador")
        || User.IsInRole("DIRDAC")
        || User.IsInRole("Direccion")
        || User.IsInRole("DirectorGeneral")
        || User.IsInRole("JefaturaTecnica");
}

<div class="container-fluid mt-4">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="@Url.Action("DashboardInspeccion", "CoordinacionJefatura")">Dashboard Inspección</a></li>
            <li class="breadcrumb-item active" aria-current="page">Validar AOCR</li>
        </ol>
    </nav>
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                <div>
                    <h2 class="mb-1">Validar AOCR</h2>
                    <p class="text-muted mb-0">Documentos AOCR institucionales disponibles segun la fase del tramite; en modificaciones directas, Condiciones y Limitaciones puede prepararse sin informe tecnico firmado.</p>
                </div>
                <a class="btn btn-outline-secondary" href="@Url.Action("DashboardInspeccion", "CoordinacionJefatura")">Volver al dashboard</a>
            </div>
        </div>
    </div>

    @if (!items.Any())
    {
        <div class="alert alert-info">No existen trámites AOCR listos para validación institucional en este momento.</div>
    }
    else
    {
        foreach (var item in items)
        {
            var solicitud = item.Solicitud;
            var estadoNormalizado = EstadoSolicitud.Normalizar(solicitud != null ? solicitud.Estado : null);
            var esModificacionDirecta = solicitud != null
                && solicitud.TipoSolicitud.GetValueOrDefault() == 3
                && (estadoNormalizado == EstadoSolicitud.GeneradoCondicionesLimitaciones
                    || estadoNormalizado == EstadoSolicitud.EnRevisionCoordinadorFinal
                    || estadoNormalizado == EstadoSolicitud.EnviadoDcav
                    || estadoNormalizado == EstadoSolicitud.FirmadoDcav
                    || estadoNormalizado == EstadoSolicitud.Finalizado);
            var alertaEstadoClass = (item.FirmaCompleta || esModificacionDirecta) ? "alert-success" : "alert-warning";
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-body">
                    <div class="d-flex flex-column flex-lg-row justify-content-between gap-3 mb-3">
                        <div>
                            <h4 class="mb-1">@(solicitud != null && !string.IsNullOrWhiteSpace(solicitud.NumeroSolicitud) ? solicitud.NumeroSolicitud : (solicitud != null ? solicitud.CodigoSolicitud.ToString() : "N/D"))</h4>
                            <div class="text-muted">@(solicitud != null ? (solicitud.RazonSocial ?? solicitud.NombreOperador ?? solicitud.NombreComercial ?? "Operador no disponible") : "Solicitud no disponible")</div>
                        </div>
                        <div class="text-lg-end">
                            <div><strong>Estado actual:</strong> @(solicitud != null ? solicitud.Estado : "N/D")</div>
                            <div><strong>AOCR:</strong> @item.NumeroAocr</div>
                            <div><strong>Fecha firma:</strong> @(item.FechaFirmaFinal.HasValue ? item.FechaFirmaFinal.Value.ToString("dd/MM/yyyy HH:mm") : "Pendiente")</div>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-3">
                            <div class="border rounded p-3 h-100">
                                <small class="text-muted d-block">Firmantes</small>
                                <strong>@item.Firmantes</strong>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="border rounded p-3 h-100">
                                <small class="text-muted d-block">Inspeccion</small>
                                <strong>@(item.Inspeccion != null ? item.Inspeccion.CodigoInspeccion.ToString() : "Pendiente")</strong>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="border rounded p-3 h-100">
                                <small class="text-muted d-block">Disponibilidad documental</small>
                                <strong>@(item.FechaDisponibilidad.HasValue ? item.FechaDisponibilidad.Value.ToString("dd/MM/yyyy HH:mm") : "Pendiente")</strong>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="border rounded p-3 h-100">
                                <small class="text-muted d-block">Continuidad</small>
                                <strong>@(item.ListoParaEnvioRt ? "Listo para envio al RT" : "En validacion")</strong>
                            </div>
                        </div>
                    </div>

                    <div class="alert @alertaEstadoClass mb-3">
                        <strong>@item.MensajeEstado</strong>
                        @if (!string.IsNullOrWhiteSpace(item.MensajeAdvertencia))
                        {
                            <div class="mt-1">@item.MensajeAdvertencia</div>
                        }
                    </div>

                    <div class="table-responsive">
                        <table class="table table-striped align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Documento</th>
                                    <th>Tipo</th>
                                    <th>Estado</th>
                                    <th>Fecha</th>
                                    <th>Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var documento in item.Documentos)
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-semibold">@documento.NombreVisible</div>
                                            @if (!string.IsNullOrWhiteSpace(documento.Observacion))
                                            {
                                                <small class="text-muted">@documento.Observacion</small>
                                            }
                                        </td>
                                        <td>@documento.TipoDocumento</td>
                                        <td>
                                            <span class="badge @(documento.Disponible ? "bg-success" : "bg-warning text-dark")">@documento.Estado</span>
                                        </td>
                                        <td>@(documento.FechaDocumento.HasValue ? documento.FechaDocumento.Value.ToString("dd/MM/yyyy HH:mm") : "Pendiente")</td>
                                        <td>
                                            @{ var tieneAcciones = !string.IsNullOrWhiteSpace(documento.UrlEditar) || !string.IsNullOrWhiteSpace(documento.UrlVer) || !string.IsNullOrWhiteSpace(documento.UrlDescargar); }
                                            @if (tieneAcciones)
                                            {
                                                <div class="d-flex gap-2 flex-wrap">
                                                    @if (!string.IsNullOrWhiteSpace(documento.UrlEditar))
                                                    {
                                                        <a class="btn btn-sm btn-primary" href="@documento.UrlEditar">Completar</a>
                                                    }
                                                    @if (!string.IsNullOrWhiteSpace(documento.UrlVer))
                                                    {
                                                        <a class="btn btn-sm btn-outline-secondary" href="@documento.UrlVer" target="_blank" rel="noopener">PDF directo</a>
                                                    }
                                                    @if (!string.IsNullOrWhiteSpace(documento.UrlDescargar))
                                                    {
                                                        <a class="btn btn-sm btn-outline-dark" href="@documento.UrlDescargar" target="_blank" rel="noopener">Descargar</a>
                                                    }
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="text-muted">Pendiente</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="d-flex flex-column flex-lg-row justify-content-between gap-3 mt-4">
                        <div>
                            <a class="btn btn-outline-dark" href="@Url.Action("Detalle", "SolicitudAOCR", new { id = solicitud.CodigoSolicitud })">Abrir detalle del tramite</a>
                        </div>
                        @if (puedeValidar && item.PuedeContinuar)
                        {
                            <form method="post" action="@Url.Action("AprobarPorJefatura", "SolicitudAOCR")" class="d-flex flex-column flex-md-row gap-2 align-items-stretch">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@solicitud.CodigoSolicitud" />
                                <input type="text" name="observaciones" class="form-control" placeholder="Observacion de validacion (opcional)" />
                                <button type="submit" class="btn btn-success">Validar AOCR y continuar flujo</button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        }
    }
</div>
