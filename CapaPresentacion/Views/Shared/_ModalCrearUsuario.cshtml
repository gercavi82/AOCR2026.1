    function sincronizarCompaniaTodasFilas() {
        $('#representantesBody tr').each(function() {
            sincronizarCompaniaFila($(this));
        });
    }

    function agregarCompaniaSeleccionadaActual() {
        var $select = $('#EmpresaCodigo');
        var codigo = ($select.val() || '').trim();
        var nombre = ($select.find('option:selected').data('nombre') || $select.find('option:selected').text() || '').toString().trim();

        if (!codigo) {
            sincronizarEmpresaDesdeTexto($('#EmpresaTexto').val());
            codigo = ($select.val() || '').trim();
            nombre = ($select.find('option:selected').data('nombre') || $select.find('option:selected').text() || '').toString().trim();
            if (!codigo) {
                mostrarErrorCampo('#EmpresaCodigo', 'Debe seleccionar una empresa antes de agregar.');
                return;
            }
        }

        removerErrorCampo('#EmpresaCodigo');

        var existe = companiasSeleccionadasRegistro.some(function (c) {
            return (c.codigo || '').toUpperCase() === codigo.toUpperCase();
        });

        if (existe) {
            return;
        }

        companiasSeleccionadasRegistro.push({
            codigo: codigo,
            nombre: nombre || codigo
        });

        renderCompaniasSeleccionadasRegistro();
        limpiarSeleccionEmpresaActual();
    }

    function limpiarSeleccionEmpresaActual() {
        $('#EmpresaCodigo').val('');
        $('#EmpresaTexto').val('');
        removerErrorCampo('#EmpresaCodigo');
        var $inputEmpresa = $('#EmpresaTexto');
        if ($inputEmpresa.length) {
            $inputEmpresa.trigger('focus');
        }
    }

    function eliminarCompaniaSeleccionada(codigo) {
        companiasSeleccionadasRegistro = companiasSeleccionadasRegistro.filter(function (c) {
            return (c.codigo || '').toUpperCase() !== (codigo || '').toUpperCase();
        });

        renderCompaniasSeleccionadasRegistro();
    }

    function renderCompaniasSeleccionadasRegistro() {
        var $list = $('#companiasSeleccionadasList');
        var $hidden = $('#companiasHiddenContainer');
        $list.empty();
        $hidden.empty();

        if (companiasSeleccionadasRegistro.length === 0) {
            $list.append(
                $('<div class="list-group-item text-muted small">')
                    .text('No hay compañías agregadas.')
            );
            return;
        }

        companiasSeleccionadasRegistro.forEach(function (compania, index) {
            var $item = $('<div class="list-group-item d-flex justify-content-between align-items-center py-2">');
            $item.append($('<span class="small fw-semibold">').text('[' + compania.codigo + '] ' + compania.nombre));

            var $btn = $('<button type="button" class="btn btn-sm btn-outline-danger">')
                .html('<i class="fas fa-times"></i>')
                .on('click', function () {
                    eliminarCompaniaSeleccionada(compania.codigo);
                });
            $item.append($btn);
            $list.append($item);

            $hidden.append($('<input type="hidden">').attr('name', 'Companias[' + index + '].IdCompania').val(compania.codigo));
            $hidden.append($('<input type="hidden">').attr('name', 'Companias[' + index + '].NombreCompania').val(compania.nombre));
        });

        actualizarDeclaracionResponsabilidad();
    }

    function registrarUsuario(e) {
        e.preventDefault();

        if (!validarFormularioUsuario()) {
            return false;
        }

        // Mostrar loading
        $('#spinnerRegistro').removeClass('d-none');
        $('#btnRegistrar').prop('disabled', true);

        const formData = new FormData(this);

        $.ajax({
            url: '@Url.Action("Crear", "Usuario")',
            type: 'POST',
            data: formData,
            processData: false,
            contentType: false,
            success: function(response) {
                if (response.success) {
                    // Usar función global del layout
                    if (typeof mostrarToast === 'function') {
                        mostrarToast('Éxito', response.message || 'Usuario registrado', 'success');
                    }

                    hideModalById('modalRegistroUsuario');
                    limpiarFormularioUsuario();

                    // Callback para recargar datos
                    if (typeof onUsuarioRegistrado === 'function') {
                        onUsuarioRegistrado(response.usuarioId);
                    }
                } else {
                    mostrarErrorModal(response.message || 'Error al registrar');
                }
            },
            error: function(xhr) {
                mostrarErrorModal(xhr.responseJSON?.message || 'Error en el servidor');
            },
            complete: function() {
                $('#spinnerRegistro').addClass('d-none');
                $('#btnRegistrar').prop('disabled', false);
            }
        });
    }

    function validarFormularioUsuario() {
        let valido = true;
        const tieneCompaniasAgregadas = companiasSeleccionadasRegistro.length > 0;

        // Validar campos requeridos
        $('input[required]').each(function() {
            const idCampo = ($(this).attr('id') || '').trim();
            if (idCampo === 'EmpresaTexto' && tieneCompaniasAgregadas) {
                removerErrorCampo(this);
                return;
            }
            if (!$(this).val().trim()) {
                mostrarErrorCampo(this, 'Campo requerido');
                valido = false;
            }
        });

        // Validar correo formato
        const correo = $('#Correo').val().trim();
        const emailRegex = /^[^\s\u0040]+\u0040[^\s\u0040]+\.[^\s\u0040]+$/;
        if (!emailRegex.test(correo)) {
            mostrarErrorCampo('#Correo', 'Correo inválido');
            valido = false;
        }

        if (!$('#aceptaDeclaracion').is(':checked')) {
            mostrarErrorCampo('#aceptaDeclaracion', 'Debe aceptar la declaración de responsabilidad');
            valido = false;
        } else {
            removerErrorCampo('#aceptaDeclaracion');
        }
        // Validar empresa seleccionada
        const empresaCodigo = ($('#EmpresaCodigo').val() || '').trim();
        if (!tieneCompaniasAgregadas && !empresaCodigo) {
            mostrarErrorCampo('#EmpresaCodigo', 'Debe seleccionar una empresa');
            valido = false;
        }

        if (!tieneCompaniasAgregadas && empresaCodigo) {
            agregarCompaniaSeleccionadaActual();
        }

        if (companiasSeleccionadasRegistro.length === 0) {
            $('#companiasSeleccionadasError').show();
            valido = false;
        } else {
            $('#companiasSeleccionadasError').hide();
            removerErrorCampo('#EmpresaCodigo');
        }

        return valido;
    }

    function registrarDeclaracionTemporal(aceptada) {
        var correo = ($('#Correo').val() || '').trim();
        var tipoIdentificacion = $('input[name="TipoIdentificacion"]:checked').val() || '';
        var identificacion = ($('#CedulaIdentificacion').val() || '').trim();
        var ruc = ($('#RUC').val() || '').trim();
        var nombres = ($('#NombreUsuario').val() || '').trim();
        var apellidos = ($('#ApellidoUsuario').val() || '').trim();
        var companias = obtenerCompaniasDeclaracion();
        var empresaCodigo = companias.length > 0 ? companias.map(function (c) { return c.codigo; }).join(',') : ($('#EmpresaCodigo').val() || '');
        var empresaNombre = companias.length > 0
            ? companias.map(function (c) { return '[' + c.codigo + '] ' + c.nombre; }).join(' | ')
            : ($('#EmpresaTexto').val() || '').trim();
        var companiasJson = JSON.stringify(companias);

        if (!correo) {
            return;
        }

        var token = $('#crearForm input[name="__RequestVerificationToken"]').val();

        $.ajax({
            url: '@Url.Action("RegistrarDeclaracionTemporal", "Usuario")',
            type: 'POST',
            data: {
                __RequestVerificationToken: token,
                correo: correo,
                tipoIdentificacion: tipoIdentificacion,
                identificacion: identificacion,
                ruc: ruc,
                nombres: nombres,
                apellidos: apellidos,
                empresaCodigo: empresaCodigo,
                empresaNombre: empresaNombre,
                companiasJson: companiasJson,
                aceptada: !!aceptada
            }
        }).done(function (resp) {
            if (resp && resp.success === false) {
                if (typeof mostrarErrorModal === 'function') {
                    mostrarErrorModal(resp.message || 'No se pudo guardar la declaración temporal.');
                } else if (typeof mostrarToast === 'function') {
                    mostrarToast('Advertencia', resp.message || 'No se pudo guardar la declaración temporal.', 'warning');
                } else {
                    alert(resp.message || 'No se pudo guardar la declaración temporal.');
                }
            }
        }).fail(function () {
            var msg = 'No se pudo guardar la declaración temporal. Verifique su conexión.';
            if (typeof mostrarErrorModal === 'function') {
                mostrarErrorModal(msg);
            } else if (typeof mostrarToast === 'function') {
                mostrarToast('Advertencia', msg, 'warning');
            } else {
                alert(msg);
            }
        });
    }

    function mostrarErrorCampo(selector, mensaje) {
        $(selector).addClass('is-invalid');
        const errorDiv = $(selector).next('.invalid-feedback');
        if (errorDiv.length) {
            errorDiv.text(mensaje).show();
        }
    }

    function removerErrorCampo(selector) {
        $(selector).removeClass('is-invalid');
        $(selector).next('.invalid-feedback').hide();
    }

    function mostrarErrorModal(mensaje) {
        $('#modalAlertMessage').text(mensaje);
        $('#modalAlertContainer').removeClass('d-none');
        $('#modalRegistroUsuario').animate({ scrollTop: 0 }, 500);
    }

    function logEmpresa(mensaje) {
        var $container = $('#empresaLogContainer');
        var $log = $('#empresaLog');
        var ts = new Date().toLocaleTimeString();
        $container.removeClass('d-none');
        // Prepend a log entry safely using text() to avoid HTML injection
        $log.prepend( $('<div>').text('[' + ts + '] ' + mensaje) );
    }

    function ocultarLogEmpresa(delayMs) {
        var $container = $('#empresaLogContainer');
        if ($container.length === 0) return;
        var ms = typeof delayMs === 'number' ? delayMs : 0;
        setTimeout(function () {
            $container.addClass('d-none');
        }, ms);
    }

    // Compatibilidad: en algunas pantallas legacy no existe panel de representante.
    function toggleSeccionRepresentante(mostrar, limpiarFilas) {
        var $panel = $('#panelRepresentante');
        if ($panel.length) {
            if (mostrar) {
                $panel.removeClass('d-none');
            } else {
                $panel.addClass('d-none');
            }
        }

        if (limpiarFilas) {
            var $body = $('#representantesBody');
            if ($body.length) {
                $body.empty();
            }
        }
    }

    function limpiarFormularioUsuario() {
        $('#crearForm')[0].reset();
        if (typeof toggleSeccionRepresentante === 'function') {
            toggleSeccionRepresentante(false, true);
        }
        $('.invalid-feedback').hide();
        $('.is-invalid').removeClass('is-invalid');
        $('#modalAlertContainer').addClass('d-none');
        companiasSeleccionadasRegistro = [];
        renderCompaniasSeleccionadasRegistro();
        $('#companiasSeleccionadasError').hide();
    }

    // Función para seleccionar compañía (llamada desde modal externo)
    window.seleccionarCompaniaParaUsuario = function(id, nombre) {
        if (filaActivaModal) {
            filaActivaModal.find('.idCompania').val(id);
            filaActivaModal.find('.nombreCompania').val(nombre);
        }
    };
</script>








