@inherits System.Web.Mvc.WebViewPage
@using System
@{
    var pageTitle = ViewBag.Title != null ? ViewBag.Title.ToString() : string.Empty;
    var pageSubtitle = ViewBag.PageSubtitle != null ? ViewBag.PageSubtitle.ToString() : string.Empty;
    var headerActionsHtml = ViewData["HeaderActionsHtml"] != null ? ViewData["HeaderActionsHtml"].ToString() : string.Empty;
    var hideBreadcrumb = ViewData["HideBreadcrumb"] != null && string.Equals(ViewData["HideBreadcrumb"].ToString(), "true", StringComparison.OrdinalIgnoreCase);
    var controllerObj = ViewContext.RouteData.Values["controller"];
    var controllerName = controllerObj != null ? controllerObj.ToString() : string.Empty;
    var controllerBreadName = controllerName;

    if (controllerName.Equals("Direccion", StringComparison.OrdinalIgnoreCase))
    {
        controllerBreadName = "Dirección";
    }
    else if (controllerName.Equals("CoordinacionJefatura", StringComparison.OrdinalIgnoreCase))
    {
        controllerBreadName = "Coordinación y Jefatura";
    }
    else if (controllerName.Equals("SolicitudAOCR", StringComparison.OrdinalIgnoreCase))
    {
        controllerBreadName = "Solicitudes AOCR";
    }
    else if (controllerName.Equals("OrdenRecaudacion", StringComparison.OrdinalIgnoreCase))
    {
        controllerBreadName = "Órdenes de Recaudación";
    }
}

<section class="content-header aocr-page-header">
    <div class="container-fluid">
        <div class="row align-items-center mb-2">
            <div class="col-sm-6">
                <h1 class="m-0 aocr-page-title">@pageTitle</h1>
                @if (!string.IsNullOrWhiteSpace(pageSubtitle))
                {
                    <div class="aocr-page-subtitle">@pageSubtitle</div>
                }
            </div>
            <div class="col-sm-6">
                @if (!string.IsNullOrWhiteSpace(headerActionsHtml))
                {
                    <div class="aocr-toolbar-right mb-2">@Html.Raw(headerActionsHtml)</div>
                }

                @if (!hideBreadcrumb)
                {
                    <div class="aocr-breadcrumb-wrap">
                        <ol class="breadcrumb aocr-page-breadcrumb aocr-breadcrumb float-sm-right" aria-label="Ruta de navegación">
                            <li class="breadcrumb-item aocr-breadcrumb-item">
                                <a href="@Url.Action("Index", "Home")"><i class="fas fa-home"></i> Inicio</a>
                            </li>
                            @if (!string.IsNullOrEmpty(controllerName) && !controllerName.Equals("Home", StringComparison.OrdinalIgnoreCase))
                            {
                                <li class="breadcrumb-item aocr-breadcrumb-item">@controllerBreadName</li>
                            }
                            <li class="breadcrumb-item aocr-breadcrumb-item active" aria-current="page">@pageTitle</li>
                        </ol>
                    </div>
                }
            </div>
        </div>
    </div>
</section>
