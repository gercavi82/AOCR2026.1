@inherits System.Web.Mvc.WebViewPage
@{
    Layout = null;
    var mensaje = ViewBag.ErrorMessage as string ?? "No tiene permisos para ejecutar esta operación o acceder a este recurso.";
    var detalle = ViewBag.ErrorDescription as string ?? "La autorización institucional del sistema AOCR bloqueó esta solicitud para proteger el flujo y la trazabilidad.";
    var tituloEncabezado = ViewBag.TituloEncabezado as string ?? "Acceso institucional no autorizado";
    var panelHint = ViewBag.PanelHint as string ?? "Verifique el rol seleccionado, la compañía activa y la etapa institucional del trámite antes de reintentar.";
    var mostrarSeleccionCompania = ViewBag.MostrarSeleccionCompania == null || (ViewBag.MostrarSeleccionCompania is bool && (bool)ViewBag.MostrarSeleccionCompania);
    var accionUrl = ViewBag.AccionUrl as string;
    var accionTexto = ViewBag.AccionTexto as string;
    var estilo = (ViewBag.Estilo as string ?? "denied").Trim().ToLowerInvariant();
    var esAdvertencia = estilo == "warning" || estilo == "info";
    var iconoPrincipal = esAdvertencia ? "fa-circle-exclamation" : "fa-user-lock";
    var colorAlerta = esAdvertencia ? "#b54708" : "#b42318";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>No autorizado - Sistema AOCR</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --aocr-navy: #0e2f44;
            --aocr-teal: #0f766e;
            --aocr-sand: #f3eee5;
            --aocr-ink: #153047;
            --aocr-alert: #b42318;
        }

        body {
            min-height: 100vh;
            margin: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            background:
                radial-gradient(circle at top left, rgba(15, 118, 110, 0.18), transparent 34%),
                radial-gradient(circle at bottom right, rgba(180, 35, 24, 0.12), transparent 28%),
                linear-gradient(145deg, #f7f2ea 0%, #ffffff 55%, #eef5f7 100%);
            color: var(--aocr-ink);
            font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
        }

        .aocr-denied-card {
            width: min(760px, calc(100vw - 2rem));
            border: 0;
            border-radius: 28px;
            overflow: hidden;
            box-shadow: 0 28px 60px rgba(14, 47, 68, 0.18);
            background: rgba(255, 255, 255, 0.96);
        }

        .aocr-denied-top {
            background: linear-gradient(120deg, var(--aocr-navy), #145374 70%, var(--aocr-teal));
            color: #fff;
            padding: 2rem 2.25rem;
        }

        .aocr-denied-badge {
            display: inline-flex;
            align-items: center;
            gap: .5rem;
            border-radius: 999px;
            padding: .45rem .9rem;
            background: rgba(255, 255, 255, 0.12);
            font-size: .85rem;
            letter-spacing: .08em;
            text-transform: uppercase;
        }

        .aocr-denied-body {
            padding: 2rem 2.25rem 2.25rem;
        }

        .aocr-denied-icon {
            width: 88px;
            height: 88px;
            border-radius: 24px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, rgba(180, 35, 24, 0.12), rgba(15, 118, 110, 0.14));
            color: @colorAlerta;
            font-size: 2rem;
            margin-bottom: 1.25rem;
        }

        .aocr-denied-copy {
            font-size: 1.05rem;
            line-height: 1.7;
            color: #425466;
        }

        .aocr-denied-panel {
            background: var(--aocr-sand);
            border-left: 4px solid var(--aocr-teal);
            border-radius: 16px;
            padding: 1rem 1.1rem;
            margin-top: 1.5rem;
        }

        .aocr-denied-actions {
            display: flex;
            gap: .75rem;
            flex-wrap: wrap;
            margin-top: 1.75rem;
        }

        .btn-aocr-primary {
            background: var(--aocr-navy);
            border-color: var(--aocr-navy);
            color: #fff;
        }

        .btn-aocr-primary:hover,
        .btn-aocr-primary:focus {
            background: #123b56;
            border-color: #123b56;
            color: #fff;
        }

        @@media (max-width: 576px) {
            .aocr-denied-top,
            .aocr-denied-body {
                padding: 1.5rem;
            }

            .aocr-denied-actions .btn {
                width: 100%;
            }
        }
    </style>
</head>
<body>
    <section class="aocr-denied-card">
        <div class="aocr-denied-top">
            <div class="aocr-denied-badge">
                <i class="fas fa-shield-halved"></i>
                Sistema AOCR · DGAC Ecuador
            </div>
            <h1 class="h3 mt-3 mb-2">@tituloEncabezado</h1>
            <p class="mb-0 opacity-75">Dirección General de Aviación Civil — control de acceso institucional.</p>
        </div>
        <div class="aocr-denied-body">
            <div class="aocr-denied-icon">
                <i class="fas @iconoPrincipal"></i>
            </div>
            <h2 class="h4 mb-3">@mensaje</h2>
            @if (!string.IsNullOrWhiteSpace(detalle))
            {
                <p class="aocr-denied-copy mb-0">@detalle</p>
            }

            @if (!string.IsNullOrWhiteSpace(panelHint))
            {
                <div class="aocr-denied-panel">
                    <strong>Qué revisar:</strong>
                    <div class="mt-2">@panelHint</div>
                </div>
            }

            <div class="aocr-denied-actions">
                @if (!string.IsNullOrWhiteSpace(accionUrl) && !string.IsNullOrWhiteSpace(accionTexto))
                {
                    <a href="@accionUrl" class="btn btn-aocr-primary">
                        <i class="fas fa-arrow-right me-2"></i>@accionTexto
                    </a>
                }
                <a href="@Url.Action("Index", "Home")" class="btn btn-aocr-primary">
                    <i class="fas fa-house me-2"></i>Ir al inicio
                </a>
                @if (mostrarSeleccionCompania)
                {
                    <a href="@Url.Action("SeleccionarCompania", "Account", new { returnUrl = Request.RawUrl })" class="btn btn-outline-secondary">
                        <i class="fas fa-building-circle-check me-2"></i>Seleccionar compañía
                    </a>
                }
                <button type="button" class="btn btn-outline-dark" onclick="history.back()">
                    <i class="fas fa-arrow-left me-2"></i>Volver
                </button>
            </div>
        </div>
    </section>
</body>
</html>
