@inherits System.Web.Mvc.WebViewPage
@using System
@{
    var iconClass = ViewData["IconClass"] != null ? ViewData["IconClass"].ToString() : "fas fa-landmark";
    var overline = ViewData["Overline"] != null ? ViewData["Overline"].ToString() : "Sistema AOCR";
    var title = ViewData["Title"] != null ? ViewData["Title"].ToString() : string.Empty;
    var subtitle = ViewData["Subtitle"] != null ? ViewData["Subtitle"].ToString() : string.Empty;
    var description = ViewData["Description"] != null ? ViewData["Description"].ToString() : string.Empty;
    var metricLabel = ViewData["MetricLabel"] != null ? ViewData["MetricLabel"].ToString() : string.Empty;
    var metricValue = ViewData["MetricValue"] != null ? ViewData["MetricValue"].ToString() : string.Empty;
}

<div class="card aocr-hero aocr-hero-panel mb-4">
    <div class="card-body">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div>
                <div class="aocr-hero-kicker aocr-hero-overline"><i class="@iconClass mr-1"></i> @overline</div>
                <h2 class="aocr-hero-title">@title</h2>
                @if (!string.IsNullOrWhiteSpace(subtitle))
                {
                    <p class="aocr-hero-subtitle mb-1">@subtitle</p>
                }
                @if (!string.IsNullOrWhiteSpace(description))
                {
                    <p class="aocr-hero-description">@description</p>
                }
            </div>
            @if (!string.IsNullOrWhiteSpace(metricLabel) || !string.IsNullOrWhiteSpace(metricValue))
            {
                <div class="aocr-hero-metric aocr-metric-card" style="min-width:130px;">
                    <div class="card-body text-center">
                        <div class="aocr-metric-value">@metricValue</div>
                        <div class="aocr-metric-label mb-0">@metricLabel</div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
