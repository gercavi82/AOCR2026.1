@inherits System.Web.Mvc.WebViewPage
@using System
@using System.Collections.Generic
@using CapaModelo
@using System.Web.Mvc.Html
@using CapaDatos.DAOs
@using CapaPresentacion.Helpers
@* ~/Views/Shared/_Sidebar.cshtml *@
<div class="aocr-sidebar-shell text-white">
    <div class="sidebar-header aocr-sidebar-panel text-center">
        <img src="@Url.Content("~/Content/imganes/logo1.png")"
             alt="DGAC Logo"
             class="logo shadow-sm" />

        <div class="mt-3 aocr-sidebar-user-card">
            <div class="aocr-sidebar-user-card__name">@((Session["NombreUsuario"] as string) ?? "Usuario AOCR")</div>
            <div class="aocr-sidebar-user-card__role">@((Session["Rol"] as string) ?? "Perfil institucional")</div>
            <span class="chip chip-info">USUARIO ACTIVO</span>
            <div class="user-mail">@Session["Correo"]</div>
            <div class="mt-2">
                @Html.Partial("_SeleccionarRol")
            </div>
        </div>
    </div>

    @{
        var rolActual = Session["Rol"] != null ? Session["Rol"].ToString() : "";
        int idUsuario = 0;
        var sessionUserId = Session["IdUsuario"] ?? Session["UserId"];
        if (sessionUserId != null)
        {
            int.TryParse(sessionUserId.ToString(), out idUsuario);
        }

        bool tieneOrdenGenerada = false;
        bool tieneOrdenBorrador = false;
        try
        {
            if (idUsuario > 0)
            {
                // Instancia del DAO para validar estados financieros
                var daoOR = new OrdenRecaudacionDAO();
                tieneOrdenGenerada = daoOR.ExisteORGeneradaOPagada(idUsuario);
                tieneOrdenBorrador = daoOR.ExisteORMinima(idUsuario);
            }
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine("_Sidebar: Error consultando estado de orden: " + ex.Message);
        }

        // Visibilidad estricta por rol seleccionado en sesion (con aliases de roles)
        var rolNormalizado = (rolActual ?? string.Empty).Trim();
        Func<string, bool> esRol = rol => rolNormalizado.Equals(rol, StringComparison.OrdinalIgnoreCase);

        bool esAdministrador = esRol("Administrador");
        bool esSolicitanteRol = esRol("Operador") || esRol("Solicitante");
        bool esTecnicaRol = esRol("Inspector") || esRol("Tecnico") || esRol("EvaluadorTecnico") || esRol("CoordinadorInspecciones");
        bool esFinancieroRol = esRol("Financiero") || esRol("CoordinadorFinanciero");
        bool esLegalRol = esRol("CoordinacionLegal") || esRol("CoordinadorLegal");
        bool esDireccionRol = esRol("Direccion") || esRol("JefaturaTecnica") || esRol("DirectorFinanciero") || esRol("DirectorGeneral");
        bool esCoordinacionJefaturaRol = esLegalRol || esDireccionRol;
        bool esAprobadorUsuariosRol = esLegalRol || esRol("JefaturaTecnica");

        // Solo Solicitante/Operador requieren crear su propia orden
        bool requiereOrden = esSolicitanteRol;

        bool puedeSolicitante = esSolicitanteRol;
        bool puedeTecnica = esAdministrador || esTecnicaRol;
        bool puedeFinanciero = esAdministrador || esFinancieroRol;
        bool puedeLegal = esAdministrador || esLegalRol;
        bool puedeDireccion = esAdministrador || esDireccionRol;
        bool puedeCoordinacionJefatura = esAdministrador || esCoordinacionJefaturaRol;
        bool puedeAprobarUsuarios = esAdministrador || esAprobadorUsuariosRol;
        bool puedeAdministracion = esAdministrador || esRol("Direccion") || esRol("JefaturaTecnica");

        // Módulo de órdenes visibles solo para rol solicitante
        bool mostrarModuloOrdenes = esSolicitanteRol;

        var companiasRtAsignadas = new List<UsuarioCompaniaRT>();
        var codigoCompaniaActiva = CompaniaActivaSessionHelper.ObtenerCodigo(Session);
        var nombreCompaniaActiva = CompaniaActivaSessionHelper.ObtenerNombre(Session);
        var mostrarSelectorCompaniaRt = false;
        Func<string, List<string>> parsearCompaniasLegacy = raw =>
        {
            if (string.IsNullOrWhiteSpace(raw))
            {
                return new List<string>();
            }

            return raw
                .Split(new[] { ',', ';', '|' }, StringSplitOptions.RemoveEmptyEntries)
                .Select(x => (x ?? string.Empty).Trim().ToUpperInvariant())
                .Where(x => !string.IsNullOrWhiteSpace(x))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToList();
        };
        try
        {
            if (idUsuario > 0)
            {
                var daoCompaniasRt = new UsuarioCompaniaRTDAO();
                companiasRtAsignadas = daoCompaniasRt.ObtenerCompaniasAsignadas(idUsuario);

                var usuarioActual = UsuarioDAO.ObtenerPorId(idUsuario);
                if (usuarioActual != null)
                {
                    var legacyCodigos = parsearCompaniasLegacy(usuarioActual.EmpresaCodigo);
                    foreach (var codigo in legacyCodigos)
                    {
                        if (companiasRtAsignadas.Any(c => string.Equals((c.CompaniaCodigo ?? string.Empty).Trim(), codigo, StringComparison.OrdinalIgnoreCase)))
                        {
                            continue;
                        }

                        companiasRtAsignadas.Add(new UsuarioCompaniaRT
                        {
                            UsuarioId = idUsuario,
                            CompaniaCodigo = codigo,
                            CompaniaNombre = codigo,
                            Activo = true
                        });
                    }
                }

                companiasRtAsignadas = companiasRtAsignadas
                    .Where(c => c != null && !string.IsNullOrWhiteSpace(c.CompaniaCodigo))
                    .GroupBy(c => (c.CompaniaCodigo ?? string.Empty).Trim(), StringComparer.OrdinalIgnoreCase)
                    .Select(g => g.First())
                    .OrderBy(c => (c.CompaniaCodigo ?? string.Empty).Trim())
                    .ToList();

                mostrarSelectorCompaniaRt = companiasRtAsignadas.Count > 1;

                if (string.IsNullOrWhiteSpace(codigoCompaniaActiva) && companiasRtAsignadas.Count == 1)
                {
                    codigoCompaniaActiva = (companiasRtAsignadas[0].CompaniaCodigo ?? string.Empty).Trim();
                }

                if (string.IsNullOrWhiteSpace(nombreCompaniaActiva) && !string.IsNullOrWhiteSpace(codigoCompaniaActiva))
                {
                    var companiaActiva = companiasRtAsignadas.FirstOrDefault(c =>
                        string.Equals(
                            (c.CompaniaCodigo ?? string.Empty).Trim(),
                            codigoCompaniaActiva.Trim(),
                            StringComparison.OrdinalIgnoreCase));
                    if (companiaActiva != null)
                    {
                        nombreCompaniaActiva = (companiaActiva.CompaniaNombre ?? string.Empty).Trim();
                    }
                }

                if (string.IsNullOrWhiteSpace(nombreCompaniaActiva) && !string.IsNullOrWhiteSpace(codigoCompaniaActiva))
                {
                    nombreCompaniaActiva = codigoCompaniaActiva;
                }
            }
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine("_Sidebar: Error consultando companias RT: " + ex.Message);
        }
    }

    <!-- Indicador de estado de orden -->
    @if (requiereOrden)
    {
        <div class="alert aocr-sidebar-alert @(tieneOrdenGenerada ? "alert-success" : tieneOrdenBorrador ? "alert-warning" : "alert-danger")
             mb-3 py-2 small" role="alert">
            <div class="d-flex align-items-center">
                <i class="fas fa-file-invoice-dollar @(tieneOrdenGenerada ? "text-success" : tieneOrdenBorrador ? "text-warning" : "text-danger")
                   mr-2"></i>
                <div>
                    @if (tieneOrdenGenerada)
                    {
                        <strong>Orden Generada ✓</strong>
                        <div class="text-success small">Puede acceder al sistema</div>
                    }
                    else if (tieneOrdenBorrador)
                    {
                        <strong>Orden en Borrador ⚠</strong>
                        <div class="text-warning small">
                            <a href="@Url.Action("Obligatoria", "OrdenRecaudacion")" class="text-warning">Completar orden</a>
                        </div>
                    }
                    else
                    {
                        <strong>Orden Requerida!</strong>
                        <div class="text-danger small">
                            <a href="@Url.Action("Obligatoria", "OrdenRecaudacion")" class="text-danger">Crear orden primero</a>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    @if (companiasRtAsignadas.Count > 0)
    {
        <div class="compania-contexto aocr-sidebar-panel mb-3">
            <div class="compania-label">COMPANIA ACTIVA</div>
            <div class="compania-name">
                @if (!string.IsNullOrWhiteSpace(codigoCompaniaActiva))
                {
                    <span>[@codigoCompaniaActiva] </span>
                }
                @(!string.IsNullOrWhiteSpace(nombreCompaniaActiva) ? nombreCompaniaActiva : "No definida")
            </div>

            @if (mostrarSelectorCompaniaRt)
            {
                using (Html.BeginForm("CambiarCompaniaActiva", "Account", System.Web.Mvc.FormMethod.Post, new { @class = "mt-2 mb-0" }))
                {
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@Request.RawUrl" />
                    <div class="input-group input-group-sm">
                        <select name="companiaCodigo" class="form-select form-select-sm" required>
                            @foreach (var compania in companiasRtAsignadas)
                            {
                                var codigo = (compania.CompaniaCodigo ?? string.Empty).Trim();
                                var nombre = (compania.CompaniaNombre ?? string.Empty).Trim();
                                var selected = string.Equals(codigo, codigoCompaniaActiva, StringComparison.OrdinalIgnoreCase)
                                    ? "selected"
                                    : string.Empty;
                                <option value="@codigo" @selected>
                                    [@codigo] @(string.IsNullOrWhiteSpace(nombre) ? codigo : nombre)
                                </option>
                            }
                        </select>
                        <button type="submit" class="btn btn-outline-info">Cambiar</button>
                    </div>
                }
            }
        </div>
    }

    <div class="menu-container aocr-sidebar-sections">
        <div class="section-title aocr-sidebar-title">Navegación Institucional</div>

        @* ===================== ORDENES DE RECAUDACIÓN ===================== *@
        @if (mostrarModuloOrdenes)
        {
            <div class="nav-group aocr-sidebar-section mb-4">
                <div class="group-title aocr-sidebar-section__title text-primary">
                    <i class="fas fa-file-invoice-dollar mr-1"></i> Órdenes de Recaudación
                </div>
                <ul class="aocr-nav">
                    <li>
                        <a class="aocr-link aocr-sidebar-item @(tieneOrdenBorrador ? "text-warning fw-bold" : "")" href="@(tieneOrdenBorrador ? Url.Action("Obligatoria","OrdenRecaudacion") : Url.Action("Nueva","OrdenRecaudacion"))">
                            <i class="fas fa-plus-circle @(tieneOrdenBorrador ? "text-warning" : "text-success") mr-2"></i>
                            @(tieneOrdenBorrador ? "Completar Orden Pendiente" : "Nueva Orden")
                        </a>
                    </li>
                    <li>
                        <a class="aocr-link aocr-sidebar-item" href="@Url.Action("MisOrdenes", "Orden")">
                            <i class="fas fa-history text-white-50 mr-2"></i> Mis Órdenes
                        </a>
                    </li>
                    @if (esAdministrador)
                    {
                        <li>
                            <a class="aocr-link aocr-sidebar-item" href="@Url.Action("TodasOrdenes", "Financiero")">
                                <i class="fas fa-list-alt text-white-50 mr-2"></i> Todas las Órdenes
                            </a>
                        </li>
                    }
                </ul>
            </div>
        }

        @* ===================== SOLICITANTE ===================== *@
        @if (puedeSolicitante)
        {
            <div class="nav-group aocr-sidebar-section mb-4">
                <div class="group-title aocr-sidebar-section__title text-warning">
                    <i class="fas fa-user-edit mr-1"></i> Solicitudes AOCR
                </div>
                <ul class="aocr-nav">
                    @* Opciones técnicas bloqueadas hasta que exista una orden válida *@
                    @if (tieneOrdenGenerada)
                    {
                        <li>
                            <a class="aocr-link aocr-sidebar-item" href="@Url.Action("Index", "SolicitudAOCR", new { abrir = "nueva" })">
                                <i class="fas fa-plus text-success mr-2"></i> Nueva Solicitud AOCR
                            </a>
                        </li>
                    }

                    <li>
                        <a class="aocr-link aocr-sidebar-item" href="@Url.Action("Index", "SolicitudAOCR")">
                            <i class="fas fa-folder-open text-white-50 mr-2"></i> Mis Solicitudes
                        </a>
                    </li>

                    @if (tieneOrdenGenerada)
                    {
                        <li>
                            <a class="aocr-link aocr-sidebar-item" href="@Url.Action("CargarDocumentos", "SolicitudAOCR")">
                                <i class="fas fa-file-upload text-info mr-2"></i> Cargar Documentos
                            </a>
                        </li>
                    }
                </ul>
            </div>
        }

        @* ===================== INSPECCIÓN / TÉCNICA (solo si la orden ya está generada) ===================== *@
        @if (puedeTecnica)
        {
            <div class="nav-group aocr-sidebar-section mb-4">
                <div class="group-title aocr-sidebar-section__title text-info">
                    <i class="fas fa-search mr-1"></i> Gestión Técnica
                </div>
                <ul class="aocr-nav">
                    <li>
                        <a class="aocr-link aocr-sidebar-item" href="@Url.Action("RevisarSolicitudes", "SolicitudAOCR")">
                            <i class="fas fa-tasks text-white-50 mr-2"></i> Revisar Solicitudes
                        </a>
                    </li>
                    <li>
                        <a class="aocr-link aocr-sidebar-item" href="@Url.Action("Index", "Inspeccion")">
                            <i class="fas fa-clipboard-check text-success mr-2"></i> Gestionar Inspecciones
                        </a>
                    </li>
                </ul>
            </div>
        }

        @* ===================== FINANCIERO (solo si la orden ya está generada) ===================== *@
        @if (puedeFinanciero)
        {
            <div class="nav-group aocr-sidebar-section mb-4">
                <div class="group-title aocr-sidebar-section__title text-success">
                    <i class="fas fa-money-bill-wave mr-1"></i> Área Financiera
                </div>
                <ul class="aocr-nav">
                    <li><a class="aocr-link aocr-sidebar-item" href="@Url.Action("TodasOrdenes", "Financiero")"><i class="fas fa-receipt text-white-50 mr-2"></i> Gestionar Órdenes</a></li>
                    <li><a class="aocr-link aocr-sidebar-item" href="@Url.Action("Index", "Financiero")"><i class="fas fa-check-circle text-white-50 mr-2"></i> Verificar Pagos</a></li>
                    <li><a class="aocr-link aocr-sidebar-item" href="@Url.Action("Index", "ReportesFinancieros")"><i class="fas fa-file-invoice text-white-50 mr-2"></i> Reportes Financieros</a></li>
                </ul>
            </div>
        }

        @* ===================== COORDINACION Y JEFATURA (bloque BPMN unificado) ===================== *@
        @if (puedeCoordinacionJefatura)
        {
            <div class="nav-group aocr-sidebar-section mb-4">
                <div class="group-title aocr-sidebar-section__title text-danger">
                    <i class="fas fa-user-tie mr-1"></i> Dirección / Jefatura
                </div>
                <ul class="aocr-nav">
                    @if (esAdministrador || esRol("Direccion") || esRol("JefaturaTecnica") || esRol("DirectorGeneral"))
                    {
                        <li><a class="aocr-link aocr-sidebar-item" href="@Url.Action("DashboardGerencial", "CoordinacionJefatura")"><i class="fas fa-chart-line text-white-50 mr-2"></i> Dashboard Gerencial</a></li>
                    }
                    <li><a class="aocr-link aocr-sidebar-item" href="@Url.Action("RevisionVerificacion", "CoordinacionJefatura")"><i class="fas fa-search text-white-50 mr-2"></i> Revisión / Verificación</a></li>
                    @if (esAdministrador || esRol("Direccion") || esRol("JefaturaTecnica"))
                    {
                        <li><a class="aocr-link aocr-sidebar-item" href="@Url.Action("Index", "Tecnico")"><i class="fas fa-user-check text-white-50 mr-2"></i> Asignar Inspector</a></li>
                        <li><a class="aocr-link aocr-sidebar-item" href="@Url.Action("AprobarSolicitudes", "CoordinacionJefatura")"><i class="fas fa-check-double text-white-50 mr-2"></i> Aprobar Solicitudes</a></li>
                    }
                    @if (esAdministrador || esRol("JefaturaTecnica"))
                    {
                        <li><a class="aocr-link aocr-sidebar-item" href="@Url.Action("ValidarAocr", "CoordinacionJefatura")"><i class="fas fa-stamp text-white-50 mr-2"></i> Validar AOCR</a></li>
                    }
                    @if (esAdministrador || esRol("CoordinacionLegal") || esRol("CoordinadorLegal") || esRol("DirectorGeneral"))
                    {
                        <li><a class="aocr-link aocr-sidebar-item" href="@Url.Action("LegalizarAocr", "CoordinacionJefatura")"><i class="fas fa-gavel text-white-50 mr-2"></i> Legalizar AOCR</a></li>
                        <li><a class="aocr-link aocr-sidebar-item" href="@Url.Action("GenerarCertificados", "CoordinacionJefatura")"><i class="fas fa-file-contract text-white-50 mr-2"></i> Generar Certificados</a></li>
                    }
                </ul>
            </div>
        }

        @* ===================== ADMINISTRACIÓN ===================== *@
        @if (puedeAdministracion || puedeAprobarUsuarios)
        {
            <div class="nav-group aocr-sidebar-section mb-4">
                <div class="group-title aocr-sidebar-section__title text-warning">
                    <i class="fas fa-user-cog mr-1"></i> Administración
                </div>
                <ul class="aocr-nav">
                    @if (puedeAdministracion)
                    {
                        <li>
                            <a class="aocr-link aocr-sidebar-item" href="@Url.Action("ConfiguracionSistema", "Direccion")">
                                <i class="fas fa-cogs text-white-50 mr-2"></i> Configuración Sistema
                            </a>
                        </li>
                        <li>
                            <a class="aocr-link aocr-sidebar-item" href="@Url.Action("Index", "AdminUsuarios")">
                                <i class="fas fa-users-cog text-white-50 mr-2"></i> Gestionar Usuarios
                            </a>
                        </li>
                        <li>
                            <a class="aocr-link aocr-sidebar-item" href="@Url.Action("PermisosRol", "AdminUsuarios")">
                                <i class="fas fa-shield-alt text-white-50 mr-2"></i> Roles y Permisos
                            </a>
                        </li>
                    }

                    @if (esAdministrador)
                    {
                        <li>
                            <a class="aocr-link aocr-sidebar-item" href="@Url.Action("CrearUsuarioInternoRT", "AdminUsuarios")">
                                <i class="fas fa-user-plus text-white-50 mr-2"></i> Crear Usuario Interno RT
                            </a>
                        </li>
                        <li>
                            <a class="aocr-link aocr-sidebar-item" href="@Url.Action("Index", "SyncAdmin")">
                                <i class="fas fa-sync-alt text-white-50 mr-2"></i> Sync RT DB2
                            </a>
                        </li>
                    }

                    @if (puedeAprobarUsuarios)
                    {
                        <li>
                            <a class="aocr-link aocr-sidebar-item" href="@Url.Action("RevisarDesignaciones", "Usuario")">
                                <i class="fas fa-clipboard-check text-white-50 mr-2"></i> Aprobar Usuarios RT
                            </a>
                        </li>
                    }
                </ul>
            </div>
        }
    </div>

    <div class="aocr-sidebar-divider"></div>

    <div class="aocr-sidebar-footer mt-auto">
        <ul class="aocr-nav">
            <li>
                <a class="aocr-link aocr-sidebar-item" href="@Url.Action("Index", "Home")">
                    <i class="fas fa-home text-info mr-2"></i> Dashboard Inicio
                </a>
            </li>

            @if (!tieneOrdenGenerada && requiereOrden)
            {
                <li>
                    <a class="aocr-link aocr-sidebar-item text-warning fw-bold" href="@Url.Action("Obligatoria", "OrdenRecaudacion")">
                        <i class="fas fa-exclamation-triangle text-warning mr-2"></i> ⚠ Orden Requerida
                    </a>
                </li>
            }

            <li>
                <a class="aocr-link aocr-sidebar-item text-danger fw-bold" href="@Url.Action("Logout", "Account")">
                    <i class="fas fa-sign-out-alt text-danger mr-2"></i> Cerrar Sesión
                </a>
            </li>
        </ul>
    </div>
</div>

<script>
    (function waitForJQuery() {
        if (typeof jQuery === 'undefined') {
            setTimeout(waitForJQuery, 50);
            return;
        }

        var $ = jQuery;

        // Mostrar tooltip para elementos bloqueados
        $(document).ready(function() {
            $('[title]').tooltip({
                placement: 'right',
                trigger: 'hover'
            });
        });
    })();
</script>






