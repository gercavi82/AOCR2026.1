@inherits System.Web.Mvc.WebViewPage
@using System
@using System.Collections.Generic
@using System.Linq
@using CapaNegocio.Services
@using CapaModelo
@using System.Web.Mvc.Html
@using CapaDatos.DAOs
@using CapaPresentacion.Helpers
@* ~/Views/Shared/_Sidebar.cshtml *@
<div class="aocr-sidebar-shell text-white">
    @{
        var rolHeader = RoleGroupingHelper.NormalizeSelectedRole(Session["Rol"] as string ?? string.Empty);
        var nombreHeader = (Session["NombreUsuario"] as string ?? string.Empty).Trim();
        var correoHeader = (Session["Correo"] as string ?? string.Empty).Trim();
        var rolHeaderTexto = RoleGroupingHelper.ToDisplayName(rolHeader);
    }

    <div class="sidebar-header aocr-sidebar-panel text-center">
        <div class="mt-3 aocr-sidebar-user-card">
            <div class="aocr-sidebar-user-card__name">@(!string.IsNullOrWhiteSpace(nombreHeader) ? nombreHeader : "Usuario AOCR")</div>
            <div class="aocr-sidebar-user-card__role">@(!string.IsNullOrWhiteSpace(rolHeaderTexto) ? rolHeaderTexto : "Perfil institucional")</div>
            <span class="chip chip-info">USUARIO ACTIVO</span>
            <div class="user-mail">@(!string.IsNullOrWhiteSpace(correoHeader) ? correoHeader : "Sin correo registrado")</div>
            <div class="mt-2">
                @Html.Partial("_SeleccionarRol")
            </div>
        </div>
    </div>

    @{
        var rolActual = RoleGroupingHelper.NormalizeSelectedRole(Session["Rol"] as string ?? string.Empty);
        var rolesRaw = RoleGroupingHelper.ExtractRoles(Session["RolesRaw"] ?? Session["Roles"], Session["Rol"] as string);
        var sinRolesRaw = rolesRaw.Count == 0;
        int idUsuario = 0;
        var sessionUserId = Session["IdUsuario"] ?? Session["UserId"];
        if (sessionUserId != null)
        {
            int.TryParse(sessionUserId.ToString(), out idUsuario);
        }

        bool tieneOrdenGenerada = false;
        bool tieneOrdenBorrador = false;
        bool tieneOrdenPendienteProceso = false;
        bool tieneOrdenPendienteComprobante = false;
        try
        {
            if (idUsuario > 0)
            {
                // Cache ligero en Session para evitar 2 queries DB en cada page render
                var cacheKey = "_Sidebar_OrdenStatus_" + idUsuario;
                var cached = Session[cacheKey] as int[];
                var now = DateTime.UtcNow.Ticks;
                // Refrescar cada 30 segundos
                var cacheTimeKey = cacheKey + "_t";
                var cachedTime = Session[cacheTimeKey] as long?;
                if (cached != null && cached.Length >= 4 && cachedTime.HasValue && (now - cachedTime.Value) < TimeSpan.FromSeconds(30).Ticks)
                {
                    tieneOrdenGenerada = cached[0] == 1;
                    tieneOrdenBorrador = cached[1] == 1;
                    tieneOrdenPendienteProceso = cached[2] == 1;
                    tieneOrdenPendienteComprobante = cached[3] == 1;
                }
                else
                {
                    var daoOR = new OrdenRecaudacionDAO();
                    tieneOrdenGenerada = daoOR.TieneOrdenHabilitanteAOCR(idUsuario);
                    tieneOrdenBorrador = daoOR.ExisteORMinima(idUsuario);
                    tieneOrdenPendienteProceso = daoOR.TieneOrdenActivaEnProceso(idUsuario);
                    tieneOrdenPendienteComprobante = daoOR.TieneOrdenPendienteComprobante(idUsuario);
                    Session[cacheKey] = new[]
                    {
                        tieneOrdenGenerada ? 1 : 0,
                        tieneOrdenBorrador ? 1 : 0,
                        tieneOrdenPendienteProceso ? 1 : 0,
                        tieneOrdenPendienteComprobante ? 1 : 0
                    };
                    Session[cacheTimeKey] = now;
                }
            }
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine("_Sidebar: Error consultando estado de orden: " + ex.Message);
        }

        bool esAdministrador = RoleGroupingHelper.IsAdministrador(rolActual);
        bool esSolicitanteRol = RoleGroupingHelper.IsSolicitante(rolActual)
            && (sinRolesRaw || RoleGroupingHelper.HasAnyRawRole(rolesRaw, "Operador", "Solicitante"));
        bool esRepresentanteRtRol = RoleGroupingHelper.IsSolicitante(rolActual)
            && RoleGroupingHelper.HasAnyRawRole(rolesRaw, "RepresentanteTecnico", "Representante Técnico", "RepresentanteLegal", "RT");
        bool esSolicitanteORT = esSolicitanteRol || esRepresentanteRtRol;

        // ── Roles internos delimitados: Inspector · Coordinador · RT · DIRDAC · Financiero ──
        bool esInspectorRol = RoleGroupingHelper.IsInspectorTecnico(rolActual)
            && (sinRolesRaw || RoleGroupingHelper.HasAnyRawRole(rolesRaw, "Inspector", "Tecnico", "EvaluadorTecnico"));
        bool esCoordinadorRol = RoleGroupingHelper.IsCoordinacion(rolActual)
            && (sinRolesRaw || RoleGroupingHelper.HasAnyRawRole(rolesRaw, "Coordinador", "CoordinadorInspecciones"));
        bool esFinancieroRol = RoleGroupingHelper.IsFinanciero(rolActual)
            && (sinRolesRaw || RoleGroupingHelper.HasAnyRawRole(rolesRaw, "Financiero", "CoordinadorFinanciero", "DirectorFinanciero"));
        bool esLegalRol = RoleGroupingHelper.IsCoordinacion(rolActual)
            && (sinRolesRaw || RoleGroupingHelper.HasAnyRawRole(rolesRaw, "CoordinacionLegal", "CoordinadorLegal"));
        bool esDirectorGeneralRol = RoleGroupingHelper.IsDireccionJefaturaTecnica(rolActual)
            && (sinRolesRaw || RoleGroupingHelper.HasAnyRawRole(rolesRaw, "DirectorGeneral"));
        bool esDirdacRol = RoleGroupingHelper.IsDireccionJefaturaTecnica(rolActual)
            && (sinRolesRaw || RoleGroupingHelper.HasAnyRawRole(rolesRaw, "DIRDAC", "Direccion", "JefaturaTecnica", "DirectorGeneral"));
        bool esDireccionRol   = esDirdacRol;  // alias compatibilidad
        bool esTecnicaRol     = esInspectorRol || esCoordinadorRol; // alias compatibilidad
        bool esCoordinacionJefaturaRol = esLegalRol || esDirdacRol;
        bool esAprobadorUsuariosRol    = esLegalRol || esCoordinadorRol || esDirdacRol;

        // Orden requerida solo para Solicitante/Operador externo
        // Administrador tambien la ve para gestion/visibilidad.
        bool requiereOrden = esSolicitanteRol || esAdministrador;
        var mensajeBloqueoRtSidebar = (!tieneOrdenBorrador && !tieneOrdenPendienteProceso && !tieneOrdenPendienteComprobante)
            ? "Debe generar la Orden de Recaudación para continuar con el proceso AOCR."
            : "El módulo de Solicitud AOCR se habilitará cuando Financiero apruebe el pago correspondiente.";

        bool puedeSolicitante      = esAdministrador || esSolicitanteRol;
        bool puedeRt               = esAdministrador || esRepresentanteRtRol;
        bool puedeInspector        = esAdministrador || esInspectorRol;
        bool puedeCoordinador      = esAdministrador || esCoordinadorRol;
        bool puedeTecnica          = puedeInspector || puedeCoordinador; // alias compatibilidad
        bool puedeFinanciero       = esAdministrador || esFinancieroRol;
        bool puedeLegal            = esAdministrador || esLegalRol;
        bool puedeDirdac           = esAdministrador || esDirdacRol;
        bool puedeDireccion        = puedeDirdac; // alias compatibilidad
        bool puedeCoordinacionJefatura = esAdministrador || esCoordinacionJefaturaRol;
        bool puedeAprobarUsuarios  = esAdministrador || esAprobadorUsuariosRol;
        bool puedeAdministracion   = esAdministrador;
        bool puedeValidarAocr      = esAdministrador || esDirdacRol || esDirectorGeneralRol;
        bool puedeLegalizarEmitirAocr = esAdministrador || esLegalRol || esDirectorGeneralRol;
        bool puedeAprobacionFinalDirdac = esAdministrador || esDirdacRol || esDirectorGeneralRol;
        bool puedeCoordinadorOperativo = esAdministrador || esCoordinadorRol;
        bool tieneNavegacionRol = puedeSolicitante
            || puedeRt
            || puedeInspector
            || puedeCoordinadorOperativo
            || puedeFinanciero
            || puedeDirdac
            || puedeLegalizarEmitirAocr
            || puedeAdministracion
            || puedeAprobarUsuarios;

        // Módulo de órdenes visible solo para Solicitante/Operador externo
        bool mostrarModuloOrdenes = esSolicitanteRol;

        var companiasRtAsignadas = new List<UsuarioCompaniaRT>();
        var codigoCompaniaActiva = CompaniaActivaSessionHelper.ObtenerCodigo(Session);
        var nombreCompaniaActiva = CompaniaActivaSessionHelper.ObtenerNombre(Session);
        var mostrarSelectorCompaniaRt = false;
        var tieneSolicitudRtHabilitada = false;
        Func<string, List<string>> parsearCompaniasLegacy = raw =>
        {
            if (string.IsNullOrWhiteSpace(raw))
            {
                return new List<string>();
            }

            return raw
                .Split(new[] { ',', ';', '|' }, StringSplitOptions.RemoveEmptyEntries)
                .Select(x => (x ?? string.Empty).Trim().ToUpperInvariant())
                .Where(x => !string.IsNullOrWhiteSpace(x))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToList();
        };
        try
        {
            if (idUsuario > 0)
            {
                var daoCompaniasRt = new UsuarioCompaniaRTDAO();
                companiasRtAsignadas = daoCompaniasRt.ObtenerCompaniasAsignadas(idUsuario);

                var usuarioActual = UsuarioDAO.ObtenerPorId(idUsuario);
                if (usuarioActual != null)
                {
                    var legacyCodigos = parsearCompaniasLegacy(usuarioActual.EmpresaCodigo);
                    foreach (var codigo in legacyCodigos)
                    {
                        if (companiasRtAsignadas.Any(c => string.Equals((c.CompaniaCodigo ?? string.Empty).Trim(), codigo, StringComparison.OrdinalIgnoreCase)))
                        {
                            continue;
                        }

                        companiasRtAsignadas.Add(new UsuarioCompaniaRT
                        {
                            UsuarioId = idUsuario,
                            CompaniaCodigo = codigo,
                            CompaniaNombre = codigo,
                            Activo = true
                        });
                    }
                }

                companiasRtAsignadas = companiasRtAsignadas
                    .Where(c => c != null && !string.IsNullOrWhiteSpace(c.CompaniaCodigo))
                    .GroupBy(c => (c.CompaniaCodigo ?? string.Empty).Trim(), StringComparer.OrdinalIgnoreCase)
                    .Select(g => g.First())
                    .OrderBy(c => (c.CompaniaCodigo ?? string.Empty).Trim())
                    .ToList();

                mostrarSelectorCompaniaRt = companiasRtAsignadas.Count > 1;

                if (string.IsNullOrWhiteSpace(codigoCompaniaActiva) && companiasRtAsignadas.Count == 1)
                {
                    codigoCompaniaActiva = (companiasRtAsignadas[0].CompaniaCodigo ?? string.Empty).Trim();
                }

                if (string.IsNullOrWhiteSpace(nombreCompaniaActiva) && !string.IsNullOrWhiteSpace(codigoCompaniaActiva))
                {
                    var companiaActiva = companiasRtAsignadas.FirstOrDefault(c =>
                        string.Equals(
                            (c.CompaniaCodigo ?? string.Empty).Trim(),
                            codigoCompaniaActiva.Trim(),
                            StringComparison.OrdinalIgnoreCase));
                    if (companiaActiva != null)
                    {
                        nombreCompaniaActiva = (companiaActiva.CompaniaNombre ?? string.Empty).Trim();
                    }
                }

                if (string.IsNullOrWhiteSpace(nombreCompaniaActiva) && !string.IsNullOrWhiteSpace(codigoCompaniaActiva))
                {
                    nombreCompaniaActiva = codigoCompaniaActiva;
                }

                if (esSolicitanteORT)
                {
                    var workflow = new AocrPostPagoWorkflowService();
                    var solicitudDao = new SolicitudAOCRDAO();
                    var solicitudesUsuario = (solicitudDao.ObtenerPorUsuario(idUsuario) ?? new List<SolicitudAOCR>())
                        .Where(s => s != null && s.CodigoSolicitud > 0)
                        .Where(s => string.IsNullOrWhiteSpace(codigoCompaniaActiva)
                            || string.IsNullOrWhiteSpace(s.CompaniasSeleccionadas)
                            || s.CompaniasSeleccionadas
                                .Split(',')
                                .Select(x => (x ?? string.Empty).Trim())
                                .Any(x => x.Equals(codigoCompaniaActiva, StringComparison.OrdinalIgnoreCase)))
                        .OrderByDescending(s => s.CodigoSolicitud)
                        .ToList();

                    foreach (var solicitudUsuario in solicitudesUsuario)
                    {
                        string mensajeBloqueoSidebar;
                        if (workflow.PuedeRtAccederModuloSolicitud(solicitudUsuario.CodigoSolicitud, idUsuario, out mensajeBloqueoSidebar))
                        {
                            tieneSolicitudRtHabilitada = true;
                            break;
                        }
                    }
                }
            }
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine("_Sidebar: Error consultando companias RT: " + ex.Message);
        }

        var tieneAccesoSolicitudRt = tieneOrdenGenerada || (esSolicitanteORT && tieneSolicitudRtHabilitada);
    }

    @if (!esAdministrador)
    {
        <!-- Indicador de estado de orden fijo en el sidebar -->
        var mostrarOrdenComoHabilitada = !requiereOrden || tieneAccesoSolicitudRt;
        var claseAlertaOrden = mostrarOrdenComoHabilitada
            ? "alert-success"
            : (tieneOrdenPendienteProceso ? "alert-warning" : (tieneOrdenBorrador ? "alert-warning" : "alert-danger"));
        var claseIconoOrden = mostrarOrdenComoHabilitada
            ? "text-success"
            : (tieneOrdenPendienteProceso ? "text-warning" : (tieneOrdenBorrador ? "text-warning" : "text-danger"));
        <div class="alert aocr-sidebar-alert @claseAlertaOrden mb-3 py-2 small" role="alert">
            <div class="d-flex align-items-center">
                <i class="fas fa-file-invoice-dollar @claseIconoOrden mr-2"></i>
                <div>
                    @if (mostrarOrdenComoHabilitada)
                    {
                        <strong>Pago aprobado ✓</strong>
                        <div class="text-success small">La Solicitud AOCR y la carga documental ya están habilitadas.</div>
                    }
                    else if (tieneOrdenPendienteProceso)
                    {
                        <strong>Orden generada / pago pendiente ⚠</strong>
                        <div class="text-warning small">
                            <a href="@Url.Action("Index", "OrdenRecaudacion")" class="text-warning">
                                @(tieneOrdenPendienteComprobante ? "Cargar comprobante desde Mis Órdenes" : "Revisar estado en Mis Órdenes")
                            </a>
                        </div>
                    }
                    else if (tieneOrdenBorrador)
                    {
                        <strong>Orden pendiente de generación ⚠</strong>
                        <div class="text-warning small">
                            <a href="@Url.Action("Obligatoria", "OrdenRecaudacion")" class="text-warning">Completar y generar orden</a>
                        </div>
                    }
                    else
                    {
                        <strong>Orden requerida</strong>
                        <div class="text-danger small">
                            <a href="@Url.Action("Obligatoria", "OrdenRecaudacion")" class="text-danger">Generar orden primero</a>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="compania-contexto aocr-sidebar-panel mb-3">
            <div class="compania-label">COMPANIA ACTIVA</div>
            <div class="compania-name">
                @if (!string.IsNullOrWhiteSpace(codigoCompaniaActiva))
                {
                    <span>[@codigoCompaniaActiva] </span>
                }
                @(!string.IsNullOrWhiteSpace(nombreCompaniaActiva) ? nombreCompaniaActiva : "No definida")
            </div>

            @if (mostrarSelectorCompaniaRt)
            {
                using (Html.BeginForm("CambiarCompaniaActiva", "Account", System.Web.Mvc.FormMethod.Post, new { @class = "mt-2 mb-0" }))
                {
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@Request.RawUrl" />
                    <div class="input-group input-group-sm">
                        <select name="companiaCodigo" class="form-select form-select-sm" required>
                            @foreach (var compania in companiasRtAsignadas)
                            {
                                var codigo = (compania.CompaniaCodigo ?? string.Empty).Trim();
                                var nombre = (compania.CompaniaNombre ?? string.Empty).Trim();
                                var selected = string.Equals(codigo, codigoCompaniaActiva, StringComparison.OrdinalIgnoreCase)
                                    ? "selected"
                                    : string.Empty;
                                <option value="@codigo" @selected>
                                    [@codigo] @(string.IsNullOrWhiteSpace(nombre) ? codigo : nombre)
                                </option>
                            }
                        </select>
                        <button type="submit" class="btn btn-outline-info">Cambiar</button>
                    </div>
                }
            }
        </div>
    }

    <div class="menu-container aocr-sidebar-sections">
        <div class="section-title aocr-sidebar-title">Navegación por Rol</div>

        @if (!tieneNavegacionRol)
        {
            <div class="aocr-sidebar-panel aocr-sidebar-empty-state">
                <div class="aocr-sidebar-empty-state__icon">
                    <i class="fas fa-circle-info text-info"></i>
                </div>
                <div class="aocr-sidebar-empty-state__title">Sin navegación disponible</div>
                <div class="aocr-sidebar-empty-state__copy">
                    La sesión actual no tiene un rol con accesos cargados para este menú.
                    Cambie de rol o vuelva a iniciar sesión para ver las opciones correspondientes.
                </div>
            </div>
        }

        @* ════════════════════════════════════════
           BLOQUE 1: SOLICITANTE / RT
           Visible: Solicitante, Operador, RT, RepresentanteTecnico
           (son el mismo perfil — menú unificado)
        ════════════════════════════════════════ *@
        @if (puedeSolicitante || puedeRt)
        {
            <div class="nav-group aocr-sidebar-section mb-4">
                <div class="group-title aocr-sidebar-section__title text-primary">
                    <i class="fas fa-user-edit mr-1"></i> Solicitante / RT
                </div>
                <ul class="aocr-nav">
                    @* Orden de recaudación: solo requerida para Solicitante/Operador externo *@
                    @if (requiereOrden)
                    {
                        <li>
                            <a class="aocr-link aocr-sidebar-item @((tieneOrdenBorrador || tieneOrdenPendienteProceso) ? "text-warning fw-bold" : "")" href="@(tieneOrdenPendienteProceso ? Url.Action("Index","OrdenRecaudacion") : (tieneOrdenBorrador ? Url.Action("Obligatoria","OrdenRecaudacion") : Url.Action("Nueva","OrdenRecaudacion")))">
                                <i class="fas fa-file-invoice-dollar @((tieneOrdenBorrador || tieneOrdenPendienteProceso) ? "text-warning" : "text-primary") mr-2"></i>
                                @(tieneOrdenPendienteProceso ? "Continuar Orden Pendiente" : (tieneOrdenBorrador ? "Completar Orden Pendiente" : "Nueva Orden de Recaudación"))
                            </a>
                        </li>
                        <li>
                            <a class="aocr-link aocr-sidebar-item" href="@Url.Action("Index", "OrdenRecaudacion")">
                                <i class="fas fa-history text-white-50 mr-2"></i> Mis Órdenes
                            </a>
                        </li>
                    }
                    @* Solicitudes AOCR: se habilitan solo con pago aprobado / orden habilitante. *@
                    @if (tieneAccesoSolicitudRt)
                    {
                        <li>
                            <a class="aocr-link aocr-sidebar-item" href="@Url.Action("Index", "SolicitudAOCR", new { abrir = "nueva" })">
                                <i class="fas fa-plus text-success mr-2"></i> Nueva Solicitud AOCR
                                <span class="badge badge-success ml-2">Habilitado</span>
                            </a>
                        </li>
                    }
                    else if (esRepresentanteRtRol)
                    {
                        <li>
                            <span class="aocr-link aocr-sidebar-item disabled text-muted"
                                  data-bs-toggle="tooltip"
                                  title="@mensajeBloqueoRtSidebar">
                                <i class="fas fa-lock text-warning mr-2"></i> Nueva Solicitud AOCR
                            </span>
                        </li>
                    }
                    @if (esRepresentanteRtRol && !tieneAccesoSolicitudRt)
                    {
                        <li>
                            <span class="aocr-link aocr-sidebar-item disabled text-muted"
                                  data-bs-toggle="tooltip"
                                  title="@mensajeBloqueoRtSidebar">
                                <i class="fas fa-folder-open text-warning mr-2"></i> Mis Solicitudes
                            </span>
                        </li>
                    }
                    else
                    {
                        <li>
                            <a class="aocr-link aocr-sidebar-item" href="@Url.Action("Index", "SolicitudAOCR")">
                                <i class="fas fa-folder-open text-white-50 mr-2"></i> Mis Solicitudes
                            </a>
                        </li>
                    }
                    <li>
                        <a class="aocr-link aocr-sidebar-item" href="@Url.Action("Registro", "RT")">
                            <i class="fas fa-id-card text-white-50 mr-2"></i> Mi Expediente RT
                        </a>
                    </li>
                    @if (tieneAccesoSolicitudRt)
                    {
                        <li>
                            <a class="aocr-link aocr-sidebar-item" href="@Url.Action("Index", "SolicitudAOCR")">
                                <i class="fas fa-file-upload text-info mr-2"></i> Cargar Documentos
                            </a>
                        </li>
                    }
                    else if (esRepresentanteRtRol)
                    {
                        <li>
                            <span class="aocr-link aocr-sidebar-item disabled text-muted"
                                  data-bs-toggle="tooltip"
                                  title="@mensajeBloqueoRtSidebar">
                                <i class="fas fa-file-upload text-warning mr-2"></i> Cargar Documentos
                            </span>
                        </li>
                    }
                </ul>
            </div>
        }

        @* ════════════════════════════════════════
           BLOQUE 3: INSPECTOR
           Visible: Inspector, Técnico, Evaluador Técnico
        ════════════════════════════════════════ *@
        @if (puedeInspector)
        {
            <div class="nav-group aocr-sidebar-section mb-4">
                <div class="group-title aocr-sidebar-section__title text-info">
                    <i class="fas fa-search mr-1"></i> Inspector
                </div>
                <ul class="aocr-nav">
                    <li>
                        <a class="aocr-link aocr-sidebar-item" href="@Url.Action("Inspector", "Dashboard")">
                            <i class="fas fa-gauge-high text-warning mr-2"></i> Dashboard
                        </a>
                    </li>
                    <li>
                        <a class="aocr-link aocr-sidebar-item" href="@Url.Action("Index", "RevisionDocumental")">
                            <i class="fas fa-file-alt text-success mr-2"></i> Bandeja Documental
                        </a>
                    </li>
                    <li>
                        <a class="aocr-link aocr-sidebar-item" href="@Url.Action("Index", "Inspeccion")">
                            <i class="fas fa-clipboard-list text-white-50 mr-2"></i> Mis Inspecciones Asignadas
                        </a>
                    </li>
                </ul>
            </div>
        }

        @* ════════════════════════════════════════
           BLOQUE 4: COORDINADOR
           Visible: Coordinador, CoordinadorInspecciones
           Alcance: Control operativo (sin firma DIRDAC ni legalización)
        ════════════════════════════════════════ *@
        @if (puedeCoordinadorOperativo)
        {
            <div class="nav-group aocr-sidebar-section mb-4">
                <div class="group-title aocr-sidebar-section__title" style="color:#a78bfa;">
                    <i class="fas fa-sitemap mr-1"></i> Coordinador
                </div>
                <ul class="aocr-nav">
                    <li><a class="aocr-link aocr-sidebar-item" href="@Url.Action("DashboardInspeccion", "CoordinacionJefatura")"><i class="fas fa-table-columns text-white-50 mr-2"></i> Dashboard Inspección</a></li>
                    <li><a class="aocr-link aocr-sidebar-item" href="@Url.Action("RevisionVerificacion", "CoordinacionJefatura")"><i class="fas fa-search text-white-50 mr-2"></i> Bandeja Documental</a></li>
                    <li><a class="aocr-link aocr-sidebar-item" href="@Url.Action("Index", "Tecnico")"><i class="fas fa-user-plus text-white-50 mr-2"></i> Asignación de Inspectores</a></li>
                    <li><a class="aocr-link aocr-sidebar-item" href="@Url.Action("Index", "Inspeccion")"><i class="fas fa-clipboard-check text-white-50 mr-2"></i> Gestión / Seguimiento de Inspección</a></li>
                </ul>
            </div>
        }

        @* ════════════════════════════════════════
           BLOQUE 5: FINANCIERO
           Visible: Financiero, CoordinadorFinanciero
        ════════════════════════════════════════ *@
        @if (puedeFinanciero)
        {
            <div class="nav-group aocr-sidebar-section mb-4">
                <div class="group-title aocr-sidebar-section__title text-success">
                    <i class="fas fa-money-bill-wave mr-1"></i> Financiero
                </div>
                <ul class="aocr-nav">
                    <li><a class="aocr-link aocr-sidebar-item" href="@Url.Action("Dashboard", "Financiero")"><i class="fas fa-chart-line text-white-50 mr-2"></i> Dashboard Financiero</a></li>
