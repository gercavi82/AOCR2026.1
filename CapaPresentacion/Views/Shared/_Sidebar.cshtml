@using CapaDatos.DAOs
@* ~/Views/Shared/_Sidebar.cshtml *@
<div class="sidebar bg-dark text-white p-3" style="min-height:100vh; width:250px;">
    <div class="text-center mb-3 border-bottom pb-3">
        <img src="@Url.Content("~/Content/imganes/logodgac.jpg")"
             alt="DGAC Logo"
             class="img-fluid shadow-sm"
             style="max-height:70px; border-radius: 8px;" />

        <div class="mt-3">
            <span class="d-block font-weight-bold text-info" style="font-size: 0.85rem;">USUARIO ACTIVO</span>
            <div class="text-light small">@Session["Correo"]</div>
            @Html.Partial("_SeleccionarRol")
        </div>
    </div>

    @{
        var rolActual = Session["Rol"] != null ? Session["Rol"].ToString() : "";
        int idUsuario = Session["IdUsuario"] != null ? Convert.ToInt32(Session["IdUsuario"]) : 0;

        // Instancia del DAO para validar estados financieros
        var daoOR = new OrdenRecaudacionDAO();
        bool tienePagoValido = daoOR.ExisteORGeneradaOPagada(idUsuario);
    }

    <div class="menu-container">
        <h6 class="text-uppercase text-muted font-weight-bold mb-3" style="font-size: 0.7rem; letter-spacing: 1px;">
            Menú de Gestión
        </h6>

        @* ===================== SOLICITANTE ===================== *@
        @if (rolActual == "Operador" || rolActual == "Administrador" || rolActual == "Solicitante")
        {
            <div class="nav-group mb-4">
                <div class="text-warning small font-weight-bold mb-2">
                    <i class="fas fa-user-edit mr-1"></i> SOLICITANTE
                </div>
                <ul class="list-unstyled ml-2">
                    @* Opción de pago siempre visible si no tiene pago *@
                    <li class="mb-2">
                        <i class="fas fa-money-bill-wave text-success mr-2"></i>
                        <a href="@Url.Action("Nueva", "OrdenRecaudacion")" class="text-light text-decoration-none hover-link">
                            Generar Orden Recaudación
                        </a>
                    </li>

                    @* Opciones técnicas bloqueadas hasta que exista una orden técnica *@
                    <li class="mb-2 @(tienePagoValido ? "" : "opacity-50 pointer-events-none")">
                        <i class="fas fa-angle-right @(tienePagoValido ? "text-white-50" : "text-danger") mr-2"></i>
                        @if (tienePagoValido)
                        {
                            <a href="javascript:void(0);" onclick="window.cargarFormulario(0)" class="text-light text-decoration-none hover-link">Crear Solicitud</a>
                        }
                        else
                        {
                            <span class="text-muted small" title="Requiere Orden de Recaudación">Crear Solicitud <i class="fas fa-lock ml-1"></i></span>
                        }
                    </li>
                    <li class="mb-2">
                        <i class="fas fa-folder-open text-white-50 mr-2"></i>
                        <a href="@Url.Action("Index", "SolicitudAOCR")" class="text-light text-decoration-none hover-link">Mis Solicitudes</a>
                    </li>
                </ul>
            </div>
        }

        @* ===================== INSPECCIÓN / TÉCNICA ===================== *@
        @if (rolActual == "Inspector" || rolActual == "Administrador" || rolActual == "Tecnico")
        {
            <div class="nav-group mb-4">
                <div class="text-info small font-weight-bold mb-2">
                    <i class="fas fa-search mr-1"></i> GESTIÓN TÉCNICA
                </div>
                <ul class="list-unstyled ml-2">
                    <li class="mb-2">
                        <i class="fas fa-tasks text-white-50 mr-2"></i>
                        <a href="@Url.Action("RevisarSolicitudes", "SolicitudAOCR")" class="text-light text-decoration-none hover-link">Revisar Solicitudes</a>
                    </li>
                    <li class="mb-2">
                        <i class="fas fa-user-check text-white-50 mr-2"></i>
                        <a href="@Url.Action("AsignarInspector", "Tecnico")" class="text-light text-decoration-none hover-link">Asignar Inspector</a>
                    </li>
                </ul>
            </div>
        }

        @* Resto de roles (Legal, Dirección, Financiero) se mantienen igual *@
        @* ... *@
    </div>

    <hr class="bg-secondary opacity-25" />

    <div class="mt-auto">
        <ul class="list-unstyled">
            <li class="mb-2">
                <i class="fas fa-home text-info mr-2"></i>
                <a href="@Url.Action("Index", "Home")" class="text-light text-decoration-none hover-link">Dashboard Inicio</a>
            </li>
            <li>
                <i class="fas fa-sign-out-alt text-danger mr-2"></i>
                <a href="@Url.Action("Logout", "Account")" class="text-danger font-weight-bold text-decoration-none">Cerrar Sesión</a>
            </li>
        </ul>
    </div>
</div>

<style>
    .opacity-50 {
        opacity: 0.5;
    }

    .pointer-events-none {
        pointer-events: none;
        cursor: not-allowed;
    }

    .hover-link {
        transition: all 0.2s;
        display: inline-block;
    }

        .hover-link:hover {
            color: #17a2b8 !important;
            padding-left: 5px;
            text-decoration: none;
        }

    .sidebar {
        box-shadow: 4px 0 10px rgba(0,0,0,0.1);
        display: flex;
        flex-direction: column;
        z-index: 1000;
    }
</style>