@model CapaPresentacion.Models.BandejaEjecutivaAprobacionViewModel
@using System.Collections.Generic
@using System.Linq
@using System.Web
@using System.Web.Mvc
@using System.Web.Mvc.Html
@using CapaModelo
@using CapaDatos.Constants
@{
    Layout = "~/Views/Shared/_LayoutAOCR.cshtml";
    ViewBag.Title = "Aprobación de Solicitudes AOCR";

    var vm = Model ?? new CapaPresentacion.Models.BandejaEjecutivaAprobacionViewModel();
    var solicitudes = (vm.SolicitudesFiltradas != null) ? vm.SolicitudesFiltradas : new List<SolicitudAOCR>();
    var totalPendientes = vm.Total;
    var totalObservadas = vm.TotalObservadas;
    var totalRevision = vm.TotalEnRevision;
    var totalSubsanadas = vm.TotalSubsanadas;
    var filtroActivo = string.IsNullOrWhiteSpace(vm.FiltroActivo) ? "todas" : vm.FiltroActivo;

    Func<string, bool> esFiltroActivo = clave => string.Equals(filtroActivo, clave, StringComparison.OrdinalIgnoreCase);

    var pageHeaderData = new ViewDataDictionary
    {
        { "Kicker", "Dirección / Jefatura" },
        { "Title", "Aprobación de Solicitudes AOCR" },
        { "Subtitle", "Decisión ejecutiva institucional sobre solicitudes en validación, observación o cierre formal" },
        { "Breadcrumbs", new[]
            {
                new { Text = "Dirección / Jefatura", Url = string.Empty },
                new { Text = "Aprobación de Solicitudes AOCR", Url = string.Empty }
            }
        }
    };

    // Hero: métrica dinámica según la categoría dominante de la bandeja
    string heroMetricTitle;
    string heroMetricSubtitle;
    int heroMetricValue;
    if (totalRevision > 0)
    {
        heroMetricTitle    = "En revisión";
        heroMetricValue    = totalRevision;
        heroMetricSubtitle = "Solicitudes en proceso de revisión";
    }
    else if (totalObservadas > 0)
    {
        heroMetricTitle    = "Observadas";
        heroMetricValue    = totalObservadas;
        heroMetricSubtitle = "Solicitudes que requieren atención";
    }
    else if (totalSubsanadas > 0)
    {
        heroMetricTitle    = "Subsanadas";
        heroMetricValue    = totalSubsanadas;
        heroMetricSubtitle = "Listas para decisión final";
    }
    else
    {
        heroMetricTitle    = "Total en bandeja";
        heroMetricValue    = totalPendientes;
        heroMetricSubtitle = "Solicitudes en este flujo";
    }

    var heroData = new ViewDataDictionary
    {
        { "Kicker", "Certificado del Reconocimiento de Operadores Aéreo Extranjero " },
        { "Title", "Bandeja ejecutiva de aprobación" },
        { "Subtitle", "Gobierno de decisiones del flujo AOCR" },
        { "Description", "Revise la información crítica de cada solicitud y escale acciones de jefatura o coordinación legal bajo una misma línea visual institucional." },
        { "MetricTitle", heroMetricTitle },
        { "MetricValue", heroMetricValue },
        { "MetricSubtitle", heroMetricSubtitle }
    };

    var toolbarLinks = new List<string>
    {
        "<a href=\"" + Url.Action("RevisarPorJefatura", "SolicitudAOCR") + "\" class=\"btn btn-aocr-secondary\"><i class=\"fas fa-user-shield\"></i><span>Jefatura técnica</span></a>",
        "<a href=\"" + Url.Action("RevisarLegalizacion", "SolicitudAOCR") + "\" class=\"btn btn-aocr-secondary\"><i class=\"fas fa-scale-balanced\"></i><span>Revisión legal</span></a>"
    };

    var toolbarData = new ViewDataDictionary
    {
        { "VolverUrl", Url.Action("Index", "Dashboard") },
        { "VolverTexto", "Volver al dashboard" },
        { "CustomActionsHtml", new HtmlString(string.Join("", toolbarLinks)) }
    };
}

<div class="aocr-view">
    @Html.Partial("_PageHeader", null, pageHeaderData)
    @Html.Partial("_HeroPanel", null, heroData)

    <div class="row g-3 mb-4">
        <div class="col-12 col-md-6 col-xl-3">
            @Html.Partial("_MetricCard", null, new ViewDataDictionary { { "Label", "Total en bandeja" }, { "Value", totalPendientes }, { "Modifier", "warning" }, { "Icon", "fas fa-hourglass-half" }, { "Caption", "Bandeja total de dirección" } })
        </div>
        <div class="col-12 col-md-6 col-xl-3">
            @Html.Partial("_MetricCard", null, new ViewDataDictionary { { "Label", "En revisión" }, { "Value", totalRevision }, { "Modifier", "info" }, { "Icon", "fas fa-magnifying-glass" }, { "Caption", "Solicitudes con validación activa" } })
        </div>
        <div class="col-12 col-md-6 col-xl-3">
            @Html.Partial("_MetricCard", null, new ViewDataDictionary { { "Label", "Observadas" }, { "Value", totalObservadas }, { "Modifier", "danger" }, { "Icon", "fas fa-triangle-exclamation" }, { "Caption", "Requieren revisión adicional" } })
        </div>
        <div class="col-12 col-md-6 col-xl-3">
            @Html.Partial("_MetricCard", null, new ViewDataDictionary { { "Label", "Subsanadas" }, { "Value", totalSubsanadas }, { "Modifier", "success" }, { "Icon", "fas fa-file-pen" }, { "Caption", "Listas para decisión final" } })
        </div>
    </div>

    @Html.Partial("_ActionToolbar", null, toolbarData)

    @if (TempData["success"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm mb-3">
            <i class="fas fa-circle-check"></i> @TempData["success"]
        </div>
    }
    @if (TempData["error"] != null)
    {
        <div class="alert alert-danger border-0 shadow-sm mb-3">
            <i class="fas fa-circle-exclamation"></i> @TempData["error"]
        </div>
    }

    <div class="card aocr-content-card">
        <div class="card-body">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
                <div>
                    <h3 class="aocr-section-title mb-1"><i class="fas fa-clipboard-check"></i> Bandeja de aprobación</h3>
                    <p class="text-muted mb-0">Vista ejecutiva consolidada para revisar contexto, estado y acciones disponibles por solicitud.</p>
                </div>
                @Html.Partial("_StatusBadge", null, new ViewDataDictionary { { "Estado", vm.Total > 0 ? "En bandeja" : "Completado" } })
            </div>

            <div class="d-flex flex-wrap gap-2 mb-4">
                <a href="@Url.Action("AprobarSolicitudes", "Direccion", new { filtro = "todas" })" class="btn @(esFiltroActivo("todas") ? "btn-aocr-primary" : "btn-aocr-secondary")">Todas (@vm.Total)</a>
                <a href="@Url.Action("AprobarSolicitudes", "Direccion", new { filtro = "enrevision" })" class="btn @(esFiltroActivo("enrevision") ? "btn-aocr-primary" : "btn-aocr-secondary")">En revisión (@vm.TotalEnRevision)</a>
                <a href="@Url.Action("AprobarSolicitudes", "Direccion", new { filtro = "observadas" })" class="btn @(esFiltroActivo("observadas") ? "btn-aocr-primary" : "btn-aocr-secondary")">Observadas (@vm.TotalObservadas)</a>
                <a href="@Url.Action("AprobarSolicitudes", "Direccion", new { filtro = "subsanadas" })" class="btn @(esFiltroActivo("subsanadas") ? "btn-aocr-primary" : "btn-aocr-secondary")">Subsanadas (@vm.TotalSubsanadas)</a>
                <a href="@Url.Action("AprobarSolicitudes", "Direccion", new { filtro = "jefatura" })" class="btn @(esFiltroActivo("jefatura") ? "btn-aocr-primary" : "btn-aocr-secondary")">Jefatura técnica (@vm.TotalJefatura)</a>
                <a href="@Url.Action("AprobarSolicitudes", "Direccion", new { filtro = "legal" })" class="btn @(esFiltroActivo("legal") ? "btn-aocr-primary" : "btn-aocr-secondary")">Revisión legal (@vm.TotalLegal)</a>
            </div>

            @if (vm.TieneDatosFiltrados)
            {
                <p class="text-muted small mb-3 ms-1">Mostrando <strong>@vm.TotalFiltradas</strong> solicitud(es) &mdash; filtro activo: <strong>@vm.FiltroActivoEtiqueta</strong></p>
            }

            @if (vm.Total == 0 && (vm.Solicitudes == null || vm.Solicitudes.Count == 0))
            {
                @Html.Partial("_EmptyState", null, new ViewDataDictionary {
                    { "Icon", "fas fa-clipboard-check" },
                    { "Title", "No hay solicitudes en la bandeja ejecutiva" },
                    { "Description", "Cuando existan solicitudes en estados AOCR en elaboración, AOCR en revisión, AOCR validado, observada o subsanada, aparecerán aquí para decisión de dirección o jefatura." }
                })
            }
            else if (solicitudes.Count == 0)
            {
                var _urlTodas       = Url.Action("AprobarSolicitudes", "Direccion", new { filtro = "todas" });
                var _urlEnRevision  = Url.Action("AprobarSolicitudes", "Direccion", new { filtro = "enrevision" });
                var _urlObservadas  = Url.Action("AprobarSolicitudes", "Direccion", new { filtro = "observadas" });
                var _urlSubsanadas  = Url.Action("AprobarSolicitudes", "Direccion", new { filtro = "subsanadas" });
                <div class="alert alert-info border-0 shadow-sm mb-0" role="alert">
                    <div class="d-flex align-items-start gap-3">
                        <i class="fas fa-filter-circle-xmark fs-4 mt-1"></i>
                        <div>
                            <strong>No hay solicitudes en "@vm.FiltroActivoEtiqueta"</strong>
                            <p class="mb-1 mt-1">Existen <strong>@vm.Total</strong> solicitud(es) en la bandeja, pero ninguna corresponde a este filtro.</p>
                            <p class="mb-0">
                                <a href="@_urlTodas" class="alert-link fw-semibold">Ver todas (@vm.Total)</a>
                                @if (vm.TotalEnRevision > 0)
                                {
                                    <text> &middot; <a href="@_urlEnRevision" class="alert-link">Ver @vm.TotalEnRevision en revisión</a></text>
                                }
                                @if (vm.TotalObservadas > 0)
                                {
                                    <text> &middot; <a href="@_urlObservadas" class="alert-link">Ver @vm.TotalObservadas observada(s)</a></text>
                                }
                                @if (vm.TotalSubsanadas > 0)
                                {
                                    <text> &middot; <a href="@_urlSubsanadas" class="alert-link">Ver @vm.TotalSubsanadas subsanada(s)</a></text>
                                }
                            </p>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="row g-4">
                    @foreach (var solicitud in solicitudes)
                    {
                        var numeroSolicitud = !string.IsNullOrWhiteSpace(solicitud.NumeroSolicitud) ? solicitud.NumeroSolicitud : solicitud.CodigoSolicitud.ToString();
                        var nombreOperador = !string.IsNullOrWhiteSpace(solicitud.NombreOperador) ? solicitud.NombreOperador : "No especificado";
                        var codigoOaci = !string.IsNullOrWhiteSpace(solicitud.CodigoOaci) ? solicitud.CodigoOaci : "No registrado";
                        var representante = !string.IsNullOrWhiteSpace(solicitud.RepresentanteLegal) ? solicitud.RepresentanteLegal : "No registrado";
                        var fechaSolicitud = solicitud.FechaSolicitud.HasValue ? solicitud.FechaSolicitud.Value.ToString("dd/MM/yyyy") : "No registrada";
                        var correo = !string.IsNullOrWhiteSpace(solicitud.Email) ? solicitud.Email : "Sin correo";

                        <div class="col-12 col-xl-6 d-flex">
                            <article class="aocr-solicitud-card w-100 d-flex flex-column">
                                <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
                                    <div>
                                        <span class="aocr-solicitud-kicker">Solicitud AOCR</span>
                                        <h4 class="mb-1 text-primary fw-bold">@numeroSolicitud</h4>
                                        <p class="text-muted mb-0">@nombreOperador</p>
                                    </div>
                                    @Html.Partial("_StatusBadge", null, new ViewDataDictionary { { "Estado", solicitud.Estado } })
                                </div>

                                <div class="aocr-detail-grid mb-3">
                                    <div>
                                        <span class="aocr-detail-grid__label">Código OACI</span>
                                        <strong>@codigoOaci</strong>
                                    </div>
                                    <div>
                                        <span class="aocr-detail-grid__label">Representante técnico</span>
                                        <strong>@representante</strong>
                                    </div>
                                    <div>
                                        <span class="aocr-detail-grid__label">Fecha de solicitud</span>
                                        <strong>@fechaSolicitud</strong>
                                    </div>
                                    <div>
                                        <span class="aocr-detail-grid__label">Correo</span>
                                        <strong>@correo</strong>
                                    </div>
                                </div>

                                <div class="mt-auto d-flex flex-wrap gap-2">
                                    <a href="@Url.Action("Detalle", "SolicitudAOCR", new { id = solicitud.CodigoSolicitud })" class="btn btn-aocr-primary">
                                        <i class="fas fa-eye"></i><span>Revisar solicitud</span>
                                    </a>

                                    @if (User.IsInRole("JefaturaTecnica") || User.IsInRole("Administrador"))
                                    {
                                        <a href="@Url.Action("RevisarPorJefatura", "SolicitudAOCR")" class="btn btn-aocr-secondary">
                                            <i class="fas fa-user-shield"></i><span>Validar jefatura</span>
                                        </a>
                                    }

                                    @if (User.IsInRole("CoordinacionLegal") || User.IsInRole("Administrador") || User.IsInRole("DirectorGeneral"))
                                    {
                                        <a href="@Url.Action("RevisarLegalizacion", "SolicitudAOCR")" class="btn btn-aocr-secondary">
                                            <i class="fas fa-scale-balanced"></i><span>Revisión legal</span>
                                        </a>
                                    }
                                </div>
                            </article>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

