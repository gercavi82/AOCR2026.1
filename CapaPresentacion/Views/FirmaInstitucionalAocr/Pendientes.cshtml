@model IEnumerable<CapaDatos.Models.FirmaInstitucionalAocrFilaDto>
@using System.Linq
@{Layout="~/Views/Shared/_LayoutAOCR.cshtml";ViewBag.Title="Firmas institucionales";var esDgac=ViewBag.EsDgac==true;var esDcav=ViewBag.EsDcav==true;var items=(Model??Enumerable.Empty<CapaDatos.Models.FirmaInstitucionalAocrFilaDto>()).Where(x=>(esDgac&&(x.EstadoAocr=="APROBADO_DCAV"||x.EstadoAocr=="PENDIENTE_FIRMA_DGAC"))||(esDcav&&(x.EstadoCondiciones=="APROBADO_DCAV"||x.EstadoCondiciones=="PENDIENTE_FIRMA_DCAV"))).ToList();}
<div class="container-fluid mt-4"><div class="card border-0 shadow-sm mb-3"><div class="card-body"><span class="badge bg-primary">@(esDgac?"DGAC · AOCR":"DCAV · Condiciones y Limitaciones")</span><h2 class="mt-2">FIRMAS INSTITUCIONALES</h2><p class="text-muted mb-0">Cada bandeja permite firmar únicamente el documento correspondiente al rol institucional.</p></div></div><div class="card border-0 shadow-sm"><div class="card-header"><strong>Pendientes (@items.Count)</strong></div><div class="table-responsive"><table class="table table-hover mb-0"><thead><tr><th>Solicitud</th><th>Explotador / trámite</th><th>Inspector</th><th>AOCR</th><th>Condiciones</th><th>Fecha</th><th></th></tr></thead><tbody>@if(!items.Any()){<tr><td colspan="7" class="text-center text-muted py-4">No existen documentos pendientes para este rol.</td></tr>}@foreach(var x in items){<tr><td><strong>@x.NumeroSolicitud</strong><br/><small>#@x.SolicitudId / inspección @x.InspeccionId</small></td><td>@x.Explotador<br/><small>@x.TipoTramite</small></td><td>@x.Inspector</td><td><span class="badge @(x.EstadoAocr=="FIRMADO_DGAC"?"bg-success":"bg-warning text-dark")">@x.EstadoAocr</span></td><td><span class="badge @(x.EstadoCondiciones=="FIRMADO_DCAV"?"bg-success":"bg-warning text-dark")">@x.EstadoCondiciones</span></td><td>@x.FechaAprobacion.ToString("dd/MM/yyyy HH:mm")</td><td><a class="btn btn-sm btn-outline-primary" href="@Url.Action("Detalle",new{solicitudId=x.SolicitudId,inspeccionId=x.InspeccionId})">Gestionar</a></td></tr>}</tbody></table></div></div></div>
