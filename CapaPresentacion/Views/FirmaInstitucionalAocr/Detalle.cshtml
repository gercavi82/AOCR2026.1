@model CapaDatos.Models.FirmaInstitucionalAocrDetalleDto
@{Layout="~/Views/Shared/_LayoutAOCR.cshtml";ViewBag.Title="Firma institucional diferenciada";var esDgac=ViewBag.EsDgac==true;var esDcav=ViewBag.EsDcav==true;var aocrPendiente=Model.EstadoAocr=="APROBADO_DCAV"||Model.EstadoAocr=="PENDIENTE_FIRMA_DGAC";var condicionesPendientes=Model.EstadoCondiciones=="APROBADO_DCAV"||Model.EstadoCondiciones=="PENDIENTE_FIRMA_DCAV";}
<div class="container-fluid mt-4">
  <div class="card border-0 shadow-sm mb-3"><div class="card-body d-flex justify-content-between"><div><span class="badge bg-primary">@Model.Estado</span><h2 class="mt-2">@Model.NumeroSolicitud</h2><p class="mb-0">@Model.Explotador · @Model.TipoTramite</p><p class="text-muted mb-0">Inspector: @Model.Inspector · Aprobó DCAV: @Model.UsuarioDcav · @Model.FechaAprobacion.ToString("dd/MM/yyyy HH:mm")</p></div><a class="btn btn-outline-secondary align-self-start" href="@Url.Action("Pendientes")">Volver</a></div></div>
  <div id="firma-message" class="alert d-none" role="alert"></div>
  <div class="row g-3 mb-3">
    <div class="col-lg-6"><div class="card h-100"><div class="card-body"><h4>AOCR</h4><p>ID #@Model.AocrId · versión @Model.VersionAocr · <strong>@Model.EstadoAocr</strong></p><a class="btn btn-outline-primary" target="_blank" href="@Url.Action("Descargar","DocumentoPdf",new{id=Model.AocrPdfId})">Visualizar PDF aprobado</a>@if(Model.EstadoAocr=="FIRMADO_DGAC"){<a class="btn btn-outline-success ms-2" target="_blank" href="@Url.Action("DescargarFirmado",new{solicitudId=Model.SolicitudId,inspeccionId=Model.InspeccionId,tipoDocumento="AOCR"})">Descargar firmado DGAC</a>}@if(esDgac&&aocrPendiente){using(Html.BeginForm("FirmarAocr","FirmaInstitucionalAocr",FormMethod.Post,new{@class="js-firma-form d-inline"})){@Html.AntiForgeryToken()<input type="hidden" name="solicitudId" value="@Model.SolicitudId"/><input type="hidden" name="inspeccionId" value="@Model.InspeccionId"/><input type="hidden" name="versionExpediente" value="@Model.VersionExpediente"/><button type="submit" class="btn btn-primary ms-2">Firmar AOCR como DGAC</button>}}</div></div></div>
    <div class="col-lg-6"><div class="card h-100"><div class="card-body"><h4>Condiciones y Limitaciones</h4><p>ID #@Model.CondicionesId · versión @Model.VersionCondiciones · <strong>@Model.EstadoCondiciones</strong></p><a class="btn btn-outline-primary" target="_blank" href="@Url.Action("Descargar","DocumentoPdf",new{id=Model.CondicionesPdfId})">Visualizar PDF aprobado</a>@if(Model.EstadoCondiciones=="FIRMADO_DCAV"){<a class="btn btn-outline-success ms-2" target="_blank" href="@Url.Action("DescargarFirmado",new{solicitudId=Model.SolicitudId,inspeccionId=Model.InspeccionId,tipoDocumento="CONDICIONES"})">Descargar firmado DCAV</a>}@if(esDcav&&condicionesPendientes){using(Html.BeginForm("FirmarCondiciones","FirmaInstitucionalAocr",FormMethod.Post,new{@class="js-firma-form d-inline"})){@Html.AntiForgeryToken()<input type="hidden" name="solicitudId" value="@Model.SolicitudId"/><input type="hidden" name="inspeccionId" value="@Model.InspeccionId"/><input type="hidden" name="versionExpediente" value="@Model.VersionExpediente"/><button type="submit" class="btn btn-primary ms-2">Firmar Condiciones como DCAV</button>}}</div></div></div>
  </div>
  <div class="card mb-3"><div class="card-header"><strong>Documentos de soporte</strong></div><div class="card-body"><a class="btn btn-outline-primary me-2" target="_blank" href="@Url.Action("VerInforme",new{solicitudId=Model.SolicitudId,inspeccionId=Model.InspeccionId})">Informe Técnico</a><a class="btn btn-outline-primary" target="_blank" href="@Url.Action("VerLvEae",new{solicitudId=Model.SolicitudId,inspeccionId=Model.InspeccionId})">LV/EAE firmada</a></div></div>
  <div class="card"><div class="card-header"><strong>Historial</strong></div><div class="table-responsive"><table class="table table-sm mb-0"><thead><tr><th>Acción</th><th>Usuario</th><th>Estado anterior</th><th>Estado nuevo</th><th>Fecha</th></tr></thead><tbody>@foreach(var h in Model.Historial){<tr><td>@h.Accion</td><td>@h.UsuarioNombre<br/><small>@h.Rol</small></td><td>@h.EstadoAnterior</td><td>@h.EstadoNuevo</td><td>@h.Fecha.ToString("dd/MM/yyyy HH:mm")</td></tr>}</tbody></table></div></div>
</div>
@section scripts{<script>$(function(){$('.js-firma-form').on('submit',function(e){e.preventDefault();var f=$(this),b=f.find('button'),m=$('#firma-message');if(b.prop('disabled'))return;b.prop('disabled',true);$.ajax({url:f.attr('action'),method:'POST',data:f.serialize()}).done(function(r){m.removeClass('d-none alert-danger').addClass('alert-success').text(r.message||'Firma registrada.');window.setTimeout(function(){window.location.reload();},700);}).fail(function(x){var r=x.responseJSON||{};m.removeClass('d-none alert-success').addClass('alert-danger').text(r.message||'No fue posible firmar el documento.');b.prop('disabled',false);});});});</script>}
