@inherits System.Web.Mvc.WebViewPage<System.Collections.Generic.IEnumerable<CapaModelo.SolicitudAOCR>>
@using CapaModelo
@using System.Linq
@using System.Web.Mvc
@using System.Web.Mvc.Html

@{
   Layout = "~/Views/Shared/_LayoutAOCR.cshtml";
}

<div class="container-fluid aocr-shell">
    @Html.Partial("_HeroPanel", null, new ViewDataDictionary {
        { "IconClass", "fas fa-user-check" },
        { "Overline", "Módulo Técnico" },
        { "Title", "Asignación de Inspectores" },
        { "Subtitle", "Solicitudes pendientes de asignación" },
        { "Description", "Asigne el inspector responsable para continuar con la etapa de inspección." },
        { "MetricLabel", "Pendientes" },
        { "MetricValue", Model != null ? Model.Count() : 0 }
    })

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="glyphicon glyphicon-ok-circle"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="glyphicon glyphicon-exclamation-sign"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Info"] != null)
{
    <div class="alert alert-info alert-dismissible fade show" role="alert">
        <i class="glyphicon glyphicon-info-sign"></i> @TempData["Info"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card aocr-table-card">
    <div class="card-body p-0">
        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th style="width:110px;">Código</th>
                            <th>N° Solicitud</th>
                            <th>Operador</th>
                            <th>Fecha Solicitud</th>
                            <th>Estado</th>
                            <th style="width:140px;" class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model)
                        {
                            <tr>
                                <td>@Html.Encode(s.CodigoSolicitud)</td>
                                <td>@Html.Encode(s.NumeroSolicitud)</td>
                                <td>@Html.Encode(s.NombreOperador)</td>
                                <td>@Html.Encode(s.FechaSolicitud.HasValue ? s.FechaSolicitud.Value.ToString("dd/MM/yyyy") : "-")</td>
                                <td>
                                    @Html.Partial("_StatusBadge", null, new ViewDataDictionary { { "Status", s.Estado } })
                                </td>
                                <td class="text-center">
                                    <a href="@Url.Action("AsignarInspector", "Tecnico", new { solicitudId = s.CodigoSolicitud })" 
                                       class="btn btn-sm btn-primary" title="Asignar Inspector">
                                        <i class="glyphicon glyphicon-user"></i> Asignar
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="p-3">
                @Html.Partial("_EmptyState", null, new ViewDataDictionary {
                    { "IconClass", "fas fa-user-clock" },
                    { "Title", "No hay solicitudes pendientes de asignación." },
                    { "Description", "Cuando una solicitud requiera inspector, se mostrará en este listado." }
                })
            </div>
        }
    </div>
</div>
</div>





