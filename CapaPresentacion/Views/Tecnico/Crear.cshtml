@inherits System.Web.Mvc.WebViewPage<CapaModelo.Inspeccion>
@using CapaModelo
@using System.Web.Mvc
@using System.Web.Mvc.Html
<h2>Programar Inspección</h2>

@using (Html.BeginForm())
{
    @Html.HiddenFor(m => m.CodigoSolicitud)

    <div class="form-group">
        @Html.LabelFor(m => m.CodigoInspector)
        @Html.TextBoxFor(m => m.CodigoInspector, new { @class = "form-control" })
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.FechaProgramada)
        @Html.TextBoxFor(m => m.FechaProgramada, new { @class = "form-control", type = "date" })
    </div>

    <button class="btn btn-success">Programar</button>
}


