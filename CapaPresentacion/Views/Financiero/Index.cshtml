@inherits System.Web.Mvc.WebViewPage<List<CapaPresentacion.Models.OrdenValidacionFinancieraVM>>
@using CapaDatos.Constants
@using CapaModelo
@using CapaNegocio.Services
@using System.Linq
@using System.Web.Mvc
@using System.Web.Mvc.Html

@{
    ViewBag.Title = "Dashboard Financiero";
    var as400FacturacionHabilitada = FacturacionAS400Service.IsEnabled();
    var registros = Model ?? new List<CapaPresentacion.Models.OrdenValidacionFinancieraVM>();

    Func<string, string> normalizarEstado = estado =>
    {
        var actual = EstadoOrden.NormalizarEstado(estado);
        return actual == EstadoOrden.Pendiente || actual == EstadoOrden.Generada
            ? EstadoOrden.Generada
            : actual;
    };

    Func<string, string> textoEstado = estado =>
    {
        switch (normalizarEstado(estado))
        {
            case EstadoOrden.Generada:
                return "GENERADA";
            case EstadoOrden.Enviada:
                return "ENVIADA";
            case EstadoOrden.EnRevisionFinanciera:
                return "EN REVISION FINANCIERA";
            case EstadoOrden.Devuelta:
                return "DEVUELTA";
            case EstadoOrden.Facturada:
                return "FACTURADA";
            case EstadoOrden.Completada:
                return "COMPLETADA";
            case EstadoOrden.Pagada:
                return "PAGADA";
            case EstadoOrden.Anulada:
                return "ANULADA";
            case EstadoOrden.Borrador:
                return "BORRADOR";
            default:
                return normalizarEstado(estado);
        }
    };

    var totalOrdenes = registros.Count;
    var montoTotal = registros.Sum(x => x != null && x.Orden != null ? x.Orden.Total : 0m);
    var generadas = registros.Count(x =>
    {
        var estado = x != null && x.Orden != null ? normalizarEstado(x.Orden.Estado) : string.Empty;
        return estado == EstadoOrden.Generada;
    });
    var enRevision = registros.Count(x =>
    {
        var estado = x != null && x.Orden != null ? normalizarEstado(x.Orden.Estado) : string.Empty;
        return estado == EstadoOrden.EnRevisionFinanciera;
    });
    var devueltas = registros.Count(x =>
    {
        var estado = x != null && x.Orden != null ? normalizarEstado(x.Orden.Estado) : string.Empty;
        return estado == EstadoOrden.Devuelta;
    });
    var facturadas = registros.Count(x =>
    {
        var estado = x != null && x.Orden != null ? normalizarEstado(x.Orden.Estado) : string.Empty;
        return estado == EstadoOrden.Facturada;
    });
    var completadas = registros.Count(x =>
    {
        var estado = x != null && x.Orden != null ? normalizarEstado(x.Orden.Estado) : string.Empty;
        return estado == EstadoOrden.Completada;
    });
    var anuladas = registros.Count(x =>
    {
        var estado = x != null && x.Orden != null ? normalizarEstado(x.Orden.Estado) : string.Empty;
        return estado == EstadoOrden.Anulada;
    });

    var fr3Ok = registros.Count(x => !string.IsNullOrWhiteSpace(x != null ? x.Fr3Numero : null));
    var fr3Error = registros.Count(x => string.Equals(x != null ? x.Fr3Estado : null, "FR3_ERROR", StringComparison.OrdinalIgnoreCase));
    var fr3Pendiente = totalOrdenes - fr3Ok - fr3Error;
    if (fr3Pendiente < 0)
    {
        fr3Pendiente = 0;
    }

    var porcentajeFr3Ok = totalOrdenes > 0 ? Math.Round((decimal)fr3Ok * 100m / totalOrdenes, 0) : 0m;
    var porcentajeCompletadas = totalOrdenes > 0 ? Math.Round((decimal)completadas * 100m / totalOrdenes, 0) : 0m;

    var companias = registros
        .Where(x => x != null && x.Orden != null)
        .GroupBy(x => !string.IsNullOrWhiteSpace(x.Orden.NombreContribuyente) ? x.Orden.NombreContribuyente : (x.Orden.Compania ?? "Sin compañía"))
        .Select(g => new
        {
            Nombre = g.Key,
            Cantidad = g.Count(),
            Monto = g.Sum(item => item.Orden.Total)
        })
        .OrderByDescending(x => x.Monto)
        .Take(5)
        .ToList();

    var recientes = registros
        .Where(x => x != null && x.Orden != null)
        .OrderByDescending(x => x.Orden.FechaCreacion)
        .Take(5)
        .ToList();
}

<style>
