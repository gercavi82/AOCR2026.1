    #tablaGestionOrdenes tbody tr:hover { background:#f2fafb; }
    @@media (max-width:1200px) {
        .fin-kpi-grid,.fin-chart-grid { grid-template-columns:repeat(2,minmax(0,1fr)); }
        .fin-info-grid { grid-template-columns:1fr 2fr; }
    }
    @@media (max-width:768px) {
        .fin-dashboard { padding:4px 0 16px; }
        .fin-kpi-grid,.fin-chart-grid,.fin-info-grid { grid-template-columns:1fr; }
        .fin-dashboard-header::after { display:none; }
        .fin-dashboard-header { padding:20px; }
        .fin-dashboard-title { font-size:1.3rem; }
        .fin-donut-layout { justify-content:center; flex-wrap:wrap; }
    }
</style>

<div class="fin-dashboard">
    <div class="fin-dashboard-header">
        <span class="fin-dashboard-badge"><i class="fas fa-chart-line"></i> Gestión financiera</span>
        <h2 class="fin-dashboard-title">Dashboard Financiero</h2>
        <p class="fin-dashboard-subtitle">Valide órdenes, supervise la facturación FR3 y controle el desempeño operativo del área financiera.</p>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-aocr alert-success mb-3"><i class="fas fa-check-circle me-1"></i> @TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-aocr alert-danger mb-3"><i class="fas fa-exclamation-circle me-1"></i> @TempData["Error"]</div>
    }
    @if (ViewBag.SinResultadosConFiltro == true)
    {
        <div class="alert alert-aocr alert-warning mb-3">
            <i class="fas fa-filter me-1"></i> No se encontraron órdenes con el estado seleccionado. Se muestran todas las órdenes disponibles (Total: @ViewBag.TotalSinFiltro).
        </div>
    }

    <div class="fin-filters">
        <div>
            <span class="fin-chip"><i class="fas fa-wave-square"></i> AS400 @(as400FacturacionHabilitada ? "habilitado" : "deshabilitado")</span>
            <span class="fin-chip"><i class="fas fa-layer-group"></i> @totalOrdenes órdenes visibles</span>
            <button type="button" class="btn btn-outline-secondary btn-sm fin-health-button" id="btnHealthPostgres">
                <i class="fas fa-database me-1"></i> Probar PostgreSQL/DB2
            </button>
            <span id="healthResult" class="text-muted small"></span>
        </div>
        <form method="get" class="fin-filter-form">
            <label class="mb-0 aocr-field-label">Estado:</label>
            <select name="estado" class="form-select form-select-sm" onchange="this.form.submit()" style="min-width:180px;">
                <option value="EN_REVISION_FINANCIERA" @(ViewBag.EstadoFiltro == "EN_REVISION_FINANCIERA" ? "selected" : "")>En revision financiera</option>
                <option value="GENERADA" @(ViewBag.EstadoFiltro == "GENERADA" ? "selected" : "")>Generada</option>
                <option value="DEVUELTA" @(ViewBag.EstadoFiltro == "DEVUELTA" ? "selected" : "")>Devuelta</option>
                <option value="FACTURADA" @(ViewBag.EstadoFiltro == "FACTURADA" ? "selected" : "")>Facturada</option>
                <option value="COMPLETADA" @(ViewBag.EstadoFiltro == "COMPLETADA" ? "selected" : "")>Completada</option>
                <option value="ANULADA" @(ViewBag.EstadoFiltro == "ANULADA" ? "selected" : "")>Anulada</option>
                <option value="TODAS" @(ViewBag.EstadoFiltro == "TODAS" ? "selected" : "")>Todas</option>
            </select>
        </form>
    </div>

    <div class="fin-kpi-grid">
        <div class="fin-card fin-kpi-card" style="--kpi-color:var(--fin-cyan);">
            <div class="fin-kpi-top">
                <div><div class="fin-metric-label">Órdenes Totales</div><div class="fin-metric-value">@totalOrdenes</div></div>
                <span class="fin-kpi-icon"><i class="fas fa-file-invoice-dollar"></i></span>
            </div>
            <div class="fin-metric-sub">Volumen operativo visible en el tablero.</div>
            <div class="fin-kpi-progress" style="--progress:100%;"><span></span></div>
        </div>

        <div class="fin-card fin-kpi-card" style="--kpi-color:var(--fin-green);">
            <div class="fin-kpi-top">
                <div><div class="fin-metric-label">Monto Consolidado</div><div class="fin-metric-value">$ @montoTotal.ToString("N2")</div></div>
                <span class="fin-kpi-icon"><i class="fas fa-coins"></i></span>
            </div>
            <div class="fin-metric-sub">Valor total acumulado de las órdenes.</div>
            <div class="fin-kpi-progress" style="--progress:@porcentajeCompletadas%;"><span></span></div>
        </div>

        <div class="fin-card fin-kpi-card" style="--kpi-color:var(--fin-blue);">
            <div class="fin-kpi-top">
                <div><div class="fin-metric-label">Cumplimiento FR3</div><div class="fin-metric-value">@porcentajeFr3Ok%</div></div>
                <span class="fin-kpi-icon"><i class="fas fa-clipboard-check"></i></span>
            </div>
            <div class="fin-metric-sub">@fr3Ok emitidos · @fr3Pendiente pendientes · @fr3Error con error</div>
            <div class="fin-kpi-progress" style="--progress:@porcentajeFr3Ok%;"><span></span></div>
        </div>

        <div class="fin-card fin-kpi-card" style="--kpi-color:var(--fin-purple);">
            <div class="fin-kpi-top">
                <div><div class="fin-metric-label">Rendimiento</div><div class="fin-metric-value">@porcentajeCompletadas%</div></div>
                <span class="fin-kpi-icon"><i class="fas fa-chart-line"></i></span>
            </div>
            <div class="fin-metric-sub">@completadas órdenes completadas del total visible.</div>
            <div class="fin-kpi-progress" style="--progress:@porcentajeCompletadas%;"><span></span></div>
        </div>
    </div>

    <div class="fin-chart-grid">
        <div class="fin-card">
            <div class="fin-section-heading"><i class="fas fa-list-check"></i><div class="fin-metric-label">Estados Clave</div></div>
            <ul class="fin-list">
                <li><div class="fin-list-copy"><span class="fin-list-icon" style="--state-color:var(--fin-yellow);"><i class="fas fa-clock"></i></span><div><div class="fin-list-title">Generadas</div><div class="fin-list-sub">Pendientes de gestión</div></div></div><strong class="fin-list-value">@generadas</strong></li>
                <li><div class="fin-list-copy"><span class="fin-list-icon" style="--state-color:var(--fin-cyan);"><i class="fas fa-search-dollar"></i></span><div><div class="fin-list-title">En revisión</div><div class="fin-list-sub">Carga activa del equipo</div></div></div><strong class="fin-list-value">@enRevision</strong></li>
                <li><div class="fin-list-copy"><span class="fin-list-icon" style="--state-color:var(--fin-red);"><i class="fas fa-undo-alt"></i></span><div><div class="fin-list-title">Devueltas al RT</div><div class="fin-list-sub">Requieren corrección</div></div></div><strong class="fin-list-value">@devueltas</strong></li>
                <li><div class="fin-list-copy"><span class="fin-list-icon" style="--state-color:#8496a3;"><i class="fas fa-ban"></i></span><div><div class="fin-list-title">Anuladas</div><div class="fin-list-sub">Casos cerrados</div></div></div><strong class="fin-list-value">@anuladas</strong></li>
            </ul>
        </div>

        <div class="fin-card">
            <div class="d-flex justify-content-between align-items-center">
                <div class="fin-section-heading"><i class="fas fa-chart-pie"></i><div class="fin-metric-label">Distribución por Estado</div></div>
                <strong class="small text-muted">@totalOrdenes total</strong>
            </div>
            @{
                var pGeneradas = totalOrdenes > 0 ? (int)Math.Round((decimal)generadas * 100m / totalOrdenes) : 0;
                var pRevision = pGeneradas + (totalOrdenes > 0 ? (int)Math.Round((decimal)enRevision * 100m / totalOrdenes) : 0);
                var pDevueltas = pRevision + (totalOrdenes > 0 ? (int)Math.Round((decimal)devueltas * 100m / totalOrdenes) : 0);
            }
            <div class="fin-donut-layout">
                <div class="fin-donut" style="--p1:@pGeneradas%; --p2:@pRevision%; --p3:@pDevueltas%; @(totalOrdenes == 0 ? "background:#e6eef2;" : "")"><strong>@totalOrdenes</strong></div>
                <ul class="fin-legend fin-donut-legend">
                    <li><span><span class="fin-dot" style="background:var(--fin-yellow);"></span>Generadas</span><strong>@generadas</strong></li>
                    <li><span><span class="fin-dot" style="background:var(--fin-cyan);"></span>En revisión</span><strong>@enRevision</strong></li>
                    <li><span><span class="fin-dot" style="background:var(--fin-red);"></span>Devueltas</span><strong>@devueltas</strong></li>
                    <li><span><span class="fin-dot" style="background:var(--fin-green);"></span>Facturadas</span><strong>@facturadas</strong></li>
                </ul>
            </div>
        </div>

        <div class="fin-card">
            <div class="fin-section-heading"><i class="fas fa-chart-line"></i><div class="fin-metric-label">Tendencia Operativa</div></div>
            <div class="fin-line-chart">
                <svg viewBox="0 0 300 150" preserveAspectRatio="none" aria-hidden="true">
                    <defs><linearGradient id="finAreaGradient" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#11a8bd" stop-opacity=".22"></stop><stop offset="100%" stop-color="#11a8bd" stop-opacity="0"></stop></linearGradient></defs>
                    <line x1="0" y1="128" x2="300" y2="128" stroke="#e1e9ee" stroke-width="1"></line>
                    <path class="fin-line-area" d="M10 112 L55 108 L95 62 L135 100 L175 88 L215 42 L255 52 L290 16 L290 128 L10 128 Z"></path>
                    <polyline fill="none" stroke="#0b8fa7" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" points="10,112 55,108 95,62 135,100 175,88 215,42 255,52 290,16"></polyline>
                    <circle cx="95" cy="62" r="4" fill="#fff" stroke="#0b8fa7" stroke-width="3"></circle>
                    <circle cx="215" cy="42" r="4" fill="#fff" stroke="#0b8fa7" stroke-width="3"></circle>
                    <circle cx="290" cy="16" r="4" fill="#fff" stroke="#0b8fa7" stroke-width="3"></circle>
                </svg>
            </div>
            <div class="fin-mini-note"><span>Inicio</span><span>Pico actual de actividad</span></div>
        </div>

        <div class="fin-card fin-flow-card">
            <div class="fin-section-heading"><i class="fas fa-heartbeat"></i><div class="fin-metric-label">Salud del Flujo</div></div>
            <div class="fin-ring-wrap" style="position:relative; justify-content:center;">
                <div class="fin-ring" style="--ring-percent:@porcentajeCompletadas; --ring-color:#d98dc5;"></div>
                <div class="fin-ring-center">
                    <strong>@porcentajeCompletadas%</strong>
                    <span>Completadas</span>
                </div>
            </div>
        </div>
    </div>

    <div class="fin-chart-grid fin-info-grid">
        <div class="fin-card">
            <div class="fin-section-heading"><i class="fas fa-building"></i><div class="fin-metric-label">Top Compañías</div></div>
            <ul class="fin-list">
                @if (companias.Any())
                {
                    foreach (var compania in companias)
                    {
                        <li>
                            <div>
                                <div class="fin-list-title">@Html.Encode(compania.Nombre)</div>
                                <div class="fin-list-sub">@compania.Cantidad órdenes</div>
                            </div>
                            <strong>@compania.Monto.ToString("N2")</strong>
                        </li>
                    }
                }
                else
                {
                    <li>
                        <div class="fin-empty-state"><div><i class="far fa-building"></i><div class="fin-list-title">Sin compañías para mostrar</div><div class="fin-list-sub">Los resultados aparecerán al registrar actividad.</div></div></div>
                    </li>
                }
            </ul>
        </div>

        <div class="fin-card">
            <div class="fin-section-heading"><i class="fas fa-history"></i><div class="fin-metric-label">Actividad Reciente</div></div>
            <ul class="fin-list">
                @if (recientes.Any())
                {
                    foreach (var reciente in recientes)
                    {
                        var ordenReciente = reciente.Orden;
                        <li>
                            <div>
                                <div class="fin-list-title">@Html.Encode(ordenReciente.NumeroOrden)</div>
                                <div class="fin-list-sub">@Html.Encode(!string.IsNullOrWhiteSpace(ordenReciente.NombreContribuyente) ? ordenReciente.NombreContribuyente : ordenReciente.Compania) · @ordenReciente.FechaCreacion.ToString("dd/MM/yyyy")</div>
                            </div>
                            <div class="text-end">
                                <div class="fin-list-title">@ordenReciente.Total.ToString("N2")</div>
                                <div class="fin-list-sub">@Html.Encode(textoEstado(ordenReciente.Estado))</div>
                            </div>
                        </li>
                    }
                }
                else
                {
                    <li>
                        <div class="fin-empty-state"><div><i class="far fa-clock"></i><div class="fin-list-title">Sin actividad reciente</div><div class="fin-list-sub">Aquí se mostrarán los últimos movimientos financieros.</div></div></div>
                    </li>
                }
            </ul>
        </div>
    </div>

    <div class="fin-table-card">
        <div class="fin-table-header">
            <div>
                <h3>Gestión de órdenes</h3>
                <div class="text-muted small">Revise, apruebe y dé seguimiento al ciclo operativo de cada orden.</div>
            </div>
            <span class="fin-chip"><i class="fas fa-table"></i> Vista operativa</span>
        </div>
        <div class="aocr-table-container">
<table class="table table-dgac mb-0" id="tablaGestionOrdenes">
    <thead>
        <tr>
            <th>#</th>
            <th>Orden</th>
            <th>Compañía</th>
            <th>Fecha</th>
            <th>Monto</th>
            <th>Estado</th>
            <th>FR3</th>
            <th>Comprobante</th>
            <th class="text-center">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            int i = 1;
            foreach (var item in Model)
            {
                var orden = item.Orden;
                var pago = item.Pago;
                var estadoNorm = orden != null ? normalizarEstado(orden.Estado) : string.Empty;
                var puedeGestionarPorEstado = item.PuedeGestionarPago;
        <tr>
            <td>@Html.Encode(i)</td>
            <td>@Html.Encode(orden != null ? orden.NumeroOrden : "-")</td>
            <td>@Html.Encode(orden != null ? (orden.NombreContribuyente ?? orden.Compania) : "-")</td>
            <td>@Html.Encode(orden != null ? orden.FechaCreacion.ToString("dd/MM/yyyy") : "")</td>
            <td>@Html.Encode(orden != null ? orden.Total.ToString("N2") : "0.00")</td>
            <td>
                @if (orden != null)
                {
                    var badgeCss = "bg-secondary";
                    switch (estadoNorm)
                    {
                        case EstadoOrden.Completada:
                        case EstadoOrden.Pagada:
                            badgeCss = "bg-success";
                            break;
                        case EstadoOrden.Facturada:
                            badgeCss = "bg-info text-dark";
                            break;
                        case EstadoOrden.Anulada:
                            badgeCss = "bg-danger";
                            break;
                        case EstadoOrden.Devuelta:
                            badgeCss = "bg-danger";
                            break;
                        case EstadoOrden.EnRevisionFinanciera:
                            badgeCss = "bg-primary";
                            break;
                        case EstadoOrden.Enviada:
                            badgeCss = "bg-info text-dark";
                            break;
                        case EstadoOrden.Generada:
                            badgeCss = "bg-warning text-dark";
                            break;
                    }
                    <span class="badge @badgeCss">@Html.Encode(textoEstado(orden.Estado))</span>
                }
            </td>
            <td>
                @if (!string.IsNullOrWhiteSpace(item.Fr3Numero))
                {
                    <span class="badge bg-success">@Html.Encode(item.Fr3Numero)</span>
                }
                else if (!string.IsNullOrWhiteSpace(item.Fr3Estado))
                {
                    var cssFr3 = item.Fr3Estado.Equals("FR3_ERROR", StringComparison.OrdinalIgnoreCase) ? "bg-danger" : "bg-secondary";
                    <span class="badge @cssFr3">@Html.Encode(item.Fr3Estado)</span>
                    if (!string.IsNullOrWhiteSpace(item.Fr3Error))
                    {
                        var fr3ErrorDisplay = System.Web.HttpUtility.HtmlDecode(item.Fr3Error);
                        <div><small class="text-danger">@fr3ErrorDisplay</small></div>
                    }
                }
                else
                {
                    <span class="text-muted">Pendiente</span>
                }
            </td>
            <td>
                @if (orden != null)
                {
                    <a href="@Url.Action("DescargarPdf", "OrdenRecaudacion", new { id = orden.Id, vistaPrevia = true })"
                       target="_blank"
                       class="btn btn-outline-secondary btn-sm btn-pdf"
                       title="Vista previa PDF de la orden">
                        <i class="fas fa-eye"></i>
                    </a>
                    <a href="@Url.Action("DescargarPdf", "OrdenRecaudacion", new { id = orden.Id })"
                       target="_blank"
                       class="btn btn-outline-success btn-sm btn-pdf"
                       title="Descargar PDF de la orden">
                        <i class="fas fa-download"></i>
                    </a>
                }
                else
                {
                    <span class="text-muted">Sin orden</span>
                }
            </td>
            <td class="acciones-cell">
                @if (orden != null)
                {
                    <div class="acciones-orden">
                        <a href="@Url.Action("Detalles", "OrdenRecaudacion", new { id = orden.Id })"
                           class="btn btn-outline-primary btn-sm btn-accion"
                           title="Ver detalles">
                            <i class="fas fa-eye"></i>
                        </a>

                        @if (puedeGestionarPorEstado)
                        {
                            <button type="button"
                                    class="btn btn-success btn-sm btn-accion js-abrir-modal-factura"
                                    title="Aprobar pago"
                                    data-orden-id="@orden.Id"
                                    data-pago-id="@(pago != null ? pago.CodigoPago.ToString() : string.Empty)"
                                    data-numero-orden="@Html.Encode(orden.NumeroOrden)"
                                    data-monto="@((orden.Total).ToString("N2"))">
                                <i class="fas fa-check"></i>
                            </button>

                            <button class="btn btn-danger btn-sm btn-accion js-abrir-modal-rechazo" type="button"
                                    title="Rechazar"
                                    data-orden-id="@orden.Id"
                                    data-numero-orden="@Html.Encode(orden.NumeroOrden)">
                                <i class="fas fa-times"></i>
                            </button>
                        }

                        @if (item.PuedeReintentarFr3)
                        {
                            <button type="button"
                                    class="btn btn-warning btn-sm btn-accion js-retry-fr3"
                                    title="Reintentar FR3"
                                    data-orden-id="@orden.Id">
                                <i class="fas fa-sync"></i>
                            </button>
                        }
                    </div>
                }
            </td>
        </tr>
                i++;
            }
        }
    </tbody>
</table>
</div>
    </div>
</div>


<div class="modal fade fin-modal" id="modalRechazarOrden" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Devolver Orden</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="formRechazarOrden" method="post" action="@Url.Action("RechazarOrden", "Financiero")">
                @Html.AntiForgeryToken()
                <input type="hidden" id="rechazo_orden_id" name="id" />
                <div class="modal-body">
                    <div class="mb-3">
                        <small class="text-muted">Orden:</small>
                        <div><strong id="rechazo_numero_orden">-</strong></div>
                    </div>
                    <label class="form-label">Motivo de devolucion</label>
                    <textarea name="motivo" class="form-control" rows="3" required></textarea>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-danger"><i class="fas fa-times me-1"></i>Devolver</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade fin-modal" id="modalAprobarPagoFactura" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Aprobar Orden de Recaudación</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <form id="formAprobarPagoFactura" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="factura_orden_id" name="ordenId" />
                <div class="modal-body">
                    <div class="mb-3">
                        <small class="text-muted">Orden:</small>
                        <div><strong id="factura_numero_orden">-</strong></div>
                    </div>
                    <div class="mb-3">
                        <small class="text-muted">Monto:</small>
                        <div><strong id="factura_monto_orden">-</strong></div>
                    </div>

                    <div id="facturaModalAlert" class="alert d-none" role="alert"></div>

                    <div class="alert alert-info py-2" role="alert">
                        <i class="fas fa-info-circle me-1"></i>
                        Se aprobará la orden de recaudación y se emitirá la factura correspondiente solo después de validar el comprobante de pago.
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" id="btnAprobarConFactura" class="btn btn-success">
                        <i class="fas fa-check-circle me-1"></i>Aprobar Orden
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

