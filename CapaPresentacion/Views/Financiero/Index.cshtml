@inherits System.Web.Mvc.WebViewPage<List<CapaPresentacion.Models.OrdenValidacionFinancieraVM>>
@using CapaModelo
@using System.Web.Mvc
@using System.Web.Mvc.Html

@{
    ViewBag.Title = "Dashboard Financiero";
}

<h2>Financiero – Validación de Órdenes</h2>
<hr />

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}
@if (ViewBag.SinResultadosConFiltro == true)
{
    <div class="alert alert-warning">
        No se encontraron órdenes con el estado seleccionado. Se muestran todas las órdenes disponibles (Total: @ViewBag.TotalSinFiltro).
    </div>
}

<div class="d-flex justify-content-end mb-3">
    <form method="get" class="d-flex align-items-center gap-2">
        <label class="mb-0 text-muted">Estado:</label>
        <select name="estado" class="form-select form-select-sm" onchange="this.form.submit()">
<option value="PROCESADA" @(ViewBag.EstadoFiltro == "PROCESADA" ? "selected" : "")>En revisión</option>
<option value="PENDIENTE" @(ViewBag.EstadoFiltro == "PENDIENTE" ? "selected" : "")>Pendiente</option>
<option value="FACTURADA" @(ViewBag.EstadoFiltro == "FACTURADA" ? "selected" : "")>Facturada</option>
<option value="COMPLETADA" @(ViewBag.EstadoFiltro == "COMPLETADA" ? "selected" : "")>Completada</option>
<option value="ANULADA" @(ViewBag.EstadoFiltro == "ANULADA" ? "selected" : "")>Anulada</option>
<option value="TODAS" @(ViewBag.EstadoFiltro == "TODAS" ? "selected" : "")>Todas</option>
        </select>
    </form>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>#</th>
            <th>Orden</th>
            <th>Compañía</th>
            <th>Fecha</th>
            <th>Monto</th>
            <th>Estado</th>
            <th>Comprobante</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            int i = 1;
            foreach (var item in Model)
            {
                var orden = item.Orden;
                var pago = item.Pago;
                var comp = pago != null ? pago.ComprobanteRuta : null;
                var estadoNorm = orden != null ? ((orden.Estado ?? "").Trim().ToUpperInvariant().Replace(" ", "_")) : "";
        <tr>
            <td>@i</td>
            <td>@(orden != null ? orden.NumeroOrden : "-")</td>
            <td>@(orden != null ? (orden.NombreContribuyente ?? orden.Compania) : "-")</td>
            <td>@(orden != null ? orden.FechaCreacion.ToString("dd/MM/yyyy") : "")</td>
            <td>@(orden != null ? orden.Total.ToString("N2") : "0.00")</td>
            <td>@(orden != null ? orden.Estado : "")</td>
            <td>
                @if (!string.IsNullOrWhiteSpace(comp))
                {
                    <a href="@Url.Content(comp)" target="_blank">Ver</a>
                }
                else
                {
                    <span class="text-muted">Sin archivo</span>
                }
            </td>
            <td>
                @if (orden != null && pago != null && (estadoNorm == "PROCESADA" || estadoNorm == "PENDIENTE"))
                {
                    using (Html.BeginForm("AprobarPago", "Financiero", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        @Html.Hidden("id", (object)orden.Id)
                        @Html.Hidden("pagoId", (object)pago.CodigoPago)
                        <button type="submit" class="btn btn-sm btn-success">Aprobar pago</button>
                    }

                    <button class="btn btn-sm btn-danger" type="button" data-bs-toggle="modal" data-bs-target="#modalRechazo-@orden.Id">Rechazar</button>

                    <div class="modal fade" id="modalRechazo-@orden.Id" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title">Rechazar Orden</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                @using (Html.BeginForm("RechazarOrden", "Financiero", FormMethod.Post))
                                {
                                    @Html.AntiForgeryToken()
                                    @Html.Hidden("id", orden.Id)
                                    <div class="modal-body">
                                        <label class="form-label">Motivo</label>
                                        <textarea name="motivo" class="form-control" rows="3" required></textarea>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                                        <button type="submit" class="btn btn-danger">Rechazar</button>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </td>
        </tr>
                i++;
            }
        }
        else
        {
            <tr>
                <td colspan="8" class="text-center">
                    No hay registros para el estado seleccionado.
                </td>
            </tr>
        }
    </tbody>
</table>







