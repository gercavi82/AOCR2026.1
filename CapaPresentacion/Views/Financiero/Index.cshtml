@inherits System.Web.Mvc.WebViewPage<List<CapaPresentacion.Models.OrdenValidacionFinancieraVM>>
@using CapaModelo
@using CapaNegocio.Services
@using System.Web.Mvc
@using System.Web.Mvc.Html

@{
    ViewBag.Title = "Dashboard Financiero";
    var as400FacturacionHabilitada = FacturacionAS400Service.IsEnabled();
}

<style>
    .acciones-cell {
        min-width: 150px;
    }

    .acciones-orden {
        display: flex;
        align-items: center;
        gap: .35rem;
        flex-wrap: wrap;
    }

    .acciones-orden form {
        margin: 0;
    }

    .btn-accion {
        width: 32px;
        height: 32px;
        padding: 0;
        border-radius: 8px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        line-height: 1;
    }

    .btn-pdf {
        width: 30px;
        height: 30px;
        padding: 0;
        border-radius: 8px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }
</style>

<h2>Financiero – Validación de Órdenes</h2>
<hr />

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}
@if (ViewBag.SinResultadosConFiltro == true)
{
    <div class="alert alert-warning">
        No se encontraron órdenes con el estado seleccionado. Se muestran todas las órdenes disponibles (Total: @ViewBag.TotalSinFiltro).
    </div>
}

<div class="d-flex justify-content-end mb-3">
    <form method="get" class="d-flex align-items-center gap-2">
        <label class="mb-0 text-muted">Estado:</label>
        <select name="estado" class="form-select form-select-sm" onchange="this.form.submit()">
<option value="PROCESADA" @(ViewBag.EstadoFiltro == "PROCESADA" ? "selected" : "")>En revisión</option>
<option value="PENDIENTE" @(ViewBag.EstadoFiltro == "PENDIENTE" ? "selected" : "")>Pendiente</option>
<option value="FACTURADA" @(ViewBag.EstadoFiltro == "FACTURADA" ? "selected" : "")>Facturada</option>
<option value="COMPLETADA" @(ViewBag.EstadoFiltro == "COMPLETADA" ? "selected" : "")>Completada</option>
<option value="ANULADA" @(ViewBag.EstadoFiltro == "ANULADA" ? "selected" : "")>Anulada</option>
<option value="TODAS" @(ViewBag.EstadoFiltro == "TODAS" ? "selected" : "")>Todas</option>
        </select>
    </form>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>#</th>
            <th>Orden</th>
            <th>Compañía</th>
            <th>Fecha</th>
            <th>Monto</th>
            <th>Estado</th>
            <th>Comprobante</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            int i = 1;
            foreach (var item in Model)
            {
                var orden = item.Orden;
                var pago = item.Pago;
                var estadoNorm = orden != null ? ((orden.Estado ?? "").Trim().ToUpperInvariant().Replace(" ", "_")) : "";
                var esPendiente = !string.IsNullOrWhiteSpace(estadoNorm) && estadoNorm.StartsWith("PENDIENTE");
                var puedeGestionarPorEstado = (estadoNorm == "PROCESADA" || esPendiente);
        <tr>
            <td>@Html.Encode(i)</td>
            <td>@Html.Encode(orden != null ? orden.NumeroOrden : "-")</td>
            <td>@Html.Encode(orden != null ? (orden.NombreContribuyente ?? orden.Compania) : "-")</td>
            <td>@Html.Encode(orden != null ? orden.FechaCreacion.ToString("dd/MM/yyyy") : "")</td>
            <td>@Html.Encode(orden != null ? orden.Total.ToString("N2") : "0.00")</td>
            <td>@Html.Encode(orden != null ? orden.Estado : "")</td>
            <td>
                @if (orden != null)
                {
                    <a href="@Url.Action("DescargarPdf", "OrdenRecaudacion", new { id = orden.Id })"
                       target="_blank"
                       class="btn btn-outline-secondary btn-sm btn-pdf"
                       title="Ver PDF de la orden">
                        <i class="fas fa-file-pdf"></i>
                    </a>
                }
                else
                {
                    <span class="text-muted">Sin orden</span>
                }
            </td>
            <td class="acciones-cell">
                @if (orden != null)
                {
                    <div class="acciones-orden">
                        <a href="@Url.Action("Detalles", "OrdenRecaudacion", new { id = orden.Id })"
                           class="btn btn-outline-primary btn-sm btn-accion"
                           title="Ver detalles">
                            <i class="fas fa-eye"></i>
                        </a>

                        @if (puedeGestionarPorEstado)
                        {
                            <button type="button"
                                    class="btn btn-success btn-sm btn-accion js-abrir-modal-factura"
                                    title="Aprobar pago"
                                    data-orden-id="@orden.Id"
                                    data-pago-id="@(pago != null ? pago.CodigoPago.ToString() : string.Empty)"
                                    data-numero-orden="@Html.Encode(orden.NumeroOrden)"
                                    data-monto="@((orden.Total).ToString("0.00", System.Globalization.CultureInfo.InvariantCulture))">
                                <i class="fas fa-check"></i>
                            </button>

                            <button class="btn btn-danger btn-sm btn-accion" type="button"
                                    title="Rechazar"
                                    data-bs-toggle="modal" data-bs-target="#modalRechazo-@orden.Id">
                                <i class="fas fa-times"></i>
                            </button>
                            <div class="modal fade" id="modalRechazo-@orden.Id" tabindex="-1" aria-hidden="true">
                                <div class="modal-dialog">
                                    <div class="modal-content">
                                        <div class="modal-header">
                                            <h5 class="modal-title">Rechazar Orden</h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                        </div>
                                        <form method="post" action="@Url.Action("RechazarOrden", "Financiero")">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@orden.Id" />
                                            <div class="modal-body">
                                                <label class="form-label">Motivo</label>
                                                <textarea name="motivo" class="form-control" rows="3" required></textarea>
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                                                <button type="submit" class="btn btn-danger">Rechazar</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </td>
        </tr>
                i++;
            }
        }
        else
        {
            <tr>
                <td colspan="8" class="text-center">
                    No hay registros para el estado seleccionado.
                </td>
            </tr>
        }
    </tbody>
</table>

<div class="modal fade" id="modalAprobarPagoFactura" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Aprobar pago y registrar factura</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <form id="formAprobarPagoFactura" method="post" enctype="multipart/form-data" data-as400-fr3-enabled="@(as400FacturacionHabilitada ? "1" : "0")">
                @Html.AntiForgeryToken()
                <input type="hidden" id="factura_orden_id" name="OrdenId" />
                <input type="hidden" id="factura_pago_id" name="PagoId" />
                <div class="modal-body">
                    <div class="mb-2">
                        <small class="text-muted">Orden:</small>
                        <div><strong id="factura_numero_orden">-</strong></div>
                    </div>

                    <div id="facturaModalAlert" class="alert d-none" role="alert"></div>
                    @if (as400FacturacionHabilitada)
                    {
                        <div class="alert alert-info py-2" role="alert">
                            Al aprobar se registrará la factura en AOCR y se intentará sincronizar FR3 en AS400.
                        </div>
                    }

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Número de factura *</label>
                            <input type="text" class="form-control" name="NumeroFactura" id="factura_numero" maxlength="80" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Autorización</label>
                            <input type="text" class="form-control" name="AutorizacionFactura" id="factura_autorizacion" maxlength="80" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Fecha emisión *</label>
                            <input type="date" class="form-control" name="FechaEmision" id="factura_fecha" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Subtotal *</label>
                            <input type="number" class="form-control" step="0.01" min="0" name="Subtotal" id="factura_subtotal" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">IVA *</label>
                            <input type="number" class="form-control" step="0.01" min="0" name="Iva" id="factura_iva" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Total *</label>
                            <input type="number" class="form-control" step="0.01" min="0.01" name="Total" id="factura_total" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Archivo factura *</label>
                            <input type="file" class="form-control" name="facturaFile" id="factura_archivo" accept=".pdf,.jpg,.jpeg,.png" required />
                            <small class="text-muted">Formatos permitidos: PDF, JPG, PNG (máx. 10MB)</small>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Observaciones</label>
                            <textarea class="form-control" name="Observaciones" id="factura_observaciones" rows="2"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" id="btnAprobarConFactura" class="btn btn-success">Aprobar y Registrar</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
(function () {
    var modalElement = document.getElementById('modalAprobarPagoFactura');
    if (!modalElement || !window.bootstrap) {
        return;
    }

    var modal = new bootstrap.Modal(modalElement);
    var form = document.getElementById('formAprobarPagoFactura');
    var alertBox = document.getElementById('facturaModalAlert');
    var submitButton = document.getElementById('btnAprobarConFactura');
    var numeroOrdenLabel = document.getElementById('factura_numero_orden');
    var inputOrdenId = document.getElementById('factura_orden_id');
    var inputPagoId = document.getElementById('factura_pago_id');
    var inputFecha = document.getElementById('factura_fecha');
    var inputSubtotal = document.getElementById('factura_subtotal');
    var inputIva = document.getElementById('factura_iva');
    var inputTotal = document.getElementById('factura_total');
    var inputArchivo = document.getElementById('factura_archivo');
    var tokenInput = form ? form.querySelector('input[name="__RequestVerificationToken"]') : null;
    var as400Fr3Enabled = form && form.getAttribute('data-as400-fr3-enabled') === '1';
    var submitLabelIdle = as400Fr3Enabled ? 'Aprobar, Registrar y Enviar AS400' : 'Aprobar y Registrar';
    var isSubmitting = false;

    if (!form || !alertBox || !submitButton) {
        return;
    }

    if (form.dataset.facturaSubmitBound === '1') {
        return;
    }
    form.dataset.facturaSubmitBound = '1';

    function showAlert(type, message) {
        alertBox.className = 'alert alert-' + type;
        alertBox.textContent = message;
        alertBox.classList.remove('d-none');
    }

    function clearAlert() {
        alertBox.className = 'alert d-none';
        alertBox.textContent = '';
    }

    function setSubmitting(isSubmitting) {
        submitButton.disabled = isSubmitting;
        submitButton.textContent = isSubmitting ? 'Procesando...' : submitLabelIdle;
    }

    function setInFlight(value) {
        isSubmitting = value === true;
        setSubmitting(isSubmitting);
    }

    function openModalFromButton(button) {
        var ordenId = button.getAttribute('data-orden-id') || '';
        var pagoId = button.getAttribute('data-pago-id') || '';
        var numeroOrden = button.getAttribute('data-numero-orden') || '-';
        var monto = button.getAttribute('data-monto') || '';

        inputOrdenId.value = ordenId;
        inputPagoId.value = pagoId;
        numeroOrdenLabel.textContent = numeroOrden;

        form.reset();
        inputOrdenId.value = ordenId;
        inputPagoId.value = pagoId;
        numeroOrdenLabel.textContent = numeroOrden;

        if (inputFecha) {
            inputFecha.value = new Date().toISOString().slice(0, 10);
        }
        if (inputSubtotal && !inputSubtotal.value && monto) {
            inputSubtotal.value = monto;
        }
        if (inputTotal && !inputTotal.value && monto) {
            inputTotal.value = monto;
        }
        if (inputIva && !inputIva.value) {
            inputIva.value = '0.00';
        }

        clearAlert();
        setInFlight(false);
        modal.show();
    }

    if (!document.body.dataset.facturaModalClickBound) {
        document.body.dataset.facturaModalClickBound = '1';
        document.addEventListener('click', function (event) {
            var button = event.target.closest('.js-abrir-modal-factura');
            if (!button) {
                return;
            }

            if (isSubmitting) {
                return;
            }

            event.preventDefault();
            openModalFromButton(button);
        });
    }

    form.addEventListener('submit', function (event) {
        event.preventDefault();

        if (isSubmitting) {
            return;
        }

        clearAlert();

        if (!inputArchivo || !inputArchivo.files || inputArchivo.files.length === 0) {
            showAlert('danger', 'Debe adjuntar la factura.');
            return;
        }

        var file = inputArchivo.files[0];
        var ext = (file.name.split('.').pop() || '').toLowerCase();
        var allowed = { pdf: true, jpg: true, jpeg: true, png: true };
        if (!allowed[ext]) {
            showAlert('danger', 'Formato no permitido. Solo PDF/JPG/PNG.');
            return;
        }
        if (file.size > (10 * 1024 * 1024)) {
            showAlert('danger', 'El archivo supera el tamaño máximo (10MB).');
            return;
        }

        var subtotal = parseFloat((inputSubtotal.value || '0').replace(',', '.'));
        var iva = parseFloat((inputIva.value || '0').replace(',', '.'));
        var total = parseFloat((inputTotal.value || '0').replace(',', '.'));
        if (isNaN(subtotal) || isNaN(iva) || isNaN(total) || total <= 0) {
            showAlert('danger', 'Valores de subtotal/IVA/total inválidos.');
            return;
        }
        if (Math.abs((subtotal + iva) - total) > 0.05) {
            showAlert('danger', 'El total debe coincidir con subtotal + IVA.');
            return;
        }

        setInFlight(true);

        var actionUrl = '@Url.Action("AprobarPagoConFactura", "Financiero")';
        var formData = new FormData(form);
        formData.set('Subtotal', subtotal.toFixed(2));
        formData.set('Iva', iva.toFixed(2));
        formData.set('Total', total.toFixed(2));
        if (inputFecha && inputFecha.value) {
            formData.set('FechaEmision', inputFecha.value);
        }
        if (tokenInput && tokenInput.value) {
            formData.set('__RequestVerificationToken', tokenInput.value);
        }

        fetch(actionUrl, {
            method: 'POST',
            body: formData,
            credentials: 'same-origin',
            headers: {
                'X-Requested-With': 'XMLHttpRequest'
            }
        })
        .then(function (response) {
            return response.text().then(function (text) {
                var payload = null;
                try {
                    payload = text ? JSON.parse(text) : null;
                } catch (e) {
                    payload = null;
                }
                return { response: response, payload: payload, rawText: text };
            });
        })
        .then(function (result) {
            var payload = result.payload || {};
            if (!result.response.ok || payload.ok !== true) {
                var errorMessage = payload.message || '';
                if (!errorMessage && result.rawText) {
                    errorMessage = result.rawText.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();
                }
                if (!errorMessage) {
                    errorMessage = 'Error al aprobar pago (HTTP ' + result.response.status + ').';
                }
                throw new Error(errorMessage);
            }

            var finalMessage = payload.warning
                ? (payload.message + ' ' + payload.warning)
                : payload.message;
            showAlert('success', finalMessage || 'Pago aprobado correctamente.');

            setTimeout(function () {
                modal.hide();
                window.location.reload();
            }, 700);
        })
        .catch(function (error) {
            showAlert('danger', error && error.message ? error.message : 'No se pudo completar la operación.');
        })
        .finally(function () {
            setInFlight(false);
        });
    });
})();
</script>
}
