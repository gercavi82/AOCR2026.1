@model List<CapaPresentacion.Models.PagoFinancieroVM>

@{
    ViewBag.Title = "Dashboard Financiero";
}

<h2>Financiero – Pagos y Solicitudes</h2>
<hr />

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<table class="table table-striped">
    <thead>
        <tr>
            <th>#</th>
            <th>Operador</th>
            <th>Fecha Solicitud</th>
            <th>Fecha Pago</th>
            <th>Monto</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            int i = 1;
            foreach (var item in Model)
            {
                var sol = item.Solicitud;
                var pago = item.Pago;
        <tr>
            <td>@i</td>
            <td>@(sol != null ? sol.NombreOperador : "-")</td>
            <td>@(sol != null && sol.FechaSolicitud.HasValue ? sol.FechaSolicitud.Value.ToString("dd/MM/yyyy") : "")</td>
            <td>@(pago != null && pago.FechaPago.HasValue ? pago.FechaPago.Value.ToString("dd/MM/yyyy") : "")</td>
            <td>@(pago != null && pago.Monto.HasValue ? pago.Monto.Value.ToString("N2") : "0.00")</td>
            <td>@(pago != null ? pago.Estado : (sol != null ? sol.Estado : ""))</td>
            <td>
                <a href="@Url.Action("RevisarSolicitud", "Financiero", new { id = sol != null ? sol.CodigoSolicitud : 0 })"
                   class="btn btn-sm btn-primary">Revisar</a>
            </td>
        </tr>
                i++;
            }
        }
        else
        {
            <tr><td colspan="7" class="text-center">No hay registros.</td></tr>
        }
    </tbody>
</table>

