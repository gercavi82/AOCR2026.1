@inherits System.Web.Mvc.WebViewPage<List<CapaDatos.Models.OrdenRecaudacionModel>>
@using CapaDatos.Constants
@using CapaModelo
@using System.Web.Mvc
@using System.Web.Mvc.Html
@functions {
    public static string NormalizarEstadoVisual(string estado)
    {
        var actual = EstadoOrden.NormalizarEstado(estado);
        if (actual == EstadoOrden.Pendiente || actual == EstadoOrden.Generada)
        {
            return EstadoOrden.Generada;
        }

        return actual;
    }

    public static string GetTextoEstado(string estado)
    {
        if (string.IsNullOrWhiteSpace(estado))
        {
            return "SIN ESTADO";
        }

        var est = NormalizarEstadoVisual(estado);
        switch (est)
        {
            case EstadoOrden.Generada: return "GENERADA";
            case EstadoOrden.Enviada: return "ENVIADA";
            case EstadoOrden.EnRevisionFinanciera: return "EN REVISION FINANCIERA";
            case EstadoOrden.Devuelta: return "DEVUELTA";
            case EstadoOrden.Facturada: return "FACTURADA";
            case EstadoOrden.Completada: return "COMPLETADA";
            case EstadoOrden.Pagada: return "PAGADA";
            case EstadoOrden.Anulada: return "ANULADA";
            default: return est;
        }
    }

    public static string GetTextoTramite(string estado)
    {
        if (string.IsNullOrWhiteSpace(estado))
        {
            return "SIN ESTADO";
        }

        var est = NormalizarEstadoVisual(estado);
        switch (est)
        {
            case EstadoOrden.Borrador: return "Borrador";
            case EstadoOrden.Generada: return "Generada / pendiente de pago";
            case EstadoOrden.Enviada: return "Enviada a financiero";
            case EstadoOrden.EnRevisionFinanciera: return "En revision financiera";
            case EstadoOrden.Devuelta: return "Devuelta para correccion";
            case EstadoOrden.Facturada: return "Factura generada";
            case EstadoOrden.Completada: return "Completada";
            case EstadoOrden.Pagada: return "Pagada";
            case EstadoOrden.Anulada: return "Anulada";
            default: return est;
        }
    }
}

@{
    ViewBag.Title = "Todas las Órdenes de recaudación";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="h3 mb-0 text-gray-800">
                <i class="fas fa-list-alt me-2"></i>Todas las Órdenes de Recaudación
            </h1>
            <p class="text-muted">Vista administrativa de todas las órdenes del sistema</p>
        </div>
    </div>

    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">Órdenes de recaudación</h6>
        </div>
        <div class="card-body">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Número Orden</th>
                                <th>Usuario</th>
                                <th>Fecha Creación</th>
                                <th>Estado</th>
                                <th>Trámite</th>
                                <th>Monto</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var orden in Model)
                            {
                                <tr>
                                    <td>@orden.Id</td>
                                    <td>@orden.NumeroOrden</td>
                                    <td>@orden.CodigoUsuario</td>
                                    <td>@orden.FechaCreacion.ToString("dd/MM/yyyy")</td>
                                    <td>@GetTextoEstado(orden.Estado)</td>
                                    <td>@GetTextoTramite(orden.Estado)</td>
                                    <td>@orden.Total.ToString("C")</td>
                                    <td class="text-center">
                                        <a href="@Url.Action("Detalles", "OrdenRecaudacion", new { id = orden.Id })"
                                           class="btn btn-sm btn-outline-primary"
                                           title="Ver detalles">
                                            <i class="fas fa-eye"></i>
                                            <span class="visually-hidden">Ver Detalles</span>
                                        </a>

                                        @{
                                            var estadoNorm = NormalizarEstadoVisual(orden.Estado);
                                        }

                                        @if (estadoNorm == EstadoOrden.EnRevisionFinanciera)
                                        {
                                            using (Html.BeginForm("AprobarOrden", "Financiero", FormMethod.Post))
                                            {
                                                @Html.AntiForgeryToken()
                                                @Html.Hidden("id", orden.Id)
                                                <button type="submit" class="btn btn-sm btn-success ms-1">Aprobar</button>
                                            }

                                            <button class="btn btn-sm btn-danger ms-1" type="button"
                                                    data-bs-toggle="modal" data-bs-target="#modalRechazo-@orden.Id">
                                                Devolver
                                            </button>

                                            <div class="modal fade" id="modalRechazo-@orden.Id" tabindex="-1" aria-hidden="true">
                                                <div class="modal-dialog">
                                                    <div class="modal-content">
                                                        <div class="modal-header">
                                                            <h5 class="modal-title">Devolver Orden</h5>
                                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                        </div>
                                                        @using (Html.BeginForm("RechazarOrden", "Financiero", FormMethod.Post))
                                                        {
                                                            @Html.AntiForgeryToken()
                                                            @Html.Hidden("id", orden.Id)
                                                            <div class="modal-body">
                                                                <label class="form-label">Motivo de devolucion</label>
                                                                <textarea name="motivo" class="form-control" rows="3" required></textarea>
                                                            </div>
                                                            <div class="modal-footer">
                                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                                                                <button type="submit" class="btn btn-danger">Devolver</button>
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-4">
                    <i class="fas fa-inbox fa-3x text-muted mb-3"></i>
                    <h5 class="text-muted">No hay órdenes registradas</h5>
                </div>
            }
        </div>
    </div>
</div>

            @section Scripts {
                <script src="@Url.Content("~/Content/plugins/datatables/jquery.dataTables.min.js")"></script>
                <script src="https://cdn.datatables.net/1.13.4/js/dataTables.bootstrap5.min.js"></script>
                <script src="https://cdn.datatables.net/responsive/2.4.1/js/dataTables.responsive.min.js"></script>
                <script src="https://cdn.datatables.net/responsive/2.4.1/js/responsive.bootstrap5.min.js"></script>
                <script>
                    $(document).ready(function () {
                        $('#dataTable').DataTable({
                            responsive: true,
                            language: {
                                url: '@Url.Content("~/Content/plugins/datatables/i18n/Spanish.json")'
                            },
                            order: [[0, 'desc']],
                            pageLength: 5,
                            lengthMenu: [[5, 10, 25, 50, -1], [5, 10, 25, 50, 'Todos']]
                        });
                    });
                </script>
            }



