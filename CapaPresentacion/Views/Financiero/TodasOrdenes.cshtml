@model List<CapaDatos.Models.OrdenRecaudacionModel>

@{
    ViewBag.Title = "Todas las Órdenes de Recaudación";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="h3 mb-0 text-gray-800">
                <i class="fas fa-list-alt me-2"></i>Todas las Órdenes de Recaudación
            </h1>
            <p class="text-muted">Vista administrativa de todas las órdenes del sistema</p>
        </div>
    </div>

    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">Órdenes de Recaudación</h6>
        </div>
        <div class="card-body">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Número Orden</th>
                                <th>Usuario</th>
                                <th>Fecha Creación</th>
                                <th>Estado</th>
                                <th>Monto</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var orden in Model)
                            {
                                <tr>
                                    <td>@orden.Id</td>
                                    <td>@orden.NumeroOrden</td>
                                    <td>@orden.CodigoUsuario</td>
                                    <td>@orden.FechaCreacion.ToString("dd/MM/yyyy")</td>
                                    <td>@orden.Estado</td>
                                    <td>@orden.Total.ToString("C")</td>
                                    <td>
                                        <a href="@Url.Action("Detalles", "OrdenRecaudacion", new { id = orden.Id })"
                                           class="btn btn-sm btn-info">Ver Detalles</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-4">
                    <i class="fas fa-inbox fa-3x text-muted mb-3"></i>
                    <h5 class="text-muted">No hay órdenes registradas</h5>
                </div>
            }
        </div>
    </div>
</div>
