                            Linea("2. Verificar si los certificados de aeronavegabilidad y/o licencias que hayan sido objeto de alguna exención, han sido anotados/anotadas o se hayan agregado a éstos/éstas, una numeración completa de los detalles respecto a los cuales dejen de satisfacer la norma o normas relacionadas con la exención, de acuerdo con el Artículo 39 al Convenio sobre Aviación Civil Internacional."),
                            Linea("3. Verificar si la AAC del explotador extranjero ha solicitado la aceptación de la exención a la AAC y si esta exención ha sido aceptada, de conformidad con el Artículo 40 al Convenio sobre Aviación Civil Internacional."),
                            Linea("Nota. Si la exención no ha sido aceptada por la AAC, entonces el explotador extranjero cumplirá con los requisitos establecidos por la AAC.", "nota"))
                    },
                    new PdfRowDefinition
                    {
                        RequirementCode = "129-13",
                        ResponseIndices = Indices(0),
                        ShowCompliance = true,
                        ReferenceLines = Lineas(Linea("129.100 (b)"), Linea("(6)")),
                        QuestionLines = Lineas(Linea("129-13", "requirement-code"), Linea("¿Ha presentado el explotador extranjero una copia de su plan de seguridad de la aviación?")),
                        OrientationLines = Lineas(Linea("1. Verificar que el plan de seguridad de la aviación, por su calidad de restricto, haya sido presentado a las personas autorizadas en la AAC u organismo apropiado del Estado."))
                    },
                    new PdfRowDefinition
                    {
                        RequirementCode = "129-14",
                        ResponseIndices = Indices(0),
                        ShowCompliance = true,
                        ReferenceLines = Lineas(Linea("129.100 (b)"), Linea("(4)")),
                        QuestionLines = Lineas(
                            Linea("129-14", "requirement-code"),
                            Linea("¿Ha presentado el explotador extranjero una copia del documento que autoriza los derechos de tránsito específicos, expedidos")),
                        OrientationLines = Lineas(
                            Linea("1. Verificar que existe una autorización de derecho de tránsito expedida por la AAC y otro organismo nacional competente."),
                            Linea("Nota. De acuerdo con los reglamentos de cada Estado, es posible que la autorización de", "nota"))
                    }
                }
            },
            new PdfPageDefinition
            {
                FooterCode = "PII-VVII-C2-15",
                ShowClosingLine = true,
                Rows = new List<PdfRowDefinition>
                {
                    new PdfRowDefinition
                    {
                        RequirementCode = "129-14",
                        ShowImplementation = false,
                        QuestionLines = Lineas(Linea("por la autoridad del Estado en que pretende operar?")),
                        OrientationLines = Lineas(Linea("derecho de tránsito solamente sea emitida después de la evaluación técnica. En este caso, puede considerarse el ítem “no aplicable”, justificando en la Casilla 14.", "nota"))
                    }
                }
            }
        };
    }
}

@{
    Layout = null;

    var lista = Model != null ? Model.ListaVerificacion : null;
    var cultura = new CultureInfo("es-EC");
    var fechaLista = lista != null && lista.FechaLista.HasValue ? lista.FechaLista.Value.ToString("dd/MM/yyyy", cultura) : string.Empty;
    var cssPath = Server != null ? Server.MapPath("~/Content/pdf-eae-oficial.css") : null;
    var pdfCss = !string.IsNullOrWhiteSpace(cssPath) && File.Exists(cssPath)
        ? File.ReadAllText(cssPath)
        : string.Empty;
    var paginas = ObtenerPaginas();
    var respuestasPorCodigo = ConstruirMapaRespuestas(lista != null ? lista.Items : null);
    Func<string, string> texto = valor => !string.IsNullOrWhiteSpace(valor) ? valor.Trim() : string.Empty;
    var direccionReconocimiento = texto(lista != null ? lista.DireccionEstadoReconocimiento : null);
    if (string.Equals(direccionReconocimiento, "Direccion General de Aviacion Civil del Ecuador", StringComparison.OrdinalIgnoreCase)
        || string.Equals(direccionReconocimiento, "Dirección General de Aviación Civil del Ecuador", StringComparison.OrdinalIgnoreCase))
    {
        direccionReconocimiento = string.Empty;
    }
    Func<string, string, bool> estaMarcada = (actual, esperado) => string.Equals((actual ?? string.Empty).Trim(), esperado, StringComparison.OrdinalIgnoreCase);
}

<style>
@Html.Raw(pdfCss)
</style>

<div class="pdf-document">
@for (var indicePagina = 0; indicePagina < paginas.Count; indicePagina++)
{
    var pagina = paginas[indicePagina];
    <div class="pdf-page">
        <div class="pdf-eae-header">
            <table class="manual-top">
                <tr>
                    <td>Parte II - Explotadores de servicios aéreos<br />Volumen VII - Vigilancia de explotadores extranjeros en operaciones de transporte aéreo comercial</td>
                    <td class="manual-right">Capítulo 2 - Solicitud, evaluación y aprobación de un explotador extranjero<br />Manual del Inspector de Operaciones Ecuador</td>
                </tr>
            </table>
        </div>

        @if (pagina.ShowTitleBox)
        {
            <div class="title-box">
                <div>DIRECCIÓN GENERAL DE AVIACIÓN CIVIL</div>
                <div class="title-box-main">Evaluación técnica de un explotador de servicios aéreos extranjero (EAE)</div>
                <div class="title-box-rdac">RDAC 129</div>
            </div>
        }

        @if (pagina.ShowFields)
        {
            <table class="field-table">
                <tbody>
                    <tr><td class="field-row"><span class="field-label">1. Nombre del EAE / Nombre comercial del EAE:</span> <span class="field-value">@texto(lista != null ? lista.NombreEae : null)</span></td></tr>
                    <tr><td class="field-row"><span class="field-label">2. N° AOC / Fecha de expedición / Validez:</span> <span class="field-value">@texto(lista != null ? lista.NumeroAocFechaValidez : null)</span></td></tr>
                    <tr><td class="field-row"><span class="field-label">3. Dirección del EAE y datos de contacto de la gerencia de operaciones en el Estado del explotador:</span> <span class="field-value">@texto(lista != null ? lista.DireccionEstadoExplotador : null)</span></td></tr>
                    <tr><td class="field-row"><span class="field-label">4. Dirección del EAE y datos de contacto en el Estado que emite el reconocimiento:</span> <span class="field-value">@direccionReconocimiento</span></td></tr>
                    <tr><td class="field-row"><span class="field-label">5. Tipo/s de aeronave/s (marca, modelo, número de serie):</span> <span class="field-value">@texto(lista != null ? lista.TiposAeronaves : null)</span></td></tr>
                    <tr><td class="field-row"><span class="field-label">6. Tipo de operación:</span> <span class="field-value">@texto(lista != null ? lista.TipoOperacion : null)</span></td></tr>
                    <tr><td class="field-row"><span class="field-label">7. Fecha:</span> <span class="field-value">@fechaLista</span></td></tr>
                    <tr><td class="field-row"><span class="field-label">8. Inspector responsable de la aprobación:</span> <span class="field-value">@texto(lista != null ? lista.InspectorResponsable : null)</span></td></tr>
                </tbody>
            </table>
        }

        <table class="eae-table">
            <colgroup>
                <col class="col-ref" />
                <col class="col-pregunta" />
                <col class="col-cumplimiento" />
                <col class="col-orientacion" />
                <col class="col-implementacion" />
                <col class="col-comentarios" />
            </colgroup>
            @if (pagina.ShowTableHeader)
            {
                <thead>
                    <tr>
                        <th><span class="th-number">9.</span>Referencia</th>
                        <th><span class="th-number">10.</span>Pregunta del requisito</th>
                        <th><span class="th-number">11.</span>Estado de cumplimiento del requisito</th>
                        <th><span class="th-number">12.</span>Orientación para el examen de pruebas o evidencias</th>
                        <th><span class="th-number">13.</span>Estado de implementación</th>
                        <th><span class="th-number">14.</span>Pruebas / Notas/ Comentarios</th>
                    </tr>
                </thead>
            }
            <tbody>
            @foreach (var fila in pagina.Rows)
            {
                var estadoCumplimiento = fila.ShowCompliance ? ObtenerEstadoCumplimiento(respuestasPorCodigo, fila.RequirementCode) : string.Empty;
                var estadoImplementacion = fila.ShowImplementation ? ObtenerEstadoImplementacion(respuestasPorCodigo, fila.RequirementCode, fila.ResponseIndices) : string.Empty;
                <tr>
                    <td class="reference-cell">
                        @if (fila.ReferenceLines.Any())
                        {
                            foreach (var linea in fila.ReferenceLines)
                            {
                                <div class="@(string.IsNullOrWhiteSpace(linea.CssClass) ? null : linea.CssClass)">@linea.Text</div>
                            }
                        }
                        else
                        {
                            @Html.Raw("&nbsp;")
                        }
                    </td>
                    <td class="question-cell">
                        @if (fila.QuestionLines.Any())
                        {
                            foreach (var linea in fila.QuestionLines)
                            {
                                <div class="@(string.IsNullOrWhiteSpace(linea.CssClass) ? null : linea.CssClass)">@linea.Text</div>
                            }
                        }
                        else
                        {
                            @Html.Raw("&nbsp;")
                        }
                    </td>
                    <td>
                        @if (fila.ShowCompliance)
                        {
                            <div class="check-option"><span class="check-box">@(estaMarcada(estadoCumplimiento, "SATISFACTORIO") ? "X" : string.Empty)</span><span class="check-label">Satisfactorio</span></div>
                            <div class="check-option"><span class="check-box">@(estaMarcada(estadoCumplimiento, "NO_SATISFACTORIO") ? "X" : string.Empty)</span><span class="check-label">No satisfactorio</span></div>
                            <div class="check-option"><span class="check-box">@(estaMarcada(estadoCumplimiento, "NO_APLICABLE") ? "X" : string.Empty)</span><span class="check-label">No aplicable</span></div>
                        }
                        else
                        {
                            @Html.Raw("&nbsp;")
                        }
                    </td>
                    <td class="orientation-cell">
                        @if (fila.OrientationLines.Any())
                        {
                            foreach (var linea in fila.OrientationLines)
                            {
                                <div class="@(string.IsNullOrWhiteSpace(linea.CssClass) ? null : linea.CssClass)">@linea.Text</div>
                            }
                        }
                        else
                        {
                            @Html.Raw("&nbsp;")
                        }
                    </td>
                    <td>
                        @if (fila.ShowImplementation)
                        {
                            <div class="check-option"><span class="check-box">@(estaMarcada(estadoImplementacion, "IMPLEMENTADO") ? "X" : string.Empty)</span><span class="check-label">Implementado</span></div>
                            <div class="check-option"><span class="check-box">@(estaMarcada(estadoImplementacion, "NO_IMPLEMENTADO") ? "X" : string.Empty)</span><span class="check-label">No implementado</span></div>
                            <div class="check-option"><span class="check-box">@(estaMarcada(estadoImplementacion, "NO_APLICABLE") ? "X" : string.Empty)</span><span class="check-label">No aplicable</span></div>
                        }
                        else
                        {
                            @Html.Raw("&nbsp;")
                        }
                    </td>
                    <td class="comments-cell">@Html.Raw("&nbsp;")</td>
                </tr>
            }
            </tbody>
        </table>

        @if (pagina.ShowClosingLine)
        {
            <div class="signature-block">
                <div class="signature-title">FIRMA DEL TÉCNICO / INSPECTOR RESPONSABLE</div>
                <div class="signature-slot" data-firma-rol="LV_EAE_INSPECTOR">
                    <span class="firma-anchor">ANCLA_FIRMA_LV_EAE_INSPECTOR</span>
                    <span class="firma-anchor">ESPACIO RESERVADO PARA FIRMA DEL TECNICO</span>
                    ESPACIO RESERVADO PARA FIRMA DEL TECNICO
                </div>
                <table class="signature-data">
                    <tr>
                        <td class="signature-label">Nombre:</td>
                        <td class="signature-line">@texto(lista != null ? lista.InspectorResponsable : null)</td>
                    </tr>
                    <tr>
                        <td class="signature-label">Cargo:</td>
                        <td class="signature-line">@texto(lista != null ? lista.CargoInspector : null)</td>
                    </tr>
                    <tr>
                        <td class="signature-label">Fecha:</td>
                        <td class="signature-line">@(lista != null && lista.FechaFirma.HasValue ? lista.FechaFirma.Value.ToString("dd/MM/yyyy", cultura) : fechaLista)</td>
                    </tr>
                </table>
            </div>
            <div class="final-line">-----------------------</div>
        }

        <div class="eae-footer">
            <table>
                <tr>
                    <td class="left">31/12/2025</td>
                    <td class="center">@pagina.FooterCode</td>
                    <td class="right">Tercera Edición</td>
                </tr>
            </table>
        </div>
    </div>

    if (indicePagina < paginas.Count - 1)
    {
        <div class="page-break"></div>
    }
}
</div>