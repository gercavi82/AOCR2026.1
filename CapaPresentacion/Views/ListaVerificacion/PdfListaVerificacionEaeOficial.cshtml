    private static IList<int> Indices(params int[] indices)
    {
        return (indices ?? new int[0]).Distinct().ToList();
    }

    private static string ObtenerCodigoPregunta(ListaVerificacionOperacionalEaeItem item)
    {
        if (item == null)
        {
            return string.Empty;
        }

        if (!string.IsNullOrWhiteSpace(item.CodigoPregunta))
        {
            return item.CodigoPregunta.Trim();
        }

        var codigo = (item.Codigo ?? string.Empty).Trim();

        if (string.IsNullOrWhiteSpace(codigo))
        {
            return string.Empty;
        }

        var indiceUltimoGuion = codigo.LastIndexOf('-');
        if (indiceUltimoGuion > 0)
        {
            int sufijo;
            if (int.TryParse(codigo.Substring(indiceUltimoGuion + 1), out sufijo))
            {
                return codigo.Substring(0, indiceUltimoGuion).Trim();
            }
        }

        return codigo;
    }

    private static IDictionary<string, List<ListaVerificacionOperacionalEaeItem>> ConstruirMapaRespuestas(IEnumerable<ListaVerificacionOperacionalEaeItem> items)
    {
        return (items ?? Enumerable.Empty<ListaVerificacionOperacionalEaeItem>())
            .Where(item => item != null)
            .GroupBy(ObtenerCodigoPregunta, StringComparer.OrdinalIgnoreCase)
            .Where(group => !string.IsNullOrWhiteSpace(group.Key))
            .ToDictionary(group => group.Key, group => group.OrderBy(item => item.Orden).ToList(), StringComparer.OrdinalIgnoreCase);
    }

    private static string ObtenerEstadoCumplimiento(IDictionary<string, List<ListaVerificacionOperacionalEaeItem>> respuestasPorCodigo, string codigoPregunta)
    {
        List<ListaVerificacionOperacionalEaeItem> respuestas;
        if (respuestasPorCodigo == null
            || string.IsNullOrWhiteSpace(codigoPregunta)
            || !respuestasPorCodigo.TryGetValue(codigoPregunta, out respuestas)
            || respuestas == null)
        {
            return string.Empty;
        }

        return respuestas
            .Select(item => (item.EstadoCumplimiento ?? string.Empty).Trim())
            .FirstOrDefault(valor => !string.IsNullOrWhiteSpace(valor)) ?? string.Empty;
    }

    private static string ObtenerEstadoImplementacion(IDictionary<string, List<ListaVerificacionOperacionalEaeItem>> respuestasPorCodigo, string codigoPregunta, IEnumerable<int> indicesPreferidos)
    {
        List<ListaVerificacionOperacionalEaeItem> respuestas;
        if (respuestasPorCodigo == null
            || string.IsNullOrWhiteSpace(codigoPregunta)
            || !respuestasPorCodigo.TryGetValue(codigoPregunta, out respuestas)
            || respuestas == null
            || respuestas.Count == 0)
        {
            return string.Empty;
        }

        foreach (var indicePreferido in (indicesPreferidos ?? Enumerable.Empty<int>()).Where(indice => indice >= 0).Distinct())
        {
            if (indicePreferido >= respuestas.Count)
            {
                continue;
            }

            var valorPreferido = (respuestas[indicePreferido].EstadoImplementacion ?? string.Empty).Trim();
            if (!string.IsNullOrWhiteSpace(valorPreferido))
            {
                return valorPreferido;
            }
        }

        return respuestas
            .Select(item => (item.EstadoImplementacion ?? string.Empty).Trim())
            .FirstOrDefault(valor => !string.IsNullOrWhiteSpace(valor)) ?? string.Empty;
    }

