@inherits System.Web.Mvc.WebViewPage<CapaPresentacion.Models.RT.GestionCompaniasRTViewModel>
@using System.Web.Mvc
@using System.Web.Mvc.Html
@{
    ViewBag.Title = "Gestionar Companias RT";
}

<div class="container-fluid">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0"><i class="fas fa-building me-2"></i>Gestionar Companias RT</h5>
        </div>
        <div class="card-body">
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger">
                    @Html.ValidationSummary(false, "", new { @class = "mb-0" })
                </div>
            }

            <div class="mb-3">
                <div><strong>Usuario:</strong> @Html.Encode(Model.NombreUsuario) (@Html.Encode(Model.CodigoUsuario))</div>
                <div><strong>Correo:</strong> @Html.Encode(Model.Correo)</div>
                <div><strong>Estado RT:</strong> @Html.Encode(Model.EstadoDesignacionRt)</div>
            </div>

            @using (Html.BeginForm("GestionarCompaniasRT", "Usuario", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.UsuarioId)
                @Html.HiddenFor(m => m.NombreUsuario)
                @Html.HiddenFor(m => m.Correo)
                @Html.HiddenFor(m => m.CodigoUsuario)
                @Html.HiddenFor(m => m.EstadoDesignacionRt)

                <div class="mb-3">
                    <label class="form-label fw-bold">Companias asignadas</label>
                    <div class="d-flex flex-wrap gap-2 mb-2">
                        <button type="button" class="btn btn-sm btn-outline-primary" id="btnSeleccionarTodasCompanias">Seleccionar todas</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" id="btnLimpiarCompanias">Limpiar</button>
                        <span class="small text-muted align-self-center" id="companiaSeleccionCount"></span>
                    </div>
                    <select class="form-select" name="CompaniasSeleccionadas" multiple size="12" required>
                        @if (Model.CatalogoCompanias != null)
                        {
                            foreach (var item in Model.CatalogoCompanias)
                            {
                                var selected = item.Selected ? "selected" : string.Empty;
                                <option value="@item.Value" @selected>[@item.Value] @item.Text</option>
                            }
                        }
                    </select>
                    <small class="text-muted">Puede seleccionar varias companias con clic simple (sin Ctrl).</small>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-success">
                        <i class="fas fa-save me-1"></i> Guardar Companias
                    </button>
                    <a href="@Url.Action("RevisarDesignaciones", "Usuario")" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left me-1"></i> Volver
                    </a>
                </div>
            }
        </div>
    </div>
</div>

<script>
    (function () {
        var select = document.querySelector('select[name="CompaniasSeleccionadas"]');
        var btnTodas = document.getElementById('btnSeleccionarTodasCompanias');
        var btnLimpiar = document.getElementById('btnLimpiarCompanias');
        var counter = document.getElementById('companiaSeleccionCount');

        if (!select) {
            return;
        }

        function actualizarContador() {
            if (!counter) {
                return;
            }

            var total = select.options.length;
            var seleccionadas = Array.prototype.filter.call(select.options, function (o) { return o.selected; }).length;
            counter.textContent = seleccionadas + ' seleccionada(s) de ' + total;
        }

        // Seleccion multiple por clic simple.
        select.addEventListener('mousedown', function (e) {
            var option = e.target;
            if (!option || option.tagName !== 'OPTION') {
                return;
            }

            e.preventDefault();
            option.selected = !option.selected;
            actualizarContador();
        });

        if (btnTodas) {
            btnTodas.addEventListener('click', function () {
                Array.prototype.forEach.call(select.options, function (o) { o.selected = true; });
                actualizarContador();
            });
        }

        if (btnLimpiar) {
            btnLimpiar.addEventListener('click', function () {
                Array.prototype.forEach.call(select.options, function (o) { o.selected = false; });
                actualizarContador();
            });
        }

        actualizarContador();
    })();
</script>
