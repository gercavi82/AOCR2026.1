@inherits System.Web.Mvc.WebViewPage<List<CapaModelo.Usuario>>
@using System.Linq
@using System.Web.Mvc
@using System.Web.Mvc.Html
@using CapaDatos.Models
@{
    ViewBag.Title = "Gestión de Usuarios RT";

    var totalRt = Model != null ? Model.Count : 0;
    var activos = Model != null ? Model.Count(u => u != null && u.Activo) : 0;
    var pendientes = Model != null ? Model.Count(u => u != null
        && ((u.EstadoSolicitudRT ?? "").Trim().ToUpperInvariant() == "ENVIADO"
            || (u.EstadoSolicitudRT ?? "").Trim().ToUpperInvariant() == "ENVIADA"
            || string.IsNullOrWhiteSpace(u.EstadoSolicitudRT))) : 0;
    var sinDocumento = Model != null ? Model.Count(u => u != null
        && string.IsNullOrWhiteSpace(u.RutaDocumentoLegal)) : 0;
    var enRevisionKpi = Model != null ? Model.Count(u => u != null
        && (u.EstadoSolicitudRT ?? "").Trim().ToUpperInvariant() == "EN_REVISION_COORDINADOR") : 0;
    var puedeEliminarUsuarios = User != null && User.IsInRole("Administrador");
}

<div class="aocr-rt-users-page rt-users-shell" data-module="rt-users-admin">

    @* ══════ HEADER ══════ *@
    <section class="rt-page-header">
        <h1><i class="fas fa-user-tie" style="margin-right:8px;color:#1d65d8;"></i>Gestión de Usuarios RT</h1>
        <p>Revise usuarios solicitantes, compañías asignadas, documentos y estados de aprobación.</p>
        <div class="rt-breadcrumb">
            <a href="@Url.Action("Index", "AdminUsuarios")">Administración</a>
            <i class="fas fa-chevron-right"></i>
            <a href="@Url.Action("Index", "AdminUsuarios", new { tab = "usuarios" })">Usuarios y Roles</a>
            <i class="fas fa-chevron-right"></i>
            <span>Usuarios RT</span>
        </div>
    </section>

    @* ══════ FLASH MESSAGES ══════ *@
    @if (TempData["msg"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rt-flash">
            <i class="fas fa-check-circle mr-1"></i> @TempData["msg"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }
    @if (TempData["error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rt-flash">
            <i class="fas fa-exclamation-circle mr-1"></i> @TempData["error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="rt-empty">
            <i class="fas fa-user-clock"></i>
            No hay usuarios RT registrados para revisión.
        </div>
    }
    else
    {
        @* ══════ KPI CARDS ══════ *@
        <div class="rt-kpi-grid">
            <div class="rt-kpi-card">
                <div class="rt-kpi-icon rt-kpi-icon--blue"><i class="fas fa-users"></i></div>
                <div class="rt-kpi-info">
                    <h3>Usuarios RT</h3>
                    <div class="rt-kpi-value">@totalRt</div>
                    <div class="rt-kpi-sub rt-kpi-sub--teal">Total registrados</div>
                </div>
            </div>
            <div class="rt-kpi-card">
                <div class="rt-kpi-icon rt-kpi-icon--teal"><i class="fas fa-user-check"></i></div>
                <div class="rt-kpi-info">
                    <h3>Activos</h3>
                    <div class="rt-kpi-value">@activos</div>
                    <div class="rt-kpi-sub rt-kpi-sub--teal">Habilitados</div>
                </div>
            </div>
            <div class="rt-kpi-card">
                <div class="rt-kpi-icon rt-kpi-icon--amber"><i class="fas fa-hourglass-half"></i></div>
                <div class="rt-kpi-info">
                    <h3>Pendientes</h3>
                    <div class="rt-kpi-value">@pendientes</div>
                    <div class="rt-kpi-sub rt-kpi-sub--amber">Requieren revisión</div>
                </div>
            </div>
            <div class="rt-kpi-card">
                <div class="rt-kpi-icon rt-kpi-icon--purple"><i class="fas fa-file-alt"></i></div>
                <div class="rt-kpi-info">
                    <h3>Sin documento</h3>
                    <div class="rt-kpi-value">@sinDocumento</div>
                    <div class="rt-kpi-sub" style="color:#7c3aed;">Sin designación</div>
                </div>
            </div>
            <div class="rt-kpi-card">
                <div class="rt-kpi-icon rt-kpi-icon--red"><i class="fas fa-undo"></i></div>
                <div class="rt-kpi-info">
                    <h3>En revisión</h3>
                    <div class="rt-kpi-value">@enRevisionKpi</div>
                    <div class="rt-kpi-sub rt-kpi-sub--red">Validación coordinador</div>
                </div>
            </div>
        </div>

        @* ══════ FILTERS ══════ *@
        <div class="rt-filter-card">
            <div class="rt-filter-grid">
                <div>
                    <label>Buscar</label>
                    <input type="text" id="rtFiltroBuscar" class="form-control" placeholder="Nombre, correo o código" />
                </div>
                <div>
                    <label>Estado RT</label>
                    <select id="rtFiltroEstado" class="form-select">
                        <option value="">Todos</option>
                        <option value="EN_REVISION_COORDINADOR">En revisión</option>
                        <option value="FINALIZADO">Finalizado</option>
                        <option value="APROBADO">Aprobado</option>
                        <option value="DEVUELTO_CON_OBSERVACIONES">Devuelto</option>
                    </select>
                </div>
                <div>
                    <label>Estado cuenta</label>
                    <select id="rtFiltroCuenta" class="form-select">
                        <option value="">Todos</option>
                        <option value="ACTIVO">Activo</option>
                        <option value="INACTIVO">Inactivo</option>
                    </select>
                </div>
                <div>
                    <label>Empresa</label>
                    <input type="text" id="rtFiltroEmpresa" class="form-control" placeholder="Código" />
                </div>
                <div>
                    <label>Documento</label>
                    <select id="rtFiltroDocumento" class="form-select">
                        <option value="">Todos</option>
                        <option value="CON_DOCUMENTO">Con documento</option>
                        <option value="SIN_DOCUMENTO">Sin documento</option>
                    </select>
                </div>
                <div>
                    <label>Fecha desde</label>
                    <input type="date" id="rtFiltroFechaDesde" class="form-control" />
                </div>
                <div>
                    <label>Fecha hasta</label>
                    <input type="date" id="rtFiltroFechaHasta" class="form-control" />
                </div>
                <div>
                    <label>&nbsp;</label>
                    <button type="button" class="btn btn-primary rt-filter-btn w-100" id="rtAplicarFiltros">
                        <i class="fas fa-search"></i> Filtrar
                    </button>
                </div>
                <div>
                    <label>&nbsp;</label>
                    <button type="button" class="btn btn-outline-secondary rt-filter-btn w-100" id="rtLimpiarFiltros">
                        <i class="fas fa-times"></i> Limpiar
                    </button>
                </div>
            </div>
        </div>

        @* ══════ TABLE ══════ *@
        <div class="rt-table-card">
            <div class="rt-table-card-header">
                <h2><i class="fas fa-list" style="margin-right:8px;color:#1d65d8;"></i>Lista de Usuarios RT</h2>
            </div>

            <div style="overflow-x:auto;">
                <table class="rt-table" id="tablaUsuariosRT">
                    <thead>
                        <tr>
                            <th>Usuario</th>
                            <th>Correo</th>
                            <th>Empresa</th>
                            <th>Compañías RT</th>
                            <th>Estado RT</th>
                            <th>Estado cuenta</th>
                            <th>Documento</th>
                            <th style="text-align:right;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var u in Model)
                        {
                            var estadoRt = (u.EstadoDesignacionRT ?? "pendiente").Trim().ToLowerInvariant();
                            var estadoExpedienteRt = (u.EstadoSolicitudRT ?? string.Empty).Trim().ToUpperInvariant();
                            if (string.IsNullOrWhiteSpace(estadoExpedienteRt))
                            {
                                if (estadoRt == "aceptado") { estadoExpedienteRt = "FINALIZADO"; }
                                else if (estadoRt == "rechazado") { estadoExpedienteRt = "DEVUELTO_CON_OBSERVACIONES"; }
                                else { estadoExpedienteRt = "EN_REVISION_COORDINADOR"; }
                            }

                            var observacionRt = (u.ObservacionSolicitudRT ?? string.Empty).Trim();
                            var esInspector = ViewBag.EsInspector != null && (bool)ViewBag.EsInspector;
                            var enRevision = (estadoExpedienteRt == "EN_REVISION_COORDINADOR"
                                    || estadoExpedienteRt == "ENVIADO"
                                    || estadoExpedienteRt == "ENVIADA");
                                var puedeGestionarDesignacion = !esInspector && enRevision;
                            var puedeEliminar = u.PuedeEliminarRT;
                            if (string.IsNullOrWhiteSpace(estadoRt)) { estadoRt = "pendiente"; }

                            var claseEstadoRt = "rt-badge rt-badge--pending";
                            if (estadoExpedienteRt == "EN_REVISION_COORDINADOR" || estadoExpedienteRt == "ENVIADO" || estadoExpedienteRt == "ENVIADA")
                            { claseEstadoRt = "rt-badge rt-badge--review"; }
                            else if (estadoExpedienteRt == "FINALIZADO" || estadoExpedienteRt == "APROBADO" || estadoExpedienteRt == "FIRMADO")
                            { claseEstadoRt = "rt-badge rt-badge--finished"; }
                            else if (estadoExpedienteRt == "DEVUELTO_CON_OBSERVACIONES")
                            { claseEstadoRt = "rt-badge rt-badge--returned"; }

                            var ini = "";
                            if (!string.IsNullOrWhiteSpace(u.NombreCompleto)) { ini += u.NombreCompleto.Trim()[0]; }
                            if (!string.IsNullOrWhiteSpace(u.ApellidoUsuario)) { ini += u.ApellidoUsuario.Trim()[0]; }
                            if (string.IsNullOrWhiteSpace(ini) && !string.IsNullOrWhiteSpace(u.CodigoUsuario)) { ini = u.CodigoUsuario.Trim().Substring(0, Math.Min(2, u.CodigoUsuario.Trim().Length)); }
                            ini = ini.ToUpperInvariant();

                            <tr data-estado-rt="@estadoExpedienteRt"
                                data-estado-cuenta="@(u.Activo ? "ACTIVO" : "INACTIVO")"
                                data-empresa="@(u.EmpresaCodigo ?? "")"
                                data-documento="@(!string.IsNullOrWhiteSpace(u.RutaDocumentoLegal) ? "CON_DOCUMENTO" : "SIN_DOCUMENTO")"
                                data-fecha="@(u.FechaCreacion.HasValue ? u.FechaCreacion.Value.ToString("yyyy-MM-dd") : "")"
                                data-buscar="@(string.Format("{0} {1} {2} {3} {4} {5}", u.NombreCompleto, u.NombreUsuario, u.CodigoUsuario, u.Ruc, u.Email, u.EmpresaCodigo).ToLowerInvariant())">
                                <td>
                                    <div class="rt-user-cell">
                                        <div class="rt-user-avatar">@ini</div>
                                        <div>
                                            <div class="rt-user-name">@Html.Encode(u.NombreCompleto)</div>
                                            <div class="rt-user-code">@Html.Encode(u.CodigoUsuario)</div>
                                        </div>
                                    </div>
                                </td>
                                <td style="font-size:12px;color:#475569;max-width:180px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="@Html.Encode(u.Email)">
                                    @Html.Encode(u.Email)
                                </td>
                                <td>
                                    <span class="rt-badge rt-badge--review">@Html.Encode(u.EmpresaCodigo)</span>
                                </td>
                                <td>
                                    <a class="rt-action-btn"
                                       href="@Url.Action("GestionarCompaniasRT", "Usuario", new { id = u.Id })"
                                       title="Gestionar compañías asignadas">
                                        <i class="fas fa-building"></i> Gestionar
                                    </a>
                                </td>
                                <td>
                                    <span class="@claseEstadoRt">@Html.Encode(estadoExpedienteRt.Replace("_", " "))</span>
                                    <span class="rt-legacy-text">Legacy: @Html.Encode(estadoRt.ToUpperInvariant())</span>
                                    @if (!string.IsNullOrWhiteSpace(observacionRt))
                                    {
                                        <span class="rt-obs-text" title="@Html.Encode(observacionRt)">Obs.: @Html.Encode(observacionRt)</span>
                                    }
                                </td>
                                <td>
                                    @if (u.Activo)
                                    {
                                        <span class="rt-badge rt-badge--active">ACTIVO</span>
                                    }
                                    else
                                    {
                                        <span class="rt-badge rt-badge--inactive">INACTIVO</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(u.RutaDocumentoLegal))
                                    {
                                        <a class="rt-doc-btn rt-doc-btn--pdf" href="@Url.Action("DescargarDesignacionRT", "Usuario", new { id = u.Id })" title="Descargar designación PDF">
                                            <i class="fas fa-file-pdf"></i> Ver PDF
                                        </a>
                                        if (!string.IsNullOrWhiteSpace(u.RutaConstanciaRT))
                                        {
                                            <a class="rt-doc-btn rt-doc-btn--const" href="@Url.Action("DescargarConstanciaRT", "Usuario", new { id = u.Id })" title="Descargar constancia" style="margin-top:3px;">
                                                <i class="fas fa-file-signature"></i> Constancia
                                            </a>
                                        }
                                    }
                                    else
                                    {
                                        <span class="rt-doc-none">Sin documento</span>
                                    }
                                </td>
                                <td>
                                    <div class="rt-actions">
                                        @if (enRevision)
                                        {
                                            if (puedeGestionarDesignacion)
                                            {
                                            <button type="button"
                                                    class="rt-action-btn rt-action-btn--approve"
                                                    title="Aprobar designación RT"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#modalAprobarRt"
                                                    data-usuario-id="@u.Id"
                                                    data-usuario-nombre="@Html.Encode(u.NombreCompleto)"
                                                    data-usuario-empresa="@Html.Encode(u.EmpresaCodigo)"
                                                    data-usuario-estado="@Html.Encode(estadoExpedienteRt.Replace("_", " "))">
                                                <i class="fas fa-check"></i>
                                            </button>
                                            }

                                            if (puedeGestionarDesignacion)
                                            {
                                            <button type="button"
                                                    class="rt-action-btn rt-action-btn--return"
                                                    title="Devolver con observación"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#modalDevolverRt"
                                                    data-usuario-id="@u.Id"
                                                    data-usuario-nombre="@Html.Encode(u.NombreCompleto)"
                                                    data-usuario-empresa="@Html.Encode(u.EmpresaCodigo)">
                                                <i class="fas fa-undo"></i>
                                            </button>
                                            }
                                        }

                                        @if (u.Activo)
                                        {
                                            using (Html.BeginForm("InactivarUsuarioRT", "Usuario", FormMethod.Post, new { @class = "d-inline", data_confirm = "¿Desea inactivar este usuario?" }))
                                            {
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@u.Id" />
                                                <button type="submit" class="rt-action-btn rt-action-btn--muted" title="Inactivar usuario">
                                                    <i class="fas fa-user-slash"></i>
                                                </button>
                                            }
                                        }
                                        else
                                        {
                                            using (Html.BeginForm("ActivarUsuarioRT", "Usuario", FormMethod.Post, new { @class = "d-inline", data_confirm = "¿Desea activar este usuario?" }))
                                            {
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@u.Id" />
                                                <button type="submit" class="rt-action-btn" title="Activar usuario" style="color:#0891b2;">
                                                    <i class="fas fa-user-check"></i>
                                                </button>
                                            }
                                        }

                                        if (puedeEliminarUsuarios)
                                        {
                                        <button type="button"
                                                class="rt-action-btn rt-action-btn--danger"
                                                title="@(puedeEliminar ? "Eliminar usuario" : "No se puede eliminar (tiene información relacionada)")"
                                                @(puedeEliminar ? "" : "disabled")
                                                data-bs-toggle="modal"
                                                data-bs-target="#modalEliminarRt"
                                                data-usuario-id="@u.Id"
                                                data-usuario-nombre="@Html.Encode(u.NombreCompleto)"
                                                data-puede-eliminar="@(puedeEliminar ? "true" : "false")">
                                            <i class="fas fa-trash-alt"></i>
                                        </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="rt-pagination">
                <div class="rt-pagination-info">
                    Mostrando <strong id="rtPaginaInfo">0</strong> de <strong>@totalRt</strong> usuarios
                </div>
                <div class="rt-pagination-nav" id="rtPaginacion"></div>
            </div>
        </div>

        @* ══════ LEGEND ══════ *@
        <div class="rt-legend-card">
            <h3><i class="fas fa-info-circle" style="margin-right:6px;color:#1d65d8;"></i>Leyenda de estados</h3>
            <div class="rt-legend-grid">
                <div class="rt-legend-item">
                    <span class="rt-badge rt-badge--active">ACTIVO</span>
                    <span>Usuario habilitado</span>
                </div>
                <div class="rt-legend-item">
                    <span class="rt-badge rt-badge--pending">PENDIENTE</span>
                    <span>Sin revisar</span>
                </div>
                <div class="rt-legend-item">
                    <span class="rt-badge rt-badge--review">EN REVISIÓN</span>
                    <span>Pendiente de validación</span>
                </div>
                <div class="rt-legend-item">
                    <span class="rt-badge rt-badge--finished">FINALIZADO</span>
                    <span>Revisión completada</span>
                </div>
                <div class="rt-legend-item">
                    <span class="rt-badge rt-badge--returned">DEVUELTO</span>
                    <span>Requiere correcciones</span>
                </div>
            </div>
        </div>
    }
</div>

@* ══════ MODAL: Aprobar RT ══════ *@
<div class="modal fade" id="modalAprobarRt" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content" style="border-radius:14px;overflow:hidden;">
            <div class="modal-header" style="background:#f0fdf4;border-bottom:1px solid #bbf7d0;padding:12px 16px;">
                <h5 class="modal-title" style="font-size:15px;font-weight:800;color:#15803d;">
                    <i class="fas fa-check-circle mr-2"></i> Aprobar designación RT
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body" style="padding:16px;">
                <p style="font-size:14px;margin-bottom:12px;">¿Está seguro de aprobar la designación RT del usuario?</p>
                <div style="background:#f8fbfd;border-radius:10px;padding:12px;border:1px solid #e2e8f0;">
                    <div style="font-size:13px;margin-bottom:4px;"><strong>Usuario:</strong> <span id="modalAprobarNombre"></span></div>
                    <div style="font-size:13px;"><strong>Empresa:</strong> <span id="modalAprobarEmpresa"></span></div>
                </div>
            </div>
            <div class="modal-footer" style="padding:10px 16px;border-top:1px solid #e2e8f0;">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancelar</button>
                @using (Html.BeginForm("AceptarDesignacion", "Usuario", FormMethod.Post, new { @class = "d-inline" }))
                {
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="modalAprobarId" value="" />
                    <button type="submit" class="btn btn-success btn-sm">
                        <i class="fas fa-check mr-1"></i> Aprobar
                    </button>
                }
            </div>
        </div>
    </div>
</div>

@* ══════ MODAL: Devolver RT ══════ *@
<div class="modal fade" id="modalDevolverRt" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content" style="border-radius:14px;overflow:hidden;">
            <div class="modal-header" style="background:#fffbeb;border-bottom:1px solid #fde68a;padding:12px 16px;">
                <h5 class="modal-title" style="font-size:15px;font-weight:800;color:#92400e;">
                    <i class="fas fa-undo mr-2"></i> Devolver solicitud RT
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body" style="padding:16px;">
                <p style="font-size:14px;margin-bottom:12px;">Se devolverá la solicitud del usuario con las siguientes observaciones:</p>
                <div style="background:#f8fbfd;border-radius:10px;padding:12px;border:1px solid #e2e8f0;margin-bottom:14px;">
                    <div style="font-size:13px;margin-bottom:4px;"><strong>Usuario:</strong> <span id="modalDevolverNombre"></span></div>
                    <div style="font-size:13px;margin-bottom:4px;"><strong>Empresa:</strong> <span id="modalDevolverEmpresa"></span></div>
                    <div style="font-size:13px;"><strong>Estado actual:</strong> <span id="modalDevolverEstado"></span></div>
                </div>
                @using (Html.BeginForm("RechazarDesignacion", "Usuario", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="modalDevolverId" value="" />
                    <label for="ObservacionDevolucion" style="font-size:13px;font-weight:700;color:#334155;display:block;margin-bottom:6px;">
                        Observación de devolución <span class="text-danger">*</span>
                    </label>
                    <textarea name="observacion"
                              id="ObservacionDevolucion"
                              class="form-control"
                              rows="4"
                              maxlength="2000"
                              required
                              placeholder="Ingrese la observación para devolver la solicitud RT..."
                              style="border-radius:8px;font-size:13px;"></textarea>
                    <div style="font-size:11px;color:#94a3b8;margin-top:4px;">Máximo 2000 caracteres. Obligatorio.</div>
                    <div class="modal-footer" style="padding:10px 0 0;border-top:1px solid #e2e8f0;margin-top:14px;">
                        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-warning btn-sm" id="btnConfirmarDevolucion">
                            <i class="fas fa-undo mr-1"></i> Confirmar devolución
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@* ══════ MODAL: Eliminar RT ══════ *@
@if (puedeEliminarUsuarios)
{
<div class="modal fade" id="modalEliminarRt" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content border-danger" style="border-radius:14px;overflow:hidden;">
            <div class="modal-header bg-danger text-white" style="padding:12px 16px;">
                <h5 class="modal-title" style="font-size:15px;font-weight:800;">
                    <i class="fas fa-exclamation-triangle mr-2"></i> Eliminar usuario RT
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body" style="padding:16px;">
                <div class="alert alert-danger mb-3" style="border-radius:10px;font-size:13px;">
                    <strong>ATENCIÓN:</strong> Esta acción eliminará permanentemente al usuario y todos sus datos asociados.
                </div>
                <div style="font-size:13px;margin-bottom:8px;"><strong>Usuario:</strong> <span id="modalEliminarNombre"></span></div>
                <div id="modalEliminarNoDisponible" style="display:none;">
                    <div class="alert alert-warning" style="border-radius:10px;font-size:13px;">
                        Este usuario tiene información relacionada y no puede ser eliminado. Use la opción de inactivar.
                    </div>
                </div>
            </div>
            <div class="modal-footer" style="padding:10px 16px;">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancelar</button>
                @using (Html.BeginForm("EliminarUsuarioRT", "Usuario", FormMethod.Post, new { @class = "d-inline" }))
                {
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="modalEliminarId" value="" />
                    <button type="submit" class="btn btn-danger btn-sm" id="btnConfirmarEliminar">
                        <i class="fas fa-trash-alt mr-1"></i> Eliminar
                    </button>
                }
            </div>
        </div>
    </div>
</div>
}

@section Styles {
    <link rel="stylesheet" href="@Url.Content("~/Content/css/rt-users-admin.css")?v=20260728" />
}

@section Scripts {
    <script>
    (function () {
        'use strict';
        var moduleRoot = document.querySelector('[data-module="rt-users-admin"]');
        if (!moduleRoot) return;

        /* ── Pagination (10 per page) ── */
        var PAGE_SIZE = 10;
        var tbody = document.querySelector('#tablaUsuariosRT tbody');
        var paginationContainer = document.getElementById('rtPaginacion');
        var infoEl = document.getElementById('rtPaginaInfo');
        var allRows = tbody ? Array.prototype.slice.call(tbody.querySelectorAll('tr')) : [];
        var filteredRows = allRows.slice();
        var currentPage = 1;

        function renderPage() {
            var totalPages = Math.ceil(filteredRows.length / PAGE_SIZE);
            if (currentPage > totalPages) currentPage = totalPages || 1;
            var start = (currentPage - 1) * PAGE_SIZE;
            var end = start + PAGE_SIZE;

            allRows.forEach(function (r) { r.style.display = 'none'; });
            filteredRows.forEach(function (r, i) {
                r.style.display = (i >= start && i < end) ? '' : 'none';
            });

            if (infoEl) {
                var shown = Math.min(end, filteredRows.length) - start;
                if (filteredRows.length === 0) shown = 0;
                infoEl.textContent = filteredRows.length === 0
                    ? '0 de 0'
                    : (start + 1) + '–' + Math.min(end, filteredRows.length) + ' de ' + filteredRows.length;
            }

            renderPagination(totalPages);
        }

        function renderPagination(totalPages) {
            if (!paginationContainer) return;
            paginationContainer.innerHTML = '';
            if (totalPages <= 1) return;

            var prev = document.createElement('button');
            prev.type = 'button';
            prev.className = 'rt-pagination-btn';
            prev.innerHTML = '<i class="fas fa-chevron-left"></i>';
            prev.disabled = currentPage === 1;
            prev.addEventListener('click', function () { currentPage--; renderPage(); });
            paginationContainer.appendChild(prev);

            for (var i = 1; i <= totalPages; i++) {
                var pgBtn = document.createElement('button');
                pgBtn.type = 'button';
                pgBtn.className = 'rt-pagination-btn' + (i === currentPage ? ' active' : '');
                pgBtn.textContent = i;
                (function (p) { pgBtn.addEventListener('click', function () { currentPage = p; renderPage(); }); })(i);
                paginationContainer.appendChild(pgBtn);
            }

            var next = document.createElement('button');
            next.type = 'button';
            next.className = 'rt-pagination-btn';
            next.innerHTML = '<i class="fas fa-chevron-right"></i>';
            next.disabled = currentPage === totalPages;
            next.addEventListener('click', function () { currentPage++; renderPage(); });
            paginationContainer.appendChild(next);
        }

        /* ── Filters ── */
        function aplicarFiltros() {
            var busqueda = (document.getElementById('rtFiltroBuscar').value || '').toLowerCase().trim();
            var estado = (document.getElementById('rtFiltroEstado').value || '').trim().toUpperCase();
            var cuenta = (document.getElementById('rtFiltroCuenta').value || '').trim().toUpperCase();
            var empresa = (document.getElementById('rtFiltroEmpresa').value || '').trim().toUpperCase();
            var documento = (document.getElementById('rtFiltroDocumento').value || '').trim().toUpperCase();
            var fechaDesde = (document.getElementById('rtFiltroFechaDesde').value || '').trim();
            var fechaHasta = (document.getElementById('rtFiltroFechaHasta').value || '').trim();

            filteredRows = allRows.filter(function (row) {
                var matchBusqueda = !busqueda || (row.getAttribute('data-buscar') || '').indexOf(busqueda) !== -1;
                var matchEstado = !estado || (row.getAttribute('data-estado-rt') || '') === estado;
                var matchCuenta = !cuenta || (row.getAttribute('data-estado-cuenta') || '') === cuenta;
                var matchEmpresa = !empresa || (row.getAttribute('data-empresa') || '').toUpperCase().indexOf(empresa) !== -1;
                var matchDocumento = !documento || (row.getAttribute('data-documento') || '') === documento;
                var fecha = row.getAttribute('data-fecha') || '';
                var matchFechaDesde = !fechaDesde || (fecha && fecha >= fechaDesde);
                var matchFechaHasta = !fechaHasta || (fecha && fecha <= fechaHasta);
                return matchBusqueda && matchEstado && matchCuenta && matchEmpresa
                    && matchDocumento && matchFechaDesde && matchFechaHasta;
            });

            currentPage = 1;
            renderPage();
        }

        function limpiarFiltros() {
            document.getElementById('rtFiltroBuscar').value = '';
            document.getElementById('rtFiltroEstado').value = '';
            document.getElementById('rtFiltroCuenta').value = '';
            document.getElementById('rtFiltroEmpresa').value = '';
            document.getElementById('rtFiltroDocumento').value = '';
            document.getElementById('rtFiltroFechaDesde').value = '';
            document.getElementById('rtFiltroFechaHasta').value = '';
            filteredRows = allRows.slice();
            currentPage = 1;
            renderPage();
        }

        var btnAplicarFiltros = document.getElementById('rtAplicarFiltros');
        var btnLimpiarFiltros = document.getElementById('rtLimpiarFiltros');
        if (btnAplicarFiltros) btnAplicarFiltros.addEventListener('click', aplicarFiltros);
        if (btnLimpiarFiltros) btnLimpiarFiltros.addEventListener('click', limpiarFiltros);

        /* ── Approve modal ── */
        var modalAprobar = document.getElementById('modalAprobarRt');
        if (modalAprobar) {
            modalAprobar.addEventListener('show.bs.modal', function (e) {
                var btn = e.target.querySelector('[data-usuario-id]') || e.relatedTarget;
                var trigger = e.target.querySelector('.modal-body');
                var idEl = document.getElementById('modalAprobarId');
                var nombreEl = document.getElementById('modalAprobarNombre');
                var empresaEl = document.getElementById('modalAprobarEmpresa');

                var src = e.relatedTarget;
                if (idEl) idEl.value = src.getAttribute('data-usuario-id') || '';
                if (nombreEl) nombreEl.textContent = src.getAttribute('data-usuario-nombre') || '';
                if (empresaEl) empresaEl.textContent = src.getAttribute('data-usuario-empresa') || '';
            });
        }

        /* ── Return modal ── */
        var modalDevolver = document.getElementById('modalDevolverRt');
        if (modalDevolver) {
            modalDevolver.addEventListener('show.bs.modal', function (e) {
                var src = e.relatedTarget;
                var idEl = document.getElementById('modalDevolverId');
                var nombreEl = document.getElementById('modalDevolverNombre');
                var empresaEl = document.getElementById('modalDevolverEmpresa');
                var estadoEl = document.getElementById('modalDevolverEstado');
                var obsEl = document.getElementById('ObservacionDevolucion');
                var btnConfirm = document.getElementById('btnConfirmarDevolucion');

                if (idEl) idEl.value = src.getAttribute('data-usuario-id') || '';
                if (nombreEl) nombreEl.textContent = src.getAttribute('data-usuario-nombre') || '';
                if (empresaEl) empresaEl.textContent = src.getAttribute('data-usuario-empresa') || '';
                if (estadoEl) estadoEl.textContent = src.getAttribute('data-usuario-estado') || '';
                if (obsEl) obsEl.value = '';
                if (btnConfirm) btnConfirm.disabled = false;
            });

            var obsTextarea = document.getElementById('ObservacionDevolucion');
            var btnConfirm = document.getElementById('btnConfirmarDevolucion');
            if (obsTextarea && btnConfirm) {
                obsTextarea.addEventListener('input', function () {
                    var val = obsTextarea.value.trim();
                    btnConfirm.disabled = val.length < 3;
                });
            }

            var formDevolver = modalDevolver.querySelector('form');
            if (formDevolver) {
                formDevolver.addEventListener('submit', function (e) {
                    var val = (document.getElementById('ObservacionDevolucion').value || '').trim();
                    if (val.length < 3) {
                        e.preventDefault();
                        alert('La observación debe tener al menos 3 caracteres.');
                        return false;
                    }
                });
            }
        }

        /* ── Delete modal ── */
        var modalEliminar = document.getElementById('modalEliminarRt');
        if (modalEliminar) {
            modalEliminar.addEventListener('show.bs.modal', function (e) {
                var src = e.relatedTarget;
                var idEl = document.getElementById('modalEliminarId');
                var nombreEl = document.getElementById('modalEliminarNombre');
                var btnConfirm = document.getElementById('btnConfirmarEliminar');
                var noDisp = document.getElementById('modalEliminarNoDisponible');

                var puede = src.getAttribute('data-puede-eliminar') === 'true';
                if (idEl) idEl.value = src.getAttribute('data-usuario-id') || '';
                if (nombreEl) nombreEl.textContent = src.getAttribute('data-usuario-nombre') || '';
                if (btnConfirm) btnConfirm.disabled = !puede;
                if (noDisp) noDisp.style.display = puede ? 'none' : 'block';
            });
        }

        /* ── Confirm delete actions ── */
        Array.prototype.forEach.call(document.querySelectorAll('form[data-confirm]'), function (form) {
            form.addEventListener('submit', function (e) {
                var confirmMsg = form.getAttribute('data-confirm');
                if (confirmMsg && !window.confirm(confirmMsg)) {
                    e.preventDefault();
                    return;
                }
                var submit = form.querySelector('button[type="submit"]');
                if (submit) {
                    submit.disabled = true;
                    window.setTimeout(function () { submit.disabled = false; }, 2000);
                }
            });
        });

        /* ── Initial render ── */
        renderPage();
    })();
    </script>
}
