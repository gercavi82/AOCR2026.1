@model List<CapaModelo.Usuario>
@{
    ViewBag.Title = "Aprobar Usuarios RT";
}

<h2 class="mb-3">Gestion de Usuarios RT</h2>

@if (TempData["msg"] != null)
{
    <div class="alert alert-success">@TempData["msg"]</div>
}

@if (TempData["error"] != null)
{
    <div class="alert alert-danger">@TempData["error"]</div>
}

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info">No hay usuarios RT registrados para revision.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm table-bordered table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Usuario</th>
                    <th>Correo</th>
                    <th>Empresa</th>
                    <th>Compañías RT</th>
                    <th>Estado RT</th>
                    <th>Estado Cuenta</th>
                    <th>Documento</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    var estadoRt = (u.EstadoDesignacionRT ?? "pendiente").Trim().ToLowerInvariant();
                    var puedeEliminar = u.PuedeEliminarRT;
                    if (string.IsNullOrWhiteSpace(estadoRt))
                    {
                        estadoRt = "pendiente";
                    }

                    var claseEstadoRt = "badge badge-secondary";
                    if (estadoRt == "pendiente")
                    {
                        claseEstadoRt = "badge badge-warning";
                    }
                    else if (estadoRt == "aceptado")
                    {
                        claseEstadoRt = "badge badge-success";
                    }
                    else if (estadoRt == "rechazado")
                    {
                        claseEstadoRt = "badge badge-danger";
                    }

                    <tr>
                        <td>
                            @Html.Encode(u.NombreCompleto)
                            <div class="text-muted small">@Html.Encode(u.CodigoUsuario)</div>
                            @if (!puedeEliminar)
                            {
                                <div class="text-danger small mt-1">
                                    No eliminable (tiene @u.TotalRelacionesBloqueantes registro(s) relacionados)
                                </div>
                            }
                        </td>
                        <td>@Html.Encode(u.Email)</td>
                        <td>@Html.Encode(u.EmpresaCodigo)</td>
                        <td>
                            <a class="btn btn-outline-primary btn-sm"
                               href="@Url.Action("GestionarCompaniasRT", "Usuario", new { id = u.Id })"
                               title="Gestionar compañías asignadas">
                                <i class="fas fa-building me-1"></i> Gestionar
                            </a>
                        </td>
                        <td><span class="@claseEstadoRt">@Html.Encode(estadoRt.ToUpperInvariant())</span></td>
                        <td>
                            @if (u.Activo)
                            {
                                <span class="badge badge-success">ACTIVO</span>
                            }
                            else
                            {
                                <span class="badge badge-secondary">INACTIVO</span>
                            }
                        </td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(u.RutaDocumentoLegal))
                            {
                                <a class="btn btn-outline-primary btn-sm" href="@Url.Action("DescargarDesignacionRT", "Usuario", new { id = u.Id })">
                                    <i class="fas fa-file-download mr-1"></i> Ver PDF
                                </a>
                            }
                            else
                            {
                                <span class="text-muted small">Sin documento</span>
                            }
                        </td>
                        <td class="text-center">
                            @if (u.Activo && estadoRt == "pendiente")
                            {
                                <form method="post" action="@Url.Action("AceptarDesignacion", "Usuario")" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@u.Id" />
                                    <button type="submit" class="btn btn-success btn-sm mr-1 mb-1" title="Aprobar RT" onclick="return confirm('Desea aprobar esta designacion RT?');">
                                        <i class="fas fa-check"></i>
                                    </button>
                                </form>

                                <form method="post" action="@Url.Action("RechazarDesignacion", "Usuario")" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@u.Id" />
                                    <button type="submit" class="btn btn-warning btn-sm mr-1 mb-1" title="Rechazar RT" onclick="return confirm('Desea rechazar esta designacion RT?');">
                                        <i class="fas fa-times"></i>
                                    </button>
                                </form>
                            }

                            @if (u.Activo)
                            {
                                <form method="post" action="@Url.Action("InactivarUsuarioRT", "Usuario")" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@u.Id" />
                                    <button type="submit" class="btn btn-secondary btn-sm mr-1 mb-1" title="Inactivar usuario" onclick="return confirm('Desea inactivar este usuario?');">
                                        <i class="fas fa-user-slash"></i>
                                    </button>
                                </form>
                            }
                            else
                            {
                                <form method="post" action="@Url.Action("ActivarUsuarioRT", "Usuario")" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@u.Id" />
                                    <button type="submit" class="btn btn-info btn-sm mr-1 mb-1" title="Activar usuario" onclick="return confirm('Desea activar este usuario?');">
                                        <i class="fas fa-user-check"></i>
                                    </button>
                                </form>
                            }

                            <form method="post" action="@Url.Action("EliminarUsuarioRT", "Usuario")" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@u.Id" />
                                <button type="submit"
                                        class="btn btn-danger btn-sm mb-1"
                                        title="@(puedeEliminar ? "Eliminar usuario" : "No se puede eliminar porque tiene información relacionada")"
                                        @(puedeEliminar ? "" : "disabled=\"disabled\"")
                                        onclick="return confirm('Desea eliminar este usuario de forma permanente?');">
                                    <i class="fas fa-trash-alt"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
