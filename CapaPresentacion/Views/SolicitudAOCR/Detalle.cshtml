    @if (documentosHistorialCompleto.Count > 0)
    {
        var grupos = documentosHistorialCompleto
            .GroupBy(d => (d.TipoDocumento ?? "Documento").Trim(), StringComparer.OrdinalIgnoreCase)
            .OrderBy(g => g.Key, StringComparer.OrdinalIgnoreCase)
            .ToList();

        <div class="card aocr-detail-card mt-4">
            <div class="card-header bg-white border-0 pt-4 px-4">
                <div class="aocr-section-title mb-0">
                    <i class="fas fa-layer-group"></i>
                    <span>Documentos del RT — Historial de versiones</span>
                </div>
                <p class="text-muted small mb-0 mt-2">
                    Se listan todos los documentos cargados por el Representante Técnico, incluyendo versiones iniciales y cargas posteriores realizadas como respuesta a observaciones.
                </p>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-sm mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Tipo documental</th>
                                <th>Versión</th>
                                <th>Archivo</th>
                                <th>Origen</th>
                                <th>Fecha carga</th>
                                <th>Cargado por</th>
                                <th>Estado</th>
                                <th>Observación</th>
                                <th>Acción</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var grupo in grupos)
                            {
                                var items = grupo
                                    .OrderByDescending(d => d.Version ?? 0)
                                    .ThenByDescending(d => d.FechaCarga ?? DateTime.MinValue)
                                    .ThenByDescending(d => d.CodigoDocumento)
                                    .ToList();
                                var idx = 0;
                                foreach (var doc in items)
                                {
                                    var esVigente = (idx == 0);
                                    var version = doc.Version ?? 1;
                                    var esSubsanacion = version > 1 || !esVigente;
                                    var etiquetaOrigen = esSubsanacion
                                        ? "<span class=\"badge bg-warning text-dark\">Subsanación</span>"
                                        : "<span class=\"badge bg-primary\">Inicial</span>";
                                    var etiquetaVigencia = esVigente
                                        ? "<span class=\"badge bg-success ms-1\">Vigente</span>"
                                        : "<span class=\"badge bg-secondary ms-1\">Histórica</span>";
                                    var rowClass = esVigente ? "table-light" : "";
                                    <tr class="@rowClass">
                                        <td><strong>@Html.Encode(grupo.Key)</strong></td>
                                        <td>v@(version) @Html.Raw(etiquetaVigencia)</td>
                                        <td>@Html.Encode(doc.NombreArchivo)</td>
                                        <td>@Html.Raw(etiquetaOrigen)</td>
                                        <td>@(doc.FechaCarga.HasValue ? doc.FechaCarga.Value.ToString("yyyy-MM-dd HH:mm") : "—")</td>
                                        <td>@Html.Encode(doc.UsuarioRegistro ?? "—")</td>
                                        <td><span class="badge bg-light text-dark border">@Html.Encode(doc.Estado ?? "—")</span></td>
                                        <td class="text-muted small" style="max-width:220px;">@Html.Encode(doc.Observaciones ?? string.Empty)</td>
                                        <td>
                                            @if (!string.IsNullOrWhiteSpace(doc.RutaGuardada))
                                            {
                                                var esPdfSolicitud = string.Equals(System.IO.Path.GetExtension(doc.NombreArchivo ?? string.Empty), ".pdf", System.StringComparison.OrdinalIgnoreCase);
                                                if (esPdfSolicitud)
                                                {
                                                    <a href="@Url.Action("Descargar", "Documento", new { id = doc.CodigoDocumento, vistaPrevia = true })"
                                                       class="btn btn-sm btn-outline-secondary aocr-pdf-open"
                                                       data-pdf-url="@Url.Action("Descargar", "Documento", new { id = doc.CodigoDocumento, vistaPrevia = true })"
                                                       data-download-url="@Url.Action("Descargar", "Documento", new { id = doc.CodigoDocumento })"
                                                       data-title="@doc.NombreArchivo"
                                                       data-status="@doc.Estado"
                                                       title="Vista previa">
                                                        <i class="fas fa-eye"></i>
                                                    </a>
                                                }
                                                <a href="@Url.Action("Descargar", "Documento", new { id = doc.CodigoDocumento })" class="btn btn-sm btn-outline-primary" title="Descargar">
                                                    <i class="fas fa-download"></i>
                                                </a>
                                            }
                                        </td>
                                    </tr>
                                    idx++;
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

