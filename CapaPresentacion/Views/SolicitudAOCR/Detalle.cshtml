@inherits System.Web.Mvc.WebViewPage<CapaModelo.SolicitudAOCR>
@using CapaDatos.Constants
@using CapaPresentacion.Helpers
@using CapaModelo
@using System.Collections.Generic
@using System.Linq
@using System.Web.Mvc
@using System.Web.Mvc.Html

@{
    ViewBag.Title = "Detalle de Solicitud AOCR";
    Layout = "~/Views/Shared/_LayoutAOCR.cshtml";

    if (Model == null)
    {
        ViewData.Model = new SolicitudAOCR
        {
            Estado = EstadoSolicitud.Pendiente
        };
        TempData["Warning"] = "La solicitud se cargÃ³ con informaciÃ³n parcial. Algunas secciones pueden mostrarse en modo lectura.";
    }

    var estadoActual = EstadoSolicitud.Normalizar(Model.Estado);
    var estadoVisibleExpediente = (ViewBag.EstadoDocumentalVisible as string ?? Model.Estado ?? string.Empty);
    var esSolicitudModificacion = Model.TipoSolicitud.GetValueOrDefault() == 3;
    var puedeInspectorDocumental =
        User.IsInRole("Inspector") &&
        (estadoActual == EstadoSolicitud.Pendiente
         || estadoActual == EstadoSolicitud.EnRevision
         || estadoActual == EstadoSolicitud.DocumentacionPendiente
         || estadoActual == EstadoSolicitud.Subsanada
         || estadoActual == EstadoSolicitud.EnInspeccion);

    var revisionesDocumentales = ViewBag.RevisionesDocumentales as Dictionary<int, Tuple<string, string>>
        ?? new Dictionary<int, Tuple<string, string>>();
    var puedeFinalizarRevisionDocumental = (bool)(ViewBag.PuedeFinalizarRevisionDocumental ?? false);
    var inspeccionesSolicitud = ViewBag.InspeccionesSolicitud as IEnumerable<Inspeccion>
        ?? Enumerable.Empty<Inspeccion>();
    var inspeccionVinculada = inspeccionesSolicitud
        .Where(i => i != null && i.CodigoInspeccion > 0)
        .OrderByDescending(i => i.CodigoInspeccion)
        .FirstOrDefault();
    var estadoInspeccionVinculada = inspeccionVinculada != null
        ? EstadosInspeccion.NormalizarEstado(inspeccionVinculada.Estado)
        : string.Empty;
    Func<string, string> textoEstadoInspeccion = estado =>
    {
        if (string.IsNullOrWhiteSpace(estado))
        {
            return "SIN ESTADO";
        }

        switch (EstadosInspeccion.NormalizarEstado(estado))
        {
            case EstadosInspeccion.SOLICITUD_INSPECCION_CREADA:
                return "SOLICITUD CREADA";
            case EstadosInspeccion.VERIFICACION_SOLICITUD:
                return "VERIFICACION DE SOLICITUD";
            case EstadosInspeccion.ACEPTADA:
                return "ACEPTADA";
            case EstadosInspeccion.OBSERVADA:
                return "OBSERVADA";
            case EstadosInspeccion.SUBSANADA:
                return "SUBSANADA";
            case EstadosInspeccion.PAGO_VALIDADO:
                return "PAGO VALIDADO";
            case EstadosInspeccion.EN_INSPECCION:
                return "EN INSPECCION";
            default:
                return EstadosInspeccion.NormalizarEstado(estado).Replace("_", " ");
        }
    };
    var usuarioActualId = (int)(ViewBag.UsuarioActualId ?? 0);
    var esPropietario = usuarioActualId > 0 && Model.CodigoUsuario == usuarioActualId;
    var puedeAbrirInspeccionVinculada = inspeccionVinculada != null &&
        (esPropietario
         || User.IsInRole("Inspector")
         || User.IsInRole("Coordinador")
         || User.IsInRole("CoordinadorInspecciones")
         || User.IsInRole("Administrador"));
    var urlInspeccionVinculada = puedeAbrirInspeccionVinculada
        ? Url.Action("Detalle", "Inspeccion", new { id = inspeccionVinculada.CodigoInspeccion })
        : string.Empty;

    var puedeSolicitarInspeccion =
        (User.IsInRole("Inspector") || User.IsInRole("Administrador")) &&
        (estadoActual == EstadoSolicitud.DocumentacionCompleta
         || estadoActual == EstadoSolicitud.PendienteAsignacionRT);

    var puedeMarcarElaboracion =
        (User.IsInRole("CoordinadorInspecciones") || User.IsInRole("Administrador")) &&
        estadoActual == EstadoSolicitud.EnInspeccion;

    var puedeMarcarRevision =
        (User.IsInRole("JefaturaTecnica") || User.IsInRole("Administrador")) &&
        estadoActual == EstadoSolicitud.AOCR_EnElaboracion;

    var puedeValidarJefatura =
        (User.IsInRole("JefaturaTecnica") || User.IsInRole("Administrador")) &&
        estadoActual == EstadoSolicitud.AOCR_EnRevision;

    var puedeLegalizar =
        (User.IsInRole("CoordinacionLegal") || User.IsInRole("DirectorGeneral") || User.IsInRole("Administrador")) &&
        estadoActual == EstadoSolicitud.AOCR_Validado;

    var puedeEmitirAocr =
        (User.IsInRole("CoordinacionLegal") || User.IsInRole("DirectorGeneral") || User.IsInRole("Administrador")) &&
        estadoActual == EstadoSolicitud.AOCR_Legalizado;
    var tieneInspectorAsignado = Model.CodigoTecnico.HasValue
        || !string.IsNullOrWhiteSpace(Model.TecnicoResponsableCedula)
        || !string.IsNullOrWhiteSpace(Model.TecnicoResponsableNombre);
    var puedeSubsanar = esPropietario && estadoActual == EstadoSolicitud.Observada;
    var puedeGestionarAsignacionInspector =
        (User.IsInRole("Coordinador") || User.IsInRole("CoordinadorInspecciones") || User.IsInRole("Administrador")) &&
        (estadoActual == EstadoSolicitud.EnRevision
         || estadoActual == EstadoSolicitud.DocumentacionPendiente
         || estadoActual == EstadoSolicitud.Subsanada
         || estadoActual == EstadoSolicitud.RequiereInspeccion
         || estadoActual == EstadoSolicitud.PendienteAsignacionRT
         || estadoActual == EstadoSolicitud.AceptacionDocumental
         || estadoActual == EstadoSolicitud.DocumentacionCompleta
         || estadoActual == EstadoSolicitud.EnInspeccion);
    var textoAccionInspector = tieneInspectorAsignado ? "Reasignar inspector" : "Asignar inspector";
    var urlAsignacionInspector = Url.Action("AsignarInspector", "Tecnico", new { solicitudId = Model.CodigoSolicitud });
    var puedeFirmarAceptacionDocumental =
        !esSolicitudModificacion &&
        (User.IsInRole("Coordinador") || User.IsInRole("CoordinadorInspecciones") || User.IsInRole("Administrador")) &&
        estadoActual == EstadoSolicitud.AceptacionDocumental;
    var puedeDescargarAceptacionDocumental =
        !esSolicitudModificacion &&
        (esPropietario || User.IsInRole("Coordinador") || User.IsInRole("CoordinadorInspecciones") || User.IsInRole("Administrador")) &&
        (estadoActual == EstadoSolicitud.FirmadoCoordinador || estadoActual == EstadoSolicitud.Finalizado);
    var puedeResolverRutaModificacion =
        esSolicitudModificacion &&
        (User.IsInRole("Inspector") || User.IsInRole("Administrador")) &&
        estadoActual == EstadoSolicitud.AceptacionDocumental;
    var puedePrepararCondicionesModificacion =
        esSolicitudModificacion &&
        (User.IsInRole("Inspector")
         || User.IsInRole("CoordinacionLegal")
         || User.IsInRole("CoordinadorLegal")
         || User.IsInRole("Coordinador")
         || User.IsInRole("CoordinadorInspecciones")
         || User.IsInRole("DIRDAC")
         || User.IsInRole("Direccion")
         || User.IsInRole("DirectorGeneral")
         || User.IsInRole("JefaturaTecnica")
         || User.IsInRole("Administrador")) &&
        (estadoActual == EstadoSolicitud.GeneradoCondicionesLimitaciones
         || estadoActual == EstadoSolicitud.EnRevisionCoordinadorFinal);
    var puedeRevisarCondicionesModificacion =
        esSolicitudModificacion &&
        (User.IsInRole("Coordinador") || User.IsInRole("CoordinadorInspecciones") || User.IsInRole("Administrador")) &&
        estadoActual == EstadoSolicitud.GeneradoCondicionesLimitaciones;
    var puedeEnviarCondicionesDcav =
        esSolicitudModificacion &&
        (User.IsInRole("Coordinador") || User.IsInRole("CoordinadorInspecciones") || User.IsInRole("Administrador")) &&
        estadoActual == EstadoSolicitud.EnRevisionCoordinadorFinal;
    var puedeFirmarCondicionesModificacion =
        esSolicitudModificacion &&
        (User.IsInRole("DIRDAC")
         || User.IsInRole("Direccion")
         || User.IsInRole("DirectorGeneral")
         || User.IsInRole("JefaturaTecnica")
         || User.IsInRole("Administrador")) &&
        estadoActual == EstadoSolicitud.EnviadoDcav;
    var puedeDescargarCondicionesModificacion =
        esSolicitudModificacion &&
        (esPropietario
         || User.IsInRole("DIRDAC")
         || User.IsInRole("Direccion")
         || User.IsInRole("DirectorGeneral")
         || User.IsInRole("JefaturaTecnica")
         || User.IsInRole("Coordinador")
         || User.IsInRole("CoordinadorInspecciones")
         || User.IsInRole("Administrador")) &&
        (estadoActual == EstadoSolicitud.FirmadoDcav || estadoActual == EstadoSolicitud.Finalizado);

    var direccionCompleta = string.Join(", ", new[]
    {
        Model.Direccion,
        (string.Concat(Model.Ciudad, " ", Model.Provincia)).Trim(),
        Model.Pais
    }.Where(x => !string.IsNullOrWhiteSpace(x)));

    Func<string, string> estadoCss = estado =>
    {
        var normalized = EstadoSolicitud.Normalizar(estado);
        if (normalized == EstadoSolicitud.Observada)
        {
            return "aocr-badge danger";
        }

        if (normalized == EstadoSolicitud.AOCR_Validado
            || normalized == EstadoSolicitud.AceptacionDocumental
            || normalized == EstadoSolicitud.FirmadoCoordinador
            || normalized == EstadoSolicitud.FirmadoDcav
            || normalized == EstadoSolicitud.Finalizado
            || normalized == EstadoSolicitud.AOCR_Legalizado
            || normalized == EstadoSolicitud.AOCR_EmitidoRecibido
            || normalized == EstadoSolicitud.Aprobada)
        {
            return "aocr-badge success";
        }

        if (normalized == EstadoSolicitud.EnRevision
            || normalized == EstadoSolicitud.AOCR_EnRevision
            || normalized == EstadoSolicitud.AOCR_EnElaboracion
            || normalized == EstadoSolicitud.RequiereInspeccion
            || normalized == EstadoSolicitud.GeneradoCondicionesLimitaciones
            || normalized == EstadoSolicitud.EnRevisionCoordinadorFinal
            || normalized == EstadoSolicitud.EnviadoDcav
            || normalized == EstadoSolicitud.EnInspeccion)
        {
            return "aocr-badge info";
        }

        return "aocr-badge warning";
    };
}

<style>
    .aocr-detail-shell {
        padding: 1.5rem 0 2rem;
    }

    .aocr-detail-card {
        border: 0;
        border-radius: 18px;
        box-shadow: 0 18px 40px rgba(14, 30, 62, 0.08);
        overflow: hidden;
    }

    .aocr-hero {
        background: linear-gradient(135deg, #0f3d75 0%, #174f97 55%, #2f6dbc 100%);
        color: #fff;
    }

    .aocr-hero .card-body {
        padding: 1.75rem;
    }

    .aocr-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.4rem 0.75rem;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.14);
        font-size: 0.8rem;
        letter-spacing: 0.03em;
        text-transform: uppercase;
    }

    .aocr-hero-title {
        font-size: 2rem;
        font-weight: 700;
        margin: 1rem 0 0.5rem;
    }

    .aocr-hero-subtitle {
        color: rgba(255, 255, 255, 0.84);
        margin-bottom: 0;
    }

    .aocr-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 132px;
        padding: 0.65rem 0.95rem;
        border-radius: 999px;
        font-size: 0.84rem;
        font-weight: 700;
        letter-spacing: 0.02em;
    }

    .aocr-badge.success {
        background: #dcfce7;
        color: #166534;
    }

    .aocr-badge.warning {
        background: #fef3c7;
        color: #92400e;
    }

    .aocr-badge.danger {
        background: #fee2e2;
        color: #b91c1c;
    }

    .aocr-badge.info {
        background: #dbeafe;
        color: #1d4ed8;
    }

    .aocr-summary-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 0.85rem;
        margin-top: 1.25rem;
    }

    .aocr-summary-item {
        background: rgba(255, 255, 255, 0.12);
        border: 1px solid rgba(255, 255, 255, 0.14);
        border-radius: 14px;
        padding: 0.9rem 1rem;
    }

    .aocr-summary-label {
        font-size: 0.78rem;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: rgba(255, 255, 255, 0.72);
        margin-bottom: 0.35rem;
    }

    .aocr-summary-value {
        font-size: 1rem;
        font-weight: 600;
        color: #fff;
    }

    .aocr-section-title {
        display: flex;
        align-items: center;
        gap: 0.7rem;
        font-size: 1.05rem;
        font-weight: 700;
        color: #16365f;
        margin-bottom: 1rem;
    }

    .aocr-section-title i {
        width: 40px;
        height: 40px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        background: #e8f1fb;
        color: #1e5aa8;
    }

    .aocr-info-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 1rem;
    }

    .aocr-info-item {
        padding: 0.95rem 1rem;
        border-radius: 14px;
        background: #f8fbff;
        border: 1px solid #e4edf7;
    }

    .aocr-info-label {
        display: flex;
        align-items: center;
        gap: 0.55rem;
        font-size: 0.8rem;
        font-weight: 700;
        text-transform: uppercase;
        color: #5f738c;
        margin-bottom: 0.45rem;
    }

    .aocr-info-label i {
        color: #1e5aa8;
    }

    .aocr-info-value {
        color: #102a43;
        font-weight: 600;
        line-height: 1.45;
    }

    .aocr-action-card {
        border: 1px solid #d8e4f2;
        background: linear-gradient(180deg, #ffffff 0%, #f8fbff 100%);
    }

    .aocr-action-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 1rem;
    }

    .aocr-action-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        border-radius: 8px;
        font-weight: 600;
        font-size: 0.875rem;
        padding: 0.5rem 1.25rem;
        white-space: nowrap;
    }

    .aocr-action-btn-full {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.6rem;
        width: 100%;
        min-height: 52px;
        border-radius: 14px;
        font-weight: 600;
    }

    .aocr-review-actions {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        justify-content: flex-end;
        height: 100%;
    }

    .aocr-review-actions .btn {
        width: 100%;
    }

    .aocr-review-card {
        border-left: 5px solid #1e5aa8;
    }

    .aocr-review-card.success {
        border-left-color: #1f7a3b;
    }

    .aocr-review-card.warning {
        border-left-color: #d97706;
    }

    .aocr-review-card.info {
        border-left-color: #2563eb;
    }

    .aocr-review-card.legal {
        border-left-color: #0f766e;
    }

    .aocr-review-card.emit {
        border-left-color: #166534;
    }

    .aocr-form-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
    }

    .aocr-history-table thead th {
        border-bottom-width: 1px;
        color: #4a5d75;
        font-size: 0.82rem;
        text-transform: uppercase;
        letter-spacing: 0.03em;
    }

    @@media (max-width: 767.98px) {
        .aocr-hero-title {
            font-size: 1.5rem;
        }

        .aocr-detail-shell {
            padding-top: 1rem;
        }
    }
</style>

<div class="container-fluid aocr-detail-shell">
    <div class="card aocr-detail-card aocr-hero mb-4">
        <div class="card-body">
            <div class="d-flex flex-column flex-lg-row justify-content-between gap-3 align-items-lg-start">
                <div>
                    <div class="aocr-eyebrow">
                        <i class="fas fa-file-signature"></i>
                        Detalle del tramite AOCR
                    </div>
                    <h1 class="aocr-hero-title">Solicitud AOCR #@Model.CodigoSolicitud</h1>
                    <p class="aocr-hero-subtitle">Vista consolidada del estado del tramite, datos del operador y acciones del flujo.</p>
                </div>
                <div class="text-lg-end">
                    <div class="mb-2 small text-uppercase opacity-75">Estado del tramite</div>
                    <span class="@estadoCss(estadoVisibleExpediente)">@estadoVisibleExpediente</span>
                </div>
            </div>

            <div class="aocr-summary-grid">
                <div class="aocr-summary-item">
                    <div class="aocr-summary-label">Fecha de solicitud</div>
                    <div class="aocr-summary-value">@(Model.FechaSolicitud.HasValue ? Model.FechaSolicitud.Value.ToString("yyyy-MM-dd HH:mm") : "No registrada")</div>
                </div>
                <div class="aocr-summary-item">
                    <div class="aocr-summary-label">Operador</div>
                    <div class="aocr-summary-value">@Model.NombreOperador</div>
                </div>
                <div class="aocr-summary-item">
                    <div class="aocr-summary-label">Tipo de operacion</div>
                    <div class="aocr-summary-value">@(string.IsNullOrWhiteSpace(Model.TipoOperacion) ? "No definido" : Model.TipoOperacion)</div>
                </div>
                <div class="aocr-summary-item">
                    <div class="aocr-summary-label">Tecnico responsable</div>
                    <div class="aocr-summary-value">@(string.IsNullOrWhiteSpace(Model.TecnicoResponsableNombre) ? "Sin asignar" : Model.TecnicoResponsableNombre)</div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-xl-7">
            <div class="card aocr-detail-card h-100">
                <div class="card-body p-4">
                    <div class="aocr-section-title">
                        <i class="fas fa-building"></i>
                        <span>Datos del Operador</span>
                    </div>

                    <div class="aocr-info-grid">
                        <div class="aocr-info-item">
                            <div class="aocr-info-label"><i class="fas fa-id-card"></i> RUC</div>
                            <div class="aocr-info-value">@(string.IsNullOrWhiteSpace(Model.Ruc) ? "No registrado" : Model.Ruc)</div>
                        </div>
                        <div class="aocr-info-item">
                            <div class="aocr-info-label"><i class="fas fa-plane-departure"></i> Codigo OACI</div>
                            <div class="aocr-info-value">@(string.IsNullOrWhiteSpace(Model.CodigoOaci) ? "No registrado" : Model.CodigoOaci)</div>
                        </div>
                        <div class="aocr-info-item">
                            <div class="aocr-info-label"><i class="fas fa-building"></i> Nombre operador</div>
                            <div class="aocr-info-value">@(string.IsNullOrWhiteSpace(Model.NombreOperador) ? "No registrado" : Model.NombreOperador)</div>
                        </div>
                        <div class="aocr-info-item">
                            <div class="aocr-info-label"><i class="fas fa-envelope"></i> Email</div>
                            <div class="aocr-info-value">@(string.IsNullOrWhiteSpace(Model.Email) ? "No registrado" : Model.Email)</div>
                        </div>
                        <div class="aocr-info-item">
                            <div class="aocr-info-label"><i class="fas fa-phone"></i> Telefono</div>
                            <div class="aocr-info-value">@(string.IsNullOrWhiteSpace(Model.Telefono) ? "No registrado" : Model.Telefono)</div>
                        </div>
                        <div class="aocr-info-item">
                            <div class="aocr-info-label"><i class="fas fa-map-marker-alt"></i> Direccion</div>
                            <div class="aocr-info-value">@(string.IsNullOrWhiteSpace(direccionCompleta) ? "No registrada" : direccionCompleta)</div>
                        </div>
                        <div class="aocr-info-item">
                            <div class="aocr-info-label"><i class="fas fa-user-tie"></i> Representante legal</div>
                            <div class="aocr-info-value">@(string.IsNullOrWhiteSpace(Model.RepresentanteLegal) ? "No registrado" : Model.RepresentanteLegal + (string.IsNullOrWhiteSpace(Model.CedulaRepresentante) ? string.Empty : " (" + Model.CedulaRepresentante + ")"))</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-5">
            <div class="card aocr-detail-card h-100">
                <div class="card-body p-4">
                    <div class="aocr-section-title">
                        <i class="fas fa-cogs"></i>
                        <span>Informacion de Operacion</span>
                    </div>

                    <div class="aocr-info-grid">
                        <div class="aocr-info-item">
                            <div class="aocr-info-label"><i class="fas fa-briefcase"></i> Tipo de operacion</div>
                            <div class="aocr-info-value">@(string.IsNullOrWhiteSpace(Model.TipoOperacion) ? "No definido" : Model.TipoOperacion)</div>
                        </div>
                        <div class="aocr-info-item">
                            <div class="aocr-info-label"><i class="fas fa-align-left"></i> Descripcion</div>
                            <div class="aocr-info-value">@(string.IsNullOrWhiteSpace(Model.DescripcionOperacion) ? "No definida" : Model.DescripcionOperacion)</div>
                        </div>
                        <div class="aocr-info-item">
                            <div class="aocr-info-label"><i class="fas fa-user-cog"></i> Tecnico responsable</div>
                            <div class="aocr-info-value">@(string.IsNullOrWhiteSpace(Model.TecnicoResponsableNombre) ? "Sin asignar" : Model.TecnicoResponsableNombre + (string.IsNullOrWhiteSpace(Model.TecnicoResponsableCedula) ? string.Empty : " - " + Model.TecnicoResponsableCedula))</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Observaciones))
    {
        <div class="card border-warning mb-4" style="border-left: 5px solid #ffc107 !important;">
            <div class="card-body p-4">
                <div class="d-flex align-items-start gap-3">
                    <div class="text-warning fs-3"><i class="fas fa-exclamation-triangle"></i></div>
                    <div>
                        <h5 class="fw-bold text-warning mb-1">Observaciones</h5>
                        <p class="mb-0" style="white-space: pre-line;">@Model.Observaciones</p>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (puedeSubsanar)
    {
        <div class="card border-info mb-4" style="border-left: 5px solid #17a2b8 !important;">
            <div class="card-body p-4">
                <div class="d-flex align-items-start gap-3">
                    <div class="text-info fs-3"><i class="fas fa-tools"></i></div>
                    <div class="flex-grow-1">
                        <h5 class="fw-bold text-info mb-1">Subsanar Solicitud</h5>
                        <p class="text-muted mb-3">Su solicitud ha sido observada. Corrija la documentación y vuelva a enviar para que sea revisada nuevamente.</p>
                        <a href="@Url.Action("Subsanar", "SolicitudAOCR", new { id = Model.CodigoSolicitud })" class="btn btn-info">
                            <i class="fas fa-edit me-1"></i> Corregir y Reenviar Solicitud
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (puedeGestionarAsignacionInspector)
    {
        <div class="card border-secondary mb-4" style="border-left: 5px solid #6c757d !important;">
            <div class="card-body p-4">
                <div class="d-flex align-items-start gap-3">
                    <div class="text-secondary fs-3"><i class="fas fa-user-check"></i></div>
                    <div class="flex-grow-1">
                        <h5 class="fw-bold text-secondary mb-1">Asignación de Inspector</h5>
                        <p class="text-muted mb-3">@(tieneInspectorAsignado
                            ? "La solicitud ya tiene inspector asignado. Puede reasignar si requiere redistribuir la revisión o actualizar la fecha programada."
                            : "El coordinador debe asignar inspector antes de que continúe la revisión técnica de la solicitud y la factura.")</p>
                        <a href="@urlAsignacionInspector" class="btn btn-outline-secondary">
                            <i class="fas fa-user-cog me-1"></i> @textoAccionInspector
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="card aocr-detail-card aocr-action-card mb-4">
        <div class="card-body p-4">
            <div class="aocr-section-title">
                <i class="fas fa-folder-open"></i>
                <span>Gestion Documental</span>
            </div>

            @{
                var puedeGenerarAocr = (ViewBag.PuedeGenerarAOCR != null) && (bool)ViewBag.PuedeGenerarAOCR;
                var motivoAocr = ViewBag.MotivoGenerarAOCR as string;
                var aocrYaGenerado = (ViewBag.AocrYaGenerado != null) && (bool)ViewBag.AocrYaGenerado;
                var documentoAocr = ViewBag.DocumentoAOCRGenerado as CapaModelo.Documento;
            }

            <div class="aocr-action-grid">
                @if (aocrYaGenerado && documentoAocr != null)
                {
                    <div class="btn btn-success aocr-action-btn-full disabled" style="cursor: default;">
                        <i class="fas fa-check-circle"></i>
                        AOCR Generada
                        <small class="d-block" style="font-size: 0.78em; opacity: 0.9;">
                            @(documentoAocr.NombreArchivo)
                            @if (documentoAocr.FechaCarga.HasValue)
                            {
                                <text> — @documentoAocr.FechaCarga.Value.ToString("dd/MM/yyyy HH:mm")</text>
                            }
                        </small>
                    </div>
                    <a href="@Url.Action("DescargarAOCRGenerada", "SolicitudAOCR", new { id = Model.CodigoSolicitud, vistaPrevia = true })"
                       class="btn btn-outline-primary aocr-action-btn-full" target="_blank" rel="noopener">
                        <i class="fas fa-eye"></i>
                        Vista previa AOCR
                    </a>
                    <a href="@Url.Action("DescargarAOCRGenerada", "SolicitudAOCR", new { id = Model.CodigoSolicitud })"
                       class="btn btn-outline-success aocr-action-btn-full" target="_blank" rel="noopener">
                        <i class="fas fa-download"></i>
                        Descargar AOCR
                    </a>
                }
                else if (puedeGenerarAocr)
                {
                    using (Html.BeginForm("GenerarAOCR", "SolicitudAOCR", new { id = Model.CodigoSolicitud }, FormMethod.Post, new { style = "display:contents;" }))
                    {
                        @Html.AntiForgeryToken()
                        <button type="submit"
                                class="btn btn-primary aocr-action-btn-full"
                                onclick="return confirm('¿Confirma la generación automática del documento AOCR para esta solicitud?');"
                                title="@(motivoAocr ?? "Generar documento AOCR desde el sistema")">
                            <i class="fas fa-file-signature"></i>
                            Generar AOCR
                        </button>
                    }
                }
                else
                {
                    <button type="button"
                            class="btn btn-primary aocr-action-btn-full"
                            disabled="disabled"
                            title="@(motivoAocr ?? "Disponible una vez la inspeccion sea satisfactoria y el informe tecnico quede firmado por el inspector")"
                            style="opacity: 0.55; cursor: not-allowed;">
                        <i class="fas fa-file-signature"></i>
                        Generar AOCR
                    </button>
                }

                <a href="@Url.Action("Lista", "Documento", new { solicitudId = Model.CodigoSolicitud })" class="btn btn-outline-primary aocr-action-btn-full">
                    <i class="fas fa-file-alt"></i>
                    Ver Documentos de la Solicitud
                </a>
            </div>

            @if (!puedeGenerarAocr && !aocrYaGenerado)
            {
                <div class="alert alert-info mt-3 mb-0" style="font-size: 0.9em;">
                    <i class="fas fa-info-circle me-1"></i>
                    <strong>AOCR no disponible aún:</strong>
                    @(string.IsNullOrEmpty(motivoAocr)
                        ? "La AOCR estara disponible cuando la inspeccion sea satisfactoria y el informe tecnico quede firmado por el inspector."
                        : motivoAocr)
                </div>
            }
            else if (aocrYaGenerado)
            {
                <div class="alert alert-success mt-3 mb-0" style="font-size: 0.9em;">
                    <i class="fas fa-check-circle me-1"></i>
                    La AOCR de esta solicitud ya fue generada automáticamente por el sistema y está disponible en el expediente.
                </div>
            }
        </div>
    </div>

    @if (puedeInspectorDocumental)
    {
        var documentosRevision = (ViewBag.DocumentosSolicitud as List<Documento>) ?? new List<Documento>();
        var totalDocumentosRevision = documentosRevision.Count;
        var documentosRevisados = documentosRevision.Count(doc =>
        {
            var estadoDoc = (doc.Estado ?? string.Empty).Trim().ToUpperInvariant();
            Tuple<string, string> revisionActual;
            return revisionesDocumentales.TryGetValue(doc.CodigoDocumento, out revisionActual)
                   || RevisionDocumentalDisplayHelper.IsAcceptedState(estadoDoc)
                   || RevisionDocumentalDisplayHelper.IsReturnedState(estadoDoc);
        });
        var documentosConObservacionPendiente = documentosRevision.Count(doc =>
        {
            Tuple<string, string> revisionActual;
            var decisionActual = string.Empty;
            var observacionActual = (doc.Observaciones ?? string.Empty).Trim();

            if (revisionesDocumentales.TryGetValue(doc.CodigoDocumento, out revisionActual) && revisionActual != null)
            {
                decisionActual = (revisionActual.Item1 ?? string.Empty).Trim().ToUpperInvariant();
                observacionActual = string.IsNullOrWhiteSpace(revisionActual.Item2) ? observacionActual : revisionActual.Item2.Trim();
            }
            else if (RevisionDocumentalDisplayHelper.IsReturnedState(doc.Estado))
            {
                decisionActual = "DEVUELTO";
            }

            return (decisionActual == "DEVUELTO" || decisionActual == "OBSERVADO")
                   && string.IsNullOrWhiteSpace(observacionActual);
        });
        var documentosSinDecision = totalDocumentosRevision - documentosRevisados;
        var todosDocumentosAceptados = totalDocumentosRevision > 0 && documentosRevision.All(doc =>
        {
            Tuple<string, string> revisionActual;
            var decisionActual = revisionesDocumentales.TryGetValue(doc.CodigoDocumento, out revisionActual) && revisionActual != null
                ? (revisionActual.Item1 ?? string.Empty).Trim().ToUpperInvariant()
                : ((RevisionDocumentalDisplayHelper.IsAcceptedState(doc.Estado) ? "ACEPTADO" : (RevisionDocumentalDisplayHelper.IsReturnedState(doc.Estado) ? "DEVUELTO" : string.Empty)));
            return decisionActual == "ACEPTADO";
        });
        var existeObservadoODevuelto = documentosRevision.Any(doc =>
        {
            Tuple<string, string> revisionActual;
            var decisionActual = revisionesDocumentales.TryGetValue(doc.CodigoDocumento, out revisionActual) && revisionActual != null
                ? (revisionActual.Item1 ?? string.Empty).Trim().ToUpperInvariant()
                : ((RevisionDocumentalDisplayHelper.IsAcceptedState(doc.Estado) ? "ACEPTADO" : (RevisionDocumentalDisplayHelper.IsReturnedState(doc.Estado) ? "DEVUELTO" : string.Empty)));
            return decisionActual == "DEVUELTO" || decisionActual == "OBSERVADO";
        });

        <div class="card aocr-detail-card aocr-review-card success mb-4">
            <div class="card-body p-4">
                <div class="aocr-section-title mb-3">
                    <i class="fas fa-clipboard-check"></i>
                    <span>Revision Documental</span>
                </div>
                <p class="text-muted mb-3">Revise cada documento vigente y registre su decisión. La solicitud solo podrá enviarse cuando todos los documentos tengan revisión y cada devolución/observación tenga su motivo.</p>

                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <div class="aocr-info-item">
                            <div class="aocr-info-label"><i class="fas fa-folder-open"></i> Documentos vigentes</div>
                            <div class="aocr-info-value">@totalDocumentosRevision</div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="aocr-info-item">
                            <div class="aocr-info-label"><i class="fas fa-check-circle"></i> Revisados</div>
                            <div class="aocr-info-value">@documentosRevisados / @totalDocumentosRevision</div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="aocr-info-item">
                            <div class="aocr-info-label"><i class="fas fa-exclamation-triangle"></i> Observaciones pendientes</div>
                            <div class="aocr-info-value">@documentosConObservacionPendiente</div>
                        </div>
                    </div>
                </div>

                @if (documentosRevision.Count == 0)
                {
                    <div class="alert alert-light mb-0">No existen documentos cargados para revisar en esta solicitud.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Documento</th>
                                    <th>Estado actual</th>
                                    <th>Decision</th>
                                    <th>Observacion</th>
                                    <th class="text-end">Accion</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var doc in documentosRevision)
                                {
                                    var estadoDoc = (doc.Estado ?? "PENDIENTE").Trim().ToUpperInvariant();
                                    var formId = "frmRevisionDoc_" + doc.CodigoDocumento;
                                    Tuple<string, string> revisionActual;
                                    var tieneRevisionGuardada = revisionesDocumentales.TryGetValue(doc.CodigoDocumento, out revisionActual) && revisionActual != null;
                                    var decisionActual = tieneRevisionGuardada
                                        ? (revisionActual.Item1 ?? string.Empty).Trim().ToUpperInvariant()
                                        : (RevisionDocumentalDisplayHelper.IsAcceptedState(estadoDoc) ? "ACEPTADO" : (RevisionDocumentalDisplayHelper.IsReturnedState(estadoDoc) ? "DEVUELTO" : string.Empty));
                                    var observacionActual = tieneRevisionGuardada
                                        ? (revisionActual.Item2 ?? string.Empty).Trim()
                                        : (doc.Observaciones ?? string.Empty).Trim();
                                    var estadoVisible = RevisionDocumentalDisplayHelper.GetVisibleStateLabel(estadoDoc);
                                    var claseBadge = RevisionDocumentalDisplayHelper.GetBadgeClass(estadoDoc);
                                    <tr>
                                        <td>
                                            <div class="fw-semibold">@(string.IsNullOrWhiteSpace(doc.TipoDocumento) ? "Documento" : doc.TipoDocumento)</div>
                                            <small class="text-muted">@doc.NombreArchivo</small>
                                        </td>
                                        <td><span class="@claseBadge">@estadoVisible</span></td>
                                        <td style="min-width: 170px;">
                                            <select name="decision" class="form-select form-select-sm js-decision-documental" data-codigo-documento="@doc.CodigoDocumento" required form="@formId">
                                                <option value="">Seleccione</option>
                                                <option value="ACEPTADO" @(decisionActual == "ACEPTADO" ? "selected" : null)>Aceptado</option>
                                                <option value="DEVUELTO" @(decisionActual == "DEVUELTO" ? "selected" : null)>Devuelto</option>
                                                <option value="OBSERVADO" @(decisionActual == "OBSERVADO" ? "selected" : null)>Observado</option>
                                            </select>
                                        </td>
                                        <td style="min-width: 280px;">
                                            <input type="text" name="observacion" class="form-control form-control-sm js-observacion-documental" data-codigo-documento="@doc.CodigoDocumento" placeholder="Observacion del revisor" maxlength="500" value="@observacionActual" form="@formId" />
                                        </td>
                                        <td class="text-end">
                                            <form id="@formId" method="post" action="@Url.Action("RevisarDocumentoItem", "SolicitudAOCR")" class="d-inline js-form-revision-documental">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@Model.CodigoSolicitud" />
                                                <input type="hidden" name="codigoDocumento" value="@doc.CodigoDocumento" />
                                                <button type="submit" class="btn btn-sm btn-primary">
                                                    <i class="fas fa-save"></i> Registrar
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="alert alert-light border mt-3 mb-0">
                        <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">
                            <div>
                                <div class="fw-semibold text-dark">Acción masiva de revisión documental</div>
                                <div class="text-muted small">Si todos están en Aceptado, puede aprobar masivamente. Si existe al menos un documento Observado/Devuelto, registre devolución/observaciones masivas.</div>
                                <div class="small mt-1 text-secondary">Sin decisión: <strong id="lblDocsSinDecision">@documentosSinDecision</strong> · Observaciones pendientes: <strong id="lblDocsObsPendientes">@documentosConObservacionPendiente</strong></div>
                            </div>
                            <form id="frmRevisionMasiva" method="post" action="@Url.Action("AccionMasivaRevisionDocumental", "SolicitudAOCR")" class="m-0">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@Model.CodigoSolicitud" />
                                <input type="hidden" name="tipoAccion" id="tipoAccionMasiva" value="" />
                                <input type="hidden" name="revisionesJson" id="revisionesJsonMasiva" value="" />
                                <div class="mb-2">
                                    <input type="text"
                                           class="form-control form-control-sm"
                                           name="observacionCoordinador"
                                           maxlength="500"
                                           placeholder="Observación opcional para coordinación (se registra en trazabilidad)." />
                                </div>
                                <div class="d-flex flex-wrap gap-2 justify-content-end">
                                    <button type="button"
                                            id="btnAprobarTodosDocumentos"
                                            class="btn btn-success aocr-action-btn"
                                            @((puedeFinalizarRevisionDocumental && todosDocumentosAceptados) ? null : "disabled=\"disabled\"")>
                                        <i class="fas fa-check-double"></i>
                                        Aprobar todos los documentos
                                    </button>
                                    <button type="button"
                                            id="btnRegistrarObsMasiva"
                                            class="btn btn-outline-danger aocr-action-btn"
                                            @((puedeFinalizarRevisionDocumental && existeObservadoODevuelto) ? null : "disabled=\"disabled\"")>
                                        <i class="fas fa-comment-dots"></i>
                                        Registrar observaciones/devolución masiva
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    @if (puedeFirmarAceptacionDocumental)
    {
        <div class="card aocr-detail-card aocr-review-card success mb-4">
            <div class="card-body p-4">
                <div class="aocr-section-title mb-3">
                    <i class="fas fa-file-signature"></i>
                    <span>Autorizacion final</span>
                </div>
                <p class="text-muted mb-3">El inspector ya aceptó la solicitud y la factura. La coordinación debe firmar la autorización final antes de poner el PDF a disposición del RT.</p>
                <form method="post" action="@Url.Action("FirmarAceptacionDocumental", "SolicitudAOCR")">
                    @Html.AntiForgeryToken()
                    @Html.Hidden("id", Model.CodigoSolicitud)
                    <div class="row g-3 align-items-end">
                        <div class="col-md-8">
                            <label class="form-label fw-semibold" for="observacionAceptacion">Observacion de autorizacion</label>
                            <textarea class="form-control" id="observacionAceptacion" name="observacion" rows="3" placeholder="Constancia interna de la autorización final firmada."></textarea>
                        </div>
                        <div class="col-md-4 d-flex justify-content-end">
                            <button type="submit" class="btn btn-success aocr-action-btn w-100">
                                <i class="fas fa-pen-nib"></i>
                                Firmar autorizacion final
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    }

    @if (puedeDescargarAceptacionDocumental)
    {
        <div class="card aocr-detail-card aocr-review-card info mb-4">
            <div class="card-body p-4 d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">
                <div>
                    <div class="aocr-section-title mb-2">
                        <i class="fas fa-file-pdf"></i>
                        <span>Autorizacion final firmada</span>
                    </div>
                    <p class="text-muted mb-0">El documento de autorización final ya está listo para consulta y descarga.</p>
                    @if (esPropietario && estadoActual == EstadoSolicitud.FirmadoCoordinador)
                    {
                        <div class="small text-secondary mt-2">La primera descarga del RT cerrará esta fase como <strong>FINALIZADO</strong>.</div>
                    }
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <a href="@Url.Action("DescargarAceptacionDocumental", "SolicitudAOCR", new { id = Model.CodigoSolicitud, vistaPrevia = true })" class="btn btn-outline-secondary aocr-action-btn" target="_blank">
                        <i class="fas fa-eye"></i>
                        Vista previa
                    </a>
                    <a href="@Url.Action("DescargarAceptacionDocumental", "SolicitudAOCR", new { id = Model.CodigoSolicitud })" class="btn btn-outline-primary aocr-action-btn">
                        <i class="fas fa-download"></i>
                        Descargar autorizacion
                    </a>
                </div>
            </div>
        </div>
    }

    @if (puedeResolverRutaModificacion)
    {
        <div class="card aocr-detail-card aocr-review-card info mb-4">
            <div class="card-body p-4">
                <div class="aocr-section-title mb-3">
                    <i class="fas fa-code-branch"></i>
                    <span>Resolucion de modificacion</span>
                </div>
                <p class="text-muted mb-3">La documentación ya fue aceptada. El inspector debe resolver si la modificación continúa al módulo de inspección o si puede cerrarse con Condiciones y Limitaciones sin nueva inspección.</p>
                <form method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.CodigoSolicitud" />
                    <div class="row g-3 align-items-end">
                        <div class="col-md-8">
                            <label class="form-label fw-semibold" for="obsResolucionModificacion">Observacion del inspector</label>
                            <textarea class="form-control" id="obsResolucionModificacion" name="observacion" rows="3" placeholder="Fundamente si la modificación requiere inspección o si puede cerrar directo con Condiciones y Limitaciones."></textarea>
                        </div>
                        <div class="col-md-4">
                            <div class="aocr-review-actions">
                                <button formaction="@Url.Action("GenerarCondicionesLimitacionesModificacion", "SolicitudAOCR")" class="btn btn-success aocr-action-btn" type="submit">
                                    <i class="fas fa-file-contract"></i>
                                    No requiere nueva inspeccion
                                </button>
                                <button formaction="@Url.Action("MarcarRequiereInspeccionModificacion", "SolicitudAOCR")" class="btn btn-outline-warning aocr-action-btn" type="submit">
                                    <i class="fas fa-clipboard-list"></i>
                                    Derivar a inspeccion
                                </button>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    }

    @if (puedePrepararCondicionesModificacion)
    {
        <div class="card aocr-detail-card aocr-review-card success mb-4">
            <div class="card-body p-4 d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">
                <div>
                    <div class="aocr-section-title mb-2">
                        <i class="fas fa-file-pdf"></i>
                        <span>Condiciones y Limitaciones de la modificacion</span>
                    </div>
                    <p class="text-muted mb-0">El documento institucional ya puede completarse y revisarse desde este trámite antes del envío a DCAV/DGAC.</p>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <a href="@Url.Action("EditarDocumentoValidacionAocr", "CoordinacionJefatura", new { solicitudId = Model.CodigoSolicitud, tipo = "CONDICIONES_LIMITACIONES" })" class="btn btn-primary aocr-action-btn">
                        <i class="fas fa-pen"></i>
                        Completar documento
                    </a>
                    <a href="@Url.Action("DocumentoValidacionAocr", "CoordinacionJefatura", new { solicitudId = Model.CodigoSolicitud, tipo = "CONDICIONES_LIMITACIONES", descargar = false })" class="btn btn-outline-secondary aocr-action-btn" target="_blank" rel="noopener">
                        <i class="fas fa-eye"></i>
                        PDF directo
                    </a>
                </div>
            </div>
        </div>
    }

    @if (esSolicitudModificacion && inspeccionVinculada != null && (estadoActual == EstadoSolicitud.RequiereInspeccion || estadoActual == EstadoSolicitud.EnInspeccion || estadoActual == EstadoSolicitud.PendienteAsignacionRT))
    {
        <div class="card aocr-detail-card aocr-review-card warning mb-4">
            <div class="card-body p-4 d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">
                <div>
                    <div class="aocr-section-title mb-2">
                        <i class="fas fa-clipboard-check"></i>
                        <span>Solicitud de inspeccion vinculada</span>
                    </div>
                    <p class="text-muted mb-2">La modificación ya tiene una inspección asociada. La revisión, observación y subsanación deben continuar dentro del módulo de inspección para no perder trazabilidad con el trámite original.</p>
                    <div class="small text-secondary">Inspeccion #@inspeccionVinculada.CodigoInspeccion - Estado actual: <strong>@textoEstadoInspeccion(estadoInspeccionVinculada)</strong></div>
                </div>
                @if (puedeAbrirInspeccionVinculada)
                {
                    <a href="@urlInspeccionVinculada" class="btn btn-outline-primary aocr-action-btn flex-shrink-0">
                        <i class="fas fa-external-link-alt"></i>
                        Abrir solicitud de inspeccion
                    </a>
                }
            </div>
        </div>
    }

    @if (puedeRevisarCondicionesModificacion)
    {
        <div class="card aocr-detail-card aocr-review-card info mb-4">
            <div class="card-body p-4">
                <div class="aocr-section-title mb-3">
                    <i class="fas fa-search"></i>
                    <span>Revision final de coordinacion</span>
                </div>
                <form method="post" action="@Url.Action("RevisarCondicionesLimitacionesModificacion", "SolicitudAOCR")">
                    @Html.AntiForgeryToken()
                    @Html.Hidden("id", Model.CodigoSolicitud)
                    <div class="row g-3 align-items-end">
                        <div class="col-md-8">
                            <label class="form-label fw-semibold" for="obsRevisionCondiciones">Observacion</label>
                            <textarea class="form-control" id="obsRevisionCondiciones" name="observacion" rows="3" placeholder="Constancia de revisión previa al envío a DCAV/DGAC."></textarea>
                        </div>
                        <div class="col-md-4 d-flex justify-content-end">
                            <button type="submit" class="btn btn-primary aocr-action-btn w-100">
                                <i class="fas fa-check-circle"></i>
                                Marcar revision final
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    }

    @if (puedeEnviarCondicionesDcav)
    {
        <div class="card aocr-detail-card aocr-review-card legal mb-4">
            <div class="card-body p-4">
                <div class="aocr-section-title mb-3">
                    <i class="fas fa-paper-plane"></i>
                    <span>Envio a DCAV / DGAC</span>
                </div>
                <form method="post" action="@Url.Action("EnviarCondicionesLimitacionesDcav", "SolicitudAOCR")">
                    @Html.AntiForgeryToken()
                    @Html.Hidden("id", Model.CodigoSolicitud)
                    <div class="row g-3 align-items-end">
                        <div class="col-md-8">
                            <label class="form-label fw-semibold" for="obsEnvioDcav">Observacion de envío</label>
