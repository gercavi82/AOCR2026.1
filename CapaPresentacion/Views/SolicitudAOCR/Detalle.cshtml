<div class="container-fluid aocr-detail-shell">
    @if (!string.IsNullOrWhiteSpace(mensajeExito))
    {
        <div class="alert alert-success mb-4" role="alert">@mensajeExito</div>
    }

    @if (!string.IsNullOrWhiteSpace(mensajeError))
    {
        <div class="alert alert-danger mb-4" role="alert">@mensajeError</div>
    }

    @if (!string.IsNullOrWhiteSpace(mensajeWarning))
    {
        <div class="alert alert-warning mb-4" role="alert">@mensajeWarning</div>
    }

    @if (procesoCerradoOperativamente)
    {
        <div class="card border-secondary mb-4" style="border-left: 5px solid #6c757d !important;">
            <div class="card-body p-4">
                <div class="d-flex align-items-start gap-3">
                    <div class="text-secondary fs-3"><i class="fas fa-lock"></i></div>
                    <div class="flex-grow-1">
                        <h5 class="fw-bold text-secondary mb-1">Proceso cerrado operativamente</h5>
                        <p class="text-muted mb-3">Este expediente ya terminó su flujo AOCR y quedó en modo consulta histórica. Las acciones operativas quedan bloqueadas; si necesita continuar con un nuevo trámite, genere una Nueva Orden de Recaudación.</p>
                        @if (puedeIniciarNuevaOrden)
                        {
                            <a href="@urlNuevaOrden" class="btn btn-primary">
                                <i class="fas fa-plus-circle me-1"></i> Nueva Orden de Recaudación
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
    }

    @if (!procesoCerradoOperativamente && documentosObligatoriosFaltantes.Count > 0)
    {
        <div class="card border-danger mb-4" style="border-left: 5px solid #dc3545 !important;">
            <div class="card-body p-4">
                <div class="d-flex align-items-start gap-3">
                    <div class="text-danger fs-3"><i class="fas fa-file-exclamation"></i></div>
                    <div class="flex-grow-1">
                        <h5 class="fw-bold text-danger mb-1">Documentación obligatoria pendiente</h5>
                        <p class="text-muted mb-2">No puede continuar al siguiente paso mientras no se carguen todos los documentos solicitados en la Solicitud AOCR.</p>
                        <ul class="mb-0">
                            @foreach (var documentoPendiente in documentosObligatoriosFaltantes)
                            {
                                <li>@documentoPendiente</li>
                            }
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="card aocr-detail-card aocr-hero mb-4">
        <div class="card-body">
            <div class="d-flex flex-column flex-lg-row justify-content-between gap-3 align-items-lg-start">
                <div>
                    <div class="aocr-eyebrow">
                        <i class="fas fa-file-signature"></i>
                        Detalle del tramite AOCR
                    </div>
                    <h1 class="aocr-hero-title">Solicitud AOCR #@Model.CodigoSolicitud</h1>
                    <p class="aocr-hero-subtitle">Vista consolidada del estado del tramite, datos del operador y acciones del flujo.</p>
                </div>
                <div class="text-lg-end">
                    <div class="mb-2 small text-uppercase opacity-75">Estado del tramite</div>
                    <span class="@estadoCss(estadoVisibleExpediente)">@estadoVisibleExpediente</span>
                </div>
            </div>

            <div class="aocr-summary-grid">
                <div class="aocr-summary-item">
                    <div class="aocr-summary-label">Fecha de solicitud</div>
                    <div class="aocr-summary-value">@(Model.FechaSolicitud.HasValue ? Model.FechaSolicitud.Value.ToString("yyyy-MM-dd HH:mm") : "No registrada")</div>
                </div>
                <div class="aocr-summary-item">
                    <div class="aocr-summary-label">Operador</div>
                    <div class="aocr-summary-value">@Model.NombreOperador</div>
                </div>
                <div class="aocr-summary-item">
                    <div class="aocr-summary-label">Tipo de operacion</div>
                    <div class="aocr-summary-value">@(string.IsNullOrWhiteSpace(Model.TipoOperacion) ? "No definido" : Model.TipoOperacion)</div>
                </div>
                <div class="aocr-summary-item">
                    <div class="aocr-summary-label">Inspector asignado</div>
                    <div class="aocr-summary-value">@inspectorAsignadoDetalle</div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-xl-7">
            <div class="card aocr-detail-card h-100">
                <div class="card-body p-4">
                    <div class="aocr-section-title">
                        <i class="fas fa-building"></i>
                        <span>Datos del Operador</span>
                    </div>

                    <div class="aocr-info-grid">
                        <div class="aocr-info-item">
                            <div class="aocr-info-label"><i class="fas fa-id-card"></i> RUC</div>
                            <div class="aocr-info-value">@(string.IsNullOrWhiteSpace(Model.Ruc) ? "No registrado" : Model.Ruc)</div>
                        </div>
                        <div class="aocr-info-item">
                            <div class="aocr-info-label"><i class="fas fa-plane-departure"></i> Codigo OACI</div>
                            <div class="aocr-info-value">@(string.IsNullOrWhiteSpace(Model.CodigoOaci) ? "No registrado" : Model.CodigoOaci)</div>
                        </div>
                        <div class="aocr-info-item">
                            <div class="aocr-info-label"><i class="fas fa-building"></i> Nombre operador</div>
                            <div class="aocr-info-value">@(string.IsNullOrWhiteSpace(Model.NombreOperador) ? "No registrado" : Model.NombreOperador)</div>
                        </div>
                        <div class="aocr-info-item">
                            <div class="aocr-info-label"><i class="fas fa-envelope"></i> Email</div>
                            <div class="aocr-info-value">@(string.IsNullOrWhiteSpace(Model.Email) ? "No registrado" : Model.Email)</div>
                        </div>
                        <div class="aocr-info-item">
                            <div class="aocr-info-label"><i class="fas fa-phone"></i> Telefono</div>
                            <div class="aocr-info-value">@(string.IsNullOrWhiteSpace(Model.Telefono) ? "No registrado" : Model.Telefono)</div>
                        </div>
                        <div class="aocr-info-item">
                            <div class="aocr-info-label"><i class="fas fa-map-marker-alt"></i> Direccion</div>
                            <div class="aocr-info-value">@(string.IsNullOrWhiteSpace(direccionCompleta) ? "No registrada" : direccionCompleta)</div>
                        </div>
                        <div class="aocr-info-item">
                            <div class="aocr-info-label"><i class="fas fa-user-tie"></i> Representante legal</div>
                            <div class="aocr-info-value">@(string.IsNullOrWhiteSpace(Model.RepresentanteLegal) ? "No registrado" : Model.RepresentanteLegal + (string.IsNullOrWhiteSpace(Model.CedulaRepresentante) ? string.Empty : " (" + Model.CedulaRepresentante + ")"))</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-5">
            <div class="card aocr-detail-card h-100">
                <div class="card-body p-4">
                    <div class="aocr-section-title">
                        <i class="fas fa-cogs"></i>
                        <span>Informacion de Operacion</span>
                    </div>

                    <div class="aocr-info-grid">
                        <div class="aocr-info-item">
                            <div class="aocr-info-label"><i class="fas fa-briefcase"></i> Tipo de operacion</div>
                            <div class="aocr-info-value">@(string.IsNullOrWhiteSpace(Model.TipoOperacion) ? "No definido" : Model.TipoOperacion)</div>
                        </div>
                        <div class="aocr-info-item">
                            <div class="aocr-info-label"><i class="fas fa-align-left"></i> Descripcion</div>
                            <div class="aocr-info-value">@(string.IsNullOrWhiteSpace(Model.DescripcionOperacion) ? "No definida" : normalizeVisibleText(Model.DescripcionOperacion))</div>
                        </div>
                        <div class="aocr-info-item">
                            <div class="aocr-info-label"><i class="fas fa-user-cog"></i> Inspector principal</div>
                            <div class="aocr-info-value">@inspectorAsignadoDetalle</div>
                        </div>
                        <div class="aocr-info-item">
                            <div class="aocr-info-label"><i class="fas fa-user-friends"></i> Inspector apoyo</div>
                            <div class="aocr-info-value">@inspectorApoyoDetalle</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Observaciones))
    {
        <div class="card border-warning mb-4" style="border-left: 5px solid #ffc107 !important;">
            <div class="card-body p-4">
                <div class="d-flex align-items-start gap-3">
                    <div class="text-warning fs-3"><i class="fas fa-exclamation-triangle"></i></div>
                    <div>
                        <h5 class="fw-bold text-warning mb-1">Observaciones</h5>
                        <p class="mb-0" style="white-space: pre-line;">@normalizeVisibleText(Model.Observaciones)</p>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (inspeccionVinculada != null
        && (estadoActual == EstadoSolicitud.DocumentacionCompleta
            || estadoActual == EstadoSolicitud.AceptacionDocumental
            || estadoActual == EstadoSolicitud.RequiereInspeccion
            || estadoActual == EstadoSolicitud.EnInspeccion
            || estadoActual == EstadoSolicitud.PendienteAsignacionRT))
    {
        <div class="card aocr-detail-card aocr-review-card warning aocr-linked-inspection-card mb-4">
            <div class="card-body p-4 p-xl-4">
                <div class="aocr-linked-inspection-layout">
                    <div>
                        <div class="aocr-linked-inspection-header">
                            <span class="aocr-linked-inspection-kicker">
                                <i class="fas fa-route"></i>
                                Continuar desde inspeccion
                            </span>
                            <span class="aocr-linked-inspection-status">@textoEstadoInspeccion(estadoInspeccionVinculada)</span>
                        </div>

                        <div class="aocr-linked-inspection-title mb-3">
                            <span class="aocr-linked-inspection-icon">
                                <i class="fas fa-clipboard-check"></i>
                            </span>
                            <div>
                                <div class="aocr-section-title mb-1">
                                    <span>Solicitud de inspeccion vinculada</span>
                                </div>
                                <div class="text-secondary small">El expediente AOCR ya migró a su bandeja operativa de inspección.</div>
                            </div>
                        </div>

                        <p class="aocr-linked-inspection-copy">
                            Este trámite ya tiene una inspección asociada. La revisión documental, observaciones, pago, LV/EAE e inicio operativo deben gestionarse desde el módulo de inspección para mantener la trazabilidad completa del proceso.
                        </p>

                        <div class="aocr-linked-inspection-summary">
                            <div class="aocr-linked-inspection-meta">
                                <span class="aocr-linked-inspection-meta-label">Inspeccion vinculada</span>
                                <div class="aocr-linked-inspection-meta-value">#@inspeccionVinculada.CodigoInspeccion</div>
                            </div>
                            <div class="aocr-linked-inspection-meta">
                                <span class="aocr-linked-inspection-meta-label">Inspector principal</span>
                                <div class="aocr-linked-inspection-meta-value">@inspectorAsignadoDetalle</div>
                            </div>
                            <div class="aocr-linked-inspection-meta">
                                <span class="aocr-linked-inspection-meta-label">Inspector de apoyo</span>
                                <div class="aocr-linked-inspection-meta-value">@inspectorApoyoDetalle</div>
                            </div>
                        </div>

                        <div class="aocr-linked-inspection-note">
                            @if (User.IsInRole("Inspector"))
                            {
                                <strong>Accion requerida:</strong><span> continúe su revisión técnica desde la inspección vinculada para ver las opciones operativas y los documentos del expediente.</span>
                            }
                            else
                            {
                                <strong>Referencia operativa:</strong><span> a partir de este punto el seguimiento principal del trámite continúa dentro del módulo de inspección.</span>
                            }
                        </div>
                    </div>

                    <div class="aocr-linked-inspection-actions">
                        <div>
                            <div class="aocr-section-title mb-2">
                                <i class="fas fa-arrow-right"></i>
                                <span>Siguiente paso</span>
                            </div>
                            <p class="aocr-linked-inspection-actions-copy">
                                Abra la inspección vinculada para continuar con la gestión del expediente y usar las acciones habilitadas para su rol actual.
                            </p>
                        </div>

                        @if (puedeAbrirInspeccionVinculada)
                        {
                            <a href="@urlInspeccionVinculada" class="btn btn-primary aocr-action-btn w-100">
                                <i class="fas fa-external-link-alt"></i>
                                Abrir inspeccion vinculada
                            </a>
                        }
                        else
                        {
                            <span class="btn btn-outline-secondary aocr-action-btn disabled w-100" aria-disabled="true">
                                <i class="fas fa-lock"></i>
                                Inspeccion vinculada disponible segun permisos
                            </span>
                        }
                    </div>
                </div>
            </div>
        </div>
    }

    @if (puedeSubsanar)
    {
        <div class="card border-info mb-4" style="border-left: 5px solid #17a2b8 !important;">
            <div class="card-body p-4">
                <div class="d-flex align-items-start gap-3">
                    <div class="text-info fs-3"><i class="fas fa-tools"></i></div>
                    <div class="flex-grow-1">
                        <h5 class="fw-bold text-info mb-1">Subsanar Solicitud</h5>
                        <p class="text-muted mb-3">Su solicitud ha sido observada. Corrija la documentación y vuelva a enviar para que sea revisada nuevamente.</p>
                        <a href="@Url.Action("Subsanar", "SolicitudAOCR", new { id = Model.CodigoSolicitud })" class="btn btn-info">
                            <i class="fas fa-edit me-1"></i> Corregir y Reenviar Solicitud
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="card aocr-detail-card aocr-action-card mb-4">
        <div class="card-body p-4">
            <div class="aocr-section-title">
                <i class="fas fa-folder-open"></i>
                <span>Gestion Documental</span>
            </div>

            @{
                var puedeGenerarAocr = !procesoCerradoOperativamente && (ViewBag.PuedeGenerarAOCR != null) && (bool)ViewBag.PuedeGenerarAOCR;
                var motivoAocr = ViewBag.MotivoGenerarAOCR as string;
                var aocrYaGenerado = (ViewBag.AocrYaGenerado != null) && (bool)ViewBag.AocrYaGenerado;
                var documentoAocr = ViewBag.DocumentoAOCRGenerado as CapaModelo.Documento;
            }

            <div class="aocr-action-grid">
                @if (aocrYaGenerado && documentoAocr != null)
                {
                    <div class="btn btn-success aocr-action-btn-full disabled" style="cursor: default;">
                        <i class="fas fa-check-circle"></i>
                        AOCR Generada
                        <small class="d-block" style="font-size: 0.78em; opacity: 0.9;">
                            @(documentoAocr.NombreArchivo)
                            @if (documentoAocr.FechaCarga.HasValue)
                            {
                                <text> — @documentoAocr.FechaCarga.Value.ToString("dd/MM/yyyy HH:mm")</text>
                            }
                        </small>
                    </div>
                    <a href="@Url.Action("DescargarAOCRGenerada", "SolicitudAOCR", new { id = Model.CodigoSolicitud, vistaPrevia = true })"
                       class="btn btn-outline-primary aocr-action-btn-full" target="_blank" rel="noopener">
                        <i class="fas fa-eye"></i>
                        Vista previa AOCR
                    </a>
                    <a href="@Url.Action("DescargarAOCRGenerada", "SolicitudAOCR", new { id = Model.CodigoSolicitud })"
                       class="btn btn-outline-success aocr-action-btn-full" target="_blank" rel="noopener">
                        <i class="fas fa-download"></i>
                        Descargar AOCR
                    </a>
                }
                else if (puedeGenerarAocr)
                {
                    using (Html.BeginForm("GenerarAOCR", "SolicitudAOCR", new { id = Model.CodigoSolicitud }, FormMethod.Post, new { style = "display:contents;" }))
                    {
                        @Html.AntiForgeryToken()
                        <button type="submit"
                                class="btn btn-primary aocr-action-btn-full"
                                onclick="return confirm('¿Confirma la generación automática del documento AOCR para esta solicitud?');"
                                title="@(string.IsNullOrWhiteSpace(motivoAocr) ? "Generar documento AOCR desde el sistema" : normalizeVisibleText(motivoAocr))">
                            <i class="fas fa-file-signature"></i>
                            Generar AOCR
                        </button>
                    }
                }
                else
                {
                    <button type="button"
                            class="btn btn-primary aocr-action-btn-full"
                            disabled="disabled"
                            title="@(procesoCerradoOperativamente
                                ? "El expediente está cerrado; solo permanece habilitada la consulta histórica y la Nueva Orden de Recaudación."
                                : (string.IsNullOrWhiteSpace(motivoAocr)
                                    ? "Disponible una vez la inspeccion sea satisfactoria y el informe tecnico quede firmado por el inspector"
                                    : normalizeVisibleText(motivoAocr)))"
                            style="opacity: 0.55; cursor: not-allowed;">
                        <i class="fas fa-file-signature"></i>
                        Generar AOCR
                    </button>
                }

                @Html.Partial("_DocumentoWorkflowActions", accesosDocumentalesSolicitudVm)
            </div>

            @if (!puedeGenerarAocr && !aocrYaGenerado)
            {
                <div class="alert alert-info mt-3 mb-0" style="font-size: 0.9em;">
                    <i class="fas fa-info-circle me-1"></i>
                    <strong>AOCR no disponible aún:</strong>
                    @(string.IsNullOrEmpty(motivoAocr)
                        ? "La AOCR estara disponible cuando el Informe Tecnico quede aprobado por Direccion/DIRDAC y la solicitud entre en fase AOCR."
                        : normalizeVisibleText(motivoAocr))
                </div>
            }
            else if (aocrYaGenerado)
            {
                <div class="alert alert-success mt-3 mb-0" style="font-size: 0.9em;">
                    <i class="fas fa-check-circle me-1"></i>
                    La AOCR de esta solicitud ya fue generada automáticamente por el sistema y está disponible en el expediente.
                </div>
            }
        </div>
    </div>

    @if (puedeInspectorDocumental)
    {
        var documentosRevision = (ViewBag.DocumentosSolicitud as List<Documento>) ?? new List<Documento>();
        var totalDocumentosRevision = documentosRevision.Count;
        var documentosRevisados = documentosRevision.Count(doc =>
        {
            var estadoDoc = (doc.Estado ?? string.Empty).Trim().ToUpperInvariant();
            Tuple<string, string> revisionActual;
            return revisionesDocumentales.TryGetValue(doc.CodigoDocumento, out revisionActual)
                   || RevisionDocumentalDisplayHelper.IsAcceptedState(estadoDoc)
                   || RevisionDocumentalDisplayHelper.IsReturnedState(estadoDoc)
                   || RevisionDocumentalDisplayHelper.IsModificationRequestedState(estadoDoc);
        });
        var documentosConObservacionPendiente = documentosRevision.Count(doc =>
        {
            Tuple<string, string> revisionActual;
            var decisionActual = string.Empty;
            var observacionActual = (doc.Observaciones ?? string.Empty).Trim();

            if (revisionesDocumentales.TryGetValue(doc.CodigoDocumento, out revisionActual) && revisionActual != null)
            {
                decisionActual = (revisionActual.Item1 ?? string.Empty).Trim().ToUpperInvariant();
                observacionActual = string.IsNullOrWhiteSpace(revisionActual.Item2) ? observacionActual : revisionActual.Item2.Trim();
            }
            else if (RevisionDocumentalDisplayHelper.IsModificationRequestedState(doc.Estado))
            {
                decisionActual = "OBSERVADO";
            }
            else if (RevisionDocumentalDisplayHelper.IsReturnedState(doc.Estado))
            {
                decisionActual = "DEVUELTO";
            }

            return (decisionActual == "DEVUELTO" || decisionActual == "OBSERVADO")
                   && string.IsNullOrWhiteSpace(observacionActual);
        });
        var documentosSinDecision = totalDocumentosRevision - documentosRevisados;
        var todosDocumentosAceptados = totalDocumentosRevision > 0 && documentosRevision.All(doc =>
        {
            Tuple<string, string> revisionActual;
            var decisionActual = revisionesDocumentales.TryGetValue(doc.CodigoDocumento, out revisionActual) && revisionActual != null
                ? (revisionActual.Item1 ?? string.Empty).Trim().ToUpperInvariant()
                : (RevisionDocumentalDisplayHelper.IsAcceptedState(doc.Estado)
                    ? "ACEPTADO"
                    : (RevisionDocumentalDisplayHelper.IsModificationRequestedState(doc.Estado)
                        ? "OBSERVADO"
                        : (RevisionDocumentalDisplayHelper.IsReturnedState(doc.Estado) ? "DEVUELTO" : string.Empty)));
            return decisionActual == "ACEPTADO";
        });
        var existeObservadoODevuelto = documentosRevision.Any(doc =>
        {
            Tuple<string, string> revisionActual;
            var decisionActual = revisionesDocumentales.TryGetValue(doc.CodigoDocumento, out revisionActual) && revisionActual != null
                ? (revisionActual.Item1 ?? string.Empty).Trim().ToUpperInvariant()
                : (RevisionDocumentalDisplayHelper.IsAcceptedState(doc.Estado)
                    ? "ACEPTADO"
                    : (RevisionDocumentalDisplayHelper.IsModificationRequestedState(doc.Estado)
                        ? "OBSERVADO"
                        : (RevisionDocumentalDisplayHelper.IsReturnedState(doc.Estado) ? "DEVUELTO" : string.Empty)));
            return decisionActual == "DEVUELTO" || decisionActual == "OBSERVADO";
        });

        <div id="revision-documental" class="card aocr-detail-card aocr-review-card success mb-4">
            <div id="documentos-rt-historial"></div>
            <div class="card-body p-4">
                <div class="aocr-section-title mb-3">
                    <i class="fas fa-clipboard-check"></i>
                    <span>Revisión documental</span>
                </div>
                <p class="text-muted mb-3">Revise cada documento vigente y registre su decisión. La solicitud solo podrá enviarse cuando todos los documentos tengan revisión y cada devolución/observación tenga su motivo.</p>

                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <div class="aocr-info-item">
                            <div class="aocr-info-label"><i class="fas fa-folder-open"></i> Documentos vigentes</div>
                            <div class="aocr-info-value">@totalDocumentosRevision</div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="aocr-info-item">
                            <div class="aocr-info-label"><i class="fas fa-check-circle"></i> Revisados</div>
                            <div class="aocr-info-value">@documentosRevisados / @totalDocumentosRevision</div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="aocr-info-item">
                            <div class="aocr-info-label"><i class="fas fa-exclamation-triangle"></i> Observaciones pendientes</div>
                            <div class="aocr-info-value">@documentosConObservacionPendiente</div>
                        </div>
                    </div>
                </div>

                @if (documentosRevision.Count == 0)
                {
                    <div class="alert alert-light mb-0">No existen documentos cargados para revisar en esta solicitud.</div>
                }
                else
                {
                    <div class="aocr-table-responsive">
                        <table class="table table-sm table-hover align-middle mb-0 aocr-doc-review-table">
                            <thead class="table-light">
                                <tr>
                                    <th>Documento</th>
                                    <th>Archivo</th>
                                    <th>Estado actual</th>
                                    <th>Resumen / trazabilidad</th>
                                    <th>Visualizar</th>
                                    <th>Descargar</th>
                                    <th>Decisión</th>
                                    <th>Observación</th>
                                    <th>Acción</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var doc in documentosRevision)
                                {
                                    var estadoDoc = (doc.Estado ?? "PENDIENTE").Trim().ToUpperInvariant();
                                    var formId = "frmRevisionDoc_" + doc.CodigoDocumento;
                                    Tuple<string, string> revisionActual;
                                    var tieneRevisionGuardada = revisionesDocumentales.TryGetValue(doc.CodigoDocumento, out revisionActual) && revisionActual != null;
                                    var decisionActual = tieneRevisionGuardada
                                        ? (revisionActual.Item1 ?? string.Empty).Trim().ToUpperInvariant()
                                        : (RevisionDocumentalDisplayHelper.IsAcceptedState(estadoDoc)
                                            ? "ACEPTADO"
                                            : (RevisionDocumentalDisplayHelper.IsModificationRequestedState(estadoDoc)
                                                ? "OBSERVADO"
                                                : (RevisionDocumentalDisplayHelper.IsReturnedState(estadoDoc) ? "DEVUELTO" : string.Empty)));
                                    var observacionActual = tieneRevisionGuardada
                                        ? normalizeVisibleText((revisionActual.Item2 ?? string.Empty).Trim())
                                        : normalizeVisibleText((doc.Observaciones ?? string.Empty).Trim());
                                    var estadoVisible = RevisionDocumentalDisplayHelper.GetVisibleStateLabel(estadoDoc);
                                    var claseBadge = RevisionDocumentalDisplayHelper.GetBadgeClass(estadoDoc);
                                    var fechaCargaTexto = doc.FechaCarga.HasValue ? doc.FechaCarga.Value.ToString("yyyy-MM-dd HH:mm") : "—";
                                    var usuarioRegistroTexto = normalizeVisibleText(doc.UsuarioRegistro ?? "—");
                                    var esSubsanacion = (doc.Version ?? 1) > 1;
                                    var etiquetaOrigen = esSubsanacion ? "Subsanación" : "Inicial";
                                    <tr>
                                        <td data-label="Documento">
                                            <div class="aocr-doc-name">@(string.IsNullOrWhiteSpace(doc.TipoDocumentoNombre) ? (string.IsNullOrWhiteSpace(doc.TipoDocumento) ? "Documento" : doc.TipoDocumento) : doc.TipoDocumentoNombre)</div>
                                            @if (!string.IsNullOrWhiteSpace(doc.TipoDocumentoCodigoCanonico) && !string.Equals(doc.TipoDocumentoCodigoCanonico, "OTRO", System.StringComparison.OrdinalIgnoreCase))
                                            {
                                                <span class="aocr-doc-code">@doc.TipoDocumentoCodigoCanonico</span>
                                            }
                                        </td>
                                        <td data-label="Archivo">
                                            <div class="fw-semibold">@Html.Encode(doc.NombreArchivo)</div>
                                            @if (!string.IsNullOrWhiteSpace(doc.NombreArchivoGuardado))
                                            {
                                                <small class="text-muted">@Html.Encode(doc.NombreArchivoGuardado)</small>
                                            }
                                        </td>
                                        <td data-label="Estado actual"><span class="@claseBadge">@estadoVisible</span></td>
                                        <td data-label="Resumen / trazabilidad">
                                            <div class="aocr-rt-summary-badges">
                                                <span class="badge bg-success">v@(doc.Version ?? 1)</span>
                                                <span class="badge @(esSubsanacion ? "bg-warning text-dark" : "bg-primary")">@etiquetaOrigen</span>
                                            </div>
                                            <div class="aocr-rt-summary-meta">
                                                <span><strong>Fecha:</strong> @fechaCargaTexto</span>
                                                <span><strong>Por:</strong> @Html.Encode(usuarioRegistroTexto)</span>
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(observacionActual) && (decisionActual == "DEVUELTO" || decisionActual == "OBSERVADO"))
                                            {
                                                <div class="aocr-rt-summary-note"><strong>Obs.:</strong> @Html.Encode(observacionActual)</div>
                                            }
                                        </td>
                                        <td data-label="Visualizar">
                                            @if (doc.PuedeVisualizar && !string.IsNullOrWhiteSpace(doc.UrlVisualizar))
                                            {
                                                <div class="aocr-doc-actions">
                                                    <a href="@doc.UrlVisualizar" class="btn btn-sm btn-outline-secondary" target="_blank" rel="noopener">
                                                        <i class="fas fa-eye"></i> Visualizar
                                                    </a>
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                        </td>
                                        <td data-label="Descargar">
                                            @if (doc.PuedeDescargar && !string.IsNullOrWhiteSpace(doc.UrlDescargar))
                                            {
                                                <div class="aocr-doc-actions">
                                                    <a href="@doc.UrlDescargar" class="btn btn-sm btn-outline-primary" target="_blank" rel="noopener">
                                                        <i class="fas fa-download"></i> Descargar
                                                    </a>
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                        </td>
                                        <td data-label="Decisión">
                                            <select name="decision" class="form-select form-select-sm js-decision-documental" data-codigo-documento="@doc.CodigoDocumento" required form="@formId">
                                                <option value="">Seleccione</option>
                                                <option value="ACEPTADO" @(decisionActual == "ACEPTADO" ? "selected" : null)>Aceptado</option>
                                                <option value="OBSERVADO" @(decisionActual == "OBSERVADO" ? "selected" : null)>Observado</option>
                                                <option value="DEVUELTO" @(decisionActual == "DEVUELTO" ? "selected" : null)>Devuelto / Rechazado</option>
                                            </select>
                                        </td>
                                        <td data-label="Observación">
                                            <input type="text" name="observacion" class="form-control form-control-sm js-observacion-documental aocr-doc-observation" data-codigo-documento="@doc.CodigoDocumento" placeholder="Observación del revisor" maxlength="500" value="@observacionActual" form="@formId" />
                                        </td>
                                        <td data-label="Acción">
                                            <form id="@formId" method="post" action="@Url.Action("RevisarDocumentoItem", "SolicitudAOCR")" class="d-inline js-form-revision-documental">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@Model.CodigoSolicitud" />
                                                <input type="hidden" name="codigoDocumento" value="@doc.CodigoDocumento" />
                                                <div class="aocr-action-buttons">
                                                    <button type="submit" class="btn btn-sm btn-primary">
                                                        <i class="fas fa-save"></i> Registrar
                                                    </button>
                                                </div>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="alert alert-light border mt-3 mb-0">
                        <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">
                            <div>
                                <div class="fw-semibold text-dark">Acción masiva de revisión documental</div>
                                <div class="text-muted small">Si todos están en Aceptado, puede aprobar masivamente. Si existe al menos un documento Observado/Devuelto, registre devolución/observaciones masivas.</div>
                                <div class="small mt-1 text-secondary">Sin decisión: <strong id="lblDocsSinDecision">@documentosSinDecision</strong> · Observaciones pendientes: <strong id="lblDocsObsPendientes">@documentosConObservacionPendiente</strong></div>
                            </div>
                            <form id="frmRevisionMasiva" method="post" action="@Url.Action("AccionMasivaRevisionDocumental", "SolicitudAOCR")" class="m-0">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@Model.CodigoSolicitud" />
                                <input type="hidden" name="tipoAccion" id="tipoAccionMasiva" value="" />
                                <input type="hidden" name="revisionesJson" id="revisionesJsonMasiva" value="" />
                                <div class="mb-2">
                                    <input type="text"
                                           class="form-control form-control-sm"
                                           name="observacionCoordinador"
                                           maxlength="500"
                                           placeholder="Observación opcional para coordinación (se registra en trazabilidad)." />
                                </div>
                                <div class="d-flex flex-wrap gap-2 justify-content-end">
                                    <button type="button"
                                            id="btnAprobarTodosDocumentos"
                                            class="btn btn-success aocr-action-btn"
                                            @((puedeFinalizarRevisionDocumental && !existeObservadoODevuelto) ? null : "disabled=\"disabled\"")>
                                        <i class="fas fa-check-double"></i>
                                        Aprobar todos los documentos
                                    </button>
                                    <button type="button"
                                            id="btnRegistrarObsMasiva"
                                            class="btn btn-outline-danger aocr-action-btn"
                                            @((puedeFinalizarRevisionDocumental && existeObservadoODevuelto) ? null : "disabled=\"disabled\"")>
                                        <i class="fas fa-comment-dots"></i>
                                        Registrar observaciones/devolución masiva
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    @if (puedeFirmarAceptacionDocumental)
    {
        <div class="card aocr-detail-card aocr-review-card success mb-4">
            <div class="card-body p-4">
                <div class="aocr-section-title mb-3">
                    <i class="fas fa-file-signature"></i>
                    <span>Autorizacion final</span>
                </div>
                <p class="text-muted mb-3">El inspector ya aceptó la solicitud y la factura. La coordinación debe firmar la autorización final antes de poner el PDF a disposición del RT.</p>
                <form method="post" action="@Url.Action("FirmarAceptacionDocumental", "SolicitudAOCR")">
                    @Html.AntiForgeryToken()
                    @Html.Hidden("id", Model.CodigoSolicitud)
                    <div class="row g-3 align-items-end">
                        <div class="col-md-8">
                            <label class="form-label fw-semibold" for="observacionAceptacion">Observacion de autorizacion</label>
                            <textarea class="form-control" id="observacionAceptacion" name="observacion" rows="3" placeholder="Constancia interna de la autorización final firmada."></textarea>
                        </div>
                        <div class="col-md-4 d-flex justify-content-end">
                            <button type="submit" class="btn btn-success aocr-action-btn w-100">
                                <i class="fas fa-pen-nib"></i>
                                Firmar autorizacion final
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    }

    @if (puedeDescargarAceptacionDocumental)
    {
        <div class="card aocr-detail-card aocr-review-card info mb-4">
            <div class="card-body p-4 d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">
                <div>
                    <div class="aocr-section-title mb-2">
                        <i class="fas fa-file-pdf"></i>
                        <span>Autorizacion final firmada</span>
                    </div>
                    <p class="text-muted mb-0">El documento de autorización final ya está listo para consulta y descarga.</p>
                    @if (esPropietario && estadoActual == EstadoSolicitud.FirmadoCoordinador)
                    {
                        <div class="small text-secondary mt-2">La primera descarga del RT cerrará esta fase como <strong>FINALIZADO</strong>.</div>
                    }
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <a href="@Url.Action("DescargarAceptacionDocumental", "SolicitudAOCR", new { id = Model.CodigoSolicitud, vistaPrevia = true })" class="btn btn-outline-secondary aocr-action-btn" target="_blank">
                        <i class="fas fa-eye"></i>
                        Vista previa
                    </a>
                    <a href="@Url.Action("DescargarAceptacionDocumental", "SolicitudAOCR", new { id = Model.CodigoSolicitud })" class="btn btn-outline-primary aocr-action-btn">
                        <i class="fas fa-download"></i>
                        Descargar autorizacion
                    </a>
                </div>
            </div>
        </div>
    }

    @if (puedeResolverRutaModificacion)
    {
        <div class="card aocr-detail-card aocr-review-card info mb-4">
            <div class="card-body p-4">
                <div class="aocr-section-title mb-3">
                    <i class="fas fa-code-branch"></i>
                    <span>Resolucion de modificacion</span>
                </div>
                <p class="text-muted mb-3">La documentación ya fue aceptada. El inspector debe resolver si la modificación continúa al módulo de inspección o si puede cerrarse con Condiciones y Limitaciones sin nueva inspección.</p>
                <form method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.CodigoSolicitud" />
                    <div class="row g-3 align-items-end">
                        <div class="col-md-8">
                            <label class="form-label fw-semibold" for="obsResolucionModificacion">Observacion del inspector</label>
                            <textarea class="form-control" id="obsResolucionModificacion" name="observacion" rows="3" placeholder="Fundamente si la modificación requiere inspección o si puede cerrar directo con Condiciones y Limitaciones."></textarea>
                        </div>
                        <div class="col-md-4">
                            <div class="aocr-review-actions">
                                <button formaction="@Url.Action("GenerarCondicionesLimitacionesModificacion", "SolicitudAOCR")" class="btn btn-success aocr-action-btn" type="submit">
                                    <i class="fas fa-file-contract"></i>
                                    No requiere nueva inspeccion
                                </button>
                                <button formaction="@Url.Action("MarcarRequiereInspeccionModificacion", "SolicitudAOCR")" class="btn btn-outline-warning aocr-action-btn" type="submit">
                                    <i class="fas fa-clipboard-list"></i>
                                    Derivar a inspeccion
                                </button>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
