@section scripts {
    <script>
        (function () {
            function requiereObservacion(decision) {
                return decision === "DEVUELTO" || decision === "OBSERVADO";
            }

            function obtenerFilasRevision() {
                var decisiones = Array.prototype.slice.call(document.querySelectorAll(".js-decision-documental"));
                return decisiones.map(function (controlDecision) {
                    var codigo = parseInt(controlDecision.getAttribute("data-codigo-documento") || "0", 10);
                    var observacion = document.querySelector('.js-observacion-documental[data-codigo-documento="' + codigo + '"]');
                    var decision = (controlDecision.value || "").trim().toUpperCase();
                    var textoObs = observacion ? (observacion.value || "").trim() : "";
                    return {
                        codigoDocumento: codigo,
                        decision: decision,
                        observacion: textoObs
                    };
                });
            }

            function evaluarAccionesMasivas() {
                var filas = obtenerFilasRevision();
                if (!filas.length) {
                    return;
                }

                var sinDecision = filas.filter(function (f) { return !f.decision; }).length;
                var obsPendientes = filas.filter(function (f) {
                    return requiereObservacion(f.decision) && !f.observacion;
                }).length;
                var existeObservadoODevuelto = filas.some(function (f) { return f.decision === "DEVUELTO" || f.decision === "OBSERVADO"; });

                var btnAprobar = document.getElementById("btnAprobarTodosDocumentos");
                var btnObs = document.getElementById("btnRegistrarObsMasiva");
                if (btnAprobar) {
                    btnAprobar.disabled = !!(existeObservadoODevuelto || obsPendientes > 0);
                }
                if (btnObs) {
                    btnObs.disabled = !(existeObservadoODevuelto && sinDecision === 0 && obsPendientes === 0);
                }

                var lblSinDecision = document.getElementById("lblDocsSinDecision");
                if (lblSinDecision) {
                    lblSinDecision.textContent = sinDecision;
                }
                var lblObsPendientes = document.getElementById("lblDocsObsPendientes");
                if (lblObsPendientes) {
                    lblObsPendientes.textContent = obsPendientes;
                }
            }

            function enviarAccionMasiva(tipoAccion) {
                var filas = obtenerFilasRevision();
                if (!filas.length) {
                    alert("No existen documentos para revisión masiva.");
                    return;
                }
                var existeObservadoODevuelto = filas.some(function (f) { return f.decision === "DEVUELTO" || f.decision === "OBSERVADO"; });

                if (tipoAccion === "APROBAR_TODOS") {
                    if (existeObservadoODevuelto) {
                        alert("No se puede aprobar masivamente mientras exista al menos un documento observado o devuelto.");
                        return;
                    }

                    filas = filas.map(function (fila) {
                        return {
                            codigoDocumento: fila.codigoDocumento,
                            decision: fila.decision || "ACEPTADO",
                            observacion: fila.decision === "ACEPTADO" ? "" : (fila.observacion || "")
                        };
                    });
                }

                var sinDecision = filas.filter(function (f) { return !f.decision; });
                if (sinDecision.length > 0) {
                    alert("No se puede ejecutar la acción masiva: existen documentos sin decisión.");
                    return;
                }

                var sinObs = filas.filter(function (f) { return requiereObservacion(f.decision) && !f.observacion; });
                if (sinObs.length > 0) {
                    alert("No se puede ejecutar la acción masiva: todo documento observado/devuelto requiere observación.");
                    return;
                }

                if (tipoAccion === "REGISTRAR_OBSERVACIONES" && !existeObservadoODevuelto) {
                    alert("Para registrar devolución/observaciones masivas debe existir al menos un documento observado o devuelto.");
                    return;
                }

                var tipoAccionInput = document.getElementById("tipoAccionMasiva");
                var revisionesJsonInput = document.getElementById("revisionesJsonMasiva");
                var form = document.getElementById("frmRevisionMasiva");
                if (!tipoAccionInput || !revisionesJsonInput || !form) {
                    return;
                }

                tipoAccionInput.value = tipoAccion;
                revisionesJsonInput.value = JSON.stringify(filas);
                form.submit();
            }

            document.querySelectorAll(".js-form-revision-documental").forEach(function (form) {
                form.addEventListener("submit", function (event) {
                    var decision = form.elements.namedItem("decision");
                    var observacion = form.elements.namedItem("observacion");
                    var valorDecision = decision ? (decision.value || "").trim().toUpperCase() : "";
                    var valorObservacion = observacion ? (observacion.value || "").trim() : "";

                    if (!valorDecision) {
                        event.preventDefault();
                        alert("Debe seleccionar una decisión para el documento.");
                        if (decision) {
                            decision.focus();
                        }
                        return;
                    }

                    if (requiereObservacion(valorDecision) && !valorObservacion) {
                        event.preventDefault();
                        alert("Debe registrar una observación cuando el documento sea devuelto u observado.");
                        if (observacion) {
                            observacion.focus();
                        }
                    }
                });
            });

            document.querySelectorAll(".js-decision-documental, .js-observacion-documental").forEach(function (control) {
                control.addEventListener("change", evaluarAccionesMasivas);
                control.addEventListener("input", evaluarAccionesMasivas);
            });

            var btnAprobarTodos = document.getElementById("btnAprobarTodosDocumentos");
            if (btnAprobarTodos) {
                btnAprobarTodos.addEventListener("click", function () {
                    enviarAccionMasiva("APROBAR_TODOS");
                });
            }

            var btnRegistrarObs = document.getElementById("btnRegistrarObsMasiva");
            if (btnRegistrarObs) {
                btnRegistrarObs.addEventListener("click", function () {
                    enviarAccionMasiva("REGISTRAR_OBSERVACIONES");
                });
            }

            evaluarAccionesMasivas();
        })();
    </script>
}
