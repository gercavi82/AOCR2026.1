@inherits System.Web.Mvc.WebViewPage<CapaModelo.SolicitudAOCR>
@using CapaDatos.Constants
@using CapaPresentacion.Helpers
@using CapaModelo
@using System.Collections.Generic
@using System.Linq
@using System.Web.Mvc
@using System.Web.Mvc.Html

@{
    ViewBag.Title = "Detalle de Solicitud AOCR";
    Layout = "~/Views/Shared/_LayoutAOCR.cshtml";

    if (Model == null)
    {
        ViewData.Model = new SolicitudAOCR
        {
            Estado = EstadoSolicitud.Pendiente
        };
        TempData["Warning"] = "La solicitud se cargó con información parcial. Algunas secciones pueden mostrarse en modo lectura.";
    }

    var normalizeVisibleText = new Func<string, string>(VisibleTextHelper.Normalize);
    var estadoActual = EstadoSolicitud.Normalizar(Model.Estado);
    var estadoVisibleExpediente = (ViewBag.EstadoDocumentalVisible as string ?? Model.Estado ?? string.Empty);
    var procesoCerradoOperativamente = (bool)(ViewBag.ProcesoCerradoOperativamente ?? false);
    var documentosObligatoriosFaltantes = (ViewBag.DocumentosObligatoriosFaltantes as List<string>) ?? new List<string>();
    var esSolicitudModificacion = Model.TipoSolicitud.GetValueOrDefault() == 3;
    var puedeInspectorDocumental =
        !procesoCerradoOperativamente &&
        User.IsInRole("Inspector") &&
        (estadoActual == EstadoSolicitud.Pendiente
         || estadoActual == EstadoSolicitud.EnRevision
         || estadoActual == EstadoSolicitud.DocumentacionPendiente
         || estadoActual == EstadoSolicitud.Subsanada
         || estadoActual == EstadoSolicitud.EnInspeccion);

    var revisionesDocumentales = ViewBag.RevisionesDocumentales as Dictionary<int, Tuple<string, string>>
        ?? new Dictionary<int, Tuple<string, string>>();
    var puedeFinalizarRevisionDocumental = (bool)(ViewBag.PuedeFinalizarRevisionDocumental ?? false);
    var inspeccionesSolicitud = ViewBag.InspeccionesSolicitud as IEnumerable<Inspeccion>
        ?? Enumerable.Empty<Inspeccion>();
    var inspeccionVinculada = inspeccionesSolicitud
        .Where(i => i != null && i.CodigoInspeccion > 0)
        .OrderByDescending(i => i.CodigoInspeccion)
        .FirstOrDefault();
    var estadoInspeccionVinculada = inspeccionVinculada != null
        ? EstadosInspeccion.NormalizarEstado(inspeccionVinculada.Estado)
        : string.Empty;
    Func<string, string> textoEstadoInspeccion = estado =>
    {
        if (string.IsNullOrWhiteSpace(estado))
        {
            return "SIN ESTADO";
        }

        switch (EstadosInspeccion.NormalizarEstado(estado))
        {
            case EstadosInspeccion.SOLICITUD_INSPECCION_CREADA:
                return "SOLICITUD CREADA";
            case EstadosInspeccion.VERIFICACION_SOLICITUD:
                return "VERIFICACION DE SOLICITUD";
            case EstadosInspeccion.ACEPTADA:
                return "ACEPTADA";
            case EstadosInspeccion.OBSERVADA:
                return "OBSERVADA";
            case EstadosInspeccion.SUBSANADA:
                return "SUBSANADA";
            case EstadosInspeccion.PAGO_VALIDADO:
                return "PAGO VALIDADO";
            case EstadosInspeccion.EN_INSPECCION:
                return "EN INSPECCION";
            default:
                return EstadosInspeccion.NormalizarEstado(estado).Replace("_", " ");
        }
    };
    var usuarioActualId = (int)(ViewBag.UsuarioActualId ?? 0);
    var esAdministradorVisualizacion = User.IsInRole("Administrador");
    var esPropietario = usuarioActualId > 0 && Model.CodigoUsuario == usuarioActualId;
    var puedeAbrirInspeccionVinculada = inspeccionVinculada != null &&
        (esPropietario
         || User.IsInRole("Inspector")
         || User.IsInRole("Coordinador")
         || User.IsInRole("CoordinadorInspecciones")
         || User.IsInRole("Administrador"));
    var urlDetalleSolicitudBase = Url.Action("Detalle", "SolicitudAOCR", new { id = Model.CodigoSolicitud });
    var urlVerDocumentacionSolicitud = string.IsNullOrWhiteSpace(urlDetalleSolicitudBase)
        ? string.Empty
        : urlDetalleSolicitudBase + "#revision-documental";
    var mostrarAccesoRevisionDocumental = User.IsInRole("Inspector") || User.IsInRole("Administrador");
    var puedeAbrirRevisionDocumentalDirecta =
        mostrarAccesoRevisionDocumental &&
        !procesoCerradoOperativamente &&
        (puedeInspectorDocumental || User.IsInRole("Administrador"));
    var urlRevisionDocumentalSolicitud = puedeAbrirRevisionDocumentalDirecta && !string.IsNullOrWhiteSpace(urlDetalleSolicitudBase)
        ? urlDetalleSolicitudBase + "#revision-documental"
        : string.Empty;
    var tituloBloqueoRevisionDocumental = procesoCerradoOperativamente
        ? "La revisión documental ya no está disponible porque el expediente cerró operativamente."
        : "La revisión documental se habilita únicamente para Inspector o Administrador en etapas documentales previas a la inspección.";
    var accesosDocumentalesSolicitudVm = new CapaPresentacion.Models.ViewModels.DocumentoWorkflowActionsVm
    {
        UrlVerDocumentacion = urlVerDocumentacionSolicitud,
        UrlRevisionDocumental = urlRevisionDocumentalSolicitud,
        MostrarRevisionDocumental = mostrarAccesoRevisionDocumental,
        PuedeAbrirRevisionDocumental = puedeAbrirRevisionDocumentalDirecta,
        TituloBloqueoRevisionDocumental = tituloBloqueoRevisionDocumental
    };
    var urlInspeccionVinculada = puedeAbrirInspeccionVinculada
        ? Url.Action("Detalle", "Inspeccion", new { id = inspeccionVinculada.CodigoInspeccion })
        : string.Empty;
    Func<string, string, string> resolverInspectorDetalle = (nombre, identificador) =>
    {
        var nombreLimpio = string.IsNullOrWhiteSpace(nombre) ? string.Empty : nombre.Trim();
        var identificadorLimpio = string.IsNullOrWhiteSpace(identificador) ? string.Empty : identificador.Trim();

        if (!string.IsNullOrWhiteSpace(nombreLimpio))
        {
            return nombreLimpio;
        }

        if (!string.IsNullOrWhiteSpace(identificadorLimpio))
        {
            return "Asignado (" + identificadorLimpio + ")";
        }

        return "Sin asignar";
    };
    var inspectorPrincipalNombre = !string.IsNullOrWhiteSpace(Model.TecnicoResponsableNombre)
        ? Model.TecnicoResponsableNombre
        : (inspeccionVinculada != null ? inspeccionVinculada.InspectorPrincipalNombre : null);
    var inspectorPrincipalIdentificador = !string.IsNullOrWhiteSpace(Model.TecnicoResponsableCedula)
        ? Model.TecnicoResponsableCedula
        : (inspeccionVinculada != null && !string.IsNullOrWhiteSpace(inspeccionVinculada.InspectorPrincipalCedula)
            ? inspeccionVinculada.InspectorPrincipalCedula
            : (Model.CodigoTecnico.HasValue
                ? Model.CodigoTecnico.Value.ToString()
                : (inspeccionVinculada != null && inspeccionVinculada.CodigoInspector.HasValue
                    ? inspeccionVinculada.CodigoInspector.Value.ToString()
                    : null)));
    var inspectorAsignadoDetalle = resolverInspectorDetalle(inspectorPrincipalNombre, inspectorPrincipalIdentificador);
    var inspectorApoyoNombre = !string.IsNullOrWhiteSpace(Model.InspectorApoyoNombre)
        ? Model.InspectorApoyoNombre
        : (inspeccionVinculada != null ? inspeccionVinculada.InspectorApoyoNombre : null);
    var inspectorApoyoIdentificador = !string.IsNullOrWhiteSpace(Model.InspectorApoyoCedula)
        ? Model.InspectorApoyoCedula
        : (inspeccionVinculada != null ? inspeccionVinculada.InspectorApoyoCedula : null);
    var inspectorApoyoDetalle = resolverInspectorDetalle(inspectorApoyoNombre, inspectorApoyoIdentificador);

    var puedeMarcarElaboracion =
        !procesoCerradoOperativamente &&
        (User.IsInRole("CoordinadorInspecciones") || User.IsInRole("Administrador")) &&
        estadoActual == EstadoSolicitud.EnInspeccion;

    var puedeMarcarRevision =
        !procesoCerradoOperativamente &&
        (User.IsInRole("JefaturaTecnica") || User.IsInRole("Administrador")) &&
        estadoActual == EstadoSolicitud.AOCR_EnElaboracion;

    var puedeValidarJefatura =
        !procesoCerradoOperativamente &&
        (User.IsInRole("JefaturaTecnica") || User.IsInRole("Administrador")) &&
        estadoActual == EstadoSolicitud.AOCR_EnRevision;

    var puedeLegalizar =
        !procesoCerradoOperativamente &&
        (User.IsInRole("CoordinacionLegal") || User.IsInRole("DirectorGeneral") || User.IsInRole("Administrador")) &&
        (estadoActual == EstadoSolicitud.AOCR_Validado || estadoActual == EstadoSolicitud.Aprobada);

    var puedeEmitirAocr =
        !procesoCerradoOperativamente &&
        (User.IsInRole("CoordinacionLegal") || User.IsInRole("DirectorGeneral") || User.IsInRole("Administrador")) &&
        estadoActual == EstadoSolicitud.AOCR_Legalizado;
    var mensajeExito = (TempData["Exito"] ?? TempData["success"]) as string;
    var mensajeError = (TempData["Error"] ?? TempData["error"]) as string;
    var mensajeWarning = TempData["Warning"] as string;
    var tieneInspectorAsignado = Model.CodigoTecnico.HasValue
        || !string.IsNullOrWhiteSpace(Model.TecnicoResponsableCedula)
        || !string.IsNullOrWhiteSpace(Model.TecnicoResponsableNombre);
    var puedeSubsanar = !procesoCerradoOperativamente && esPropietario && estadoActual == EstadoSolicitud.Observada;
    var puedeFirmarAceptacionDocumental =
        !procesoCerradoOperativamente &&
        !esSolicitudModificacion &&
        (User.IsInRole("Coordinador") || User.IsInRole("CoordinadorInspecciones") || User.IsInRole("Administrador")) &&
        estadoActual == EstadoSolicitud.AceptacionDocumental;
    var puedeDescargarAceptacionDocumental =
        !esSolicitudModificacion &&
        (esPropietario || User.IsInRole("Coordinador") || User.IsInRole("CoordinadorInspecciones") || User.IsInRole("Administrador")) &&
        (estadoActual == EstadoSolicitud.FirmadoCoordinador || estadoActual == EstadoSolicitud.Finalizado);
    var puedeResolverRutaModificacion =
        !procesoCerradoOperativamente &&
        esSolicitudModificacion &&
        (User.IsInRole("Inspector") || User.IsInRole("Administrador")) &&
        estadoActual == EstadoSolicitud.AceptacionDocumental;
    var puedePrepararCondicionesModificacion =
        !procesoCerradoOperativamente &&
        esSolicitudModificacion &&
        (User.IsInRole("Inspector")
         || User.IsInRole("CoordinacionLegal")
         || User.IsInRole("CoordinadorLegal")
         || User.IsInRole("Coordinador")
         || User.IsInRole("CoordinadorInspecciones")
         || User.IsInRole("DIRDAC")
         || User.IsInRole("Direccion")
         || User.IsInRole("DirectorGeneral")
         || User.IsInRole("JefaturaTecnica")
         || User.IsInRole("Administrador")) &&
        (estadoActual == EstadoSolicitud.GeneradoCondicionesLimitaciones
         || estadoActual == EstadoSolicitud.EnRevisionCoordinadorFinal);
    var puedeRevisarCondicionesModificacion =
        !procesoCerradoOperativamente &&
        esSolicitudModificacion &&
        (User.IsInRole("Coordinador") || User.IsInRole("CoordinadorInspecciones") || User.IsInRole("Administrador")) &&
        estadoActual == EstadoSolicitud.GeneradoCondicionesLimitaciones;
    var puedeEnviarCondicionesDcav =
        !procesoCerradoOperativamente &&
        esSolicitudModificacion &&
        (User.IsInRole("Coordinador") || User.IsInRole("CoordinadorInspecciones") || User.IsInRole("Administrador")) &&
        estadoActual == EstadoSolicitud.EnRevisionCoordinadorFinal;
    var puedeFirmarCondicionesModificacion =
        !procesoCerradoOperativamente &&
        esSolicitudModificacion &&
        (User.IsInRole("DIRDAC")
         || User.IsInRole("Direccion")
         || User.IsInRole("DirectorGeneral")
         || User.IsInRole("JefaturaTecnica")
         || User.IsInRole("Administrador")) &&
        estadoActual == EstadoSolicitud.EnviadoDcav;
    var puedeDescargarCondicionesModificacion =
        esSolicitudModificacion &&
        (esPropietario
         || User.IsInRole("DIRDAC")
         || User.IsInRole("Direccion")
         || User.IsInRole("DirectorGeneral")
         || User.IsInRole("JefaturaTecnica")
         || User.IsInRole("Coordinador")
         || User.IsInRole("CoordinadorInspecciones")
         || User.IsInRole("Administrador")) &&
        (estadoActual == EstadoSolicitud.FirmadoDcav || estadoActual == EstadoSolicitud.Finalizado);
    var puedeIniciarNuevaOrden = esPropietario || User.IsInRole("Solicitante");
    var urlNuevaOrden = Url.Action("Index", "SolicitudAOCR", new { tipoSolicitud = 1, abrirModal = true });

    var direccionCompleta = string.Join(", ", new[]
    {
        Model.Direccion,
        (string.Concat(Model.Ciudad, " ", Model.Provincia)).Trim(),
        Model.Pais
    }.Where(x => !string.IsNullOrWhiteSpace(x)));

    Func<string, string> estadoCss = estado =>
    {
        var normalized = EstadoSolicitud.Normalizar(estado);
        if (normalized == EstadoSolicitud.Observada)
        {
            return "aocr-badge danger";
        }

        if (normalized == EstadoSolicitud.AOCR_Validado
            || normalized == EstadoSolicitud.AceptacionDocumental
            || normalized == EstadoSolicitud.FirmadoCoordinador
            || normalized == EstadoSolicitud.FirmadoDcav
            || normalized == EstadoSolicitud.Finalizado
            || normalized == EstadoSolicitud.AOCR_Legalizado
            || normalized == EstadoSolicitud.AOCR_EmitidoRecibido
            || normalized == EstadoSolicitud.Aprobada)
        {
            return "aocr-badge success";
        }

        if (normalized == EstadoSolicitud.EnRevision
            || normalized == EstadoSolicitud.AOCR_EnRevision
            || normalized == EstadoSolicitud.AOCR_EnElaboracion
            || normalized == EstadoSolicitud.RequiereInspeccion
            || normalized == EstadoSolicitud.GeneradoCondicionesLimitaciones
            || normalized == EstadoSolicitud.EnRevisionCoordinadorFinal
            || normalized == EstadoSolicitud.EnviadoDcav
            || normalized == EstadoSolicitud.EnInspeccion)
        {
            return "aocr-badge info";
        }

        return "aocr-badge warning";
    };
}

<style>
    .aocr-detail-shell {
        padding: clamp(1rem, 2vw, 1.5rem) 0 2rem;
    }

    .aocr-detail-card {
        border: 0;
        border-radius: 18px;
        box-shadow: 0 18px 40px rgba(14, 30, 62, 0.08);
        overflow: hidden;
    }

    .aocr-hero {
        background: linear-gradient(135deg, #0f3d75 0%, #174f97 55%, #2f6dbc 100%);
        color: #fff;
    }

    .aocr-hero .card-body {
        padding: 1.75rem;
    }

    .aocr-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.4rem 0.75rem;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.14);
        font-size: 0.8rem;
        letter-spacing: 0.03em;
        text-transform: uppercase;
    }

    .aocr-hero-title {
        font-size: clamp(1.5rem, 4vw, 2rem);
        font-weight: 700;
        margin: 1rem 0 0.5rem;
    }

    .aocr-hero-subtitle {
        color: rgba(255, 255, 255, 0.84);
        margin-bottom: 0;
    }

    .aocr-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 132px;
        padding: 0.65rem 0.95rem;
        border-radius: 999px;
        font-size: 0.84rem;
        font-weight: 700;
        letter-spacing: 0.02em;
    }

    .aocr-badge.success {
        background: #dcfce7;
        color: #166534;
    }

    .aocr-badge.warning {
        background: #fef3c7;
        color: #92400e;
    }

    .aocr-badge.danger {
        background: #fee2e2;
        color: #b91c1c;
    }

    .aocr-badge.info {
        background: #dbeafe;
        color: #1d4ed8;
    }

    .aocr-summary-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 0.85rem;
        margin-top: 1.25rem;
    }

    .aocr-summary-item {
        background: rgba(255, 255, 255, 0.12);
        border: 1px solid rgba(255, 255, 255, 0.14);
        border-radius: 14px;
        padding: 0.9rem 1rem;
    }

    .aocr-summary-label {
        font-size: 0.78rem;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: rgba(255, 255, 255, 0.72);
        margin-bottom: 0.35rem;
    }

    .aocr-summary-value {
        font-size: 1rem;
        font-weight: 600;
        color: #fff;
    }

    .aocr-section-title {
        display: flex;
        align-items: center;
        gap: 0.7rem;
        font-size: 1.05rem;
        font-weight: 700;
        color: #16365f;
        margin-bottom: 1rem;
    }

    .aocr-section-title i {
        width: 40px;
        height: 40px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        background: #e8f1fb;
        color: #1e5aa8;
    }

    .aocr-info-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 1rem;
    }

    .aocr-info-item {
        padding: 0.95rem 1rem;
        border-radius: 14px;
        background: #f8fbff;
        border: 1px solid #e4edf7;
    }

    .aocr-info-label {
        display: flex;
        align-items: center;
        gap: 0.55rem;
        font-size: 0.8rem;
        font-weight: 700;
        text-transform: uppercase;
        color: #5f738c;
        margin-bottom: 0.45rem;
    }

    .aocr-info-label i {
        color: #1e5aa8;
    }

    .aocr-info-value {
        color: #102a43;
        font-weight: 600;
        line-height: 1.45;
    }

    .aocr-action-card {
        border: 1px solid #d8e4f2;
        background: linear-gradient(180deg, #ffffff 0%, #f8fbff 100%);
    }

    .aocr-action-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 1rem;
    }

    .aocr-action-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        border-radius: 8px;
        font-weight: 600;
        font-size: 0.875rem;
        padding: 0.5rem 1.25rem;
        white-space: nowrap;
    }

    .aocr-action-btn-full {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.6rem;
        width: 100%;
        min-height: 52px;
        border-radius: 14px;
        font-weight: 600;
    }

    .aocr-action-btn-full.aocr-action-btn-full--stacked {
        justify-content: flex-start;
        align-items: flex-start;
        flex-direction: column;
        gap: 0.2rem;
        padding: 0.85rem 1rem;
        text-align: left;
    }

    .aocr-action-btn-full__title {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        font-weight: 700;
        line-height: 1.2;
    }

    .aocr-action-btn-full__hint {
        display: block;
        font-size: 0.78rem;
        line-height: 1.35;
        opacity: 0.82;
        font-weight: 500;
        margin-left: 1.8rem;
    }

    .aocr-review-actions {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        justify-content: flex-end;
        height: 100%;
    }

    .aocr-review-actions .btn {
        width: 100%;
    }

    .aocr-review-card {
        border-left: 5px solid #1e5aa8;
    }

    .aocr-review-card.success {
        border-left-color: #1f7a3b;
    }

    .aocr-review-card.warning {
        border-left-color: #d97706;
    }

    .aocr-review-card.info {
        border-left-color: #2563eb;
    }

    .aocr-review-card.legal {
        border-left-color: #0f766e;
    }

    .aocr-review-card.emit {
        border-left-color: #166534;
    }

    .aocr-linked-inspection-card {
        border-left-width: 6px;
        background: linear-gradient(135deg, #fffaf0 0%, #ffffff 55%, #f6f9ff 100%);
        box-shadow: 0 18px 36px -28px rgba(30, 90, 168, 0.45);
    }

    .aocr-linked-inspection-layout {
        display: grid;
        gap: 1.5rem;
        grid-template-columns: minmax(0, 1.65fr) minmax(260px, 0.95fr);
        align-items: stretch;
    }

    .aocr-linked-inspection-header {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.85rem;
        margin-bottom: 0.9rem;
    }

    .aocr-linked-inspection-kicker {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        padding: 0.35rem 0.75rem;
        border-radius: 999px;
        background: rgba(217, 119, 6, 0.12);
        color: #9a3412;
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        text-transform: uppercase;
    }

    .aocr-linked-inspection-title {
        display: flex;
        align-items: center;
        gap: 0.85rem;
        color: #153e75;
    }

    .aocr-linked-inspection-icon {
        width: 3rem;
        height: 3rem;
        border-radius: 1rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #eff6ff 0%, #e0ecff 100%);
        color: #2563eb;
        font-size: 1.15rem;
        box-shadow: inset 0 0 0 1px rgba(37, 99, 235, 0.08);
    }

    .aocr-linked-inspection-status {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.5rem 0.95rem;
        border-radius: 999px;
        background: rgba(21, 94, 117, 0.1);
        color: #155e75;
        font-size: 0.82rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.03em;
    }

    .aocr-linked-inspection-copy {
        color: #4a5d75;
        line-height: 1.7;
        margin-bottom: 1rem;
    }

    .aocr-linked-inspection-summary {
        display: grid;
        gap: 0.85rem;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    }

    .aocr-linked-inspection-meta {
        border: 1px solid rgba(15, 23, 42, 0.08);
        border-radius: 1rem;
        background: rgba(255, 255, 255, 0.88);
        padding: 0.95rem 1rem;
    }

    .aocr-linked-inspection-meta-label {
        display: block;
        color: #6b7280;
        font-size: 0.76rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-bottom: 0.35rem;
    }

    .aocr-linked-inspection-meta-value {
        color: #153e75;
        font-weight: 700;
        line-height: 1.45;
    }

    .aocr-linked-inspection-note {
        margin-top: 1rem;
        padding: 0.9rem 1rem;
        border-radius: 0.95rem;
        background: rgba(30, 90, 168, 0.06);
        color: #234a83;
        font-size: 0.92rem;
        line-height: 1.6;
    }

    .aocr-linked-inspection-actions {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 1rem;
        border: 1px solid rgba(37, 99, 235, 0.14);
        border-radius: 1.15rem;
        background: rgba(255, 255, 255, 0.94);
        padding: 1.2rem;
    }

    .aocr-linked-inspection-actions-copy {
        color: #4a5d75;
        line-height: 1.65;
        margin: 0;
    }

