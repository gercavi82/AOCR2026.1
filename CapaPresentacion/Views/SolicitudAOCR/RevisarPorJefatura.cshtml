@inherits System.Web.Mvc.WebViewPage<List<CapaModelo.SolicitudAOCR>>
@using CapaModelo
@using System.Web.Mvc
@using System.Web.Mvc.Html

@{
    ViewBag.Title = "Validación por Jefatura Técnica";
    Layout = "~/Views/Shared/_LayoutAOCR.cshtml";
}

<h3>Solicitudes pendientes de Validación Técnica</h3>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Código</th>
            <th>Operador</th>
            <th>Fecha</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var sol in Model)
        {
            <tr>
                <td>@Html.Encode(sol.CodigoSolicitud)</td>
                <td>@Html.Encode(sol.NombreOperador)</td>
                <td>@Html.Encode(sol.FechaSolicitud.HasValue ? sol.FechaSolicitud.Value.ToString("yyyy-MM-dd") : "")</td>
                <td>@Html.Encode(sol.Estado)</td>
                <td>
                    @Html.ActionLink("Ver Detalle", "Detalle", "SolicitudAOCR", new { id = sol.CodigoSolicitud }, new { @class = "btn btn-info btn-sm" })
                </td>
            </tr>
        }
    </tbody>
</table>



