@model CapaModelo.Checklist
@{
    ViewData["Title"] = "Crear Checklist";
    Layout = "~/Views/Shared/_Layout.cshtml"; // Ajusta si usas otro layout
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card shadow">
                <div class="card-header bg-success text-white">
                    <h4><i class="fas fa-clipboard-list"></i> Crear Nuevo Checklist</h4>
                </div>
                <div class="card-body">
                    @using (Html.BeginForm("Crear", "Checklist", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()

                        <div class="row">
                            <div class="col-md-8 mb-3">
                                @Html.LabelFor(m => m.Seccion, new { @class = "form-label" })
                                @Html.TextBoxFor(m => m.Seccion, new { @class = "form-control", placeholder = "Ej: Seguridad Eléctrica", required = "required" })
                                @Html.ValidationMessageFor(m => m.Seccion, "", new { @class = "text-danger" })
                            </div>

                            <div class="col-md-4 mb-3">
                                <label for="UsuarioId" class="form-label">Usuario Responsable *</label>
                                <select name="UsuarioId" class="form-select" required>
                                    <option value="">Seleccione...</option>
                                    @foreach (var u in ViewBag.Usuarios)
                                    {
                                        <option value="@u.Id">@u.Nombres @u.Apellidos</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(m => m.Descripcion, new { @class = "form-label" })
                            @Html.TextAreaFor(m => m.Descripcion, new { @class = "form-control", rows = 3, placeholder = "Descripción general del checklist..." })
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Items del Checklist *</label>
                            <div id="itemsContainer">
                                <div class="input-group mb-2">
                                    <input type="text" class="form-control" name="items[]" placeholder="Descripción del ítem" required />
                                    <button type="button" class="btn btn-danger btnRemoverItem">
                                        <i class="fas fa-minus"></i>
                                    </button>
                                </div>
                            </div>
                            <button type="button" class="btn btn-sm btn-primary" id="btnAgregarItem">
                                <i class="fas fa-plus"></i> Agregar Item
                            </button>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Fecha de Inicio</label>
                                <input type="date" name="FechaInicio" class="form-control" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Fecha de Finalización</label>
                                <input type="date" name="FechaFin" class="form-control" />
                            </div>
                        </div>

                        <div class="form-check mb-3">
                            @Html.CheckBoxFor(m => m.Activo, new { @class = "form-check-input", @checked = "checked" })
                            @Html.LabelFor(m => m.Activo, new { @class = "form-check-label" })
                        </div>

                        <div class="alert alert-info">
                            <i class="fas fa-info-circle"></i>
                            Los ítems pueden ser agregados o modificados más adelante desde la opción de editar.
                        </div>

                        <hr />

                        <div class="d-flex justify-content-between">
                            <a href="@Url.Action("Index", "Checklist")" class="btn btn-secondary">
                                <i class="fas fa-arrow-left"></i> Cancelar
                            </a>
                            <button type="submit" class="btn btn-success">
                                <i class="fas fa-save"></i> Guardar Checklist
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function () {
            $('#btnAgregarItem').click(function () {
                var nuevoItem = `
                        <div class="input-group mb-2">
                            <input type="text" class="form-control" name="items[]" placeholder="Descripción del ítem" required />
                            <button type="button" class="btn btn-danger btnRemoverItem">
                                <i class="fas fa-minus"></i>
                            </button>
                        </div>`;
                $('#itemsContainer').append(nuevoItem);
            });

            $(document).on('click', '.btnRemoverItem', function () {
                if ($('#itemsContainer .input-group').length > 1) {
                    $(this).closest('.input-group').remove();
                } else {
                    Swal.fire('Atención', 'Debe tener al menos un ítem', 'warning');
                }
            });
        });
    </script>
}
