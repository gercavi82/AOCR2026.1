            var documentoDevolverOperadora = document.getElementById('DocumentoDevolverOperadora');
            var btnConfirmarDevolucion = document.getElementById('btnConfirmarDevolucion');

            function escapeHtml(value) {
                var div = document.createElement('div');
                div.textContent = value == null ? '' : String(value);
                return div.innerHTML;
            }

            function decodeHtmlEntities(value) {
                var actual = value == null ? '' : String(value);
                var textarea = document.createElement('textarea');

                for (var i = 0; i < 3; i++) {
                    textarea.innerHTML = actual;
                    var decodificado = textarea.value;
                    if (decodificado === actual) {
                        break;
                    }

                    actual = decodificado;
                }

                return actual;
            }

            function normalizeObservationCell(element) {
                if (!element) {
                    return;
                }

                if (element.querySelector && element.querySelector('textarea, select, input')) {
                    return;
                }

                var texto = decodeHtmlEntities(element.textContent || '').trim();
                if (texto) {
                    element.textContent = texto;
                }
            }

            function normalizeDecisionValue(value) {
                var normalized = (value || '').trim().toUpperCase();
                if (normalized === 'RECHAZADO') {
                    return 'DEVUELTO_INSPECTOR';
                }
                if (normalized === 'ACEPTAR') {
                    return 'ACEPTADO';
                }
                if (normalized === 'DEVOLVER' || normalized === 'DEVUELTO' || normalized === 'OBSERVADO') {
                    return 'DEVUELTO_INSPECTOR';
                }
                return normalized;
            }

            function getElementsByDocument(documentId, selector) {
                if (!documentId) {
                    return [];
                }
                return Array.prototype.slice.call(document.querySelectorAll(selector + '[data-document-id="' + documentId + '"]'));
            }

            function syncDecisionState(documentId, decision, sourceCombo) {
                var normalizedDecision = normalizeDecisionValue(decision);
                var combos = getElementsByDocument(documentId, '.js-decision-combo');
                var observaciones = getElementsByDocument(documentId, '.js-decision-observacion');
                var requiresObservation = normalizedDecision === 'DEVUELTO_INSPECTOR';
                var estadoVista = requiresObservation
                    ? 'RECHAZADO'
                    : (normalizedDecision === 'ACEPTADO' ? 'ACEPTADO' : 'PENDIENTE');

                combos.forEach(function (combo) {
                    if (sourceCombo && combo === sourceCombo) {
                        return;
                    }
                    combo.value = normalizedDecision || 'PENDIENTE';
                });

                observaciones.forEach(function (observacion) {
                    if (requiresObservation) {
                        observacion.classList.remove('d-none');
                        observacion.required = true;
                    } else {
                        observacion.classList.add('d-none');
                        observacion.required = false;
                    }
                });

                document.querySelectorAll('[data-document-id="' + documentId + '"][data-doc-revision="true"]').forEach(function (item) {
                    item.setAttribute('data-estado', estadoVista);
                    item.classList.toggle('aocr-review-row-rejected', requiresObservation);
                });
            }

            function syncObservationValue(documentId, value, sourceElement) {
                var observaciones = getElementsByDocument(documentId, '.js-decision-observacion');
                observaciones.forEach(function (observacion) {
                    if (sourceElement && observacion === sourceElement) {
                        return;
                    }
                    observacion.value = value;
                });
            }

            function showAlert(type, message) {
                if (!alertContainer) {
                    return;
                }

                alertContainer.innerHTML = [
                    '<div class="alert alert-', escapeHtml(type), ' alert-dismissible fade show mb-3" role="alert">',
                    escapeHtml(message || ''),
                    '<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>',
                    '</div>'
                ].join('');
            }

            function getModalInstance() {
                if (!modalElemento) {
                    return null;
                }

                if (window.bootstrap && typeof window.bootstrap.Modal === 'function') {
                    return window.bootstrap.Modal.getOrCreateInstance(modalElemento, {
                        backdrop: 'static',
                        keyboard: false
                    });
                }

                return null;
            }

            function showModal() {
                var modal = getModalInstance();
                if (modal) {
                    modal.show();
                    return;
                }

                if (window.jQuery && window.jQuery.fn && window.jQuery.fn.modal) {
                    window.jQuery(modalElemento).modal('show');
                }
            }

            function hideModal() {
                var modal = getModalInstance();
                if (modal) {
                    modal.hide();
                    return;
                }

                if (window.jQuery && window.jQuery.fn && window.jQuery.fn.modal) {
                    window.jQuery(modalElemento).modal('hide');
                }
            }

            function buildActionsHtml(doc) {
                var html = ['<div class="documentos-actions aocr-actions-icons">'];

                if (doc.esPdf && doc.previewUrl) {
                    html.push(
                        '<a href="', escapeHtml(doc.previewUrl), '" class="btn btn-sm aocr-icon-btn aocr-pdf-open"',
                        ' data-pdf-url="', escapeHtml(doc.previewUrl), '"',
                        ' data-download-url="', escapeHtml(doc.downloadUrl || ''), '"',
                        ' data-title="', escapeHtml(doc.archivo || ''), '"',
                        ' data-status="', escapeHtml(doc.estado || ''), '"',
                        ' title="Vista previa" aria-label="Vista previa de ', escapeHtml(doc.archivo || 'documento'), '" data-bs-toggle="tooltip">',
                        '<i class="fas fa-eye" aria-hidden="true"></i></a>'
                    );
                }

                html.push(
                    '<a href="', escapeHtml(doc.downloadUrl || ''), '" class="btn btn-sm aocr-icon-btn"',
                    ' title="Descargar" aria-label="Descargar ', escapeHtml(doc.archivo || 'documento'), '" data-bs-toggle="tooltip">',
                    '<i class="fas fa-download" aria-hidden="true"></i></a>'
                );

                if (doc.puedeAceptar && !revisionDocumentalMasiva) {
                    html.push(
                        '<button type="button" class="btn btn-sm btn-success btn-aceptar-documento" data-id="', escapeHtml(doc.id), '"',
                        ' title="Aceptar" aria-label="Aceptar ', escapeHtml(doc.archivo || 'documento'), '" data-bs-toggle="tooltip">',
                        '<i class="fas fa-check" aria-hidden="true"></i></button>'
                    );
                }

                if (doc.puedeDevolver && !revisionDocumentalMasiva) {
                    html.push(
                        '<button type="button" class="btn btn-sm btn-outline-danger btn-devolver-documento"',
                        ' data-id="', escapeHtml(doc.id), '"',
                        ' data-tipo="', escapeHtml(doc.tipo || ''), '"',
                        ' data-nombre="', escapeHtml(doc.archivo || ''), '"',
                        ' data-operadora="', escapeHtml(doc.operadora || ''), '"',
                        ' title="Devolver" aria-label="Devolver ', escapeHtml(doc.archivo || 'documento'), '" data-bs-toggle="tooltip">',
                        '<i class="fas fa-undo" aria-hidden="true"></i></button>'
                    );
                }

                if (doc.puedeReabrir) {
                    html.push(
                        '<button type="button" class="btn btn-sm btn-outline-warning btn-reabrir-documento" data-id="', escapeHtml(doc.id), '"',
                        ' title="Reabrir" aria-label="Reabrir ', escapeHtml(doc.archivo || 'documento'), '" data-bs-toggle="tooltip">',
                        '<i class="fas fa-rotate-left" aria-hidden="true"></i></button>'
                    );
                }

                html.push('</div>');
                return html.join('');
            }

            function setMetricValue(id, value) {
                var elemento = document.getElementById(id);
                if (elemento) {
                    elemento.textContent = value;
                }
            }

            function recalculateMetrics() {
                var filas = tabla.querySelectorAll('tbody tr[data-document-id]');
                var total = 0;
                var pendientes = 0;
                var aceptados = 0;
                var devueltos = 0;

                filas.forEach(function (fila) {
                    if (fila.style.display === 'none') {
                        return;
                    }

                    total += 1;
                    var estado = (fila.getAttribute('data-estado') || '').toUpperCase();
                    if (estado === 'APROBADO') {
                        aceptados += 1;
                    } else if (estado === 'RECHAZADO' || estado === 'OBSERVADO') {
                        devueltos += 1;
                    } else {
                        pendientes += 1;
                    }
                });

                setMetricValue('metricTotalDocs', total);
                setMetricValue('metricPendientesDocs', pendientes);
                setMetricValue('metricAceptadosDocs', aceptados);
                setMetricValue('metricDevueltosDocs', devueltos);

                if (filaSinResultados) {
                    filaSinResultados.style.display = total === 0 ? '' : 'none';
                }
            }

            function parseDateOnly(value) {
                if (!value) {
                    return null;
                }

                var parsed = new Date(value + 'T00:00:00');
                return isNaN(parsed.getTime()) ? null : parsed;
            }

            function matchesQuickDate(rowDateValue, quickFilterValue) {
                if (!quickFilterValue) {
                    return true;
                }

                var rowDate = parseDateOnly(rowDateValue);
                if (!rowDate) {
                    return false;
                }

                var today = new Date();
                today.setHours(0, 0, 0, 0);

                if (quickFilterValue === 'hoy') {
                    return rowDate.getTime() === today.getTime();
                }

                if (quickFilterValue === '7dias' || quickFilterValue === '30dias') {
                    var days = quickFilterValue === '7dias' ? 7 : 30;
                    var start = new Date(today.getTime());
                    start.setDate(start.getDate() - (days - 1));
                    return rowDate >= start && rowDate <= today;
                }

                return true;
            }

            function matchesRange(rowDateValue, desdeValue, hastaValue) {
                if (!desdeValue && !hastaValue) {
                    return true;
                }

                var rowDate = parseDateOnly(rowDateValue);
                if (!rowDate) {
                    return false;
                }

                var desde = parseDateOnly(desdeValue);
                var hasta = parseDateOnly(hastaValue);

                if (desde && rowDate < desde) {
                    return false;
                }

                if (hasta && rowDate > hasta) {
                    return false;
                }

                return true;
            }

            function applyFilters() {
                var filas = tabla.querySelectorAll('tbody tr[data-document-id]');
                var cards = listaMobile ? listaMobile.querySelectorAll('.js-review-mobile-card[data-document-id]') : [];
                var tipo = filtroTipo ? filtroTipo.value : '';
                var operadora = filtroOperadora ? filtroOperadora.value : '';
                var quickDate = filtroFechaRapida ? filtroFechaRapida.value : '';
                var desde = filtroFechaDesde ? filtroFechaDesde.value : '';
                var hasta = filtroFechaHasta ? filtroFechaHasta.value : '';

                filas.forEach(function (fila) {
                    var filaTipo = fila.getAttribute('data-tipo') || '';
                    var filaOperadora = fila.getAttribute('data-operadora') || '';
                    var filaFecha = fila.getAttribute('data-fecha') || '';

                    var visible = (!tipo || filaTipo === tipo)
                        && (!operadora || filaOperadora === operadora)
                        && matchesQuickDate(filaFecha, quickDate)
                        && matchesRange(filaFecha, desde, hasta);

                    fila.style.display = visible ? '' : 'none';
                });

                cards.forEach(function (card) {
                    var cardTipo = card.getAttribute('data-tipo') || '';
                    var cardOperadora = card.getAttribute('data-operadora') || '';
                    var cardFecha = card.getAttribute('data-fecha') || '';

                    var visible = (!tipo || cardTipo === tipo)
                        && (!operadora || cardOperadora === operadora)
                        && matchesQuickDate(cardFecha, quickDate)
                        && matchesRange(cardFecha, desde, hasta);

                    card.style.display = visible ? '' : 'none';
                });

                recalculateMetrics();

                if (filaSinResultadosMobile) {
                    var cardsVisibles = 0;
                    cards.forEach(function (card) {
                        if (card.style.display !== 'none') {
                            cardsVisibles += 1;
                        }
                    });
                    filaSinResultadosMobile.style.display = cardsVisibles === 0 ? '' : 'none';
                }
            }

            function updateRow(doc) {
                if (!doc || !doc.id) {
                    return;
                }

                var fila = document.getElementById('doc-row-' + doc.id);
                if (!fila) {
                    return;
                }

                fila.setAttribute('data-estado', doc.estadoNormalizado || 'PENDIENTE');
                fila.setAttribute('data-operadora', doc.operadora || '');
                fila.setAttribute('data-fecha', doc.fechaCargaIso || '');
                fila.querySelector('.js-doc-state').innerHTML = '<span class="' + escapeHtml(doc.badgeClass || 'badge bg-secondary') + ' aocr-status-badge">' + escapeHtml(doc.estado || 'PENDIENTE') + '</span>';
                fila.querySelector('.js-doc-observacion').innerHTML = doc.observacion ? escapeHtml(decodeHtmlEntities(doc.observacion)) : '<span class="documentos-muted">-</span>';
                fila.querySelector('.js-doc-reviewer').innerHTML = doc.revisadoPor ? escapeHtml(doc.revisadoPor) : '<span class="documentos-muted">-</span>';
                fila.querySelector('.js-doc-review-date').textContent = doc.fechaRevision || '-';
                fila.querySelector('.js-doc-actions').innerHTML = buildActionsHtml(doc);

                var card = document.getElementById('doc-card-' + doc.id);
                if (card) {
                    card.setAttribute('data-estado', doc.estadoNormalizado || 'PENDIENTE');
                    card.setAttribute('data-operadora', doc.operadora || '');
                    card.setAttribute('data-fecha', doc.fechaCargaIso || '');

                    var estadoCard = card.querySelector('.aocr-status-badge');
                    if (estadoCard) {
                        estadoCard.className = (doc.badgeClass || 'badge bg-secondary') + ' aocr-status-badge';
                        estadoCard.textContent = doc.estado || 'PENDIENTE';
                    }

                    var observacionCard = card.querySelector('.js-doc-observacion-card');
                    if (observacionCard) {
                        observacionCard.innerHTML = doc.observacion ? escapeHtml(decodeHtmlEntities(doc.observacion)) : '<span class="documentos-muted">-</span>';
                    }

                    var accionesCard = card.querySelector('.js-doc-actions-card');
                    if (accionesCard) {
                        accionesCard.innerHTML = buildActionsHtml(doc);
                    }
                }
            }

            tabla.querySelectorAll('.js-doc-observacion').forEach(normalizeObservationCell);

            async function postForm(url, payload) {
                if (!tokenInput) {
                    throw new Error('No se encontró el token antiforgery.');
                }

                var body = new URLSearchParams();
                Object.keys(payload || {}).forEach(function (key) {
                    var value = payload[key];
                    if (value !== undefined && value !== null) {
                        body.append(key, value);
                    }
                });
                body.append('__RequestVerificationToken', tokenInput.value);

                var response = await fetch(url, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8'
                    },
                    credentials: 'same-origin',
                    body: body.toString()
                });

                var result;
                try {
                    result = await response.json();
                } catch (error) {
                    throw new Error('La respuesta del servidor no es válida.');
                }

                if (result && parseInt(result.code, 10) === 403) {
                    throw new Error(result.message || 'No tiene permiso para guardar la revisión documental.');
                }

                if (!response.ok || !result || result.success !== true) {
                    throw new Error(result && result.message ? result.message : 'No se pudo procesar la solicitud.');
                }

                return result;
            }

            document.addEventListener('click', async function (event) {
                var aceptarBtn = event.target.closest('.btn-aceptar-documento');
                if (aceptarBtn) {
                    if (revisionDocumentalMasiva) {
                        showAlert('warning', 'Use los combos por documento y pulse Guardar revisión documental para registrar las decisiones.');
                        return;
                    }
                    var idDocumentoAceptar = aceptarBtn.getAttribute('data-id');
                    if (!idDocumentoAceptar) {
                        showAlert('danger', 'No se encontró el documento seleccionado.');
                        return;
                    }

                    if (!window.confirm('¿Desea aceptar este documento?')) {
                        return;
                    }

                    try {
                        aceptarBtn.disabled = true;
                        var resultadoAceptar = await postForm(urls.aceptar, {
                            idDocumento: idDocumentoAceptar,
                            codigoSolicitud: solicitudId,
                            codigoInspeccion: codigoInspeccion
                        });
                        updateRow(resultadoAceptar.documento);
                        showAlert('success', resultadoAceptar.message || 'Documento aceptado correctamente.');
                        applyFilters();
                        if (resultadoAceptar.redirectUrl) {
                            window.setTimeout(function () {
                                window.location.assign(resultadoAceptar.redirectUrl);
                            }, 280);
                        }
                    } catch (error) {
                        console.error('[AOCR][REVISION_DOCUMENTAL_ERROR]', error);
                        showAlert('danger', error.message || 'No se pudo aceptar el documento.');
                    } finally {
                        aceptarBtn.disabled = false;
                    }
                    return;
                }

                var devolverBtn = event.target.closest('.btn-devolver-documento');
                if (devolverBtn) {
                    if (revisionDocumentalMasiva) {
                        showAlert('warning', 'Use los combos por documento y pulse Guardar revisión documental para registrar las decisiones.');
                        return;
                    }
                    documentoDevolverId.value = devolverBtn.getAttribute('data-id') || '';
                    documentoDevolverTipo.textContent = devolverBtn.getAttribute('data-tipo') || '-';
                    documentoDevolverNombre.textContent = devolverBtn.getAttribute('data-nombre') || '-';
                    documentoDevolverOperadora.textContent = devolverBtn.getAttribute('data-operadora') || '-';
                    motivoInput.value = '';
                    showModal();
                    return;
                }

                var reabrirBtn = event.target.closest('.btn-reabrir-documento');
                if (reabrirBtn) {
                    var idDocumentoReabrir = reabrirBtn.getAttribute('data-id');
                    if (!idDocumentoReabrir) {
                        showAlert('danger', 'No se encontró el documento seleccionado.');
                        return;
                    }

                    if (!window.confirm('¿Desea reabrir este documento para una nueva revisión?')) {
                        return;
                    }

                    try {
                        reabrirBtn.disabled = true;
                        var resultadoReabrir = await postForm(urls.reabrir, {
                            idDocumento: idDocumentoReabrir,
                            codigoSolicitud: solicitudId,
                            codigoInspeccion: codigoInspeccion
                        });
                        updateRow(resultadoReabrir.documento);
                        showAlert('success', resultadoReabrir.message || 'Documento reabierto correctamente.');
                        applyFilters();
                    } catch (error) {
                        console.error('[AOCR][REVISION_DOCUMENTAL_ERROR]', error);
                        showAlert('danger', error.message || 'No se pudo reabrir el documento.');
                    } finally {
                        reabrirBtn.disabled = false;
                    }
                }
            });

            if (btnConfirmarDevolucion) {
                btnConfirmarDevolucion.addEventListener('click', async function () {
                    var idDocumento = documentoDevolverId.value;
                    var motivo = (motivoInput.value || '').trim();

                    if (!idDocumento) {
                        showAlert('danger', 'No se encontró el documento seleccionado.');
                        return;
                    }

                    if (motivo.length < 10) {
                        showAlert('danger', 'Debe ingresar el motivo por el cual se devuelve el documento. Mínimo 10 caracteres.');
                        motivoInput.focus();
                        return;
                    }

                    try {
                        btnConfirmarDevolucion.disabled = true;
                        var resultadoDevolucion = await postForm(urls.devolver, {
                            idDocumento: idDocumento,
                            codigoSolicitud: solicitudId,
                            codigoInspeccion: codigoInspeccion,
                            motivoDevolucion: motivo
                        });
                        updateRow(resultadoDevolucion.documento);
                        hideModal();
                        showAlert('success', resultadoDevolucion.message || 'Documento devuelto correctamente.');
                        applyFilters();
                    } catch (error) {
                        console.error('[AOCR][REVISION_DOCUMENTAL_ERROR]', error);
                        showAlert('danger', error.message || 'No se pudo devolver el documento.');
                    } finally {
                        btnConfirmarDevolucion.disabled = false;
                    }
                });
            }

            [filtroTipo, filtroOperadora, filtroFechaRapida, filtroFechaDesde, filtroFechaHasta].forEach(function (control) {
                if (!control) {
                    return;
                }

                control.addEventListener('change', applyFilters);
                control.addEventListener('input', applyFilters);
            });

            function toggleObservacionCombo(combo) {
                if (!combo) {
                    return;
                }

                var documentId = combo.getAttribute('data-document-id');
                if (!documentId) {
                    return;
                }

                var decision = normalizeDecisionValue(combo.value);
                syncDecisionState(documentId, decision, combo);
            }

            document.querySelectorAll('.js-decision-combo').forEach(function (combo) {
                toggleObservacionCombo(combo);
                combo.addEventListener('change', function () {
                    toggleObservacionCombo(combo);
                });
            });

            document.querySelectorAll('.js-decision-observacion').forEach(function (textarea) {
                textarea.addEventListener('input', function () {
                    var documentId = textarea.getAttribute('data-document-id');
                    if (!documentId) {
                        return;
                    }
                    syncObservationValue(documentId, textarea.value || '', textarea);
                });
            });

            function recolectarRevisionesDocumentales() {
                var revisiones = [];
                var sinObservacion = [];

                tabla.querySelectorAll('tbody tr[data-doc-revision="true"][data-document-id]').forEach(function (fila) {
                    var puedeRevisar = String(fila.getAttribute('data-puede-revisar') || '').toLowerCase() === 'true';
                    var versionActiva = String(fila.getAttribute('data-version-activa') || '').toLowerCase() !== 'false';
                    var soloConsulta = String(fila.getAttribute('data-solo-consulta') || '').toLowerCase() === 'true';
                    var tipoDocumentoPayload = (fila.getAttribute('data-tipo-documento') || fila.getAttribute('data-tipo') || '').trim().toUpperCase();
                    var tiposSoloConsulta = {
                        SOLICITUD_INSPECCION_EXT: true,
                        SOLICITUD_INSPECCION_FIRMADA: true,
                        SOLICITUD_INSPECCIONES_FIRMADA: true,
                        ORDEN_RECAUDACION: true,
                        FACTURA: true,
                        COMPROBANTE_AS400: true,
                        COMPROBANTE_PAGO: true,
                        DOCUMENTO_GENERADO_SISTEMA: true,
                        AOCR_GENERADO: true,
                        AOCR_FIRMADO: true,
                        CONDICIONES_LIMITACIONES: true,
                        CONSTANCIA: true
                    };
                    if (soloConsulta || tiposSoloConsulta[tipoDocumentoPayload]) {
                        return;
                    }

                    if (!puedeRevisar || !versionActiva) {
                        return;
                    }

                    var documentId = parseInt(fila.getAttribute('data-document-id'), 10);
                    if (!documentId) {
                        return;
                    }

                    var combo = fila.querySelector('.js-estado-documento, .js-decision-combo');
                    if (!combo) {
                        return;
                    }

                    var decision = normalizeDecisionValue(combo.value);
                    var observacionInput = fila.querySelector('.js-decision-observacion');
                    var observacion = observacionInput ? (observacionInput.value || '').trim() : '';

                    if (!decision || decision === 'PENDIENTE') {
                        return;
                    }

                    if (decision === 'DEVUELTO_INSPECTOR' && !observacion) {
                        sinObservacion.push(documentId);
                        return;
                    }

                    revisiones.push({
                        CodigoDocumento: documentId,
                        Decision: decision,
                        Estado: decision,
                        Observacion: observacion
                    });
                });

                return {
                    revisiones: revisiones,
                    sinObservacion: sinObservacion
                };
            }

            var btnGuardarRevision = document.getElementById('btnGuardarRevisionDocumental');
            var frmGuardarRevision = document.getElementById('frmGuardarRevisionDocumental');
            var revisionesJsonGuardar = document.getElementById('revisionesJsonGuardar');
            var handlerRevisionDocumentalJsonActivo = false;

            if (btnGuardarRevision && frmGuardarRevision) {
                frmGuardarRevision.onsubmit = function (event) {
                    event.preventDefault();
                    event.stopPropagation();
                    return false;
                };

                async function enviarRevisionDocumentalJson(payload) {
                    var tokenInput = frmGuardarRevision.querySelector('input[name="__RequestVerificationToken"]')
                        || document.querySelector('#frmRevisionToken input[name="__RequestVerificationToken"]');
                    var token = tokenInput ? tokenInput.value : '';
                    var requestPayload = {
                        solicitudId: parseInt(frmGuardarRevision.getAttribute('data-solicitud-id') || '0', 10),
                        modo: frmGuardarRevision.getAttribute('data-modo') || 'revision',
                        origen: frmGuardarRevision.getAttribute('data-origen') || 'revision-documental',
                        decisiones: payload.revisiones.map(function (item) {
                            return {
                                documentoId: item.CodigoDocumento,
                                decision: item.Decision,
                                estado: item.Estado || item.Decision,
                                observacion: item.Observacion || ''
                            };
                        })
                    };

                    if (revisionesJsonGuardar) {
                        revisionesJsonGuardar.value = JSON.stringify(requestPayload.decisiones);
                    } else {
                        console.warn('[AOCR][REV_DOC][DOM_MISSING]', 'No existe revisionesJsonGuardar. Se usara payload JSON directo.');
                    }

                    if (!requestPayload.solicitudId) {
                        showAlert('warning', 'No se encontro el identificador de la solicitud.');
                        return false;
                    }

                    if (!requestPayload.decisiones.length) {
                        showAlert('warning', 'Debe seleccionar al menos una decision documental valida.');
                        return false;
                    }

                    console.log('[AOCR][REV_DOC][PAYLOAD]', requestPayload);

                    var response = await fetch(frmGuardarRevision.action, {
                        method: 'POST',
                        credentials: 'same-origin',
                        headers: {
                            'Content-Type': 'application/json',
                            'Accept': 'application/json',
                            'X-Requested-With': 'XMLHttpRequest',
                            'RequestVerificationToken': token || '',
                            'X-RequestVerificationToken': token || ''
                        },
                        body: JSON.stringify(requestPayload)
                    });

                    var contentType = response.headers ? (response.headers.get('content-type') || '') : '';
                    var data = contentType.indexOf('application/json') >= 0
                        ? await response.json().catch(function () { return null; })
                        : null;

                    if (!response.ok || (data && (data.ok === false || data.success === false || parseInt(data.code, 10) >= 400))) {
                        showAlert('danger', (data && (data.message || data.mensaje)) || ('Error ' + response.status + ' al guardar la revision documental.'));
                        return false;
                    }

                    showAlert('success', (data && data.message) || 'Revision documental guardada correctamente.');
                    var redirectUrl = data && data.data && data.data.redirectUrl
                        ? data.data.redirectUrl
                        : (data && data.redirectUrl ? data.redirectUrl : null);
                    if (redirectUrl) {
                        window.location.assign(redirectUrl);
                    } else {
                        window.location.reload();
                    }

                    return true;
                }

                btnGuardarRevision.onclick = async function (event) {
                    if (event) {
                        event.preventDefault();
                        event.stopPropagation();
                    }

                    if (window.__guardandoRevisionDocumental) {
                        return false;
                    }

                    window.__guardandoRevisionDocumental = true;
                    btnGuardarRevision.disabled = true;

                    console.log('[AOCR][REV_DOC][CLICK_GUARDAR]', {
                        solicitudId: parseInt(frmGuardarRevision.getAttribute('data-solicitud-id') || '0', 10),
                        timestamp: new Date().toISOString()
                    });

                    var payload = recolectarRevisionesDocumentales();
                    if (payload.sinObservacion.length > 0) {
                        showAlert('warning', 'Existen documentos rechazados sin observación. Ingrese el motivo antes de guardar.');
                        window.__guardandoRevisionDocumental = false;
                        btnGuardarRevision.disabled = false;
                        return false;
                    }

                    if (payload.revisiones.length === 0) {
                        showAlert('warning', 'Debe seleccionar al menos una decisión documental válida.');
                        window.__guardandoRevisionDocumental = false;
                        btnGuardarRevision.disabled = false;
                        return false;
                    }

                    var cantidadDevueltos = payload.revisiones.filter(function (item) {
                        return item.Decision === 'DEVUELTO_INSPECTOR';
                    }).length;

                    var ejecutar = async function () {
                        try {
                            var ok = await enviarRevisionDocumentalJson(payload);
                            if (!ok) {
                                window.__guardandoRevisionDocumental = false;
                                btnGuardarRevision.disabled = false;
                            }
                        } catch (error) {
                            console.error('[AOCR][REV_DOC][ERROR]', error);
                            showAlert('danger', (error && error.message) || 'No se pudo guardar la revision documental.');
                            window.__guardandoRevisionDocumental = false;
                            btnGuardarRevision.disabled = false;
                        }
                    };

                    if (cantidadDevueltos > 0) {
                        var mensaje = 'Se rechazaran ' + cantidadDevueltos + ' documento(s) para subsanacion. Desea continuar?';
                        if (window.Swal && typeof window.Swal.fire === 'function') {
                            window.Swal.fire({
                                title: 'Confirmar revision documental',
                                text: mensaje,
                                icon: 'question',
                                showCancelButton: true,
                                confirmButtonText: 'Si, guardar',
                                cancelButtonText: 'Cancelar'
                            }).then(function (result) {
                                if (result.isConfirmed) {
                                    ejecutar();
                                } else {
                                    window.__guardandoRevisionDocumental = false;
                                    btnGuardarRevision.disabled = false;
                                }
                            });
                            return false;
                        }

                        if (window.confirm(mensaje)) {
                            ejecutar();
                        } else {
                            window.__guardandoRevisionDocumental = false;
                            btnGuardarRevision.disabled = false;
                        }
                        return false;
                    }

                    ejecutar();
                    return false;
                };

                handlerRevisionDocumentalJsonActivo = true;
            }

            if (!handlerRevisionDocumentalJsonActivo && btnGuardarRevision && frmGuardarRevision && revisionesJsonGuardar) {
                async function enviarRevisionDocumental(payload) {
                    revisionesJsonGuardar.value = JSON.stringify(payload.revisiones);
                    btnGuardarRevision.disabled = true;

                    try {
                        var response = await fetch(frmGuardarRevision.action, {
                            method: 'POST',
                            credentials: 'same-origin',
                            headers: {
                                'X-Requested-With': 'XMLHttpRequest'
                            },
                            body: new FormData(frmGuardarRevision)
                        });

                        var contentType = response.headers ? (response.headers.get('content-type') || '') : '';
                        if (contentType.indexOf('application/json') >= 0) {
                            var json = await response.json();
                            if (json && parseInt(json.code, 10) === 403) {
                                showAlert('danger', json.message || 'No tiene permiso para guardar la revisión documental.');
                                btnGuardarRevision.disabled = false;
                                return;
                            }

                            if (!response.ok || (json && json.success === false)) {
                                showAlert('danger', (json && (json.message || json.mensaje)) || 'No se pudo guardar la revisión documental.');
                                btnGuardarRevision.disabled = false;
                                return;
                            }

                            if (json && json.redirectUrl) {
                                window.location.assign(json.redirectUrl);
                                return;
                            }
                        } else if (!response.ok) {
                            showAlert('danger', 'No se pudo guardar la revisión documental. Revise permisos, estado de la solicitud o recargue la pantalla.');
                            btnGuardarRevision.disabled = false;
                            return;
                        }

                        window.location.assign(response.url || frmGuardarRevision.action);
                    } catch (error) {
                        console.error('[AOCR][REVISION_DOCUMENTAL_ERROR]', error);
                        showAlert('danger', 'No se pudo guardar la revisión documental. Revise permisos, estado de la solicitud o recargue la pantalla.');
                        btnGuardarRevision.disabled = false;
                    }
                }

                btnGuardarRevision.addEventListener('click', function () {
                    var payload = recolectarRevisionesDocumentales();

                    if (payload.sinObservacion.length > 0) {
                        showAlert('warning', 'Existen documentos rechazados sin observación. Ingrese el motivo antes de guardar.');
                        return;
                    }

                    if (payload.revisiones.length === 0) {
                        showAlert('warning', 'Debe seleccionar al menos una decisión documental válida.');
                        return;
                    }

                    var cantidadDevueltos = payload.revisiones.filter(function (item) {
                        return item.Decision === 'DEVUELTO_INSPECTOR';
                    }).length;

                    var confirmar = function () {
                        enviarRevisionDocumental(payload);
                    };

                    if (cantidadDevueltos > 0) {
                        var mensaje = 'Se rechazarán ' + cantidadDevueltos + ' documento(s) para subsanación. ¿Desea continuar?';
                        if (window.Swal && typeof window.Swal.fire === 'function') {
                            window.Swal.fire({
                                title: 'Confirmar revisión documental',
                                text: mensaje,
                                icon: 'question',
                                showCancelButton: true,
                                confirmButtonText: 'Sí, guardar',
                                cancelButtonText: 'Cancelar'
                            }).then(function (result) {
                                if (result.isConfirmed) {
                                    confirmar();
                                }
                            });
                            return;
                        }

                        if (window.confirm(mensaje)) {
                            confirmar();
                        }
                        return;
                    }

                    confirmar();
                });
            }

            applyFilters();
        })();
    </script>
}
