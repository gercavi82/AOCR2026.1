        border-radius: 18px;
        background: linear-gradient(135deg, #eef8fb 0%, #f9fcfe 55%, #fff7eb 100%);
        box-shadow: 0 12px 28px rgba(15, 97, 122, 0.08);
        margin-bottom: 1rem;
    }

    .documentos-view-banner--review {
        border-color: rgba(18, 92, 146, 0.16);
        background: linear-gradient(135deg, #eef5ff 0%, #f9fbff 55%, #ecf7ff 100%);
        box-shadow: 0 12px 28px rgba(18, 92, 146, 0.08);
    }

    .documentos-view-banner--review .documentos-view-banner__eyebrow,
    .documentos-view-banner--review .documentos-view-chip {
