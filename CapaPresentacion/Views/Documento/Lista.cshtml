@if (TempData["Error"] != null)
{
    <div class="alert alert-aocr alert-danger mb-3"><i class="fas fa-exclamation-circle me-1"></i> @TempData["Error"]</div>
}
@if (TempData["Exito"] != null)
{
    <div class="alert alert-aocr alert-success mb-3"><i class="fas fa-check-circle me-1"></i> @TempData["Exito"]</div>
}
@{
    var mostrarAvisoRevisionDocumental = ViewBag.MostrarAvisoRevisionDocumental as bool? ?? false;
    var urlRevisionDocumentalActiva = (ViewBag.UrlRevisionDocumentalActiva as string) ?? string.Empty;
}
@if (mostrarAvisoRevisionDocumental && !string.IsNullOrWhiteSpace(urlRevisionDocumentalActiva))
{
    <div class="alert alert-warning border mb-3">
        <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-2">
            <div>
                <strong><i class="fas fa-clipboard-check me-1"></i>Está en modo consulta.</strong>
                Para registrar decisiones documentales (aceptar, devolver u observar) debe abrir la revisión documental activa con combos por documento.
            </div>
            <a href="@urlRevisionDocumentalActiva" class="btn btn-warning">
                <i class="fas fa-file-circle-check me-1"></i> Abrir revisión documental
            </a>
        </div>
    </div>
}

<div class="aocr-review-page">
<section class="documentos-view-banner aocr-review-header @(esModoRevisionDocumental ? "documentos-view-banner--review" : string.Empty)">
    <div>
        <span class="documentos-view-banner__eyebrow">@bannerEyebrow</span>
        <h1 class="documentos-view-banner__title">@tituloPaginaModulo</h1>
        <p class="documentos-view-banner__copy">@bannerDescripcion</p>
        <div class="documentos-view-banner__chips">
            @if (esModoVerDocumentacion)
            {
                <span class="documentos-view-chip"><i class="fas fa-eye"></i> Solo lectura</span>
                <span class="documentos-view-chip"><i class="fas fa-download"></i> Descarga habilitada</span>
                <span class="documentos-view-chip"><i class="fas fa-shield-halved"></i> Sin decisiones operativas</span>
            }
            else
            {
                <span class="documentos-view-chip"><i class="fas fa-clipboard-check"></i> Expediente sincronizado</span>
                <span class="documentos-view-chip"><i class="fas fa-download"></i> Descarga habilitada</span>
                <span class="documentos-view-chip"><i class="fas fa-file-circle-check"></i> @(puedeRevisarDocumentos ? "Combos + Guardar revisión documental" : "Acciones restringidas")</span>
            }
        </div>
    </div>
    <div class="documentos-view-highlight">
        <div class="documentos-view-highlight__card">
            <span class="documentos-view-highlight__label">@estadoTarjetaTitulo</span>
            <span class="documentos-view-highlight__value">@estadoTarjetaValor</span>
            <span class="documentos-view-highlight__note">@estadoTarjetaNota</span>
        </div>
        <div class="documentos-view-highlight__card">
            <span class="documentos-view-highlight__label">Solicitud activa</span>
            <span class="documentos-view-highlight__value">@(tieneSolicitudId ? ("#" + solicitudIdNumero) : "N/D")</span>
            <span class="documentos-view-highlight__note">@(string.IsNullOrWhiteSpace(operadoraContexto) ? "Expediente documental asociado a la solicitud activa." : operadoraContexto)</span>
        </div>
    </div>
</section>

<div class="aocr-summary-strip aocr-review-kpis mb-3">
    @Html.Partial("_MetricCard", null, new ViewDataDictionary { { "Label", "Total" }, { "Value", totalDocs }, { "Icon", "fas fa-folder-open" }, { "ValueId", "metricTotalDocs" } })
    @Html.Partial("_MetricCard", null, new ViewDataDictionary { { "Label", "Pendientes" }, { "Value", pendientesDocs }, { "Modifier", "warning" }, { "Icon", "fas fa-clock" }, { "ValueId", "metricPendientesDocs" } })
    @Html.Partial("_MetricCard", null, new ViewDataDictionary { { "Label", "Aceptados" }, { "Value", aprobadosDocs }, { "Modifier", "success" }, { "Icon", "fas fa-check" }, { "ValueId", "metricAceptadosDocs" } })
    @Html.Partial("_MetricCard", null, new ViewDataDictionary { { "Label", "Devueltos" }, { "Value", rechazadosDocs }, { "Modifier", "danger" }, { "Icon", "fas fa-times" }, { "ValueId", "metricDevueltosDocs" } })
</div>

@Html.Partial("_ActionToolbar", null, new ViewDataDictionary {
    { "VolverUrl", volverUrl },
    { "VolverTexto", volverTexto }
})

<div id="frmRevisionToken" class="d-none">@Html.AntiForgeryToken()</div>

<div id="documentoRevisionAlerts"></div>

<div class="documentos-review-tools aocr-review-filters @(esModoVerDocumentacion ? "documentos-review-tools--view" : "documentos-review-tools--review")">
    <div class="documentos-review-tools__context aocr-review-summary">
        <div class="documentos-review-tools__context-item">
            <span class="documentos-review-tools__label">Solicitud</span>
            <strong>@(tieneSolicitudId ? ("#" + solicitudIdNumero) : "N/D")</strong>
        </div>
        @if (!string.IsNullOrWhiteSpace(operadoraContexto))
        {
            <div class="documentos-review-tools__context-item">
                <span class="documentos-review-tools__label">Operadora / EAE</span>
                <strong>@Html.Encode(operadoraContexto)</strong>
            </div>
        }
        @if (codigoInspeccion.HasValue)
        {
            <div class="documentos-review-tools__context-item">
                <span class="documentos-review-tools__label">Inspeccion vinculada</span>
                <strong>#@codigoInspeccion.Value</strong>
            </div>
        }
