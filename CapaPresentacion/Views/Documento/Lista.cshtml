@inherits System.Web.Mvc.WebViewPage<List<CapaModelo.Documento>>
@using CapaModelo
@using CapaPresentacion.Helpers
@using System.Web.Mvc
@using System.Web.Mvc.Html
@using System.Collections.Generic
@using System.Linq
@using System.Web
@using CapaDatos.Constants

@{
    Layout = "~/Views/Shared/_LayoutAOCR.cshtml";

    var solicitudIdRaw = ViewData["SolicitudId"] ?? ViewBag.SolicitudId;
    var solicitudIdTexto = solicitudIdRaw != null ? solicitudIdRaw.ToString() : string.Empty;
    int solicitudIdNumero;
    var tieneSolicitudId = int.TryParse(solicitudIdTexto, out solicitudIdNumero);
    var codigoInspeccionRaw = ViewBag.CodigoInspeccion;
    int codigoInspeccionValor = 0;
    var codigoInspeccion = codigoInspeccionRaw != null && int.TryParse(codigoInspeccionRaw.ToString(), out codigoInspeccionValor)
        ? (int?)codigoInspeccionValor
        : null;
    var puedeRevisarDocumentos = ViewBag.PuedeRevisarDocumentos as bool? ?? false;
    var puedeReabrirDocumentos = ViewBag.PuedeReabrirDocumentos as bool? ?? false;
    var modoDocumentos = (ViewBag.ModoDocumentos ?? string.Empty).ToString().Trim();
    var origenDocumentos = (Request.QueryString["origen"] ?? "revision-documental").Trim();
    var esModoVerDocumentacion = string.Equals(modoDocumentos, "ver", System.StringComparison.OrdinalIgnoreCase);
    var esModoRevisionDocumental = !esModoVerDocumentacion;
    var esFaseInspectorDocumental = ViewBag.EsFaseInspectorDocumental as bool? ?? false;
    var operadoraContexto = (ViewBag.OperadoraEae ?? string.Empty).ToString().Trim();
    var documentos = Model ?? new List<Documento>();
    var solicitudNumero = (ViewBag.SolicitudNumero ?? solicitudIdTexto ?? string.Empty).ToString().Trim();
    var referenciaSolicitud = !string.IsNullOrWhiteSpace(solicitudNumero) ? solicitudNumero : solicitudIdTexto;
    var tituloPaginaModulo = string.IsNullOrWhiteSpace(referenciaSolicitud)
        ? (esModoVerDocumentacion ? "Documentación cargada" : "Revisión documental de la solicitud")
        : (esModoVerDocumentacion
            ? "Documentación cargada - Solicitud AOCR " + referenciaSolicitud
            : "Revisión documental - Solicitud AOCR " + referenciaSolicitud);
    var volverUrl = (ViewBag.VolverUrl as string) ?? (string.IsNullOrWhiteSpace(solicitudIdTexto)
        ? Url.Action("Index", "SolicitudAOCR")
        : Url.Action("Detalle", "SolicitudAOCR", new { id = solicitudIdTexto }));
    var volverTexto = (ViewBag.VolverTexto as string) ?? "Volver";
    var subtituloPaginaModulo = esModoVerDocumentacion
        ? "Consulta documental del expediente en modo solo lectura, con trazabilidad y descarga disponible."
        : (puedeRevisarDocumentos
            ? "Gestión documental operativa para aceptar, devolver y cerrar la fase previa a inspección."
            : "Seguimiento documental del expediente sin acciones operativas habilitadas.");
    var bannerEyebrow = esModoVerDocumentacion ? "Consulta del expediente" : "Gestión documental";
    var bannerTitulo = esModoVerDocumentacion ? "Visualización sincronizada del expediente" : "Revisión documental sincronizada";
    var bannerDescripcion = esModoVerDocumentacion
        ? "Todos los archivos de la solicitud se presentan en un formato de consulta estable, con vista previa y descarga, sin habilitar decisiones operativas."
        : (puedeRevisarDocumentos
            ? "Este espacio concentra la revisión documental del expediente con el mismo contexto visual del módulo de consulta, pero habilitando decisiones de aceptación y devolución."
            : "El expediente se mantiene visible con el mismo contexto documental, aunque las decisiones operativas no están disponibles para el usuario actual.");
    var modoVisible = esModoVerDocumentacion
        ? "Ver documentación"
        : (puedeRevisarDocumentos ? "Revisión documental activa" : "Revisión documental bloqueada");
    var estadoTarjetaTitulo = esModoVerDocumentacion ? "Estado de consulta" : "Capacidad operativa";
    var estadoTarjetaValor = esModoVerDocumentacion
        ? "Solo lectura"
        : (puedeRevisarDocumentos ? "Aceptar y devolver documentos" : "Seguimiento sin decisiones");
    var estadoTarjetaNota = esModoVerDocumentacion
        ? "La consulta usa el mismo expediente documental, pero sin habilitar aceptación ni devolución."
        : (puedeRevisarDocumentos
            ? "La revisión utiliza el mismo expediente y habilita decisiones documentales antes de la inspección."
            : "La revisión conserva el contexto documental, pero no habilita acciones para este usuario.");
    var tablaTitulo = esModoVerDocumentacion ? "Archivos del expediente" : "Bandeja de revisión documental";
    var tablaSubtitulo = esModoVerDocumentacion
        ? "Consulta histórica y descarga de documentos vigentes asociados a la solicitud."
        : (puedeRevisarDocumentos
            ? "Documentos listos para decisión documental con trazabilidad de revisión."
            : "Consulta documental del expediente sin acciones operativas habilitadas.");
    var tablaBadge = esModoVerDocumentacion ? "Solo lectura" : (puedeRevisarDocumentos ? "Revisión activa" : "Seguimiento");
    var urlGuardarRevisionDocumental = tieneSolicitudId
        ? Url.Action("GuardarRevisionDocumental", "RevisionDocumental")
        : string.Empty;
    ViewBag.Title = tituloPaginaModulo + " AOCR";

    var stats = (ViewBag.Stats as IDictionary<string, object>)
                ?? (ViewBag.Estadisticas as IDictionary<string, object>)
                ?? new Dictionary<string, object>();

    Func<string, int> statInt = key =>
    {
        object value;
        if (!stats.TryGetValue(key, out value) || value == null)
        {
            return 0;
        }

        int parsed;
        return int.TryParse(value.ToString(), out parsed) ? parsed : 0;
    };

    var totalDocs = statInt("Total");
    var pendientesDocs = statInt("Pendientes");
    var aprobadosDocs = statInt("Aprobados");
    var rechazadosDocs = statInt("Rechazados");
    var tiposDisponiblesSet = new HashSet<string>(System.StringComparer.OrdinalIgnoreCase);
    var operadorasDisponiblesSet = new HashSet<string>(System.StringComparer.OrdinalIgnoreCase);
    foreach (var documento in documentos)
    {
        var tipoDocumento = documento != null ? (documento.TipoDocumento ?? string.Empty).Trim() : string.Empty;
        if (!string.IsNullOrWhiteSpace(tipoDocumento))
        {
            tiposDisponiblesSet.Add(tipoDocumento);
        }

        var operadoraDocumento = documento != null ? (documento.OperadoraEae ?? string.Empty).Trim() : string.Empty;
        if (string.IsNullOrWhiteSpace(operadoraDocumento))
        {
            operadoraDocumento = operadoraContexto;
        }

        if (!string.IsNullOrWhiteSpace(operadoraDocumento))
        {
            operadorasDisponiblesSet.Add(operadoraDocumento);
        }
    }

    var tiposDisponibles = tiposDisponiblesSet
        .OrderBy(x => x, System.StringComparer.OrdinalIgnoreCase)
        .ToList();
    var operadorasDisponibles = operadorasDisponiblesSet
        .OrderBy(x => x, System.StringComparer.OrdinalIgnoreCase)
        .ToList();

    Func<string, string> normalizarTextoVisible = value =>
    {
        var actual = (value ?? string.Empty).Trim();
        for (var i = 0; i < 3; i++)
        {
            var decodificado = HttpUtility.HtmlDecode(actual) ?? string.Empty;
            if (string.Equals(decodificado, actual, System.StringComparison.Ordinal))
            {
                break;
            }

            actual = decodificado;
        }

        return actual;
    };

    Func<Documento, bool> documentoEsCargadoSubsanacionRevisable = doc =>
    {
        var estadoRaw = doc != null ? (doc.Estado ?? string.Empty).Trim().ToUpperInvariant().Replace(" ", "_") : string.Empty;
        return doc != null
            && string.Equals(estadoRaw, "CARGADO", System.StringComparison.OrdinalIgnoreCase)
            && (doc.Version ?? 1) > 1
            && string.Equals(EstadoSolicitud.Normalizar(ViewBag.EstadoSolicitudNormalizado as string), EstadoSolicitud.Subsanada, System.StringComparison.OrdinalIgnoreCase);
    };

    Func<Documento, bool> documentoPuedeRevisarse = doc =>
    {
        if (doc == null || doc.CodigoDocumento <= 0)
        {
            return false;
        }

        if (!RevisionDocumentalDisplayHelper.ShouldIncludeInRevisionDocumental(doc.TipoDocumento))
        {
            return false;
        }

        var estadoRaw = (doc.Estado ?? string.Empty).Trim().ToUpperInvariant().Replace(" ", "_");
        if (string.Equals(estadoRaw, "CARGADO", System.StringComparison.OrdinalIgnoreCase))
        {
            return true;
        }

        if (documentoEsCargadoSubsanacionRevisable(doc))
        {
            return true;
        }

        return EstadoDocumentoInstitucional.EsEstadoRevisablePorInspector(doc.Estado);
    };

    Func<Documento, string> estadoVisible = doc =>
    {
        var visible = doc != null ? (doc.EstadoRevisionVisible ?? string.Empty).Trim() : string.Empty;
        if (!string.IsNullOrWhiteSpace(visible))
        {
            return visible;
        }

        var estado = doc != null ? (doc.Estado ?? string.Empty).Trim().ToUpperInvariant() : string.Empty;
        switch (estado)
        {
            case "PENDIENTE":
            case "PENDIENTE_REVISION":
            case "PENDIENTE_REVISION_SUBSANACION":
            case "SUBSANADO":
            case "SUBSANADO_RT":
            case "DOCUMENTACION_SUBSANADA":
            case "EN_REVISION_INSPECTOR":
                return "PENDIENTE";
            case "APROBADO":
            case "ACEPTADO":
            case "VALIDADO":
                return "ACEPTADO";
            case "OBSERVADO":
                return "OBSERVADO";
            case "DEVUELTO":
            case "RECHAZADO":
                return "DEVUELTO";
            case "CARGADO":
                return documentoEsCargadoSubsanacionRevisable(doc) ? "PENDIENTE" : "CARGADO";
            case "VERSION_ANTERIOR":
                return "VERSION_ANTERIOR";
            default:
                return string.IsNullOrWhiteSpace(estado) ? "PENDIENTE" : estado;
        }
    };

    Func<Documento, string> estadoNormalizado = doc =>
    {
        var visible = estadoVisible(doc);
        switch (visible)
        {
            case "ACEPTADO":
                return "APROBADO";
            case "DEVUELTO":
                return "RECHAZADO";
            case "OBSERVADO":
                return "OBSERVADO";
            case "CARGADO":
                return "CARGADO";
            case "VERSION_ANTERIOR":
                return "VERSION_ANTERIOR";
            default:
                return visible == "PENDIENTE" ? "PENDIENTE" : (visible ?? string.Empty).Trim().ToUpperInvariant().Replace(" ", "_");
        }
    };

    Func<Documento, string> badgeClass = doc =>
    {
        switch (estadoVisible(doc))
        {
            case "ACEPTADO":
                return "badge bg-success";
            case "DEVUELTO":
                return "badge bg-danger";
            case "OBSERVADO":
                return "badge bg-warning text-dark";
            default:
                return "badge bg-secondary";
        }
    };

    Func<Documento, string> observacionVisible = doc =>
    {
        if (doc == null)
        {
            return string.Empty;
        }

        if (esFaseInspectorDocumental)
        {
            return normalizarTextoVisible(doc.ObservacionRevision ?? string.Empty);
        }

        var observacion = doc.ObservacionRevision ?? doc.Observaciones ?? string.Empty;
        return normalizarTextoVisible(observacion);
    };

    Func<Documento, string> revisorVisible = doc =>
    {
        if (doc == null)
        {
            return string.Empty;
        }

        if (esFaseInspectorDocumental)
        {
            return (doc.NombreUsuarioRevisor ?? string.Empty).Trim();
        }

        return (doc.NombreUsuarioRevisor ?? doc.ValidadoPor ?? string.Empty).Trim();
    };

    Func<Documento, string> operadoraVisible = doc =>
    {
        if (doc == null)
        {
            return operadoraContexto;
        }

        var operadora = (doc.OperadoraEae ?? string.Empty).Trim();
        return string.IsNullOrWhiteSpace(operadora) ? operadoraContexto : operadora;
    };

    Func<string, bool> pareceNombreTecnicoArchivo = nombreArchivo =>
    {
        var nombre = (nombreArchivo ?? string.Empty).Trim();
        if (string.IsNullOrWhiteSpace(nombre))
        {
            return false;
        }

        var baseNombre = System.IO.Path.GetFileNameWithoutExtension(nombre);
        if (baseNombre.Length < 24)
        {
            return false;
        }

        if (baseNombre.IndexOf('_') >= 0 || baseNombre.IndexOf('-') >= 0 || baseNombre.IndexOf(' ') >= 0)
        {
            return false;
        }

        var letras = baseNombre.Count(char.IsLetter);
        return letras <= 6;
    };

    Func<Documento, string> nombreArchivoVisible = doc =>
    {
        if (doc == null)
        {
            return "Sin archivo";
        }

        var candidatos = new[]
        {
            doc.NombreArchivoOriginal,
            doc.NombreArchivoVisible,
            doc.NombreOriginal,
            doc.NombreVisible,
            doc.NombreArchivo
        };

        foreach (var candidato in candidatos)
        {
            var nombreCandidato = System.IO.Path.GetFileName((candidato ?? string.Empty).Trim());
            if (!string.IsNullOrWhiteSpace(nombreCandidato) && !pareceNombreTecnicoArchivo(nombreCandidato))
            {
                return nombreCandidato;
            }
        }

        var nombreReferencia = candidatos
            .Select(x => System.IO.Path.GetFileName((x ?? string.Empty).Trim()))
            .FirstOrDefault(x => !string.IsNullOrWhiteSpace(x));
        var extension = System.IO.Path.GetExtension(nombreReferencia ?? doc.RutaGuardada ?? string.Empty) ?? string.Empty;
        var tipo = RevisionDocumentalDisplayHelper.GetDocumentDisplayName(doc.TipoDocumento);

        if (!string.IsNullOrWhiteSpace(tipo))
        {
            return tipo + extension;
        }

        return "Documento cargado" + (string.IsNullOrWhiteSpace(extension) ? ".pdf" : extension);
    };
}

<style>
