@inherits System.Web.Mvc.WebViewPage<List<CapaPresentacion.Models.ViewModels.OrdenRecaudacionViewModel>>
@using CapaModelo
@using System.Web.Mvc
@using System.Web.Mvc.Html
@using System.Net
@{
    Layout = "~/Views/Shared/_LayoutAOCR.cshtml";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <h4>@ViewBag.Mensaje</h4>
                </div>
                <div class="card-body">
                    @if (Model != null && Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead>
                                    <tr>
                                        <th>Número de Orden</th>
                                        <th>Fecha de Creación</th>
                                        <th>Estado</th>
                                        <th>Subtotal</th>
                                        <th>Administración</th>
                                        <th>Total</th>
                                        <th>Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var orden in Model)
                                    {
                                        <tr>
                                            <td>@orden.NumeroOrden</td>
                                            <td>@orden.FechaCreacion.ToString("dd/MM/yyyy")</td>
                                            <td>
                                                @if (WebUtility.HtmlDecode(orden.Estado) == "Orden de RecaudaciÃ³n Requerida")
                                                {
                                                    <span class="badge badge-warning">Requerida</span>
                                                }
                                                else
                                                {
                                                    @Html.Raw(WebUtility.HtmlDecode(orden.Estado))
                                                }
                                            </td>
                                            <td>@orden.Subtotal.ToString("N2") USD</td>
                                            <td>@orden.Admin.ToString("N2") USD</td>
                                            <td>@orden.Total.ToString("N2") USD</td>
                                            <td>
                                                <a href="@Url.Action("Detalle", "Orden", new { id = orden.Id })" class="btn btn-sm btn-primary">Ver Detalle</a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info">
                            No tiene Ã³rdenes de recaudaciÃ³n registradas.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

