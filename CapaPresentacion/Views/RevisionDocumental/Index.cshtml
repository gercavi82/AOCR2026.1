@inherits System.Web.Mvc.WebViewPage<CapaPresentacion.Models.ViewModels.RevisionDocumentalIndexViewModel>
@using System.Web.Mvc
@using System.Web.Mvc.Html
@using System
@using System.Linq

@{
    ViewBag.Title = "Bandeja de revisión documental";
    Layout = "~/Views/Shared/_LayoutAOCR.cshtml";

    var bandeja = Model ?? new CapaPresentacion.Models.ViewModels.RevisionDocumentalIndexViewModel();
    var solicitudes = bandeja.Solicitudes ?? new CapaPresentacion.Models.ViewModels.RevisionDocumentalSolicitudRowViewModel[0];
}

@section Styles {
    <style>
        .rd-shell {
            display: grid;
            gap: 1rem;
        }

        .rd-header {
            display: flex;
            justify-content: space-between;
            gap: 1rem;
            align-items: flex-start;
            flex-wrap: wrap;
            background: linear-gradient(135deg, var(--aocr-blue-700) 0%, var(--aocr-teal-600) 100%);
            padding: 1.5rem 2rem;
            border-radius: 18px;
            box-shadow: 0 10px 30px rgba(15, 77, 122, 0.2);
            margin-bottom: 1rem;
        }

        .rd-header__title {
            margin: 0;
            color: #ffffff;
            font-weight: 800;
            letter-spacing: -.02em;
        }

        .rd-header__subtitle {
            margin: .35rem 0 0;
            color: rgba(255, 255, 255, 0.85);
            max-width: 58rem;
        }

        .rd-flow {
            display: flex;
            flex-wrap: wrap;
            gap: .65rem;
            padding: 1rem 1.15rem;
            border-radius: 18px;
            background: linear-gradient(135deg, #f3f8fb 0%, #fffdf7 100%);
            border: 1px solid rgba(22,53,75,.08);
        }

        .rd-flow__step {
            display: inline-flex;
            align-items: center;
            gap: .55rem;
            padding: .55rem .85rem;
            border-radius: 999px;
            background: #fff;
            border: 1px solid rgba(22,53,75,.1);
            color: #28455b;
            font-size: .88rem;
            font-weight: 700;
        }

        .rd-flow__step.is-current {
            background: #0f6a7f;
            border-color: #0f6a7f;
            color: #fff;
            box-shadow: 0 12px 24px rgba(15,106,127,.2);
        }

        .rd-metrics {
            display: grid;
            grid-template-columns: repeat(5, minmax(0, 1fr));
            gap: .9rem;
        }

        .rd-metric {
            background: #fff;
            border: 1px solid rgba(22,53,75,.08);
            border-radius: 18px;
            padding: 1rem;
            box-shadow: 0 12px 30px rgba(22,53,75,.06);
        }

        .rd-metric__label {
            display: block;
            font-size: .76rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: .08em;
            color: #688193;
        }

        .rd-metric__value {
            display: block;
            margin-top: .35rem;
            font-size: 1.95rem;
            line-height: 1;
            font-weight: 800;
            color: #16354b;
        }

        .rd-metric__caption {
            display: block;
            margin-top: .35rem;
            color: #6f8595;
            font-size: .82rem;
        }

        .rd-card {
            background: #fff;
            border: 1px solid rgba(22,53,75,.08);
            border-radius: 22px;
            overflow: hidden;
            box-shadow: 0 14px 36px rgba(22,53,75,.06);
        }

        .rd-card__header {
            display: flex;
            justify-content: space-between;
            gap: 1rem;
            align-items: center;
            flex-wrap: wrap;
            padding: 1rem 1.25rem;
            border-bottom: 1px solid rgba(22,53,75,.08);
            background: linear-gradient(180deg, #fcfeff 0%, #f8fbfd 100%);
        }

        .rd-card__title {
            margin: 0;
            font-size: 1.08rem;
            font-weight: 800;
            color: #16354b;
        }

        .rd-card__sub {
            margin: .25rem 0 0;
            color: #6b8292;
            font-size: .85rem;
        }

        .rd-chip {
            display: inline-flex;
            align-items: center;
            gap: .45rem;
            padding: .45rem .75rem;
            border-radius: 999px;
            font-size: .78rem;
            font-weight: 800;
            letter-spacing: .03em;
            text-transform: uppercase;
            border: 1px solid transparent;
        }

        .rd-chip--loaded { background: #eef7fb; color: #0f6a7f; border-color: #cde7ee; }
        .rd-chip--review { background: #eef4ff; color: #1f4f8b; border-color: #d4e2ff; }
        .rd-chip--observed { background: #fff4e5; color: #9a6407; border-color: #f6d8a4; }
        .rd-chip--subsanated { background: #f5efff; color: #6f42c1; border-color: #dfd0ff; }
        .rd-chip--waiting { background: #f7f8fa; color: #586775; border-color: #d7dee4; }

        .rd-table-wrap {
            overflow-x: auto;
        }

        .rd-table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0;
        }

        .rd-table thead th {
            padding: .95rem 1rem;
            font-size: .78rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: .06em;
            color: #6a8393;
            background: #f8fbfd;
            border-bottom: 1px solid rgba(22,53,75,.08);
            white-space: nowrap;
        }

        .rd-table tbody td {
            padding: 1rem;
            vertical-align: top;
            border-bottom: 1px solid rgba(22,53,75,.08);
            color: #274257;
        }

        .rd-table tbody tr:last-child td {
            border-bottom: none;
        }

        .rd-table__main {
            font-weight: 800;
            color: #16354b;
        }

        .rd-table__sub {
            display: block;
            margin-top: .2rem;
            color: #6f8595;
            font-size: .84rem;
        }

        .rd-state-copy {
            margin-top: .45rem;
            color: #6f8595;
            font-size: .84rem;
            line-height: 1.45;
        }

        .rd-stats {
            display: grid;
            gap: .3rem;
            font-size: .83rem;
        }

        .rd-stats strong {
            color: #16354b;
        }

        .rd-actions {
            display: flex;
            justify-content: flex-end;
        }

        .rd-empty {
            padding: 2.75rem 1.5rem;
            text-align: center;
            color: #6b8292;
        }

        .rd-empty i {
            font-size: 2.2rem;
            color: #0f6a7f;
            margin-bottom: .9rem;
        }

        @@media (max-width: 1080px) {
            .rd-metrics {
                grid-template-columns: repeat(3, minmax(0, 1fr));
            }
        }

        @@media (max-width: 768px) {
            .rd-metrics {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            .rd-table thead {
                display: none;
            }

            .rd-table,
            .rd-table tbody,
            .rd-table tr,
            .rd-table td {
                display: block;
                width: 100%;
            }

            .rd-table tbody tr {
                padding: .65rem 1rem;
            }

            .rd-table tbody td {
                padding: .55rem 0;
                border-bottom: none;
            }

            .rd-table tbody td::before {
                content: attr(data-column-label);
                display: block;
                margin-bottom: .22rem;
                font-size: .74rem;
                font-weight: 800;
                text-transform: uppercase;
                letter-spacing: .05em;
                color: #6a8393;
            }

            .rd-actions {
                justify-content: stretch;
            }

            .rd-actions .btn {
                width: 100%;
            }
        }

        @@media (max-width: 520px) {
            .rd-metrics {
                grid-template-columns: 1fr;
            }
        }
    </style>
}

<div class="rd-shell">
    <div class="rd-header aocr-bg-dark">
        <div>
            <h2 class="rd-header__title">Bandeja de revisión documental</h2>
            <p class="rd-header__subtitle">Gestión documental sincronizada con la consulta del expediente y con el detalle de inspección. Desde aquí el Inspector revisa documentos habilitantes, registra observaciones y habilita el avance a la fase operativa.</p>
        </div>
        <nav>
            <ol class="aocr-breadcrumb breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")"><i class="fas fa-home"></i></a></li>
                <li class="breadcrumb-item"><a href="@Url.Action("Inspector", "Dashboard")">Dashboard</a></li>
                <li class="breadcrumb-item active">Bandeja de revisión documental</li>
            </ol>
        </nav>
    </div>

    <div class="rd-flow" aria-label="Cronología del flujo AOCR">
        <span class="rd-flow__step"><i class="fas fa-money-check-dollar"></i> Pago aprobado</span>
        <span class="rd-flow__step"><i class="fas fa-folder-open"></i> Carga documental RT</span>
        <span class="rd-flow__step is-current"><i class="fas fa-file-circle-check"></i> Bandeja documental</span>
        <span class="rd-flow__step"><i class="fas fa-thumbs-up"></i> Documentación aprobada</span>
        <span class="rd-flow__step"><i class="fas fa-plane"></i> Inspección</span>
        <span class="rd-flow__step"><i class="fas fa-list-check"></i> LV/EAE</span>
        <span class="rd-flow__step"><i class="fas fa-file-signature"></i> Informe Técnico</span>
    </div>

    <div class="rd-metrics" aria-label="Indicadores documentales del inspector">
        <article class="rd-metric">
            <span class="rd-metric__label">Solicitudes pendientes</span>
            <span class="rd-metric__value">@bandeja.TotalSolicitudesPendientes</span>
            <span class="rd-metric__caption">Bandeja documental activa</span>
        </article>
        <article class="rd-metric">
            <span class="rd-metric__label">Documentos pendientes</span>
            <span class="rd-metric__value">@bandeja.TotalDocumentosPendientes</span>
            <span class="rd-metric__caption">Aún sin decisión final</span>
        </article>
        <article class="rd-metric">
            <span class="rd-metric__label">En revisión</span>
            <span class="rd-metric__value">@bandeja.TotalSolicitudesEnRevision</span>
            <span class="rd-metric__caption">Solicitudes con revisión en curso</span>
        </article>
        <article class="rd-metric">
            <span class="rd-metric__label">Observados</span>
            <span class="rd-metric__value">@bandeja.TotalDocumentosObservados</span>
            <span class="rd-metric__caption">Requieren subsanación RT</span>
        </article>
        <article class="rd-metric">
            <span class="rd-metric__label">Aceptados / Subsanados</span>
            <span class="rd-metric__value">@bandeja.TotalDocumentosAceptados / @bandeja.TotalDocumentosSubsanados</span>
            <span class="rd-metric__caption">Aceptados y pendientes de re-revisión</span>
        </article>
    </div>

    <section class="rd-card" aria-labelledby="rdCardTitle">
        <div class="rd-card__header">
            <div>
                <h3 id="rdCardTitle" class="rd-card__title">Expedientes pendientes de revisión documental</h3>
                <p class="rd-card__sub">Esta bandeja no muestra LV/EAE ni Informe Técnico. Solo concentra expedientes documentales que el Inspector debe revisar antes de habilitar la inspección, usando la misma lógica visible en consulta y detalle operativo.</p>
            </div>
            <span class="rd-chip rd-chip--review"><i class="fas fa-shield-halved"></i> Flujo documental sincronizado</span>
        </div>

        @if (solicitudes.Any())
        {
            <div class="rd-table-wrap">
                <table class="rd-table">
                    <thead>
                        <tr>
                            <th>Número de solicitud</th>
                            <th>Operadora / compañía</th>
                            <th>RT / solicitante</th>
                            <th>Estado documental</th>
                            <th>Fecha de carga</th>
                            <th>Conteo documental</th>
                            <th class="text-end">Acción</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in solicitudes)
                        {
                            var chipClass = "rd-chip rd-chip--loaded";
                            switch ((item.EstadoDocumentalCodigo ?? string.Empty).Trim().ToUpperInvariant())
                            {
                                case "EN_REVISION_DOCUMENTAL":
                                    chipClass = "rd-chip rd-chip--review";
                                    break;
                                case "DOCUMENTACION_OBSERVADA":
                                    chipClass = "rd-chip rd-chip--observed";
                                    break;
                                case "DOCUMENTACION_SUBSANADA":
                                    chipClass = "rd-chip rd-chip--subsanated";
                                    break;
                                case "PENDIENTE_CARGA_DOCUMENTAL":
                                    chipClass = "rd-chip rd-chip--waiting";
                                    break;
                                case "LISTO_INSPECCION_CAMPO":
                                    chipClass = "rd-chip rd-chip--review";
                                    break;
                                case "PENDIENTE_CONFIRMACION_INSPECTOR":
                                    chipClass = "rd-chip rd-chip--waiting";
                                    break;
                            }

                            <tr>
                                <td data-column-label="Solicitud">
                                    <span class="rd-table__main">@item.NumeroSolicitud</span>
                                    <span class="rd-table__sub">Estado solicitud: @(!string.IsNullOrWhiteSpace(item.EstadoSolicitud) ? item.EstadoSolicitud : "Sin estado")</span>
                                </td>
                                <td data-column-label="Operadora / compañía">
                                    <span class="rd-table__main">@item.Operadora</span>
                                </td>
                                <td data-column-label="RT / solicitante">
                                    <span class="rd-table__main">@item.Responsable</span>
                                </td>
                                <td data-column-label="Estado documental">
                                    <span class="@chipClass">@item.EstadoDocumentalNombre</span>
                                    <div class="rd-state-copy">@item.EstadoDocumentalDetalle</div>
                                </td>
                                <td data-column-label="Fecha de carga">
                                    <span class="rd-table__main">@(item.FechaCargaDocumentos.HasValue ? item.FechaCargaDocumentos.Value.ToString("dd/MM/yyyy HH:mm") : "Sin carga registrada")</span>
                                </td>
                                <td data-column-label="Conteo documental">
                                    <div class="rd-stats">
                                        <span><strong>Cargados:</strong> @item.DocumentosCargados</span>
                                        <span><strong>Pendientes:</strong> @item.DocumentosPendientes</span>
                                        <span><strong>Observados:</strong> @item.DocumentosObservados</span>
                                        <span><strong>Aceptados:</strong> @item.DocumentosAceptados</span>
                                        <span><strong>Subsanados:</strong> @item.DocumentosSubsanados</span>
                                    </div>
                                </td>
                                <td data-column-label="Acción">
                                    <div class="rd-actions">
                                        @if (item.MostrarAccionInspeccion && item.CodigoInspeccion.HasValue && item.CodigoInspeccion.Value > 0)
                                        {
                                            <a href="@Url.Action("Detalle", "Inspeccion", new { id = item.CodigoInspeccion.Value })" class="btn btn-primary btn-sm">
                                                <i class="fas fa-plane-departure"></i> Continuar en LV/EAE
                                            </a>
                                        }
                                        else if (item.PendienteConfirmacionInspector && item.CodigoInspeccion.HasValue && item.CodigoInspeccion.Value > 0)
                                        {
                                            <a href="@Url.Action("Detalle", "Inspeccion", new { id = item.CodigoInspeccion.Value })" class="btn btn-warning btn-sm">
                                                <i class="fas fa-file-circle-check"></i> Confirmar fase documental
                                            </a>
                                        }
                                        else
                                        {
                                            <a href="@Url.Action("Lista", "Documento", new { solicitudId = item.CodigoSolicitud, modo = "revision", origen = "revision-documental" })" class="btn btn-outline-primary btn-sm">
                                                <i class="fas fa-folder-open"></i> Revisar documentación
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="rd-empty">
                <i class="fas fa-file-circle-check"></i>
                <p class="mb-1"><strong>No hay solicitudes pendientes de revisión documental para el Inspector actual.</strong></p>
                <p class="mb-0">Si el coordinador ya le asignó una solicitud con documentación aprobada, revise también la bandeja de <a href="@Url.Action("Index", "Inspeccion")">Inspecciones</a>. Las asignaciones con documentos pendientes de decisión aparecerán aquí automáticamente.</p>
            </div>
        }
    </section>
</div>
