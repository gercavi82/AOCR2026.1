@{
    ViewBag.Title = "Prueba de Envío de Correo";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Sistema AOCR</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            max-width: 800px;
            margin: 50px auto;
            padding: 20px;
            background-color: #f5f5f5;
        }
        .container {
            background-color: white;
            padding: 30px;
            border-radius: 5px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        }
        h2 {
            color: #003366;
            border-bottom: 2px solid #003366;
            padding-bottom: 10px;
        }
        .form-group {
            margin-bottom: 20px;
        }
        label {
            display: block;
            margin-bottom: 5px;
            font-weight: bold;
            color: #333;
        }
        input[type="text"],
        input[type="email"],
        textarea {
            width: 100%;
            padding: 10px;
            border: 1px solid #ddd;
            border-radius: 4px;
            box-sizing: border-box;
        }
        textarea {
            min-height: 150px;
            resize: vertical;
        }
        button {
            background-color: #003366;
            color: white;
            padding: 12px 30px;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            font-size: 16px;
            margin-right: 10px;
        }
        button:hover {
            background-color: #004080;
        }
        button:disabled {
            background-color: #cccccc;
            cursor: not-allowed;
        }
        .alert {
            padding: 15px;
            margin-bottom: 20px;
            border-radius: 4px;
            display: none;
        }
        .alert-success {
            background-color: #d4edda;
            color: #155724;
            border: 1px solid #c3e6cb;
        }
        .alert-error {
            background-color: #f8d7da;
            color: #721c24;
            border: 1px solid #f5c6cb;
        }
        .section {
            margin-bottom: 30px;
            padding: 20px;
            background-color: #f9f9f9;
            border-radius: 4px;
        }
        .section h3 {
            margin-top: 0;
            color: #003366;
        }
    </style>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
</head>
<body>
    <div class="container">
        <h2>🔧 Prueba de Envío de Correo - Sistema AOCR</h2>
        
        <div id="resultado" class="alert"></div>

        <!-- Sección 1: Envío Simple -->
        <div class="section">
            <h3>1. Envío Simple</h3>
            <div class="form-group">
                <label for="destinatario1">Correo Destinatario:</label>
                <input type="email" id="destinatario1" placeholder="ejemplo@aviacioncivil.gob.ec" />
            </div>
            <div class="form-group">
                <label for="asunto1">Asunto:</label>
                <input type="text" id="asunto1" value="Prueba de correo - Sistema AOCR" />
            </div>
            <div class="form-group">
                <label for="mensaje1">Mensaje (HTML):</label>
                <textarea id="mensaje1"><h2>Correo de Prueba</h2><p>Este es un correo de prueba desde el Sistema AOCR.</p><p>Fecha: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</p></textarea>
            </div>
            <button onclick="enviarSimple()">Enviar Correo Simple</button>
        </div>

        <!-- Sección 2: Envío con Remitente Personalizado -->
        <div class="section">
            <h3>2. Envío con Remitente Personalizado</h3>
            <div class="form-group">
                <label for="remitente">Correo Remitente:</label>
                <input type="email" id="remitente" value="no_reply@aviacioncivil.gob.ec" />
            </div>
            <div class="form-group">
                <label for="destinatario2">Correo Destinatario:</label>
                <input type="email" id="destinatario2" placeholder="ejemplo@aviacioncivil.gob.ec" />
            </div>
            <div class="form-group">
                <label for="asunto2">Asunto:</label>
                <input type="text" id="asunto2" value="Prueba con remitente personalizado" />
            </div>
            <div class="form-group">
                <label for="mensaje2">Mensaje (HTML):</label>
                <textarea id="mensaje2"><h2>Correo con Remitente Personalizado</h2><p>Este correo se envía con un remitente específico.</p></textarea>
            </div>
            <button onclick="enviarConRemitente()">Enviar con Remitente</button>
        </div>

        <!-- Sección 3: Notificación de Orden -->
        <div class="section">
            <h3>3. Notificación de Orden de Recaudación</h3>
            <div class="form-group">
                <label for="ordenId">ID de Orden:</label>
                <input type="text" id="ordenId" value="12345" />
            </div>
            <div class="form-group">
                <label for="destinatario3">Correo Destinatario:</label>
                <input type="email" id="destinatario3" placeholder="ejemplo@aviacioncivil.gob.ec" />
            </div>
            <button onclick="notificarOrden()">Enviar Notificación de Orden</button>
        </div>

        <div style="margin-top: 30px; padding: 15px; background-color: #fff3cd; border-radius: 4px;">
            <strong>ℹ️ Información de Configuración:</strong>
            <ul>
                <li>Servidor SMTP: <code>172.20.16.21</code></li>
                <li>Puerto: <code>25</code></li>
                <li>Remitente por defecto: <code>no_reply@aviacioncivil.gob.ec</code></li>
                <li>SSL: Deshabilitado (red interna)</li>
            </ul>
        </div>
    </div>

    <script>
        function mostrarResultado(success, message) {
            var $resultado = $('#resultado');
            $resultado.removeClass('alert-success alert-error');
            $resultado.addClass(success ? 'alert-success' : 'alert-error');
            $resultado.html(message);
            $resultado.fadeIn();
            
            setTimeout(function() {
                $resultado.fadeOut();
            }, 5000);
        }

        function enviarSimple() {
            var destinatario = $('#destinatario1').val();
            var asunto = $('#asunto1').val();
            var mensaje = $('#mensaje1').val();

            if (!destinatario) {
                alert('Por favor ingrese un destinatario');
                return;
            }

            $('button').prop('disabled', true);
            
            $.ajax({
                url: '@Url.Action("EnviarPrueba", "TestEmail")',
                type: 'POST',
                data: {
                    destinatario: destinatario,
                    asunto: asunto,
                    mensaje: mensaje
                },
                success: function(response) {
                    mostrarResultado(response.success, response.message);
                    $('button').prop('disabled', false);
                },
                error: function(xhr, status, error) {
                    mostrarResultado(false, 'Error en la petición: ' + error);
                    $('button').prop('disabled', false);
                }
            });
        }

        function enviarConRemitente() {
            var remitente = $('#remitente').val();
            var destinatario = $('#destinatario2').val();
            var asunto = $('#asunto2').val();
            var mensaje = $('#mensaje2').val();

            if (!destinatario) {
                alert('Por favor ingrese un destinatario');
                return;
            }

            $('button').prop('disabled', true);
            
            $.ajax({
                url: '@Url.Action("EnviarConRemitente", "TestEmail")',
                type: 'POST',
                data: {
                    remitente: remitente,
                    destinatario: destinatario,
                    asunto: asunto,
                    mensaje: mensaje
                },
                success: function(response) {
                    mostrarResultado(response.success, response.message);
                    $('button').prop('disabled', false);
                },
                error: function(xhr, status, error) {
                    mostrarResultado(false, 'Error en la petición: ' + error);
                    $('button').prop('disabled', false);
                }
            });
        }

        function notificarOrden() {
            var ordenId = $('#ordenId').val();
            var destinatario = $('#destinatario3').val();

            if (!destinatario) {
                alert('Por favor ingrese un destinatario');
                return;
            }

            $('button').prop('disabled', true);
            
            $.ajax({
                url: '@Url.Action("NotificarOrden", "TestEmail")',
                type: 'POST',
                data: {
                    ordenId: ordenId,
                    destinatario: destinatario
                },
                success: function(response) {
                    mostrarResultado(response.success, response.message);
                    $('button').prop('disabled', false);
                },
                error: function(xhr, status, error) {
                    mostrarResultado(false, 'Error en la petición: ' + error);
                    $('button').prop('disabled', false);
                }
            });
        }
    </script>
</body>
</html>
