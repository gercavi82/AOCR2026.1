@model CapaPresentacion.Models.AdminUsuarios.AdminRolPermisosViewModel

@{
    ViewBag.Title = "Administracion - Permisos por rol";
}

<h2>Permisos por rol</h2>
<p class="text-muted">Asigne permisos granulares a cada rol del sistema.</p>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (!Model.InfraestructuraPermisosDisponible)
{
    <div class="alert alert-warning">
        La infraestructura de permisos no esta disponible. Ejecute primero los scripts de seguridad.
    </div>
}

@using (Html.BeginForm("PermisosRol", "AdminUsuarios", FormMethod.Get, new { @class = "card card-body mb-3" }))
{
    <div class="row align-items-end">
        <div class="col-md-8">
            <label class="form-label">Rol</label>
            @Html.DropDownListFor(m => m.CodigoRolSeleccionado, Model.RolesDisponibles, "Seleccione un rol", new { @class = "form-control" })
        </div>
        <div class="col-md-4">
            <button type="submit" class="btn btn-primary w-100">
                <i class="fas fa-filter mr-1"></i> Cargar permisos
            </button>
        </div>
    </div>
}

@if (Model.CodigoRolSeleccionado > 0 && Model.InfraestructuraPermisosDisponible)
{
    using (Html.BeginForm("PermisosRol", "AdminUsuarios", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.CodigoRolSeleccionado)

        <div class="card">
            <div class="card-header">
                <strong>Permisos del rol:</strong> @Model.NombreRolSeleccionado
            </div>
            <div class="card-body">
                @if (Model.PermisosDisponibles != null && Model.PermisosDisponibles.Any())
                {
                    <div class="row">
                        @foreach (var permiso in Model.PermisosDisponibles)
                        {
                            var marcado = Model.PermisosSeleccionados != null &&
                                          Model.PermisosSeleccionados.Contains(permiso.IdPermiso);
                            <div class="col-md-6 col-lg-4 mb-3">
                                <div class="border rounded p-2 h-100">
                                    <div class="form-check">
                                        <input class="form-check-input"
                                               type="checkbox"
                                               name="PermisosSeleccionados"
                                               id="perm_@permiso.IdPermiso"
                                               value="@permiso.IdPermiso"
                                               @(marcado ? "checked" : null) />
                                        <label class="form-check-label font-weight-bold" for="perm_@permiso.IdPermiso">
                                            @permiso.Codigo
                                        </label>
                                    </div>
                                    <div class="small text-muted mt-1">@permiso.Nombre</div>
                                    <div class="small mt-1">
                                        <span class="badge bg-light text-dark">@permiso.Modulo</span>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-muted">No hay permisos disponibles para asignar.</div>
                }
            </div>
        </div>

        <div class="d-flex justify-content-end mt-3">
            <a class="btn btn-outline-secondary mr-2" href="@Url.Action("Index", "AdminUsuarios")">Volver</a>
            <button type="submit" class="btn btn-success">Guardar permisos</button>
        </div>
    }
}

@section Scripts {
    <script src="~/Scripts/admin-usuarios.js"></script>
}
