@inherits System.Web.Mvc.WebViewPage<CapaPresentacion.Models.AdminUsuarios.AdminUsuarioRolesViewModel>
@using System.Linq
@using System.Web.Mvc
@using System.Web.Mvc.Html

@{
    ViewBag.Title = "Administracion - Roles de usuario";
}

<h2>Asignar roles</h2>
<p class="text-muted">Defina los roles que tendra el usuario seleccionado.</p>

<div class="card mb-3">
    <div class="card-body">
        <div class="row">
            <div class="col-md-3"><strong>Usuario:</strong> @Model.CodigoUsuario</div>
            <div class="col-md-6"><strong>Nombre:</strong> @Model.NombreCompleto</div>
            <div class="col-md-3">
                <strong>Estado:</strong>
                <span class="badge @(Model.Activo ? "bg-success" : "bg-secondary")">
                    @(Model.Activo ? "Activo" : "Inactivo")
                </span>
            </div>
        </div>
    </div>
</div>

@using (Html.BeginForm("Roles", "AdminUsuarios", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.IdUsuario)
    @Html.HiddenFor(m => m.CodigoUsuario)
    @Html.HiddenFor(m => m.NombreCompleto)
    @Html.HiddenFor(m => m.Activo)
    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

    <div class="card">
        <div class="card-header">
            <strong>Roles disponibles</strong>
        </div>
        <div class="card-body">
            <div class="row">
                @if (Model.RolesDisponibles != null && Model.RolesDisponibles.Any())
                {
                    foreach (var rol in Model.RolesDisponibles)
                    {
                        <div class="col-md-4 mb-2">
                            <div class="form-check">
                                <input class="form-check-input"
                                       type="checkbox"
                                       name="RolesSeleccionados"
                                       id="rol_@rol.Value"
                                       value="@rol.Value"
                                       @(rol.Selected ? "checked" : null) />
                                <label class="form-check-label" for="rol_@rol.Value">@rol.Text</label>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="col-12 text-muted">No hay roles disponibles.</div>
                }
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-end mt-3">
        <a class="btn btn-outline-secondary mr-2" href="@Url.Action("Index", "AdminUsuarios")">Cancelar</a>
        <button type="submit" class="btn btn-primary">Guardar roles</button>
    </div>
}

@section Scripts {
    <script src="@Url.Content("~/Scripts/admin-usuarios.js")"></script>
}
