@inherits System.Web.Mvc.WebViewPage<CapaPresentacion.Models.DashboardViewModel>
@using CapaModelo
@using System.Web.Mvc
@using System.Web.Mvc.Html

@{
    ViewBag.Title = "Inicio - Sistema AOCR";
    Layout = "~/Views/Shared/_LayoutAOCR.cshtml";
    ViewBag.AocrHeaderUserName = Model.NombreUsuario;
    ViewBag.AocrHeaderRole = Model.RolUsuario;
    ViewBag.AocrHeaderSubtitle = "Panel ergonómico para seguimiento operativo, control institucional y acceso directo a las acciones del sistema AOCR.";
    ViewBag.AocrHeaderContextBadge = "Inicio";
    ViewBag.AocrHeaderDateValue = DateTime.Now.ToString("dd/MM/yyyy");
    ViewBag.AocrHeaderDateText = "Resumen habilitado para navegación y seguimiento diario";
}

<div class="aocr-view">
    <div class="row g-3 mb-4">
        <div class="col-12 col-md-6 col-xl-3">
            @Html.Partial("_MetricCard", null, new ViewDataDictionary { { "Label", "Pendientes" }, { "Value", Model.SolicitudesPendientes }, { "Modifier", "warning" }, { "Icon", "fas fa-inbox" }, { "Caption", "Solicitudes por revisar" } })
        </div>
        <div class="col-12 col-md-6 col-xl-3">
            @Html.Partial("_MetricCard", null, new ViewDataDictionary { { "Label", "En proceso" }, { "Value", Model.TramitesEnCurso }, { "Modifier", "info" }, { "Icon", "fas fa-gears" }, { "Caption", "Trámites en curso" } })
        </div>
        <div class="col-12 col-md-6 col-xl-3">
            @Html.Partial("_MetricCard", null, new ViewDataDictionary { { "Label", "Avisos" }, { "Value", Model.NotificacionesNuevas }, { "Modifier", "success" }, { "Icon", "fas fa-bell" }, { "Caption", "Notificaciones nuevas" } })
        </div>
        <div class="col-12 col-md-6 col-xl-3">
            @Html.Partial("_MetricCard", null, new ViewDataDictionary { { "Label", "Fecha" }, { "Value", DateTime.Now.ToString("dd MMM yyyy") }, { "Modifier", "primary" }, { "Icon", "fas fa-calendar-day" }, { "Caption", "Referencia institucional" } })
        </div>
    </div>

    <div class="card aocr-card">
        <div class="card-body">
            <h5 class="aocr-section-title"><i class="fas fa-bolt me-2"></i> Acciones rápidas</h5>
            <div class="row g-3">
                @if (Model.MostrarModuloOperador)
                {
                    <div class="col-md-3 col-sm-6">
                        <button class="aocr-quick-action w-100 border-0 text-start"
                                onclick="cargarFormulario(0)">
                            <span class="aocr-quick-action__icon">
                                <i class="fas fa-plus-circle"></i>
                            </span>
                            <span class="aocr-quick-action__body">
                                <strong class="aocr-quick-action__title">Crear Solicitud</strong>
                                <span class="aocr-quick-action__text">Nueva solicitud AOCR</span>
                            </span>
                        </button>
                    </div>
                }
                <div class="col-md-3 col-sm-6">
                    <a class="aocr-quick-action w-100"
                       href="@Url.Action("Index", "SolicitudAOCR")">
                        <span class="aocr-quick-action__icon">
                            <i class="fas fa-file-alt"></i>
                        </span>
                        <span class="aocr-quick-action__body">
                            <strong class="aocr-quick-action__title">Mis Solicitudes</strong>
                            <span class="aocr-quick-action__text">Gestionar mis trámites</span>
                        </span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
