    private static List<RequisitoRender> ConstruirRequisitosRender(IEnumerable<ListaVerificacionOperacionalEaeItem> items)
    {
        var gruposRespuesta = (items ?? Enumerable.Empty<ListaVerificacionOperacionalEaeItem>())
            .Where(item => item != null)
            .GroupBy(ObtenerCodigoPreguntaPdf, StringComparer.OrdinalIgnoreCase)
            .Where(group => !string.IsNullOrWhiteSpace(group.Key))
            .ToDictionary(group => group.Key, group => AgruparRespuestasFilas(group), StringComparer.OrdinalIgnoreCase);

        var requisitos = new List<RequisitoRender>();
        foreach (var requisito in ObtenerRequisitosOficiales())
        {
            List<RespuestaFila> respuestas;
            if (!gruposRespuesta.TryGetValue(requisito.Codigo, out respuestas))
            {
                respuestas = new List<RespuestaFila>();
            }

            var cumplimiento = respuestas
                .Where(respuesta => respuesta != null && respuesta.ItemPrincipal != null)
                .Select(respuesta => (respuesta.ItemPrincipal.EstadoCumplimiento ?? string.Empty).Trim())
                .FirstOrDefault(valor => !string.IsNullOrWhiteSpace(valor)) ?? string.Empty;

            var filas = new List<RequisitoRenderFila>();
            for (var indice = 0; indice < requisito.Filas.Count; indice++)
            {
                var respuesta = indice < respuestas.Count ? respuestas[indice] : null;
                var item = respuesta != null ? respuesta.ItemPrincipal : null;
                var comentarios = item != null ? (item.PruebasNotasComentarios ?? string.Empty).Trim() : string.Empty;
                var implementacion = item != null ? (item.EstadoImplementacion ?? string.Empty).Trim() : string.Empty;
                var longitudTexto = requisito.Pregunta.Length
                    + requisito.NotaPregunta.Length
                    + comentarios.Length
                    + string.Concat(requisito.Filas[indice].Lineas.Select(linea => linea.Texto ?? string.Empty)).Length;

                filas.Add(new RequisitoRenderFila
                {
                    MostrarCabecera = indice == 0,
                    FilaOficial = requisito.Filas[indice],
                    EstadoCumplimiento = indice == 0 ? cumplimiento : string.Empty,
                    EstadoImplementacion = implementacion,
                    Comentarios = comentarios,
                    EsFilaLarga = longitudTexto > 360
                });
            }

            requisitos.Add(new RequisitoRender
            {
                Requisito = requisito,
                Filas = filas
            });
        }

        return requisitos;
    }
}

@{
    Layout = "~/Views/Shared/_PdfLayoutDGACAocr.cshtml";

    var lista = Model != null ? Model.ListaVerificacion : null;
    var cultura = new CultureInfo("es-EC");
    var fechaLista = lista != null && lista.FechaLista.HasValue ? lista.FechaLista.Value.ToString("dd/MM/yyyy", cultura) : string.Empty;
    var cssPath = Server != null ? Server.MapPath("~/Content/pdf-eae-oficial.css") : null;
    var pdfCss = !string.IsNullOrWhiteSpace(cssPath) && File.Exists(cssPath)
        ? File.ReadAllText(cssPath)
        : string.Empty;
    var requisitos = ConstruirRequisitosRender(lista != null ? lista.Items : null);
    Func<string, string> texto = value => !string.IsNullOrWhiteSpace(value) ? value.Trim() : string.Empty;
    Func<string, string, string> check = (actual, esperado) => string.Equals((actual ?? string.Empty).Trim(), esperado, StringComparison.OrdinalIgnoreCase) ? "☑" : "□";
}

@section PdfHead {
    <style>
        @Html.Raw(pdfCss)
    </style>
}

<div class="pdf-eae-oficial">
    <div class="title-box">
        <div>SISTEMA REGIONAL DE COOPERACIÓN PARA LA VIGILANCIA<br />DE LA SEGURIDAD OPERACIONAL</div>
        <div class="title-box-main">Evaluación técnica de un explotador de servicios aéreos extranjero (EAE)</div>
        <div class="title-box-rdac">RDAC 129</div>
    </div>

    <table class="field-table">
        <tbody>
            <tr><td class="field-row"><span class="field-label">1. Nombre del EAE / Nombre comercial del EAE:</span> <span class="field-value">@texto(lista != null ? lista.NombreEae : null)</span></td></tr>
            <tr><td class="field-row"><span class="field-label">2. N° AOC / Fecha de expedición / Validez:</span> <span class="field-value">@texto(lista != null ? lista.NumeroAocFechaValidez : null)</span></td></tr>
            <tr><td class="field-row"><span class="field-label">3. Dirección del EAE y datos de contacto de la gerencia de operaciones en el Estado del explotador:</span> <span class="field-value">@texto(lista != null ? lista.DireccionEstadoExplotador : null)</span></td></tr>
            <tr><td class="field-row"><span class="field-label">4. Dirección del EAE y datos de contacto en el Estado que emite el reconocimiento:</span> <span class="field-value">@texto(lista != null ? lista.DireccionEstadoReconocimiento : null)</span></td></tr>
            <tr><td class="field-row"><span class="field-label">5. Tipo/s de aeronave/s (marca, modelo, número de serie):</span> <span class="field-value">@texto(lista != null ? lista.TiposAeronaves : null)</span></td></tr>
            <tr><td class="field-row"><span class="field-label">6. Tipo de operación:</span> <span class="field-value">@texto(lista != null ? lista.TipoOperacion : null)</span></td></tr>
            <tr><td class="field-row"><span class="field-label">7. Fecha:</span> <span class="field-value">@fechaLista</span></td></tr>
            <tr><td class="field-row"><span class="field-label">8. Inspector responsable de la aprobación:</span> <span class="field-value">@texto(lista != null ? lista.InspectorResponsable : null)</span></td></tr>
        </tbody>
    </table>

    <table class="official-table">
        <colgroup>
            <col class="col-ref" />
            <col class="col-question" />
            <col class="col-compliance" />
            <col class="col-guidance" />
            <col class="col-implementation" />
            <col class="col-comments" />
        </colgroup>
        <thead>
            <tr>
                <th>9. Referencia</th>
                <th>10. Pregunta del requisito</th>
                <th>11. Estado de cumplimiento del requisito</th>
                <th>12. Orientación para el examen de pruebas o evidencias</th>
                <th>13. Estado de implementación</th>
                <th>14. Pruebas / Notas/ Comentarios</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var requisito in requisitos)
            {
                for (var indice = 0; indice < requisito.Filas.Count; indice++)
                {
                    var fila = requisito.Filas[indice];
                    <tr class="@(fila.EsFilaLarga ? "long-row" : string.Empty)">
                        @if (fila.MostrarCabecera)
                        {
                            <td>
                                @foreach (var referencia in requisito.Requisito.Referencias)
                                {
                                    <div class="reference-line">@referencia</div>
                                }
                            </td>
                            <td>
                                <span class="question-code">@requisito.Requisito.Codigo</span>
                                <span class="question-text">@requisito.Requisito.Pregunta</span>
                                @if (!string.IsNullOrWhiteSpace(requisito.Requisito.NotaPregunta))
                                {
                                    <span class="nota">@requisito.Requisito.NotaPregunta</span>
                                }
                            </td>
                            <td>
                                <span class="check-option">@check(fila.EstadoCumplimiento, "SATISFACTORIO") Satisfactorio</span>
                                <span class="check-option">@check(fila.EstadoCumplimiento, "NO_SATISFACTORIO") No satisfactorio</span>
                                <span class="check-option">@check(fila.EstadoCumplimiento, "NO_APLICABLE") No aplicable</span>
                            </td>
                        }
                        else
                        {
                            <td class="empty-cell"></td>
                            <td class="empty-cell"></td>
                            <td class="empty-cell"></td>
                        }
                        <td>
                            @foreach (var linea in fila.FilaOficial.Lineas)
                            {
                                <span class="orientation-line @(linea.CssClass)">@linea.Texto</span>
                            }
                        </td>
                        <td>
                            <span class="check-option-tight">@check(fila.EstadoImplementacion, "IMPLEMENTADO")Implementado</span>
                            <span class="check-option-tight">@check(fila.EstadoImplementacion, "NO_IMPLEMENTADO")No implementado</span>
                            <span class="check-option-tight">@check(fila.EstadoImplementacion, "NO_APLICABLE")No aplicable</span>
                        </td>
                        <td class="comments-cell">@fila.Comentarios</td>
                    </tr>
                }
            }
        </tbody>
    </table>

    <div class="closing-line">-----------------------</div>
</div>