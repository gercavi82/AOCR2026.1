@model CapaPresentacion.Models.ViewModels.ListaVerificacionOperacionalEaePdfViewModel
@using System
@using System.Collections.Generic
@using System.Globalization
@using System.IO
@using System.Linq
@using CapaModelo

@functions {
    private sealed class OficialTextoLinea
    {
        public OficialTextoLinea(string texto, string cssClass = null)
        {
            Texto = texto ?? string.Empty;
            CssClass = cssClass ?? string.Empty;
        }

        public string Texto { get; private set; }
        public string CssClass { get; private set; }
    }

    private sealed class OficialFila
    {
        public OficialFila(params OficialTextoLinea[] lineas)
        {
            Lineas = new List<OficialTextoLinea>(lineas ?? new OficialTextoLinea[0]);
        }

        public IList<OficialTextoLinea> Lineas { get; private set; }
    }

    private sealed class OficialRequisito
    {
        public OficialRequisito(string codigo, string[] referencias, string pregunta, string notaPregunta, params OficialFila[] filas)
        {
            Codigo = codigo ?? string.Empty;
            Referencias = new List<string>(referencias ?? new string[0]);
            Pregunta = pregunta ?? string.Empty;
            NotaPregunta = notaPregunta ?? string.Empty;
            Filas = new List<OficialFila>(filas ?? new OficialFila[0]);
        }

        public string Codigo { get; private set; }
        public IList<string> Referencias { get; private set; }
        public string Pregunta { get; private set; }
        public string NotaPregunta { get; private set; }
        public IList<OficialFila> Filas { get; private set; }
    }

    private sealed class RespuestaFila
    {
        public ListaVerificacionOperacionalEaeItem ItemPrincipal { get; set; }
    }

    private sealed class RequisitoRenderFila
    {
        public bool MostrarCabecera { get; set; }
        public OficialFila FilaOficial { get; set; }
        public string EstadoCumplimiento { get; set; }
        public string EstadoImplementacion { get; set; }
        public string Comentarios { get; set; }
        public bool EsFilaLarga { get; set; }
    }

    private sealed class RequisitoRender
    {
        public OficialRequisito Requisito { get; set; }
        public IList<RequisitoRenderFila> Filas { get; set; }
    }

    private static OficialTextoLinea Linea(string texto, string cssClass = null)
    {
        return new OficialTextoLinea(texto, cssClass);
    }

    private static OficialFila Fila(params OficialTextoLinea[] lineas)
    {
        return new OficialFila(lineas);
    }

    private static string ObtenerCodigoPreguntaPdf(ListaVerificacionOperacionalEaeItem item)
    {
        if (item == null)
        {
            return string.Empty;
        }

        var codigo = !string.IsNullOrWhiteSpace(item.CodigoPregunta)
            ? item.CodigoPregunta.Trim()
            : (item.Codigo ?? string.Empty).Trim();

        if (string.IsNullOrWhiteSpace(codigo))
        {
            return string.Empty;
        }

        var indiceUltimoGuion = codigo.LastIndexOf('-');
        if (indiceUltimoGuion > 0)
        {
            int sufijo;
            if (int.TryParse(codigo.Substring(indiceUltimoGuion + 1), out sufijo))
            {
                return codigo.Substring(0, indiceUltimoGuion).Trim();
            }
        }

        return codigo;
    }

    private static List<RespuestaFila> AgruparRespuestasFilas(IEnumerable<ListaVerificacionOperacionalEaeItem> items)
    {
        var filas = new List<RespuestaFila>();
        RespuestaFila filaActual = null;

        foreach (var item in (items ?? Enumerable.Empty<ListaVerificacionOperacionalEaeItem>()).OrderBy(valor => valor.Orden))
        {
            if (filaActual == null || !item.EsNotaOrientacion)
            {
                filaActual = new RespuestaFila
                {
                    ItemPrincipal = item
                };
                filas.Add(filaActual);
            }
        }

        return filas;
    }

