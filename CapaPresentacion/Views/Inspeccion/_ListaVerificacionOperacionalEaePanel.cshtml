@model CapaPresentacion.Models.ViewModels.ListaVerificacionOperacionalEaePanelVm
@using System
@using System.Collections.Generic
@using System.Linq
@using CapaModelo
@using CapaPresentacion.Models.ViewModels

@{
    var vm = Model ?? new ListaVerificacionOperacionalEaePanelVm();
    var lista = vm.ListaVerificacion ?? new ListaVerificacionOperacionalEae();
    var items = (lista.Items ?? new List<ListaVerificacionOperacionalEaeItem>()).OrderBy(item => item.Orden).ToList();
    var gruposItems = items
        .GroupBy(item => item.GrupoRequisitoId > 0 ? item.GrupoRequisitoId : item.Orden)
        .OrderBy(group => group.Min(item => item.Orden))
        .Select(group => group.OrderBy(item => item.Orden).ToList())
        .ToList();
    var tieneLv = lista.CodigoListaVerificacion > 0 || items.Any(item => !string.IsNullOrWhiteSpace(item.EstadoCumplimiento) || !string.IsNullOrWhiteSpace(item.EstadoImplementacion) || !string.IsNullOrWhiteSpace(item.PruebasNotasComentarios));
    var tienePdf = !string.IsNullOrWhiteSpace(vm.UrlVisualizacion);
    var firmada = vm.EstaFirmada || (lista.Finalizado && lista.FirmadoTecnico);
    var finalizada = lista.Finalizado;
    var estado = (lista.EstadoLista ?? "LV_BORRADOR").ToUpperInvariant();

    string estadoLabel;
    string estadoClass;
    switch (estado)
    {
        case "LV_FIRMADA":
        case "FIRMADA":
            estadoLabel = "LV firmada";
            estadoClass = "success";
            break;
        case "LV_COMPLETADA":
        case "FINALIZADA":
        case "COMPLETA":
            estadoLabel = "LV completada";
            estadoClass = "primary";
            break;
        default:
            estadoLabel = tieneLv ? "LV borrador" : "Sin LV";
            estadoClass = tieneLv ? "secondary" : "warning";
            break;
    }
}

<style>
    #bloqueListaVerificacionOperacionalEae .aocr-lv-wrapper {
        width: 100%;
    }

    #bloqueListaVerificacionOperacionalEae .aocr-lv-document-header {
        border: 1px solid #222;
        background: #fff;
        padding: 12px 14px;
        margin-bottom: 16px;
    }

    #bloqueListaVerificacionOperacionalEae .aocr-lv-manual-top {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 6px;
        font-size: 0.75rem;
        color: #333;
    }

    #bloqueListaVerificacionOperacionalEae .aocr-lv-manual-top td {
        border: none;
        padding: 0;
        vertical-align: top;
    }

    #bloqueListaVerificacionOperacionalEae .aocr-lv-manual-right {
        text-align: right;
    }

    #bloqueListaVerificacionOperacionalEae .aocr-lv-institution {
        text-align: center;
        font-weight: 700;
        font-size: 1rem;
        text-transform: uppercase;
        line-height: 1.3;
        margin-top: 4px;
    }

    #bloqueListaVerificacionOperacionalEae .aocr-lv-title-document {
        text-align: center;
        font-weight: 700;
        font-size: 0.95rem;
        line-height: 1.35;
        margin-top: 4px;
        text-transform: uppercase;
    }

    #bloqueListaVerificacionOperacionalEae .aocr-lv-rdac {
        text-align: center;
        font-weight: 700;
        margin-top: 4px;
    }

    #bloqueListaVerificacionOperacionalEae .aocr-lv-scroll-container {
        width: 100%;
        overflow-x: auto;
        overflow-y: visible;
        -webkit-overflow-scrolling: touch;
        border: 1px solid #222;
        background: #ffffff;
    }

    #bloqueListaVerificacionOperacionalEae .aocr-lv-table {
        min-width: 1350px;
        width: 100%;
        margin-bottom: 0;
        border-collapse: collapse;
        table-layout: fixed;
    }

    #bloqueListaVerificacionOperacionalEae .aocr-lv-table th,
    #bloqueListaVerificacionOperacionalEae .aocr-lv-table td {
        border: 1px solid #222;
        padding: 6px;
        vertical-align: top;
        white-space: normal;
        word-wrap: break-word;
        overflow-wrap: break-word;
    }

    #bloqueListaVerificacionOperacionalEae .aocr-lv-table th {
        font-size: 0.78rem;
        font-weight: 700;
        text-align: left;
        background: #d9d9d9;
    }

    #bloqueListaVerificacionOperacionalEae .aocr-lv-table td {
        font-size: 0.79rem;
    }

    #bloqueListaVerificacionOperacionalEae .aocr-lv-table .form-control {
        min-width: 160px;
    }

    #bloqueListaVerificacionOperacionalEae .aocr-lv-table .lv-observacion {
        min-width: 220px;
        min-height: 90px;
        resize: vertical;
    }

    #bloqueListaVerificacionOperacionalEae .aocr-lv-col-ref {
        width: 9%;
    }

    #bloqueListaVerificacionOperacionalEae .aocr-lv-col-pregunta {
        width: 17%;
    }

    #bloqueListaVerificacionOperacionalEae .aocr-lv-col-cumplimiento {
        width: 15%;
    }

    #bloqueListaVerificacionOperacionalEae .aocr-lv-col-orientacion {
        width: 24%;
    }

    #bloqueListaVerificacionOperacionalEae .aocr-lv-col-implementacion {
        width: 15%;
    }

    #bloqueListaVerificacionOperacionalEae .aocr-lv-col-comentarios {
        width: 20%;
    }

    #bloqueListaVerificacionOperacionalEae .lv-group-cell {
        background: #fafafa;
    }

    #bloqueListaVerificacionOperacionalEae .lv-question-code {
        display: block;
        font-weight: 700;
        margin-bottom: 4px;
    }

    #bloqueListaVerificacionOperacionalEae .lv-question-text {
        white-space: pre-line;
        line-height: 1.45;
    }

    #bloqueListaVerificacionOperacionalEae .lv-check-group {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    #bloqueListaVerificacionOperacionalEae .lv-check-group label {
        display: flex;
        align-items: center;
        gap: 5px;
        margin: 0;
        font-weight: 400;
        line-height: 1.35;
    }

    #bloqueListaVerificacionOperacionalEae .lv-check-group input[type="radio"] {
        margin: 0;
    }

    #bloqueListaVerificacionOperacionalEae .lv-nota {
        margin-top: 8px;
        padding: 8px 10px;
        border-left: 4px solid #0c7c86;
        border-radius: 8px;
        background: #f5fbfc;
        line-height: 1.4;
    }

    #bloqueListaVerificacionOperacionalEae .lv-guidance-text {
        white-space: pre-line;
        line-height: 1.45;
        text-align: justify;
    }

    #bloqueListaVerificacionOperacionalEae .lv-guidance-stack {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    #bloqueListaVerificacionOperacionalEae .lv-guidance-entry + .lv-guidance-entry {
        border-top: 1px solid #d4d4d8;
        padding-top: 8px;
    }

    #bloqueListaVerificacionOperacionalEae .lv-orientacion-subnumeral {
        font-weight: 600;
    }

    #bloqueListaVerificacionOperacionalEae .lv-orientacion-literal {
        padding-left: 12px;
    }

    #bloqueListaVerificacionOperacionalEae .lv-orientacion-nota {
        font-style: italic;
        background: #f8fafc;
        border-left: 3px solid #64748b;
        padding: 6px 8px;
    }

    #bloqueListaVerificacionOperacionalEae .aocr-lv-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    #bloqueListaVerificacionOperacionalEae .aocr-lv-headline {
        display: inline-flex;
        flex-wrap: wrap;
        gap: 0.4rem;
        align-items: center;
    }

    #bloqueListaVerificacionOperacionalEae .aocr-lv-meta .form-label {
        margin-bottom: 0.35rem;
        font-weight: 700;
    }

    @@media (max-width: 1440px) {
        #bloqueListaVerificacionOperacionalEae .aocr-lv-wrapper {
            padding: 12px;
        }

        #bloqueListaVerificacionOperacionalEae .aocr-lv-table {
            min-width: 1250px;
        }

        #bloqueListaVerificacionOperacionalEae .aocr-lv-table th,
        #bloqueListaVerificacionOperacionalEae .aocr-lv-table td {
            font-size: 11.5px;
            padding: 5px;
            vertical-align: top;
        }
    }

    @@media (max-width: 768px) {
        #bloqueListaVerificacionOperacionalEae .aocr-lv-wrapper {
            padding: 8px;
        }

        #bloqueListaVerificacionOperacionalEae .aocr-lv-table {
            min-width: 1150px;
        }

        #bloqueListaVerificacionOperacionalEae .aocr-lv-actions .btn {
            width: 100%;
        }
    }
</style>

<div class="card section-card soft-card" id="bloqueListaVerificacionOperacionalEae">
    <div class="card-body">
        <div class="aocr-lv-wrapper">
        <div class="section-heading">
            <div class="section-icon">
                <i class="fas fa-clipboard-check"></i>
            </div>
            <div>
                <h2 class="section-title">LISTA DE VERIFICACIÓN OPERACIONAL (LV)</h2>
                <p class="section-copy">Evaluación técnica de un explotador de servicios aéreos extranjero (EAE) - RDAC 129</p>
            </div>
        </div>

        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-3">
            <div>
                <span class="badge bg-@estadoClass">@estadoLabel</span>
                <span class="ms-2 text-muted">Resultado general: <strong>@(string.IsNullOrWhiteSpace(lista.ResultadoGeneral) ? "PENDIENTE" : lista.ResultadoGeneral)</strong></span>
            </div>
            <div class="d-flex flex-column flex-md-row gap-2">
                @if (tienePdf)
                {
                    <a class="btn btn-outline-primary" href="@vm.UrlVisualizacion" target="_blank" rel="noopener">
                        <i class="fas fa-file-pdf me-1"></i> Vista previa LV
                    </a>
                    <a class="btn btn-outline-secondary" href="@vm.UrlDescarga" target="_blank" rel="noopener">
                        <i class="fas fa-download me-1"></i> Descargar LV
                    </a>
                }
            </div>
        </div>

        @if (!tieneLv)
        {
            <div class="alert alert-warning alert-inline mb-3">
                Antes de generar el Informe Tecnico debe completar la Lista de Verificacion Operacional (LV).
            </div>
        }
        else if (firmada)
        {
            <div class="alert alert-success alert-inline mb-3">
                La Lista de Verificacion Operacional ya fue firmada. Ahora puede generar el Informe Tecnico.
                Flujo simplificado activo: LV firmada + Informe Tecnico firmado por Tecnico / Inspector.
            </div>
        }
        else if (finalizada)
        {
            <div class="alert alert-info alert-inline mb-3">
                La Lista de Verificacion Operacional fue completada correctamente. Proceda con la firma del Tecnico / Inspector.
            </div>
        }
        else
        {
            <div class="alert alert-warning alert-inline mb-3">
                Informe Tecnico bloqueado. Primero complete y firme la Lista de Verificacion Operacional (LV).
            </div>
        }

        @if (tienePdf)
        {
            @Html.Partial("~/Views/Shared/_AocrPdfViewer.cshtml", new AocrPdfViewerViewModel
            {
                PdfUrl = vm.UrlVisualizacion,
                DescargarUrl = vm.UrlDescarga,
                Titulo = "Lista de Verificacion Operacional (LV)",
                EstadoDocumento = lista.EstadoLista ?? "LV_BORRADOR",
                MensajeAyuda = firmada ? "LV firmada por el Tecnico / Inspector responsable." : "Revise el PDF generado antes de aplicar la firma digital.",
                PermitirDescarga = true,
                PermitirImpresion = true,
                MostrarToolbar = true,
                ContenedorId = "viewerListaVerificacionOperacionalEae",
                PantallaCompleta = false
            })
        }
        else if (finalizada || firmada)
        {
            <div class="alert alert-warning alert-inline mb-3">
                El registro de la LV/EAE existe, pero el PDF asociado no está disponible en el servidor. Debe regenerarse o volver a finalizarse antes de abrir la vista previa.
            </div>
        }

        @if (!vm.PuedeEditar && !firmada)
        {
            <div class="alert alert-warning alert-inline mb-3">
                @(!string.IsNullOrWhiteSpace(vm.MensajeBloqueoEdicion)
                    ? vm.MensajeBloqueoEdicion
                    : "La lista de verificación operacional se encuentra disponible solo en modo consulta para su rol o en el estado actual del trámite.")
            </div>

            <div class="d-flex flex-column flex-md-row gap-2 mb-3">
                @if (!string.IsNullOrWhiteSpace(vm.UrlDocumentosSolicitud))
                {
                    <a class="btn btn-outline-primary" href="@vm.UrlDocumentosSolicitud" target="_blank" rel="noopener">
                        <i class="fas fa-file-alt me-1"></i> Ver documentos de la solicitud
                    </a>
                }

                @if (vm.PuedeConfirmarRevisionDocumental)
                {
                    using (Html.BeginForm("ConfirmarRevisionDocumentalInspector", "Inspeccion", FormMethod.Post, new { @class = "mb-0" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.Hidden("id", vm.CodigoInspeccion)
                        <button type="submit" class="btn btn-warning">
                            <i class="fas fa-check-double me-1"></i> Confirmar revisión documental
                        </button>
                    }
                }
            </div>

            <div class="alert alert-light alert-inline mb-3">
                Cuando la revisión documental esté confirmada, esta misma ventana mostrará la cabecera completa de la LV/EAE, la tabla de criterios y los botones para guardar, finalizar o firmar.
            </div>
        }

        @if (vm.PuedeEditar && !firmada)
        {
            using (Html.BeginForm("GuardarListaVerificacionOperacionalEae", "Inspeccion", FormMethod.Post, new { @class = "mt-4" }))
            {
                @Html.AntiForgeryToken()
                @Html.Hidden("id", vm.CodigoInspeccion)

                <div class="aocr-lv-document-header">
                    <table class="aocr-lv-manual-top">
                        <tr>
                            <td>Parte II - Explotadores de servicios aereos<br />Volumen VII - Vigilancia de explotadores extranjeros en operaciones de transporte aereo comercial</td>
                            <td class="aocr-lv-manual-right">Capitulo 2 - Solicitud, evaluacion y aprobacion de un explotador extranjero<br />Manual del Inspector de Operaciones Ecuador</td>
                        </tr>
                    </table>
                    <div class="aocr-lv-institution">DIRECCION GENERAL DE AVIACION CIVIL</div>
                    <div class="aocr-lv-title-document">
                        LISTA DE VERIFICACION (LV)<br />
                        EVALUACION TECNICA DE UN EXPLOTADOR DE SERVICIOS AEREOS EXTRANJERO (EAE)
                    </div>
                    <div class="aocr-lv-rdac">RDAC 129</div>
                </div>

                <div class="row g-3 mb-3 aocr-lv-meta">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">1. Nombre del EAE / Nombre comercial del EAE</label>
                        <input class="form-control" name="lvNombreEae" value="@(lista.NombreEae ?? string.Empty)" required="required" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">2. N AOC / Fecha de expedicion / Validez</label>
                        <input class="form-control" name="lvNumeroAocFechaValidez" value="@(lista.NumeroAocFechaValidez ?? string.Empty)" required="required" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">3. Direccion del EAE y contacto en Estado del explotador</label>
                        <textarea class="form-control" name="lvDireccionEstadoExplotador" rows="2" required="required">@(lista.DireccionEstadoExplotador ?? string.Empty)</textarea>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">4. Direccion del EAE y contacto en Estado que emite reconocimiento</label>
                        <textarea class="form-control" name="lvDireccionEstadoReconocimiento" rows="2" required="required">@(lista.DireccionEstadoReconocimiento ?? string.Empty)</textarea>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">5. Tipo/s de aeronave/s: marca, modelo, numero de serie</label>
                        <textarea class="form-control" name="lvTiposAeronaves" rows="2" required="required">@(lista.TiposAeronaves ?? string.Empty)</textarea>
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="form-label">6. Tipo de operacion</label>
                        <input class="form-control" name="lvTipoOperacion" value="@(lista.TipoOperacion ?? string.Empty)" required="required" />
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="form-label">7. Fecha</label>
                        <input class="form-control" type="date" name="lvFecha" value="@(lista.FechaLista.HasValue ? lista.FechaLista.Value.ToString("yyyy-MM-dd") : DateTime.Now.ToString("yyyy-MM-dd"))" required="required" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">8. Inspector responsable de la aprobacion</label>
                        <input class="form-control" name="lvInspectorResponsable" value="@(lista.InspectorResponsable ?? string.Empty)" required="required" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Cargo del Tecnico / Inspector</label>
                        <input class="form-control" name="lvCargoInspector" value="@(string.IsNullOrWhiteSpace(lista.CargoInspector) ? "Tecnico / Inspector responsable" : lista.CargoInspector)" />
                    </div>
                </div>

                <div class="aocr-lv-scroll-container">
                    <table class="table table-bordered align-middle lv-operacional-table aocr-lv-table aocr-lv-eae-table">
                        <thead class="table-light">
                            <tr>
                                <th class="aocr-lv-col-ref">9.<br />Referencia</th>
                                <th class="aocr-lv-col-pregunta">10.<br />Pregunta del requisito</th>
                                <th class="aocr-lv-col-cumplimiento">11.<br />Estado de cumplimiento del requisito</th>
                                <th class="aocr-lv-col-orientacion">12.<br />Orientacion para el examen de pruebas o evidencias</th>
                                <th class="aocr-lv-col-implementacion">13.<br />Estado de implementacion</th>
                                <th class="aocr-lv-col-comentarios">14.<br />Pruebas / Notas / Comentarios</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var grupo in gruposItems)
                            {
                                var itemCabecera = grupo.First();
                                var filasGrupo = new List<List<ListaVerificacionOperacionalEaeItem>>();
                                List<ListaVerificacionOperacionalEaeItem> filaActual = null;
                                foreach (var itemGrupo in grupo)
                                {
                                    if (filaActual == null || !itemGrupo.EsNotaOrientacion)
                                    {
                                        filaActual = new List<ListaVerificacionOperacionalEaeItem> { itemGrupo };
                                        filasGrupo.Add(filaActual);
                                    }
                                    else
                                    {
                                        filaActual.Add(itemGrupo);
                                    }
                                }

                                for (var indice = 0; indice < filasGrupo.Count; indice++)
                                {
                                    var filaGrupo = filasGrupo[indice];
                                    var item = filaGrupo.First();
                                    var cumplimiento = (item.EstadoCumplimiento ?? string.Empty).Trim().ToUpperInvariant();
                                    var implementacion = (item.EstadoImplementacion ?? string.Empty).Trim().ToUpperInvariant();
                                    var etiquetaOrientacion = ((item.CodigoPregunta ?? item.Codigo ?? string.Empty) + " - " + (item.OrientacionEvidencia ?? string.Empty).Replace("\r\n", " ").Replace("\n", " ")).Trim();
                                    if (etiquetaOrientacion.Length > 160)
                                    {
                                        etiquetaOrientacion = etiquetaOrientacion.Substring(0, 157).TrimEnd() + "...";
                                    }
                                    <tr data-item-codigo="@item.Codigo" data-item-label="@etiquetaOrientacion">
                                        @if (indice == 0)
                                        {
                                            <td class="aocr-lv-col-ref lv-group-cell" rowspan="@filasGrupo.Count" style="white-space:pre-line;">@itemCabecera.Referencia</td>
                                            <td class="aocr-lv-col-pregunta lv-group-cell" rowspan="@filasGrupo.Count">
                                                <span class="lv-question-code">@(!string.IsNullOrWhiteSpace(itemCabecera.CodigoPregunta) ? itemCabecera.CodigoPregunta : itemCabecera.Codigo)</span>
                                                <div class="lv-question-text">@itemCabecera.PreguntaRequisito</div>
                                                @if (!string.IsNullOrWhiteSpace(itemCabecera.NotaPregunta))
                                                {
                                                    <div class="lv-nota">
                                                        <strong>Nota:</strong> @itemCabecera.NotaPregunta
                                                    </div>
                                                }
                                            </td>
                                        }
                                        <td class="aocr-lv-col-cumplimiento">
                                            <div class="lv-check-group">
                                                <label>
                                                    <input type="radio" class="lv-cumplimiento" name="@("lvItem_" + item.Codigo + "_cumplimiento")" value="SATISFACTORIO" @(cumplimiento == "SATISFACTORIO" ? "checked=\"checked\"" : null) />
                                                    Satisfactorio
                                                </label>
                                                <label>
                                                    <input type="radio" class="lv-cumplimiento" name="@("lvItem_" + item.Codigo + "_cumplimiento")" value="NO_SATISFACTORIO" @(cumplimiento == "NO_SATISFACTORIO" ? "checked=\"checked\"" : null) />
                                                    No satisfactorio
                                                </label>
                                                <label>
                                                    <input type="radio" class="lv-cumplimiento" name="@("lvItem_" + item.Codigo + "_cumplimiento")" value="NO_APLICABLE" @(cumplimiento == "NO_APLICABLE" ? "checked=\"checked\"" : null) />
                                                    No aplicable
                                                </label>
                                            </div>
                                        </td>
                                        <td class="aocr-lv-col-orientacion">
                                            <div class="lv-guidance-stack">
                                                @foreach (var orientacion in filaGrupo)
                                                {
                                                    <div class="lv-guidance-entry lv-guidance-text @(orientacion.EsNotaOrientacion ? "lv-orientacion-nota" : orientacion.EsLiteral ? "lv-orientacion-literal" : orientacion.EsSubnumeral ? "lv-orientacion-subnumeral" : string.Empty)">@orientacion.OrientacionEvidencia</div>
                                                }
                                            </div>
                                        </td>
                                        <td class="aocr-lv-col-implementacion">
                                            <div class="lv-check-group">
                                                <label>
                                                    <input type="radio" class="lv-implementacion" name="@("lvItem_" + item.Codigo + "_implementacion")" value="IMPLEMENTADO" @(implementacion == "IMPLEMENTADO" ? "checked=\"checked\"" : null) />
                                                    Implementado
                                                </label>
                                                <label>
                                                    <input type="radio" class="lv-implementacion" name="@("lvItem_" + item.Codigo + "_implementacion")" value="NO_IMPLEMENTADO" @(implementacion == "NO_IMPLEMENTADO" ? "checked=\"checked\"" : null) />
                                                    No implementado
                                                </label>
                                                <label>
                                                    <input type="radio" class="lv-implementacion" name="@("lvItem_" + item.Codigo + "_implementacion")" value="NO_APLICABLE" @(implementacion == "NO_APLICABLE" ? "checked=\"checked\"" : null) />
                                                    No aplicable
                                                </label>
                                            </div>
                                        </td>
                                        <td class="aocr-lv-col-comentarios">
                                            <textarea class="form-control lv-comentarios lv-observacion" name="@("lvItem_" + item.Codigo + "_comentarios")" rows="4" placeholder="Pruebas, notas o comentarios. Obligatorio si marca No satisfactorio o No implementado.">@(item.PruebasNotasComentarios ?? string.Empty)</textarea>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                <div class="d-flex flex-column flex-md-row gap-2 mt-3 lv-operacional-actions aocr-lv-actions">
                    <button type="submit" class="btn btn-outline-primary">
                        <i class="fas fa-save me-1"></i> Guardar LV
                    </button>
                    <button type="submit" class="btn btn-primary" name="finalizar" value="true" onclick="return validarComentariosLvEae(this.form);">
                        <i class="fas fa-file-pdf me-1"></i> Finalizar LV
                    </button>
                </div>
            }
        }

        @if (finalizada && !firmada && vm.PuedeFirmar)
        {
            <div class="card mt-4 border-0 bg-light">
                <div class="card-body">
                    <h5 class="mb-3"><i class="fas fa-signature me-2"></i>Firma del Tecnico / Inspector responsable de la LV</h5>
                    @using (Html.BeginForm("FirmarListaVerificacionOperacionalEae", "Inspeccion", FormMethod.Post, new { enctype = "multipart/form-data" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.Hidden("id", vm.CodigoInspeccion)

                        <div class="row g-3">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Certificado digital (.p12 / .pfx)</label>
                                <input type="file" name="CertificadoInspector" class="form-control" accept=".p12,.pfx" required="required" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Contrasena del certificado</label>
                                <input type="password" name="passwordCertificado" class="form-control" autocomplete="off" required="required" />
                            </div>
                        </div>
                        <div class="lv-signature-actions">
                            <button type="submit" class="btn btn-success">
                                <i class="fas fa-shield-alt me-1"></i> Firmar Lista de Verificacion LV
                            </button>
                        </div>
                    }
                </div>
            </div>
        }
        </div>
    </div>
</div>

<script>
function validarComentariosLvEae(form) {
    if (!form) return true;
    var filas = form.querySelectorAll('.lv-operacional-table tbody tr');
    for (var i = 0; i < filas.length; i++) {
        var fila = filas[i];
        var cumplimiento = fila.querySelector('.lv-cumplimiento:checked');
        var implementacion = fila.querySelector('.lv-implementacion:checked');
        var comentarios = fila.querySelector('.lv-comentarios');
        var etiqueta = fila.getAttribute('data-item-label') || fila.getAttribute('data-item-codigo') || ('ítem ' + (i + 1));

        if (!cumplimiento) {
            alert('Seleccione el estado de cumplimiento para la orientacion ' + etiqueta + '.');
            var primeraOpcionCumplimiento = fila.querySelector('.lv-cumplimiento');
            if (primeraOpcionCumplimiento) {
                primeraOpcionCumplimiento.focus();
            }
            return false;
        }

        if (!implementacion) {
            alert('Seleccione el estado de implementación para la orientacion ' + etiqueta + '.');
            var primeraOpcionImplementacion = fila.querySelector('.lv-implementacion');
            if (primeraOpcionImplementacion) {
                primeraOpcionImplementacion.focus();
            }
            return false;
        }

        var requiereComentario = cumplimiento.value === 'NO_SATISFACTORIO' || implementacion.value === 'NO_IMPLEMENTADO';
        if (requiereComentario && comentarios && !comentarios.value.trim()) {
            alert('Ingrese Pruebas / Notas / Comentarios para la orientacion ' + etiqueta + '.');
            comentarios.focus();
            return false;
        }
    }
    return confirm('Confirma que desea finalizar la Lista de Verificacion Operacional (LV) y generar el PDF?');
}
</script>
