@* Partial: Sección completa de Dirección / Jefatura — bloque separado en Detalle *@
@{
    var informeTecnico = ViewBag.InformeTecnico as CapaModelo.InspeccionInformeTecnico;
    var codigoInspeccion = (int)ViewBag.CodigoInspeccion;
    var esDirdac = (bool)(ViewBag.EsDirdac ?? false);
    var esInspector = (bool)(ViewBag.EsInspector ?? false);
    var esSolicitante = (bool)(ViewBag.EsSolicitante ?? false);
    var puedeFirmarDirdac = (bool)(ViewBag.PuedeFirmarDirdac ?? false);
    var informeEnviadoADirdac = (bool)(ViewBag.InformeEnviadoADirdac ?? false);
    var notificacionFormalDirdac = (bool)(ViewBag.NotificacionFormalDirdac ?? false);
    var estadoInformeTecnico = (string)ViewBag.EstadoInformeTecnico ?? "BORRADOR";
    var rutaInformeVisual = (string)ViewBag.RutaInformeVisual;
    var tieneInforme = !string.IsNullOrWhiteSpace(rutaInformeVisual);

    // Determinar visibilidad: mostrar sección si hay informe enviado/firmado o si es DIRDAC
    var informeRelevante = informeTecnico != null && informeTecnico.Finalizado
        && (informeTecnico.FirmadoInspector || informeEnviadoADirdac || informeTecnico.FirmadoDirdac);
    var mostrarSeccion = informeRelevante || esDirdac;
}

@if (mostrarSeccion && informeTecnico != null)
{
<div class="card section-card" style="border-left: 4px solid #6f42c1;">
    <div class="card-body">
        <div class="section-heading">
            <div class="section-icon" style="background: #6f42c1;">
                <i class="fas fa-university"></i>
            </div>
            <div>
                <h2 class="section-title">Dirección / Jefatura</h2>
                <p class="section-copy">Revisión institucional, firma digital de Dirección y trazabilidad del informe técnico remitido.</p>
            </div>
        </div>

        @* ══════════════════════════════════════════════════════════
           MENSAJERÍA INSTITUCIONAL
           ══════════════════════════════════════════════════════════ *@
        @if (informeTecnico.FirmadoDirdac)
        {
            <div class="alert mb-3" style="background:#d1e7dd; border-left:4px solid #198754; color:#0a3622; font-size:0.9rem;">
                <i class="fas fa-check-circle me-1"></i>
                <strong>Proceso de firma finalizado.</strong>
                El informe técnico ha sido firmado por el Inspector DGAC y por Dirección / Jefatura.
                El trámite avanza a la siguiente etapa (generación de certificado AOCR).
            </div>
        }
        else if (informeEnviadoADirdac)
        {
            <div class="alert mb-3" style="background:#fff3cd; border-left:4px solid #ffc107; color:#664d03; font-size:0.9rem;">
                <i class="fas fa-hourglass-half me-1"></i>
                <strong>Pendiente de firma institucional.</strong>
                El informe técnico fue remitido a Dirección / Jefatura para su revisión y firma digital.
                @if (esSolicitante || (!esDirdac && !esInspector))
                {
                    <br /><span>Su trámite se encuentra en revisión final por la Dirección / Jefatura. Será notificado al completarse la firma.</span>
                }
            </div>
        }
        else if (informeTecnico.FirmadoInspector && !informeEnviadoADirdac)
        {
            <div class="alert mb-3" style="background:#e2e3e5; border-left:4px solid #6c757d; color:#41464b; font-size:0.9rem;">
                <i class="fas fa-info-circle me-1"></i>
                El informe fue firmado por el inspector. Pendiente de envío formal a Dirección / Jefatura.
            </div>
        }
        else
        {
            <div class="alert mb-3" style="background:#e2e3e5; border-left:4px solid #6c757d; color:#41464b; font-size:0.9rem;">
                <i class="fas fa-info-circle me-1"></i>
                El informe técnico aún no ha completado la etapa de firma del inspector.
            </div>
        }

        @* ══════════════════════════════════════════════════════════
           ESTADO DEL DOCUMENTO (badges compactos)
           ══════════════════════════════════════════════════════════ *@
        <div class="d-flex flex-wrap gap-2 mb-3">
            <span class="badge" style="font-size:0.82rem; padding:6px 12px; background:@(informeTecnico.FirmadoInspector ? "#198754" : "#6c757d");">
                <i class="fas fa-@(informeTecnico.FirmadoInspector ? "check" : "clock") me-1"></i>
                Firma Inspector: @(informeTecnico.FirmadoInspector ? "Completada" : "Pendiente")
            </span>
            <span class="badge" style="font-size:0.82rem; padding:6px 12px; background:@(informeEnviadoADirdac ? "#0d6efd" : "#6c757d");">
                <i class="fas fa-@(informeEnviadoADirdac ? "paper-plane" : "clock") me-1"></i>
                Envío DIRDAC: @(informeEnviadoADirdac ? "Enviado" : "Pendiente")
            </span>
            <span class="badge" style="font-size:0.82rem; padding:6px 12px; background:@(notificacionFormalDirdac ? "#198754" : (informeEnviadoADirdac ? "#ffc107" : "#6c757d")); color:@(notificacionFormalDirdac || !informeEnviadoADirdac ? "#fff" : "#000");">
                <i class="fas fa-@(notificacionFormalDirdac ? "envelope-open" : "envelope") me-1"></i>
                Notificación: @(notificacionFormalDirdac ? "Enviada" : (informeEnviadoADirdac ? "Pendiente" : "N/A"))
            </span>
            <span class="badge" style="font-size:0.82rem; padding:6px 12px; background:@(informeTecnico.FirmadoDirdac ? "#198754" : "#6c757d");">
                <i class="fas fa-@(informeTecnico.FirmadoDirdac ? "check-double" : "clock") me-1"></i>
                Firma DIRDAC: @(informeTecnico.FirmadoDirdac ? "Completada" : "Pendiente")
            </span>
        </div>

        @* ══════════════════════════════════════════════════════════
           METADATOS / TRAZABILIDAD (grid 2×4)
           ══════════════════════════════════════════════════════════ *@
        <div class="detail-grid" style="grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 0.6rem;">
            <div class="detail-item">
                <span class="detail-label">Versión informe</span>
                <div class="detail-value">@informeTecnico.Version</div>
            </div>
            <div class="detail-item">
                <span class="detail-label">Hash del documento</span>
                <div class="detail-value" style="word-break:break-all; font-size:0.78rem;">
                    @(!string.IsNullOrWhiteSpace(informeTecnico.HashDocumento) ? informeTecnico.HashDocumento : "—")
                </div>
            </div>
            <div class="detail-item">
                <span class="detail-label">Inspector firmante</span>
                <div class="detail-value">@(!string.IsNullOrWhiteSpace(informeTecnico.UsuarioFirma1) ? informeTecnico.UsuarioFirma1 : "—")</div>
            </div>
            <div class="detail-item">
                <span class="detail-label">Fecha firma inspector</span>
                <div class="detail-value">@(informeTecnico.FechaFirma1.HasValue ? informeTecnico.FechaFirma1.Value.ToString("dd/MM/yyyy HH:mm") : "—")</div>
            </div>
            <div class="detail-item">
                <span class="detail-label">Fecha envío a DIRDAC</span>
                <div class="detail-value">@(informeTecnico.FechaEnvioDirdac.HasValue ? informeTecnico.FechaEnvioDirdac.Value.ToString("dd/MM/yyyy HH:mm") : "—")</div>
            </div>
            <div class="detail-item">
                <span class="detail-label">Usuario envío DIRDAC</span>
                <div class="detail-value">@(!string.IsNullOrWhiteSpace(informeTecnico.UsuarioEnvioDirdac) ? informeTecnico.UsuarioEnvioDirdac : "—")</div>
            </div>
            <div class="detail-item">
                <span class="detail-label">Firmante DIRDAC</span>
                <div class="detail-value">@(!string.IsNullOrWhiteSpace(informeTecnico.UsuarioFirma2) ? informeTecnico.UsuarioFirma2 : "—")</div>
            </div>
            <div class="detail-item">
                <span class="detail-label">Fecha firma DIRDAC</span>
                <div class="detail-value">@(informeTecnico.FechaFirma2.HasValue ? informeTecnico.FechaFirma2.Value.ToString("dd/MM/yyyy HH:mm") : "—")</div>
            </div>
        </div>

        @* ══════════════════════════════════════════════════════════
           DOCUMENTO PDF
           ══════════════════════════════════════════════════════════ *@
        @if (tieneInforme)
        {
            <div class="d-flex align-items-center gap-2 mt-3 mb-3">
                <a class="btn btn-sm btn-outline-primary"
                   href="@Url.Action("VerInforme", "Inspeccion", new { id = codigoInspeccion })"
                   target="_blank" rel="noopener">
                    <i class="fas fa-file-pdf me-1"></i> Ver PDF del informe
                </a>
                <small class="text-muted">@rutaInformeVisual</small>
            </div>
        }

        @* ══════════════════════════════════════════════════════════
           ACCIONES: DECISIÓN Y FIRMA DIRDAC (solo para rol Dirección/Jefatura)
           ══════════════════════════════════════════════════════════ *@
        @if (puedeFirmarDirdac)
        {
            <div class="mt-3 p-3" style="background:#f8f0ff; border:1px solid #d4b5f0; border-radius:8px;" id="panelDecisionDirdac">
                <h6 style="margin:0 0 12px 0; color:#6f42c1; font-weight:600;">
                    <i class="fas fa-stamp me-1"></i> Revisión y firma de Dirección / Jefatura
                </h6>

                <div class="mb-3" id="decisionDirdacBtns">
                    <p style="font-size:0.88rem; color:#555; margin-bottom:10px;">
                        Revise el informe técnico y seleccione una acción:
                    </p>
                    <button type="button" class="btn btn-success me-2" id="btnAprobarInforme" onclick="mostrarFormularioFirmaDirdac()">
                        <i class="fas fa-check-circle me-1"></i> Aprobar informe técnico
                    </button>
                    <button type="button" class="btn btn-outline-danger" id="btnRechazarInforme" onclick="mostrarFormularioRechazo()">
                        <i class="fas fa-times-circle me-1"></i> Rechazar informe técnico
                    </button>
                </div>

                <div id="formularioRechazo" style="display:none;" class="mt-2">
                    @using (Html.BeginForm("RechazarInformeDirdac", "Inspeccion", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        @Html.Hidden("id", codigoInspeccion)
                        <div class="form-field mb-2">
                            <label style="font-weight:600; font-size:0.88rem;">Observación de rechazo <span class="text-danger">*</span></label>
                            <textarea name="observacionRechazo" class="form-control" rows="3" required
                                      placeholder="Indique el motivo del rechazo..."></textarea>
                        </div>
                        <button type="submit" class="btn btn-danger me-2">
                            <i class="fas fa-times me-1"></i> Confirmar rechazo
                        </button>
                        <button type="button" class="btn btn-outline-secondary" onclick="cancelarRechazo()">Cancelar</button>
                    }
                </div>

                <div id="formularioFirmaDirdac" style="display:none;" class="mt-2">
                    @using (Html.BeginForm("FirmarInformeDirdac", "Inspeccion", FormMethod.Post, new { enctype = "multipart/form-data" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.Hidden("id", codigoInspeccion)
                        <div class="compact-form">
                            <div class="form-field">
                                <label>Certificado DIRDAC (.p12 / .pfx)</label>
                                <input type="file" name="CertificadoDirdac" class="form-control" accept=".p12,.pfx" required />
                            </div>
                            <div class="form-field">
                                <label>Contraseña del certificado</label>
                                <input type="password" name="passwordCertificado" class="form-control" autocomplete="off" required />
                            </div>
                            <div>
                                <button type="submit" class="btn btn-primary" style="background:#6f42c1; border-color:#6f42c1;">
                                    <i class="fas fa-file-signature me-1"></i> Firmar documento (DIRDAC)
                                </button>
                                <button type="button" class="btn btn-outline-secondary ms-2" onclick="cancelarFirma()">Cancelar</button>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <script>
                function mostrarFormularioFirmaDirdac() {
                    document.getElementById('decisionDirdacBtns').style.display = 'none';
                    document.getElementById('formularioRechazo').style.display = 'none';
                    document.getElementById('formularioFirmaDirdac').style.display = 'block';
                }
                function mostrarFormularioRechazo() {
                    document.getElementById('decisionDirdacBtns').style.display = 'none';
                    document.getElementById('formularioFirmaDirdac').style.display = 'none';
                    document.getElementById('formularioRechazo').style.display = 'block';
                }
                function cancelarRechazo() {
                    document.getElementById('formularioRechazo').style.display = 'none';
                    document.getElementById('decisionDirdacBtns').style.display = 'block';
                }
                function cancelarFirma() {
                    document.getElementById('formularioFirmaDirdac').style.display = 'none';
                    document.getElementById('decisionDirdacBtns').style.display = 'block';
                }
            </script>
        }
        else if (informeTecnico.FirmadoDirdac)
        {
            <div class="firma-status-card mt-3" style="border-left-color:#198754;">
                <div class="firma-status-icon" style="background:#198754;"><i class="fas fa-check-double"></i></div>
                <div class="firma-status-text">
                    Firma de Dirección / Jefatura completada correctamente.
                    <strong>Firmado por @(!string.IsNullOrWhiteSpace(informeTecnico.UsuarioFirma2) ? informeTecnico.UsuarioFirma2 : "-") el @(informeTecnico.FechaFirma2.HasValue ? informeTecnico.FechaFirma2.Value.ToString("dd/MM/yyyy HH:mm") : "-")</strong>
                </div>
            </div>
        }
        else if (informeEnviadoADirdac && !esDirdac)
        {
            <div class="firma-status-card mt-3" style="border-left-color:#f0ad4e;">
                <div class="firma-status-icon" style="background:#f0ad4e;"><i class="fas fa-clock"></i></div>
                <div class="firma-status-text">
                    <strong>Pendiente de firma por Dirección / Jefatura.</strong><br />
                    Una vez firmado por Dirección, se procederá a la generación del certificado AOCR.
                </div>
            </div>
        }
    </div>
</div>
}
