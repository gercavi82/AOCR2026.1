@inherits System.Web.Mvc.WebViewPage<CapaModelo.Inspeccion>
@using CapaModelo
@using CapaDatos.Constants
@using CapaPresentacion.Helpers
@using CapaPresentacion.Models.ViewModels
@using System.Web.Mvc
@using System.Web.Mvc.Html
@using System.Linq

@{
    if (Model == null)
    {
    <div id="modalInformeTecnicoHost"></div>

        ViewData.Model = new Inspeccion();
        TempData["Warning"] = "Se detectó un detalle de inspección sin modelo completo. Se cargó contexto mínimo para evitar errores.";
    }

    ViewBag.Title = "Detalle de inspección";
    Layout = "~/Views/Shared/_LayoutAOCR.cshtml";
    var hallazgos = ViewBag.Hallazgos as IEnumerable<Hallazgo>;
    var hallazgosLista = hallazgos != null ? hallazgos.ToList() : new List<Hallazgo>();
    var historialEstados = ViewBag.HistorialEstados as IEnumerable<InspeccionHistorialEstado>;
    var historialLista = historialEstados != null ? historialEstados.ToList() : new List<InspeccionHistorialEstado>();
    var informeTecnico = ViewBag.InformeTecnico as InspeccionInformeTecnico;
    var documentosSolicitante = ViewBag.DocumentosSolicitante as IEnumerable<DocumentoInspeccion>;
    var estadoRevisionDocumental = ViewBag.EstadoRevisionDocumental as EstadoRevisionDocumental ?? new EstadoRevisionDocumental();
    var pendienteCargaDocumentalRt = ViewBag.PendienteCargaDocumentalRt != null && (bool)ViewBag.PendienteCargaDocumentalRt;
    var documentosLista = documentosSolicitante != null ? documentosSolicitante.ToList() : new List<DocumentoInspeccion>();
    var normalizeVisibleText = new Func<string, string>(VisibleTextHelper.Normalize);
    var documentoSolicitanteBase = documentosLista.OrderByDescending(d => d.CodigoDocumento).FirstOrDefault();
    var solicitud = ViewBag.Solicitud as SolicitudAOCR;
    var listaVerificacionOperacionalEae = ViewBag.ListaVerificacionOperacionalEae as ListaVerificacionOperacionalEae;
    var usaFlujoListaVerificacionOperacionalEae = ViewBag.UsaFlujoListaVerificacionOperacionalEae != null
        && (bool)ViewBag.UsaFlujoListaVerificacionOperacionalEae;
    var fechaProgramada = Model != null && Model.FechaProgramada.HasValue ? Model.FechaProgramada.Value.ToString("yyyy-MM-dd") : "-";
    var fechaPagoViaticos = Model != null && Model.FechaPagoViaticos.HasValue ? Model.FechaPagoViaticos.Value.ToString("yyyy-MM-dd HH:mm") : "-";
    var montoViaticos = Model != null && Model.ViaticosMonto.HasValue ? Model.ViaticosMonto.Value.ToString("0.00") : "-";
    var estadoActual = Model != null && !string.IsNullOrWhiteSpace(Model.Estado) ? Model.Estado : "SIN ESTADO";
    var resultadoActual = Model != null && !string.IsNullOrWhiteSpace(Model.Resultado) ? Model.Resultado : "Pendiente";
    var resultadoEvaluacion = Model != null && !string.IsNullOrWhiteSpace(Model.ResultadoEvaluacion) ? Model.ResultadoEvaluacion : "Pendiente";
    var estadoDocumental = Model != null && !string.IsNullOrWhiteSpace(Model.EstadoDocumental) ? Model.EstadoDocumental : "Pendiente";
    var inspectorAsignado = (ViewBag.InspectorAsignadoNombre as string) ?? (Model != null && Model.CodigoInspector.HasValue ? Model.CodigoInspector.Value.ToString() : "No asignado");
    var inspectorPrincipalNombre = Model != null ? (Model.InspectorPrincipalNombre ?? string.Empty).Trim() : string.Empty;
    if (string.IsNullOrWhiteSpace(inspectorPrincipalNombre) && solicitud != null)
    {
        inspectorPrincipalNombre = (solicitud.TecnicoResponsableNombre ?? string.Empty).Trim();
    }
    var inspectorPrincipalCedula = Model != null ? (Model.InspectorPrincipalCedula ?? string.Empty).Trim() : string.Empty;
    if (string.IsNullOrWhiteSpace(inspectorPrincipalCedula) && solicitud != null)
    {
        inspectorPrincipalCedula = (solicitud.TecnicoResponsableCedula ?? string.Empty).Trim();
    }
    if (string.IsNullOrWhiteSpace(inspectorPrincipalCedula) && Model != null && Model.CodigoInspector.HasValue)
    {
        inspectorPrincipalCedula = Model.CodigoInspector.Value.ToString();
    }
    if (string.IsNullOrWhiteSpace(inspectorPrincipalCedula) && solicitud != null && solicitud.CodigoTecnico.HasValue)
    {
        inspectorPrincipalCedula = solicitud.CodigoTecnico.Value.ToString();
    }
    var inspectorPrincipal = !string.IsNullOrWhiteSpace(inspectorPrincipalNombre)
        ? (string.IsNullOrWhiteSpace(inspectorPrincipalCedula) || string.Equals(inspectorPrincipalNombre, inspectorPrincipalCedula, System.StringComparison.OrdinalIgnoreCase)
            ? inspectorPrincipalNombre
            : (inspectorPrincipalNombre + " - " + inspectorPrincipalCedula))
        : (!string.IsNullOrWhiteSpace(inspectorPrincipalCedula) ? inspectorPrincipalCedula : "No asignado");
    var inspectorApoyoNombre = Model != null ? (Model.InspectorApoyoNombre ?? string.Empty).Trim() : string.Empty;
    if (string.IsNullOrWhiteSpace(inspectorApoyoNombre) && solicitud != null)
    {
        inspectorApoyoNombre = (solicitud.InspectorApoyoNombre ?? string.Empty).Trim();
    }
    var inspectorApoyoCedula = Model != null ? (Model.InspectorApoyoCedula ?? string.Empty).Trim() : string.Empty;
    if (string.IsNullOrWhiteSpace(inspectorApoyoCedula) && solicitud != null)
    {
        inspectorApoyoCedula = (solicitud.InspectorApoyoCedula ?? string.Empty).Trim();
    }
    var inspectorApoyo = !string.IsNullOrWhiteSpace(inspectorApoyoNombre)
        ? (string.IsNullOrWhiteSpace(inspectorApoyoCedula) || string.Equals(inspectorApoyoNombre, inspectorApoyoCedula, System.StringComparison.OrdinalIgnoreCase)
            ? inspectorApoyoNombre
            : (inspectorApoyoNombre + " - " + inspectorApoyoCedula))
        : (!string.IsNullOrWhiteSpace(inspectorApoyoCedula) ? inspectorApoyoCedula : "No asignado");
    var rutaInformeDisponible = ViewBag.RutaInformeTecnicoDisponible as string;
    var rutaInformeVisual = !string.IsNullOrWhiteSpace(rutaInformeDisponible)
        ? rutaInformeDisponible
        : string.Empty;
    var rutaListaVerificacionDisponible = ViewBag.RutaListaVerificacionOperacionalEaeDisponible as string;
    var rutaListaVerificacionVisual = !string.IsNullOrWhiteSpace(rutaListaVerificacionDisponible)
        ? rutaListaVerificacionDisponible
        : string.Empty;
    var tieneInforme = !string.IsNullOrWhiteSpace(rutaInformeVisual);
    var tieneListaVerificacionOperacionalEae = !string.IsNullOrWhiteSpace(rutaListaVerificacionVisual);
    var listaVerificacionFinalizada = listaVerificacionOperacionalEae != null
        && listaVerificacionOperacionalEae.Finalizado;
    var listaVerificacionFirmada = listaVerificacionOperacionalEae != null
        && listaVerificacionOperacionalEae.Finalizado
        && listaVerificacionOperacionalEae.FirmadoTecnico;
    var estadoActualNormalizado = EstadosInspeccion.NormalizarEstado(estadoActual);
    var estadosPermitidosDesdeActual = EstadosInspeccion.ObtenerEstadosPermitidos(estadoActualNormalizado);
    Func<string, bool> usuarioTieneRol = rol => User != null && User.IsInRole(rol);
    Func<string[], bool> usuarioTieneAlgunRol = roles =>
        roles != null && roles.Any(r => !string.IsNullOrWhiteSpace(r) && usuarioTieneRol(r));
    Func<string, bool> transicionPermitida = estadoDestino =>
        estadosPermitidosDesdeActual.Any(x =>
            string.Equals(
                EstadosInspeccion.NormalizarEstado(x),
                EstadosInspeccion.NormalizarEstado(estadoDestino),
                System.StringComparison.OrdinalIgnoreCase));
    var rolesCoordinacionJefatura = new[]
    {
        "CoordinadorInspecciones",
        "Coordinador",
        "JefaturaTecnica",
        "Jefe",
        "Direccion",
        "Director"
    };
    var esAdministrador = usuarioTieneRol("Administrador");
    var esInspector = usuarioTieneRol("Inspector");
    var revisionDocumentalInspectorConfirmada = ViewBag.RevisionDocumentalInspectorConfirmada != null
        && (bool)ViewBag.RevisionDocumentalInspectorConfirmada;
    var mensajeBloqueoRevisionDocumentalInspectorBase = (ViewBag.MensajeBloqueoRevisionDocumentalInspector as string ?? string.Empty).Trim();
    var inspectorDebeRevisarDocumentos = (esInspector || esAdministrador) && (!revisionDocumentalInspectorConfirmada || pendienteCargaDocumentalRt);
    var mensajeBloqueoRevisionDocumentalInspector = string.Empty;
    if (inspectorDebeRevisarDocumentos)
    {
        if (pendienteCargaDocumentalRt)
        {
            mensajeBloqueoRevisionDocumentalInspector = "Inspector asignado. El proceso se encuentra pendiente porque el RT aún no ha cargado los documentos habilitantes requeridos.";
        }
        else if (!string.IsNullOrWhiteSpace(mensajeBloqueoRevisionDocumentalInspectorBase))
        {
            mensajeBloqueoRevisionDocumentalInspector = mensajeBloqueoRevisionDocumentalInspectorBase;
        }
        else if (estadoRevisionDocumental.DocumentacionAprobada)
        {
            mensajeBloqueoRevisionDocumentalInspector = "Revise la documentación cargada y confirme el cierre documental antes de habilitar la LV/EAE y el informe técnico.";
        }
        else if (!string.IsNullOrWhiteSpace(estadoRevisionDocumental.MensajeBloqueoDocumental))
        {
            mensajeBloqueoRevisionDocumentalInspector = estadoRevisionDocumental.MensajeBloqueoDocumental;
        }
        else
        {
            mensajeBloqueoRevisionDocumentalInspector = "No se puede continuar porque existen documentos observados o subsanados pendientes de revisión documental.";
        }
    }
    var esCoordinadorRevision = esAdministrador || usuarioTieneAlgunRol(new[] { "CoordinadorInspecciones", "Coordinador" });
    var puedeGestionarCoordinacion = esAdministrador || usuarioTieneAlgunRol(rolesCoordinacionJefatura);
    var puedeGestionarInspector = (esAdministrador || esInspector) && !inspectorDebeRevisarDocumentos;
    var puedeVerificacion = puedeGestionarCoordinacion && transicionPermitida(EstadosInspeccion.VERIFICACION_SOLICITUD);
    var puedeAceptarSolicitud = puedeGestionarCoordinacion && transicionPermitida(EstadosInspeccion.ACEPTADA);
    var puedeObservar = puedeGestionarCoordinacion && transicionPermitida(EstadosInspeccion.OBSERVADA);
    var puedeSubsanada = puedeGestionarCoordinacion && transicionPermitida(EstadosInspeccion.SUBSANADA);
    var puedeCerrar = puedeGestionarCoordinacion && transicionPermitida(EstadosInspeccion.CERRADA);
    var puedeIniciarInspeccion = puedeGestionarInspector && transicionPermitida(EstadosInspeccion.EN_INSPECCION);
    var puedeInformeElaborado = puedeGestionarInspector && transicionPermitida(EstadosInspeccion.INFORME_ELABORADO);
    var puedeObservacionDocumental = puedeGestionarInspector && transicionPermitida(EstadosInspeccion.OBSERVACION_DOCUMENTAL);
    var hayAccionesCoordinacionDisponibles = puedeVerificacion || puedeAceptarSolicitud || puedeObservar || puedeSubsanada || puedeCerrar;
    var hayAccionesInspectorDisponibles = puedeIniciarInspeccion || puedeInformeElaborado || puedeObservacionDocumental;
    var mostrarBloqueCoordinacionDetalle = false;
    var mostrarAvisoCoordinacionDetalle = puedeGestionarCoordinacion && !esInspector;
    var mostrarBloqueInspectorDetalle = esInspector || (esAdministrador && EstadosInspeccion.EsEstadoBloqueInspector(estadoActualNormalizado));
    var mostrarAccionesCierreDetalle = false;
    var urlRevisionVerificacion = Url.Action("RevisionVerificacion", "CoordinacionJefatura");
    var mensajeCoordinacionDetalle = string.Equals(estadoActualNormalizado, EstadosInspeccion.VERIFICACION_SOLICITUD, System.StringComparison.OrdinalIgnoreCase)
        ? "La verificación institucional de esta solicitud se ejecuta desde la bandeja de Dirección / Jefatura. Allí se concentran las decisiones de aceptar, observar o cerrar sin duplicar acciones en la pantalla operativa de inspección."
        : (string.Equals(estadoActualNormalizado, EstadosInspeccion.ACEPTADA, System.StringComparison.OrdinalIgnoreCase)
            ? "La solicitud ya fue aceptada. El siguiente paso institucional es gestionar la asignación desde el módulo Asignación de Inspectores del menú Coordinador o revisar el avance desde Dirección / Jefatura."
            : "Las decisiones institucionales de este trámite se controlan desde Dirección / Jefatura para mantener una sola trazabilidad operativa por rol y estado.");
    var mensajeInspectorSinAcciones = inspectorDebeRevisarDocumentos
        ? mensajeBloqueoRevisionDocumentalInspector
        : (EstadosInspeccion.EsEstadoBloqueCoordinacionJefatura(estadoActualNormalizado)
            ? "El trámite se encuentra en etapa de verificación por Dirección / Jefatura. Aún no existen acciones disponibles para el Inspector."
            : "No existen acciones operativas disponibles para el Inspector en la etapa actual del trámite.");
    var puedePlanificar = esAdministrador || usuarioTieneRol("CoordinadorInspecciones");
    var puedeSubirInforme = (User.IsInRole("Inspector") || User.IsInRole("Administrador")) && !inspectorDebeRevisarDocumentos;
    var puedeSolicitarViaticos = ((esInspector || esAdministrador) && !inspectorDebeRevisarDocumentos)
        || (!esInspector && !esAdministrador && puedeGestionarCoordinacion);
    var puedeValidarViaticos = User.IsInRole("CoordinadorFinanciero") || User.IsInRole("DirectorFinanciero") || User.IsInRole("Administrador");
    var informeTecnicoFirmadoInspector = informeTecnico != null && informeTecnico.Finalizado && informeTecnico.FirmadoInspector;
    var puedeRegistrarResultado = (esInspector || esAdministrador) && !inspectorDebeRevisarDocumentos && informeTecnicoFirmadoInspector;
    var puedeRegistrarHallazgo = (User.IsInRole("Inspector") || User.IsInRole("Administrador")) && !inspectorDebeRevisarDocumentos;
    var puedeEditarInformeTecnico = (esInspector || esAdministrador) && !inspectorDebeRevisarDocumentos;
    var hallazgosAbiertos = hallazgosLista.Count(h => h != null && !string.Equals((h.Estado ?? string.Empty).Trim(), "CERRADO", System.StringComparison.OrdinalIgnoreCase));
    var puedeSubirCorreccionSolicitante = (User.IsInRole("Solicitante") || User.IsInRole("Administrador"))
        && (string.Equals(estadoActualNormalizado, EstadosInspeccion.OBSERVADA, System.StringComparison.OrdinalIgnoreCase)
            || string.Equals(estadoActualNormalizado, EstadosInspeccion.SUBSANADA, System.StringComparison.OrdinalIgnoreCase)
            || string.Equals(estadoActualNormalizado, EstadosInspeccion.OBSERVACION_DOCUMENTAL, System.StringComparison.OrdinalIgnoreCase));
    var esSolicitante = User.IsInRole("Solicitante");
    var esDirdac = usuarioTieneAlgunRol(new[] { "DIRDAC", "Direccion", "DirectorGeneral", "Director", "JefaturaTecnica", "Jefe" });
    var puedeAbrirModalInformeTecnico = puedeEditarInformeTecnico || esCoordinadorRevision || esDirdac;
    var estadoInformeTecnico = informeTecnico != null && !string.IsNullOrWhiteSpace(informeTecnico.EstadoInforme)
        ? informeTecnico.EstadoInforme
        : (informeTecnico != null && informeTecnico.Finalizado ? "GENERADO" : "BORRADOR");
    var informeDefinitivoUrl = Model != null && Model.CodigoInspeccion > 0
        ? Url.Action("VerInforme", "Inspeccion", new { id = Model.CodigoInspeccion })
        : string.Empty;
    var informeDescargaUrl = Model != null && Model.CodigoInspeccion > 0
        ? Url.Action("DescargarInforme", "Inspeccion", new { id = Model.CodigoInspeccion })
        : string.Empty;
    var usarDocumentoLvPersistido = listaVerificacionFirmada && tieneListaVerificacionOperacionalEae;
    var listaVerificacionOperacionalEaeUrl = Model != null && Model.CodigoInspeccion > 0
        ? (usarDocumentoLvPersistido
            ? Url.Action("VerListaVerificacionOperacionalEae", "Inspeccion", new { id = Model.CodigoInspeccion })
            : Url.Action("VerLvEaeOficial", "Inspeccion", new { codigoInspeccion = Model.CodigoInspeccion }))
        : string.Empty;
    var listaVerificacionOperacionalEaeDescargaUrl = Model != null && Model.CodigoInspeccion > 0
        ? (usarDocumentoLvPersistido
            ? Url.Action("DescargarListaVerificacionOperacionalEae", "Inspeccion", new { id = Model.CodigoInspeccion })
            : Url.Action("DescargarLvEaeOficial", "Inspeccion", new { codigoInspeccion = Model.CodigoInspeccion }))
        : string.Empty;
    var urlDetalleSolicitudBase = Model != null && Model.CodigoSolicitud > 0
        ? Url.Action("Detalle", "SolicitudAOCR", new { id = Model.CodigoSolicitud })
        : string.Empty;
    var urlVerDocumentacionSolicitud = Model != null && Model.CodigoSolicitud > 0
        ? Url.Action("Lista", "Documento", new
        {
            solicitudId = Model.CodigoSolicitud,
            modo = "ver",
            origen = "inspeccion-detalle",
            inspeccionId = Model.CodigoInspeccion
        })
        : string.Empty;
    var urlRevisionDocumentalSolicitud = Model != null && Model.CodigoSolicitud > 0 && (esInspector || esAdministrador)
        ? Url.Action("Lista", "Documento", new
        {
            solicitudId = Model.CodigoSolicitud,
            modo = "revision",
            origen = "inspeccion-detalle",
            inspeccionId = Model.CodigoInspeccion
        })
        : string.Empty;
    var accesosDocumentalesInspeccionVm = new CapaPresentacion.Models.ViewModels.DocumentoWorkflowActionsVm
    {
        UrlVerDocumentacion = urlVerDocumentacionSolicitud,
        UrlRevisionDocumental = urlRevisionDocumentalSolicitud,
        MostrarRevisionDocumental = esInspector || esAdministrador,
        PuedeAbrirRevisionDocumental = (esInspector || esAdministrador) && !string.IsNullOrWhiteSpace(urlRevisionDocumentalSolicitud),
        TituloBloqueoRevisionDocumental = "La revisión documental requiere una solicitud asociada y un rol Inspector o Administrador.",
        TextoAyudaRevision = "Aceptar, devolver y gestionar la fase documental previa a la LV/EAE y al informe técnico."
    };
    var autoOpenLvFlow = Request != null && Request.QueryString != null
        ? (Request.QueryString["lvAutoFlow"] ?? string.Empty)
        : string.Empty;
    var autoOpenLvEditor = string.Equals(autoOpenLvFlow, "open", System.StringComparison.OrdinalIgnoreCase)
        || string.Equals(autoOpenLvFlow, "start", System.StringComparison.OrdinalIgnoreCase);
    var autoOpenLvSignature = string.Equals(autoOpenLvFlow, "sign", System.StringComparison.OrdinalIgnoreCase);
    var autoOpenInformeTecnico = string.Equals(
        Request != null && Request.QueryString != null ? Request.QueryString["autoOpenInformeTecnico"] : null,
        "true",
        System.StringComparison.OrdinalIgnoreCase);
    var autoFocusInformeFirma = string.Equals(
        Request != null && Request.QueryString != null ? Request.QueryString["autoFocusInformeFirma"] : null,
        "true",
        System.StringComparison.OrdinalIgnoreCase);
    var urlModalInformeTecnico = Model != null && Model.CodigoInspeccion > 0
        ? Url.Action("ModalInformeTecnico", "Inspeccion", new { codigoInspeccion = Model.CodigoInspeccion })
        : string.Empty;
    var puedeAbrirLvEae = !pendienteCargaDocumentalRt && revisionDocumentalInspectorConfirmada;
    var mensajeBloqueoLvEae = puedeAbrirLvEae
        ? string.Empty
        : (pendienteCargaDocumentalRt
            ? "Pendiente de carga de documentos habilitantes por parte del RT."
            : (!string.IsNullOrWhiteSpace(estadoRevisionDocumental.MensajeBloqueoDocumental)
            ? estadoRevisionDocumental.MensajeBloqueoDocumental
            : "Debe completar la revisión documental y aceptar los documentos subsanados antes de iniciar la LV/EAE."));
    var informeTecnicoModalHabilitado = puedeAbrirLvEae && (!usaFlujoListaVerificacionOperacionalEae || listaVerificacionFirmada);
    var mensajeBloqueoInformeTecnico = !puedeAbrirLvEae
        ? "No se puede elaborar el informe técnico hasta que la documentación observada haya sido subsanada y aceptada."
        : (usaFlujoListaVerificacionOperacionalEae && !listaVerificacionFirmada
            ? (listaVerificacionFinalizada
                ? "Debe firmar la Lista de Verificación Operacional LV/EAE antes de elaborar el informe técnico."
                : "Debe finalizar y firmar la Lista de Verificación Operacional LV/EAE antes de elaborar el informe técnico.")
            : string.Empty);
    var abrirModalListaVerificacionAlCargar = autoOpenLvEditor
        || autoOpenLvSignature
        || (!string.IsNullOrWhiteSpace(mensajeBloqueoInformeTecnico) && !listaVerificacionFinalizada);
    var mostrarPanelVistaPrevia = (!usaFlujoListaVerificacionOperacionalEae || listaVerificacionFirmada || tieneInforme)
        && (tieneInforme || puedeEditarInformeTecnico);
    var copyVistaPrevia = !string.IsNullOrWhiteSpace(mensajeBloqueoInformeTecnico) && !tieneInforme
        ? "El informe técnico quedará disponible cuando la LV/EAE esté finalizada y firmada."
        : (tieneInforme
            ? "Consulte el PDF consolidado debajo del flujo BPMN antes de continuar con la revisión o firma."
            : "La vista previa del borrador se actualizará automáticamente mientras completa o corrige el informe técnico.");
    var rutaVistaPreviaTexto = !string.IsNullOrWhiteSpace(mensajeBloqueoInformeTecnico) && !tieneInforme
        ? "El flujo del informe técnico está bloqueado por la LV/EAE hasta que la lista quede finalizada y firmada."
        : (tieneInforme
            ? rutaInformeVisual
            : "La vista previa automática aparecerá aquí cuando empiece a ingresar o actualizar la información del informe.");
    var ayudaViewer = !string.IsNullOrWhiteSpace(mensajeBloqueoInformeTecnico) && !tieneInforme
        ? "La vista del informe técnico se habilitará cuando la lista operacional EAE esté finalizada y firmada."
        : (tieneInforme
            ? "Documento definitivo disponible para revisión y firma."
            : "La vista previa automática se actualizará mientras edita el informe técnico.");
    var estadoViewer = !string.IsNullOrWhiteSpace(mensajeBloqueoInformeTecnico) && !tieneInforme
        ? "BLOQUEADO POR LV/EAE"
        : (tieneInforme ? estadoInformeTecnico : "VISTA PREVIA AUTOMÁTICA");
    var puedeFirmarInspector = puedeEditarInformeTecnico
        && informeTecnico != null
        && informeTecnico.Finalizado
        && !informeTecnico.FirmadoInspector
        && listaVerificacionFirmada;
    var informeEnviadoADirdac = informeTecnico != null && string.Equals(estadoInformeTecnico, "ENVIADO_A_DIRDAC", System.StringComparison.OrdinalIgnoreCase);
    var informeEnviadoACoordinador = informeTecnico != null && string.Equals(estadoInformeTecnico, "ENVIADO_A_COORDINADOR", System.StringComparison.OrdinalIgnoreCase);
    var informeDevueltoCoordinador = informeTecnico != null && string.Equals(estadoInformeTecnico, "DEVUELTO_COORDINADOR", System.StringComparison.OrdinalIgnoreCase);
    var informeDevueltoDireccion = informeTecnico != null
        && (string.Equals(estadoInformeTecnico, "DEVUELTO_DIRECCION", System.StringComparison.OrdinalIgnoreCase)
            || string.Equals(estadoInformeTecnico, "RECHAZADO_DIRDAC", System.StringComparison.OrdinalIgnoreCase));
    var informeAprobadoDireccion = informeTecnico != null
        && (string.Equals(estadoInformeTecnico, "APROBADO_COORDINADOR", System.StringComparison.OrdinalIgnoreCase)
            || string.Equals(estadoInformeTecnico, "APROBADO_DIRECCION", System.StringComparison.OrdinalIgnoreCase)
            || string.Equals(estadoInformeTecnico, "FIRMADO_FINAL", System.StringComparison.OrdinalIgnoreCase)
            || informeTecnico.NotificadoRt
            || informeTecnico.FirmadoDirdac);
    var notificacionFormalDirdac = informeTecnico != null && informeEnviadoADirdac && informeTecnico.CorreoEnviado;
    var correoSolicitante = solicitud != null && !string.IsNullOrWhiteSpace(solicitud.CorreoRepresentanteTecnico)
        ? solicitud.CorreoRepresentanteTecnico
        : (solicitud != null ? solicitud.Email : "-");
    var numeroSolicitudVisual = solicitud != null && !string.IsNullOrWhiteSpace(solicitud.NumeroSolicitud)
        ? solicitud.NumeroSolicitud
        : (Model != null ? Model.CodigoSolicitud.ToString() : "-");
    var numeroSolicitudInspeccionRaw = !string.IsNullOrWhiteSpace(numeroSolicitudVisual)
        ? numeroSolicitudVisual.Trim().ToUpperInvariant()
        : string.Empty;
    var coincidenciaSolicitudInspeccion = !string.IsNullOrWhiteSpace(numeroSolicitudInspeccionRaw)
        ? System.Text.RegularExpressions.Regex.Match(numeroSolicitudInspeccionRaw, @"AOCR\d+")
        : System.Text.RegularExpressions.Match.Empty;
    var referenciaSolicitudInspeccion = coincidenciaSolicitudInspeccion.Success
        ? coincidenciaSolicitudInspeccion.Value
        : (Model != null && Model.CodigoSolicitud > 0 ? "AOCR" + Model.CodigoSolicitud.ToString() : "AOCR");
    var coincidenciaAnioInspeccion = !string.IsNullOrWhiteSpace(numeroSolicitudInspeccionRaw)
        ? System.Text.RegularExpressions.Regex.Match(numeroSolicitudInspeccionRaw, @"20\d{2}")
        : System.Text.RegularExpressions.Match.Empty;
    var anioInspeccionVisual = coincidenciaAnioInspeccion.Success
        ? coincidenciaAnioInspeccion.Value
        : ((Model != null && Model.FechaProgramada.HasValue)
            ? Model.FechaProgramada.Value.Year.ToString()
            : System.DateTime.Now.Year.ToString());
    var numeroInspeccionVisual = Model != null
        ? string.Format("DGAC-INS-{0}-{1}", anioInspeccionVisual, referenciaSolicitudInspeccion)
        : "-";
    var operadorInspeccionado = solicitud != null && !string.IsNullOrWhiteSpace(solicitud.NombreOperador)
        ? solicitud.NombreOperador
        : "-";
    var nombreArchivoInformeTecnico = Model != null && Model.CodigoInspeccion > 0
        ? PdfFileNameHelper.CrearNombreInformeTecnico(
            numeroSolicitudVisual,
            Model.CodigoInspeccion,
            informeTecnico != null ? (informeTecnico.FechaFirma1 ?? informeTecnico.FechaFinalizacion ?? informeTecnico.UpdatedAt ?? informeTecnico.CreatedAt) : (System.DateTime?)null)
        : string.Empty;
    var rucOperador = solicitud != null && !string.IsNullOrWhiteSpace(solicitud.Ruc) ? solicitud.Ruc : "-";
    var codigoOaciOperador = solicitud != null && !string.IsNullOrWhiteSpace(solicitud.CodigoOaci) ? solicitud.CodigoOaci : "-";
    var emailOperador = solicitud != null && !string.IsNullOrWhiteSpace(solicitud.Email) ? solicitud.Email : "-";
    var telefonoOperador = solicitud != null && !string.IsNullOrWhiteSpace(solicitud.Telefono) ? solicitud.Telefono : "-";
    var direccionOperador = solicitud != null && !string.IsNullOrWhiteSpace(solicitud.Direccion) ? solicitud.Direccion : "-";
    var representanteLegalOperador = solicitud != null && !string.IsNullOrWhiteSpace(solicitud.RepresentanteLegal) ? solicitud.RepresentanteLegal : "-";
    var tipoInspectorPrincipal = !string.IsNullOrWhiteSpace(Model.InspectorPrincipalTipo)
        ? Model.InspectorPrincipalTipo
        : (solicitud != null && !string.IsNullOrWhiteSpace(solicitud.TecnicoResponsableTipo) ? solicitud.TecnicoResponsableTipo : "-");
    var tipoInspectorApoyo = !string.IsNullOrWhiteSpace(Model.InspectorApoyoTipo)
        ? Model.InspectorApoyoTipo
        : (solicitud != null && !string.IsNullOrWhiteSpace(solicitud.InspectorApoyoTipo) ? solicitud.InspectorApoyoTipo : "-");
    var estadoFinanciero = Model.PagoViaticosValidado
        ? "Viaticos validados"
        : (Model.ViaticosRequeridos ? "Pendiente de validación financiera" : "Sin requerimiento financiero");
    var horaProgramadaVisual = Model != null && Model.HoraProgramada.HasValue ? Model.HoraProgramada.Value.ToString(@"hh\:mm") : "";
    var fechaHoraProgramada = fechaProgramada + (!string.IsNullOrWhiteSpace(horaProgramadaVisual) ? " " + horaProgramadaVisual : "");
    var duracionEstimada = Model != null && Model.DuracionEstimada.HasValue ? Model.DuracionEstimada.Value + " h" : "-";
    var lugarInspeccion = Model != null && !string.IsNullOrWhiteSpace(Model.Lugar) ? Model.Lugar : "-";
    var tipoInspeccion = Model != null && !string.IsNullOrWhiteSpace(Model.Tipo) ? Model.Tipo : "-";
    var cedulaRepresentante = solicitud != null && !string.IsNullOrWhiteSpace(solicitud.CedulaRepresentante) ? solicitud.CedulaRepresentante : "";
    var representanteLegalCompleto = representanteLegalOperador != "-" && !string.IsNullOrWhiteSpace(cedulaRepresentante)
        ? representanteLegalOperador + " - " + cedulaRepresentante
        : representanteLegalOperador;
    var tipoOperacion = solicitud != null && !string.IsNullOrWhiteSpace(solicitud.TipoOperacion) ? solicitud.TipoOperacion : "-";
    var ciudadProv = new[] { solicitud != null ? (solicitud.Ciudad ?? "").Trim() : "", solicitud != null ? (solicitud.Provincia ?? "").Trim() : "" }.Where(s => s.Length > 0);
    var ubicacionOperador = ciudadProv.Any() ? string.Join(", ", ciudadProv) : "-";
    var serviciosEstacionesInforme = InformeTecnicoTemplateHelper.GetServicioRows(informeTecnico != null ? informeTecnico.ServiciosEstaciones : null);
    var documentosAdjuntosBase = InformeTecnicoTemplateHelper.GetDocumentosAdjuntosBase();
    var documentosAdjuntosSeleccionados = InformeTecnicoTemplateHelper.SplitLines(informeTecnico != null ? informeTecnico.DocumentosAdjuntos : null);
    var documentosAdjuntosArchivos = InformeTecnicoTemplateHelper.ParseDocumentosAdjuntosArchivos(informeTecnico != null ? informeTecnico.DocumentosAdjuntosArchivos : null);
    var numeroLicenciaInspector = informeTecnico != null && !string.IsNullOrWhiteSpace(informeTecnico.NumeroLicenciaInspector)
        ? informeTecnico.NumeroLicenciaInspector
        : (!string.IsNullOrWhiteSpace(inspectorPrincipalCedula) ? inspectorPrincipalCedula : string.Empty);
    var trabajosRealizadosInforme = normalizeVisibleText(informeTecnico != null && !string.IsNullOrWhiteSpace(informeTecnico.TrabajosRealizados)
        ? informeTecnico.TrabajosRealizados
        : (informeTecnico != null ? informeTecnico.Resumen : string.Empty));
    var operacionComercialInforme = normalizeVisibleText(informeTecnico != null ? informeTecnico.OperacionComercial : string.Empty);
    var notasInforme = normalizeVisibleText(informeTecnico != null ? informeTecnico.Notas : string.Empty);
    var noConformidadesInforme = normalizeVisibleText(informeTecnico != null && !string.IsNullOrWhiteSpace(informeTecnico.NoConformidades)
        ? informeTecnico.NoConformidades
        : (informeTecnico != null ? informeTecnico.Observaciones : string.Empty));
    var otrosAdjuntosInforme = normalizeVisibleText(informeTecnico != null ? informeTecnico.OtrosAdjuntos : string.Empty);
    var resultadoInforme = !string.IsNullOrWhiteSpace(informeTecnico != null ? informeTecnico.Resultado : null)
        ? informeTecnico.Resultado
        : (Model != null ? Model.Resultado : string.Empty);
    var resultadoInformeNormalizado = InformeTecnicoTemplateHelper.NormalizeResultadoInformeTecnico(resultadoInforme);
    var tipoResultadoInsatisfactorioInforme = InformeTecnicoTemplateHelper.NormalizeTipoResultadoInsatisfactorio(informeTecnico != null ? informeTecnico.TipoResultadoInsatisfactorio : null);
    var mostrarTipoResultadoInsatisfactorioInforme = string.Equals(resultadoInformeNormalizado, "INSATISFACTORIO", System.StringComparison.OrdinalIgnoreCase);
    var tieneNoConformidadRegistrada = hallazgosLista.Any(h => h != null);
    var mensajeRutaResultadoInsatisfactorio = string.Equals(tipoResultadoInsatisfactorioInforme, "CON_INSPECCION", System.StringComparison.OrdinalIgnoreCase)
        ? "La ruta institucional exige NC y posterior solicitud de nueva inspección una vez revisada por coordinación."
        : (string.Equals(tipoResultadoInsatisfactorioInforme, "SIN_INSPECCION", System.StringComparison.OrdinalIgnoreCase)
            ? "La ruta institucional exige NC y subsanación documental del RT sin habilitar AOCR."
            : "La ruta institucional exige NC y definición explícita del siguiente paso antes de continuar.");
    var coordinacionDebeDecidirRutaNc = puedeGestionarCoordinacion
        && string.Equals(estadoActualNormalizado, EstadosInspeccion.RESULTADO_NO_SATISFACTORIO, System.StringComparison.OrdinalIgnoreCase)
        && string.Equals(resultadoInformeNormalizado, "INSATISFACTORIO", System.StringComparison.OrdinalIgnoreCase)
        && hallazgosAbiertos > 0;
    var puedeAprobarNcNuevaInspeccion = coordinacionDebeDecidirRutaNc
        && string.Equals(tipoResultadoInsatisfactorioInforme, "CON_INSPECCION", System.StringComparison.OrdinalIgnoreCase);
    var puedeAprobarNcSubsanacionDocumental = coordinacionDebeDecidirRutaNc
        && string.Equals(tipoResultadoInsatisfactorioInforme, "SIN_INSPECCION", System.StringComparison.OrdinalIgnoreCase);
    var observacionCriticaMovil = normalizeVisibleText(!string.IsNullOrWhiteSpace(informeTecnico != null ? informeTecnico.ObservacionDevolucion : null)
        ? informeTecnico.ObservacionDevolucion
        : documentosLista.Where(d => !string.IsNullOrWhiteSpace(d.Observacion)).Select(d => d.Observacion).FirstOrDefault());
    var hayObservacionCriticaMovil = !string.IsNullOrWhiteSpace(observacionCriticaMovil);
    var notasLineas = InformeTecnicoTemplateHelper.SplitLines(notasInforme).Take(5).ToList();
    while (notasLineas.Count < 5)
    {
        notasLineas.Add(string.Empty);
    }

    var noConformidadesLineas = InformeTecnicoTemplateHelper.SplitLines(noConformidadesInforme).Take(4).ToList();
    while (noConformidadesLineas.Count < 4)
    {
        noConformidadesLineas.Add(string.Empty);
    }

    var recomendacionesLineas = InformeTecnicoTemplateHelper.SplitLines(informeTecnico != null ? informeTecnico.Recomendaciones : null).Take(3).ToList();
    while (recomendacionesLineas.Count < 3)
    {
        recomendacionesLineas.Add(string.Empty);
    }

    var otrosAdjuntosLineas = InformeTecnicoTemplateHelper.SplitLines(otrosAdjuntosInforme).Take(4).ToList();
    if (!otrosAdjuntosLineas.Any())
    {
        otrosAdjuntosLineas.Add("Orden de inspección.");
    }
    while (otrosAdjuntosLineas.Count < 2)
    {
        otrosAdjuntosLineas.Add(string.Empty);
    }

    var puedeRenderizarEditorInforme = puedeEditarInformeTecnico && string.IsNullOrWhiteSpace(mensajeBloqueoInformeTecnico);
    var estadoListaVerificacionResumen = !usaFlujoListaVerificacionOperacionalEae
        ? "No aplica para este tipo de inspección."
        : (listaVerificacionFirmada
            ? "LV/EAE finalizada y firmada por el técnico responsable."
            : (listaVerificacionOperacionalEae != null && listaVerificacionOperacionalEae.Finalizado
                ? "LV/EAE finalizada y pendiente de firma."
                : (listaVerificacionOperacionalEae != null
                    ? "LV/EAE en elaboración."
                    : "LV/EAE pendiente de elaboración.")));
    var estadoFirmaInspectorResumen = informeTecnico != null && informeTecnico.FirmadoInspector
        ? "La firma del inspector ya consta en el documento."
        : (puedeFirmarInspector
            ? "La firma digital ya está disponible dentro de la ventana flotante del informe técnico."
            : (usaFlujoListaVerificacionOperacionalEae && !listaVerificacionFirmada
                ? "La firma se habilitará cuando la LV/EAE quede firmada."
                : "La firma se habilitará cuando el flujo documental quede listo."));
    var estadoWorkspaceInforme = !string.IsNullOrWhiteSpace(mensajeBloqueoInformeTecnico) && !tieneInforme
        ? "Bloqueado por LV/EAE"
        : (tieneInforme ? estadoInformeTecnico : "Borrador en edición");
    var claseEstadoWorkspaceInforme = !string.IsNullOrWhiteSpace(mensajeBloqueoInformeTecnico) && !tieneInforme
        ? "warning"
        : (tieneInforme ? string.Empty : "neutral");
    var iconoEstadoWorkspaceInforme = !string.IsNullOrWhiteSpace(mensajeBloqueoInformeTecnico) && !tieneInforme
        ? "fa-lock"
        : (tieneInforme ? "fa-check-circle" : "fa-edit");
    var copyWorkspaceInforme = usaFlujoListaVerificacionOperacionalEae
        ? "Concentre la redacción, los adjuntos, la vista previa y la firma del expediente EAE en un solo espacio técnico de trabajo."
        : "Consolide el borrador, controle el PDF definitivo y deje listo el expediente para revisión institucional sin pasos dispersos.";
    var ayudaWorkspaceInforme = !string.IsNullOrWhiteSpace(mensajeBloqueoInformeTecnico)
        ? mensajeBloqueoInformeTecnico
        : (tieneInforme
            ? "El PDF definitivo ya existe y puede revisarse en paralelo mientras ajusta o valida el expediente."
            : "Trabaje por módulos: contexto, observaciones, resultado y anexos; luego use la vista previa antes de finalizar.");
    var documentosAdjuntosSeleccionadosTotal = documentosAdjuntosSeleccionados.Count;
    var otrosAdjuntosRegistradosTotal = InformeTecnicoTemplateHelper.SplitLines(otrosAdjuntosInforme).Count(x => !string.IsNullOrWhiteSpace(x));
    var totalAdjuntosInforme = documentosAdjuntosSeleccionadosTotal + otrosAdjuntosRegistradosTotal;
    var resultadoInformeVisual = InformeTecnicoTemplateHelper.GetResultadoLabel(resultadoInforme);
    var modoConsultaInformeCopy = puedeEditarInformeTecnico && !string.IsNullOrWhiteSpace(mensajeBloqueoInformeTecnico)
        ? "Existe un documento consultable, pero la edición y la firma siguen condicionadas a la LV/EAE."
        : "Su rol puede revisar el documento y su estado, pero la redacción operativa sigue bajo control del inspector.";
}

