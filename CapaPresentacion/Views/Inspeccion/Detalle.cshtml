            .inspection-detail-page .action-grid {
                grid-template-columns: 1fr 1fr;
            }

            .inspection-detail-page .hero-layout,
            .inspection-detail-page .central-grid,
            .inspection-detail-page .utility-grid,
            .inspection-detail-page .info-panel-grid {
                grid-template-columns: 1fr;
            }

            .inspection-detail-page .signature-panel .compact-form {
                grid-template-columns: 1fr;
            }

            .inspection-detail-page .report-preview-card {
                position: static;
            }

            .inspection-detail-page .report-workspace-toolbar,
            .inspection-detail-page .report-support-grid {
                grid-template-columns: 1fr;
                flex-direction: column;
            }

            .inspection-detail-page .report-coverage-head {
                flex-direction: column;
            }

            .inspection-detail-page .report-original-inline,
            .inspection-detail-page .report-original-document-item {
                grid-template-columns: 1fr;
            }

            .inspection-detail-page .report-original-doc {
                padding: 1.2rem;
            }

            .inspection-detail-page .report-workspace-side {
                min-width: 0;
            }

            .inspection-detail-page .report-action-grid {
                grid-template-columns: 1fr 1fr;
            }

            .inspection-detail-page .report-section-table .section-header-main {
                flex-direction: column;
            }

            .inspection-detail-page .report-grid-3 {
                grid-template-columns: 1fr 1fr;
            }
        }

        @@media (max-width: 767.98px) {
            .inspection-detail-page .inspection-shell {
                padding: 1rem;
            }

            .inspection-detail-page .hero-title {
                font-size: 1.6rem;
            }

            .inspection-detail-page .hero-metrics,
            .inspection-detail-page .status-strip,
            .inspection-detail-page .detail-grid,
            .inspection-detail-page .action-grid,
            .inspection-detail-page .bpmn-mini-grid,
            .inspection-detail-page .info-panel-stack.two-col,
            .inspection-detail-page .report-observation-grid,
            .inspection-detail-page .report-grid-2,
            .inspection-detail-page .report-grid-3 {
                grid-template-columns: 1fr;
            }

            .inspection-detail-page .action-footer {
                align-items: stretch;
            }

            .inspection-detail-page .report-accordion .accordion-button {
                flex-wrap: wrap;
            }

            .inspection-detail-page .report-accordion-badge {
                order: 3;
            }

            .inspection-detail-page .report-action-grid {
                grid-template-columns: 1fr;
            }

            .inspection-detail-page .report-original-fill,
            .inspection-detail-page .report-original-fill.long {
                display: block;
                min-width: 0;
                width: 100%;
                margin: 0.4rem 0;
            }

            .inspection-detail-page .report-original-text {
                line-height: 1.7;
            }

            .inspection-detail-page .report-original-result-item,
            .inspection-detail-page .report-original-subitem {
                grid-template-columns: auto 1fr;
            }

            .inspection-detail-page .report-section-table,
            .inspection-detail-page .report-section-table > thead,
            .inspection-detail-page .report-section-table > tbody,
            .inspection-detail-page .report-section-table > thead > tr,
            .inspection-detail-page .report-section-table > tbody > tr,
            .inspection-detail-page .report-section-table > thead > tr > th,
            .inspection-detail-page .report-section-table > tbody > tr > th,
            .inspection-detail-page .report-section-table > tbody > tr > td {
                display: block;
                width: 100%;
            }

            .inspection-detail-page .report-section-table .field-label-cell {
                padding-bottom: 0.4rem;
            }

            .inspection-detail-page .report-section-table .field-value-cell {
                padding-top: 0.5rem;
            }
        }
    </style>
}

@if (Model == null)
{
    <div class="alert alert-danger">No se recibio el modelo de inspeccion.</div>
    return;
}

<div class="inspection-detail-page">
    <div class="inspection-shell">
        <div class="card hero-card mb-4">
            <div class="hero-body">
                <div class="hero-layout">
                    <div class="hero-main">
                        <div>
                            <span class="hero-badge">
                                <i class="fas fa-clipboard-check"></i>
                                Gestión Técnica DGAC
                            </span>
                            <h1 class="hero-title">Detalle de inspección</h1>
                            <p class="hero-subtitle">Vista ejecutiva para seguimiento técnico, trazabilidad BPMN, control documental y gestión integral del informe de inspección.</p>
                        </div>

                        <div class="hero-metrics">
                            <div class="hero-metric">
                                <span class="hero-metric-label">Código inspección</span>
                                <span class="hero-metric-value">@Model.CodigoInspeccion</span>
                            </div>
                            <div class="hero-metric">
                                <span class="hero-metric-label">Solicitud vinculada</span>
                                <span class="hero-metric-value">@Model.CodigoSolicitud</span>
                            </div>
                            <div class="hero-metric">
                                <span class="hero-metric-label">Estado actual</span>
                                <span class="hero-metric-value">@estadoActual</span>
                            </div>
                            <div class="hero-metric">
                                <span class="hero-metric-label">Fechas de inspeccion</span>
                                <span class="hero-metric-value">@fechaProgramada</span>
                            </div>
                        </div>

                        @if (solicitud != null)
                        {
                            <div class="hero-metrics mt-2">
                                <div class="hero-metric">
                                    <span class="hero-metric-label">Operador</span>
                                    <span class="hero-metric-value">@(!string.IsNullOrWhiteSpace(solicitud.RazonSocial) ? solicitud.RazonSocial : solicitud.NombreOperador)</span>
                                </div>
                                <div class="hero-metric">
                                    <span class="hero-metric-label">Correo solicitante</span>
                                    <span class="hero-metric-value">@correoSolicitante</span>
                                </div>
                                <div class="hero-metric">
                                    <span class="hero-metric-label">Versión informe</span>
                                    <span class="hero-metric-value">@(informeTecnico != null ? informeTecnico.Version.ToString() : "0")</span>
                                </div>
                                <div class="hero-metric">
                                    <span class="hero-metric-label">Dirección/Jefatura notificada</span>
                                    <span class="hero-metric-value">@(informeTecnico == null ? "NO" : (notificacionFormalDirdac ? "SI" : (informeEnviadoADirdac ? "PENDIENTE" : "NO")))</span>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="hero-side">
                        <div class="hero-side-card">
                            <h2 class="hero-side-title">Contexto ejecutivo</h2>
                            <p class="hero-side-copy">Concentre aquí la lectura operativa de la inspección antes de revisar transiciones BPMN, informe técnico, documentos y hallazgos.</p>
                        </div>
                        <div class="hero-side-card">
                            <div class="hero-pill-grid">
                                <div class="hero-pill-item">
                                    <span>Resultado</span>
                                    <strong>@resultadoActual</strong>
                                </div>
                                <div class="hero-pill-item">
                                    <span>Evaluación</span>
                                    <strong>@resultadoEvaluacion</strong>
                                </div>
                                <div class="hero-pill-item">
                                    <span>Estado documental</span>
                                    <strong>@estadoDocumental</strong>
                                </div>
                                <div class="hero-pill-item">
                                    <span>Hallazgos</span>
                                    <strong>@hallazgosLista.Count registrados</strong>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-inline mb-4">@TempData["Success"]</div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-inline mb-4">@TempData["Error"]</div>
        }

        @if (TempData["Warning"] != null)
        {
            <div class="alert alert-warning alert-inline mb-4">@TempData["Warning"]</div>
        }

        <div class="status-strip status-strip-wide">
            <div class="status-tile highlight">
                <small>Resultado</small>
                <strong>@resultadoActual</strong>
            </div>
            <div class="status-tile">
                <small>Evaluación</small>
                <strong>@resultadoEvaluacion</strong>
            </div>
            <div class="status-tile">
                <small>Estado documental</small>
                <strong>@estadoDocumental</strong>
            </div>
            <div class="status-tile">
                <small>Hallazgos</small>
                <strong>@hallazgosLista.Count registrados</strong>
            </div>
            <div class="status-tile">
                <small>Versión informe</small>
                <strong>@(informeTecnico != null ? informeTecnico.Version.ToString() : "0")</strong>
            </div>
            <div class="status-tile">
                <small>Notificación DGAC</small>
                <strong>@(notificacionFormalDirdac ? "Notificado" : (informeEnviadoADirdac ? "Pendiente" : "No enviado"))</strong>
            </div>
        </div>

        <div class="card section-card soft-card mt-4">
            <div class="card-body">
                <div class="section-heading">
                    <div class="section-icon">
                        <i class="fas fa-id-badge"></i>
                    </div>
                    <div>
                        <h2 class="section-title">Información general de inspección</h2>
                        <p class="section-copy">Consolidado principal de asignación, estado operativo y datos administrativos asociados a la inspección.</p>
                    </div>
                </div>

                <div class="info-panel-grid">
                    @* ── Panel 1: Equipo inspector ── *@
                    <div class="info-panel">
                        <div class="info-panel-head">
                            <div>
                                <h3 class="info-panel-title">Equipo inspector</h3>
                                <p class="info-panel-copy">Asignación, responsables y apoyo técnico del equipo de inspección.</p>
                            </div>
                            <span class="info-panel-badge">Equipo</span>
                        </div>
                        <div class="info-panel-stack two-col compact">
                            <div class="detail-item" style="grid-column: 1 / -1;">
                                <span class="detail-label">Inspector asignado</span>
                                <div class="detail-value">@inspectorAsignado</div>
                            </div>
                            <div class="detail-item">
                                <span class="detail-label">Inspector principal</span>
                                <div class="detail-value">@inspectorPrincipal</div>
                            </div>
                            <div class="detail-item">
                                <span class="detail-label">Tipo principal</span>
                                <div class="detail-value">@tipoInspectorPrincipal</div>
                            </div>
                            <div class="detail-item">
                                <span class="detail-label">Inspector apoyo</span>
                                <div class="detail-value">@inspectorApoyo</div>
                            </div>
                            <div class="detail-item">
                                <span class="detail-label">Tipo apoyo</span>
                                <div class="detail-value">@tipoInspectorApoyo</div>
                            </div>
                            <div class="detail-item" style="grid-column: 1 / -1;">
                                <span class="detail-label">Representante legal</span>
                                <div class="detail-value">@representanteLegalCompleto</div>
                            </div>
                        </div>
                    </div>

                    @* ── Panel 2: Clasificación técnica ── *@
                    <div class="info-panel">
                        <div class="info-panel-head">
                            <div>
                                <h3 class="info-panel-title">Clasificación técnica</h3>
                                <p class="info-panel-copy">Datos técnicos de la inspección, agenda programada y estado documental.</p>
                            </div>
                            <span class="info-panel-badge">Técnico</span>
                        </div>
                        <div class="info-panel-stack two-col compact">
                            <div class="detail-item">
                                <span class="detail-label">Tipo de inspección</span>
                                <div class="detail-value">@tipoInspeccion</div>
                            </div>
                            <div class="detail-item">
                                <span class="detail-label">Estado documental</span>
                                <div class="detail-value">@estadoDocumental</div>
                            </div>
                            <div class="detail-item">
                                <span class="detail-label">Resultado evaluación</span>
                                <div class="detail-value">@resultadoEvaluacion</div>
                            </div>
                            <div class="detail-item">
                                <span class="detail-label">Fecha / hora programada</span>
                                <div class="detail-value">@fechaHoraProgramada</div>
                            </div>
                            <div class="detail-item">
                                <span class="detail-label">Duración estimada</span>
                                <div class="detail-value">@duracionEstimada</div>
                            </div>
                            <div class="detail-item">
                                <span class="detail-label">Lugar de inspección</span>
                                <div class="detail-value">@lugarInspeccion</div>
                            </div>
                        </div>
                    </div>

                    @* ── Panel 3: Operador inspeccionado ── *@
                    <div class="info-panel">
                        <div class="info-panel-head">
                            <div>
                                <h3 class="info-panel-title">Operador inspeccionado</h3>
                                <p class="info-panel-copy">Datos del operador asociado a la solicitud de inspección.</p>
                            </div>
                            <span class="info-panel-badge">Operador</span>
                        </div>
                        <div class="info-panel-stack two-col compact">
                            <div class="detail-item">
                                <span class="detail-label">Operador</span>
                                <div class="detail-value">@operadorInspeccionado</div>
                            </div>
                            <div class="detail-item">
                                <span class="detail-label">RUC</span>
                                <div class="detail-value">@rucOperador</div>
                            </div>
                            <div class="detail-item">
                                <span class="detail-label">Código OACI</span>
                                <div class="detail-value">@codigoOaciOperador</div>
                            </div>
                            <div class="detail-item">
                                <span class="detail-label">Tipo operación</span>
                                <div class="detail-value">@tipoOperacion</div>
                            </div>
                            <div class="detail-item">
                                <span class="detail-label">Email</span>
                                <div class="detail-value">@emailOperador</div>
                            </div>
                            <div class="detail-item">
                                <span class="detail-label">Teléfono</span>
                                <div class="detail-value">@telefonoOperador</div>
                            </div>
                            <div class="detail-item">
                                <span class="detail-label">Dirección</span>
                                <div class="detail-value">@direccionOperador</div>
                            </div>
                            <div class="detail-item">
                                <span class="detail-label">Ubicación</span>
                                <div class="detail-value">@ubicacionOperador</div>
                            </div>
                        </div>
                    </div>

                    @* ── Panel 4: Control financiero ── *@
                    <div class="info-panel">
                        <div class="info-panel-head">
                            <div>
                                <h3 class="info-panel-title">Control financiero</h3>
                                <p class="info-panel-copy">Seguimiento de viáticos, validación financiera y coherencia administrativa.</p>
                            </div>
                            <span class="info-panel-badge">Finanzas</span>
                        </div>
                        <div class="info-panel-stack two-col compact">
                            <div class="detail-item">
                                <span class="detail-label">Viáticos requeridos</span>
                                <div class="detail-value">@(Model.ViaticosRequeridos ? "SÍ" : "NO")</div>
                            </div>
                            <div class="detail-item">
                                <span class="detail-label">Monto viáticos</span>
                                <div class="detail-value">@(montoViaticos != "-" ? "$ " + montoViaticos : "-")</div>
                            </div>
                            <div class="detail-item">
                                <span class="detail-label">Pago validado</span>
                                <div class="detail-value">@(Model.PagoViaticosValidado ? "SÍ" : "NO")</div>
                            </div>
                            <div class="detail-item">
                                <span class="detail-label">Fecha pago viáticos</span>
                                <div class="detail-value">@fechaPagoViaticos</div>
                            </div>
                            <div class="detail-item" style="grid-column: 1 / -1;">
                                <span class="detail-label">Estado financiero</span>
                                <div class="detail-value">@estadoFinanciero</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="central-grid">
            <div class="central-side-stack">
                <div class="card section-card">
                    <div class="card-body">
                        <div class="section-heading">
                            <div class="section-icon">
                                <i class="fas fa-project-diagram"></i>
                            </div>
                            <div>
                                <h2 class="section-title">Flujo BPMN de inspección</h2>
                                <p class="section-copy">Transiciones, lectura operativa del estado y decisiones disponibles según el rol autenticado.</p>
                            </div>
                        </div>

                        <div class="stack-grid">
                            <div class="bpmn-panel">
                                <div class="bpmn-mini-grid">
                                    <div class="bpmn-mini-card">
                                        <small>Estado actual</small>
                                        <strong>@estadoActualNormalizado</strong>
                                    </div>
                                    <div class="bpmn-mini-card">
                                        <small>Resultado</small>
                                        <strong>@resultadoActual</strong>
                                    </div>
                                    <div class="bpmn-mini-card">
                                        <small>Operador</small>
                                        <strong>@operadorInspeccionado</strong>
                                    </div>
                                    <div class="bpmn-mini-card">
                                        <small>Inspector principal</small>
                                        <strong>@inspectorPrincipal</strong>
                                    </div>
                                </div>
                            </div>

                        @if (mostrarAvisoCoordinacionDetalle)
                        {
                            <div class="alert alert-info mb-3" role="alert">
                                <strong>Gestion institucional centralizada en Direccion / Jefatura.</strong>
                                <div class="mt-2">@mensajeCoordinacionDetalle</div>
                                <div class="d-flex flex-wrap gap-3 mt-3 small">
                                    <span><strong>Solicitud:</strong> @(solicitud != null && !string.IsNullOrWhiteSpace(solicitud.NumeroSolicitud) ? solicitud.NumeroSolicitud : (Model != null ? Model.CodigoSolicitud.ToString() : "-"))</span>
                                    <span><strong>Compania:</strong> @operadorInspeccionado</span>
                                    <span><strong>Estado actual:</strong> @estadoActualNormalizado</span>
                                    <span><strong>Inspector:</strong> @inspectorPrincipal</span>
                                </div>
                                <div class="d-flex flex-wrap gap-2 mt-3">
                                    <a href="@urlRevisionVerificacion" class="btn btn-sm btn-outline-primary">
                                        <i class="fas fa-search"></i> Abrir Revisión / Verificación
                                    </a>
                                    @if (puedeDerivarAsignacionInspector)
                                    {
                                        <a href="@urlAsignarInspectorDetalle" class="btn btn-sm btn-outline-secondary">
                                            <i class="fas fa-user-check"></i> Asignar inspector
                                        </a>
                                    }
                                </div>
                            </div>
                        }

                        @if (mostrarBloqueCoordinacionDetalle)
                        {
                            <div class="role-panel">
                                <div class="role-panel-head">
                                    <div>
                                        <h3 class="role-panel-title">Coordinación y jefatura</h3>
                                        <p class="role-panel-copy">Decisiones institucionales y transiciones de alto nivel para esta inspección.</p>
                                    </div>
                                    <span class="status-pill primary"><i class="fas fa-user-shield"></i> Coordinación</span>
                                </div>
                                <div class="button-flow">
                                    @if (puedeVerificacion)
                                    {
                                        using (Html.BeginForm("CambiarEstado", "Inspeccion", FormMethod.Post))
                                        {
                                            @Html.AntiForgeryToken()
                                            @Html.Hidden("id", Model.CodigoInspeccion)
                                            @Html.Hidden("estado", EstadosInspeccion.VERIFICACION_SOLICITUD)
                                            <button type="submit" class="btn btn-outline-primary">Verificacion</button>
                                        }
                                    }
                                    @if (puedeAceptarSolicitud)
                                    {
                                        using (Html.BeginForm("CambiarEstado", "Inspeccion", FormMethod.Post))
                                        {
                                            @Html.AntiForgeryToken()
                                            @Html.Hidden("id", Model.CodigoInspeccion)
                                            @Html.Hidden("estado", EstadosInspeccion.ACEPTADA)
                                            <button type="submit" class="btn btn-outline-success">Aceptar solicitud</button>
                                        }
                                    }
                                    @if (puedeObservar)
                                    {
                                        using (Html.BeginForm("CambiarEstado", "Inspeccion", FormMethod.Post))
                                        {
                                            @Html.AntiForgeryToken()
                                            @Html.Hidden("id", Model.CodigoInspeccion)
                                            @Html.Hidden("estado", EstadosInspeccion.OBSERVADA)
                                            <button type="submit" class="btn btn-outline-danger">Observar</button>
                                        }
                                    }
                                    @if (puedeSubsanada)
                                    {
                                        using (Html.BeginForm("CambiarEstado", "Inspeccion", FormMethod.Post))
                                        {
                                            @Html.AntiForgeryToken()
                                            @Html.Hidden("id", Model.CodigoInspeccion)
                                            @Html.Hidden("estado", EstadosInspeccion.SUBSANADA)
                                            <button type="submit" class="btn btn-outline-warning">Subsanada</button>
                                        }
                                    }
                                    @if (puedeCerrar)
                                    {
                                        using (Html.BeginForm("CambiarEstado", "Inspeccion", FormMethod.Post))
                                        {
                                            @Html.AntiForgeryToken()
                                            @Html.Hidden("id", Model.CodigoInspeccion)
                                            @Html.Hidden("estado", EstadosInspeccion.CERRADA)
                                            <button type="submit" class="btn btn-outline-dark">Cerrar</button>
                                        }
                                    }
                                </div>
                                @if (!hayAccionesCoordinacionDisponibles)
                                {
                                    <small class="text-muted d-block mt-2">No hay transiciones habilitadas para este bloque desde el estado actual (@estadoActualNormalizado).</small>
                                }
                            </div>
                        }

                        @if (mostrarBloqueInspectorDetalle)
                        {
                            <div class="role-panel">
                                <div class="role-panel-head">
                                    <div>
                                        <h3 class="role-panel-title">Operación de inspector</h3>
                                        <p class="role-panel-copy">Acciones disponibles para ejecución operativa y documentación técnica del inspector.</p>
                                    </div>
                                    <span class="status-pill warning"><i class="fas fa-user-check"></i> Inspector</span>
                                </div>
                                <div class="button-flow">
                                    @if (puedeIniciarInspeccion)
                                    {
                                        using (Html.BeginForm("CambiarEstado", "Inspeccion", FormMethod.Post))
                                        {
                                            @Html.AntiForgeryToken()
                                            @Html.Hidden("id", Model.CodigoInspeccion)
                                            @Html.Hidden("estado", EstadosInspeccion.EN_INSPECCION)
                                            <button type="submit" class="btn btn-outline-warning">Iniciar inspeccion</button>
                                        }
                                    }
                                    @if (puedeInformeElaborado)
                                    {
                                        using (Html.BeginForm("CambiarEstado", "Inspeccion", FormMethod.Post))
                                        {
                                            @Html.AntiForgeryToken()
                                            @Html.Hidden("id", Model.CodigoInspeccion)
                                            @Html.Hidden("estado", EstadosInspeccion.INFORME_ELABORADO)
                                            <button type="submit" class="btn btn-outline-info">Informe elaborado</button>
                                        }
                                    }
                                    @if (puedeObservacionDocumental)
                                    {
                                        using (Html.BeginForm("CambiarEstado", "Inspeccion", FormMethod.Post))
                                        {
                                            @Html.AntiForgeryToken()
                                            @Html.Hidden("id", Model.CodigoInspeccion)
                                            @Html.Hidden("estado", EstadosInspeccion.OBSERVACION_DOCUMENTAL)
                                            <button type="submit" class="btn btn-outline-danger">Observacion documental</button>
                                        }
                                    }
                                </div>
                                @if (!hayAccionesInspectorDisponibles)
                                {
                                    <small class="text-muted d-block mt-2">@mensajeInspectorSinAcciones</small>
                                }
                            </div>
                        }

