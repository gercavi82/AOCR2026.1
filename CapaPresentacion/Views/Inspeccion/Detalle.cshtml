@inherits System.Web.Mvc.WebViewPage<CapaModelo.Inspeccion>
@using CapaModelo
@using CapaDatos.Constants
@using CapaPresentacion.Helpers
@using CapaPresentacion.Models.ViewModels
@using System.Web.Mvc
@using System.Web.Mvc.Html
@using System.Linq

@{
    if (Model == null)
    {
        ViewData.Model = new Inspeccion();
        TempData["Warning"] = "Se detectÃ³ un detalle de inspecciÃ³n sin modelo completo. Se cargÃ³ contexto mÃ­nimo para evitar errores.";
    }

    ViewBag.Title = "Detalle Inspeccion";
    Layout = "~/Views/Shared/_LayoutAOCR.cshtml";
    var hallazgos = ViewBag.Hallazgos as IEnumerable<Hallazgo>;
    var hallazgosLista = hallazgos != null ? hallazgos.ToList() : new List<Hallazgo>();
    var historialEstados = ViewBag.HistorialEstados as IEnumerable<InspeccionHistorialEstado>;
    var historialLista = historialEstados != null ? historialEstados.ToList() : new List<InspeccionHistorialEstado>();
    var informeTecnico = ViewBag.InformeTecnico as InspeccionInformeTecnico;
    var documentosSolicitante = ViewBag.DocumentosSolicitante as IEnumerable<DocumentoInspeccion>;
    var documentosLista = documentosSolicitante != null ? documentosSolicitante.ToList() : new List<DocumentoInspeccion>();
    var solicitud = ViewBag.Solicitud as SolicitudAOCR;
    var fechaProgramada = Model != null && Model.FechaProgramada.HasValue ? Model.FechaProgramada.Value.ToString("yyyy-MM-dd") : "-";
    var fechaPagoViaticos = Model != null && Model.FechaPagoViaticos.HasValue ? Model.FechaPagoViaticos.Value.ToString("yyyy-MM-dd HH:mm") : "-";
    var montoViaticos = Model != null && Model.ViaticosMonto.HasValue ? Model.ViaticosMonto.Value.ToString("0.00") : "-";
    var estadoActual = Model != null && !string.IsNullOrWhiteSpace(Model.Estado) ? Model.Estado : "SIN ESTADO";
    var resultadoActual = Model != null && !string.IsNullOrWhiteSpace(Model.Resultado) ? Model.Resultado : "Pendiente";
    var resultadoEvaluacion = Model != null && !string.IsNullOrWhiteSpace(Model.ResultadoEvaluacion) ? Model.ResultadoEvaluacion : "Pendiente";
    var estadoDocumental = Model != null && !string.IsNullOrWhiteSpace(Model.EstadoDocumental) ? Model.EstadoDocumental : "Pendiente";
    var inspectorAsignado = (ViewBag.InspectorAsignadoNombre as string) ?? (Model != null && Model.CodigoInspector.HasValue ? Model.CodigoInspector.Value.ToString() : "No asignado");
    var inspectorPrincipalNombre = Model != null ? (Model.InspectorPrincipalNombre ?? string.Empty).Trim() : string.Empty;
    if (string.IsNullOrWhiteSpace(inspectorPrincipalNombre) && solicitud != null)
    {
        inspectorPrincipalNombre = (solicitud.TecnicoResponsableNombre ?? string.Empty).Trim();
    }
    var inspectorPrincipalCedula = Model != null ? (Model.InspectorPrincipalCedula ?? string.Empty).Trim() : string.Empty;
    if (string.IsNullOrWhiteSpace(inspectorPrincipalCedula) && solicitud != null)
    {
        inspectorPrincipalCedula = (solicitud.TecnicoResponsableCedula ?? string.Empty).Trim();
    }
    if (string.IsNullOrWhiteSpace(inspectorPrincipalCedula) && Model != null && Model.CodigoInspector.HasValue)
    {
        inspectorPrincipalCedula = Model.CodigoInspector.Value.ToString();
    }
    if (string.IsNullOrWhiteSpace(inspectorPrincipalCedula) && solicitud != null && solicitud.CodigoTecnico.HasValue)
    {
        inspectorPrincipalCedula = solicitud.CodigoTecnico.Value.ToString();
    }
    var inspectorPrincipal = !string.IsNullOrWhiteSpace(inspectorPrincipalNombre)
        ? (string.IsNullOrWhiteSpace(inspectorPrincipalCedula) || string.Equals(inspectorPrincipalNombre, inspectorPrincipalCedula, System.StringComparison.OrdinalIgnoreCase)
            ? inspectorPrincipalNombre
            : (inspectorPrincipalNombre + " - " + inspectorPrincipalCedula))
        : (!string.IsNullOrWhiteSpace(inspectorPrincipalCedula) ? inspectorPrincipalCedula : "No asignado");
    var inspectorApoyoNombre = Model != null ? (Model.InspectorApoyoNombre ?? string.Empty).Trim() : string.Empty;
    if (string.IsNullOrWhiteSpace(inspectorApoyoNombre) && solicitud != null)
    {
        inspectorApoyoNombre = (solicitud.InspectorApoyoNombre ?? string.Empty).Trim();
    }
    var inspectorApoyoCedula = Model != null ? (Model.InspectorApoyoCedula ?? string.Empty).Trim() : string.Empty;
    if (string.IsNullOrWhiteSpace(inspectorApoyoCedula) && solicitud != null)
    {
        inspectorApoyoCedula = (solicitud.InspectorApoyoCedula ?? string.Empty).Trim();
    }
    var inspectorApoyo = !string.IsNullOrWhiteSpace(inspectorApoyoNombre)
        ? (string.IsNullOrWhiteSpace(inspectorApoyoCedula) || string.Equals(inspectorApoyoNombre, inspectorApoyoCedula, System.StringComparison.OrdinalIgnoreCase)
            ? inspectorApoyoNombre
            : (inspectorApoyoNombre + " - " + inspectorApoyoCedula))
        : (!string.IsNullOrWhiteSpace(inspectorApoyoCedula) ? inspectorApoyoCedula : "No asignado");
    var rutaInformeVisual = !string.IsNullOrWhiteSpace(informeTecnico != null ? informeTecnico.RutaDocumentoFirmado : null)
        ? informeTecnico.RutaDocumentoFirmado
        : (!string.IsNullOrWhiteSpace(Model != null ? Model.RutaInforme : null)
            ? Model.RutaInforme
            : (informeTecnico != null ? informeTecnico.RutaPdf : null));
    var tieneInforme = !string.IsNullOrWhiteSpace(rutaInformeVisual);
    var estadoActualNormalizado = EstadosInspeccion.NormalizarEstado(estadoActual);
    var estadosPermitidosDesdeActual = EstadosInspeccion.ObtenerEstadosPermitidos(estadoActualNormalizado);
    Func<string, bool> usuarioTieneRol = rol => User != null && User.IsInRole(rol);
    Func<string[], bool> usuarioTieneAlgunRol = roles =>
        roles != null && roles.Any(r => !string.IsNullOrWhiteSpace(r) && usuarioTieneRol(r));
    Func<string, bool> transicionPermitida = estadoDestino =>
        estadosPermitidosDesdeActual.Any(x =>
            string.Equals(
                EstadosInspeccion.NormalizarEstado(x),
                EstadosInspeccion.NormalizarEstado(estadoDestino),
                System.StringComparison.OrdinalIgnoreCase));
    var rolesCoordinacionJefatura = new[]
    {
        "CoordinadorInspecciones",
        "Coordinador",
        "JefaturaTecnica",
        "Jefe",
        "Direccion",
        "Director"
    };
    var esAdministrador = usuarioTieneRol("Administrador");
    var esInspector = usuarioTieneRol("Inspector");
    var esCoordinadorRevision = esAdministrador || usuarioTieneAlgunRol(new[] { "CoordinadorInspecciones", "Coordinador" });
    var puedeGestionarCoordinacion = esAdministrador || usuarioTieneAlgunRol(rolesCoordinacionJefatura);
    var puedeGestionarInspector = esAdministrador || esInspector;
    var puedeVerificacion = puedeGestionarCoordinacion && transicionPermitida(EstadosInspeccion.VERIFICACION_SOLICITUD);
    var puedeAceptarSolicitud = puedeGestionarCoordinacion && transicionPermitida(EstadosInspeccion.ACEPTADA);
    var puedeObservar = puedeGestionarCoordinacion && transicionPermitida(EstadosInspeccion.OBSERVADA);
    var puedeSubsanada = puedeGestionarCoordinacion && transicionPermitida(EstadosInspeccion.SUBSANADA);
    var puedeCerrar = puedeGestionarCoordinacion && transicionPermitida(EstadosInspeccion.CERRADA);
    var puedeIniciarInspeccion = puedeGestionarInspector && transicionPermitida(EstadosInspeccion.EN_INSPECCION);
    var puedeInformeElaborado = puedeGestionarInspector && transicionPermitida(EstadosInspeccion.INFORME_ELABORADO);
    var puedeObservacionDocumental = puedeGestionarInspector && transicionPermitida(EstadosInspeccion.OBSERVACION_DOCUMENTAL);
    var hayAccionesCoordinacionDisponibles = puedeVerificacion || puedeAceptarSolicitud || puedeObservar || puedeSubsanada || puedeCerrar;
    var hayAccionesInspectorDisponibles = puedeIniciarInspeccion || puedeInformeElaborado || puedeObservacionDocumental;
    var mostrarBloqueCoordinacionDetalle = false;
    var mostrarAvisoCoordinacionDetalle = puedeGestionarCoordinacion && !esInspector;
    var mostrarBloqueInspectorDetalle = esInspector || (esAdministrador && EstadosInspeccion.EsEstadoBloqueInspector(estadoActualNormalizado));
    var mostrarAccionesCierreDetalle = false;
    var urlRevisionVerificacion = Url.Action("RevisionVerificacion", "CoordinacionJefatura");
    var puedeDerivarAsignacionInspector = puedeGestionarCoordinacion
        && Model != null
        && Model.CodigoSolicitud > 0
        && (string.Equals(estadoActualNormalizado, EstadosInspeccion.ACEPTADA, System.StringComparison.OrdinalIgnoreCase)
            || string.Equals(estadoActualNormalizado, EstadosInspeccion.SUBSANADA, System.StringComparison.OrdinalIgnoreCase)
            || string.Equals(estadoActualNormalizado, EstadosInspeccion.PAGO_VALIDADO, System.StringComparison.OrdinalIgnoreCase));
    var urlAsignarInspectorDetalle = puedeDerivarAsignacionInspector
        ? Url.Action("AsignarInspector", "Tecnico", new { solicitudId = Model.CodigoSolicitud })
        : string.Empty;
    var mensajeCoordinacionDetalle = string.Equals(estadoActualNormalizado, EstadosInspeccion.VERIFICACION_SOLICITUD, System.StringComparison.OrdinalIgnoreCase)
        ? "La verificacion institucional de esta solicitud se ejecuta desde la bandeja de Direccion / Jefatura. Alli se concentran las decisiones de aceptar, observar o cerrar sin duplicar acciones en la pantalla operativa de inspeccion."
        : (string.Equals(estadoActualNormalizado, EstadosInspeccion.ACEPTADA, System.StringComparison.OrdinalIgnoreCase)
            ? "La solicitud ya fue aceptada. El siguiente paso institucional es asignar inspector o revisar el avance desde Direccion / Jefatura."
            : "Las decisiones institucionales de este tramite se controlan desde Direccion / Jefatura para mantener una sola trazabilidad operativa por rol y estado.");
    var mensajeInspectorSinAcciones = EstadosInspeccion.EsEstadoBloqueCoordinacionJefatura(estadoActualNormalizado)
        ? "El tramite se encuentra en etapa de verificacion por Direccion / Jefatura. Aun no existen acciones disponibles para el Inspector."
        : "No existen acciones operativas disponibles para el Inspector en la etapa actual del tramite.";
    var puedePlanificar = esAdministrador || usuarioTieneRol("CoordinadorInspecciones");
    var puedeSubirInforme = User.IsInRole("Inspector") || User.IsInRole("Administrador");
    var puedeSolicitarViaticos = esInspector || puedeGestionarCoordinacion;
    var puedeValidarViaticos = User.IsInRole("CoordinadorFinanciero") || User.IsInRole("DirectorFinanciero") || User.IsInRole("Administrador");
    var puedeRegistrarResultado = esInspector || puedeGestionarCoordinacion;
    var puedeRegistrarHallazgo = User.IsInRole("Inspector") || User.IsInRole("Administrador");
    var puedeEditarInformeTecnico = esInspector || esAdministrador;
    var puedeSubirCorreccionSolicitante = User.IsInRole("Solicitante") || User.IsInRole("Administrador");
    var esSolicitante = User.IsInRole("Solicitante");
    var esDirdac = esAdministrador || usuarioTieneAlgunRol(new[] { "DIRDAC", "Direccion", "Director", "JefaturaTecnica", "Jefe" });
    var estadoInformeTecnico = informeTecnico != null && !string.IsNullOrWhiteSpace(informeTecnico.EstadoInforme)
        ? informeTecnico.EstadoInforme
        : (informeTecnico != null && informeTecnico.Finalizado ? "GENERADO" : "BORRADOR");
    var informeDefinitivoUrl = Model != null && Model.CodigoInspeccion > 0
        ? Url.Action("VerInforme", "Inspeccion", new { id = Model.CodigoInspeccion })
        : string.Empty;
    var informeDescargaUrl = Model != null && Model.CodigoInspeccion > 0
        ? Url.Action("DescargarInforme", "Inspeccion", new { id = Model.CodigoInspeccion })
        : string.Empty;
    var mostrarPanelVistaPrevia = tieneInforme || puedeEditarInformeTecnico;
    var copyVistaPrevia = tieneInforme
        ? "Consulte el PDF consolidado debajo del flujo BPMN antes de continuar con la revisión o firma."
        : "La vista previa del borrador se actualizará automáticamente mientras completa o corrige el informe técnico.";
    var rutaVistaPreviaTexto = tieneInforme
        ? rutaInformeVisual
        : "La vista previa automática aparecerá aquí cuando empiece a ingresar o actualizar la información del informe.";
    var ayudaViewer = tieneInforme
        ? "Documento definitivo disponible para revisión y firma."
        : "La vista previa automática se actualizará mientras edita el informe técnico.";
    var estadoViewer = tieneInforme ? estadoInformeTecnico : "VISTA PREVIA AUTOMÁTICA";
    var puedeFirmarInspector = puedeEditarInformeTecnico
        && informeTecnico != null
        && informeTecnico.Finalizado
        && !informeTecnico.FirmadoInspector
        && (string.Equals(estadoInformeTecnico, "APROBADO_COORDINADOR", System.StringComparison.OrdinalIgnoreCase)
            || string.Equals(estadoInformeTecnico, "APROBADO_DIRECCION", System.StringComparison.OrdinalIgnoreCase));
    var informeEnviadoADirdac = informeTecnico != null && string.Equals(estadoInformeTecnico, "ENVIADO_A_DIRDAC", System.StringComparison.OrdinalIgnoreCase);
    var informeEnviadoACoordinador = informeTecnico != null && string.Equals(estadoInformeTecnico, "ENVIADO_A_COORDINADOR", System.StringComparison.OrdinalIgnoreCase);
    var informeDevueltoCoordinador = informeTecnico != null && string.Equals(estadoInformeTecnico, "DEVUELTO_COORDINADOR", System.StringComparison.OrdinalIgnoreCase);
    var informeDevueltoDireccion = informeTecnico != null
        && (string.Equals(estadoInformeTecnico, "DEVUELTO_DIRECCION", System.StringComparison.OrdinalIgnoreCase)
            || string.Equals(estadoInformeTecnico, "RECHAZADO_DIRDAC", System.StringComparison.OrdinalIgnoreCase));
    var informeAprobadoDireccion = informeTecnico != null
        && (string.Equals(estadoInformeTecnico, "APROBADO_COORDINADOR", System.StringComparison.OrdinalIgnoreCase)
            || string.Equals(estadoInformeTecnico, "APROBADO_DIRECCION", System.StringComparison.OrdinalIgnoreCase)
            || string.Equals(estadoInformeTecnico, "FIRMADO_FINAL", System.StringComparison.OrdinalIgnoreCase)
            || informeTecnico.FirmadoDirdac);
    var notificacionFormalDirdac = informeTecnico != null && informeEnviadoADirdac && informeTecnico.CorreoEnviado;
    var puedeEnviarADirdac = puedeEditarInformeTecnico
        && informeTecnico != null
        && informeTecnico.Finalizado
        && !informeTecnico.FirmadoInspector
        && !informeEnviadoADirdac
        && !informeEnviadoACoordinador
        && !informeAprobadoDireccion;
    var puedeReintentarNotificacionDirdac = (puedeGestionarCoordinacion || esAdministrador)
        && informeTecnico != null
        && informeTecnico.Finalizado
        && !informeTecnico.FirmadoInspector
        && informeEnviadoADirdac
        && !notificacionFormalDirdac
        && !informeAprobadoDireccion;
    var puedeFirmarDirdac = esDirdac
        && informeTecnico != null
        && !informeAprobadoDireccion
        && string.Equals(estadoInformeTecnico, "ENVIADO_A_DIRDAC", System.StringComparison.OrdinalIgnoreCase);
    var correoSolicitante = solicitud != null && !string.IsNullOrWhiteSpace(solicitud.CorreoRepresentanteTecnico)
        ? solicitud.CorreoRepresentanteTecnico
        : (solicitud != null ? solicitud.Email : "-");
    var numeroInspeccionVisual = Model != null
        ? (!string.IsNullOrWhiteSpace(Model.NumeroInspeccion) ? Model.NumeroInspeccion : Model.CodigoInspeccion.ToString())
        : "-";
    var operadorInspeccionado = solicitud != null && !string.IsNullOrWhiteSpace(solicitud.NombreOperador)
        ? solicitud.NombreOperador
        : "-";
    var rucOperador = solicitud != null && !string.IsNullOrWhiteSpace(solicitud.Ruc) ? solicitud.Ruc : "-";
    var codigoOaciOperador = solicitud != null && !string.IsNullOrWhiteSpace(solicitud.CodigoOaci) ? solicitud.CodigoOaci : "-";
    var emailOperador = solicitud != null && !string.IsNullOrWhiteSpace(solicitud.Email) ? solicitud.Email : "-";
    var telefonoOperador = solicitud != null && !string.IsNullOrWhiteSpace(solicitud.Telefono) ? solicitud.Telefono : "-";
    var direccionOperador = solicitud != null && !string.IsNullOrWhiteSpace(solicitud.Direccion) ? solicitud.Direccion : "-";
    var representanteLegalOperador = solicitud != null && !string.IsNullOrWhiteSpace(solicitud.RepresentanteLegal) ? solicitud.RepresentanteLegal : "-";
    var tipoInspectorPrincipal = !string.IsNullOrWhiteSpace(Model.InspectorPrincipalTipo)
        ? Model.InspectorPrincipalTipo
        : (solicitud != null && !string.IsNullOrWhiteSpace(solicitud.TecnicoResponsableTipo) ? solicitud.TecnicoResponsableTipo : "-");
    var tipoInspectorApoyo = !string.IsNullOrWhiteSpace(Model.InspectorApoyoTipo)
        ? Model.InspectorApoyoTipo
        : (solicitud != null && !string.IsNullOrWhiteSpace(solicitud.InspectorApoyoTipo) ? solicitud.InspectorApoyoTipo : "-");
    var estadoFinanciero = Model.PagoViaticosValidado
        ? "Viáticos validados"
        : (Model.ViaticosRequeridos ? "Pendiente validación financiera" : "Sin requerimiento financiero");
    var horaProgramadaVisual = Model != null && Model.HoraProgramada.HasValue ? Model.HoraProgramada.Value.ToString(@"hh\:mm") : "";
    var fechaHoraProgramada = fechaProgramada + (!string.IsNullOrWhiteSpace(horaProgramadaVisual) ? " " + horaProgramadaVisual : "");
    var duracionEstimada = Model != null && Model.DuracionEstimada.HasValue ? Model.DuracionEstimada.Value + " h" : "-";
    var lugarInspeccion = Model != null && !string.IsNullOrWhiteSpace(Model.Lugar) ? Model.Lugar : "-";
    var tipoInspeccion = Model != null && !string.IsNullOrWhiteSpace(Model.Tipo) ? Model.Tipo : "-";
    var cedulaRepresentante = solicitud != null && !string.IsNullOrWhiteSpace(solicitud.CedulaRepresentante) ? solicitud.CedulaRepresentante : "";
    var representanteLegalCompleto = representanteLegalOperador != "-" && !string.IsNullOrWhiteSpace(cedulaRepresentante)
        ? representanteLegalOperador + " — " + cedulaRepresentante
        : representanteLegalOperador;
    var tipoOperacion = solicitud != null && !string.IsNullOrWhiteSpace(solicitud.TipoOperacion) ? solicitud.TipoOperacion : "-";
    var ciudadProv = new[] { solicitud != null ? (solicitud.Ciudad ?? "").Trim() : "", solicitud != null ? (solicitud.Provincia ?? "").Trim() : "" }.Where(s => s.Length > 0);
    var ubicacionOperador = ciudadProv.Any() ? string.Join(", ", ciudadProv) : "-";
    var serviciosEstacionesInforme = InformeTecnicoTemplateHelper.GetServicioRows(informeTecnico != null ? informeTecnico.ServiciosEstaciones : null);
    var documentosAdjuntosBase = InformeTecnicoTemplateHelper.GetDocumentosAdjuntosBase();
    var documentosAdjuntosSeleccionados = InformeTecnicoTemplateHelper.SplitLines(informeTecnico != null ? informeTecnico.DocumentosAdjuntos : null);
    var documentosAdjuntosArchivos = InformeTecnicoTemplateHelper.ParseDocumentosAdjuntosArchivos(informeTecnico != null ? informeTecnico.DocumentosAdjuntosArchivos : null);
    var numeroLicenciaInspector = informeTecnico != null && !string.IsNullOrWhiteSpace(informeTecnico.NumeroLicenciaInspector)
        ? informeTecnico.NumeroLicenciaInspector
        : (!string.IsNullOrWhiteSpace(inspectorPrincipalCedula) ? inspectorPrincipalCedula : string.Empty);
    var trabajosRealizadosInforme = informeTecnico != null && !string.IsNullOrWhiteSpace(informeTecnico.TrabajosRealizados)
        ? informeTecnico.TrabajosRealizados
        : (informeTecnico != null ? informeTecnico.Resumen : string.Empty);
    var operacionComercialInforme = informeTecnico != null ? informeTecnico.OperacionComercial : string.Empty;
    var notasInforme = informeTecnico != null ? informeTecnico.Notas : string.Empty;
    var noConformidadesInforme = informeTecnico != null && !string.IsNullOrWhiteSpace(informeTecnico.NoConformidades)
        ? informeTecnico.NoConformidades
        : (informeTecnico != null ? informeTecnico.Observaciones : string.Empty);
    var otrosAdjuntosInforme = informeTecnico != null ? informeTecnico.OtrosAdjuntos : string.Empty;
    var resultadoInforme = !string.IsNullOrWhiteSpace(informeTecnico != null ? informeTecnico.Resultado : null)
        ? informeTecnico.Resultado
        : (Model != null ? Model.Resultado : string.Empty);
    var notasLineas = InformeTecnicoTemplateHelper.SplitLines(notasInforme).Take(5).ToList();
    while (notasLineas.Count < 5)
    {
        notasLineas.Add(string.Empty);
    }

    var noConformidadesLineas = InformeTecnicoTemplateHelper.SplitLines(noConformidadesInforme).Take(4).ToList();
    while (noConformidadesLineas.Count < 4)
    {
        noConformidadesLineas.Add(string.Empty);
    }

    var recomendacionesLineas = InformeTecnicoTemplateHelper.SplitLines(informeTecnico != null ? informeTecnico.Recomendaciones : null).Take(3).ToList();
    while (recomendacionesLineas.Count < 3)
    {
        recomendacionesLineas.Add(string.Empty);
    }

    var otrosAdjuntosLineas = InformeTecnicoTemplateHelper.SplitLines(otrosAdjuntosInforme).Take(4).ToList();
    if (!otrosAdjuntosLineas.Any())
    {
        otrosAdjuntosLineas.Add("Orden de Inspección.");
    }
    while (otrosAdjuntosLineas.Count < 2)
    {
        otrosAdjuntosLineas.Add(string.Empty);
    }
}

@section Styles {
    <style>
        .inspection-detail-page {
            --inspection-primary: #1b4f72;
            --inspection-primary-dark: #163a55;
            --inspection-accent: #0f7b84;
            --inspection-soft: #eef5f8;
            --inspection-border: rgba(27, 79, 114, 0.14);
            --inspection-muted: #667784;
            --inspection-text: #243746;
            --inspection-success: #2f7d50;
            --inspection-warning: #c48a18;
            --inspection-danger: #b84a4a;
            --inspection-shadow: 0 18px 38px rgba(13, 40, 58, 0.08);
            color: var(--inspection-text);
        }

        .inspection-detail-page .inspection-shell {
            background: linear-gradient(180deg, #f8fbfd 0%, #edf3f7 100%);
            border: 1px solid rgba(255, 255, 255, 0.75);
            border-radius: 28px;
            padding: 1.5rem;
        }

        .inspection-detail-page .hero-card {
            position: relative;
            overflow: hidden;
            border: 0;
            border-radius: 28px;
            background: linear-gradient(135deg, var(--inspection-primary-dark) 0%, var(--inspection-primary) 58%, #266f8b 100%);
            color: #fff;
            box-shadow: var(--inspection-shadow);
        }

        .inspection-detail-page .hero-card::before {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient(90deg, rgba(255, 255, 255, 0.08), transparent 58%);
        }

        .inspection-detail-page .hero-card::after {
            content: "";
            position: absolute;
            right: -70px;
            bottom: -85px;
            width: 240px;
            height: 240px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.08);
        }

        .inspection-detail-page .hero-body {
            position: relative;
            z-index: 1;
            padding: 1.75rem;
        }

        .inspection-detail-page .hero-layout {
            display: grid;
            grid-template-columns: minmax(0, 1.55fr) minmax(320px, 0.95fr);
            gap: 1.25rem;
            align-items: stretch;
        }

        .inspection-detail-page .hero-main {
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        .inspection-detail-page .hero-side {
            display: grid;
            gap: 1rem;
            align-content: start;
        }

        .inspection-detail-page .hero-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.55rem;
            padding: 0.5rem 0.85rem;
            border-radius: 999px;
            background: rgba(255, 255, 255, 0.14);
            font-size: 0.8rem;
            font-weight: 800;
            letter-spacing: 0.04em;
            text-transform: uppercase;
        }

        .inspection-detail-page .hero-title {
            margin: 1rem 0 0.35rem;
            font-size: 2rem;
