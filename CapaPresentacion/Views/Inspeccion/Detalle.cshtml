                                </button>
                            }
                        }
                    }

                    @if (esSolicitante)
                    {
                        if (puedeSubirCorreccionSolicitante)
                        {
                            <div class="alert alert-inline mb-3">
                                Revise el informe final, atienda las observaciones registradas y cargue una nueva versión del documento requerido.
                            </div>

                            using (Html.BeginForm("SubirDocumentoSolicitante", "Inspeccion", FormMethod.Post, new { enctype = "multipart/form-data", @class = "compact-form mb-3" }))
                            {
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@Model.CodigoInspeccion" />
                                <div class="row g-3 align-items-end mb-3">
                                    <div class="col-md-4 mb-3">
