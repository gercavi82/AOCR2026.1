                                    <div class="col-12 mb-3">
                                        <label class="form-label fw-semibold" for="observacionCorreccionSolicitante">Observación del solicitante</label>
                                        <textarea class="form-control" id="observacionCorreccionSolicitante" name="observacion" rows="2" placeholder="Detalle breve de la corrección realizada para revisión técnica."></textarea>
                                    </div>
                                    <div class="col-12 d-flex justify-content-end">
                                        <button type="submit" class="btn btn-outline-primary">
                                            <i class="fas fa-upload"></i>
                                            Cargar nueva version
                                        </button>
                                    </div>
                                </div>
                            }
                        }
                        else if (string.Equals(resultadoInformeNormalizado, "INSATISFACTORIO", System.StringComparison.OrdinalIgnoreCase)
                            && string.Equals(tipoResultadoInsatisfactorioInforme, "SIN_INSPECCION", System.StringComparison.OrdinalIgnoreCase))
                        {
                            <div class="alert alert-warning mb-3">
                                La subsanación documental del RT se habilitará cuando coordinación apruebe formalmente la NC y devuelva el expediente en observación.
                            </div>
                        }
                        else if (string.Equals(resultadoInformeNormalizado, "INSATISFACTORIO", System.StringComparison.OrdinalIgnoreCase)
                            && string.Equals(tipoResultadoInsatisfactorioInforme, "CON_INSPECCION", System.StringComparison.OrdinalIgnoreCase))
                        {
                            <div class="alert alert-info mb-3">
                                Este resultado insatisfactorio continúa por la ruta de nueva inspección. No corresponde cargar subsanación documental en esta etapa.
                            </div>
                        }
                    }

                    @if (documentosLista.Any())
