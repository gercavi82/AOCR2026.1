                                        <select class="form-control" id="documentoBaseIdSolicitante" name="documentoBaseId">
                                            <option value="">Seleccione si corrige un documento existente</option>
                                            @foreach (var docBase in documentosLista.OrderByDescending(d => d.CodigoDocumento))
                                            {
                                                <option value="@docBase.CodigoDocumento">@((docBase.TipoDocumento ?? "DOCUMENTO") + " · v" + docBase.Version + (!string.IsNullOrWhiteSpace(docBase.Observacion) ? " · " + normalizeVisibleText(docBase.Observacion) : string.Empty))</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-md-4 mb-3">
                                        <label class="form-label fw-semibold" for="tipoDocumentoSolicitante">Tipo de documento</label>
                                        <input type="text" class="form-control" id="tipoDocumentoSolicitante" name="tipoDocumento" value="@(documentoSolicitanteBase != null ? documentoSolicitanteBase.TipoDocumento : "DOCUMENTO_CORREGIDO")" required />
                                    </div>
                                    <div class="col-md-4 mb-3">
