                        </div>
                        <div>
                            <h2 class="section-title">Hallazgos</h2>
                            <p class="section-copy">Registro de novedades, severidad y estado de seguimiento de cada hallazgo.</p>
                        </div>
                    </div>
                        <div class="hallazgos-summary">
                            <div class="hallazgos-summary-item"><i class="fas fa-layer-group"></i> @hallazgosLista.Count registrados</div>
                            <div class="hallazgos-summary-item"><i class="fas fa-shield-alt"></i> Sección crítica del proceso</div>
                        </div>
                    </div>

                    @if (puedeRegistrarHallazgo)
                    {
                        <button class="btn btn-warning" type="button" data-bs-toggle="modal" data-bs-target="#modalHallazgo">
                            <i class="fas fa-plus-circle"></i>
                            Registrar hallazgo
                        </button>
                    }
                </div>

                @if (hallazgosLista.Any())
                {
                    if (mostrarTipoResultadoInsatisfactorioInforme)
                    {
                        <div class="alert alert-warning mb-3">
                            <strong>NC obligatoria para este branch:</strong> @mensajeRutaResultadoInsatisfactorio
                            @if (hallazgosAbiertos > 0)
                            {
                                <span> Existen @hallazgosAbiertos NC abiertas pendientes de decisión formal.</span>
                            }
                        </div>

                        if (puedeGestionarCoordinacion && hallazgosAbiertos <= 0)
                        {
                            <div class="alert alert-danger mb-3">
                                Coordinación no puede decidir la ruta institucional hasta que exista al menos una NC abierta registrada por el inspector.
                            </div>
                        }

                        if (puedeAprobarNcNuevaInspeccion || puedeAprobarNcSubsanacionDocumental)
                        {
                            <div class="d-flex flex-column flex-md-row gap-2 mb-3">
                                @if (puedeAprobarNcNuevaInspeccion)
                                {
                                    using (Html.BeginForm("SolicitarNueva", "Inspeccion", FormMethod.Post, new { @class = "d-inline" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@Model.CodigoInspeccion" />
                                        <button type="submit" class="btn btn-outline-danger">
                                            <i class="fas fa-route"></i>
                                            Aprobar NC y solicitar nueva inspección
                                        </button>
                                    }
                                }

                                @if (puedeAprobarNcSubsanacionDocumental)
                                {
                                    using (Html.BeginForm("AprobarNcSubsanacionDocumental", "Inspeccion", FormMethod.Post, new { @class = "d-inline" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@Model.CodigoInspeccion" />
                                        <button type="submit" class="btn btn-outline-warning">
                                            <i class="fas fa-file-circle-check"></i>
                                            Aprobar NC y habilitar subsanación RT
                                        </button>
                                    }
                                }
                            </div>
                        }
                    }

                    <div class="hallazgos-list">
                        @for (var hallazgoIndex = 0; hallazgoIndex < hallazgosLista.Count; hallazgoIndex++)
                        {
                            var h = hallazgosLista[hallazgoIndex];
                            var criticidadTexto = normalizeVisibleText(h.Criticidad ?? "Sin severidad");
                            var estadoHallazgoTexto = normalizeVisibleText(h.Estado ?? "Sin estado");
                            var descripcionHallazgo = string.IsNullOrWhiteSpace(h.Descripcion) ? "Sin descripción registrada." : normalizeVisibleText(h.Descripcion);
                            var criticidadNormalizada = (criticidadTexto ?? string.Empty).Trim().ToUpperInvariant();
                            var estadoNormalizado = (estadoHallazgoTexto ?? string.Empty).Trim().ToUpperInvariant();
                            var criticidadClase = criticidadNormalizada.Contains("ALTA") || criticidadNormalizada.Contains("CRIT") || criticidadNormalizada.Contains("MAYOR")
                                ? "is-critical"
                                : (criticidadNormalizada.Contains("MEDIA") || criticidadNormalizada.Contains("MODER")
                                    ? "is-medium"
                                    : (criticidadNormalizada.Contains("BAJA") || criticidadNormalizada.Contains("MENOR")
                                        ? "is-low"
                                        : "is-neutral"));
                            var estadoClase = estadoNormalizado.Contains("CERR") || estadoNormalizado.Contains("SOLUC") || estadoNormalizado.Contains("RESUEL")
                                ? "is-state-closed"
                                : (estadoNormalizado.Contains("PROCES") || estadoNormalizado.Contains("REVISION") || estadoNormalizado.Contains("SEGUIMIENTO")
                                    ? "is-state-progress"
                                    : (estadoNormalizado.Contains("ABIER") || estadoNormalizado.Contains("PEND")
                                        ? "is-state-open"
                                        : "is-neutral"));

                            <article class="hallazgo-row @criticidadClase">
                                <div class="hallazgo-row-main">
                                    <span class="hallazgo-row-label">Hallazgo @(hallazgoIndex + 1)</span>
                                    <div class="hallazgo-row-title">@criticidadTexto</div>
                                </div>
                                <div class="hallazgo-row-copy">@descripcionHallazgo</div>
                                <div class="hallazgo-row-side">
                                    <span class="hallazgo-pill @estadoClase">@estadoHallazgoTexto</span>
                                </div>
                            </article>
                        }
                    </div>
                }
                else
                {
                    <div class="hallazgos-empty hallazgos-empty-card">
                        <div class="hallazgo-empty-inline">No hay hallazgos registrados para esta inspección.</div>
                    </div>
                }
            </div>
        </div>
            </div>
        </div>
        </div>

        <div class="aocr-mobile-collapse-shell">
            <button class="aocr-mobile-collapse-toggle d-md-none" type="button" data-bs-toggle="collapse" data-bs-target="#collapseDetalleCierre" aria-expanded="false" aria-controls="collapseDetalleCierre">
                <span class="aocr-mobile-collapse-summary">
                    <small>Más acciones</small>
                    <strong>Planificación y cierre operativo</strong>
                </span>
                <span class="aocr-mobile-collapse-badge">Cierre</span>
            </button>
            <div id="collapseDetalleCierre" class="aocr-mobile-collapse-section collapse">
        <div class="action-footer">
            <div>
                <span class="section-badge">Cierre operativo</span>
                <p class="section-copy mb-0 mt-2">Continúe con la planificación o ejecute el cierre institucional según su rol y el estado actual del flujo.</p>
            </div>
            @if (puedePlanificar)
            {
                <a class="btn btn-primary"
                   href="@Url.Action("Planificacion", "Inspeccion", new { id = Model.CodigoInspeccion })">
                    <i class="fas fa-calendar-alt"></i>
                    Planificar inspección
                </a>
            }

            @if (mostrarAccionesCierreDetalle && puedeCerrar)
            {
                using (Html.BeginForm("Cerrar", "Inspeccion", FormMethod.Post, new { @class = "button-flow" }))
                {
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.CodigoInspeccion" />
                    <button type="submit" name="resultado" value="APROBADO" class="btn btn-success">Aprobar</button>
                    <button type="submit" name="resultado" value="RECHAZADO" class="btn btn-danger">Rechazar</button>
                }
            }
            else if (puedeGestionarCoordinacion && !esInspector && puedeCerrar)
            {
                <div class="alert alert-info mb-0" role="alert">
                    El cierre institucional de esta inspección se ejecuta desde
                    <a href="@Url.Action("RevisionVerificacion", "CoordinacionJefatura")" class="alert-link">Dirección / Jefatura</a>
                    para mantener una sola bandeja de decisión y trazabilidad.
                </div>
            }
        </div>
    </div>
</div>
</div>
</div>

@section Scripts {
    <script>
        (function () {
            var modalElement = document.getElementById('modalListaVerificacionOperacionalEae');
            if (!modalElement) {
                return;
            }

            var modalDialog = modalElement.querySelector('.modal-dialog');
            var expandButton = modalElement.querySelector('[data-lv-modal-toggle="expand"]');
            var expandButtonLabel = expandButton ? expandButton.querySelector('.lv-modal-expand-toggle-label') : null;
            var expandButtonIcon = expandButton ? expandButton.querySelector('i') : null;

            function updateExpandButton() {
                if (!expandButton) {
                    return;
                }

                var expanded = modalDialog && modalDialog.classList.contains('lv-modal-dialog-expanded');
                expandButton.setAttribute('aria-pressed', expanded ? 'true' : 'false');
                expandButton.setAttribute('title', expanded ? 'Restaurar tamaño' : 'Expandir a pantalla');

                if (expandButtonLabel) {
                    expandButtonLabel.textContent = expanded ? 'Restaurar' : 'Expandir';
                }

                if (expandButtonIcon) {
                    expandButtonIcon.classList.toggle('fa-expand', !expanded);
                    expandButtonIcon.classList.toggle('fa-compress', expanded);
                }
            }

            function setExpanded(expanded) {
                if (!modalDialog) {
                    return;
                }

                modalDialog.classList.toggle('lv-modal-dialog-expanded', !!expanded);
                modalElement.classList.toggle('lv-modal-expanded', !!expanded);
                modalElement.setAttribute('data-lv-expanded', expanded ? 'true' : 'false');

                if (window.bootstrap && window.bootstrap.Modal) {
                    var modalInstance = window.bootstrap.Modal.getInstance(modalElement);
                    if (modalInstance && typeof modalInstance.handleUpdate === 'function') {
                        modalInstance.handleUpdate();
                    }
                }

                updateExpandButton();
            }

            if (expandButton) {
                expandButton.addEventListener('click', function () {
                    var expanded = modalDialog && modalDialog.classList.contains('lv-modal-dialog-expanded');
                    setExpanded(!expanded);
                });
                updateExpandButton();
            }

            modalElement.addEventListener('hidden.bs.modal', function () {
                setExpanded(false);
            });

            var debeAbrirse = (modalElement.getAttribute('data-auto-open') || 'false') === 'true';
            if (!debeAbrirse || !window.bootstrap || !window.bootstrap.Modal) {
                return;
            }

            window.setTimeout(function () {
                if (modalElement.classList.contains('show')) {
                    return;
                }

                window.bootstrap.Modal.getOrCreateInstance(modalElement).show();
            }, 320);
        })();
    </script>
    <script src="@AssetVersionHelper.VersionedContent(Url, "~/Scripts/aocr-informe-tecnico-modal.js")"></script>
    <script src="@AssetVersionHelper.VersionedContent(Url, "~/Scripts/aocr-lv-eae-flujo-automatico.js")"></script>
}


<div class="modal fade" id="modalHallazgo" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Registrar hallazgo</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                @using (Html.BeginForm("RegistrarHallazgo", "Inspeccion", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    @Html.Hidden("CodigoInspeccion", Model.CodigoInspeccion)

                    <div class="mb-3">
                        <label class="form-label d-block">Severidad</label>
                        <select name="Severidad" class="form-control" required>
                            <option value="ALTA">ALTA</option>
                            <option value="MEDIA">MEDIA</option>
                            <option value="BAJA">BAJA</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label d-block">Descripción</label>
                        <textarea name="Descripcion" class="form-control" rows="3" required></textarea>
                    </div>

                    <button class="btn btn-primary" type="submit">Guardar</button>
                }
            </div>
        </div>
    </div>
</div>
