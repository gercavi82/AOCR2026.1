                            <div class="alert alert-warning alert-inline mb-3">@mensajeBloqueoRevisionDocumentalInspector</div>
                            using (Html.BeginForm("ConfirmarRevisionDocumentalInspector", "Inspeccion", FormMethod.Post, new { @class = "mb-3" }))
                            {
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@Model.CodigoInspeccion" />
                                <button type="submit" class="btn btn-warning w-100">
