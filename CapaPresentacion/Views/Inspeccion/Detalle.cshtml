                                : (tieneInforme ? estadoInformeTecnico : "Disponible para elaboración");
                            var claseEstadoAccesoInforme = !informeTecnicoModalHabilitado
                                ? "warning"
                                : (tieneInforme ? "primary" : "success");
                            var estadoLvModal = !usaFlujoListaVerificacionOperacionalEae
                                ? "No aplica"
