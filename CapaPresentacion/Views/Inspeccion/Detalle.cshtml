                        </div>
                    }

                    @if (puedeRegistrarResultado)
                    {
                        if (resultadoInformeNormalizado == "INSATISFACTORIO")
                        {
                            <div class="alert alert-warning alert-inline mb-3">
                                <strong>Ruta no satisfactoria activa:</strong> @mensajeRutaResultadoInsatisfactorio
                                @if (!tieneNoConformidadRegistrada)
                                {
                                    <span class="d-block mt-2">Al registrar el resultado, el sistema materializará una NC base desde el Informe Técnico si aún no existe. Puede complementar los hallazgos antes o después desde la sección respectiva.</span>
                                }
                            </div>

                            if (puedeRegistrarHallazgo)
