                                TieneDocumentosSubsanadosPendientes = estadoRevisionDocumental.TieneDocumentosSubsanadosPendientes,
                                DocumentacionAprobada = estadoRevisionDocumental.DocumentacionAprobada,
                                PuedeAbrirLvEae = puedeAbrirLvEae,
