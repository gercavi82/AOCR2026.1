                                            <span class="status-pill primary"><i class="fas fa-hashtag"></i> Inspección @numeroInspeccionVisual</span>
                                            <span class="status-pill primary"><i class="fas fa-file-contract"></i> Solicitud @numeroSolicitudVisual</span>
                                            <span class="status-pill @(listaVerificacionFinalizada ? "success" : "warning")"><i class="fas fa-clipboard-check"></i> LV/EAE: @estadoLvModal</span>
                                        </div>

                                        <div class="button-flow justify-content-xl-end">
                                            @if (informeTecnicoModalHabilitado)
                                            {
                                                <button type="button"
                                                        class="btn btn-primary aocr-btn-informe-tecnico"
                                                        data-url="@urlModalInformeTecnico"
                                                        data-codigo-inspeccion="@Model.CodigoInspeccion">
                                                    <i class="fas fa-file-alt me-1"></i> Informe Técnico
                                                </button>
                                            }
                                            else
                                            {
                                                <span class="aocr-disabled-button-wrapper"
                                                      tabindex="0"
                                                      data-bs-toggle="tooltip"
                                                      data-bs-placement="top"
                                                      title="@mensajeBloqueoInformeTecnico">
                                                    <button type="button" class="btn btn-secondary" disabled>
                                                        <i class="fas fa-lock me-1"></i> Informe Técnico
                                                    </button>
                                                </span>
                                            }

                                            @if (tieneInforme)
                                            {
                                                <a class="btn btn-outline-primary" href="@informeDefinitivoUrl" target="_blank" rel="noopener">
                                                    <i class="fas fa-file-pdf me-1"></i> Ver PDF
