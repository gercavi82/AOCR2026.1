            </div>

            <div class="card section-card soft-card">
                <div class="card-body">
                    <div class="section-heading">
                        <div class="section-icon">
                            <i class="fas fa-file-pdf"></i>
                        </div>
                        <div>
                            <h2 class="section-title">Informe tecnico</h2>
                            <p class="section-copy">Redacción estructurada del informe, generación automática del PDF y flujo de revisión institucional por roles.</p>
                        </div>
                    </div>

                    @if (puedeEditarInformeTecnico)
                    {
                        using (Html.BeginForm("GuardarInformeTecnico", "Inspeccion", FormMethod.Post, new { @class = "mb-4", id = "formInformeTecnico", enctype = "multipart/form-data", data_tiene_informe = tieneInforme ? "true" : "false", data_operador_informe = operadorInspeccionado }))
                        {
                            @Html.AntiForgeryToken()
                            @Html.Hidden("id", Model.CodigoInspeccion)
                            @Html.Hidden("titulo", string.IsNullOrWhiteSpace(informeTecnico != null ? informeTecnico.Titulo : null) ? "Informe de inspeccion" : informeTecnico.Titulo)

                            <div class="report-shell report-original-editor">
                                <div class="report-original-doc">
                                    <div class="report-original-header">
                                        <p class="report-original-annex">ANEXO 1</p>
                                        <p class="report-original-entity">DIRECCION INSPECCION Y CERTIFICACION AERONAUTICA</p>
                                        <h3 class="report-original-title">INFORME DE INSPECCION</h3>
                                    </div>

                                    <div class="report-original-inline">
                                        <span class="report-original-inline-copy">ORDEN DE INSPECCION:</span>
                                        <input type="text" class="form-control report-original-input report-original-readonly" value="@numeroInspeccionVisual" readonly />
                                    </div>

                                    <div class="report-original-block">
                                        <span class="report-original-label">TRABAJOS REALIZADOS:</span>
                                        <input type="hidden" id="trabajosRealizadosField" name="trabajosRealizados" value="@trabajosRealizadosInforme" />
                                        <div class="report-original-text">
                                            En cumplimiento del Art. 110 del Código Aeronáutico, entre
                                            <span class="report-original-fill">
                                                <input type="text" id="fechasInspeccionManualField" class="form-control report-original-input border-0 p-0 bg-transparent" name="fechasInspeccionManual" value="@(informeTecnico != null ? informeTecnico.FechasInspeccionManual : string.Empty)" placeholder="fecha" />
                                            </span>
                                            se realizó la inspección a la(s) estación(es) de
                                            <span class="report-original-fill long">
                                                <input type="text" id="estacionesInspeccionManualField" class="form-control report-original-input border-0 p-0 bg-transparent" name="estacionesInspeccionManual" value="@(informeTecnico != null ? informeTecnico.EstacionesInspeccionManual : string.Empty)" placeholder="UIO, GYE, MEC, LTX" />
                                            </span>
                                            con el fin de verificar que la compañía
                                            <span class="report-original-fill long">@operadorInspeccionado</span>
                                            cuenta con instalaciones, facilidades y personal técnico - operativo que brinda asistencia en tierra a sus operaciones comerciales, en la(s) cual(es) se verificó lo siguiente:
                                        </div>

                                        <input type="hidden" name="operacionComercial" value="@operacionComercialInforme" />
                                        <div class="report-original-operation">
                                            <div class="report-original-text">
                                                La operación comercial de <span class="report-original-strong">@operadorInspeccionado</span> será asistida por:
                                            </div>
                                        </div>

                                        <input type="hidden" name="serviciosEstacionesPresent" value="true" />
                                        <div class="inspection-services-shell mt-3">
                                            <table class="table table-bordered inspection-services-table">
                                                <thead>
                                                    <tr>
                                                        <th>Servicio / responsabilidad</th>
                                                        <th class="text-center">UIO</th>
                                                        <th class="text-center">GYE</th>
                                                        <th class="text-center">MEC</th>
                                                        <th class="text-center">LTX</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var fila in serviciosEstacionesInforme)
                                                    {
                                                        <tr>
                                                            <td>@fila.Label</td>
                                                            <td><input type="text" class="form-control form-control-sm service-text" name="@("servicio_" + fila.Key + "_uio")" value="@(fila.Uio ?? "")" placeholder="" /></td>
                                                            <td><input type="text" class="form-control form-control-sm service-text" name="@("servicio_" + fila.Key + "_gye")" value="@(fila.Gye ?? "")" placeholder="" /></td>
                                                            <td><input type="text" class="form-control form-control-sm service-text" name="@("servicio_" + fila.Key + "_mec")" value="@(fila.Mec ?? "")" placeholder="" /></td>
                                                            <td><input type="text" class="form-control form-control-sm service-text" name="@("servicio_" + fila.Key + "_ltx")" value="@(fila.Ltx ?? "")" placeholder="" /></td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>

                                    <div class="report-original-block">
                                        <span class="report-original-label">Notas:</span>
                                        <textarea class="form-control report-original-input" name="notas" rows="6" placeholder="Ingrese aquí las notas del informe. Cada línea se conservará en el PDF.">@notasInforme</textarea>
                                    </div>

                                    <div class="report-original-block">
                                        <span class="report-original-label">No Conformidades:</span>
                                        <textarea class="form-control report-original-input" name="noConformidades" rows="5" placeholder="Ingrese aquí las no conformidades. Cada línea se conservará en el PDF.">@noConformidadesInforme</textarea>
                                    </div>

                                    <div class="report-original-block">
                                        <span class="report-original-label">2. CONCLUSION</span>
                                        <input type="hidden" id="conclusionesField" name="conclusiones" value="@(informeTecnico != null ? informeTecnico.Conclusiones : string.Empty)" />
                                        <div class="report-original-text">El resultado de la inspección es:</div>
                                        <div class="report-original-result-list">
                                            <label class="report-original-result-item">
                                                <span class="report-original-bullet">•</span>
                                                <input type="radio" name="resultado" value="SATISFACTORIO" @(string.Equals(resultadoInforme, "SATISFACTORIO", System.StringComparison.OrdinalIgnoreCase) ? "checked" : null) />
                                                <span>Satisfactorio</span>
                                            </label>
                                            <label class="report-original-result-item">
                                                <span class="report-original-bullet">•</span>
                                                <input type="radio" name="resultado" value="NO_SATISFACTORIO" @(string.Equals(resultadoInforme, "NO_SATISFACTORIO", System.StringComparison.OrdinalIgnoreCase) || string.Equals(resultadoInforme, "INSATISFACTORIO", System.StringComparison.OrdinalIgnoreCase) ? "checked" : null) />
                                                <span>Insatisfactorio.</span>
                                            </label>
                                        </div>
                                    </div>

                                    <div class="report-original-block">
                                        <span class="report-original-label">3. RECOMENDACIONES:</span>
                                        <textarea class="form-control report-original-input" name="recomendaciones" rows="5" placeholder="Ingrese aquí las recomendaciones. Cada línea se conservará en el PDF.">@(informeTecnico != null ? informeTecnico.Recomendaciones : string.Empty)</textarea>
                                    </div>

                                    <div class="report-original-block">
                                        <span class="report-original-label">DOCUMENTOS ADJUNTOS:</span>
                                        <input type="hidden" name="documentosAdjuntosPresent" value="true" />
                                        <div class="report-original-documents">
                                            @{ var idxAdj = 0; }
                                            @foreach (var adjunto in documentosAdjuntosBase)
                                            {
                                                var estaSeleccionado = documentosAdjuntosSeleccionados.Any(item => string.Equals(item, adjunto, System.StringComparison.OrdinalIgnoreCase));
                                                var archivoAdjuntoActual = documentosAdjuntosArchivos.ContainsKey(adjunto) ? documentosAdjuntosArchivos[adjunto] : string.Empty;
                                                var resumenAdjuntoActual = !string.IsNullOrWhiteSpace(archivoAdjuntoActual)
                                                    ? "Archivo cargado: " + archivoAdjuntoActual
                                                    : (estaSeleccionado ? "Documento marcado en el informe. Sin archivo cargado." : string.Empty);
                                                var adjFileKey = "archivoAdjunto_" + idxAdj;
                                                var adjSummaryId = "adjuntoResumen_" + idxAdj;
                                                <div class="report-original-document-item">
                                                    <label class="report-original-document-main">
                                                        <span class="report-original-bullet">•</span>
                                                        <input type="checkbox" name="documentosAdjuntos" value="@adjunto" @(estaSeleccionado ? "checked" : null) />
                                                        <span>@adjunto</span>
                                                    </label>
                                                    <div class="report-original-document-upload">
                                                        <input type="file" name="@adjFileKey" class="form-control form-control-sm" accept=".pdf,.jpg,.jpeg,.png,.doc,.docx,.xls,.xlsx" data-file-summary-target="@adjSummaryId" />
                                                        <small class="report-original-document-note" id="@adjSummaryId" data-existing-summary="@resumenAdjuntoActual">@resumenAdjuntoActual</small>
                                                    </div>
                                                </div>
                                                idxAdj++;
                                            }
                                        </div>

                                        <div class="report-original-text mt-3">
                                            <strong>• OTROS:</strong>
                                            <textarea class="form-control report-original-input mt-3" name="otrosAdjuntos" rows="4" placeholder="Ingrese aquí otros documentos adjuntos. Puede usar una línea por documento.">@otrosAdjuntosInforme</textarea>
                                            <input type="file" name="otrosAdjuntosArchivo" class="form-control form-control-sm mt-3" multiple accept=".pdf,.jpg,.jpeg,.png,.doc,.docx,.xls,.xlsx" />
                                        </div>
                                    </div>

                                    <div class="report-original-signature">
                                        <div class="report-original-signature-line"></div>
                                        <p class="report-original-signature-name">@(!string.IsNullOrWhiteSpace(inspectorPrincipalNombre) ? inspectorPrincipalNombre : "NOMBRE DEL INSPECTOR")</p>
                                        <p class="report-original-signature-license">@(string.IsNullOrWhiteSpace(numeroLicenciaInspector) ? "No. LICENCIA" : "No. LICENCIA " + numeroLicenciaInspector)</p>
                                        <p class="report-original-signature-role">INSPECTOR DGAC</p>
                                        <p class="report-original-signature-specialty">ESPECIALISTA CERTIFICACION DE OPERACIONES</p>
                                    </div>
                                </div>

                                <div class="report-original-actions">
                                    <p class="report-original-actions-copy">El anexo conserva la estructura original del informe. Puede guardar el borrador, abrir la vista previa o finalizar el documento definitivo.</p>
                                    <div class="report-action-grid">
                                        <button type="submit" class="btn btn-outline-primary">
                                            <i class="fas fa-save me-1"></i> Guardar borrador
                                        </button>
                                        <button type="button" class="btn btn-outline-secondary" id="btnPreviewInformeTecnico">
                                            <i class="fas fa-eye me-1"></i> Previsualizar informe
                                        </button>
                                        <button type="submit" class="btn btn-primary" name="finalizar" value="true" onclick="return confirm('¿Confirma que desea finalizar el informe técnico y generar el PDF definitivo?');">
                                            <i class="fas fa-file-pdf me-1"></i> Finalizar informe
                                        </button>
                                        <a class="btn btn-light" href="@Url.Action("Index", "Inspeccion")">
                                            <i class="fas fa-arrow-left me-1"></i> Volver
                                        </a>
                                    </div>
                                </div>
                            </div>
                        }
                    }

                    @if (!tieneInforme && !mostrarPanelVistaPrevia)
                    {
                        <div class="alert alert-light alert-inline mb-3">Aún no hay informe cargado para esta inspección.</div>
                    }

                    @if (informeTecnico != null && (esInspector || esAdministrador))
                    {
                        <div class="alert alert-light alert-inline mb-0" style="font-size:0.88rem;">
                            La firma digital del inspector se habilita despues de la revisión DIRDAC y la aprobación de Coordinación.
                        </div>

                        var firmaInspectorVm = new FirmaInspectorPanelVm
                        {
                            CodigoInspeccion = Model.CodigoInspeccion,
                            InformeTecnico = informeTecnico,
                            PuedeFirmarInspector = puedeFirmarInspector,
                            PuedeEnviarADirdac = puedeEnviarADirdac,
                            PuedeReintentarNotificacionDirdac = puedeReintentarNotificacionDirdac,
                            InformeEnviadoADirdac = informeEnviadoADirdac,
                            InformeDevueltoCoordinador = informeDevueltoCoordinador,
                            InformeDevueltoDireccion = informeDevueltoDireccion,
                            InformeAprobadoDireccion = informeAprobadoDireccion,
                            EstadoInformeTecnico = estadoInformeTecnico
                        };
                        @Html.Partial("_FirmaInspectorPanel", firmaInspectorVm)
                    }
                </div>
            </div>
        </div>

        @* ══════════════════════════════════════════════════════════════
           SECCIÓN: COORDINADOR
           Bloque de revisión de solo lectura por el coordinador.
           ══════════════════════════════════════════════════════════════ *@
        @{
            var coordinadorVm = new CoordinadorPanelVm
