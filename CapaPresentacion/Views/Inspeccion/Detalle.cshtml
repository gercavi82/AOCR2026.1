        <div class="utility-grid">
            <div class="card section-card soft-card">
                <div class="card-body">
                    <div class="section-heading">
                        <div class="section-icon">
                            <i class="fas fa-stream"></i>
                        </div>
                        <div>
                            <h2 class="section-title">Historial de estados</h2>
                            <p class="section-copy">Trazabilidad completa de transiciones BPMN, origen y observaciones de cada movimiento.</p>
                        </div>
                    </div>

                    @if (historialLista.Any())
                    {
                        <div class="timeline-list">
                            @foreach (var item in historialLista)
                            {
                                <div class="timeline-item">
                                    <div class="timeline-meta">
                                        <span><strong>@item.FechaCambio.ToString("yyyy-MM-dd HH:mm")</strong></span>
                                        <span>@(string.IsNullOrWhiteSpace(item.UsuarioNombre) ? "Sistema" : item.UsuarioNombre)</span>
                                        <span>@(string.IsNullOrWhiteSpace(item.Origen) ? "FLUJO" : item.Origen)</span>
                                    </div>
                                    <div class="detail-value">@(!string.IsNullOrWhiteSpace(item.EstadoAnterior) ? item.EstadoAnterior : "SIN ESTADO") <i class="fas fa-arrow-right text-muted mx-1"></i> @item.EstadoNuevo</div>
                                    @if (!string.IsNullOrWhiteSpace(item.Observacion))
                                    {
                                        <div class="text-muted mt-2">@item.Observacion</div>
                                    }
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-light alert-inline mb-0">Todavía no existen eventos de transición registrados para esta inspección.</div>
                    }
                </div>
            </div>

            <div class="card section-card">
                <div class="card-body">
                    <div class="section-heading">
                        <div class="section-icon">
                            <i class="fas fa-file-upload"></i>
                        </div>
                        <div>
                            <h2 class="section-title">Subsanación y documentos</h2>
                            <p class="section-copy">Versionado de documentos corregidos y revisión del solicitante sobre observaciones documentales.</p>
                        </div>
                    </div>

                    @if (esSolicitante)
                    {
                        <div class="alert alert-inline mb-3">
                            Revise el informe final, atienda las observaciones registradas y cargue una nueva versión del documento requerido.
                        </div>
                    }

                    @if (documentosLista.Any())
                    {
                        <div class="table-responsive doc-table mb-3">
                            <table class="table table-hover mb-0">
                                <thead>
                                    <tr>
                                        <th>Tipo</th>
                                        <th>Versión</th>
                                        <th>Archivo</th>
                                        <th>Rol</th>
                                        <th>Observación</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var doc in documentosLista)
                                    {
                                        <tr>
                                            <td>@(doc.TipoDocumento ?? "-")</td>
                                            <td>v@doc.Version</td>
                                            <td>
                                                @if (!string.IsNullOrWhiteSpace(doc.RutaArchivo))
                                                {
                                                    var urlDocSolicitante = Url.Action("VerDocumentoSolicitante", "Inspeccion", new { documentoId = doc.CodigoDocumento });
                                                    var esPdfSolicitante = string.Equals(doc.ContentType, "application/pdf", System.StringComparison.OrdinalIgnoreCase)
                                                        || string.Equals(System.IO.Path.GetExtension(doc.NombreArchivoOriginal ?? doc.NombreArchivoStorage ?? string.Empty), ".pdf", System.StringComparison.OrdinalIgnoreCase);
                                                    <a href="@urlDocSolicitante"
                                                       class="@(esPdfSolicitante ? "aocr-pdf-open" : "")"
                                                       data-pdf-url="@urlDocSolicitante"
                                                       data-title="Documento del solicitante"
                                                       data-subtitle="Archivo revisado dentro del expediente de inspección"
                                                       data-status="Documento"
                                                       target="_blank"
                                                       rel="noopener">@(doc.NombreArchivoOriginal ?? doc.NombreArchivoStorage)</a>
                                                }
                                                else
                                                {
                                                    @:(sin ruta)
                                                }
                                            </td>
                                            <td>@(doc.SubidoPorRol ?? "-")</td>
                                            <td>@(doc.Observacion ?? "-")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-light alert-inline mb-3">No existen documentos versionados para esta inspección.</div>
                    }

                    <div class="alert alert-info alert-inline mb-0">
                        El PDF del informe técnico se genera automáticamente al guardar/finalizar el informe.
                    </div>
                </div>
            </div>
        </div>

        <div class="card section-card mt-4">
            <div class="card-body">
                <div class="table-card-header flex-column flex-md-row">
                    <div>
                        <div class="section-heading mb-0">
                        <div class="section-icon">
                            <i class="fas fa-search"></i>
                        </div>
                        <div>
                            <h2 class="section-title">Hallazgos</h2>
                            <p class="section-copy">Registro de novedades, severidad y estado de seguimiento de cada hallazgo.</p>
                        </div>
                    </div>
                        <div class="hallazgos-summary">
                            <div class="hallazgos-summary-item"><i class="fas fa-layer-group"></i> @hallazgosLista.Count registrados</div>
                            <div class="hallazgos-summary-item"><i class="fas fa-shield-alt"></i> Sección crítica del proceso</div>
                        </div>
                    </div>

                    @if (puedeRegistrarHallazgo)
                    {
                        <button class="btn btn-warning" type="button" data-bs-toggle="modal" data-bs-target="#modalHallazgo">
                            <i class="fas fa-plus-circle"></i>
                            Registrar hallazgo
                        </button>
                    }
                </div>

                <div class="table-responsive hallazgos-table">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Severidad</th>
                                <th>Descripción</th>
                                <th>Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (hallazgosLista.Any())
                            {
                                foreach (var h in hallazgosLista)
                                {
                                    <tr>
                                        <td>@(h.Criticidad ?? "-")</td>
                                        <td>@(h.Descripcion ?? "-")</td>
                                        <td>@(h.Estado ?? "-")</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="3" class="hallazgos-empty hallazgos-empty-card">No hay hallazgos registrados para esta inspección.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="action-footer">
            <div>
                <span class="section-badge">Cierre operativo</span>
                <p class="section-copy mb-0 mt-2">Continúe con la planificación o ejecute el cierre institucional según su rol y el estado actual del flujo.</p>
            </div>
            @if (puedePlanificar)
            {
                <a class="btn btn-primary"
                   href="@Url.Action("Planificacion", "Inspeccion", new { id = Model.CodigoInspeccion })">
                    <i class="fas fa-calendar-alt"></i>
                    Planificar inspección
                </a>
            }

            @if (mostrarAccionesCierreDetalle && puedeCerrar)
            {
                using (Html.BeginForm("Cerrar", "Inspeccion", FormMethod.Post, new { @class = "button-flow" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.Hidden("id", Model.CodigoInspeccion)
                    <button type="submit" name="resultado" value="APROBADO" class="btn btn-success">Aprobar</button>
                    <button type="submit" name="resultado" value="RECHAZADO" class="btn btn-danger">Rechazar</button>
                }
            }
            else if (puedeGestionarCoordinacion && !esInspector && puedeCerrar)
            {
                <div class="alert alert-info mb-0" role="alert">
                    El cierre institucional de esta inspeccion se ejecuta desde
                    <a href="@Url.Action("RevisionVerificacion", "CoordinacionJefatura")" class="alert-link">Direccion / Jefatura</a>
                    para mantener una sola bandeja de decision y trazabilidad.
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var form = document.getElementById('formInformeTecnico');
            var btnPreview = document.getElementById('btnPreviewInformeTecnico');
            var viewerInline = document.getElementById('viewerInformeTecnicoDefinitivo');
            var viewerStatus = viewerInline ? viewerInline.querySelector('.aocr-pdf-status') : null;
            var viewerHelp = viewerInline ? viewerInline.querySelector('.aocr-pdf-help') : null;
            var reportPdfPath = document.getElementById('reportPdfPathInformeTecnico');
            var previewTimer = null;
            var previewInFlight = false;
            var queuedRequest = null;
            var tieneInformeDefinitivo = (form.getAttribute('data-tiene-informe') || 'false') === 'true';
            var operadorTextoInforme = form.getAttribute('data-operador-informe') || '';

            if (!form || !btnPreview) {
                return;
            }

            function syncLineCollection(container) {
                if (!container) {
                    return;
                }

                var targetId = container.getAttribute('data-lines-target');
                if (!targetId) {
                    return;
                }

                var target = document.getElementById(targetId);
                if (!target) {
                    return;
                }

                var values = [];
                Array.prototype.forEach.call(container.querySelectorAll('input[type="text"]'), function (input) {
                    var value = input && typeof input.value === 'string' ? input.value.trim() : '';
                    if (value) {
                        values.push(value);
                    }
                });

                target.value = values.join('\n');
            }

            function syncGeneratedDocumentFields() {
                Array.prototype.forEach.call(form.querySelectorAll('[data-lines-target]'), function (container) {
                    syncLineCollection(container);
                });

                var fechas = document.getElementById('fechasInspeccionManualField');
                var estaciones = document.getElementById('estacionesInspeccionManualField');
                var trabajos = document.getElementById('trabajosRealizadosField');
                var conclusion = document.getElementById('conclusionesField');
                var resultadoSeleccionado = form.querySelector('input[name="resultado"]:checked');
                var fechasTexto = fechas && fechas.value ? fechas.value.trim() : '';
                var estacionesTexto = estaciones && estaciones.value ? estaciones.value.trim() : '';

                if (trabajos) {
                    trabajos.value = 'En cumplimiento del Art. 110 del Código Aeronáutico, entre '
                        + (fechasTexto || '___________ ( fecha ) ___________')
                        + ' se realizó la inspección a la(s) estación(es) de '
                        + (estacionesTexto || '_________, ________, _____________, ____________')
                        + ' con el fin de verificar que la compañía '
                        + (operadorTextoInforme || '__________________')
                        + ' cuenta con instalaciones, facilidades y personal técnico - operativo que brinda asistencia en tierra a sus operaciones comerciales, en la(s) cual(es) se verificó lo siguiente:';
                }

                if (conclusion) {
                    if (!resultadoSeleccionado) {
                        conclusion.value = stringEmpty();
                    } else if (resultadoSeleccionado.value === 'SATISFACTORIO') {
                        conclusion.value = 'El resultado de la inspección es: Satisfactorio.';
                    } else {
                        conclusion.value = 'El resultado de la inspección es: Insatisfactorio.';
                    }
                }
            }

            function stringEmpty() {
                return '';
            }

            function syncAttachmentFileSummary(input) {
                if (!input) {
                    return;
                }

                var targetId = input.getAttribute('data-file-summary-target');
                if (!targetId) {
                    return;
                }

                var target = document.getElementById(targetId);
                if (!target) {
                    return;
                }

                var existingSummary = target.getAttribute('data-existing-summary') || '';
                var files = Array.prototype.slice.call(input.files || []);
                if (files.length === 0) {
                    target.textContent = existingSummary;
                    return;
                }

                target.textContent = 'Archivo seleccionado: ' + files.map(function (file) {
                    return file.name;
                }).join(', ');
            }

            function buildPreviewFormData(includeFiles, silent) {
                syncGeneratedDocumentFields();
                var formData = new FormData(form);

                if (!includeFiles) {
                    Array.prototype.forEach.call(form.querySelectorAll('input[type="file"]'), function (input) {
                        if (input && input.name) {
                            formData.delete(input.name);
                        }
                    });
                }

                formData.set('previewSilent', silent ? 'true' : 'false');
                return formData;
            }

            function refreshInlinePreview(result) {
                if (!viewerInline || !result || !result.pdfUrl) {
                    return;
                }

                viewerInline.setAttribute('data-pdf-url', result.pdfUrl);
                viewerInline.setAttribute('data-download-url', result.downloadUrl || result.pdfUrl);

                if (viewerStatus) {
                    viewerStatus.textContent = result.estado || 'VISTA PREVIA';
                }

                if (viewerHelp) {
                    viewerHelp.textContent = 'Vista previa del borrador actual. Se actualiza automáticamente mientras edita el informe técnico.';
                }

                if (reportPdfPath) {
                    reportPdfPath.textContent = 'Vista previa automática actualizada a las ' + new Date().toLocaleTimeString('es-EC');
                }

                if (window.AOCRPdfViewer && window.AOCRPdfViewer.instances) {
                    var viewer = window.AOCRPdfViewer.instances[viewerInline.id];
                    if (!viewer && typeof window.AOCRPdfViewer.init === 'function') {
                        window.AOCRPdfViewer.init(document);
                        viewer = window.AOCRPdfViewer.instances[viewerInline.id];
                    }

                    if (viewer && typeof viewer.load === 'function') {
                        viewer.load(result.pdfUrl);
                    }
                }
            }

            function requestPreview(options) {
                options = options || {};

                if (previewInFlight) {
                    queuedRequest = options;
                    return;
                }

                var originalHtml = btnPreview.innerHTML;
                previewInFlight = true;

                if (options.openInModal) {
                    btnPreview.disabled = true;
                    btnPreview.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i> Generando vista previa...';
                }

                fetch('@Url.Action("PrevisualizarInformeTecnico", "Inspeccion")', {
                    method: 'POST',
                    body: buildPreviewFormData(!!options.includeFiles, !!options.silent),
                    credentials: 'same-origin',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                })
                .then(function (response) {
                    if (!response.ok) {
                        throw new Error('HTTP ' + response.status);
                    }
                    return response.json();
                })
                .then(function (result) {
                    if (!result || !result.success) {
                        throw new Error(result && result.message ? result.message : 'No se pudo generar la vista previa.');
                    }

                    refreshInlinePreview(result);

                    if (options.openInModal) {
                        if (window.AOCRPdfViewer && typeof window.AOCRPdfViewer.open === 'function') {
                            window.AOCRPdfViewer.open({
                                url: result.pdfUrl,
                                downloadUrl: result.downloadUrl || result.pdfUrl,
                                title: 'Vista previa del Informe Técnico',
                                subtitle: 'Documento generado en modo borrador. No finaliza, no firma y no mueve el flujo.',
                                status: result.estado || 'VISTA PREVIA'
                            });
                        } else {
                            window.open(result.pdfUrl, '_blank', 'noopener');
                        }
                    }
                })
                .catch(function (error) {
                    if (options.silent) {
                        return;
                    }

                    var message = error && error.message ? error.message : 'No se pudo generar la vista previa del informe técnico.';
                    if (window.Swal) {
                        window.Swal.fire('Vista previa no disponible', message, 'warning');
                    } else {
                        alert(message);
                    }
                })
                .finally(function () {
                    previewInFlight = false;

                    if (options.openInModal) {
                        btnPreview.disabled = false;
                        btnPreview.innerHTML = originalHtml;
                    }

                    if (queuedRequest) {
                        var nextRequest = queuedRequest;
                        queuedRequest = null;
                        requestPreview(nextRequest);
                    }
                });
            }

            function scheduleAutoPreview(delay) {
                clearTimeout(previewTimer);
                previewTimer = window.setTimeout(function () {
                    requestPreview({ includeFiles: false, openInModal: false, silent: true });
                }, typeof delay === 'number' ? delay : 1400);
            }

            Array.prototype.forEach.call(form.querySelectorAll('input, textarea, select'), function (field) {
                if (!field || !field.name || field.disabled) {
                    return;
                }

                var tagName = (field.tagName || '').toUpperCase();
                var type = (field.type || '').toLowerCase();
                if (type === 'hidden' || type === 'submit' || type === 'button' || type === 'reset') {
                    return;
                }

                if (type === 'file') {
                    syncAttachmentFileSummary(field);
                    field.addEventListener('change', function () {
                        syncAttachmentFileSummary(field);
                        scheduleAutoPreview(500);
                    });
                    return;
                }

                if (tagName === 'SELECT' || type === 'checkbox' || type === 'radio') {
                    field.addEventListener('change', function () {
                        scheduleAutoPreview(450);
                    });
                    return;
                }

                field.addEventListener('input', function () {
                    scheduleAutoPreview();
                });

                field.addEventListener('change', function () {
                    scheduleAutoPreview(450);
                });
            });

            Array.prototype.forEach.call(form.querySelectorAll('.report-original-line-input'), function (field) {
                field.addEventListener('input', function () {
                    syncGeneratedDocumentFields();
                    scheduleAutoPreview();
                });

                field.addEventListener('change', function () {
                    syncGeneratedDocumentFields();
                    scheduleAutoPreview(450);
                });
            });

            form.addEventListener('submit', function () {
                syncGeneratedDocumentFields();
                clearTimeout(previewTimer);
            });

            btnPreview.addEventListener('click', function () {
                if (btnPreview.disabled) {
                    return;
                }

                clearTimeout(previewTimer);
                requestPreview({ includeFiles: true, openInModal: true, silent: false });
            });

            syncGeneratedDocumentFields();
            scheduleAutoPreview(tieneInformeDefinitivo ? 250 : 700);
        })();
    </script>
}


<div class="modal fade" id="modalHallazgo" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Registrar hallazgo</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                @using (Html.BeginForm("RegistrarHallazgo", "Inspeccion", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    @Html.Hidden("CodigoInspeccion", Model.CodigoInspeccion)

                    <div class="mb-3">
                        <label class="form-label d-block">Severidad</label>
                        <select name="Severidad" class="form-control" required>
                            <option value="ALTA">ALTA</option>
                            <option value="MEDIA">MEDIA</option>
                            <option value="BAJA">BAJA</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label d-block">Descripción</label>
                        <textarea name="Descripcion" class="form-control" rows="3" required></textarea>
                    </div>

                    <button class="btn btn-primary" type="submit">Guardar</button>
                }
            </div>
        </div>
    </div>
</div>
