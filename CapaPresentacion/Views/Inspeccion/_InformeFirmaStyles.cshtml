@* Estilos compartidos para paneles de firma/revisión del Informe Técnico. *@
<style>
    /* ───── Hero con pasos y estado ───── */
    .it-hero {
        position: relative;
        border-radius: 14px;
        padding: 18px 22px;
        color: #fff;
        background: linear-gradient(135deg, #0b3d78 0%, #1566b8 55%, #1e88e5 100%);
        box-shadow: 0 8px 24px rgba(11,61,120,.18);
        overflow: hidden;
        margin-bottom: 14px;
    }
    .it-hero::after {
        content: ""; position: absolute; right: -40px; top: -40px;
        width: 200px; height: 200px; border-radius: 50%;
        background: rgba(255,255,255,.06);
    }
    .it-hero-row { display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap; position: relative; z-index: 1; }
    .it-hero h3 { font-size: 1.15rem; font-weight: 700; margin: 0 0 3px; }
    .it-hero .sub { opacity: .85; font-size: .85rem; margin: 0; }

    .it-pill {
        display: inline-flex; align-items: center; gap: 7px;
        background: rgba(255,255,255,.16); backdrop-filter: blur(6px);
        padding: 7px 14px; border-radius: 999px;
        font-weight: 600; font-size: .83rem;
        border: 1px solid rgba(255,255,255,.22); color: #fff;
    }
    .it-pill.ok { background: #15a670; border-color: rgba(255,255,255,.35); box-shadow: 0 4px 12px rgba(21,166,112,.35); }
    .it-pill.warn { background: #e8a22d; color: #3a2a00; }
    .it-pill.danger { background: #d64545; }
    .it-pill.info { background: #17a2b8; }

    .it-steps {
        display: grid; grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 6px; margin-top: 12px; position: relative; z-index: 1;
    }
    @@media (max-width: 720px) { .it-steps { grid-template-columns: repeat(2, 1fr); } }
    .it-step {
        padding: 9px 12px; background: rgba(255,255,255,.10); border-radius: 8px;
        font-size: .78rem; color: rgba(255,255,255,.82);
        border-left: 3px solid rgba(255,255,255,.25);
        display: flex; align-items: center; gap: 6px;
    }
    .it-step.done { background: rgba(21,166,112,.28); border-left-color: #2ce59b; color: #fff; }
    .it-step.active { background: rgba(255,255,255,.22); border-left-color: #ffd166; color: #fff; }
    .it-step .n {
        background: rgba(0,0,0,.18); color: #fff;
        min-width: 20px; height: 20px; border-radius: 50%;
        font-size: .72rem; font-weight: 700;
        display: inline-flex; align-items: center; justify-content: center;
    }
    .it-step.done .n { background: #15a670; }
    .it-step.active .n { background: #f0a500; }

    /* ───── Panel de acción (firmar / aprobar / devolver) ───── */
    .it-panel {
        background: linear-gradient(180deg, #ffffff 0%, #f6fbff 100%);
        border: 1.5px solid #0b3d78;
        border-radius: 14px;
        padding: 18px;
        box-shadow: 0 6px 18px rgba(11,61,120,.10);
        margin-bottom: 14px;
    }
    .it-panel.coord { border-color: #17a2b8; background: linear-gradient(180deg, #fff 0%, #f2fafd 100%); }
    .it-panel.dirdac { border-color: #6f42c1; background: linear-gradient(180deg, #fff 0%, #faf5ff 100%); }
    .it-panel h4 {
        margin: 0 0 6px; font-size: 1rem; font-weight: 700; color: #0b3d78;
        display: flex; align-items: center; gap: 8px;
    }
    .it-panel.coord h4 { color: #0c6878; }
    .it-panel.dirdac h4 { color: #553399; }
    .it-panel .hint { font-size: .82rem; color: #54657c; margin: 0 0 12px; line-height: 1.4; }

    /* Campos de entrada */
    .it-field { position: relative; margin-bottom: 12px; }
    .it-field label {
        display: block; font-size: .78rem; font-weight: 600;
        color: #0b3d78; margin-bottom: 5px; letter-spacing: .2px;
    }
    .it-input {
        width: 100%; padding: 10px 40px 10px 13px;
        border: 1.5px solid #c6d4e3; border-radius: 9px;
        font-size: .92rem; font-family: inherit;
        background: #fff; transition: border-color .15s, box-shadow .15s;
    }
    .it-input[type="file"] { padding: 8px 13px; }
    .it-input:focus { outline: 0; border-color: #1566b8; box-shadow: 0 0 0 3px rgba(21,102,184,.15); }
    .it-toggle {
        position: absolute; right: 8px; top: 29px;
        background: transparent; border: 0; color: #6b7a90; cursor: pointer; padding: 5px;
    }
    .it-toggle:hover { color: #0b3d78; }

    /* Botones */
    .it-btn {
        display: inline-flex; align-items: center; gap: 8px;
        padding: 11px 18px; border-radius: 9px;
        font-size: .92rem; font-weight: 700; border: 0; cursor: pointer;
        text-decoration: none; color: #fff;
        transition: transform .12s, box-shadow .12s, background .15s;
    }
    .it-btn:hover { transform: translateY(-1px); text-decoration: none; }
    .it-btn:active { transform: translateY(0); }
    .it-btn[disabled] { opacity: .6; cursor: not-allowed; transform: none; box-shadow: none; }
    .it-btn.full { width: 100%; justify-content: center; padding: 13px 16px; font-size: .98rem; }
    .it-btn.success { background: linear-gradient(135deg, #15a670 0%, #118558 100%); box-shadow: 0 5px 14px rgba(21,166,112,.28); }
    .it-btn.success:hover { box-shadow: 0 9px 20px rgba(21,166,112,.38); }
    .it-btn.primary { background: linear-gradient(135deg, #0b3d78 0%, #1566b8 100%); box-shadow: 0 5px 14px rgba(11,61,120,.25); }
    .it-btn.primary:hover { box-shadow: 0 9px 20px rgba(11,61,120,.35); }
    .it-btn.warn { background: linear-gradient(135deg, #e8a22d 0%, #cc8619 100%); box-shadow: 0 5px 14px rgba(232,162,45,.25); color: #2d1b00; }
    .it-btn.danger { background: linear-gradient(135deg, #d64545 0%, #a92828 100%); box-shadow: 0 5px 14px rgba(214,69,69,.25); }
    .it-btn.info { background: linear-gradient(135deg, #17a2b8 0%, #127988 100%); box-shadow: 0 5px 14px rgba(23,162,184,.25); }
    .it-btn.ghost { background: #fff; color: #0b3d78; border: 1.5px solid #c6d4e3; }
    .it-btn.ghost:hover { background: #f4f8fc; }

    .it-btn-row { display: flex; gap: 8px; flex-wrap: wrap; }

    /* Info / alertas / estados */
    .it-info {
        display: flex; gap: 10px; align-items: flex-start;
        background: #eef6ff; border: 1px solid #c7def6;
        border-radius: 8px; padding: 10px 12px;
        font-size: .78rem; color: #2d4e75; margin-top: 10px; line-height: 1.4;
    }
    .it-info i { color: #1566b8; font-size: 1rem; margin-top: 1px; }

    .it-alert {
        display: flex; gap: 10px; align-items: flex-start;
        padding: 11px 14px; border-radius: 9px;
        margin-bottom: 12px; font-size: .86rem; line-height: 1.4;
    }
    .it-alert i { font-size: 1.05rem; margin-top: 1px; }
    .it-alert.success { background: #e8f8f0; color: #0c6b45; border: 1px solid #bde5d0; }
    .it-alert.warn { background: #fff5e0; color: #7a5a06; border: 1px solid #f5dd9a; }
    .it-alert.danger { background: #fdecea; color: #8a1c13; border: 1px solid #f5c2bd; }
    .it-alert.info { background: #e3f5fa; color: #0c5460; border: 1px solid #b6e3ef; }
    .it-alert.neutral { background: #f1f3f5; color: #495057; border: 1px solid #dee2e6; }

    /* Estado "firmado correctamente" */
    .it-done { text-align: center; padding: 18px 4px 4px; }
    .it-done .icon {
        width: 58px; height: 58px; line-height: 58px;
        border-radius: 50%; background: #15a670; color: #fff;
        font-size: 1.6rem; margin: 0 auto 10px;
        box-shadow: 0 6px 18px rgba(21,166,112,.35);
    }
    .it-done h5 { margin: 0 0 3px; color: #0b3d78; font-weight: 700; font-size: 1rem; }
    .it-done p { margin: 0 0 12px; color: #54657c; font-size: .82rem; }

    /* Meta info cards */
    .it-meta {
        display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
        gap: 8px; margin: 10px 0;
    }
    .it-meta-item {
        background: #fff; border: 1px solid #e4eaf2; border-radius: 8px;
        padding: 8px 11px; font-size: .82rem;
    }
    .it-meta-item .k { color: #6b7a90; font-size: .72rem; font-weight: 600; text-transform: uppercase; letter-spacing: .3px; display: block; margin-bottom: 2px; }
    .it-meta-item .v { color: #1b2a3f; font-weight: 600; }

    /* Observación devuelta */
    .it-obs {
        background: #fff8e8; border: 1px solid #ffc107; border-radius: 9px;
        padding: 11px 13px; margin-top: 10px;
    }
    .it-obs h6 { margin: 0 0 5px; color: #856404; font-weight: 700; font-size: .85rem; display: flex; align-items: center; gap: 6px; }
    .it-obs p { margin: 0; font-size: .87rem; color: #3a2a00; line-height: 1.45; }
    .it-obs small { color: #856404; font-size: .74rem; }
</style>
