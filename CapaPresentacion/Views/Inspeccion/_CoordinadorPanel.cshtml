@* Partial: Seccion del Coordinador - revision de solo lectura, aprobacion o devolucion *@
@{
    var informeTecnico = ViewBag.InformeTecnico as CapaModelo.InspeccionInformeTecnico;
    var codigoInspeccion = (int)ViewBag.CodigoInspeccion;
    var esCoordinador = (bool)(ViewBag.EsCoordinador ?? false);
    var estadoInformeTecnico = (string)ViewBag.EstadoInformeTecnico ?? "BORRADOR";
    var rutaInformeVisual = (string)ViewBag.RutaInformeVisual;
    var tieneInforme = !string.IsNullOrWhiteSpace(rutaInformeVisual);

    var enviadoACoordinador = string.Equals(estadoInformeTecnico, "ENVIADO_A_COORDINADOR", StringComparison.OrdinalIgnoreCase);
    var aprobadoCoordinacion = string.Equals(estadoInformeTecnico, "APROBADO_COORDINADOR", StringComparison.OrdinalIgnoreCase)
        || string.Equals(estadoInformeTecnico, "APROBADO_DIRECCION", StringComparison.OrdinalIgnoreCase)
        || string.Equals(estadoInformeTecnico, "FIRMADO_FINAL", StringComparison.OrdinalIgnoreCase)
        || (informeTecnico != null && informeTecnico.FirmadoDirdac);
    var puedeRevisarCoordinador = esCoordinador && informeTecnico != null && enviadoACoordinador;
}

@if ((puedeRevisarCoordinador || esCoordinador) && informeTecnico != null)
{
<div class="card section-card" style="border-left: 4px solid #17a2b8;">
    <div class="card-body">
        <div class="section-heading">
            <div class="section-icon" style="background: #17a2b8;">
                <i class="fas fa-user-tie"></i>
            </div>
            <div>
                <h2 class="section-title">Coordinador - Revision del Informe</h2>
                <p class="section-copy">Revision de solo lectura. Coordinacion puede aprobar y habilitar la firma final del inspector, o devolver con observacion obligatoria.</p>
            </div>
        </div>

        @if (enviadoACoordinador)
        {
            <div class="alert mb-3" style="background:#d1ecf1; border-left:4px solid #17a2b8; color:#0c5460; font-size:0.9rem;">
                <i class="fas fa-clipboard-check me-1"></i>
                <strong>Pendiente de revision de Coordinacion.</strong>
                El informe tecnico fue revisado por DIRDAC / Direccion - Jefatura y enviado a Coordinacion. No se permiten ediciones: solo aprobar o devolver.
            </div>
        }
        else if (string.Equals(estadoInformeTecnico, "DEVUELTO_COORDINADOR", StringComparison.OrdinalIgnoreCase))
        {
            <div class="alert mb-3" style="background:#f8d7da; border-left:4px solid #dc3545; color:#721c24; font-size:0.9rem;">
                <i class="fas fa-undo me-1"></i>
                <strong>Informe devuelto al inspector.</strong>
                Coordinacion devolvio el informe con observaciones. Pendiente de correccion y reenvio del inspector.
            </div>
        }
        else if (aprobadoCoordinacion)
        {
            <div class="alert mb-3" style="background:#d1e7dd; border-left:4px solid #198754; color:#0a3622; font-size:0.9rem;">
                <i class="fas fa-check-circle me-1"></i>
                <strong>Informe aprobado por Coordinacion.</strong>
                El informe fue aprobado y devuelto al inspector para aplicar la firma final.
            </div>
        }
        else
        {
            <div class="alert mb-3" style="background:#e2e3e5; border-left:4px solid #6c757d; color:#41464b; font-size:0.9rem;">
                <i class="fas fa-info-circle me-1"></i>
                El informe tecnico aun no ha llegado a la etapa de revision de Coordinacion.
            </div>
        }

        @if (tieneInforme)
        {
            <div class="d-flex align-items-center gap-2 mb-3">
                <a class="btn btn-sm btn-outline-primary"
                   href="@Url.Action("VerInforme", "Inspeccion", new { id = codigoInspeccion })"
                   target="_blank" rel="noopener">
                    <i class="fas fa-file-pdf me-1"></i> Ver PDF del informe (solo lectura)
                </a>
                <small class="text-muted">@rutaInformeVisual</small>
            </div>
        }

        @if (puedeRevisarCoordinador)
        {
            <div class="mt-3 p-3" style="background:#e8f4f8; border:1px solid #b8daff; border-radius:8px;" id="panelDecisionCoordinador">
                <h6 style="margin:0 0 12px 0; color:#17a2b8; font-weight:600;">
                    <i class="fas fa-clipboard-check me-1"></i> Decision de Coordinacion
                </h6>

                <div class="mb-3" id="decisionCoordBtns">
                    <p style="font-size:0.88rem; color:#555; margin-bottom:10px;">
                        Revise el informe tecnico y seleccione una accion. <strong>No puede editarlo.</strong>
                    </p>
                    <button type="button" class="btn btn-success me-2" onclick="document.getElementById('formAprobCoord').style.display='block'; this.parentElement.style.display='none';">
                        <i class="fas fa-check-circle me-1"></i> Aprobar y devolver al inspector para firma
                    </button>
                    <button type="button" class="btn btn-outline-warning" onclick="document.getElementById('formDevolCoord').style.display='block'; this.parentElement.parentElement.querySelector('#decisionCoordBtns').style.display='none';">
                        <i class="fas fa-undo me-1"></i> Devolver al inspector
                    </button>
                </div>

                <div id="formAprobCoord" style="display:none;" class="mt-2">
                    @using (Html.BeginForm("CoordinadorAprobar", "Inspeccion", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        @Html.Hidden("id", codigoInspeccion)
                        <p style="font-size:0.88rem; margin-bottom:8px;">Confirma aprobar el informe y habilitar la firma final del inspector?</p>
                        <button type="submit" class="btn btn-success me-2">
                            <i class="fas fa-check me-1"></i> Confirmar aprobacion
                        </button>
                        <button type="button" class="btn btn-outline-secondary" onclick="document.getElementById('formAprobCoord').style.display='none'; document.getElementById('decisionCoordBtns').style.display='block';">Cancelar</button>
                    }
                </div>

                <div id="formDevolCoord" style="display:none;" class="mt-2">
                    @using (Html.BeginForm("CoordinadorDevolver", "Inspeccion", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        @Html.Hidden("id", codigoInspeccion)
                        <div class="form-field mb-2">
                            <label style="font-weight:600; font-size:0.88rem;">Observacion de devolucion <span class="text-danger">*</span></label>
                            <textarea name="observacionDevolucion" class="form-control" rows="3" required
                                      placeholder="Indique la observacion por la cual devuelve el informe al inspector..."></textarea>
                        </div>
                        <button type="submit" class="btn btn-warning me-2">
                            <i class="fas fa-undo me-1"></i> Confirmar devolucion
                        </button>
                        <button type="button" class="btn btn-outline-secondary" onclick="document.getElementById('formDevolCoord').style.display='none'; document.getElementById('decisionCoordBtns').style.display='block';">Cancelar</button>
                    }
                </div>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(informeTecnico.ObservacionDevolucion))
        {
            <div class="mt-3 p-3" style="background:#fff8e8; border:1px solid #ffc107; border-radius:8px;">
                <h6 style="margin:0 0 8px 0; color:#856404; font-weight:600;">
                    <i class="fas fa-comment-dots me-1"></i> Ultima observacion de devolucion
                </h6>
                <p style="font-size:0.9rem; margin:0;">@informeTecnico.ObservacionDevolucion</p>
                @if (informeTecnico.FechaDevolucion.HasValue)
                {
                    <small class="text-muted">
                        @informeTecnico.FechaDevolucion.Value.ToString("dd/MM/yyyy HH:mm")
                        @(!string.IsNullOrWhiteSpace(informeTecnico.UsuarioDevolucion) ? " - " + informeTecnico.UsuarioDevolucion : "")
                    </small>
                }
            </div>
        }
    </div>
</div>
}
