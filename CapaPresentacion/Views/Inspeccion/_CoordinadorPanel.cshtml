@* ============================================================
   Partial: Panel Coordinador — aprobar / devolver el informe
   ============================================================ *@
@model CapaPresentacion.Models.ViewModels.CoordinadorPanelVm
@{
    var vm = Model ?? new CapaPresentacion.Models.ViewModels.CoordinadorPanelVm();
    var informeTecnico = vm.InformeTecnico;
    var codigoInspeccion = vm.CodigoInspeccion;
    var esCoordinador = vm.EsCoordinador;
    var estadoInformeTecnico = vm.EstadoInformeTecnico ?? "BORRADOR";
    var rutaInformeVisual = vm.RutaInformeVisual;
    var tieneInforme = !string.IsNullOrWhiteSpace(rutaInformeVisual);

    var enviadoACoordinador = string.Equals(estadoInformeTecnico, "ENVIADO_A_COORDINADOR", StringComparison.OrdinalIgnoreCase);
    var devueltoCoordinador = string.Equals(estadoInformeTecnico, "DEVUELTO_COORDINADOR", StringComparison.OrdinalIgnoreCase);
    var aprobadoCoordinacion = string.Equals(estadoInformeTecnico, "APROBADO_COORDINADOR", StringComparison.OrdinalIgnoreCase)
        || string.Equals(estadoInformeTecnico, "APROBADO_DIRECCION", StringComparison.OrdinalIgnoreCase)
        || string.Equals(estadoInformeTecnico, "FIRMADO_FINAL", StringComparison.OrdinalIgnoreCase)
        || (informeTecnico != null && informeTecnico.FirmadoDirdac);
    var puedeRevisarCoordinador = esCoordinador && informeTecnico != null && enviadoACoordinador;
    var urlVerPdf = codigoInspeccion > 0
        ? Url.Action("VerInforme", "Inspeccion", new { id = codigoInspeccion })
        : "#";
}

@if (codigoInspeccion <= 0)
{
    <div class="it-alert warn">
        <i class="fas fa-exclamation-triangle"></i>
        <div>No hay contexto de inspecciÃ³n disponible para la revisiÃ³n de coordinaciÃ³n.</div>
    </div>
}
else if ((puedeRevisarCoordinador || esCoordinador) && informeTecnico != null)
{
    @Html.Partial("_InformeFirmaStyles")

    <div class="it-hero" style="background: linear-gradient(135deg, #0c6878 0%, #12909f 55%, #17a2b8 100%); box-shadow: 0 8px 24px rgba(12,104,120,.22);">
        <div class="it-hero-row">
            <div>
                <h3><i class="fas fa-user-tie"></i> Revisión de Coordinación</h3>
                <p class="sub">Panel heredado para expedientes del flujo anterior. La ruta vigente ya no requiere devolución al inspector para firma final.</p>
            </div>
            <div>
                @if (aprobadoCoordinacion)
                { <span class="it-pill ok"><i class="fas fa-check-circle"></i> Aprobado</span> }
                else if (devueltoCoordinador)
                { <span class="it-pill danger"><i class="fas fa-undo"></i> Devuelto</span> }
                else if (enviadoACoordinador)
                { <span class="it-pill warn"><i class="fas fa-hourglass-half"></i> Pendiente</span> }
                else
                { <span class="it-pill"><i class="fas fa-circle-notch"></i> Sin enviar</span> }
            </div>
        </div>
    </div>

    if (enviadoACoordinador)
    {
        <div class="it-alert info">
            <i class="fas fa-clipboard-check"></i>
            <div><strong>Pendiente de revisión de Coordinación.</strong> Este estado corresponde a expedientes heredados que aún no han migrado al flujo institucional final directo con DIRDAC.</div>
        </div>
    }
    else if (devueltoCoordinador)
    {
        <div class="it-alert danger">
            <i class="fas fa-undo"></i>
            <div><strong>Informe devuelto al inspector.</strong> Pendiente de corrección y reenvío del inspector.</div>
        </div>
    }
    else if (aprobadoCoordinacion)
    {
        <div class="it-alert success">
            <i class="fas fa-check-circle"></i>
            <div><strong>Informe aprobado por Coordinación.</strong> Estado heredado del flujo anterior.</div>
        </div>
    }
    else
    {
        <div class="it-alert neutral">
            <i class="fas fa-info-circle"></i>
            <div>El informe técnico aún no ha llegado a la etapa de revisión de Coordinación.</div>
        </div>
    }

    if (tieneInforme)
    {
        <div class="it-btn-row" style="margin-bottom: 12px;">
            <a class="it-btn ghost" href="@urlVerPdf" target="_blank" rel="noopener">
                <i class="fas fa-file-pdf"></i> Ver PDF del informe
            </a>
        </div>
    }

    if (puedeRevisarCoordinador)
    {
        <div class="it-panel coord">
            <h4><i class="fas fa-balance-scale"></i> Decisión de Coordinación</h4>
            <p class="hint">Revise el informe técnico y seleccione una acción. <strong>Este panel solo aplica a expedientes heredados.</strong></p>

            <div id="coordDecisionBtns" class="it-btn-row">
                <button type="button" class="it-btn success"
                        onclick="itCoordMostrar('coordFormAprob')">
                    <i class="fas fa-check-circle"></i> Aprobar y remitir a DIRDAC
                </button>
                <button type="button" class="it-btn warn"
                        onclick="itCoordMostrar('coordFormDevol')">
                    <i class="fas fa-undo"></i> Devolver con observación
                </button>
            </div>

            <div id="coordFormAprob" style="display:none; margin-top: 14px;">
                @using (Html.BeginForm("CoordinadorAprobar", "Inspeccion", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@codigoInspeccion" />
                    <div class="it-alert success" style="margin-bottom: 10px;">
                        <i class="fas fa-question-circle"></i>
                        <div>¿Confirma aprobar el informe y remitirlo a DIRDAC / Dirección - Jefatura?</div>
                    </div>
                    <div class="it-btn-row">
                        <button type="submit" class="it-btn success"><i class="fas fa-check"></i> Confirmar aprobación</button>
                        <button type="button" class="it-btn ghost" onclick="itCoordCancelar()">Cancelar</button>
                    </div>
                }
            </div>

            <div id="coordFormDevol" style="display:none; margin-top: 14px;">
                @using (Html.BeginForm("CoordinadorDevolver", "Inspeccion", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@codigoInspeccion" />
                    <div class="it-field">
                        <label>Observación de devolución <span style="color:#d64545;">*</span></label>
                        <textarea name="observacionDevolucion" class="it-input" rows="3" required="required"
                                  placeholder="Indique la observación por la cual devuelve el informe al inspector..."></textarea>
                    </div>
                    <div class="it-btn-row">
                        <button type="submit" class="it-btn warn"><i class="fas fa-undo"></i> Confirmar devolución</button>
                        <button type="button" class="it-btn ghost" onclick="itCoordCancelar()">Cancelar</button>
                    </div>
                }
            </div>
        </div>

        <script>
            function itCoordMostrar(id) {
                document.getElementById('coordDecisionBtns').style.display = 'none';
                document.getElementById('coordFormAprob').style.display = id === 'coordFormAprob' ? 'block' : 'none';
                document.getElementById('coordFormDevol').style.display = id === 'coordFormDevol' ? 'block' : 'none';
            }
            function itCoordCancelar() {
                document.getElementById('coordFormAprob').style.display = 'none';
                document.getElementById('coordFormDevol').style.display = 'none';
                document.getElementById('coordDecisionBtns').style.display = 'flex';
            }
        </script>
    }

    if (!string.IsNullOrWhiteSpace(informeTecnico.ObservacionDevolucion))
    {
        <div class="it-obs">
            <h6><i class="fas fa-comment-dots"></i> Última observación de devolución</h6>
            <p>@informeTecnico.ObservacionDevolucion</p>
            @if (informeTecnico.FechaDevolucion.HasValue)
            {
                <small>
                    @informeTecnico.FechaDevolucion.Value.ToString("dd/MM/yyyy HH:mm")
                    @(!string.IsNullOrWhiteSpace(informeTecnico.UsuarioDevolucion) ? " · " + informeTecnico.UsuarioDevolucion : "")
                </small>
            }
        </div>
    }
}
