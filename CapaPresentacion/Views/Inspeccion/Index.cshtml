@model IEnumerable<CapaModelo.Inspeccion>

<h2>Inspecciones</h2>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Solicitud</th>
            <th>Inspector</th>
            <th>Fecha Programada</th>
            <th>Estado</th>
            <th>Opciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var i in Model)
        {
            <tr>
                <td>@i.CodigoSolicitud</td>
                <td>@i.NombreInspector</td>
                <td>
                    @(i.FechaProgramada.HasValue
                                ? i.FechaProgramada.Value.ToString("yyyy-MM-dd")
                                : "-")
                </td>
                <td>@i.Estado</td>
                <td>
                    <a href="@Url.Action("Detalle", "Inspeccion", new { id = i.CodigoInspeccion })"
                       class="btn btn-info btn-sm">
                        Ver
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
