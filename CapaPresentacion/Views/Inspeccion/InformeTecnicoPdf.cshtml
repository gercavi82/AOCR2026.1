@model CapaPresentacion.Models.ViewModels.InformeTecnicoPdfViewModel
@using System
@using System.Collections.Generic
@using System.Globalization
@using System.Linq
@using System.Web
@using CapaPresentacion.Helpers

@{
    Layout = "~/Views/Shared/_PdfLayoutDGACAocr.cshtml";

    var inspeccion = Model != null ? Model.Inspeccion : null;
    var solicitud = Model != null ? Model.Solicitud : null;
    var informe = Model != null ? Model.Informe : null;
    var esVistaPrevia = Model != null && Model.EsVistaPrevia;
    var mostrarMarcaAguaBorrador = Model != null && Model.MostrarMarcaAguaBorrador;
    var mostrarFirmas = Model == null || Model.MostrarFirmas;
    var mostrarFirmaDirector = Model != null && Model.MostrarFirmaDirector;
    var cultura = new CultureInfo("es-EC");

    var textoNoAplica = "No aplica";
    Func<string, string, string> textoDocumento = (value, fallback) => !string.IsNullOrWhiteSpace(value) ? value.Trim() : fallback;
    Func<string, IList<string>> obtenerItemsOTextoNoAplica = value =>
    {
        var items = InformeTecnicoTemplateHelper.SplitLines(value).ToList();
        return items.Any() ? items : new List<string> { textoNoAplica };
    };

    var inspectorPrincipalNombre = inspeccion != null ? (inspeccion.InspectorPrincipalNombre ?? string.Empty).Trim() : string.Empty;
    if (string.IsNullOrWhiteSpace(inspectorPrincipalNombre) && solicitud != null)
    {
        inspectorPrincipalNombre = (solicitud.TecnicoResponsableNombre ?? string.Empty).Trim();
    }

    var inspectorPrincipalCedula = inspeccion != null ? (inspeccion.InspectorPrincipalCedula ?? string.Empty).Trim() : string.Empty;
    if (string.IsNullOrWhiteSpace(inspectorPrincipalCedula) && solicitud != null)
    {
        inspectorPrincipalCedula = (solicitud.TecnicoResponsableCedula ?? string.Empty).Trim();
    }

    if (string.IsNullOrWhiteSpace(inspectorPrincipalCedula) && inspeccion != null && inspeccion.CodigoInspector.HasValue)
    {
        inspectorPrincipalCedula = inspeccion.CodigoInspector.Value.ToString();
    }

    var inspector = !string.IsNullOrWhiteSpace(inspectorPrincipalNombre)
        ? (string.IsNullOrWhiteSpace(inspectorPrincipalCedula) || string.Equals(inspectorPrincipalNombre, inspectorPrincipalCedula, StringComparison.OrdinalIgnoreCase)
            ? inspectorPrincipalNombre
            : inspectorPrincipalNombre + " - " + inspectorPrincipalCedula)
        : (!string.IsNullOrWhiteSpace(inspectorPrincipalCedula) ? inspectorPrincipalCedula : null);

    var numeroInspeccion = inspeccion != null
        ? (!string.IsNullOrWhiteSpace(inspeccion.NumeroInspeccion) ? inspeccion.NumeroInspeccion : inspeccion.CodigoInspeccion.ToString())
        : null;
    var operador = solicitud != null ? solicitud.NombreOperador : null;
    var licenciaInspector = informe != null && !string.IsNullOrWhiteSpace(informe.NumeroLicenciaInspector)
        ? informe.NumeroLicenciaInspector
        : (inspeccion != null && !string.IsNullOrWhiteSpace(inspeccion.InspectorPrincipalCedula)
            ? inspeccion.InspectorPrincipalCedula
            : (solicitud != null ? solicitud.TecnicoResponsableCedula : null));
    var fechaProgramada = inspeccion != null ? inspeccion.FechaProgramada : null;
    var resultadoTecnico = !string.IsNullOrWhiteSpace(informe != null ? informe.Resultado : null)
        ? informe.Resultado
        : (inspeccion != null ? inspeccion.Resultado : null);
    var notas = informe != null ? informe.Notas : null;
    var noConformidades = informe != null && !string.IsNullOrWhiteSpace(informe.NoConformidades)
        ? informe.NoConformidades
        : (informe != null ? informe.Observaciones : null);
    var recomendaciones = informe != null ? informe.Recomendaciones : null;
    var fechasInspeccionManual = informe != null ? informe.FechasInspeccionManual : null;
    var estacionesInspeccionManual = informe != null ? informe.EstacionesInspeccionManual : null;
    var servicios = InformeTecnicoTemplateHelper.GetServicioRows(informe != null ? informe.ServiciosEstaciones : null);
    var documentosAdjuntosSeleccionados = InformeTecnicoTemplateHelper.SplitLines(informe != null ? informe.DocumentosAdjuntos : null);
    var documentosAdjuntosArchivos = InformeTecnicoTemplateHelper.ParseDocumentosAdjuntosArchivos(informe != null ? informe.DocumentosAdjuntosArchivos : null);
    var firmadoInspector = informe != null && informe.FirmadoInspector;
    var firmanteInspector = informe != null && !string.IsNullOrWhiteSpace(informe.UsuarioFirma1) ? informe.UsuarioFirma1 : null;

    var fechaInspeccionTexto = !string.IsNullOrWhiteSpace(fechasInspeccionManual)
        ? fechasInspeccionManual.Trim()
        : (fechaProgramada.HasValue ? fechaProgramada.Value.ToString("dd/MM/yyyy", cultura) : textoNoAplica);
    var estacionesTextoArt110 = !string.IsNullOrWhiteSpace(estacionesInspeccionManual)
        ? estacionesInspeccionManual.Trim()
        : textoNoAplica;
    var notasItems = obtenerItemsOTextoNoAplica(notas);
    var noConformidadesItems = obtenerItemsOTextoNoAplica(noConformidades);
    var recomendacionesItems = obtenerItemsOTextoNoAplica(recomendaciones);
    var otrosAdjuntosItems = obtenerItemsOTextoNoAplica(informe != null ? informe.OtrosAdjuntos : null);
    var documentosAdjuntosItems = documentosAdjuntosSeleccionados.Any()
        ? documentosAdjuntosSeleccionados.Select(item =>
        {
            string archivoAdjunto;
            return documentosAdjuntosArchivos.TryGetValue(item, out archivoAdjunto) && !string.IsNullOrWhiteSpace(archivoAdjunto)
                ? item + " (" + archivoAdjunto + ")"
                : item;
        }).ToList()
        : new List<string> { textoNoAplica };

    var resultadoNormalizado = string.IsNullOrWhiteSpace(resultadoTecnico) ? string.Empty : resultadoTecnico.Trim().ToUpperInvariant();
    var esResultadoSatisfactorio = resultadoNormalizado == "SATISFACTORIO" || resultadoNormalizado == "SAT";
    var esResultadoInsatisfactorio = resultadoNormalizado == "NO_SATISFACTORIO" || resultadoNormalizado == "INSATISFACTORIO";
    var nombreInspectorFirma = firmadoInspector && !string.IsNullOrWhiteSpace(firmanteInspector) ? firmanteInspector : inspector;
    var nombreInspectorVisual = !string.IsNullOrWhiteSpace(nombreInspectorFirma) ? nombreInspectorFirma.Trim().ToUpperInvariant() : textoNoAplica.ToUpperInvariant();
    var licenciaInspectorVisual = !string.IsNullOrWhiteSpace(licenciaInspector) ? "No. LICENCIA " + licenciaInspector.Trim() : textoNoAplica.ToUpperInvariant();
}

@section PdfHead {
    <style>
        body { font-family: Arial, Helvetica, sans-serif; font-size: 10pt; color: #111; }
        .preview-watermark { position: fixed; top: 42%; left: 8%; right: 8%; z-index: 0; color: rgba(180, 120, 20, .12); font-size: 42pt; font-weight: bold; text-align: center; transform: rotate(-24deg); text-transform: uppercase; }
        .report-flow { position: relative; z-index: 1; }
        .report-sheet { border: 1px solid #222; padding: 20px 24px 24px; }
        .report-header { text-align: center; margin-bottom: 18px; }
        .report-header p, .report-header h1 { margin: 0; }
        .report-annex { font-weight: bold; font-size: 10pt; text-transform: uppercase; }
        .report-entity { margin-top: 6px; font-weight: bold; font-size: 11pt; text-transform: uppercase; }
        .report-title { margin-top: 6px; font-weight: bold; font-size: 13pt; text-transform: uppercase; }
        .report-order { margin-bottom: 14px; font-size: 10pt; }
        .report-section-title { margin: 16px 0 8px; font-weight: bold; font-size: 10.5pt; text-transform: uppercase; }
        .report-paragraph { margin: 0 0 10px; line-height: 1.75; text-align: justify; }
        .report-paragraph.compact { margin-bottom: 6px; }
        .fill-inline { display: inline-block; min-width: 160px; padding: 0 4px 2px; border-bottom: 1px solid #222; font-weight: bold; text-align: center; }
        .fill-inline.wide { min-width: 240px; }
        .coverage-table { width: 100%; border-collapse: collapse; margin-top: 8px; }
        .coverage-table th, .coverage-table td { border: 1px solid #222; padding: 6px; vertical-align: middle; }
        .coverage-table th { text-align: center; background: #f3f3f3; font-size: 8.6pt; }
        .coverage-table td { font-size: 8.6pt; }
        .coverage-table .service-name { width: 38%; font-weight: bold; }
        .bullet-list, .dash-list { margin: 6px 0 0; padding-left: 0; list-style: none; }
        .bullet-list li, .dash-list li { margin-bottom: 4px; line-height: 1.55; }
        .result-list li.selected { font-weight: bold; text-decoration: underline; }
        .documents-block { margin-top: 14px; }
        .signature-block { margin-top: 26px; text-align: center; page-break-inside: avoid; break-inside: avoid; }
        .signature-slot { width: 420px; max-width: 100%; height: 122px; margin: 0 auto 10px; border: 1px solid #d3d3d3; background: #f9f9f9; position: relative; overflow: hidden; text-align: left; }
        .signature-name, .signature-license, .signature-role, .signature-specialty { margin: 3px 0; font-weight: bold; text-transform: uppercase; }
        .signature-role, .signature-specialty { font-size: 9pt; }
        .firma-anchor, .hidden-anchor { font-size: 1px; line-height: 1px; color: transparent; display: block; overflow: hidden; }
        .firma-anchor { position: absolute; left: 0; top: 0; width: 1px; height: 1px; text-align: left; white-space: nowrap; }
        .hidden-anchor { height: 1px; }
    </style>
}

@if (mostrarMarcaAguaBorrador)
{
    <div class="preview-watermark">BORRADOR / VISTA PREVIA</div>
}

<div class="report-flow">
    <div class="report-sheet">
        <div class="report-header">
            <p class="report-annex">ANEXO 1</p>
            <p class="report-entity">DIRECCION INSPECCION Y CERTIFICACION AERONAUTICA</p>
            <h1 class="report-title">INFORME DE INSPECCION</h1>
        </div>

        <div class="report-order">
            <strong>ORDEN DE INSPECCION:</strong>
            <span class="fill-inline wide">@textoDocumento(numeroInspeccion, textoNoAplica)</span>
        </div>

        <div class="report-section-title">TRABAJOS REALIZADOS:</div>
        <p class="report-paragraph">
            En cumplimiento del Art. 110 del Código Aeronáutico, entre
            <span class="fill-inline">@fechaInspeccionTexto</span>
            se realizó la inspección a la(s) estación(es) de
            <span class="fill-inline wide">@estacionesTextoArt110</span>
            con el fin de verificar que la compañía
            <span class="fill-inline wide">@textoDocumento(operador, textoNoAplica)</span>
            cuenta con instalaciones, facilidades y personal técnico - operativo que brinda asistencia en tierra a sus operaciones comerciales, en la(s) cual(es) se verificó lo siguiente:
        </p>

        <p class="report-paragraph">La operación comercial de <span class="fill-inline wide">@textoDocumento(operador, textoNoAplica)</span> será asistida por:</p>

        <table class="coverage-table">
            <thead>
                <tr>
                    <th class="service-name"></th>
                    <th>UIO</th>
                    <th>GYE</th>
                    <th>MEC</th>
                    <th>LTX</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var fila in servicios)
                {
                    <tr>
                        <td class="service-name">@fila.Label</td>
                        <td>@(string.IsNullOrWhiteSpace(fila.Uio) ? string.Empty : fila.Uio)</td>
                        <td>@(string.IsNullOrWhiteSpace(fila.Gye) ? string.Empty : fila.Gye)</td>
                        <td>@(string.IsNullOrWhiteSpace(fila.Mec) ? string.Empty : fila.Mec)</td>
                        <td>@(string.IsNullOrWhiteSpace(fila.Ltx) ? string.Empty : fila.Ltx)</td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="report-section-title">Notas:</div>
        <ul class="bullet-list">
            @foreach (var item in notasItems)
            {
                <li>@item</li>
            }
        </ul>

        <div class="report-section-title">No Conformidades:</div>
        <ul class="bullet-list">
            @foreach (var item in noConformidadesItems)
            {
                <li>@item</li>
            }
        </ul>

        <div class="report-section-title">2. CONCLUSION</div>
        <p class="report-paragraph compact">El resultado de la inspección es:</p>
        <ul class="bullet-list result-list">
            <li class="@(esResultadoSatisfactorio ? "selected" : string.Empty)">Satisfactorio</li>
            <li class="@(esResultadoInsatisfactorio ? "selected" : string.Empty)">Insatisfactorio.</li>
        </ul>

        <div class="report-section-title">3. RECOMENDACIONES:</div>
        <ul class="bullet-list">
            @foreach (var item in recomendacionesItems)
            {
                <li>@item</li>
            }
        </ul>

        <div class="report-section-title documents-block">DOCUMENTOS ADJUNTOS:</div>
        <ul class="bullet-list">
            @foreach (var documento in documentosAdjuntosItems)
            {
                <li>@documento</li>
            }
            <li>
                OTROS:
                <ul class="dash-list">
                    @foreach (var item in otrosAdjuntosItems)
                    {
                        <li>@item</li>
                    }
                </ul>
            </li>
        </ul>

        <div class="signature-block">
            <div class="signature-slot" data-firma-rol="INFORME_TECNICO_INSPECTOR">
                @if (mostrarFirmas)
                {
                    <span class="firma-anchor">ANCLA_FIRMA_INSPECTOR_DGAC</span>
                }
            </div>
            <div class="signature-name">@nombreInspectorVisual</div>
            <div class="signature-license">@licenciaInspectorVisual</div>
            <div class="signature-role">FIRMA DEL TÉCNICO / INSPECTOR RESPONSABLE</div>
            <div class="signature-specialty">Nombre: @nombreInspectorVisual &nbsp; Cargo: TECNICO / INSPECTOR DGAC &nbsp; Fecha: @(informe != null && informe.FechaFirma1.HasValue ? informe.FechaFirma1.Value.ToString("dd/MM/yyyy", cultura) : textoNoAplica)</div>
        </div>

        @if (mostrarFirmas && mostrarFirmaDirector)
        {
            <div class="hidden-anchor">
                <span>ANCLA_FIRMA_DIRDAC_JEFATURA</span>
                <span>FIRMA DEL DIRECTOR / JEFATURA</span>
            </div>
        }
    </div>
</div>
