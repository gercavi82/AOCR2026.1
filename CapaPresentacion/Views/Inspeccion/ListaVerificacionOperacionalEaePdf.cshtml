@inherits System.Web.Mvc.WebViewPage<CapaPresentacion.Models.ViewModels.ListaVerificacionOperacionalEaePdfViewModel>
@using System
@using System.Collections.Generic
@using System.Globalization
@using System.Linq
@using CapaModelo

@functions {
    private static int CompararItemsPorOrden(ListaVerificacionOperacionalEaeItem izquierda, ListaVerificacionOperacionalEaeItem derecha)
    {
        var ordenIzquierda = izquierda != null ? izquierda.Orden : int.MaxValue;
        var ordenDerecha = derecha != null ? derecha.Orden : int.MaxValue;
        return ordenIzquierda.CompareTo(ordenDerecha);
    }

    private static List<ListaVerificacionOperacionalEaeItem> ConstruirItemsOrdenados(IEnumerable<ListaVerificacionOperacionalEaeItem> itemsOrigen)
    {
        var items = new List<ListaVerificacionOperacionalEaeItem>();
        if (itemsOrigen != null)
        {
            foreach (var item in itemsOrigen)
            {
                if (item != null)
                {
                    items.Add(item);
                }
            }
        }

        items.Sort(CompararItemsPorOrden);
        return items;
    }

    private static List<List<ListaVerificacionOperacionalEaeItem>> ConstruirGruposItems(IEnumerable<ListaVerificacionOperacionalEaeItem> itemsOrdenados)
    {
        var grupos = new SortedDictionary<int, List<ListaVerificacionOperacionalEaeItem>>();
        if (itemsOrdenados != null)
        {
            foreach (var item in itemsOrdenados)
            {
                if (item == null)
                {
                    continue;
                }

                var claveGrupo = item.GrupoRequisitoId > 0 ? item.GrupoRequisitoId : item.Orden;
                List<ListaVerificacionOperacionalEaeItem> grupoActual;
                if (!grupos.TryGetValue(claveGrupo, out grupoActual))
                {
                    grupoActual = new List<ListaVerificacionOperacionalEaeItem>();
                    grupos.Add(claveGrupo, grupoActual);
                }

                grupoActual.Add(item);
            }
        }

        var resultado = new List<List<ListaVerificacionOperacionalEaeItem>>();
        foreach (var grupo in grupos)
        {
            grupo.Value.Sort(CompararItemsPorOrden);
            resultado.Add(grupo.Value);
        }

        return resultado;
    }

    private static string TextoVisible(string value)
    {
        return !string.IsNullOrWhiteSpace(value) ? value.Trim() : "No registra";
    }

    private static string CheckEstado(string actual, string esperado)
    {
        return string.Equals((actual ?? string.Empty).Trim(), esperado, StringComparison.OrdinalIgnoreCase) ? "☒" : "☐";
    }

    private static int CalcularLongitudOrientacion(IEnumerable<ListaVerificacionOperacionalEaeItem> items)
    {
        var total = 0;
        if (items != null)
        {
            foreach (var item in items)
            {
                total += ((item != null ? item.OrientacionEvidencia : null) ?? string.Empty).Length;
            }
        }

        return total;
    }
}

@{
    Layout = "~/Views/Shared/_PdfLayoutDGACAocr.cshtml";

    var lista = Model != null ? Model.ListaVerificacion : null;
    var items = lista != null ? ConstruirItemsOrdenados(lista.Items) : new List<ListaVerificacionOperacionalEaeItem>();
    var gruposItems = ConstruirGruposItems(items);
    var cultura = new CultureInfo("es-EC");
    var fechaLista = lista != null && lista.FechaLista.HasValue ? lista.FechaLista.Value.ToString("dd/MM/yyyy", cultura) : DateTime.Now.ToString("dd/MM/yyyy", cultura);
    Func<string, string> texto = TextoVisible;
    Func<string, string, string> check = CheckEstado;
}

@section PdfHead {
    <style>
        @@page { size: A4 portrait; }
        html, body { margin: 0; padding: 0; font-family: Arial, Helvetica, sans-serif; font-size: 8px; line-height: 1.25; }
        body { color: #111; }
        .pdf-lv-eae { width: 100%; margin: 0; padding: 0; }
        .pdf-content { width: 100%; padding-top: 6px; padding-bottom: 12px; box-sizing: border-box; }
        .manual-top { width: 100%; border-collapse: collapse; margin-bottom: 4px; font-size: 6.5pt; color: #333; }
        .manual-top td { vertical-align: top; border: none; padding: 0; }
        .manual-right { text-align: right; }
        .institution { text-align: center; font-weight: bold; text-transform: uppercase; font-size: 10pt; line-height: 1.25; margin-top: 4px; }
        .title { text-align: center; font-weight: bold; font-size: 9pt; line-height: 1.25; margin-top: 4px; }
        .rdac { text-align: center; font-weight: bold; margin: 3px 0 6px; font-size: 9pt; }
        .meta-list { width: 100%; border-collapse: collapse; margin: 0 0 4px; }
        .meta-list td { border: none; padding: 1.5px 2px; vertical-align: top; line-height: 1.25; }
        .meta-label { width: 35%; font-weight: bold; }
        .meta-value { border-bottom: 1px solid #222 !important; min-height: 12px; }
        .pdf-table-wrapper { margin-top: 10px; }
        .lv-table { width: 100%; border-collapse: collapse; table-layout: fixed; page-break-inside: auto; font-size: 7.8px; line-height: 1.18; }
        .lv-table thead { display: table-header-group; }
        .lv-table tfoot { display: table-footer-group; }
        .lv-table tr { page-break-after: auto; }
        .lv-table tr.keep-together { page-break-inside: avoid; }
        .lv-table tr.allow-break { page-break-inside: auto !important; }
        .lv-table th, .lv-table td { border: 1px solid #222; padding: 4px; vertical-align: top; white-space: normal; word-break: normal; overflow-wrap: break-word; }
        .lv-table thead tr:first-child th { padding-top: 8px; padding-bottom: 6px; }
        .lv-table th { text-align: center; font-weight: bold; background: #d9d9d9; }
        .cell-pre { white-space: pre-line; overflow-wrap: break-word; word-break: normal; }
        .checks div { display: block; margin-bottom: 2px; white-space: nowrap; line-height: 1.35; }
        .code { font-weight: bold; display: block; margin-bottom: 2px; }
        .continuation-label { display: block; color: #666; font-size: 7px; font-style: italic; line-height: 1.2; }
        .group-continuation { background: #fafafa; }
        .question-note { margin-top: 4px; padding-top: 4px; border-top: 1px dashed #666; font-style: italic; }
        .guidance-stack { display: block; }
        .guidance-entry { display: block; white-space: pre-line; line-height: 1.25; text-align: justify; }
        .guidance-entry + .guidance-entry { border-top: 1px solid #ddd; padding-top: 4px; margin-top: 4px; }
        .orientation-subnumeral { font-weight: bold; }
        .orientation-literal { padding-left: 10px; }
        .orientation-note { font-style: italic; background: #fafafa; }
        .footer-safe-space { height: 20px; }
        .signature-block { margin-top: 20px; margin-bottom: 20px; padding-top: 10px; page-break-inside: avoid; break-inside: avoid; text-align: center; }
        .signature-title { font-weight: bold; text-transform: uppercase; margin-bottom: 8px; }
        .signature-slot { width: 360px; min-height: 90px; margin: 0 auto 8px; border: 1px dashed #777; position: relative; text-align: center; padding-top: 30px; box-sizing: border-box; color: #666; }
        .firma-anchor { position: absolute; left: 0; top: 0; width: 1px; height: 1px; overflow: hidden; color: transparent; font-size: 1px; line-height: 1px; }
        .signature-data { width: 70%; margin: 0 auto; border-collapse: collapse; }
        .signature-data td { border: none; padding: 3px 4px; text-align: left; }
        .line { border-bottom: 1px solid #222 !important; }
        .footer-line { margin-top: 8px; width: 100%; font-size: 6.5pt; color: #333; }
    </style>
}

<div class="pdf-lv-eae">
<div class="pdf-content">
    <table class="manual-top">
        <tr>
            <td>Parte II - Explotadores de servicios aereos<br />Volumen VII - Vigilancia de explotadores extranjeros en operaciones de transporte aereo comercial</td>
            <td class="manual-right">Capitulo 2 - Solicitud, evaluacion y aprobacion de un explotador extranjero<br />Manual del Inspector de Operaciones Ecuador</td>
        </tr>
    </table>

    <div class="institution">DIRECCIÓN GENERAL DE AVIACIÓN CIVIL</div>
    <div class="title">
        LISTA DE VERIFICACIÓN (LV)<br />
        EVALUACIÓN TÉCNICA DE UN EXPLOTADOR DE SERVICIOS AÉREOS EXTRANJERO (EAE)
    </div>
    <div class="rdac">RDAC 129</div>

    <table class="meta-list">
        <tr><td class="meta-label">1. Nombre del EAE / Nombre comercial del EAE:</td><td class="meta-value">@texto(lista != null ? lista.NombreEae : null)</td></tr>
        <tr><td class="meta-label">2. N AOC / Fecha de expedicion / Validez:</td><td class="meta-value">@texto(lista != null ? lista.NumeroAocFechaValidez : null)</td></tr>
        <tr><td class="meta-label">3. Direccion del EAE y datos de contacto de la gerencia de operaciones en el Estado del explotador:</td><td class="meta-value">@texto(lista != null ? lista.DireccionEstadoExplotador : null)</td></tr>
        <tr><td class="meta-label">4. Direccion del EAE y datos de contacto en el Estado que emite el reconocimiento:</td><td class="meta-value">@texto(lista != null ? lista.DireccionEstadoReconocimiento : null)</td></tr>
        <tr><td class="meta-label">5. Tipo/s de aeronave/s (marca, modelo, numero de serie):</td><td class="meta-value">@texto(lista != null ? lista.TiposAeronaves : null)</td></tr>
        <tr><td class="meta-label">6. Tipo de operacion:</td><td class="meta-value">@texto(lista != null ? lista.TipoOperacion : null)</td></tr>
        <tr><td class="meta-label">7. Fecha:</td><td class="meta-value">@fechaLista</td></tr>
        <tr><td class="meta-label">8. Inspector responsable de la aprobación:</td><td class="meta-value">@texto(lista != null ? lista.InspectorResponsable : null)</td></tr>
    </table>

    <div class="pdf-table-wrapper">
    <table class="lv-table">
        <colgroup>
            <col style="width: 11%;" />
            <col style="width: 18%;" />
            <col style="width: 13%;" />
            <col style="width: 30%;" />
            <col style="width: 13%;" />
            <col style="width: 15%;" />
        </colgroup>
        <thead>
            <tr>
                <th>9.<br />Referencia</th>
                <th>10.<br />Pregunta del requisito</th>
                <th>11.<br />Estado de cumplimiento del requisito</th>
                <th>12.<br />Orientacion para el examen de pruebas o evidencias</th>
                <th>13.<br />Estado de implementacion</th>
                <th>14.<br />Pruebas / Notas / Comentarios</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var grupo in gruposItems)
            {
                var itemCabecera = grupo.First();
                var filasGrupo = new List<List<ListaVerificacionOperacionalEaeItem>>();
                List<ListaVerificacionOperacionalEaeItem> filaActual = null;
                foreach (var itemGrupo in grupo)
                {
                    if (filaActual == null || !itemGrupo.EsNotaOrientacion)
                    {
                        filaActual = new List<ListaVerificacionOperacionalEaeItem> { itemGrupo };
                        filasGrupo.Add(filaActual);
                    }
                    else
                    {
                        filaActual.Add(itemGrupo);
                    }
                }

                for (var indice = 0; indice < filasGrupo.Count; indice++)
                {
                    var filaGrupo = filasGrupo[indice];
                    var item = filaGrupo.First();
                    var longitudOrientacion = CalcularLongitudOrientacion(filaGrupo);
                    var longitudComentarios = (item.PruebasNotasComentarios ?? string.Empty).Length;
                    var rowClass = (longitudOrientacion > 350 || longitudComentarios > 220) ? "allow-break" : "keep-together";
                    var esPrimeraFilaGrupo = indice == 0;
                    <tr class="@rowClass">
                        <td class="cell-pre @(esPrimeraFilaGrupo ? string.Empty : "group-continuation")">@texto(itemCabecera.Referencia)</td>
                        <td class="cell-pre @(esPrimeraFilaGrupo ? string.Empty : "group-continuation")">
                            <span class="code">@texto(!string.IsNullOrWhiteSpace(itemCabecera.CodigoPregunta) ? itemCabecera.CodigoPregunta : itemCabecera.Codigo)</span>
                            @if (esPrimeraFilaGrupo)
                            {
                                @texto(itemCabecera.PreguntaRequisito)
                                if (!string.IsNullOrWhiteSpace(itemCabecera.NotaPregunta))
                                {
                                    <div class="question-note">Nota: @texto(itemCabecera.NotaPregunta)</div>
                                }
                            }
                            else
                            {
                                <span class="continuation-label">Continuacion del requisito</span>
                            }
                        </td>
                        <td class="checks">
                            <div>@check(item.EstadoCumplimiento, "SATISFACTORIO") Satisfactorio</div>
                            <div>@check(item.EstadoCumplimiento, "NO_SATISFACTORIO") No satisfactorio</div>
                            <div>@check(item.EstadoCumplimiento, "NO_APLICABLE") No aplicable</div>
                        </td>
                        <td class="cell-pre">
                            <div class="guidance-stack">
                                @foreach (var orientacion in filaGrupo)
                                {
                                    <div class="guidance-entry @(orientacion.EsNotaOrientacion ? "orientation-note" : orientacion.EsLiteral ? "orientation-literal" : orientacion.EsSubnumeral ? "orientation-subnumeral" : string.Empty)">@orientacion.OrientacionEvidencia</div>
                                }
                            </div>
                        </td>
                        <td class="checks">
                            <div>@check(item.EstadoImplementacion, "IMPLEMENTADO") Implementado</div>
                            <div>@check(item.EstadoImplementacion, "NO_IMPLEMENTADO") No implementado</div>
                            <div>@check(item.EstadoImplementacion, "NO_APLICABLE") No aplicable</div>
                        </td>
                        <td class="cell-pre">@texto(item.PruebasNotasComentarios)</td>
                    </tr>
                }
            }
        </tbody>
    </table>
    </div>

    <div class="footer-safe-space"></div>

    <div class="signature-block">
        <div class="signature-title">FIRMA DEL TÉCNICO / INSPECTOR RESPONSABLE</div>
        <div class="signature-slot" data-firma-rol="LV_EAE_INSPECTOR">
            <span class="firma-anchor">ANCLA_FIRMA_LV_EAE_INSPECTOR</span>
            <span class="firma-anchor">ESPACIO RESERVADO PARA FIRMA DEL TECNICO</span>
            ESPACIO RESERVADO PARA FIRMA DEL TECNICO
        </div>
        <table class="signature-data">
            <tr><td style="width:18%;">Nombre:</td><td class="line">@texto(lista != null ? lista.InspectorResponsable : null)</td></tr>
            <tr><td>Cargo:</td><td class="line">@texto(lista != null ? lista.CargoInspector : null)</td></tr>
            <tr><td>Fecha:</td><td class="line">@(lista != null && lista.FechaFirma.HasValue ? lista.FechaFirma.Value.ToString("dd/MM/yyyy", cultura) : fechaLista)</td></tr>
        </table>
    </div>

    <div class="footer-line">31/12/2025 PII-VVII-C2-9 Tercera Edicion</div>
</div>
</div>
