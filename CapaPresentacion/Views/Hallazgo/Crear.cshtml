@inherits System.Web.Mvc.WebViewPage<CapaModelo.Hallazgo>
@using CapaModelo
@using System.Web.Mvc
@using System.Web.Mvc.Html

<h2>Registrar Hallazgo</h2>

@using (Html.BeginForm())
    @Html.AntiForgeryToken()
{
    @Html.HiddenFor(m => m.CodigoInspeccion)

    <div class="form-group">
        @Html.LabelFor(m => m.Descripcion)
        @Html.TextAreaFor(m => m.Descripcion, new { @class = "form-control", rows = 3 })
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.Criticidad)
        @Html.DropDownListFor(m => m.Criticidad,
            new SelectList(new[]{
                "LEVE","MODERADA","CRITICA"
            }),
            "-- Seleccione --",
            new { @class="form-control" })
    </div>

    <button class="btn btn-success">Guardar</button>
}


