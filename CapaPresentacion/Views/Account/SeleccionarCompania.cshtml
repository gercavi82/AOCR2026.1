@model CapaPresentacion.Models.SeleccionCompaniaViewModel
@using System
@{
    Layout = null;
    ViewBag.Title = "Seleccionar Compañía";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - AOCR</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background: linear-gradient(135deg, #0c7c86 0%, #1b4f72 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
        }

        .card-select {
            width: 100%;
            max-width: 560px;
            border: 0;
            border-radius: 12px;
            box-shadow: 0 14px 32px rgba(0, 0, 0, .25);
        }

        .card-header {
            background: linear-gradient(135deg, #0c7c86 0%, #1b4f72 100%);
            color: #fff;
            border-top-left-radius: 12px;
            border-top-right-radius: 12px;
            font-weight: 700;
        }
    </style>
</head>
<body>
    <div class="card card-select">
        <div class="card-header py-3">
            Solicitud AOCR
        </div>
        <div class="card-body p-4">
            <h5 class="mb-3 text-dark">¿Con qué compañía desea realizar el trámite?</h5>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger">
                    @Html.ValidationSummary(false, "", new { @class = "mb-0" })
                </div>
            }

            @using (Html.BeginForm("SeleccionarCompania", "Account", FormMethod.Post, new { @class = "mt-3" }))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.ReturnUrl)

                <div class="mb-3">
                    <label class="form-label fw-semibold" for="CompaniaSeleccionada">Compañía asignada</label>
                    <select class="form-select" id="CompaniaSeleccionada" name="CompaniaSeleccionada" required>
                        <option value="">-- Seleccione una compañía --</option>
                        @if (Model != null && Model.Companias != null)
                        {
                            foreach (var item in Model.Companias)
                            {
                                var selected = string.Equals(item.Codigo, Model.CompaniaSeleccionada, StringComparison.OrdinalIgnoreCase)
                                    ? "selected"
                                    : string.Empty;
                                <option value="@item.Codigo" @selected>
                                    [@item.Codigo] @item.Nombre
                                </option>
                            }
                        }
                    </select>
                </div>

                <button type="submit" class="btn btn-primary w-100">
                    Continuar
                </button>
            }
        </div>
    </div>
</body>
</html>
