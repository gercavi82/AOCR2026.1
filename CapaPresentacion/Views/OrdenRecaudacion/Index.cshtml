@model List<CapaDatos.Models.OrdenRecaudacionModel>

    @{
    ViewBag.Title = "Mis Órdenes de Recaudación";
    var estadisticas = ViewBag.Estadisticas as Dictionary<string, object>
        ;
        }

        <div class="row mb-4">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header bg-primary text-white">
                        <h3 class="card-title mb-0">
                            <i class="fas fa-file-invoice-dollar me-2"></i>@ViewBag.Title
                        </h3>
                        <div class="card-tools">
                            <a href="@Url.Action(" Nueva")" class="btn btn-light btn-sm">
                                <i class="fas fa-plus me-1"></i> Nueva Orden
                            </a>
                        </div>
                    </div>
                    <div class="card-body">
                        <!-- Filtros -->
                        <div class="row mb-3">
                            <div class="col-md-6">
                                @using (Html.BeginForm("Index", "OrdenRecaudacion", FormMethod.Get, new { @class = "form-inline" }))
                                {
                                <div class="input-group">
                                    @Html.DropDownList("estado", ViewBag.Estados as SelectList,
                                    new { @class = "form-control", onchange = "this.form.submit()" })
                                    <button type="submit" class="btn btn-outline-secondary">
                                        <i class="fas fa-filter"></i> Filtrar
                                    </button>
                                </div>
                                }
                            </div>
                            <div class="col-md-6 text-end">
                                <div class="btn-group" role="group">
                                    <a href="@Url.Action(" Index")" class="btn btn-outline-secondary btn-sm">
                                        <i class="fas fa-sync-alt"></i> Actualizar
                                    </a>
                                    <button type="button" class="btn btn-outline-secondary btn-sm" onclick="exportarExcel()">
                                        <i class="fas fa-file-excel"></i> Excel
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- Estadísticas -->
                        @if (estadisticas != null)
                        {
                        <div class="row mb-4">
                            <div class="col-md-3 col-sm-6">
                                <div class="info-box bg-gradient-info">
                                    <span class="info-box-icon"><i class="fas fa-file-alt"></i></span>
                                    <div class="info-box-content">
                                        <span class="info-box-text">Total Órdenes</span>
                                        <span class="info-box-number">@estadisticas["Total"]</span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3 col-sm-6">
                                <div class="info-box bg-gradient-success">
                                    <span class="info-box-icon"><i class="fas fa-check-circle"></i></span>
                                    <div class="info-box-content">
                                        <span class="info-box-text">Pagadas</span>
                                        <span class="info-box-number">@estadisticas["Pagadas"]</span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3 col-sm-6">
                                <div class="info-box bg-gradient-warning">
                                    <span class="info-box-icon"><i class="fas fa-clock"></i></span>
                                    <div class="info-box-content">
                                        <span class="info-box-text">Pendientes</span>
                                        <span class="info-box-number">$@Convert.ToDecimal(estadisticas["SaldoPendiente"]).ToString("#,##0.00")</span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3 col-sm-6">
                                <div class="info-box bg-gradient-primary">
                                    <span class="info-box-icon"><i class="fas fa-dollar-sign"></i></span>
                                    <div class="info-box-content">
                                        <span class="info-box-text">Total Recaudado</span>
                                        <span class="info-box-number">$@Convert.ToDecimal(estadisticas["MontoPagado"]).ToString("#,##0.00")</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        }

                        <!-- Tabla de órdenes -->
                        <div class="table-responsive">
                            <table id="tablaOrdenes" class="table table-hover table-striped">
                                <thead>
                                    <tr>
                                        <th>Número</th>
                                        <th>Fecha</th>
                                        <th>Contribuyente</th>
                                        <th>Concepto</th>
                                        <th class="text-end">Monto</th>
                                        <th class="text-end">Pagado</th>
                                        <th>Estado</th>
                                        <th>Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var orden in Model)
                                    {
                                    <tr>
                                        <td>
                                            <strong>@orden.NumeroOrden</strong>
                                            @if (orden.EstaVencida)
                                            {
                                            <span class="badge bg-danger" title="Orden vencida">VENCIDA</span>
                                            }
                                        </td>
                                        <td>@orden.FechaOrden.ToString("dd/MM/yyyy")</td>
                                        <td>
                                            @if (orden.Contribuyente != null)
                                            {
                                            <small class="text-muted d-block">@orden.Contribuyente.IdentificacionCompleta</small>
                                            @orden.Contribuyente.NombreRazonSocial
                                            }
                                        </td>
                                        <td>
                                            <small class="text-truncate d-block" style="max-width: 200px;"
                                                   title="@orden.Concepto">
                                                @orden.Concepto
                                            </small>
                                        </td>
                                        <td class="text-end">
                                            <span class="fw-bold">$@orden.MontoTotal.ToString("#,##0.00")</span>
                                        </td>
                                        <td class="text-end">
                                            <span class="@(orden.MontoPagado > 0 ? " text-success" : "text-muted" )">
                                                $@orden.MontoPagado.ToString("#,##0.00")
                                            </span>
                                        </td>
                                        <td>
                                            <span class="badge bg-@orden.EstadoColor">
                                                @orden.Estado
                                            </span>
                                            @if (orden.TieneSaldoPendiente)
                                            {
                                            <br />
                                            <small class="text-danger">Pendiente: $@orden.SaldoPendiente.ToString("#,##0.00")</small>
                                            }
                                        </td>
                                        <td>
                                            <div class="btn-group btn-group-sm" role="group">
                                                <a href="@Url.Action(" Detalles", new { id=orden.IdOrden })"
                                                   class="btn btn-info" title="Ver detalles">
                                                    <i class="fas fa-eye"></i>
                                                </a>
                                                <a href="@Url.Action(" DescargarPDF", new { id=orden.IdOrden })"
                                                   class="btn btn-secondary" title="Descargar PDF">
                                                    <i class="fas fa-download"></i>
                                                </a>
                                                @if (orden.Estado == "BORRADOR")
                                                {
                                                <a href="@Url.Action(" Editar", new { id=orden.IdOrden })"
                                                   class="btn btn-warning" title="Editar">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="card-footer text-muted">
                        <small>Mostrando @Model.Count órdenes</small>
                    </div>
                </div>
            </div>
        </div>

        @section Scripts {
        <script>
            $(document).ready(function () {
                $('#tablaOrdenes').DataTable({
                    language: {
                        url: '//cdn.datatables.net/plug-ins/1.13.4/i18n/es-ES.json'
                    },
                    order: [[1, 'desc']],
                    pageLength: 25,
                    responsive: true
                });
            });

            function exportarExcel() {
                window.location.href = '@Url.Action("ExportarExcel")';
            }
        </script>
        }
