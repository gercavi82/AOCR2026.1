@inherits System.Web.Mvc.WebViewPage<CapaPresentacion.Models.ViewModels.OrdenRecaudacionDetallesViewModel>
@using CapaModelo
@using CapaDatos.Constants
@using System.Web.Mvc
@using System.Web.Mvc.Html
@using CapaPresentacion.Helpers
@using CapaNegocio.Helpers
@using System.Globalization

@{
    ViewBag.Title = "Detalles de Orden";

    // Crear variables para facilitar el acceso
    var modeloIncompleto = Model == null || Model.Orden == null;
    var orden = Model != null && Model.Orden != null ? Model.Orden : new CapaDatos.Models.OrdenRecaudacionModel();
    var estado = EstadoOrden.NormalizarEstado(orden.Estado);
    var ordenCerradaPostAprobacion = OrdenRecaudacionOperativaHelper.EsOrdenCerradaPostAprobacionFinanciera(estado);
    var puedeEditar = OrdenRecaudacionOperativaHelper.PermiteEditarOrden(estado) &&
        (User != null && (User.IsInRole("Solicitante") || User.IsInRole("Administrador")));
    var solicitudInspeccionPanel = Model != null ? Model.SolicitudInspeccionPanel : null;
    var bloquearEdicionPorSolicitudInspeccion = solicitudInspeccionPanel != null &&
        solicitudInspeccionPanel.TieneInspeccionExt &&
        !solicitudInspeccionPanel.PuedeAgregarAccionesOrden;
    var puedeEditarOrden = puedeEditar && !bloquearEdicionPorSolicitudInspeccion;
    var puedeGenerar = estado == EstadoOrden.Borrador && orden.Total > 0;
    int solicitudId = 0;
    int.TryParse(orden.CodigoSolicitud ?? "", out solicitudId);
    var tieneSolicitudValida = solicitudId > 0;
    var puedeSubirComprobante = OrdenRecaudacionOperativaHelper.PermiteSubirComprobante(estado) && tieneSolicitudValida;
    var puedeAnular = OrdenRecaudacionOperativaHelper.PermiteAnularOrden(estado);
    var esDevuelta = estado == EstadoOrden.Devuelta;
    var motivoDevolucion = esDevuelta ? (orden.Observacion ?? string.Empty).Trim() : string.Empty;

    // Obtener documentos y pagos desde ViewBag
    var documentos = Model != null ? (Model.Documentos ?? new List<CapaDatos.Models.DocumentoModel>()) : new List<CapaDatos.Models.DocumentoModel>();
    var pagos = Model != null ? (Model.Pagos ?? new List<CapaDatos.Models.PagoModel>()) : new List<CapaDatos.Models.PagoModel>();
    var facturaPago = Model != null ? Model.FacturaPago : null;
    var culturaEsEc = new CultureInfo("es-EC");
    var tieneComprobanteValido = Model != null && Model.TieneComprobanteValido;
    var mensajeComprobante = Model != null ? (Model.MensajeComprobante ?? "Debe registrar el comprobante antes de continuar.") : "Debe registrar el comprobante antes de continuar.";
    var tieneFacturaDescargable = facturaPago != null && !string.IsNullOrWhiteSpace(facturaPago.FilePath);
    var abrirModalPago = Model != null && Model.AbrirModalPago;
    var abrirModalPagoJs = (abrirModalPago && puedeSubirComprobante) ? "true" : "false";
    var numeroOrdenVinculadaGop = CapaNegocio.Services.OrdenRecaudacionService.ConstruirNumeroOrdenDesdeNumeroSolicitud(
        orden.NumeroSolicitud,
        orden.FechaCreacion != default(DateTime) ? orden.FechaCreacion.Year : DateTime.Now.Year);
    var numeroOrdenReferencia = !string.IsNullOrWhiteSpace(numeroOrdenVinculadaGop)
        ? numeroOrdenVinculadaGop
        : orden.NumeroOrden;

    // Calcular total pagado
    // Contar pagos aprobados/validados (ambos estados son equivalentes funcionalmente)
    var totalPagado = pagos.Where(p => {
        var e = (p.Estado ?? "").Trim().ToUpperInvariant();
        return e == "APROBADO" || e == "VALIDADO";
    }).Sum(p => p.Monto);
    var saldoPendiente = orden.Total - totalPagado;
    var tieneSaldoPendiente = saldoPendiente > 0 && estado != EstadoOrden.Facturada && estado != EstadoOrden.Completada;
    var tienePagoAprobado = orden.Total > 0 && totalPagado >= orden.Total;
    var facturaGenerada = ordenCerradaPostAprobacion || estado == EstadoOrden.Facturada || estado == EstadoOrden.Completada;
    var ordenCompleta = tieneSolicitudValida && tienePagoAprobado && facturaGenerada && !tieneSaldoPendiente;
    var requiereSolicitudInspeccion = solicitudInspeccionPanel != null && solicitudInspeccionPanel.TieneInspeccionExt;
    var bloquearGeneracionPorSolicitudInspeccion = requiereSolicitudInspeccion && !solicitudInspeccionPanel.PuedeContinuarConOrden;

}

<div class="row">
    <div class="col-md-12">
        <div class="card">
            @if (modeloIncompleto)
            {
                <div class="alert alert-warning m-3 mb-0">
                    Se detectó información parcial de la orden. Se muestran datos mínimos para evitar errores de carga.
                </div>
            }
            @if (ordenCerradaPostAprobacion)
            {
                <div class="alert alert-success m-3 mb-0">
                    <i class="fas fa-circle-check me-2"></i>@OrdenRecaudacionOperativaHelper.MensajeOrdenCerradaPostAprobacion
                </div>
            }
            <div class="card-header bg-dark text-white">
                <div class="d-flex justify-content-between align-items-center">
                    <h3 class="card-title mb-0 text-white">
                        <i class="fas fa-file-invoice-dollar me-2 text-white"></i>Orden: @numeroOrdenReferencia
                    </h3>
                    <div class="btn-group">
                        <a href="@Url.Action("Index")" class="btn btn-light btn-sm">
                            <i class="fas fa-arrow-left me-1"></i> Volver
                        </a>
                        <a href="@Url.Action("DescargarPdf", new { id = orden.Id, vistaPrevia = true })"
                           class="btn btn-outline-light btn-sm" target="_blank">
                            <i class="fas fa-eye me-1"></i> Vista previa
                        </a>
                        <a href="@Url.Action("DescargarPdf", new { id = orden.Id })"
                           class="btn btn-success btn-sm" target="_blank">
                            <i class="fas fa-file-pdf me-1"></i> Descargar PDF
                        </a>
                        @if (facturaGenerada && tieneFacturaDescargable)
                        {
                            <a href="@Url.Action("DescargarFactura", new { id = orden.Id })"
                               class="btn btn-warning btn-sm" target="_blank"
                               title="Descargar factura @(string.IsNullOrWhiteSpace(facturaPago.NumeroFactura) ? string.Empty : facturaPago.NumeroFactura)">
                                <i class="fas fa-file-invoice me-1"></i> Descargar Factura
                            </a>
                        }
                    </div>
                </div>
            </div>

            <!-- Estado y acciones -->
            <div class="card-body border-bottom">
                @if (TempData["OK"] != null)
                {
                    <div class="alert alert-success">@TempData["OK"]</div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger">@TempData["Error"]</div>
                }
                @if (ordenCompleta)
                {
                    <div class="alert alert-success mb-3">
                        <i class="fas fa-check-circle me-2"></i> Orden completada: solicitud vinculada, pago aprobado, factura generada y sin saldo pendiente.
                    </div>
                }
                @if (facturaGenerada && tieneFacturaDescargable)
                {
                    <div class="alert alert-info mb-3">
                        <i class="fas fa-file-invoice me-2"></i> La factura ya esta disponible para descarga.
                    </div>
                }
                @if (!tieneComprobanteValido)
                {
                    <div class="alert alert-warning mb-3">
                        <i class="fas fa-exclamation-triangle me-2"></i> @mensajeComprobante
                    </div>
                }
                @if (esDevuelta)
                {
                    <div class="alert alert-danger mb-3">
                        <i class="fas fa-undo-alt me-2"></i> Financiero devolvió esta orden para corrección.
                        @if (!string.IsNullOrWhiteSpace(motivoDevolucion))
                        {
                            <div class="mt-2"><strong>Motivo:</strong> @motivoDevolucion</div>
                        }
                        <div class="mt-2">Debe cargar un respaldo actualizado y reenviarlo para nueva revisión.</div>
                    </div>
                }
                <div class="row">
                    <div class="col-md-6">
                        <span class="badge bg-@orden.EstadoColor fs-6 p-2">
                            <i class="fas fa-circle me-1"></i> @orden.Estado
                        </span>
                        @if (tieneSaldoPendiente && estado != EstadoOrden.Anulada)
                        {
                            <span class="badge bg-warning ms-2">
                                <i class="fas fa-clock me-1"></i> PENDIENTE
                            </span>
                        }
                        else if (estado == EstadoOrden.Facturada || estado == EstadoOrden.Completada)
                        {
                            <span class="badge bg-success ms-2">
                                <i class="fas fa-check-circle me-1"></i> FACTURADA
                            </span>
                        }
                    </div>
                    <div class="col-md-6 text-end">
                        <div class="botones-orden d-inline-flex align-items-center" style="gap: 10px;">
                            @if (puedeGenerar && !bloquearGeneracionPorSolicitudInspeccion)
                            {
                                using (Html.BeginForm("Generar", "OrdenRecaudacion", FormMethod.Post))
                                {
                                    @Html.AntiForgeryToken()
                                    @Html.Hidden("id", orden.Id)
                                    <button type="submit" class="btn btn-primary btn-sm"
                                            onclick="return confirm('¿Confirma que desea generar la orden? Esta acción es irreversible y no podrá editarla posteriormente.')">
                                        <i class="fas fa-check me-1"></i> Generar Orden
                                    </button>
                                }
                            }
                            else if (puedeGenerar && bloquearGeneracionPorSolicitudInspeccion)
                            {
                                <button type="button" class="btn btn-primary btn-sm" disabled
                                        title="Debe generar, firmar y cargar la Solicitud de Inspecciones antes de generar la orden.">
                                    <i class="fas fa-check me-1"></i> Generar Orden
                                </button>
                            }
                            @if (puedeSubirComprobante)
                            {
                                <button type="button" class="btn btn-success btn-sm" data-bs-toggle="modal" data-bs-target="#modalPago">
                                    <i class="fas fa-upload me-1"></i> Subir Comprobante
                                </button>
                            }
                            else if (estado == EstadoOrden.Pendiente || estado == EstadoOrden.Generada || estado == EstadoOrden.Devuelta)
                            {
                                <button type="button" class="btn btn-success btn-sm" disabled
                                        title="Debe vincular una solicitud válida para cargar el respaldo.">
                                    <i class="fas fa-upload me-1"></i> @(esDevuelta ? "Reenviar Respaldo" : "Subir Comprobante")
                                </button>
                            }
                            @if (puedeAnular)
                            {
                                <button type="button" class="btn btn-danger btn-sm" id="btnAbrirModalAnularOrden">
                                    <i class="fas fa-times me-1"></i> Anular Orden
                                </button>
                            }
                            @if (puedeEditarOrden)
                            {
                                <a href="@Url.Action("Editar", new { id = orden.Id })" class="btn btn-info btn-sm">
                                    <i class="fas fa-edit me-1"></i> Editar
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Información principal -->
            <div class="card-body">
                <div class="row">
                    <!-- Columna izquierda: Información general -->
                    <div class="col-md-8">
                        <div class="row mb-4">
                            <div class="col-md-6">
                                <h5><i class="fas fa-info-circle me-2 text-primary"></i>Información General</h5>
                                <table class="table table-sm table-borderless">
                                    <tr>
                                        <td class="fw-bold" style="width: 150px;">Número:</td>
                                        <td>
                                            @if (!string.IsNullOrWhiteSpace(orden.NumeroSolicitud))
                                            {
                                                <span>@orden.NumeroSolicitud</span>
                                                <div class="text-muted" style="font-size:0.8em;">Ref. OR: @numeroOrdenReferencia</div>
                                            }
                                            else
                                            {
                                                @orden.NumeroOrden
                                            }
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="fw-bold">Fecha Creación:</td>
                                        <td>@orden.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</td>
                                    </tr>
                                    <tr>
                                        <td class="fw-bold">Lugar Emisión:</td>
                                        <td>@(string.IsNullOrWhiteSpace(orden.LugarEmision) ? "No especificado" : orden.LugarEmision)</td>
                                    </tr>
                                    <tr>
                                        <td class="fw-bold">Estado:</td>
                                        <td>
                                            <span class="badge bg-@orden.EstadoColor">@orden.Estado</span>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="fw-bold">Usuario:</td>
                                        <td>@(string.IsNullOrWhiteSpace(orden.NombreUsuario) ? "No especificado" : orden.NombreUsuario)</td>
                                    </tr>
                                </table>
                            </div>

                            <div class="col-md-6">
                                <h5><i class="fas fa-user me-2 text-primary"></i>Información del Contribuyente</h5>
                                <table class="table table-sm table-borderless">
                                    <tr>
                                        <td class="fw-bold" style="width: 150px;">Compañía:</td>
                                        <td>@orden.Compania</td>
                                    </tr>
                                    <tr>
                                        <td class="fw-bold">RUC/Cédula:</td>
                                        <td>@orden.RucCedula</td>
                                    </tr>
                                    <tr>
                                        <td class="fw-bold">Email:</td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(orden.Correo))
                                            {
                                                <a href="mailto:@orden.Correo">@orden.Correo</a>
                                            }
                                            else
                                            {
                                                <span class="text-muted">No especificado</span>
                                            }
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="fw-bold">Teléfono:</td>
                                        <td>@(string.IsNullOrWhiteSpace(orden.Telefono) ? "No especificado" : orden.Telefono)</td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <!-- Observaciones -->
                        @if (!string.IsNullOrEmpty(orden.Observacion))
                        {
                            <div class="mb-4">
                                <h5><i class="fas fa-align-left me-2 text-primary"></i>Observaciones</h5>
                                <div class="card">
                                    <div class="card-body bg-light">
                                        @Html.Raw(System.Web.HttpUtility.HtmlEncode(CapaPresentacion.Helpers.VisibleTextHelper.Normalize(orden.Observacion)).Replace("\n", "<br />"))
                                    </div>
                                </div>
                            </div>
                        }

                        <!-- Detalles -->
                        <div class="mb-4">
                            <h5><i class="fas fa-list me-2 text-primary"></i>Detalles de la Orden</h5>
                            @if (orden.Detalles != null && orden.Detalles.Any())
                            {
                                <div class="table-responsive">
                                    <table class="table table-sm table-bordered">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Código</th>
                                                <th>Concepto</th>
                                                <th class="text-end">Cantidad</th>
                                                <th class="text-end">Valor Unit.</th>
                                                <th class="text-end">% Admin</th>
                                                <th class="text-end">Administración</th>
                                                <th class="text-end">Total Línea</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var detalle in orden.Detalles)
                                            {
                                                <tr>
                                                    <td>@detalle.ConceptoCodigo</td>
                                                    <td>@detalle.ConceptoNombre</td>
                                                    <td class="text-end">@detalle.Cantidad.ToString("#,##0.00")</td>
                                                    <td class="text-end">$@detalle.ValorUnitario.ToString("#,##0.00")</td>
                                                    <td class="text-end">@detalle.PorcentajeAdmin.ToString("#,##0.00")%</td>
                                                    <td class="text-end">$@detalle.Admin.ToString("#,##0.00")</td>
                                                    <td class="text-end fw-bold">$@detalle.TotalLinea.ToString("#,##0.00")</td>
                                                </tr>
                                            }
                                        </tbody>
                                        <tfoot class="table-light">
                                            <tr>
                                                <td colspan="5" class="text-end fw-bold">TOTALES:</td>
                                                <td class="text-end fw-bold">$@orden.Admin.ToString("#,##0.00")</td>
                                                <td class="text-end fw-bold fs-5">$@orden.Total.ToString("#,##0.00")</td>
                                            </tr>
                                        </tfoot>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-info">
                                    <i class="fas fa-info-circle me-2"></i>
                                    No hay detalles registrados para esta orden.
                                </div>
                            }
                        </div>

                        @if (requiereSolicitudInspeccion)
                        {
                            @Html.Partial("_PanelSolicitudInspeccionesExt", solicitudInspeccionPanel)
                        }

                        <!-- Pagos registrados -->
                        @if (pagos.Any())
                        {
                            <div class="mb-4">
                                <h5><i class="fas fa-money-bill-wave me-2 text-primary"></i>Pagos Registrados</h5>
                                <div class="table-responsive">
                                    <table class="table table-sm table-bordered">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Fecha</th>
                                                <th>N° Factura</th>
                                                <th>Método</th>
                                                <th>Banco</th>
                                                <th class="text-end">Monto</th>
                                                <th>Estado</th>
                                                <th>Validado por</th>
                                                @if (User.IsInRole("Administrador") || User.IsInRole("Financiero"))
                                                {
                                                    <th>Acciones</th>
                                                }
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var pago in pagos)
                                            {
                                                var fechaPago = pago.FechaPago.HasValue
                                                    ? pago.FechaPago.Value.ToString("dd/MM/yyyy HH:mm")
                                                    : "N/A";
                                                var numeroFactura = !string.IsNullOrEmpty(pago.NumeroFactura) ? pago.NumeroFactura : "N/A";
                                                var metodoPago = !string.IsNullOrEmpty(pago.MetodoPago) ? pago.MetodoPago : "N/A";
                                                var banco = !string.IsNullOrEmpty(pago.Banco)
                                                    ? pago.Banco
                                                    : (!string.IsNullOrEmpty(pago.MetodoPago) ? "Método: " + pago.MetodoPago : "No especificado");
                                                var validadoPor = !string.IsNullOrEmpty(pago.ValidadoPor) ? pago.ValidadoPor : "N/A";
                                                var estadoPago = (pago.Estado ?? "Pendiente").Trim();
                                                var estadoPagoNormalizado = estadoPago.Replace("_", " ").Trim().ToUpperInvariant();
                                                var estadoMostrar = estadoPago.Equals("APROBADO", System.StringComparison.OrdinalIgnoreCase) ? "Validado" : estadoPago;
                                                var badgeClass = estadoPago.Equals("APROBADO", System.StringComparison.OrdinalIgnoreCase) ? "success"
                                                    : estadoPago.Equals("RECHAZADO", System.StringComparison.OrdinalIgnoreCase) ? "danger"
                                                    : estadoPago.Equals("En Validación", System.StringComparison.OrdinalIgnoreCase) ? "info"
                                                    : "warning";
                                                var puedeGestionarPago = estadoPagoNormalizado == "PENDIENTE"
                                                    || estadoPagoNormalizado == "PENDIENTE VALIDACION"
                                                    || estadoPagoNormalizado == "EN VALIDACION";

                                                var montoMostrar = pago.Monto;
                                                if (orden.Total > 0 && montoMostrar > orden.Total * 10)
                                                {
                                                    montoMostrar = montoMostrar / 100m;
                                                }

                                                <tr>
                                                    <td>@fechaPago</td>
                                                    <td>@numeroFactura</td>
                                                    <td>@metodoPago</td>
                                                    <td>@banco</td>
                                                    <td class="text-end">@string.Format(culturaEsEc, "{0:C}", montoMostrar)</td>
                                                    <td>
                                                        <span class="badge bg-@badgeClass">
                                                            @estadoMostrar
                                                        </span>
                                                    </td>
                                                    <td>@validadoPor</td>
                                                    @if (User.IsInRole("Administrador") || User.IsInRole("Financiero"))
                                                    {
                                                        <td>
                                                            @if (puedeGestionarPago)
                                                            {
                                                                <div class="btn-group btn-group-sm" role="group">
                                                                    @Html.Hidden("PagoId_" + pago.CodigoPago, pago.CodigoPago, new { @class = "js-pago-id" })
                                                                    @Html.Hidden("NumeroFactura_" + pago.CodigoPago, numeroFactura, new { @class = "js-numero-factura" })
                                                                    <button type="button"
                                                                            class="btn btn-success btn-sm"
                                                                            onclick="validarPagoDesdeFila(this)"
                                                                            title="Validar pago">
                                                                        <i class="fas fa-check"></i>
                                                                    </button>
                                                                    <button type="button"
                                                                            class="btn btn-danger btn-sm"
                                                                            onclick="rechazarPagoDesdeFila(this)"
                                                                            title="Rechazar pago">
                                                                        <i class="fas fa-times"></i>
                                                                    </button>
                                                                </div>
                                                            }
                                                            else
                                                            {
                                                                <span class="text-muted">-</span>
                                                            }
                                                        </td>
                                                    }
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Columna derecha: Resumen y documentos -->
                    <div class="col-md-4">
                        <!-- Resumen financiero -->
                        <div class="card mb-4">
                            <div class="card-header bg-secondary text-white">
                                <h5 class="mb-0"><i class="fas fa-calculator me-2"></i>Resumen Financiero</h5>
                            </div>
                            <div class="card-body">
                                <table class="table table-sm table-borderless">
                                    <tr>
                                        <td class="fw-bold">Subtotal:</td>
                                        <td class="text-end">$@orden.Subtotal.ToString("#,##0.00")</td>
                                    </tr>
                                    <tr>
                                        <td class="fw-bold">Administración:</td>
                                        <td class="text-end">$@orden.Admin.ToString("#,##0.00")</td>
                                    </tr>
                                    <tr class="border-top">
                                        <td class="fw-bold">Total Orden:</td>
                                        <td class="text-end fw-bold fs-5">$@orden.Total.ToString("#,##0.00")</td>
                                    </tr>
                                    <tr>
                                        <td class="fw-bold">Total Pagado:</td>
                                        <td class="text-end text-success fw-bold">$@totalPagado.ToString("#,##0.00")</td>
                                    </tr>
                                    <tr class="border-top">
                                        <td class="fw-bold">Saldo Pendiente:</td>
                                        <td class="text-end @(saldoPendiente > 0 ? "text-danger fw-bold fs-5" : "text-success fw-bold fs-5")">
                                            $@saldoPendiente.ToString("#,##0.00")
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <!-- Documentos adjuntos -->
                        <div class="card mb-4">
                            <div class="card-header bg-secondary text-white d-flex justify-content-between align-items-center">
                                <h5 class="mb-0"><i class="fas fa-paperclip me-2"></i>Documentos Adjuntos</h5>
                                @if (puedeSubirComprobante)
                                {
                                    <button type="button" class="btn btn-outline-light btn-sm"
                                            data-bs-toggle="modal" data-bs-target="#modalPago">
                                        <i class="fas fa-upload"></i> Subir comprobante
                                    </button>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-outline-light btn-sm" disabled
                                            style="opacity:1"
                                            title="La orden debe estar PENDIENTE y vinculada a una solicitud válida.">
                                        <i class="fas fa-upload"></i> Subir comprobante
                                    </button>
                                }
                            </div>
                            <div class="card-body">
                                @if (documentos.Any())
                                {
                                    <div class="aocr-documents-grid">
                                        @foreach (var doc in documentos)
                                        {
                                            var tarjetaDocumento = DocumentoTarjetaPresentacionHelper.CrearTarjeta(doc, orden.Id, Url);
                                            @Html.Partial("_DocumentoTarjeta", tarjetaDocumento)
                                        }
                                    </div>
                                }
                                else
                                {
                                    <p class="text-muted text-center mb-0">
                                        <i class="fas fa-inbox fa-2x mb-2"></i><br />
                                        No hay documentos adjuntos
                                    </p>
                                }
                            </div>
                        </div>

                        <!-- Historial de estados -->
                        @if (ViewBag.HistorialEstados != null)
                        {
                            <div class="card">
                                <div class="card-header bg-light">
                                    <h5 class="mb-0"><i class="fas fa-history me-2"></i>Historial de Estados</h5>
                                </div>
                                <div class="card-body">
                                    <ul class="list-unstyled">
                                        <li class="mb-2">
                                            <i class="fas fa-plus-circle text-success me-2"></i>
                                            <strong>Creada:</strong> @orden.FechaCreacion.ToString("dd/MM/yyyy HH:mm")
                                        </li>
                                        @foreach (var hist in ViewBag.HistorialEstados)
                                        {
                                            <li class="mb-2">
                                                <i class="fas fa-exchange-alt text-info me-2"></i>
                                                <strong>@hist.EstadoNuevo:</strong> @hist.FechaCambio.ToString("dd/MM/yyyy HH:mm")
                                            </li>
                                        }
                                    </ul>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal para registrar pago -->
<div class="modal fade" id="modalPago" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            @using (Html.BeginForm("RegistrarPago", "OrdenRecaudacion", FormMethod.Post, new { enctype = "multipart/form-data" }))
            {
                @Html.AntiForgeryToken()
                @Html.Hidden("id", orden.Id)

                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title"><i class="fas fa-upload me-2"></i>Subir Comprobante</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Monto a Pagar:</label>
                        <div class="input-group">
                            <span class="input-group-text">$</span>
                            <input type="number" name="Monto" class="form-control"
                                   step="0.01" min="0.01"
                                   max="@(saldoPendiente.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture))"
                                   value="@(saldoPendiente.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture))"
                                   required />
                        </div>
                        <small class="text-muted">Saldo pendiente: $@saldoPendiente.ToString("#,##0.00")</small>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Número de Orden de recaudación/Referencia:</label>
                        <input type="text" name="NumeroFactura" class="form-control"
                               placeholder="Ej: FACT-001, Depósito #12345" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Método de Pago:</label>
                        @if (ViewBag.ListaMetodoPago != null)
                        {
                            @Html.DropDownList("MetodoPago", ViewBag.ListaMetodoPago as SelectList, new { @class = "form-control", @required = "required" })
                        }
                        else
                        {
                            <select name="MetodoPago" class="form-control" required>
                                <option value="">Seleccione método...</option>
                                <option value="DEPOSITO">Depósito Bancario</option>
                                <option value="TRANSFERENCIA">Transferencia Bancaria</option>
                                <option value="CHEQUE">Cheque</option>
                            </select>
                        }
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Banco donde se realiza el depósito:</label>
                        @if (ViewBag.ListaBancoPago != null)
                        {
                            @Html.DropDownList("Banco", ViewBag.ListaBancoPago as SelectList, new { @class = "form-control", @required = "required" })
                        }
                        else
                        {
                            <select name="Banco" class="form-control" required>
                                <option value="">Seleccione banco...</option>
                                <option value="001">BANCO PICHINCHA</option>
                                <option value="002">BANCO GUAYAQUIL</option>
                                <option value="003">BANCO PACIFICO</option>
                            </select>
                        }
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Comprobante de Pago:</label>
                        <input type="file" name="ComprobanteArchivo" class="form-control"
                               accept=".pdf,.jpg,.jpeg,.png" />
                        <small class="text-muted">Formatos permitidos: PDF, JPG, PNG (Máx. 10MB)</small>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Observaciones:</label>
                        <textarea name="Observaciones" class="form-control" rows="2"
                                  placeholder="Observaciones adicionales..."></textarea>
                    </div>
                    <div class="alert alert-info">
                        <i class="fas fa-info-circle me-2"></i>
                        Al registrar el pago, se actualizará el estado de la orden automáticamente.
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-success">
                        <i class="fas fa-check me-1"></i> Enviar Comprobante
                    </button>
                </div>
            }
        </div>
    </div>
</div>

@section PageModals {
    <div class="modal fade aocr-modal-anulacion" id="modalAnular" tabindex="-1" aria-labelledby="modalAnularOrdenLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                @using (Html.BeginForm("Anular", "OrdenRecaudacion", FormMethod.Post, new { id = "formAnularOrden" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.Hidden("id", orden.Id)

                    <div class="modal-header bg-danger text-white">
                        <h5 class="modal-title" id="modalAnularOrdenLabel">Anular Orden</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    </div>
                    <div class="modal-body">
                        <div class="alert alert-warning mb-0">
                            <strong>¡Advertencia!</strong><br />
                            Está a punto de anular la orden <strong id="ordenAnularNumero">@orden.NumeroOrden</strong>.<br />
                            Esta acción no se puede deshacer.
                        </div>
                        <div class="mt-3">
                            <label for="motivoAnulacion" class="form-label fw-bold">Motivo de la anulación:</label>
                            <textarea id="motivoAnulacion"
                                      name="motivo"
                                      class="form-control"
                                      rows="4"
                                      placeholder="Ingrese el motivo de la anulación..."
                                      required></textarea>
                            <div id="motivoAnulacionError" class="invalid-feedback d-none">
                                Debe ingresar el motivo de la anulación.
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-danger" id="btnConfirmarAnulacion">
                            <i class="fas fa-times me-1"></i> Confirmar Anulación
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
}

<!-- Recorrido del trámite AOCR -->
@if (orden != null && orden.Id > 0)
{
    <div class="row mt-4">
        <div class="col-md-12">
            <div data-aocr-recorrido-orden="@orden.Id" class="mb-4"></div>
        </div>
    </div>
}

@section Scripts {
    <style>
        .solicitud-inspeccion-card {
            border: 1px solid #b8d7f0;
            box-shadow: 0 4px 14px rgba(0, 44, 84, 0.08);
        }

        .solicitud-inspeccion-card .card-header {
            background: #f5fbff;
        }

        .solicitud-inspeccion-actions {
            display: flex;
            flex-wrap: wrap;
            gap: .5rem;
        }

        .solicitud-inspeccion-upload {
            margin-top: .75rem;
        }

        @@media (max-width: 576px) {
            .solicitud-inspeccion-actions .btn,
            .solicitud-inspeccion-file {
                width: 100%;
            }

            .solicitud-inspeccion-file {
                display: block;
            }

            .solicitud-inspeccion-file .form-control,
            .solicitud-inspeccion-file .btn {
                width: 100%;
                margin-top: .5rem;
                border-radius: .25rem !important;
            }
        }
    </style>
    <script>
    (function (window, document) {
        'use strict';

        function inicializarOrdenDetalles() {
            if (!window.jQuery) {
                console.error('[AOCR][JS] jQuery no está cargado. No se puede inicializar OrdenRecaudacion/Detalles.');
                return;
            }

            var $ = window.jQuery;

            var debeAbrirModalPago = '@abrirModalPagoJs' === 'true';
            if (debeAbrirModalPago) {
                var modalPago = document.getElementById('modalPago');
                if (modalPago && typeof bootstrap !== 'undefined' && bootstrap.Modal) {
                    bootstrap.Modal.getOrCreateInstance(modalPago).show();
                }
            }

            // Validar monto máximo en modal de pago
            $('input[name="Monto"]').off('change.aocr').on('change.aocr', function() {
                var max = parseFloat('@saldoPendiente.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)');
                var value = parseFloat($(this).val());

                if (value > max) {
                    $(this).val(max);
                    alert('El monto no puede exceder el saldo pendiente: $' + max.toFixed(2));
                }
            });

            // Validar archivo de comprobante
            $('input[name="ComprobanteArchivo"]').off('change.aocr').on('change.aocr', function() {
                var file = this.files[0];
                if (file) {
                    var fileSize = file.size / 1024 / 1024; // en MB
                    var allowedExtensions = /(\.pdf|\.jpg|\.jpeg|\.png)$/i;

                    if (fileSize > 10) {
                        alert('El archivo no puede exceder 10MB');
                        $(this).val('');
                        return false;
                    }

                    if (!allowedExtensions.exec(file.name)) {
                        alert('Solo se permiten archivos PDF, JPG y PNG');
                        $(this).val('');
                        return false;
                    }
                }
                return true;
            });

            $('#archivoSolicitudFirmada').off('change.aocr').on('change.aocr', function() {
                var file = this.files[0];
                if (file) {
                    var fileSize = file.size / 1024 / 1024;
                    var allowedExtensions = /(\.pdf)$/i;

                    if (fileSize > 10) {
                        alert('El archivo no puede exceder 10MB');
                        $(this).val('');
                        return false;
                    }

                    if (!allowedExtensions.exec(file.name)) {
                        alert('Solo se permiten archivos PDF');
                        $(this).val('');
                        return false;
                    }
                }
                return true;
            });

            var $modalAnular = $('#modalAnular');
            var $formAnular = $('#formAnularOrden');
            var $motivoAnulacion = $('#motivoAnulacion');
            var $motivoAnulacionError = $('#motivoAnulacionError');
            var $btnConfirmarAnulacion = $('#btnConfirmarAnulacion');
            var enviandoAnulacion = false;

            $('#btnAbrirModalAnularOrden').off('click.aocr').on('click.aocr', function (e) {
                e.preventDefault();
                if (window.AOCR && typeof window.AOCR.abrirModalAocr === 'function') {
                    window.AOCR.abrirModalAocr('#modalAnular');
                    return;
                }

                var modalEl = document.getElementById('modalAnular');
                if (modalEl && window.bootstrap && bootstrap.Modal) {
                    if (modalEl.parentElement !== document.body) {
                        document.body.appendChild(modalEl);
                    }
                    bootstrap.Modal.getOrCreateInstance(modalEl).show();
                }
            });

            $modalAnular.off('hidden.bs.modal.aocr').on('hidden.bs.modal.aocr', function () {
                $motivoAnulacion.val('').removeClass('is-invalid');
                $motivoAnulacionError.addClass('d-none');
                enviandoAnulacion = false;
                $btnConfirmarAnulacion.prop('disabled', false)
                    .html('<i class="fas fa-times me-1"></i> Confirmar Anulación');
            });

            $formAnular.off('submit.aocr').on('submit.aocr', function (e) {
                var motivo = ($motivoAnulacion.val() || '').trim();
                if (!motivo) {
                    e.preventDefault();
                    $motivoAnulacion.addClass('is-invalid');
                    $motivoAnulacionError.removeClass('d-none');
                    $motivoAnulacion.focus();
                    return false;
                }

                if (enviandoAnulacion) {
                    e.preventDefault();
                    return false;
                }

                enviandoAnulacion = true;
                $btnConfirmarAnulacion.prop('disabled', true)
                    .html('<i class="fas fa-spinner fa-spin me-1"></i> Anulando...');
                return true;
            });

            function obtenerDatosPagoDesdeFila(button) {
                var grupo = button ? button.closest('.btn-group') : null;
                if (!grupo) {
                    return { pagoId: 0, numeroFactura: '' };
                }

                var pagoIdInput = grupo.querySelector('.js-pago-id');
                var numeroFacturaInput = grupo.querySelector('.js-numero-factura');
                return {
                    pagoId: pagoIdInput ? pagoIdInput.value : 0,
                    numeroFactura: numeroFacturaInput ? numeroFacturaInput.value : ''
                };
            }

            function validarPagoDesdeFila(button) {
                var datos = obtenerDatosPagoDesdeFila(button);
                validarPago(datos.pagoId, datos.numeroFactura);
            }

            function rechazarPagoDesdeFila(button) {
                var datos = obtenerDatosPagoDesdeFila(button);
                rechazarPago(datos.pagoId, datos.numeroFactura);
            }

            function validarPago(pagoId, numeroFactura) {
                if (confirm('¿Está seguro de que desea validar el pago ' + numeroFactura + '?')) {
                    var form = $('<form>', {
                        'method': 'POST',
                        'action': '@Url.Action("ValidarPago", "OrdenRecaudacion")'
                    }).append($('<input>', {
                        'type': 'hidden',
                        'name': 'ordenId',
                        'value': '@orden.Id'
                    })).append($('<input>', {
                        'type': 'hidden',
                        'name': 'pagoId',
                        'value': pagoId
                    })).append($('@Html.AntiForgeryToken()'));

                    $('body').append(form);
                    form.submit();
                }
            }

            function rechazarPago(pagoId, numeroFactura) {
                var motivo = prompt('Ingrese el motivo del rechazo para el pago ' + numeroFactura + ':');
                if (motivo && motivo.trim() !== '') {
                    var form = $('<form>', {
                        'method': 'POST',
                        'action': '@Url.Action("RechazarPago", "OrdenRecaudacion")'
                    }).append($('<input>', {
                        'type': 'hidden',
                        'name': 'ordenId',
                        'value': '@orden.Id'
                    })).append($('<input>', {
                        'type': 'hidden',
                        'name': 'pagoId',
                        'value': pagoId
                    })).append($('<input>', {
                        'type': 'hidden',
                        'name': 'motivo',
                        'value': motivo
                    })).append($('@Html.AntiForgeryToken()'));

                    $('body').append(form);
                    form.submit();
                }
            }

            // Exponer al ámbito de window para que los onclicks en el HTML no se rompan
            window.validarPagoDesdeFila = validarPagoDesdeFila;
            window.rechazarPagoDesdeFila = rechazarPagoDesdeFila;
            window.validarPago = validarPago;
            window.rechazarPago = rechazarPago;
        }

        if (window.jQuery) {
            inicializarOrdenDetalles();
        } else if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', inicializarOrdenDetalles);
        } else {
            setTimeout(inicializarOrdenDetalles, 100);
        }

    })(window, document);
    </script>
}





