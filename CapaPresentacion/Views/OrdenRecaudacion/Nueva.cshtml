@{
    ViewBag.Title = "Nueva Orden AOCR";
    Layout = "~/Views/Shared/_LayoutAOCR.cshtml";
}

<div class="container py-5">
    <div class="card shadow border-0">
        <div class="card-header bg-dark text-white">
            <h4 class="mb-0"><i class="fas fa-calculator me-2"></i> Generar Orden de Recaudación</h4>
        </div>
        <div class="card-body">
            @Html.AntiForgeryToken()
            <div class="row">
                <div class="col-md-7">
                    <div class="mb-3">
                        <label class="fw-bold">Concepto Principal</label>
                        <select id="concepto" class="form-control calc-trigger">
                            <option value="EMISION_AOCR" data-p="3300">Emisión AOCR ($3,300.00)</option>
                            <option value="RENOVACION_AOCR" data-p="3300">Renovación AOCR ($3,300.00)</option>
                            <option value="MODIF_INC_AERONAVE" data-p="1600">Modificación (Con Aeronaves) ($1,600.00)</option>
                            <option value="MODIF_SIN_INC" data-p="80">Modificación Administrativa ($80.00)</option>
                        </select>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="fw-bold">Estaciones</label>
                            <input type="number" id="estaciones" class="form-control calc-trigger" value="0" min="0" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="fw-bold">Días de Viáticos</label>
                            <input type="number" id="dias" class="form-control calc-trigger" value="0" min="0" />
                        </div>
                    </div>
                </div>
                <div class="col-md-5 bg-light p-3 rounded">
                    <h5 class="border-bottom pb-2">RESUMEN DGAC</h5>
                    <div class="d-flex justify-content-between"><span>Tasa:</span><span id="resTasa">$0.00</span></div>
                    <div class="d-flex justify-content-between"><span>Inspección ($500):</span><span id="resInsp">$0.00</span></div>
                    <div class="d-flex justify-content-between"><span>Viáticos ($80):</span><span id="resViat">$0.00</span></div>
                    <div class="d-flex justify-content-between text-info font-italic"><span>Admin (8%):</span><span id="resAdmin">$0.00</span></div>
                    <hr />
                    <div class="d-flex justify-content-between h4 text-primary"><strong>TOTAL:</strong><strong id="resTotal">$0.00</strong></div>
                    <button id="btnCrear" class="btn btn-success w-100 mt-3">PROCESAR ORDEN</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function calcular() {
            const pBase = parseFloat($('#concepto option:selected').data('p'));
            const nEst = parseInt($('#estaciones').val()) || 0;
            const nDia = parseInt($('#dias').val()) || 0;

            const tInsp = nEst * 500;
            const tViat = nDia * 80;
            const tAdmin = tViat * 0.08;
            const total = pBase + tInsp + tViat + tAdmin;

            $('#resTasa').text('$' + pBase.toFixed(2));
            $('#resInsp').text('$' + tInsp.toFixed(2));
            $('#resViat').text('$' + tViat.toFixed(2));
            $('#resAdmin').text('$' + tAdmin.toFixed(2));
            $('#resTotal').text('$' + total.toFixed(2));
        }

        $('.calc-trigger').on('input change', calcular);
        $(document).ready(calcular);

        $('#btnCrear').on('click', function() {
            const btn = $(this);
            btn.prop('disabled', true).text('Procesando...');
            $.ajax({
                url: '@Url.Action("Crear", "OrdenRecaudacion")',
                type: 'POST',
                data: {
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val(),
                    ConceptoPrincipalCodigo: $('#concepto').val(),
                    Estaciones: $('#estaciones').val(),
                    Dias: $('#dias').val()
                },
                success: function(r) {
                    if(r.success) {
                        Swal.fire('Éxito', 'Orden creada', 'success').then(() => window.location.href='/Home/Index');
                    } else {
                        Swal.fire('Error', r.mensaje, 'error');
                        btn.prop('disabled', false).text('PROCESAR ORDEN');
                    }
                }
            });
        });
    </script>
}