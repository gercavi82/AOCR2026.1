@inherits System.Web.Mvc.WebViewPage<CapaPresentacion.Models.OrdenRecaudacionNuevaVM>
@using CapaModelo
@using System.Web.Mvc
@using System.Web.Mvc.Html
@{
    Layout = "~/Views/Shared/_LayoutAOCR.cshtml";
    ViewBag.Title = "Nueva Orden de recaudación";
}

@Html.Partial("_PageHeader", null, new ViewDataDictionary {
    { "Title", "Nueva Orden de Recaudación" },
    { "Subtitle", "Creación de orden para el flujo financiero AOCR" }
})

<style>
    .aocr-form-card .form-control,
    .aocr-form-card .form-select,
    .aocr-form-card input.form-control,
    .aocr-form-card textarea.form-control,
    .aocr-form-card .form-control[readonly],
    .aocr-form-card .form-control:disabled,
    .aocr-form-card .form-control.bg-light {
        color: #172033 !important;
        -webkit-text-fill-color: #172033;
    }

    .aocr-form-card .form-control::placeholder,
    .aocr-form-card textarea.form-control::placeholder {
        color: #6b7280 !important;
        opacity: 1;
    }

    .aocr-form-card .form-control[readonly],
    .aocr-form-card .form-control.bg-light {
        background-color: #f8fafc !important;
    }
</style>

<div class="card aocr-form-card">
    <div class="card-header" style="background: linear-gradient(135deg, var(--aocr-primary), var(--aocr-secondary)); color:#fff; border-radius: var(--aocr-radius-md) var(--aocr-radius-md) 0 0;">
        <h3 class="card-title mb-0">
            <i class="fas fa-plus-circle me-2"></i>@ViewBag.Title
        </h3>
    </div>

            @{
                var companiaActivaNombre = ViewBag.CompaniaActivaNombre as string ?? (Model != null ? Model.Orden?.Compania : string.Empty);
                var companiaActivaCodigo = ViewBag.CompaniaActivaCodigo as string ?? (Model != null ? Model.CompaniaActivaCodigo : string.Empty);
                var companiaActivaAlerta = ViewBag.CompaniaActivaAlerta as string;
            }

            @using (Html.BeginForm("Nueva", "OrdenRecaudacion", FormMethod.Post, new {
                id = "formOrden",
                @class = "form-horizontal",
                autocomplete = "off",
                data_compania_codigo = companiaActivaCodigo,
                data_compania_nombre = companiaActivaNombre
            }))
            {
                @Html.AntiForgeryToken()

                <input type="hidden" id="Subtotal" value="0" />
                <input type="hidden" id="Admin" value="0" />
                <input type="hidden" id="Total" value="0" />
                @Html.HiddenFor(m => m.DetallesJson, new { id = "DetallesJson" })
                @Html.HiddenFor(m => m.RucCedula, new { id = "RucCedulaGeneral" })
                @Html.HiddenFor(m => m.GenerarSolicitudInspeccionAlGuardar, new { id = "GenerarSolicitudInspeccionAlGuardar" })

                <div class="card-body">

                    @if (TempData["OK"] != null)
                    {
                        <div class="alert alert-success">@TempData["OK"]</div>
                    }

                    @Html.ValidationSummary(false, "", new { @class = "alert alert-danger" })

                    @if (!string.IsNullOrWhiteSpace(companiaActivaAlerta))
                    {
                        <div class="alert alert-info">
                            <i class="fas fa-building me-2"></i>@companiaActivaAlerta
                        </div>
                    }

                    @Html.HiddenFor(m => m.CompaniaActivaCodigo)

                    <!-- Información básica -->
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <h5><i class="fas fa-info-circle me-2 text-primary"></i>Información General</h5>

                            <div class="mb-3">
                                <label class="form-label">Solicitud</label>
                                @{
                                    var solicitudes = Model.Solicitudes ?? new List<CapaPresentacion.Models.OrdenRecaudacionNuevaVM.SolicitudOptionVM>();
                                    var solicitudUnica = solicitudes.Count == 1 ? solicitudes[0] : null;
                                }
                                @if (solicitudes.Count == 1)
                                {
                                    <input type="text" class="form-control" value="@solicitudUnica.Label" readonly />
                                    @Html.Hidden("Orden.CodigoSolicitud", solicitudUnica.Id)
                                }
                                else if (solicitudes.Count > 1)
                                {
                                    <select id="Orden_CodigoSolicitud" name="Orden.CodigoSolicitud" class="form-select">
                                        <option value="">-- Seleccione una solicitud --</option>
                                        @foreach (var s in solicitudes)
                                        {
                                            <option value="@s.Id" data-ruc="@s.Ruc" data-correo="@s.Correo" data-telefono="@s.Telefono">@s.Label</option>
                                        }
                                    </select>
                                }
                                else
                                {
                                    <input type="text" class="form-control" value="Se generará al guardar la orden" readonly />
                                }
                                @Html.ValidationMessageFor(m => m.Orden.CodigoSolicitud, "", new { @class = "text-danger" })
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Lugar de Emisión</label>
                                @Html.HiddenFor(m => m.Orden.LugarEmision)
                                <div class="form-control bg-light" aria-readonly="true" title="Este valor se obtiene directamente de la base de datos.">
                                    @(Model != null && Model.Orden != null ? (Model.Orden.LugarEmision ?? string.Empty) : string.Empty)
                                </div>
                                <small class="text-muted">Valor obtenido automáticamente desde la base de datos.</small>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Compañía activa</label>
                                @Html.HiddenFor(m => m.Orden.Compania)
                                @Html.HiddenFor(m => m.Orden.NombreContribuyente, new { id = "Orden_NombreContribuyente" })
                                <div id="Orden_Compania_Texto" class="form-control bg-light" aria-readonly="true" title="Compañía activa seleccionada en el sistema.">
                                    @if (!string.IsNullOrWhiteSpace(companiaActivaCodigo))
                                    {
                                        @:[@companiaActivaCodigo] @companiaActivaNombre
                                    }
                                    else
                                    {
                                        @(Model != null && Model.Orden != null ? (Model.Orden.Compania ?? string.Empty) : string.Empty)
                                    }
                                </div>
                                <small class="text-muted">Valor tomado exclusivamente de la compañía activa del RT. Si necesita cambiarla, use el selector del menú lateral.</small>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <h5><i class="fas fa-user me-2 text-primary"></i>Información del Contribuyente</h5>

                            <div class="mb-3">
                                <label class="form-label">RUC/Cédula</label>
                                @Html.TextBoxFor(m => m.Orden.RucCedula, new { @class = "form-control", placeholder = "RUC o Cédula", autocomplete = "off", maxlength = "13", inputmode = "numeric", pattern = "[0-9]*", oninput = "this.value=this.value.replace(/\\D/g,'').slice(0,13);" })
                                <small class="text-muted">Valor obtenido automáticamente. Puede corregirlo si es necesario (RUC: 13 dígitos / Cédula: 10 dígitos).</small>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Correo Electrónico</label>
                                @Html.TextBoxFor(m => m.Orden.Correo, new { @class = "form-control", type = "email", placeholder = "correo@empresa.com" })
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Teléfono</label>
                                @Html.TextBoxFor(m => m.Orden.Telefono, new { @class = "form-control", placeholder = "Teléfono de contacto", inputmode = "numeric", pattern = "[0-9]*", maxlength = "15", autocomplete = "off", oninput = "this.value=this.value.replace(/\\D/g,'').slice(0,15);" })
                            </div>
                        </div>
                    </div>

                    <!-- Agregar conceptos -->
                    <div class="row mb-4">
                        <div class="col-md-12">
                            <h5><i class="fas fa-list me-2 text-primary"></i>Agregar Conceptos</h5>

                            @if (ViewBag.ConceptoObligatorioEncontrado == false)
                            {
                                <div class="alert alert-danger" id="alertConceptoObligatorioCatalogo">
                                    <i class="fas fa-exclamation-triangle me-1"></i>
                                    No se encontró el concepto obligatorio INSPECCION_EXT. Verifique el catálogo de conceptos antes de continuar.
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-info d-none" id="alertConceptoObligatorioInfo">
                                    <i class="fas fa-info-circle me-1"></i>
                                    Para continuar con el proceso debe mantener el concepto obligatorio <strong>INSPECCION_EXT</strong> y agregar al menos otra acción o concepto adicional.
                                </div>
                            }

                             <div class="card">
                                 <div class="card-body">
                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            <label class="form-label">Concepto</label>
                                            <select id="ConceptoId" class="form-select">
                                                <option value="">Seleccione un concepto</option>
                                                @foreach (var c in (Model.Conceptos ?? new List<CapaPresentacion.Models.ConceptoOptionVM>()))
                                                {
                                                    <option value="@c.Id"
                                                            data-codigo="@c.Codigo"
                                                            data-nombre="@c.Nombre"
                                                            data-valor="@c.Valor"
                                                            data-porcentaje="@c.PorcentajeAdmin">
                                                        @c.Label
                                                    </option>
                                                }
                                            </select>
                                        </div>

                                        <div class="col-md-4" id="grupoCantidad">
                                            <label class="form-label" id="labelCantidad">Cantidad</label>
                                            <input type="number" id="Cantidad" class="form-control" value="1" min="1" step="1" />
                                        </div>

                                        <div class="col-md-2 d-flex align-items-end">
                                            <button type="button" id="btnAgregarConcepto" class="btn btn-primary w-100">
                                                <i class="fas fa-plus me-1"></i> Agregar
                                            </button>
                                        </div>
                                    </div>
                                 </div>
                             </div>

                             <!-- Lugar de inspeccion (visible cuando aplica INSPECCION_EXT) -->
                             <div class="mt-4" id="seccionViaticos" style="display: none;">
                                 <h5><i class="fas fa-plane-departure me-2 text-primary"></i>Detalles de Inspección</h5>
                                 <div class="card bg-light">
                                     <div class="card-body row g-3">
                                         <div class="col-12">
                                             <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
                                                 <label class="form-label fw-bold mb-0">Lugares de Inspección <span class="text-danger">*</span></label>
                                                 <span class="badge rounded-pill lugar-inspeccion-badge"><i class="fas fa-layer-group me-1"></i>Selección múltiple</span>
                                             </div>
                                             <input type="hidden" id="LugarInspeccion" name="LugarInspeccion" value="@Model.LugarInspeccion" />
                                             <div class="row g-2" id="opcionesLugarInspeccion">
                                                 <div class="col-12 col-sm-6 col-xl-3">
                                                     <label class="lugar-inspeccion-opcion">
                                                         <input type="checkbox" class="lugar-inspeccion-check" name="LugaresInspeccion" value="QUITO" />
                                                         <span class="lugar-inspeccion-marca"><i class="fas fa-check"></i></span>
                                                         <span class="lugar-inspeccion-texto"><strong>Quito</strong><small>Sin viáticos</small></span>
                                                     </label>
                                                 </div>
                                                 <div class="col-12 col-sm-6 col-xl-3">
                                                     <label class="lugar-inspeccion-opcion">
                                                         <input type="checkbox" class="lugar-inspeccion-check" name="LugaresInspeccion" value="LATACUNGA" />
                                                         <span class="lugar-inspeccion-marca"><i class="fas fa-check"></i></span>
                                                         <span class="lugar-inspeccion-texto"><strong>Latacunga</strong><small>Sin viáticos</small></span>
                                                     </label>
                                                 </div>
                                                 <div class="col-12 col-sm-6 col-xl-3">
                                                     <label class="lugar-inspeccion-opcion">
                                                         <input type="checkbox" class="lugar-inspeccion-check" name="LugaresInspeccion" value="GUAYAQUIL" />
                                                         <span class="lugar-inspeccion-marca"><i class="fas fa-check"></i></span>
                                                         <span class="lugar-inspeccion-texto"><strong>Guayaquil</strong><small>Permite viáticos</small></span>
                                                     </label>
                                                 </div>
                                                 <div class="col-12 col-sm-6 col-xl-3">
                                                     <label class="lugar-inspeccion-opcion">
                                                         <input type="checkbox" class="lugar-inspeccion-check" name="LugaresInspeccion" value="MANTA" />
                                                         <span class="lugar-inspeccion-marca"><i class="fas fa-check"></i></span>
                                                         <span class="lugar-inspeccion-texto"><strong>Manta</strong><small>Permite viáticos</small></span>
                                                     </label>
                                                 </div>
                                                 <div class="col-12 col-md-6">
                                                     <label class="lugar-inspeccion-opcion">
                                                         <input type="checkbox" class="lugar-inspeccion-check" name="LugaresInspeccion" value="OTRA_PROVINCIA" />
                                                         <span class="lugar-inspeccion-marca"><i class="fas fa-check"></i></span>
                                                         <span class="lugar-inspeccion-texto"><strong>Otra provincia/localidad</strong><small>Especifique el destino</small></span>
                                                     </label>
                                                 </div>
                                             </div>
                                             <small class="text-muted d-block mt-2"><i class="fas fa-info-circle me-1"></i>Puede seleccionar todos los lugares que sean necesarios.</small>
                                         </div>
                                         <div class="col-md-6" id="divProvinciaInspeccion" style="display: none;">
                                             <label class="form-label fw-bold">Provincia / localidad <span class="text-danger">*</span></label>
                                             @Html.TextBoxFor(m => m.ProvinciaInspeccion, new { @class = "form-control", placeholder = "Ingrese la provincia o localidad real", maxlength = "150" })
                                         </div>
                                     </div>
                                     <div class="row g-3 mt-1" id="mensajeViaticosLugar" style="display: none;">
                                         <div class="col-12">
                                             <div class="alert alert-info mb-0 py-2">
                                                 <i class="fas fa-info-circle me-2"></i><span id="textoMensajeViaticosLugar"></span>
                                             </div>
                                         </div>
                                     </div>
                                 </div>
                             </div>

                         </div>
                     </div>

                    <!-- Tabla de detalles -->
                    <div class="row mb-4">
                        <div class="col-md-12">
                            <h5><i class="fas fa-table me-2 text-primary"></i>Detalles de la Orden</h5>

                            <div class="table-responsive">
                                <table class="table table-hover" id="tablaDetalles">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Código</th>
                                            <th>Concepto</th>
                                            <th style="width: 120px;" id="encabezadoCantidad">Cantidad</th>
                                            <th style="width: 150px; display: none;" id="encabezadoNumeroDias">NÚMERO DE DÍAS</th>
                                            <th class="text-end">Valor Unit.</th>
                                            <th class="text-end">% Admin</th>
                                            <th class="text-end">Administración</th>
                                            <th class="text-end">Total Línea</th>
                                            <th style="width: 60px;">Acciones</th>
                                        </tr>
                                    </thead>
                                    <tbody></tbody>
                                    <tfoot class="table-light">
                                        <tr>
                                            <td colspan="5" class="text-end fw-bold" id="colspanTotales">TOTALES:</td>
                                            <td class="text-end fw-bold" id="admin">$0.00</td>
                                            <td class="text-end fw-bold" id="total">$0.00</td>
                                            <td></td>
                                        </tr>
                                        <tr>
                                            <td colspan="6" class="text-end fw-bold" id="colspanSubtotal">SUBTOTAL:</td>
                                            <td class="text-end fw-bold" id="subtotal">$0.00</td>
                                            <td></td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>

                        </div>
                    </div>

                    @Html.Partial("_PanelSolicitudInspeccionesExt", Model.SolicitudInspeccionPanel)

                    <!-- Observaciones -->
                    <div class="row mb-4">
                        <div class="col-md-12">
                            <h5><i class="fas fa-sticky-note me-2 text-primary"></i>Observaciones</h5>
                            @Html.TextAreaFor(m => m.Orden.Observacion, 3, 60, new { @class = "form-control", placeholder = "Observaciones adicionales..." })
                        </div>
                    </div>

                </div>

                <div class="card-footer">
                    <div class="text-end">
                        <a href="@Url.Action("Index","OrdenRecaudacion")" class="btn btn-secondary me-2">
                            <i class="fas fa-times me-1"></i> Cancelar
                        </a>
                        <button type="submit" class="btn btn-primary" id="btnGuardar">
                            <i class="fas fa-save me-1"></i> Guardar Orden
                        </button>
                    </div>
                </div>
            }
        </div>



@section Scripts {
    <style>
        .solicitud-inspeccion-card {
            border: 1px solid #b8d7f0;
            box-shadow: 0 4px 14px rgba(0, 44, 84, 0.08);
        }

        .solicitud-inspeccion-card .card-header {
            background: #f5fbff;
        }

        .solicitud-inspeccion-actions {
            display: flex;
            flex-wrap: wrap;
            gap: .5rem;
        }

        .detalle-obligatorio td {
            background-color: #f8fbff;
        }

         .badge-concepto-obligatorio {
             font-size: 0.7rem;
             vertical-align: middle;
         }

         .lugar-inspeccion-badge {
             color: #0b5ed7;
             background: #eaf3ff;
             border: 1px solid #b7d3f5;
             font-weight: 700;
         }

         .lugar-inspeccion-opcion {
             position: relative;
             display: flex;
             align-items: center;
             gap: .75rem;
             width: 100%;
             min-height: 68px;
             padding: .75rem .9rem;
             border: 1px solid #cbd8e6;
             border-radius: .65rem;
             background: #fff;
             cursor: pointer;
             transition: border-color .16s ease, background-color .16s ease, box-shadow .16s ease, transform .16s ease;
         }

         .lugar-inspeccion-opcion:hover {
             border-color: #75a8e8;
             background: #f8fbff;
             transform: translateY(-1px);
         }

         .lugar-inspeccion-opcion:focus-within {
             outline: 3px solid rgba(13, 110, 253, .18);
             outline-offset: 1px;
         }

         .lugar-inspeccion-opcion.seleccionada {
             border-color: #0d6efd;
             background: #eef6ff;
             box-shadow: 0 5px 14px rgba(13, 110, 253, .12);
         }

         .lugar-inspeccion-check {
             position: absolute;
             width: 1px;
             height: 1px;
             opacity: 0;
             pointer-events: none;
         }

         .lugar-inspeccion-marca {
             display: inline-flex;
             align-items: center;
             justify-content: center;
             flex: 0 0 26px;
             width: 26px;
             height: 26px;
             border: 2px solid #9fb3c8;
             border-radius: 50%;
             color: transparent;
             background: #fff;
             transition: all .16s ease;
         }

         .lugar-inspeccion-marca i {
             font-size: .72rem;
         }

         .lugar-inspeccion-opcion.seleccionada .lugar-inspeccion-marca {
             color: #fff;
             border-color: #0d6efd;
             background: #0d6efd;
         }

         .lugar-inspeccion-texto {
             display: flex;
             flex-direction: column;
             min-width: 0;
             line-height: 1.2;
         }

         .lugar-inspeccion-texto strong {
             color: #17324d;
             font-size: .94rem;
         }

         .lugar-inspeccion-texto small {
             margin-top: .22rem;
             color: #6c7f92;
             font-size: .76rem;
             font-weight: 500;
         }

        @@media (max-width: 576px) {
            .solicitud-inspeccion-actions .btn,
            .solicitud-inspeccion-actions label.btn {
                width: 100%;
            }
        }
    </style>
    <script>
                        $(function () {

                            var detalles = [];
                             var CODIGO_CONCEPTO_OBLIGATORIO = '@(ViewBag.ConceptoObligatorioCodigo ?? "INSPECCION_EXT")';
                             var CONCEPTO_OBLIGATORIO_ENCONTRADO = @((ViewBag.ConceptoObligatorioEncontrado == true) ? "true" : "false");
                             var LUGAR_INSPECCION_INICIAL = '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(Model.LugarInspeccion ?? string.Empty))';
                             var agregandoConceptoObligatorio = false;
                             $('#AeropuertosSolicitados').prop('readonly', true).addClass('bg-light');

                             function obtenerCodigoTramite() {
                                 var codigoTramite = null;
                                 detalles.forEach(function (d) {
                                     var codigo = (d.ConceptoCodigo || '').toString().trim().toUpperCase();
                                     if (codigo === 'EMI_AOCR' || codigo === 'REN_AOCR' || codigo === 'MOD_AOCR_INC') {
                                         codigoTramite = codigo;
                                     }
                                 });
                                 return codigoTramite;
                             }

                             function requiereInspeccionExterna() {
                                 return !!obtenerCodigoTramite();
                             }

                            function esConceptoObligatorio(codigo) {
                                var cod = (codigo || '').toString().trim().toUpperCase();
                                if (cod !== CODIGO_CONCEPTO_OBLIGATORIO) return false;
                                
                                 return requiereInspeccionExterna();
                            }

                            function obtenerOpcionConceptoObligatorio() {
                                var $encontrada = null;
                                $('#ConceptoId option').each(function () {
                                    var codigo = ($(this).data('codigo') || '').toString().trim().toUpperCase();
                                    if (codigo === CODIGO_CONCEPTO_OBLIGATORIO) {
                                        $encontrada = $(this);
                                        return false;
                                    }
                                });
                                return $encontrada;
                            }

                            function yaExisteConceptoObligatorio() {
                                return detalles.some(function (d) {
                                    return esConceptoObligatorio(d.ConceptoCodigo);
                                });
                            }

                            function mostrarAlertaInstitucional(mensaje) {
                                alert(mensaje);
                            }

                             function crearDetalleDesdeOpcion($opt, cantidad, numeroDiasInspeccion) {
                                var conceptoId = $opt.val();
                                var codigo = ($opt.data('codigo') || '').toString().trim().toUpperCase();
                                var nombre = $opt.data('nombre') || $opt.text();
                                var valor = toNumber($opt.data('valor'));
                                var porcentaje = toNumber($opt.data('porcentaje'));
                                var esViatico = codigo === 'VIATICOS_INSPECTOR';
                                var diasInspeccion = esViatico ? Math.max(parseInt(numeroDiasInspeccion || 1, 10), 1) : null;

                                var detalle = {
                                    ConceptoId: parseInt(conceptoId, 10),
                                    ConceptoCodigo: codigo,
                                    ConceptoNombre: nombre,
                                    Cantidad: esViatico ? 1 : cantidad,
                                    NumeroDiasInspeccion: diasInspeccion,
                                    ValorUnitario: valor,
                                    PorcentajeAdmin: porcentaje,
                                    EsObligatorio: esConceptoObligatorio(codigo)
                                };

                                 var diasFacturables = esViatico
                                     ? Math.max(detalle.NumeroDiasInspeccion - 1, 0)
                                     : detalle.Cantidad;
                                 detalle.Subtotal = diasFacturables * detalle.ValorUnitario;
                                detalle.Admin = detalle.Subtotal * (detalle.PorcentajeAdmin / 100.0);
                                detalle.TotalLinea = detalle.Subtotal + detalle.Admin;
                                return detalle;
                            }

                            function agregarDetalleDesdeOpcion($opt, cantidad, numeroDiasInspeccion) {
                                if (!$opt || !$opt.length || cantidad <= 0) {
                                    return false;
                                }

                                 var codigo = ($opt.data('codigo') || '').toString().trim().toUpperCase();
                                 var conceptoDuplicado = detalles.some(function (d) {
                                     return parseInt(d.ConceptoId, 10) === parseInt($opt.val(), 10)
                                         || (d.ConceptoCodigo || '').toString().trim().toUpperCase() === codigo;
                                 });
                                 if (conceptoDuplicado) {
                                     return false;
                                 }

                                detalles.push(crearDetalleDesdeOpcion($opt, cantidad, numeroDiasInspeccion));
                                return true;
                            }

                            function seleccionarConceptoObligatorioEnCombo() {
                                var $opt = obtenerOpcionConceptoObligatorio();
                                if ($opt && $opt.length) {
                                    $('#ConceptoId').val($opt.val());
                                }
                            }

                             function agregarConceptoObligatorioAutomatico() {
                                 if (!requiereInspeccionExterna()) {
                                     return;
                                 }

                                if (!CONCEPTO_OBLIGATORIO_ENCONTRADO) {
                                    $('#btnGuardar').prop('disabled', true);
                                    return;
                                }

                                if (yaExisteConceptoObligatorio()) {
                                    seleccionarConceptoObligatorioEnCombo();
                                    return;
                                }

                                var $opt = obtenerOpcionConceptoObligatorio();
                                if (!$opt || !$opt.length) {
                                    CONCEPTO_OBLIGATORIO_ENCONTRADO = false;
                                    $('#alertConceptoObligatorioInfo').addClass('d-none');
                                    if ($('#alertConceptoObligatorioCatalogo').length === 0) {
                                        var $alertCatalogo = $('<div class="alert alert-danger" id="alertConceptoObligatorioCatalogo">' +
                                            '<i class="fas fa-exclamation-triangle me-1"></i> ' +
                                            'No se encontró el concepto obligatorio INSPECCION_EXT. Verifique el catálogo de conceptos antes de continuar.' +
                                            '</div>');
                                        if ($('#alertConceptoObligatorioInfo').length) {
                                            $('#alertConceptoObligatorioInfo').replaceWith($alertCatalogo);
                                        } else {
                                            $('h5:contains("Agregar Conceptos")').first().after($alertCatalogo);
                                        }
                                    }
                                    $('#btnGuardar').prop('disabled', true);
                                    return;
                                }

                                agregandoConceptoObligatorio = true;
                                seleccionarConceptoObligatorioEnCombo();
                                if (agregarDetalleDesdeOpcion($opt, 1)) {
                                    renderTabla();
                                    actualizarTotales();
                                }
                                agregandoConceptoObligatorio = false;
                                $('#Cantidad').val('1');
                            }

                             function validarDetallesAntesGuardar() {
                                 if (requiereInspeccionExterna() && !CONCEPTO_OBLIGATORIO_ENCONTRADO) {
                                    mostrarAlertaInstitucional('No se encontró el concepto obligatorio INSPECCION_EXT. Verifique el catálogo de conceptos antes de continuar.');
                                    return false;
                                }

                                 var codigoTramite = obtenerCodigoTramite();
                                var tieneViaticos = false;
                                var tieneInspeccionExt = false;
                                
                                detalles.forEach(function (d) {
                                    if (d.ConceptoCodigo) {
                                        if (d.ConceptoCodigo === 'VIATICOS_INSPECTOR' && d.NumeroDiasInspeccion > 0) {
                                            tieneViaticos = true;
                                        }
                                        if (d.ConceptoCodigo === 'INSPECCION_EXT' && d.Cantidad > 0) {
                                            tieneInspeccionExt = true;
                                        }
                                    }
                                });

                                // Regla INSPECCION_EXT
                                 if (codigoTramite === 'EMI_AOCR' || codigoTramite === 'REN_AOCR' || codigoTramite === 'MOD_AOCR_INC') {
                                    if (!tieneInspeccionExt) {
                                        mostrarAlertaInstitucional('El trámite exige obligatoriamente el concepto INSPECCION_EXT.');
                                        return false;
                                    }
                                 }

                                 var requiereDatosInspeccion = requiereInspeccionExterna() || tieneInspeccionExt;
                                 var lugaresInspeccion = sincronizarLugaresYAeropuertos();
                                 if (requiereDatosInspeccion && lugaresInspeccion.length === 0) {
                                     mostrarAlertaInstitucional('Seleccione el lugar o provincia donde se realizará la inspección.');
                                     return false;
                                 }

                                 if (lugaresInspeccion.indexOf('OTRA_PROVINCIA') >= 0) {
                                     var provinciaInspeccion = ($('#ProvinciaInspeccion').val() || '').trim();
                                     if (!provinciaInspeccion) {
                                         mostrarAlertaInstitucional('Ingrese la provincia o localidad donde se realizará la inspección.');
                                         return false;
                                     }
                                 }

                                 if (tieneViaticos && lugaresSoloQuitoLatacunga(lugaresInspeccion)) {
                                     mostrarAlertaInstitucional('Para inspecciones realizadas únicamente en Quito y/o Latacunga no aplica registro de viáticos.');
                                     return false;
                                 }

                                 var tieneLugarExterno = lugaresInspeccion.some(function (lugar) {
                                     return lugar !== 'QUITO' && lugar !== 'LATACUNGA';
                                 });
                                 if (requiereDatosInspeccion && tieneLugarExterno && !tieneViaticos) {
                                     mostrarAlertaInstitucional('No fue posible agregar automáticamente VIATICOS_INSPECTOR. Verifique el catálogo de conceptos.');
                                     return false;
                                 }

                                return true;
                            }

                            function limpiarSoloDigitos(valor, maximo) {
                                var limpio = (valor || '').toString().replace(/\D/g, '');
                                if (typeof maximo === 'number' && maximo > 0) {
                                    return limpio.slice(0, maximo);
                                }
                                return limpio;
                            }

                            var $rucCedula = $('#Orden_RucCedula');
                            $rucCedula.on('input paste blur', function () {
                                $(this).val(limpiarSoloDigitos($(this).val(), 13));
                            });
                            $rucCedula.val(limpiarSoloDigitos($rucCedula.val(), 13));

                            function aplicarSolicitudSeleccionada() {
                                var $sel = $('#Orden_CodigoSolicitud');
                                if ($sel.length === 0) return;

                                var $opt = $sel.find('option:selected');
                                var solicitudId = $opt.val();
                                if (!solicitudId) {
                                    return;
                                }

                                var ruc = limpiarSoloDigitos($opt.data('ruc') || '', 13);
                                var correo = $opt.data('correo') || '';
                                var telefono = $opt.data('telefono') || '';

                                if (ruc) $('#Orden_RucCedula').val(ruc);
                                if (correo) $('#Orden_Correo').val(correo);
                                if (telefono) $('#Orden_Telefono').val(telefono);
                            }

            function toNumber(v) {
                if (v === null || v === undefined) return 0;
                // dataset viene como string con punto decimal
                var n = parseFloat(v.toString().replace(',', '.'));
                return isNaN(n) ? 0 : n;
            }

            function obtenerLugaresSeleccionados() {
                return $('.lugar-inspeccion-check:checked').map(function () {
                    return ($(this).val() || '').toString().trim().toUpperCase();
                }).get().filter(function (valor, indice, lista) {
                    return valor && lista.indexOf(valor) === indice;
                });
            }

            function lugaresSoloQuitoLatacunga(lugares) {
                return lugares.length > 0 && lugares.every(function (lugar) {
                    return lugar === 'QUITO' || lugar === 'LATACUNGA';
                });
            }

            function sincronizarLugaresYAeropuertos() {
                var lugares = obtenerLugaresSeleccionados();
                $('#LugarInspeccion').val(lugares.join(','));
                $('.lugar-inspeccion-opcion').each(function () {
                    $(this).toggleClass('seleccionada', $(this).find('.lugar-inspeccion-check').prop('checked'));
                });

                var nombres = [];
                lugares.forEach(function (lugar) {
                    if (lugar === 'OTRA_PROVINCIA') {
                        var otraLocalidad = ($('#ProvinciaInspeccion').val() || '').trim();
                        if (otraLocalidad) nombres.push(otraLocalidad);
                        return;
                    }

                    var $opcion = $('.lugar-inspeccion-check[value="' + lugar + '"]').first();
                    var etiqueta = $opcion.closest('.lugar-inspeccion-opcion').find('.lugar-inspeccion-texto strong').first().text().trim();
                    if (etiqueta) nombres.push(etiqueta);
                });

                var $aeropuertos = $('#AeropuertosSolicitados');
                if ($aeropuertos.length) {
                    $aeropuertos.val(nombres.join(', '));
                }

                return lugares;
            }

            function actualizarTotales() {
                var subtotal = 0, admin = 0, total = 0;

                detalles.forEach(function (d) {
                    subtotal += d.Subtotal;
                    admin += d.Admin;
                    total += d.TotalLinea;
                });

                $('#subtotal').text('$' + subtotal.toFixed(2));
                $('#admin').text('$' + admin.toFixed(2));
                $('#total').text('$' + total.toFixed(2));

                $('#Subtotal').val(subtotal.toFixed(2));
                $('#Admin').val(admin.toFixed(2));
                $('#Total').val(total.toFixed(2));
            }

             function renderTabla() {
                 var $tb = $('#tablaDetalles tbody');
                 $tb.empty();

                 var tablaTieneViaticos = detalles.some(function (d) {
                     return (d.ConceptoCodigo || '').toString().trim().toUpperCase() === 'VIATICOS_INSPECTOR';
                 });
                 $('#encabezadoNumeroDias').toggle(tablaTieneViaticos);
                 $('#colspanTotales').attr('colspan', tablaTieneViaticos ? 6 : 5);
                 $('#colspanSubtotal').attr('colspan', tablaTieneViaticos ? 7 : 6);

                detalles.forEach(function (d, i) {
                    var esObligatorio = esConceptoObligatorio(d.ConceptoCodigo);
                    var esViatico = (d.ConceptoCodigo || '').toString().trim().toUpperCase() === 'VIATICOS_INSPECTOR';
                    var nombreHtml = AOCR.escapeHtml(String(d.ConceptoNombre));
                    if (esObligatorio) {
                        nombreHtml += ' <span class="badge bg-primary badge-concepto-obligatorio ms-1">Obligatorio</span>';
                    }
                    if (esViatico) {
                        nombreHtml += ' <span class="badge bg-info text-dark ms-1">Automático</span>';
                    }

                    var accionesHtml = esObligatorio || esViatico
                        ? '<span class="text-muted" title="' + (esViatico ? 'Concepto automático según el lugar de inspección' : 'Concepto obligatorio del proceso AOCR') + '"><i class="fas fa-lock"></i></span>'
                        : '<button type="button" class="btn btn-danger btn-sm btnEliminarDetalle" data-index="' + AOCR.escapeHtml(String(i)) + '"><i class="fas fa-trash"></i></button>';

                    var celdaNumeroDias = '';
                    if (tablaTieneViaticos) {
                        celdaNumeroDias = esViatico
                            ? '<td><input type="number" class="form-control form-control-sm numero-dias-detalle" data-index="' + AOCR.escapeHtml(String(i)) + '" value="' + AOCR.escapeHtml(String(d.NumeroDiasInspeccion || 1)) + '" min="1" step="1" aria-label="Número de días de inspección"></td>'
                            : '<td class="text-center text-muted">-</td>';
                    }

                    var tr = ''
                        + '<tr data-index="' + AOCR.escapeHtml(String(i)) + '"' + (esObligatorio || esViatico ? ' class="detalle-obligatorio"' : '') + '>'
                        + '<td>' + AOCR.escapeHtml(String(d.ConceptoCodigo)) + '</td>'
                        + '<td>' + nombreHtml + '</td>'
                        + '<td><input type="number" class="form-control form-control-sm cantidad-detalle" data-index="' + AOCR.escapeHtml(String(i)) + '" value="' + AOCR.escapeHtml(String(d.Cantidad)) + '" min="1" step="1"' + (esObligatorio ? ' data-obligatorio="1"' : '') + (esViatico ? ' readonly aria-label="Cantidad del concepto de viáticos"' : '') + '></td>'
                        + celdaNumeroDias
                        + '<td class="text-end">$' + AOCR.escapeHtml(d.ValorUnitario.toFixed(2)) + '</td>'
                        + '<td class="text-end">' + AOCR.escapeHtml(d.PorcentajeAdmin.toFixed(2)) + '%</td>'
                        + '<td class="text-end">$' + AOCR.escapeHtml(d.Admin.toFixed(2)) + '</td>'
                        + '<td class="text-end">$' + AOCR.escapeHtml(d.TotalLinea.toFixed(2)) + '</td>'
                        + '<td class="text-center">' + accionesHtml + '</td>'
                        + '</tr>';
                    $tb.append(tr);
                });

                actualizarPanelSolicitudInspeccion();
                 actualizarReglasInspeccionSeguras();
             }

             function actualizarReglasInspeccionSeguras() {
                 var inspeccionRequerida = requiereInspeccionExterna();
                 var tieneInspeccionExt = detalles.some(function (d) {
                     return (d.ConceptoCodigo || '').toString().trim().toUpperCase() === 'INSPECCION_EXT';
                 });
                 var tieneViaticos = detalles.some(function (d) {
                     return (d.ConceptoCodigo || '').toString().trim().toUpperCase() === 'VIATICOS_INSPECTOR';
                 });

                 if (inspeccionRequerida && !tieneInspeccionExt) {
                     var $inspeccion = obtenerOpcionConcepto('INSPECCION_EXT');
                     if ($inspeccion && $inspeccion.length && !agregandoConceptoObligatorio) {
                         agregandoConceptoObligatorio = true;
                         agregarDetalleDesdeOpcion($inspeccion, 1);
                         agregandoConceptoObligatorio = false;
                         renderTabla();
                         actualizarTotales();
                         return;
                     }
                 }

                 $('#alertConceptoObligatorioInfo').toggleClass('d-none', !inspeccionRequerida);

                 var requiereDatosInspeccion = inspeccionRequerida || tieneInspeccionExt;
                 $('#seccionViaticos').toggle(requiereDatosInspeccion);

                 var lugares = sincronizarLugaresYAeropuertos();
                 var lugarSinViaticos = lugaresSoloQuitoLatacunga(lugares);
                 var permiteViaticos = requiereDatosInspeccion
                     && lugares.some(function (lugar) { return lugar !== 'QUITO' && lugar !== 'LATACUNGA'; });
                 var $opcionViaticos = obtenerOpcionConcepto('VIATICOS_INSPECTOR');

                 if ($opcionViaticos && $opcionViaticos.length) {
                     $opcionViaticos.prop('disabled', true).prop('hidden', true);
                     if ($('#ConceptoId').val() === $opcionViaticos.val()) {
                         $('#ConceptoId').val('');
                     }
                 }

                 if (permiteViaticos && !tieneViaticos && $opcionViaticos && $opcionViaticos.length) {
                     agregarDetalleDesdeOpcion($opcionViaticos, 1, 1);
                     renderTabla();
                     actualizarTotales();
                     return;
                 }

                 if ((!permiteViaticos || !requiereDatosInspeccion) && tieneViaticos) {
                     detalles = detalles.filter(function (d) {
                         return (d.ConceptoCodigo || '').toString().trim().toUpperCase() !== 'VIATICOS_INSPECTOR';
                     });
                     renderTabla();
                     actualizarTotales();
                     return;
                 }

                 if (!requiereDatosInspeccion) {
                     $('.lugar-inspeccion-check').prop('checked', false);
                     $('#LugarInspeccion').val('');
                     $('#ProvinciaInspeccion').val('');
                     $('#divProvinciaInspeccion').hide();
                     $('#mensajeViaticosLugar').hide();
                     sincronizarLugaresYAeropuertos();
                 }

                 if (lugarSinViaticos) {
                     $('#textoMensajeViaticosLugar').text('Para inspecciones realizadas únicamente en Quito y/o Latacunga no aplica registro de viáticos.');
                     $('#mensajeViaticosLugar').show();
                 } else {
                     $('#mensajeViaticosLugar').hide();
                 }

                 actualizarEtiquetaCantidadSeleccionada();
             }

             function actualizarEtiquetaCantidadSeleccionada() {
                 $('#labelCantidad').text('Cantidad');
             }

            function obtenerOpcionConcepto(codigoBuscado) {
                var $encontrada = null;
                $('#ConceptoId option').each(function () {
                    var codigo = ($(this).data('codigo') || '').toString().trim().toUpperCase();
                    if (codigo === codigoBuscado) {
                        $encontrada = $(this);
                        return false;
                    }
                });
                return $encontrada;
            }

            function actualizarPanelSolicitudInspeccion() {

                var existeInspeccion = $('#tablaDetalles tbody tr').filter(function () {
                    var codigo = ($(this).find('td:first').text() || '').trim().toUpperCase();
                    return codigo === 'INSPECCION_EXT';
                }).length > 0;

                $('#panelSolicitudInspeccion').toggleClass('d-none', !existeInspeccion);
                if (!existeInspeccion) {
                    $('#AeropuertosSolicitados').val('');
                    $('#mensajeSolicitudInspeccion').addClass('d-none').text('');
                    $('#estadoSolicitudInspeccion').text('NO_REQUERIDO').removeClass('bg-success bg-primary bg-warning bg-danger').addClass('bg-secondary');
                    $('#btnGenerarSolicitudInspeccionNueva').prop('disabled', true);
                    $('#btnDescargarSolicitudInspeccionNueva').prop('disabled', true);
                    $('#btnSubirSolicitudInspeccionNueva').addClass('disabled').find('input[type=file]').prop('disabled', true);
                    return;
                }

                $('#estadoSolicitudInspeccion').text('NO_GENERADO').removeClass('bg-success bg-primary bg-danger bg-secondary').addClass('bg-warning text-dark');
                $('#mensajeSolicitudInspeccion')
                    .removeClass('d-none')
                    .text('Debe generar la Solicitud de Inspecciones.');
                $('#btnGenerarSolicitudInspeccionNueva').prop('disabled', false);
                $('#btnDescargarSolicitudInspeccionNueva').prop('disabled', true);
                $('#btnSubirSolicitudInspeccionNueva').addClass('disabled').find('input[type=file]').prop('disabled', true);

                // Inicializar calendario de fechas cuando el panel es visible
                if (window.AOCR && typeof window.AOCR.inicializarCalendarioFechasInspeccion === 'function') {
                    setTimeout(function () { window.AOCR.inicializarCalendarioFechasInspeccion(); }, 200);
                }
            }

            function actualizarCamposOcultos() {
                // SOLO enviar lo mínimo; el servidor recalcula compañía desde sesión (seguridad).
                var payload = detalles.map(function (d) {
                    return {
                        ConceptoId: d.ConceptoId,
                        Cantidad: d.Cantidad,
                        NumeroDiasInspeccion: d.NumeroDiasInspeccion
                    };
                });
                $('#DetallesJson').val(JSON.stringify(payload));

                var $form = $('#formOrden');
                var codigoCompania = ($form.data('compania-codigo') || $('#CompaniaActivaCodigo').val() || '').toString().trim();
                var nombreCompania = ($form.data('compania-nombre') || $('#Orden_Compania').val() || '').toString().trim();
                var ruc = limpiarSoloDigitos($('#Orden_RucCedula').val(), 13);

                if (codigoCompania) {
                    $('#CompaniaActivaCodigo').val(codigoCompania);
                }
                if (nombreCompania) {
                    $('#Orden_Compania').val(nombreCompania);
                    $('#Orden_NombreContribuyente').val(nombreCompania);
                }

                $('#RucCedulaGeneral').val(ruc);
            }

            function restaurarBotonGenerarSolicitudInspeccion() {
                $('#btnGenerarSolicitudInspeccionNueva')
                    .prop('disabled', false)
                    .html('<i class="fas fa-file-pdf me-1"></i> Generar Solicitud de Inspecciones');
            }

                            $('#btnAgregarConcepto').on('click', function () {
                var $opt = $('#ConceptoId option:selected');
                var conceptoId = $opt.val();
                var cantidad = toNumber($('#Cantidad').val() || 1);

                if (!conceptoId) { alert('Seleccione un concepto'); return; }
                if (cantidad <= 0) { alert('Cantidad inválida'); return; }

                 var codigo = ($opt.data('codigo') || '').toString().trim().toUpperCase();
                 var conceptoDuplicado = detalles.some(function (d) {
                     return parseInt(d.ConceptoId, 10) === parseInt(conceptoId, 10)
                         || (d.ConceptoCodigo || '').toString().trim().toUpperCase() === codigo;
                 });
                 if (conceptoDuplicado) {
                     alert('El concepto seleccionado ya esta incluido en la orden.');
                     return;
                 }

                 if (codigo === 'VIATICOS_INSPECTOR') {
                     alert('VIATICOS_INSPECTOR se agrega automáticamente al seleccionar Guayaquil, Manta u otra provincia/localidad.');
                     return;
                 }

                 if (esConceptoObligatorio(codigo) && yaExisteConceptoObligatorio()) {
                    alert('El concepto INSPECCION_EXT ya está incluido como concepto obligatorio.');
                    seleccionarConceptoObligatorioEnCombo();
                    return;
                }

                if (!agregarDetalleDesdeOpcion($opt, cantidad)) {
                    return;
                }

                renderTabla();
                actualizarTotales();

                if (!esConceptoObligatorio(codigo)) {
                    $('#ConceptoId').val('');
                } else {
                    seleccionarConceptoObligatorioEnCombo();
                }
                 $('#Cantidad').val('1');
                 actualizarEtiquetaCantidadSeleccionada();
             });

            $(document).on('click', '.btnEliminarDetalle', function () {
                var idx = parseInt($(this).data('index'), 10);
                if (!detalles[idx]) {
                    return;
                }

                if (esConceptoObligatorio(detalles[idx].ConceptoCodigo)) {
                    alert('El concepto INSPECCION_EXT es obligatorio y no puede eliminarse.');
                    return;
                }

                if ((detalles[idx].ConceptoCodigo || '').toString().trim().toUpperCase() === 'VIATICOS_INSPECTOR') {
                    alert('VIATICOS_INSPECTOR es automático y se retira al desmarcar los lugares externos.');
                    return;
                }

                detalles.splice(idx, 1);
                renderTabla();
                actualizarTotales();
            });

            $(document).on('change', '.cantidad-detalle', function () {
                var idx = parseInt($(this).data('index'), 10);
                var cant = toNumber($(this).val());
                var esObligatorio = $(this).data('obligatorio') === 1 || $(this).data('obligatorio') === '1';

                if (!detalles[idx]) return;

                if (cant <= 0) {
                    if (esObligatorio) {
                        cant = 1;
                        $(this).val('1');
                    } else {
                        return;
                    }
                }

                detalles[idx].Cantidad = cant;
                 detalles[idx].Subtotal = detalles[idx].Cantidad * detalles[idx].ValorUnitario;
                 detalles[idx].Admin = detalles[idx].Subtotal * (detalles[idx].PorcentajeAdmin / 100.0);
                detalles[idx].TotalLinea = detalles[idx].Subtotal + detalles[idx].Admin;

                renderTabla();
                actualizarTotales();
            });

            $(document).on('change', '.numero-dias-detalle', function () {
                var idx = parseInt($(this).data('index'), 10);
                var numeroDias = parseInt($(this).val(), 10);
                if (!detalles[idx]) return;

                if (!numeroDias || numeroDias < 1) {
                    numeroDias = 1;
                    $(this).val('1');
                }

                detalles[idx].Cantidad = 1;
                detalles[idx].NumeroDiasInspeccion = numeroDias;
                detalles[idx].Subtotal = Math.max(numeroDias - 1, 0) * detalles[idx].ValorUnitario;
                detalles[idx].Admin = detalles[idx].Subtotal * (detalles[idx].PorcentajeAdmin / 100.0);
                detalles[idx].TotalLinea = detalles[idx].Subtotal + detalles[idx].Admin;

                renderTabla();
                actualizarTotales();
            });

                            function cargarDetallesIniciales() {
                                 var raw = $('#DetallesJson').val();
                                 if (!raw) {
                                     agregarConceptoObligatorioAutomatico();
                                     renderTabla();
                                     actualizarTotales();
                                     return;
                                 }

                                try {
                                    var iniciales = JSON.parse(raw) || [];
                                    iniciales.forEach(function (item) {
                                        var conceptoId = item.ConceptoId || item.conceptoId || 0;
                                        var cantidad = toNumber(item.Cantidad || item.cantidad || 1);
                                        var $opt = $('#ConceptoId option[value="' + conceptoId + '"]');
                                        if (!$opt.length || cantidad <= 0) return;

                                         var codigo = ($opt.data('codigo') || '').toString().trim().toUpperCase();
                                         var numeroDiasInspeccion = item.NumeroDiasInspeccion || item.numeroDiasInspeccion || null;
                                         if (codigo === 'VIATICOS_INSPECTOR' && !numeroDiasInspeccion) {
                                             numeroDiasInspeccion = cantidad;
                                         }
                                         if (esConceptoObligatorio(codigo) && yaExisteConceptoObligatorio()) {
                                            return;
                                        }

                                         agregarDetalleDesdeOpcion($opt, cantidad, numeroDiasInspeccion);
                                    });

                                    renderTabla();
                                    actualizarTotales();
                                    agregarConceptoObligatorioAutomatico();
                                } catch (e) {
                                    agregarConceptoObligatorioAutomatico();
                                }
                            }

                            $('#formOrden').on('submit', function (e) {
                                if (!validarDetallesAntesGuardar()) {
                                    if ($('#GenerarSolicitudInspeccionAlGuardar').val() === 'true') {
                                        $('#GenerarSolicitudInspeccionAlGuardar').val('false');
                                        restaurarBotonGenerarSolicitudInspeccion();
                                    }
                                    e.preventDefault();
                                    return false;
                                }

                                var solicitaGenerarInspeccion = $('#GenerarSolicitudInspeccionAlGuardar').val() === 'true' || $('#GenerarSolicitudInspeccionAlGuardar').val() === 'True';
                                if (solicitaGenerarInspeccion) {
                                    var aeropuertos = ($('#AeropuertosSolicitados').val() || '').trim().toUpperCase();
                                    $('#AeropuertosSolicitados').val(aeropuertos);
                                    if (!aeropuertos) {
                                        $('#mensajeSolicitudInspeccion')
                                            .removeClass('d-none')
                                            .text('Debe ingresar los aeropuertos solicitados antes de generar la Solicitud de Inspecciones.');
                                        $('#GenerarSolicitudInspeccionAlGuardar').val('false');
                                        restaurarBotonGenerarSolicitudInspeccion();
                                        e.preventDefault();
                                        return false;
                                    }

                                    var fechas = ($('#FechasInspeccion').val() || '').trim();
                                    $('#FechasInspeccion').val(fechas);
                                    if (!fechas) {
                                        $('#mensajeSolicitudInspeccion')
                                            .removeClass('d-none')
                                            .text('Debe ingresar las fechas estimadas de inspección.');
                                        $('#GenerarSolicitudInspeccionAlGuardar').val('false');
                                        restaurarBotonGenerarSolicitudInspeccion();
                                        e.preventDefault();
                                        return false;
                                    }
                                }

                                $('#Orden_RucCedula').val(limpiarSoloDigitos($('#Orden_RucCedula').val(), 13));
                                actualizarCamposOcultos();
                                return true;
                            });

                            $('#btnGenerarSolicitudInspeccionNueva').on('click', function () {
                                var aeropuertos = ($('#AeropuertosSolicitados').val() || '').trim().toUpperCase();
                                $('#AeropuertosSolicitados').val(aeropuertos);
                                $('#mensajeSolicitudInspeccion').addClass('d-none').text('');

                                if (!aeropuertos) {
                                    $('#mensajeSolicitudInspeccion')
                                        .removeClass('d-none')
                                        .text('Debe ingresar los aeropuertos solicitados.');
                                    return;
                                }

                                var fechas = ($('#FechasInspeccion').val() || '').trim();
                                $('#FechasInspeccion').val(fechas);
                                if (!fechas) {
                                    $('#mensajeSolicitudInspeccion')
                                        .removeClass('d-none')
                                        .text('Debe ingresar las fechas estimadas de inspección.');
                                    return;
                                }

                                function solicitarConfirmacionGeneracion(onConfirm) {
                                    if (window.AOCR && typeof window.AOCR.confirmarGeneracionSolicitudInspeccion === 'function') {
                                        window.AOCR.confirmarGeneracionSolicitudInspeccion(onConfirm);
                                        return;
                                    }

                                    var mensajePlano = 'Está por generar el PDF definitivo de la Solicitud de Inspecciones.\n\n' +
                                        'Si continúa, la solicitud quedará cerrada y ya no podrá agregar nuevas acciones, conceptos o inspecciones adicionales a esta orden.\n\n' +
                                        '¿Desea generar el PDF definitivo con la información actual?';

                                    if (window.confirm(mensajePlano)) {
                                        onConfirm();
                                    }
                                }

                                solicitarConfirmacionGeneracion(function () {
                                    $('#GenerarSolicitudInspeccionAlGuardar').val('true');
                                    $('#btnGenerarSolicitudInspeccionNueva')
                                        .prop('disabled', true)
                                        .html('<i class="fas fa-spinner fa-spin me-1"></i> Generando...');
                                    $('#formOrden').trigger('submit');
                                });
                            });

                             $(document).on('change', '.lugar-inspeccion-check', function () {
                                 var lugares = obtenerLugaresSeleccionados();
                                 var incluyeOtraLocalidad = lugares.indexOf('OTRA_PROVINCIA') >= 0;
                                 $('#divProvinciaInspeccion').toggle(incluyeOtraLocalidad);
                                 if (!incluyeOtraLocalidad) {
                                     $('#ProvinciaInspeccion').val('');
                                 }
                                 sincronizarLugaresYAeropuertos();
                                 actualizarReglasInspeccionSeguras();
                             });

                             $('#ProvinciaInspeccion').on('input change', sincronizarLugaresYAeropuertos);

                             $('#ConceptoId').on('change', actualizarEtiquetaCantidadSeleccionada);

                             $('#Orden_CodigoSolicitud').on('change', aplicarSolicitudSeleccionada);
                             aplicarSolicitudSeleccionada();
                             if (LUGAR_INSPECCION_INICIAL) {
                                 LUGAR_INSPECCION_INICIAL.split(',').forEach(function (lugar) {
                                     var valor = (lugar || '').trim().toUpperCase();
                                     $('.lugar-inspeccion-check[value="' + valor + '"]').prop('checked', true);
                                 });
                                 $('#LugarInspeccion').val(LUGAR_INSPECCION_INICIAL);
                             }
                             $('#divProvinciaInspeccion').toggle(obtenerLugaresSeleccionados().indexOf('OTRA_PROVINCIA') >= 0);
                             sincronizarLugaresYAeropuertos();
                             cargarDetallesIniciales();

                         });
    </script>
}
