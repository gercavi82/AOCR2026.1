@inherits System.Web.Mvc.WebViewPage<IEnumerable<CapaNegocio.Services.AocrDcavRevisionItem>>
@using System.Linq

@{
    Layout = "~/Views/Shared/_LayoutAOCR.cshtml";
    ViewBag.Title = "Revision DCAV";
    var items = Model != null ? Model.ToList() : new System.Collections.Generic.List<CapaNegocio.Services.AocrDcavRevisionItem>();
}

<div class="container-fluid mt-4">
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body d-flex justify-content-between align-items-center">
            <div>
                <span class="badge bg-primary-subtle text-primary mb-2">Director de Certificaciones DCAV</span>
                <h2 class="mb-1">Revision DCAV</h2>
                <p class="text-muted mb-0">Expedientes AOCR pendientes de revision previa a la firma del Director General.</p>
            </div>
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Numero de solicitud</th>
                            <th>Numero de AOCR</th>
                            <th>Explotador</th>
                            <th>Tipo de tramite</th>
                            <th>Inspector</th>
                            <th>Coordinador</th>
                            <th>Envio a DCAV</th>
                            <th>Revision</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!items.Any())
                        {
                            <tr>
                                <td colspan="10" class="text-center text-muted py-4">No existen expedientes pendientes de revision DCAV.</td>
                            </tr>
                        }
                        @foreach (var item in items)
                        {
                            <tr>
                                <td><strong>@item.NumeroSolicitud</strong><div class="small text-muted">SolicitudId @item.SolicitudId</div></td>
                                <td>@(string.IsNullOrWhiteSpace(item.NumeroAocr) ? "Pendiente" : item.NumeroAocr)</td>
                                <td>@item.NombreExplotador</td>
                                <td>@item.TipoTramite</td>
                                <td>@item.InspectorResponsable</td>
                                <td>@item.CoordinadorResponsable</td>
                                <td>@(item.FechaEnvioDcav.HasValue ? item.FechaEnvioDcav.Value.ToString("dd/MM/yyyy HH:mm") : "-")</td>
                                <td>@item.TipoRevision</td>
                                <td><span class="badge bg-warning text-dark">@item.Estado</span></td>
                                <td>
                                    <a class="btn btn-sm btn-primary" href="@Url.Action("Detalle", "AocrDcav", new { solicitudId = item.SolicitudId })">Ver expediente</a>
                                    <a class="btn btn-sm btn-outline-secondary" href="@Url.Action("DocumentoValidacionAocr", "CoordinacionJefatura", new { solicitudId = item.SolicitudId, tipo = "RECONOCIMIENTO" })" target="_blank">Ver AOCR</a>
                                    <a class="btn btn-sm btn-outline-secondary" href="@Url.Action("DocumentoValidacionAocr", "CoordinacionJefatura", new { solicitudId = item.SolicitudId, tipo = "CONDICIONES_LIMITACIONES" })" target="_blank">Ver Condiciones</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
