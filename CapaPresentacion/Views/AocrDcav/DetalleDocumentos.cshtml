@model CapaPresentacion.Models.RevisionDocumentosDcavViewModel
@using System.Linq
@{Layout="~/Views/Shared/_LayoutAOCR.cshtml";ViewBag.Title="Revisión de AOCR y Condiciones";}
@helper Documento(string titulo,CapaPresentacion.Models.DocumentoRevisionDcavViewModel d){<div class="card border-0 shadow-sm h-100"><div class="card-header bg-light"><strong>@titulo</strong></div><div class="card-body"><dl class="row mb-3"><dt class="col-4">Versión enviada</dt><dd class="col-8">@d.Version</dd><dt class="col-4">Estado</dt><dd class="col-8">@d.Estado</dd><dt class="col-4">Fecha</dt><dd class="col-8">@d.Fecha.ToString("dd/MM/yyyy HH:mm")</dd><dt class="col-4">Tamaño</dt><dd class="col-8">@d.Tamano bytes</dd><dt class="col-4">SHA-256</dt><dd class="col-8"><code class="text-break">@d.Hash</code></dd></dl><a class="btn btn-outline-primary" target="_blank" href="@Url.Action("Descargar","DocumentoPdf",new{id=d.PdfId})">Visualizar / descargar</a></div></div>}
<div class="container-fluid mt-4">
 <div class="card border-0 shadow-sm mb-3"><div class="card-body d-flex justify-content-between"><div><span class="badge bg-primary">Segunda revisión DCAV</span><h2 class="mt-2">@Model.NumeroSolicitud</h2><p class="mb-0 text-muted">@Model.Explotador · @Model.TipoTramite · @Model.Pais</p><p class="mb-0"><strong>Inspector:</strong> @Model.Inspector · <strong>Enviado:</strong> @Model.FechaEnvio.ToString("dd/MM/yyyy HH:mm")</p><span class="badge bg-warning text-dark mt-2">@Model.Estado</span></div><a class="btn btn-outline-secondary align-self-start" href="@Url.Action("RevisionDocumentos")">Volver</a></div></div>
 <div class="row g-3 mb-3"><div class="col-lg-6">@Documento("AOCR",Model.Aocr)</div><div class="col-lg-6">@Documento("CONDICIONES Y LIMITACIONES",Model.Condiciones)</div></div>
 <div class="card border-0 shadow-sm mb-3"><div class="card-header bg-light"><strong>Soporte obligatorio</strong></div><div class="card-body"><a class="btn btn-outline-primary me-2" target="_blank" href="@Url.Action("VerInformeDocumento",new{solicitudId=Model.SolicitudId,inspeccionId=Model.InspeccionId})">Informe Técnico aprobado</a><a class="btn btn-outline-primary" target="_blank" href="@Url.Action("VerLvDocumento",new{solicitudId=Model.SolicitudId,inspeccionId=Model.InspeccionId})">LV/EAE firmada</a></div></div>
 <div class="card border-0 shadow-sm mb-3"><div class="card-header bg-light"><strong>Historial</strong></div><div class="table-responsive"><table class="table table-sm mb-0"><thead><tr><th>Acción</th><th>Usuario / rol</th><th>Estado anterior</th><th>Estado nuevo</th><th>Observación</th><th>Fecha</th></tr></thead><tbody>@foreach(var h in Model.Historial){<tr><td>@h.Accion</td><td>@h.Usuario<br/><small>@h.Rol</small></td><td>@h.EstadoAnterior</td><td>@h.EstadoNuevo</td><td>@h.Observacion</td><td>@h.Fecha.ToString("dd/MM/yyyy HH:mm")</td></tr>}</tbody></table></div></div>
 @if(Model.Observaciones.Any()){<div class="card border-warning shadow-sm mb-3"><div class="card-header"><strong>Verificación de observaciones</strong></div><div class="card-body">@foreach(var o in Model.Observaciones){<div class="border rounded p-2 mb-2"><strong>@o.TipoDocumento · @o.Seccion · @o.Campo</strong><p class="mb-1">@o.Texto</p><span class="badge bg-secondary">@o.Estado</span><small> Corrección #@o.DocumentoCorreccionId v@o.VersionCorreccion</small>@if(o.Estado=="ATENDIDA_INSPECTOR"){using(Html.BeginForm("CerrarObservacionDocumento","AocrDcav",FormMethod.Post,new{@class="mt-2"})){@Html.AntiForgeryToken()@Html.Hidden("observacionId",o.ObservacionId)@Html.Hidden("solicitudId",Model.SolicitudId)@Html.Hidden("inspeccionId",Model.InspeccionId)@Html.Hidden("documentoCorreccionId",o.DocumentoCorreccionId)<button class="btn btn-sm btn-outline-success" type="submit">VERIFICAR Y CERRAR</button>}}</div>}</div></div>}
 <div class="row g-3"><div class="col-lg-5"><div class="card border-success shadow-sm"><div class="card-body">@using(Html.BeginForm("AprobarDocumentos","AocrDcav",FormMethod.Post,new{id="frmAprobarDocumentos"})){@Html.AntiForgeryToken()@HiddenDecision()<button class="btn btn-success w-100" type="submit" id="btnAprobarDocumentos">APROBAR AOCR Y CONDICIONES</button>}</div></div></div>
 <div class="col-lg-7"><div class="card border-danger shadow-sm"><div class="card-body"><h5>DEVOLVER AL INSPECTOR</h5><p class="text-muted">Registre cada observación en el documento, sección y campo exactos.</p>@using(Html.BeginForm("DevolverDocumentos","AocrDcav",FormMethod.Post,new{id="frmDevolverDocumentos"})){@Html.AntiForgeryToken()@HiddenDecision()<div id="observacionesDcav"></div><button class="btn btn-sm btn-outline-secondary mb-3" type="button" id="agregarObservacion">+ Agregar observación</button><button class="btn btn-outline-danger w-100" type="submit">DEVOLVER DOCUMENTOS SELECCIONADOS</button>}</div></div></div></div>
</div>
@helper HiddenDecision(){@Html.Hidden("SolicitudId",Model.SolicitudId)@Html.Hidden("InspeccionId",Model.InspeccionId)@Html.Hidden("EstadoEsperado",Model.Estado)@Html.Hidden("VersionExpediente",Model.VersionExpediente)@Html.Hidden("AocrId",Model.Aocr.DocumentoId)@Html.Hidden("VersionAocr",Model.Aocr.Version)@Html.Hidden("AocrPdfId",Model.Aocr.PdfId)@Html.Hidden("CondicionesId",Model.Condiciones.DocumentoId)@Html.Hidden("VersionCondiciones",Model.Condiciones.Version)@Html.Hidden("CondicionesPdfId",Model.Condiciones.PdfId)@Html.Hidden("ClaveIdempotencia",Model.SolicitudId+":"+Model.InspeccionId+":"+Model.Aocr.DocumentoId+":"+Model.Aocr.Version+":"+Model.Condiciones.DocumentoId+":"+Model.Condiciones.Version+":APROBAR_DOCUMENTOS_DCAV")}
@section Scripts{
<script>
(function(){var host=document.getElementById('observacionesDcav'),n=0;
 function add(){var i=n++,box=document.createElement('div');box.className='border rounded p-2 mb-2 observacion-dcav';box.innerHTML='<div class="row g-2"><div class="col-md-5"><label class="form-label">Documento</label><select class="form-select" name="Observaciones['+i+'].TipoDocumento" required><option value="">Seleccione</option><option value="RECONOCIMIENTO">AOCR</option><option value="CONDICIONES_LIMITACIONES">Condiciones y Limitaciones</option></select></div><div class="col-md-7"><label class="form-label">Sección</label><input class="form-control" name="Observaciones['+i+'].Seccion" maxlength="200" required></div><div class="col-md-5"><label class="form-label">Campo</label><input class="form-control" name="Observaciones['+i+'].Campo" maxlength="200" required></div><div class="col-md-7"><label class="form-label">Observación</label><textarea class="form-control" name="Observaciones['+i+'].Texto" maxlength="2000" required></textarea></div></div><button type="button" class="btn btn-sm btn-link text-danger quitar">Eliminar</button>';host.appendChild(box);box.querySelector('.quitar').onclick=function(){if(host.children.length>1)box.remove();};}
 document.getElementById('agregarObservacion').onclick=add;document.getElementById('frmDevolverDocumentos').onsubmit=function(e){if(!host.children.length){e.preventDefault();alert('Registre al menos una observación.');}};add();})();
(function(){var f=document.getElementById('frmAprobarDocumentos'),b=document.getElementById('btnAprobarDocumentos');if(!f||!b)return;f.onsubmit=function(e){var ok=window.confirm('Se aprobarán conjuntamente el AOCR y las Condiciones y Limitaciones y el expediente será enviado a firma institucional. Después de confirmar, los documentos no podrán modificarse. ¿Desea continuar?');if(!ok){e.preventDefault();return false;}b.disabled=true;b.textContent='PROCESANDO...';};})();
</script>}
