@model IEnumerable<CapaPresentacion.Models.ViewModels.PendienteRevisionDireccionItemViewModel>
@using System.Collections.Generic
@using System.Linq

@{
    Layout = "~/Views/Shared/_LayoutAOCR.cshtml";
    ViewBag.Title = "Informes Técnicos pendientes";
    var items = Model != null ? Model.ToList() : new List<CapaPresentacion.Models.ViewModels.PendienteRevisionDireccionItemViewModel>();
}

<div class="container-fluid mt-4">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="@Url.Action("DashboardInspeccion", "CoordinacionJefatura")">Dashboard Inspección</a></li>
            <li class="breadcrumb-item active" aria-current="page">Informes Técnicos pendientes de revisión institucional</li>
        </ol>
    </nav>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">
            <div>
                <span class="badge bg-primary-subtle text-primary mb-2">DIRDAC / Dirección - Jefatura</span>
                <h2 class="mb-1">Informes Técnicos pendientes de revisión institucional</h2>
                <p class="text-muted mb-0">Bandeja exclusiva para revisar, aprobar o devolver informes técnicos firmados por el inspector.</p>
            </div>
            <a class="btn btn-outline-secondary" href="@Url.Action("DashboardInspeccion", "CoordinacionJefatura")">
                <i class="fas fa-arrow-left"></i> Volver al dashboard
            </a>
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    @if (!items.Any())
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="alert alert-info mb-0">No existen informes técnicos pendientes de revisión institucional.</div>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Código informe</th>
                                <th>Solicitud AOCR</th>
                                <th>Operadora / EAE</th>
                                <th>Inspector</th>
                                <th>Fecha firma inspector</th>
                                <th>Resultado técnico</th>
                                <th>Estado</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in items)
                            {
                                <tr>
                                    <td>
                                        <strong>#@item.CodigoInforme</strong>
                                        <div class="small text-muted">Inspección @item.CodigoInspeccion</div>
                                    </td>
                                    <td>@item.NumeroSolicitud</td>
                                    <td>@item.NombreOperadora</td>
                                    <td>@item.NombreInspector</td>
                                    <td>@(item.FechaFirmaInspector.HasValue ? item.FechaFirmaInspector.Value.ToString("dd/MM/yyyy HH:mm") : "Pendiente")</td>
                                    <td>@item.ResultadoTecnicoFinal</td>
                                    <td>
                                        <span class="badge @(item.NotificacionFormalEnviada ? "bg-warning text-dark" : "bg-secondary")">@item.EstadoInforme</span>
                                    </td>
                                    <td>
                                        <div class="d-flex flex-wrap gap-2">
                                            <a class="btn btn-sm btn-primary" href="@item.UrlRevision">
                                                <i class="fas fa-balance-scale"></i> Revisar informe
                                            </a>
                                            @if (!string.IsNullOrWhiteSpace(item.UrlPdfInformeFirmadoInspector))
                                            {
                                                <a class="btn btn-sm btn-outline-secondary" href="@item.UrlPdfInformeFirmadoInspector" target="_blank" rel="noopener">
                                                    <i class="fas fa-file-pdf"></i> Ver PDF
                                                </a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>