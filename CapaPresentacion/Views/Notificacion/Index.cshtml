@inherits System.Web.Mvc.WebViewPage<List<CapaModelo.Notificacion>>
@using System.Linq
@using System.Web.Mvc
@using System.Web.Mvc.Html
@{
    ViewBag.Title = "Mis Notificaciones";
    Layout = "~/Views/Shared/_LayoutAOCR.cshtml";
}

@section styles {
    <style>
        .aocr-notifications { width:100%; margin:0; padding:16px 0; color:#163c59; }
        body.aocr-body .aocr-notifications .content-header { padding:0 0 18px; display:flex; justify-content:space-between; align-items:center; gap:16px; flex-wrap:wrap; }
        body.aocr-body .aocr-notifications .content-header h1 { font-size:28px; margin:0; color:#073b63!important; -webkit-text-fill-color:#073b63!important; }
        body.aocr-body .aocr-notifications .notifications-subtitle { display:block; margin:6px 0 0; font-size:14px; color:#425a70!important; -webkit-text-fill-color:#425a70!important; }
        .aocr-notifications .content { padding:0; }
        .aocr-notifications .box { background:#fff; border:1px solid #b8ccdd; border-radius:10px; overflow:hidden; }
        .aocr-notifications .box-header { display:flex; align-items:center; justify-content:space-between; gap:12px; flex-wrap:wrap; padding:14px 16px; background:#e7eff6; border-bottom:1px solid #c6d5e1; }
        body.aocr-body .aocr-notifications .box-title { margin:0; font-size:18px; color:#073b63!important; -webkit-text-fill-color:#073b63!important; }
        .aocr-notifications .box-tools { display:flex; gap:8px; flex-wrap:wrap; }
        .aocr-notifications .box-body { padding:14px; }
        .aocr-notifications .notificacion-item { display:grid; grid-template-columns:minmax(0,1fr) auto; gap:8px 16px; padding:16px; margin-bottom:10px; border:1px solid #c6d5e1; border-left:4px solid #849caf; border-radius:8px; background:#f7f9fc; cursor:pointer; }
        .aocr-notifications .notificacion-item:last-child { margin-bottom:0; }
        .aocr-notifications .notificacion-item.no-leida { background:#edf5ff; border-left-color:#0752a0; }
        .aocr-notifications .notificacion-item:hover { border-color:#0752a0; }
        .aocr-notifications .notificacion-item.leida { opacity:1; }
        .aocr-notifications .notificacion-header { grid-column:1; display:flex; align-items:center; justify-content:space-between; gap:12px; flex-wrap:wrap; }
        body.aocr-body .aocr-notifications .notificacion-titulo { font-size:15px; font-weight:700; color:#123c60!important; -webkit-text-fill-color:#123c60!important; overflow-wrap:anywhere; }
        body.aocr-body .aocr-notifications .notificacion-fecha { font-size:12px; color:#425a70!important; -webkit-text-fill-color:#425a70!important; white-space:nowrap; }
        body.aocr-body .aocr-notifications .notificacion-mensaje { grid-column:1; font-size:14px; line-height:1.5; margin:0; color:#344b60!important; -webkit-text-fill-color:#344b60!important; overflow-wrap:anywhere; }
        .aocr-notifications .notificacion-acciones { grid-column:2; grid-row:1 / span 2; align-self:center; }
        body.aocr-body .aocr-notifications .notificacion-icono { margin-right:8px; color:#0752a0!important; -webkit-text-fill-color:#0752a0!important; }
        body.aocr-body .aocr-notifications .badge-tipo { display:inline-block; margin-left:8px; padding:4px 7px; font-size:11px; background:#d5e7fa!important; color:#164d80!important; -webkit-text-fill-color:#164d80!important; }
        body.aocr-body .aocr-notifications .btn, body.aocr-body .aocr-notifications .btn i { color:#fff!important; -webkit-text-fill-color:#fff!important; }
        .aocr-notifications .btn-primary { background:#0752a0!important; }
        .aocr-notifications .btn-success { background:#087647!important; }
        .aocr-notifications .btn-danger { background:#b42337!important; }
        body.aocr-body .aocr-notifications .alert-info, body.aocr-body .aocr-notifications .alert-info p, body.aocr-body .aocr-notifications .alert-info h4 { background:#edf5ff; color:#163c59!important; -webkit-text-fill-color:#163c59!important; }
        @@media(max-width:600px) {
            .aocr-notifications .notificacion-item { grid-template-columns:1fr; }
            .aocr-notifications .notificacion-acciones { grid-column:1; grid-row:auto; justify-self:end; }
            .aocr-notifications .box-tools { width:100%; }
            .aocr-notifications .box-tools .btn { flex:1; }
        }
    </style>
}

<div class="aocr-notifications">
    <section class="content-header">
        <div>
        <h1>
            <i class="fa fa-bell"></i> Mis Notificaciones
        </h1>
        <p class="notifications-subtitle">Centro de notificaciones del sistema</p>
        </div>
        <ol class="aocr-breadcrumb breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")"><i class="fa fa-dashboard"></i> Inicio</a></li>
            <li class="breadcrumb-item active">Notificaciones</li>
        </ol>
    </section>

    <section class="content">
        <div class="row">
            <div class="col-md-12">
                <div class="box box-primary">
                    <div class="box-header with-border">
                        <h3 class="box-title">
                            <i class="fa fa-list"></i> Todas las notificaciones
                        </h3>
                        <div class="box-tools pull-right">
                            <button type="button" class="btn btn-sm btn-success" id="btnMarcarTodasLeidas" title="Marcar todas como leídas">
                                <i class="fa fa-check-double"></i> Marcar todas leídas
                            </button>
                            <button type="button" class="btn btn-sm btn-danger" id="btnEliminarLeidas" title="Eliminar notificaciones leídas">
                                <i class="fa fa-trash"></i> Limpiar leídas
                            </button>
                        </div>
                    </div>
                    <div class="box-body">
                        @if (Model == null || Model.Count == 0)
                        {
                            <div class="alert alert-info text-center">
                                <i class="fa fa-info-circle fa-3x"></i>
                                <h4>No tienes notificaciones</h4>
                                <p>Aquí aparecerán las notificaciones del sistema sobre tus solicitudes, inspecciones y pagos.</p>
                            </div>
                        }
                        else
                        {
                            <div id="listaNotificaciones">
                                @foreach (var notif in Model.OrderByDescending(n => n.FechaCreacion))
                                {
                                    var cssClass = notif.Leida ? "notificacion-item leida" : "notificacion-item no-leida";
                                    var icono = CapaDatos.Constants.TiposNotificacion.ObtenerIcono(notif.Tipo);
                                    var color = CapaDatos.Constants.TiposNotificacion.ObtenerColorBadge(notif.Tipo);

                                    <div class="@cssClass" data-id="@notif.CodigoNotificacion" data-url="@notif.Url" data-leida="@notif.Leida.ToString().ToLower()">
                                        <div class="notificacion-header">
                                            <div>
                                                <i class="@icono notificacion-icono"></i>
                                                <span class="notificacion-titulo">
                                                    @notif.Titulo
                                                    <span class="badge @color badge-tipo">@notif.Tipo</span>
                                                </span>
                                            </div>
                                            <span class="notificacion-fecha">
                                                @(notif.FechaCreacion.HasValue ? notif.FechaCreacion.Value.ToString("dd/MM/yyyy HH:mm") : "")
                                            </span>
                                        </div>
                                        <div class="notificacion-mensaje">
                                            @notif.Mensaje
                                        </div>
                                        @if (!notif.Leida)
                                        {
                                            <div class="notificacion-acciones">
                                                <button type="button" class="btn btn-xs btn-primary btnMarcarLeida" data-id="@notif.CodigoNotificacion" title="Marcar como leída">
                                                    <i class="fa fa-check" aria-hidden="true"></i> Marcar leída
                                                </button>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

@section scripts {
    <script>
        $(document).ready(function () {

            // Marcar notificación individual como leída
            $(document).on('click', '.btnMarcarLeida', function (e) {
                e.stopPropagation();
                var id = $(this).data('id');
                marcarComoLeida(id);
            });

            // Click en notificación completa
            $(document).on('click', '.notificacion-item', function () {
                var id = $(this).data('id');
                var url = $(this).data('url');
                var leida = $(this).data('leida') === 'true';

                if (!leida) {
                    marcarComoLeida(id);
                }

                if (url && url !== '') {
                    window.location.href = url;
                }
            });

            // Marcar todas como leídas
            $('#btnMarcarTodasLeidas').on('click', function () {
                if (confirm('¿Deseas marcar todas las notificaciones como leídas?')) {
                    $.ajax({
                        url: '@Url.Action("MarcarTodasComoLeidas", "Notificacion")',
                        type: 'POST',
                        success: function (result) {
                            if (result.success) {
                                location.reload();
                            } else {
                                alert('Error: ' + result.message);
                            }
                        },
                        error: function () {
                            alert('Error al marcar notificaciones');
                        }
                    });
                }
            });

            // Eliminar notificaciones leídas
            $('#btnEliminarLeidas').on('click', function () {
                if (confirm('¿Deseas eliminar todas las notificaciones ya leídas?')) {
                    $.ajax({
                        url: '@Url.Action("EliminarTodas", "Notificacion")',
                        type: 'POST',
                        success: function (result) {
                            if (result.success) {
                                location.reload();
                            } else {
                                alert('Error: ' + result.message);
                            }
                        },
                        error: function () {
                            alert('Error al eliminar notificaciones');
                        }
                    });
                }
            });

            // Función para marcar como leída
            function marcarComoLeida(id) {
                $.ajax({
                    url: '@Url.Action("MarcarComoLeida", "Notificacion")',
                    type: 'POST',
                    data: { id: id },
                    success: function (result) {
                        if (result.success) {
                            var $item = $('[data-id="' + id + '"]');
                            $item.removeClass('no-leida').addClass('leida');
                            $item.find('.btnMarcarLeida').remove();
                            $item.data('leida', 'true');
                        }
                    }
                });
            }
        });
    </script>
}

