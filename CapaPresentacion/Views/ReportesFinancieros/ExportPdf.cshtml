@inherits System.Web.Mvc.WebViewPage<CapaPresentacion.Models.ViewModels.ReportesFinancierosViewModel>
@using System.Linq
@{
    Layout = null;
    var r = (Model != null && Model.Resumen != null)
        ? Model.Resumen
        : new CapaModelo.ReportesFinancieros.ReporteResumenDTO();
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Reporte Financiero AOCR</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            font-size: 11px;
            color: #1f2937;
            margin: 16px;
        }

        h1 {
            font-size: 18px;
            margin: 0;
        }

        .meta {
            margin: 8px 0 14px 0;
            font-size: 10px;
            color: #4b5563;
        }

        .kpi {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 12px;
        }

        .kpi td {
            border: 1px solid #cbd5e1;
            padding: 6px 8px;
        }

        .kpi .label {
            font-weight: bold;
            background: #f8fafc;
        }

        table.data {
            width: 100%;
            border-collapse: collapse;
        }

        table.data th,
        table.data td {
            border: 1px solid #cbd5e1;
            padding: 5px 6px;
            vertical-align: top;
        }

        table.data th {
            background: #f1f5f9;
            text-align: left;
        }

        .text-right {
            text-align: right;
        }
    </style>
</head>
<body>
    <h1>Reporte Financiero AOCR</h1>
    <div class="meta">
        Generado: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")
        @if ((Model != null && Model.Filtros != null && Model.Filtros.FechaDesde != null) ||
             (Model != null && Model.Filtros != null && Model.Filtros.FechaHasta != null))
        {
            <text> | Periodo: @((Model != null && Model.Filtros != null && Model.Filtros.FechaDesde.HasValue) ? Model.Filtros.FechaDesde.Value.ToString("dd/MM/yyyy") : "-") - @((Model != null && Model.Filtros != null && Model.Filtros.FechaHasta.HasValue) ? Model.Filtros.FechaHasta.Value.ToString("dd/MM/yyyy") : "-")</text>
        }
    </div>

    <table class="kpi">
        <tr>
            <td class="label">Total ordenes generadas</td>
            <td>@r.TotalOrdenesGeneradas.ToString("N0")</td>
            <td class="label">Total ordenes pagadas</td>
            <td>@r.TotalOrdenesPagadas.ToString("N0")</td>
            <td class="label">Pendientes</td>
            <td>@r.TotalPendientes.ToString("N0")</td>
        </tr>
        <tr>
            <td class="label">Anuladas</td>
            <td>@r.TotalAnuladas.ToString("N0")</td>
            <td class="label">Total recaudado</td>
            <td>$@r.TotalRecaudado.ToString("N2")</td>
            <td class="label">Pendiente por cobrar</td>
            <td>$@r.TotalPendientePorCobrar.ToString("N2")</td>
        </tr>
    </table>

    <table class="data">
        <thead>
            <tr>
                <th>Orden</th>
                <th>Fecha</th>
                <th>Usuario</th>
                <th>Estado</th>
                <th>Tramite</th>
                <th>Unidad</th>
                <th class="text-right">Total</th>
                <th class="text-right">Pagado</th>
                <th class="text-right">Saldo</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Ordenes != null && Model.Ordenes.Any())
            {
                foreach (var item in Model.Ordenes.Take(400))
                {
                    <tr>
                        <td>@item.NumeroOrden</td>
                        <td>@item.FechaCreacion.ToString("dd/MM/yyyy")</td>
                        <td>@item.UsuarioSolicitante</td>
                        <td>@item.Estado</td>
                        <td>@item.TipoTramite</td>
                        <td>@item.Unidad</td>
                        <td class="text-right">$@item.Total.ToString("N2")</td>
                        <td class="text-right">$@item.MontoPagado.ToString("N2")</td>
                        <td class="text-right">$@item.SaldoPendiente.ToString("N2")</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="9">No existen datos para el filtro aplicado.</td>
                </tr>
            }
        </tbody>
    </table>
</body>
</html>
