<?xml version="1.0" encoding="utf-8"?>
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">

  <system.web>
    <!-- COMPILACIÓN: Asegurar debug false -->
    <compilation debug="false" xdt:Transform="SetAttributes(debug)" />

    <!-- ERRORES: Modo producción conservando las vistas custom -->
    <customErrors mode="On" defaultRedirect="~/Error" xdt:Transform="SetAttributes(mode)">
    </customErrors>

    <!-- TRACE: Desactivado -->
    <trace enabled="false" localOnly="true" xdt:Transform="SetAttributes(enabled,localOnly)" />

    <!-- HTTP RUNTIME: Evitar version headers -->
    <httpRuntime enableVersionHeader="false" xdt:Transform="SetAttributes(enableVersionHeader)" />

    <!-- COOKIES: Globales -->
    <httpCookies httpOnlyCookies="true" requireSSL="true" sameSite="None" xdt:Transform="InsertIfMissing" />

    <!-- AUTENTICACIÓN: Seguro -->
    <authentication mode="Forms">
      <forms requireSSL="true" xdt:Transform="SetAttributes(requireSSL)" />
    </authentication>

    <!-- SESIÓN: Seguro -->
    <sessionState cookieSameSite="None" xdt:Transform="InsertIfMissing" />
  </system.web>

  <system.webServer>
    <!-- ERRORES HTTP: IIS enruta a MVC -->
    <httpErrors existingResponse="Replace" xdt:Transform="SetAttributes(existingResponse)">
    </httpErrors>

    <!-- SEGURIDAD: Prevenir acceso a App_Data -->
    <security>
      <requestFiltering>
        <hiddenSegments xdt:Transform="InsertIfMissing">
          <add segment="App_Data" xdt:Transform="InsertIfMissing" xdt:Locator="Match(segment)" />
        </hiddenSegments>
      </requestFiltering>
    </security>
  </system.webServer>

</configuration>
