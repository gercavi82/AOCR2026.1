@model CapaNegocio.Services.CertificadoAOCRViewModel
@{
    Layout = "~/Views/Shared/_PdfLayoutDGACAocr.cshtml";
    var cultureEs = new System.Globalization.CultureInfo("es-EC");
    Func<string, string> safe = s => !string.IsNullOrWhiteSpace(s) ? System.Web.HttpUtility.HtmlEncode(s) : "---";
}

@section PdfHead {
<style>
    /* ============================================
       CERTIFICADO AOCR — CSS EXCLUSIVO
       Tamaño A4 (210×297mm)
       ============================================ */
    @@page {
        size: A4 portrait;
        margin: 8mm 10mm 10mm 10mm;
    }

    body {
        font-family: "Times New Roman", "Georgia", serif;
        font-size: 9pt;
        line-height: 1.3;
        color: #1a1a1a;
        margin: 0;
        padding: 6mm 8mm;
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
    }

    /* ---------- ENCABEZADO ---------- */
    .cert-header {
        text-align: center;
        border-bottom: 2.5px solid #003366;
        padding-bottom: 6px;
        margin-bottom: 4px;
    }

    .cert-header-title {
        font-size: 11pt;
        font-weight: bold;
        color: #003366;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin: 0 0 1px 0;
    }

    .cert-header-subtitle {
        font-size: 9pt;
        color: #555;
        font-style: italic;
        margin: 0;
    }

    /* ---------- TABLA PRINCIPAL ---------- */
    .cert-main-table {
        width: 100%;
        border-collapse: collapse;
        table-layout: fixed;
        margin-top: 4px;
        border: 1.5px solid #003366;
    }

    .cert-main-table td {
        border: 1px solid #8fa8c8;
        padding: 4px 6px;
        vertical-align: top;
        font-size: 8.5pt;
        word-wrap: break-word;
        overflow-wrap: anywhere;
    }

    .cert-main-table .cell-header {
        background-color: #eef3f9;
        font-weight: bold;
        color: #003366;
        font-size: 7.5pt;
        text-transform: uppercase;
        padding: 3px 6px;
    }

    .cell-value {
        font-size: 8.5pt;
        color: #111;
        min-height: 14px;
    }

    /* ---------- BLOQUES CENTRALES ---------- */
    .cert-top-row {
        display: table;
        width: 100%;
        border-bottom: 1.5px solid #003366;
    }

    .cert-top-cell {
        display: table-cell;
        vertical-align: middle;
        padding: 6px 8px;
    }

    .cert-logo-cell {
        width: 120px;
        text-align: center;
    }

    .cert-logo-cell img {
        max-height: 60px;
        max-width: 100px;
    }

    .cert-republic-cell {
        text-align: center;
    }

    .cert-republic-cell .republic-title {
        font-size: 9pt;
        font-weight: bold;
        color: #003366;
        margin: 0;
    }

    .cert-republic-cell .republic-sub {
        font-size: 8pt;
        color: #003366;
        margin: 0;
    }

    .cert-republic-cell .republic-en {
        font-size: 7.5pt;
        color: #666;
        font-style: italic;
        margin: 0;
    }

    .cert-permiso-cell {
        width: 200px;
        text-align: center;
        font-size: 7.5pt;
    }

    .cert-permiso-cell .permiso-title {
        font-weight: bold;
        color: #003366;
        font-size: 8pt;
        margin: 0;
    }

    /* ---------- SECCIONES BILINGÜE ---------- */
    .lbl-es {
        font-weight: bold;
        font-size: 8pt;
        color: #003366;
        display: block;
        margin: 0;
    }

    .lbl-en {
        font-size: 7pt;
        color: #777;
        font-style: italic;
        display: block;
        margin: 0;
    }

    /* ---------- TEXTO LEGAL ---------- */
    .cert-legal {
        border: 1.5px solid #003366;
        border-top: none;
        padding: 6px 8px;
        font-size: 7.5pt;
        line-height: 1.35;
        text-align: justify;
        color: #222;
    }

    .cert-legal p {
        margin: 3px 0;
    }

    /* ---------- FIRMAS ---------- */
    .cert-firma-section {
        border: 1.5px solid #003366;
        border-top: none;
        padding: 6px 8px;
    }

    .cert-firma-table {
        width: 100%;
        border-collapse: collapse;
    }

    .cert-firma-table td {
        padding: 4px 6px;
        vertical-align: top;
        font-size: 8pt;
    }

    .firma-label {
        font-weight: bold;
        color: #003366;
        font-size: 8pt;
    }

    .firma-value {
        font-size: 8.5pt;
        padding-top: 2px;
    }

    /* ---------- PIE ---------- */
    .cert-footer {
        border: 1.5px solid #003366;
        border-top: none;
        display: table;
        width: 100%;
        font-size: 7pt;
        color: #666;
        font-style: italic;
    }

    .cert-footer-cell {
        display: table-cell;
        padding: 3px 8px;
        vertical-align: middle;
    }

    .cert-footer-left { text-align: left; }
    .cert-footer-center { text-align: center; }
    .cert-footer-right { text-align: right; }

    /* ---------- UTILIDADES ---------- */
    .text-center { text-align: center; }
    .text-right { text-align: right; }
    .no-border-top { border-top: none !important; }
    .no-border-bottom { border-bottom: none !important; }
    .col-left { width: 33%; }
    .col-center { width: 34%; }
    .col-right { width: 33%; }
    .section-separator { border-top: 1.5px solid #003366; }
</style>
}

<!-- =============================================
     ENCABEZADO DEL CERTIFICADO
     ============================================= -->
<div class="cert-header">
    <p class="cert-header-title">RECONOCIMIENTO DE CERTIFICADO DE EXPLOTADOR DE SERVICIOS AEREOS</p>
    <p class="cert-header-subtitle">AIR OPERATOR CERTIFICATE RECOGNIZED</p>
</div>

<!-- =============================================
     BLOQUE SUPERIOR: LOGO + REPÚBLICA + PERMISO
     ============================================= -->
<table class="cert-main-table" style="margin-top:4px;">
    <!-- Fila 1: Logo / República / Permiso -->
    <tr>
        <td rowspan="2" style="width:33%; text-align:center; vertical-align:middle; border-bottom:none;">
            @if (!string.IsNullOrWhiteSpace(Model.LogoBase64))
            {
                <img src="data:image/png;base64,@Model.LogoBase64" style="max-height:55px; max-width:90px;" alt="DGAC" />
            }
        </td>
        <td style="width:34%; text-align:center; vertical-align:middle; border-bottom:none;">
            <p style="font-size:9.5pt; font-weight:bold; color:#003366; margin:0;">REPUBLICA DEL ECUADOR</p>
            <p style="font-size:7pt; color:#777; font-style:italic; margin:0;">REPUBLIC OF ECUADOR</p>
            <p style="font-size:8.5pt; font-weight:bold; color:#003366; margin:3px 0 0 0;">DIRECCION GENERAL<br/>DE AVIACION CIVIL</p>
            <p style="font-size:7pt; color:#777; font-style:italic; margin:0;">CIVIL AVIATION<br/>GENERAL DIRECTORATE</p>
        </td>
        <td style="width:33%; text-align:center; vertical-align:top;">
            <p style="font-weight:bold; color:#003366; font-size:8pt; margin:0 0 4px 0;">PERMISO OPERACION CNAC</p>
            <p style="font-size:7pt; color:#777; font-style:italic; margin:0;">CNAC OPERATION PERMIT</p>
            <br/>
            <span class="lbl-es">Fecha de Emision / <span class="lbl-en" style="display:inline;">Date of issue:</span></span>
            <span class="cell-value">@Model.FechaEmision.ToString("dd/MM/yyyy", cultureEs)</span>
            <br/><br/>
            <span class="lbl-es">Fecha de Vencimiento / <span class="lbl-en" style="display:inline;">Expiry date:</span></span>
            <span class="cell-value">@(Model.FechaVencimiento.HasValue ? Model.FechaVencimiento.Value.ToString("dd/MM/yyyy", cultureEs) : "---")</span>
        </td>
    </tr>
</table>

<!-- =============================================
     CUERPO: 3 COLUMNAS PRINCIPALES
     ============================================= -->
<table class="cert-main-table" style="border-top:none;">
    <!-- Fila: AOCR#/AOC / Nombre Explotador / Contacto Ecuador -->
    <tr>
        <td class="col-left" style="border-top:1.5px solid #003366;">
            <span class="lbl-es">AOCR #</span>
            <span class="cell-value" style="font-weight:bold; font-size:9pt;">@safe(Model.NumeroAOCR)</span>
            <br/><br/>
            <span style="font-size:7.5pt; color:#444;">
                Otorgado en base al AOC No. ---<br/>
                emitido por (Estado Explotador)
            </span>
            <br/>
            <span class="lbl-en">Issued based don the original AOC granted by (State of the Operator)</span>
            <br/><br/>
            <span class="lbl-es">Fecha de Vencimiento:</span>
            <span class="lbl-en">/ Expiry date</span>
            <span class="cell-value">@(Model.FechaVencimiento.HasValue ? Model.FechaVencimiento.Value.ToString("dd/MM/yyyy", cultureEs) : "---")</span>
        </td>
        <td class="col-center" style="text-align:center; border-top:1.5px solid #003366;">
            <span class="lbl-es" style="font-size:9pt;">NOMBRE DEL EXPLOTADOR</span>
            <span class="lbl-en">OPERATOR NAME</span>
            <br/>
            <span class="cell-value" style="font-weight:bold; font-size:9.5pt;">@safe(Model.NombreExplotador)</span>
            <br/><br/>
            <span class="lbl-es">Estado del Explotador:</span>
            <span class="lbl-en">/ Operator State:</span>
            <br/>
            <span class="cell-value">@safe(Model.EstadoExplotador)</span>
        </td>
        <td class="col-right" style="border-top:1.5px solid #003366;">
            <span class="lbl-es">PUNTO DE CONTACTO ECUADOR:</span>
            <span class="lbl-en">/ ECUADOR CONTACT POINT:</span>
            <br/><br/>
            <span style="font-size:7.5pt; color:#444;">
                La informacion de contacto donde se puede ubicar al Representante Legal.
            </span>
            <br/>
            <span class="lbl-en">/The contact information where you can locate the Legal Representative.</span>
        </td>
    </tr>

    <!-- Fila: Puntos de contacto / Razón Social / Dirección contacto -->
    <tr>
        <td class="col-left">
            <span class="lbl-es">PUNTOS DE CONTACTO OPERACIONALES:</span>
            <span class="lbl-en">/OPERATIONAL POINTS OF CONTACT:</span>
            <br/><br/>
            <span style="font-size:7pt; color:#444;">
                La informacion de contacto donde se puede ubicar a las autoridades de gestion operacional sin demoras indebidas se proporciona en:
            </span>
            <br/>
            <span class="lbl-en">/Contact details where operational management authorities can be contacted without undue delay, are listed in:</span>
        </td>
        <td class="col-center" style="text-align:center;">
            <span class="lbl-es" style="font-size:9pt;">Razon Social:</span>
            <span class="lbl-en">/ trade name:</span>
            <br/>
            <span class="cell-value" style="font-weight:bold;">@safe(Model.RazonSocial)</span>
            <br/><br/>
            <span class="cell-value">---</span>
            <br/><br/>
            <span class="lbl-es">Direccion del explotador:</span>
            <span class="lbl-en">/ Operator address:</span>
            <br/>
            <span class="cell-value">@safe(Model.DireccionExplotador)</span>
            <br/><br/>
            <span class="cell-value">---</span>
        </td>
        <td class="col-right">
            <span class="lbl-es">Direccion / <span class="lbl-en" style="display:inline;">Address:</span></span>
            <span class="cell-value">@safe(Model.DireccionContactoEcuador)</span>
            <br/><br/>
            <span class="cell-value">---</span>
            <br/><br/>
            <span class="lbl-es">Telefono / <span class="lbl-en" style="display:inline;">Telephone:</span></span>
            <span class="cell-value">@safe(Model.TelefonoContactoEcuador)</span>
            <br/><br/>
            <span class="cell-value">---</span>
            <br/><br/>
            <span class="lbl-es">Correo-e / <span class="lbl-en" style="display:inline;">Email:</span></span>
            <span class="cell-value">@safe(Model.CorreoContactoEcuador)</span>
        </td>
    </tr>

    <!-- Fila: GSO + RT / Teléfono-Correo central / (vacío) -->
    <tr>
        <td class="col-left">
            <span class="lbl-es" style="font-style:italic;">"Gerencia de Seguridad Operacional"</span>
            <span class="lbl-en" style="font-style:italic;">-Operational Safety Manager's office:</span>
            <br/>
            <span class="cell-value">@safe(Model.GerenciaSeguridadOperacional)</span>
            <br/><br/>
            <span class="lbl-es">Direccion / <span class="lbl-en" style="display:inline;">Address:</span></span>
            <span class="cell-value">@safe(Model.DireccionGSO)</span>
            <br/><br/>
            <span class="lbl-es">Telefono / <span class="lbl-en" style="display:inline;">Telephone:</span></span>
            <span class="cell-value">@safe(Model.TelefonoGSO)</span>
            <br/><br/>
            <span class="lbl-es">Correo-e / <span class="lbl-en" style="display:inline;">Email:</span></span>
            <span class="cell-value">@safe(Model.CorreoGSO)</span>
        </td>
        <td class="col-center" style="text-align:center;">
            <span class="lbl-es">Telefono / <span class="lbl-en" style="display:inline;">telephone:</span></span>
            <span class="cell-value">@safe(Model.TelefonoExplotador)</span>
            <br/><br/>
            <span class="cell-value">---</span>
            <br/><br/>
            <span class="lbl-es">Correo-e / <span class="lbl-en" style="display:inline;">E-mail:</span></span>
            <span class="cell-value">@safe(Model.CorreoExplotador)</span>
        </td>
        <td class="col-right">&nbsp;</td>
    </tr>

    <!-- Fila: Representante Técnico -->
    <tr>
        <td class="col-left">
            <span class="lbl-es" style="font-style:italic;">"Representante Tecnico" / <span class="lbl-en" style="display:inline;">"Technical Representative"</span></span>
            <br/>
            <span class="cell-value">@safe(Model.RepresentanteTecnico)</span>
            <br/><br/>
            <span class="lbl-es">Direccion / <span class="lbl-en" style="display:inline;">Address:</span></span>
            <span class="cell-value">@safe(Model.DireccionRT)</span>
            <br/><br/>
            <span class="lbl-es">Telefono / <span class="lbl-en" style="display:inline;">Telephone:</span></span>
            <span class="cell-value">@safe(Model.TelefonoRT)</span>
            <br/><br/>
            <span class="lbl-es">Correo e / <span class="lbl-en" style="display:inline;">Email:</span></span>
            <span class="cell-value">@safe(Model.CorreoRT)</span>
        </td>
        <td class="col-center" colspan="2">&nbsp;</td>
    </tr>
</table>

<!-- =============================================
     TEXTO LEGAL BILINGÜE
     ============================================= -->
<div class="cert-legal">
    <p>@Html.Raw(System.Web.HttpUtility.HtmlEncode(Model.TextoLegalEs ?? "").Replace("\n", "<br/>"))</p>
    <p style="font-style:italic; color:#444;">@Html.Raw(System.Web.HttpUtility.HtmlEncode(Model.TextoLegalEn ?? "").Replace("\n", "<br/>"))</p>
</div>

<!-- =============================================
     FIRMA + FECHAS
     ============================================= -->
<div class="cert-firma-section">
    <table class="cert-firma-table">
        <tr>
            <td style="width:50%;">
                <span class="firma-label">Fecha de expedicion</span>
                <span class="lbl-en">/ Date of issue:</span>
                <br/>
                <span class="firma-value">@Model.FechaEmision.ToString("dd/MM/yyyy", cultureEs)</span>
                <br/><br/>
                <span class="firma-label">Fecha de renovacion</span>
                <span class="lbl-en">/ Date of Renovation</span>
                <br/>
                <span class="firma-value">@(Model.FechaRenovacion.HasValue ? Model.FechaRenovacion.Value.ToString("dd/MM/yyyy", cultureEs) : "---")</span>
            </td>
            <td style="width:50%; text-align:center;">
                <span class="firma-label">Nombre y firma</span>
                <span class="lbl-en">/ Name and signature :</span>
                <br/><br/>
                @if (!string.IsNullOrWhiteSpace(Model.RutaFirmaDigital))
                {
                    <img src="@Model.RutaFirmaDigital" style="max-height:45px;" alt="Firma" />
                    <br/>
                }
                <br/>
                <div style="border-top:1.5px solid #000; width:70%; margin:8px auto 4px; padding-top:4px;">
                    <span style="font-weight:bold; font-size:8.5pt;">@safe(Model.NombreFirmante)</span>
                </div>
                <span class="firma-label">Titulo: @safe(Model.TituloFirmante)</span>
                <br/>
                <span class="lbl-en">/ Title: Director General of Civil Aviation</span>
            </td>
        </tr>
    </table>
</div>

<!-- =============================================
     PIE DE PÁGINA
     ============================================= -->
<div class="cert-footer">
    <span class="cert-footer-cell cert-footer-left"><em>Enmienda No.: @Model.NumeroEnmienda</em></span>
    <span class="cert-footer-cell cert-footer-center">9</span>
    <span class="cert-footer-cell cert-footer-right"><em>Actualizada: @DateTime.Now.ToString("dd/MM/yyyy")</em></span>
</div>
