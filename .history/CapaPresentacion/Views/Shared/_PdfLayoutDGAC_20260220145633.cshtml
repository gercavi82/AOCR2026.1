@using CapaNegocio.Helpers
@{
    Layout = null;
    var assets = PdfBrandingHelper.ResolveAssets("Views/Shared/_PdfLayoutDGAC.cshtml");
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <style>
        @@page {
            size: A4;
            margin-top: 120px;
            margin-bottom: 80px;
            margin-left: 25px;
            margin-right: 25px;
        }

        html,
        body {
            margin: 0;
            padding: 0;
            width: 100%;
            font-family: "Times New Roman", serif;
            font-size: 12px;
            color: #111;
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
        }

        #pdf-header {
            position: fixed;
            top: -110px;
            left: 0;
            right: 0;
            height: 110px;
            z-index: 10;
            width: 95%;
            margin: 0 auto;
            text-align: center;
            padding-left: 30px;
            padding-right: 30px;
            box-sizing: border-box;
        }

        #pdf-footer {
            position: fixed;
            bottom: -60px;
            left: 0;
            right: 0;
            height: 60px;
            z-index: 10;
            width: 95%;
            margin: 0 auto;
            text-align: center;
            padding-left: 30px;
            padding-right: 30px;
            box-sizing: border-box;
        }

        #pdf-header img,
        #pdf-footer img {
            display: block;
            max-height: 90px;
            height: auto;
            width: auto;
            margin: 0 auto;
        }

        #pdf-content {
            position: relative;
            z-index: 20;
            width: 95%;
            margin: 0 auto;
            padding-top: 8px;
        }
        
        /* Mejorar jerarquía visual de títulos */
        .pdf-title {
            font-size: 20px;
            font-weight: bold;
            text-align: center;
            margin-bottom: 2px;
        }
        .pdf-subtitle {
            font-size: 16px;
            font-weight: bold;
            text-align: center;
            margin-bottom: 2px;
        }
        .pdf-section-title {
            font-size: 14px;
            font-weight: bold;
            margin-top: 10px;
            margin-bottom: 4px;
        }
        .pdf-table {
            width: 100%;
            border-collapse: collapse;
            margin: 0 auto;
        }
        .pdf-table th, .pdf-table td {
            border: 1px solid #222;
            padding: 6px 4px;
            font-size: 12px;
        }
        .pdf-table th {
            background: #f2f2f2;
            font-weight: bold;
            text-align: center;
        }
        .pdf-table td {
            text-align: left;
        }
        .pdf-table .totales {
            font-weight: bold;
            background: #e6e6e6;
        }
    </style>
    @RenderSection("PdfHead", required: false)
</head>
<body>
    <div id="pdf-header">
        @if (assets.HeaderExists && !string.IsNullOrWhiteSpace(assets.HeaderDataUri))
        {
            <img src="@assets.HeaderDataUri" alt="Header institucional DGAC" />
        }
    </div>

    <div id="pdf-footer">
        @if (assets.FooterExists && !string.IsNullOrWhiteSpace(assets.FooterDataUri))
        {
            <img src="@assets.FooterDataUri" alt="Footer institucional DGAC" />
        }
    </div>

    <div id="pdf-content">
        @RenderBody()
    </div>
</body>
