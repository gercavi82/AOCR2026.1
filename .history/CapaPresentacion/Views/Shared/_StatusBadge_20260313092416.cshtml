@inherits System.Web.Mvc.WebViewPage
@using System
@{
    var statusRaw = ViewData["Status"] != null ? ViewData["Status"].ToString() : string.Empty;
    var status = (statusRaw ?? string.Empty).Trim();
    var statusNorm = status.ToUpperInvariant();
    var css = "status-pendiente";

    if (statusNorm.Contains("APROBAD") || statusNorm.Contains("LEGALIZ") || statusNorm.Contains("SUBSAN"))
    {
        css = "status-aprobado";
    }
    else if (statusNorm.Contains("RECHAZ"))
    {
        css = "status-rechazado";
    }
    else if (statusNorm.Contains("OBSERV"))
    {
        css = "status-observado";
    }
    else if (statusNorm.Contains("REVISION") || statusNorm.Contains("TRAMITE") || statusNorm.Contains("ENVIADO"))
    {
        css = "status-en-revision";
    }
}

<span class="aocr-status-badge @css">@status</span>
