@inherits System.Web.Mvc.WebViewPage
@{
    var iconClass = ViewData["IconClass"] != null ? ViewData["IconClass"].ToString() : "fas fa-inbox";
    var title = ViewData["Title"] != null ? ViewData["Title"].ToString() : "Sin registros";
    var description = ViewData["Description"] != null ? ViewData["Description"].ToString() : string.Empty;
    var actionUrl = ViewData["ActionUrl"] != null ? ViewData["ActionUrl"].ToString() : string.Empty;
    var actionText = ViewData["ActionText"] != null ? ViewData["ActionText"].ToString() : string.Empty;
}

<div class="aocr-empty aocr-empty-state">
    <div class="aocr-empty-icon aocr-empty-state-icon"><i class="@iconClass"></i></div>
    <h5 class="aocr-empty-title mb-2">@title</h5>
    @if (!string.IsNullOrWhiteSpace(description))
    {
        <p class="aocr-empty-text mb-3">@description</p>
    }
    @if (!string.IsNullOrWhiteSpace(actionUrl) && !string.IsNullOrWhiteSpace(actionText))
    {
        <a href="@actionUrl" class="btn btn-primary btn-sm">@actionText</a>
    }
</div>
