@inherits System.Web.Mvc.WebViewPage
@{
    var title = ViewData["Title"] != null ? ViewData["Title"].ToString() : string.Empty;
    var iconClass = ViewData["IconClass"] != null ? ViewData["IconClass"].ToString() : "fas fa-layer-group";
    var bodyHtml = ViewData["BodyHtml"] != null ? ViewData["BodyHtml"].ToString() : string.Empty;
}

<div class="card aocr-section-card mb-3">
    <div class="card-body">
        @if (!string.IsNullOrWhiteSpace(title))
        {
            <h5 class="aocr-section-title"><i class="@iconClass mr-1"></i> @title</h5>
        }
        @if (!string.IsNullOrWhiteSpace(bodyHtml))
        {
            @Html.Raw(bodyHtml)
        }
    </div>
</div>
