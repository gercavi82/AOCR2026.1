@inherits System.Web.Mvc.WebViewPage
@using System
@{
    var statusRaw = ViewData["Status"] != null ? ViewData["Status"].ToString() : string.Empty;
    var status = (statusRaw ?? string.Empty).Trim();
    var statusNorm = status.ToUpperInvariant();
    var cssStatus = "status-pendiente";
    var cssAocr = "aocr-badge-pendiente";

    if (statusNorm.Contains("SUBSAN"))
    {
        cssStatus = "status-subsanado";
        cssAocr = "aocr-badge-subsanado";
    }
    else if (statusNorm.Contains("LEGALIZ"))
    {
        cssStatus = "status-legalizado";
        cssAocr = "aocr-badge-legalizado";
    }
    else if (statusNorm.Contains("APROBAD"))
    {
        cssStatus = "status-aprobado";
        cssAocr = "aocr-badge-aprobado";
    }
    else if (statusNorm.Contains("RECHAZ"))
    {
        cssStatus = "status-rechazado";
        cssAocr = "aocr-badge-rechazado";
    }
    else if (statusNorm.Contains("OBSERV"))
    {
        cssStatus = "status-observado";
        cssAocr = "aocr-badge-observado";
    }
    else if (statusNorm.Contains("REVISION") || statusNorm.Contains("TRAMITE") || statusNorm.Contains("ENVIADO"))
    {
        cssStatus = "status-en-revision";
        cssAocr = "aocr-badge-enrevision";
    }
}

<span class="aocr-badge aocr-status-badge @cssStatus @cssAocr">@status</span>
