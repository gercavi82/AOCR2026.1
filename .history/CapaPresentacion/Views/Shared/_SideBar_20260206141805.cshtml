@inherits System.Web.Mvc.WebViewPage
@using CapaModelo
@using System.Web.Mvc.Html
@using CapaDatos.DAOs

@{
    // =============================
    // CONTEXTO DEL USUARIO
    // =============================
    var contextoUsuario = ObtenerContextoUsuario();
}

<style>
/* ========================================
   SIDEBAR EMPRESARIAL - DISEÑO AOCR
   ======================================== */

.aocr-sidebar {
    --primary-color: #1B4F72;
    --primary-light: #0C7C86;
    --accent-color: #0C7C86;
    --success-color: #28a745;
    --warning-color: #ffc107;
    --danger-color: #dc3545;
    --sidebar-bg: #1B4F72;
    --card-bg: rgba(255, 255, 255, 0.05);
    --border-color: rgba(255, 255, 255, 0.1);
    --text-primary: #ffffff;
    --text-secondary: rgba(255, 255, 255, 0.7);
    --hover-bg: rgba(12, 124, 134, 0.2);
    
    width: 280px;
    min-height: 100vh;
    background: linear-gradient(180deg, #1B4F72 0%, #0C7C86 100%);
    color: var(--text-primary);
    display: flex;
    flex-direction: column;
    box-shadow: 2px 0 10px rgba(0, 0, 0, 0.1);
    position: relative;
    overflow-y: auto;
    padding: 0;
}

/* CABECERA */
.sidebar-header {
    padding: 20px 16px;
    text-align: center;
    border-bottom: 1px solid var(--border-color);
    background: rgba(0, 0, 0, 0.1);
}

.logo {
    max-height: 60px;
    border-radius: 8px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
    margin-bottom: 12px;
    transition: transform 0.2s ease;
}

.logo:hover {
    transform: scale(1.02);
}

.user-info {
    margin-top: 12px;
}

.status-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    border-radius: 12px;
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    background: rgba(255, 255, 255, 0.15);
}

.status-active {
    background: rgba(40, 167, 69, 0.2);
    border: 1px solid rgba(40, 167, 69, 0.4);
    color: #6ee7b7;
}

.pulse {
    animation: pulse-dot 2s ease-in-out infinite;
}

@@keyframes pulse-dot {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
}

.user-email {
    color: var(--text-secondary);
    font-size: 0.85rem;
    margin-top: 6px;
}

/* ESTADO DE ÓRDENES */
.orden-status-card {
    margin: 16px 12px;
    padding: 12px;
    border-radius: 8px;
    border-left: 3px solid;
    display: flex;
    align-items: flex-start;
    gap: 10px;
    transition: all 0.2s ease;
    background: rgba(255, 255, 255, 0.08);
}

.orden-status-card:hover {
    background: rgba(255, 255, 255, 0.12);
}

.status-success {
    border-left-color: var(--success-color);
}

.status-warning {
    border-left-color: var(--warning-color);
}

.status-danger {
    border-left-color: var(--danger-color);
}

.status-icon {
    font-size: 1.2rem;
    opacity: 0.9;
    min-width: 20px;
}

.status-success .status-icon { color: var(--success-color); }
.status-warning .status-icon { color: var(--warning-color); }
.status-danger .status-icon { color: var(--danger-color); }

.status-content {
    flex: 1;
}

.status-title {
    font-size: 0.8rem;
    font-weight: 600;
    margin: 0 0 3px 0;
}

.status-description {
    font-size: 0.7rem;
    color: var(--text-secondary);
    margin: 0 0 6px 0;
}

.status-action-btn {
    display: inline-block;
    padding: 4px 10px;
    border-radius: 4px;
    background: var(--accent-color);
    color: white;
    text-decoration: none;
    font-size: 0.7rem;
    font-weight: 500;
    transition: all 0.2s ease;
}

.status-action-btn:hover {
    background: #0a6570;
    text-decoration: none;
    color: white;
}

/* NAVEGACIÓN */
.sidebar-nav {
    flex: 1;
    padding: 8px 0;
}

.nav-section {
    margin-bottom: 4px;
}

.section-header {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 16px 6px;
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    color: var(--text-secondary);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}

.dashboard-section .section-header {
    background: rgba(12, 124, 134, 0.15);
    color: rgba(255, 255, 255, 0.9);
}

.nav-menu {
    list-style: none;
    margin: 0;
    padding: 4px 0;
}

.nav-menu li {
    margin: 1px 8px;
}

.nav-link {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    color: var(--text-primary);
    text-decoration: none;
    border-radius: 6px;
    transition: all 0.2s ease;
    font-size: 0.85rem;
    position: relative;
}

.nav-link:hover {
    background: var(--hover-bg);
    color: #ffffff;
    text-decoration: none;
    padding-left: 16px;
}

.nav-link i {
    width: 18px;
    text-align: center;
    opacity: 0.85;
    font-size: 0.95rem;
}

.nav-link:hover i {
    opacity: 1;
}

.primary-dashboard {
    background: rgba(12, 124, 134, 0.25);
    border: 1px solid rgba(12, 124, 134, 0.4);
    font-weight: 600;
}

.primary-dashboard:hover {
    background: rgba(12, 124, 134, 0.35);
    color: #ffffff;
}

.badge {
    font-size: 0.65rem;
    padding: 2px 6px;
    border-radius: 8px;
    font-weight: 600;
    margin-left: auto;
}

.badge-primary {
    background: var(--accent-color);
    color: white;
}

.badge-warning {
    background: var(--warning-color);
    color: #333;
}

/* PIE DEL SIDEBAR */
.sidebar-footer {
    padding: 12px 0;
    border-top: 1px solid var(--border-color);
    background: rgba(0, 0, 0, 0.15);
}

.footer-menu {
    list-style: none;
    margin: 0;
    padding: 0 8px;
}

.footer-menu li {
    margin: 1px 0;
}

.warning-link {
    color: var(--warning-color) !important;
    font-weight: 600;
}

.warning-link:hover {
    background: rgba(255, 193, 7, 0.15);
    color: #ffd454 !important;
}

.logout-link {
    color: #ff6b6b !important;
    font-weight: 600;
}

.logout-link:hover {
    background: rgba(220, 53, 69, 0.15);
    color: #ff8787 !important;
}

/* RESPONSIVE */
@@media (max-width: 768px) {
    .aocr-sidebar {
        width: 100%;
        position: fixed;
        top: 0;
        left: -100%;
        z-index: 1000;
        transition: left 0.3s ease;
    }
    
    .aocr-sidebar.mobile-open {
        left: 0;
    }
}

/* ESTADOS ESPECIALES */
.nav-link[data-disabled="true"] {
    opacity: 0.4;
    cursor: not-allowed;
    pointer-events: none;
}

/* SCROLLBAR PERSONALIZADA */
.aocr-sidebar::-webkit-scrollbar {
    width: 5px;
}

.aocr-sidebar::-webkit-scrollbar-track {
    background: rgba(0, 0, 0, 0.1);
}

.aocr-sidebar::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.2);
    border-radius: 3px;
}

.aocr-sidebar::-webkit-scrollbar-thumb:hover {
    background: rgba(255, 255, 255, 0.3);
}
</style>

<!-- SIDEBAR EMPRESARIAL OPTIMIZADO -->
<aside class="aocr-sidebar" role="navigation" aria-label="Menú principal" id="mainSidebar">
    
    @* CABECERA DEL USUARIO *@
    <header class="sidebar-header">
        <img src="@Url.Content("~/Content/imganes/logodgac.jpg")" 
             alt="DGAC - Dirección General de Aviación Civil" 
             class="logo" 
             title="Sistema AOCR" />
        
        <div class="user-info">
            <div class="user-status">
                <span class="status-badge status-active">
                    <i class="fas fa-circle pulse"></i> EN LÍNEA
                </span>
            </div>
            <div class="user-email" title="Usuario actual">@Session["Correo"]</div>
            @Html.Partial("_SeleccionarRol")
        </div>
    </header>

    @* INDICADOR DE ESTADO ÓRDENES *@
    @if (contextoUsuario.RequiereOrden)
    {
        <div class="orden-status-card @(contextoUsuario.TieneOrdenGenerada ? "status-success" : contextoUsuario.TieneOrdenBorrador ? "status-warning" : "status-danger")">
            <div class="status-icon">
                @if (contextoUsuario.TieneOrdenGenerada)
                {
                    <i class="fas fa-check-circle"></i>
                }
                else if (contextoUsuario.TieneOrdenBorrador)
                {
                    <i class="fas fa-clock"></i>
                }
                else
                {
                    <i class="fas fa-exclamation-circle"></i>
                }
            </div>
            <div class="status-content">
                <h4 class="status-title">
                    @if (contextoUsuario.TieneOrdenGenerada)
                    {
                        @:Sistema Disponible
                    }
                    else if (contextoUsuario.TieneOrdenBorrador)
                    {
                        @:Orden Pendiente
                    }
                    else
                    {
                        @:Orden Requerida
                    }
                </h4>
                <p class="status-description">
                    @if (contextoUsuario.TieneOrdenGenerada)
                    {
                        @:Acceso completo al sistema
                    }
                    else if (contextoUsuario.TieneOrdenBorrador)
                    {
                        @:Complete su orden para continuar
                    }
                    else
                    {
                        @:Debe crear una orden de recaudación
                    }
                </p>
                @if (!contextoUsuario.TieneOrdenGenerada)
                {
                    <a href="@Url.Action("Obligatoria", "OrdenRecaudacion")" 
                       class="status-action-btn">
                        @(contextoUsuario.TieneOrdenBorrador ? "Completar Orden" : "Crear Orden")
                    </a>
                }
            </div>
        </div>
    }

    @* NAVEGACIÓN PRINCIPAL *@
    <nav class="sidebar-nav" role="menubar">
        
        @* DASHBOARD PRINCIPAL *@
        <section class="nav-section dashboard-section">
            <div class="section-header">
                <i class="fas fa-tachometer-alt"></i>
                <span>Dashboard</span>
            </div>
            <ul class="nav-menu" role="menu">
                <li role="menuitem">
                    <a href="@Url.Action("Index", "Dashboard")" 
                       class="nav-link primary-dashboard"
                       data-analytics="dashboard-principal"
                       title="Panel de control principal">
                        <i class="fas fa-chart-line"></i>
                        <span>Dashboard Principal</span>
                        <span class="badge badge-primary">ACTIVO</span>
                    </a>
                </li>
            </ul>
        </section>

        @* MÓDULO ÓRDENES DE RECAUDACIÓN *@
        <section class="nav-section">
            <div class="section-header">
                <i class="fas fa-file-invoice-dollar"></i>
                <span>Órdenes de Recaudación</span>
            </div>
            <ul class="nav-menu">
                <li>
                    <a href="@Url.Action("Index", "OrdenRecaudacion")" 
                       class="nav-link"
                       title="Gestión de órdenes">
                        <i class="fas fa-list"></i>
                        <span>Mis Órdenes</span>
                        @if (contextoUsuario.TieneOrdenBorrador)
                        {
                            <span class="badge badge-warning">!</span>
                        }
                    </a>
                </li>
                @if (contextoUsuario.PuedeSolicitante)
                {
                    <li>
                        <a href="@Url.Action("Index", "SolicitudAOCR")" 
                           class="nav-link"
                           title="Solicitudes AOCR">
                            <i class="fas fa-plane"></i>
                            <span>Solicitudes AOCR</span>
                        </a>
                    </li>
                }
            </ul>
        </section>

        @* MÓDULO TÉCNICO *@
        @if (contextoUsuario.PuedeTecnica)
        {
            <section class="nav-section">
                <div class="section-header">
                    <i class="fas fa-cogs"></i>
                    <span>Área Técnica</span>
                </div>
                <ul class="nav-menu">
                    <li>
                        <a href="@Url.Action("Index", "Inspeccion")" 
                           class="nav-link"
                           title="Inspecciones técnicas">
                            <i class="fas fa-search"></i>
                            <span>Inspecciones</span>
                        </a>
                    </li>
                    <li>
                        <a href="@Url.Action("Index", "Checklist")" 
                           class="nav-link"
                           title="Listas de verificación">
                            <i class="fas fa-tasks"></i>
                            <span>Checklists</span>
                        </a>
                    </li>
                </ul>
            </section>
        }

        @* MÓDULO FINANCIERO *@
        @if (contextoUsuario.PuedeFinanciero)
        {
            <section class="nav-section">
                <div class="section-header">
                    <i class="fas fa-money-bill-wave"></i>
                    <span>Área Financiera</span>
                </div>
                <ul class="nav-menu">
                    <li>
                        <a href="@Url.Action("Index", "Financiero")" 
                           class="nav-link"
                           title="Validación financiera">
                            <i class="fas fa-coins"></i>
                            <span>Validación</span>
                        </a>
                    </li>
                    <li>
                        <a href="@Url.Action("Index", "Reportes")" 
                           class="nav-link"
                           title="Reportes financieros">
                            <i class="fas fa-chart-bar"></i>
                            <span>Reportes</span>
                        </a>
                    </li>
                </ul>
            </section>
        }

        @* MÓDULO ADMINISTRATIVO *@
        @if (contextoUsuario.EsRolAdministrativo)
        {
            <section class="nav-section">
                <div class="section-header">
                    <i class="fas fa-users-cog"></i>
                    <span>Administración</span>
                </div>
                <ul class="nav-menu">
                    <li>
                        <a href="@Url.Action("Index", "Usuario")" 
                           class="nav-link"
                           title="Gestión de usuarios">
                            <i class="fas fa-users"></i>
                            <span>Usuarios</span>
                        </a>
                    </li>
                    <li>
                        <a href="@Url.Action("Index", "Auditoria")" 
                           class="nav-link"
                           title="Auditoría del sistema">
                            <i class="fas fa-clipboard-list"></i>
                            <span>Auditoría</span>
                        </a>
                    </li>
                    @if (contextoUsuario.PuedeDireccion)
                    {
                        <li>
                            <a href="@Url.Action("Index", "Direccion")" 
                               class="nav-link"
                               title="Gestión de direcciones">
                                <i class="fas fa-map-marker-alt"></i>
                                <span>Direcciones</span>
                            </a>
                        </li>
                    }
                </ul>
            </section>
        }

        @* CONFIGURACIÓN *@
        <section class="nav-section">
            <div class="section-header">
                <i class="fas fa-cog"></i>
                <span>Configuración</span>
            </div>
            <ul class="nav-menu">
                <li>
                    <a href="@Url.Action("Profile", "Account")" 
                       class="nav-link"
                       title="Mi perfil de usuario">
                        <i class="fas fa-user-circle"></i>
                        <span>Mi Perfil</span>
                    </a>
                </li>
                <li>
                    <a href="@Url.Action("Help", "Support")" 
                       class="nav-link"
                       title="Ayuda y documentación">
                        <i class="fas fa-question-circle"></i>
                        <span>Ayuda</span>
                    </a>
                </li>
            </ul>
        </section>

    </nav>

    @* PIE DEL SIDEBAR *@
    <footer class="sidebar-footer">
        <ul class="footer-menu">
            <li>
                <a href="@Url.Action("Index", "Home")" 
                   class="nav-link"
                   title="Página de inicio">
                    <i class="fas fa-home"></i>
                    <span>Inicio</span>
                </a>
            </li>
            @if (!contextoUsuario.TieneOrdenGenerada && contextoUsuario.RequiereOrden)
            {
                <li>
                    <a href="@Url.Action("Obligatoria", "OrdenRecaudacion")" 
                       class="nav-link warning-link"
                       title="Crear orden requerida">
                        <i class="fas fa-exclamation-triangle"></i>
                        <span>Orden Requerida</span>
                    </a>
                </li>
            }
            <li>
                <a href="@Url.Action("Logout", "Account")" 
                   class="nav-link logout-link"
                   data-confirm="¿Está seguro que desea cerrar sesión?"
                   title="Cerrar sesión">
                    <i class="fas fa-sign-out-alt"></i>
                    <span>Cerrar Sesión</span>
                </a>
            </li>
        </ul>
    </footer>

</aside>

<script>
// ========================================
// FUNCIONALIDAD AVANZADA DEL SIDEBAR
// ========================================
document.addEventListener('DOMContentLoaded', function() {
    const sidebar = {
        // Confirmar acciones críticas
        confirmAction: function(element) {
            const message = element.getAttribute('data-confirm');
            if (message) {
                return confirm(message);
            }
            return true;
        },

        // Analytics de navegación
        trackNavigation: function(element) {
            const analytics = element.getAttribute('data-analytics');
            if (analytics && typeof gtag !== 'undefined') {
                gtag('event', 'navigation', {
                    'event_category': 'sidebar',
                    'event_label': analytics
                });
            }
        },

        // Marcar link activo
        markActiveLink: function() {
            const currentPath = window.location.pathname.toLowerCase();
            const navLinks = document.querySelectorAll('.nav-link');
            
            navLinks.forEach(link => {
                const href = link.getAttribute('href');
                if (href && currentPath.includes(href.toLowerCase().split('?')[0])) {
                    link.style.background = 'rgba(30, 64, 175, 0.15)';
                    link.style.borderLeft = '3px solid var(--primary-color)';
                    link.style.fontWeight = '600';
                }
            });
        },

        // Responsive mobile
        toggleMobile: function() {
            const sidebar = document.getElementById('mainSidebar');
            if (sidebar) {
                sidebar.classList.toggle('mobile-open');
            }
        }
    };

    // Marcar link activo al cargar
    sidebar.markActiveLink();

    // Event listeners
    document.addEventListener('click', function(e) {
        // Confirmar logout
        const confirmElement = e.target.closest('[data-confirm]');
        if (confirmElement) {
            if (!sidebar.confirmAction(confirmElement)) {
                e.preventDefault();
                return false;
            }
        }

        // Analytics
        const analyticsElement = e.target.closest('[data-analytics]');
        if (analyticsElement) {
            sidebar.trackNavigation(analyticsElement);
        }

        // Auto-close en mobile
        if (e.target.closest('.nav-link') && window.innerWidth <= 768) {
            sidebar.toggleMobile();
        }
    });

    // Keyboard navigation
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
            const mobileSidebar = document.querySelector('.aocr-sidebar.mobile-open');
            if (mobileSidebar) {
                sidebar.toggleMobile();
            }
        }
    });

    // Responsive behavior
    window.addEventListener('resize', function() {
        const sidebar = document.getElementById('mainSidebar');
        if (sidebar && window.innerWidth > 768) {
            sidebar.classList.remove('mobile-open');
        }
    });

    // Exponer funciones globalmente
    window.aocrSidebar = sidebar;
});
</script>

@functions {
    public class ContextoUsuario
    {
        public string RolActual { get; set; }
        public int IdUsuario { get; set; }
        public bool TieneOrdenGenerada { get; set; }
        public bool TieneOrdenBorrador { get; set; }
        public bool RequiereOrden { get; set; }
        public bool EsRolAdministrativo { get; set; }
        public bool PuedeSolicitante { get; set; }
        public bool PuedeTecnica { get; set; }
        public bool PuedeFinanciero { get; set; }
        public bool PuedeLegal { get; set; }
        public bool PuedeDireccion { get; set; }
        public string EmailUsuario { get; set; }
        
        public ContextoUsuario()
        {
            RolActual = "";
            IdUsuario = 0;
            TieneOrdenGenerada = false;
            TieneOrdenBorrador = false;
            RequiereOrden = false;
            EsRolAdministrativo = false;
            PuedeSolicitante = false;
            PuedeTecnica = false;
            PuedeFinanciero = false;
            PuedeLegal = false;
            PuedeDireccion = false;
            EmailUsuario = "";
        }
    }

    private ContextoUsuario ObtenerContextoUsuario()
    {
        var contexto = new ContextoUsuario();
        
        contexto.RolActual = Session["Rol"] != null ? Session["Rol"].ToString() : "";
        contexto.EmailUsuario = Session["Correo"] != null ? Session["Correo"].ToString() : "";

        // Obtener ID de usuario
        var sessionUserId = Session["IdUsuario"];
        if (sessionUserId == null)
        {
            sessionUserId = Session["UserId"];
        }
        
        if (sessionUserId != null)
        {
            int userId;
            if (int.TryParse(sessionUserId.ToString(), out userId))
            {
                contexto.IdUsuario = userId;
            }
        }

        // Determinar permisos por rol
        var rolesOperacionales = new[] { "Operador", "Solicitante", "Inspector", "Tecnico", "Administrador" };
        var rolesAdministrativos = new[] { "Financiero", "JefaturaTecnica", "Direccion", "CoordinacionLegal", "Administrador" };

        contexto.RequiereOrden = rolesOperacionales.Contains(contexto.RolActual);
        contexto.EsRolAdministrativo = rolesAdministrativos.Contains(contexto.RolActual);

        contexto.PuedeSolicitante = new[] { "Operador", "Administrador", "Solicitante" }.Contains(contexto.RolActual);
        contexto.PuedeTecnica = new[] { "Inspector", "Administrador", "Tecnico" }.Contains(contexto.RolActual);
        contexto.PuedeFinanciero = new[] { "Financiero", "Administrador" }.Contains(contexto.RolActual);
        contexto.PuedeLegal = new[] { "CoordinacionLegal", "Administrador" }.Contains(contexto.RolActual);
        contexto.PuedeDireccion = new[] { "Direccion", "JefaturaTecnica", "Administrador" }.Contains(contexto.RolActual);

        // Verificar estado de órdenes (con cache para performance)
        if (contexto.IdUsuario > 0)
        {
            try
            {
                var cacheKey = String.Format("OrdenEstado_{0}", contexto.IdUsuario);
                if (HttpContext.Current.Cache[cacheKey] == null)
                {
                    var daoOR = new OrdenRecaudacionDAO();
                    var estadoOrden = new
                    {
                        TieneGenerada = daoOR.ExisteORGeneradaOPagada(contexto.IdUsuario),
                        TieneBorrador = daoOR.ExisteORMinima(contexto.IdUsuario)
                    };
                    HttpContext.Current.Cache.Insert(cacheKey, estadoOrden, null, DateTime.Now.AddMinutes(5), TimeSpan.Zero);
                }

                var cached = HttpContext.Current.Cache[cacheKey] as dynamic;
                if (cached != null)
                {
                    contexto.TieneOrdenGenerada = cached.TieneGenerada;
                    contexto.TieneOrdenBorrador = cached.TieneBorrador;
                }
            }
            catch (Exception ex)
            {
                System.Diagnostics.Debug.WriteLine(String.Format("_Sidebar: Error consultando estado de orden: {0}", ex.Message));
            }
        }

        return contexto;
    }
}
