@* Partial View para Badge de Notificaciones en Navbar *@
@* Se debe incluir en _Layout.cshtml dentro del navbar *@

<style>
    .notificaciones-dropdown {
        position: relative;
        display: inline-block;
    }

    .notificaciones-bell {
        font-size: 20px;
        color: #fff;
        cursor: pointer;
        position: relative;
        padding: 10px 15px;
    }

    .notificaciones-bell:hover {
        background-color: rgba(255, 255, 255, 0.1);
    }

    .badge-notificaciones {
        position: absolute;
        top: 5px;
        right: 8px;
        background-color: #f56954;
        color: white;
        border-radius: 10px;
        padding: 2px 6px;
        font-size: 11px;
        font-weight: bold;
        min-width: 18px;
        text-align: center;
    }

    .notificaciones-menu {
        display: none;
        position: absolute;
        right: 0;
        top: 100%;
        background-color: white;
        min-width: 350px;
        max-width: 400px;
        box-shadow: 0 4px 8px rgba(0,0,0,0.2);
        border-radius: 4px;
        z-index: 9999;
        margin-top: 5px;
    }

    .notificaciones-menu.show {
        display: block;
    }

    .notificaciones-header {
        background-color: #3c8dbc;
        color: white;
        padding: 10px 15px;
        border-radius: 4px 4px 0 0;
        font-weight: bold;
    }

    .notificaciones-lista {
        max-height: 400px;
        overflow-y: auto;
    }

    .notificacion-mini {
        padding: 12px 15px;
        border-bottom: 1px solid #f0f0f0;
        cursor: pointer;
        transition: background-color 0.2s;
    }

    .notificacion-mini:hover {
        background-color: #f9f9f9;
    }

    .notificacion-mini.no-leida {
        background-color: #e8f4fd;
    }

    .notificacion-mini-titulo {
        font-weight: bold;
        font-size: 13px;
        margin-bottom: 3px;
        color: #333;
    }

    .notificacion-mini-mensaje {
        font-size: 12px;
        color: #666;
        margin-bottom: 3px;
    }

    .notificacion-mini-fecha {
        font-size: 11px;
        color: #999;
    }

    .notificaciones-footer {
        padding: 10px 15px;
        text-align: center;
        border-top: 1px solid #f0f0f0;
        background-color: #f9f9f9;
    }

    .notificaciones-footer a {
        color: #3c8dbc;
        font-size: 13px;
        font-weight: bold;
        text-decoration: none;
    }

    .notificaciones-footer a:hover {
        text-decoration: underline;
    }

    .notificaciones-vacia {
        padding: 30px 15px;
        text-align: center;
        color: #999;
    }
</style>

<li class="notificaciones-dropdown">
    @Html.AntiForgeryToken()
    <a href="#" class="notificaciones-bell" id="notificacionesBell" role="button" tabindex="0" aria-haspopup="true" aria-expanded="false">
        <i class="fa fa-bell" aria-hidden="true"></i>
        <span class="badge-notificaciones" id="badgeNotificaciones" style="display:none;" aria-live="polite" aria-atomic="true">0</span>
    </a>

    <div class="notificaciones-menu" id="notificacionesMenu">
        <div class="notificaciones-header">
            <i class="fa fa-bell"></i> Notificaciones
            <span class="pull-right" id="contadorNotificaciones">0</span>
        </div>
        <div class="notificaciones-lista" id="listaNotificaciones">
            <div class="notificaciones-vacia">
                <i class="fa fa-inbox fa-2x"></i>
                <p>No tienes notificaciones nuevas</p>
            </div>
        </div>
        <div class="notificaciones-footer">
            <a href="@Url.Action("Index", "Notificacion")">
                <i class="fa fa-list"></i> Ver todas las notificaciones
            </a>
        </div>
    </div>
</li>

<script>
    (function _initNotificaciones() {
        if (typeof jQuery === 'undefined') {
            setTimeout(_initNotificaciones, 150);
            return;
        }
        jQuery(function ($) {
        // Variables
        var $bell = $('#notificacionesBell');
        var $menu = $('#notificacionesMenu');
        var $badge = $('#badgeNotificaciones');
        var $contador = $('#contadorNotificaciones');
        var $lista = $('#listaNotificaciones');
        var pollingInterval = 30000;
        var contadorTimer = null;
        var currentLoadRequest = null;

        function getAntiForgeryToken() {
            var token = $('input[name="__RequestVerificationToken"]').val();
            return token || '';
        }

        function escapeHtml(text) {
            return $('<div/>').text(text || '').html();
        }

        function showErrorMessage(msg) {
            $lista.html('<div class="notificaciones-vacia text-danger"><p>' + escapeHtml(msg) + '</p></div>');
        }

        // Toggle menú al hacer click en campana
        $bell.on('click', function (e) {
            e.preventDefault();
            e.stopPropagation();
            var wasOpen = $menu.hasClass('show');
            $menu.toggleClass('show');
            $bell.attr('aria-expanded', (!wasOpen).toString());

            if (!wasOpen) {
                cargarNotificaciones();
            }
        });

        // Soporte teclado (Enter/Space para abrir, Escape para cerrar)
        $bell.on('keydown', function (e) {
            if (e.key === 'Enter' || e.key === ' ') {
                e.preventDefault();
                $(this).click();
            } else if (e.key === 'Escape') {
                $menu.removeClass('show');
                $bell.attr('aria-expanded', 'false');
            }
        });

        // Cerrar menú al hacer click fuera o presionar Escape
        $(document).on('click keydown', function (e) {
            if (e.type === 'click' && !$(e.target).closest('.notificaciones-dropdown').length) {
                $menu.removeClass('show');
                $bell.attr('aria-expanded', 'false');
            }
            if (e.type === 'keydown' && e.key === 'Escape') {
                $menu.removeClass('show');
                $bell.attr('aria-expanded', 'false');
            }
        });

        // Cargar contador inicial
        function cargarContador() {
            if (currentLoadRequest && currentLoadRequest.readyState !== 4) {
                try { currentLoadRequest.abort(); } catch (e) { }
            }
            currentLoadRequest = $.ajax({
                url: '@Url.Action("ContarNoLeidas", "Notificacion")',
                type: 'GET',
                dataType: 'json',
                timeout: 10000,
                success: function (result) {
                    if (result && result.success && result.cantidad > 0) {
                        $badge.text(result.cantidad).show();
                        $contador.text(result.cantidad);
                        $badge.attr('aria-hidden', 'false');
                    } else {
                        $badge.hide();
                        $contador.text('0');
                        $badge.attr('aria-hidden', 'true');
                    }
                },
                error: function () {
                    console.warn('Error al obtener contador de notificaciones');
                }
            });
        }

        // Cargar notificaciones recientes
        function cargarNotificaciones() {
            $lista.html('<div class="notificaciones-vacia"><i class="fa fa-spinner fa-spin fa-2x"></i><p>Cargando...</p></div>');
            $.ajax({
                url: '@Url.Action("ObtenerRecientes", "Notificacion")',
                type: 'GET',
                data: { cantidad: 10 },
                dataType: 'json',
                success: function (result) {
                    if (result && result.success && result.notificaciones && result.notificaciones.length > 0) {
                        renderizarNotificaciones(result.notificaciones);
                    } else {
                        $lista.html('<div class="notificaciones-vacia"><i class="fa fa-inbox fa-2x"></i><p>No tienes notificaciones nuevas</p></div>');
                    }
                },
                error: function () {
                    showErrorMessage('No se pudieron cargar las notificaciones. Intenta nuevamente.');
                }
            });
        }

        function renderizarNotificaciones(notificaciones) {
            $lista.empty();
            $.each(notificaciones, function (i, n) {
                var cssClass = n.leida ? 'notificacion-mini' : 'notificacion-mini no-leida';
                var titulo = escapeHtml(n.titulo);
                var mensaje = escapeHtml(n.mensaje);
                var fecha = escapeHtml(n.fecha);
                var url = escapeHtml(n.url || '');
                var icono = escapeHtml(n.icono || 'fa fa-envelope');

                var $item = $('<div>').addClass(cssClass).attr('data-id', n.id).attr('data-url', url);
                var $titulo = $('<div>').addClass('notificacion-mini-titulo').append($('<i>').addClass(icono)).append(' ').append(document.createTextNode(titulo));
                var $mensaje = $('<div>').addClass('notificacion-mini-mensaje').text(mensaje);
                var $fecha = $('<div>').addClass('notificacion-mini-fecha').append($('<i>').addClass('fa fa-clock-o')).append(' ').append(document.createTextNode(fecha));

                $item.append($titulo).append($mensaje).append($fecha);
                $lista.append($item);
            });
        }

        // Click en notificación individual (delegado)
        $(document).on('click', '.notificacion-mini', function () {
            var $this = $(this);
            var id = $this.data('id');
            var url = $this.data('url');
            var token = getAntiForgeryToken();

            $.ajax({
                url: '@Url.Action("MarcarComoLeida", "Notificacion")',
                type: 'POST',
                data: { id: id },
                headers: { 'RequestVerificationToken': token },
                success: function () {
                    $this.removeClass('no-leida');
                    cargarContador();
                    if (url && url !== '') {
                        window.location.href = url;
                    } else {
                        window.location.href = '@Url.Action("Index", "Notificacion")';
                    }
                },
                error: function () {
                    Swal.fire({ title: 'Error', text: 'No se pudo marcar la notificación como leída. Intenta nuevamente.', icon: 'error' });
                }
            });
        });

        // Auto-refresh cada 30 segundos
        cargarContador();
        if (contadorTimer) { clearInterval(contadorTimer); }
        contadorTimer = setInterval(cargarContador, pollingInterval);
        });
    })();
</script>
