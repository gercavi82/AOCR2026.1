@inherits System.Web.Mvc.WebViewPage
@using CapaModelo
@using System.Web.Mvc.Html
@using CapaDatos.DAOs
@* ~/Views/Shared/_Sidebar.cshtml *@
<div class="aocr-sidebar text-white">
    <div class="sidebar-header text-center">
        <img src="@Url.Content("~/Content/imganes/logodgac.jpg")"
             alt="DGAC Logo"
             class="logo shadow-sm" />

        <div class="mt-3">
            <span class="chip chip-info">USUARIO ACTIVO</span>
            <div class="user-mail">@Session["Correo"]</div>
            <div class="mt-2">
                @Html.Partial("_SeleccionarRol")
            </div>
        </div>
    </div>

    @{
        var rolActual = Session["Rol"] != null ? Session["Rol"].ToString() : "";
        int idUsuario = 0;
        var sessionUserId = Session["IdUsuario"] ?? Session["UserId"];
        if (sessionUserId != null)
        {
            int.TryParse(sessionUserId.ToString(), out idUsuario);
        }

        bool tieneOrdenGenerada = false;
        bool tieneOrdenBorrador = false;
        try
        {
            if (idUsuario > 0)
            {
                // Instancia del DAO para validar estados financieros
                var daoOR = new OrdenRecaudacionDAO();
                tieneOrdenGenerada = daoOR.ExisteORGeneradaOPagada(idUsuario);
                tieneOrdenBorrador = daoOR.ExisteORMinima(idUsuario);
            }
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine("_Sidebar: Error consultando estado de orden: " + ex.Message);
        }

        // Determinar si el usuario requiere orden para su rol
        bool requiereOrden = rolActual == "Operador" || rolActual == "Solicitante" ||
                            rolActual == "Inspector" || rolActual == "Tecnico" ||
                            rolActual == "Administrador";

        // Para roles administrativos/financieros, no requieren orden
        bool esRolAdministrativo = rolActual == "Financiero" || rolActual == "JefaturaTecnica" ||
                                  rolActual == "Direccion" || rolActual == "CoordinacionLegal" || rolActual == "Administrador";
        bool puedeSolicitante = rolActual == "Operador" || rolActual == "Administrador" || rolActual == "Solicitante";
        bool puedeTecnica = rolActual == "Inspector" || rolActual == "Administrador" || rolActual == "Tecnico";
        bool puedeFinanciero = rolActual == "Financiero" || rolActual == "Administrador";
        bool puedeLegal = rolActual == "CoordinacionLegal" || rolActual == "Administrador";
        bool puedeDireccion = rolActual == "Direccion" || rolActual == "JefaturaTecnica" || rolActual == "Administrador";
    }

    <!-- Indicador de estado de orden -->
    @if (requiereOrden)
    {
        <div class="alert @(tieneOrdenGenerada ? "alert-success" : tieneOrdenBorrador ? "alert-warning" : "alert-danger")
             mb-3 py-2 small" role="alert">
            <div class="d-flex align-items-center">
                <i class="fas fa-file-invoice-dollar @(tieneOrdenGenerada ? "text-success" : tieneOrdenBorrador ? "text-warning" : "text-danger")
                   mr-2"></i>
                <div>
                    @if (tieneOrdenGenerada)
                    {
                        <strong>Orden Generada ✓</strong>
                        <div class="text-success small">Puede acceder al sistema</div>
                    }
                    else if (tieneOrdenBorrador)
                    {
                        <strong>Orden en Borrador ⚠</strong>
                        <div class="text-warning small">
                            <a href="@Url.Action("Obligatoria", "OrdenRecaudacion")" class="text-warning">Completar orden</a>
                        </div>
                    }
                    else
                    {
                        <strong>Orden Requerida!</strong>
                        <div class="text-danger small">
                            <a href="@Url.Action("Obligatoria", "OrdenRecaudacion")" class="text-danger">Crear orden primero</a>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    <div class="menu-container">
        <div class="section-title">📊 Dashboard Principal</div>

        @* ================ DASHBOARD EMPRESARIAL PRINCIPAL ================ *@
        <div class="nav-group mb-4 border border-primary rounded p-2" style="background: rgba(0,123,255,0.1);">
            <ul class="aocr-nav">
                <li>
                    <a class="aocr-link fw-bold text-primary" href="@Url.Action("Index", "OrdenRecaudacionDashboardEmpresarial")">
                        <i class="fas fa-tachometer-alt text-primary mr-2"></i> 
                        Dashboard Empresarial
                        <span class="badge bg-primary text-white ms-2">PRINCIPAL</span>
                    </a>
                </li>
            </ul>
        </div>

        <div class="section-title">Menú de Gestión</div>

        @* ===================== ORDENES DE RECAUDACIÓN ===================== *@
        <div class="nav-group mb-4">
            <div class="group-title text-primary">
                <i class="fas fa-file-invoice-dollar mr-1"></i> ÓRDENES DE RECAUDACIÓN
            </div>
            <ul class="aocr-nav">
                <li>
                    <a class="aocr-link @(tieneOrdenBorrador ? "text-warning fw-bold" : "")" href="@(tieneOrdenBorrador ? Url.Action("Obligatoria","OrdenRecaudacion") : Url.Action("Nueva","OrdenRecaudacion"))">
                        <i class="fas fa-plus-circle @(tieneOrdenBorrador ? "text-warning" : "text-success") mr-2"></i>
                        @(tieneOrdenBorrador ? "Completar Orden Pendiente" : "Nueva Orden")
                    </a>
                </li>
                <li>
                    <a class="aocr-link" href="@Url.Action("Obligatoria", "OrdenRecaudacion")">
                        <i class="fas fa-list text-white-50 mr-2"></i> Mis Órdenes
                    </a>
                </li>
                @if (esRolAdministrativo)
                {
                    <li>
                        <a class="aocr-link" href="@Url.Action("Index", "OrdenRecaudacionDashboardEmpresarial")">
                            <i class="fas fa-chart-bar text-white-50 mr-2"></i> Dashboard Completo
                        </a>
                    </li>
                }
            </ul>
        </div>

        @* ================ AVISO TEMPORAL ================ *@
        <div class="alert alert-info small py-2 mb-4">
            <i class="fas fa-info-circle mr-2"></i>
            <strong>Sistema en Optimización:</strong><br>
            <small class="text-muted">
                El módulo de solicitudes AOCR está siendo optimizado. 
                Actualmente el sistema se enfoca en la gestión de órdenes de recaudación.
            </small>
        </div>
                    </li>
                }
            </ul>
        </div>

        @* ===================== SOLICITANTE - TEMPORALMENTE OCULTO ===================== *@
        @* Temporalmente oculto hasta que se complete el módulo de órdenes de recaudación *@
        @if (false && puedeSolicitante) // Deshabilitado temporalmente
        {
            <div class="nav-group mb-4">
                <div class="group-title text-warning">
                    <i class="fas fa-user-edit mr-1"></i> SOLICITANTE
                </div>
                <ul class="aocr-nav">
                    @* Opciones técnicas bloqueadas hasta que exista una orden válida *@
                    @if (tieneOrdenGenerada)
                    {
                        <li>
                            <a class="aocr-link" href="@Url.Action("Index", "SolicitudAOCR", new { abrir = "nueva" })">
                                <i class="fas fa-plus text-success mr-2"></i> Nueva Solicitud AOCR
                            </a>
                        </li>
                    }

                    <li>
                        <a class="aocr-link" href="@Url.Action("Index", "SolicitudAOCR")">
                            <i class="fas fa-folder-open text-white-50 mr-2"></i> Mis Solicitudes
                        </a>
                    </li>

                    @if (tieneOrdenGenerada)
                    {
                        <li>
                            <a class="aocr-link" href="@Url.Action("CargarDocumentos", "SolicitudAOCR")">
                                <i class="fas fa-file-upload text-info mr-2"></i> Cargar Documentos
                            </a>
                        </li>
                    }
                </ul>
            </div>
        }

        @* ===================== INSPECCIÓN / TÉCNICA - TEMPORALMENTE OCULTO ===================== *@
        @* Temporalmente oculto hasta que se complete el módulo de órdenes de recaudación *@
        @if (false && (esRolAdministrativo || tieneOrdenGenerada) && puedeTecnica) // Deshabilitado temporalmente
        {
            <div class="nav-group mb-4">
                <div class="group-title text-info">
                    <i class="fas fa-search mr-1"></i> GESTIÓN TÉCNICA
                </div>
                <ul class="aocr-nav">
                    <li>
                        <a class="aocr-link" href="@Url.Action("RevisarSolicitudes", "SolicitudAOCR")">
                            <i class="fas fa-tasks text-white-50 mr-2"></i> Revisar Solicitudes
                        </a>
                    </li>
                    <li>
                        <a class="aocr-link" href="@Url.Action("AsignarInspector", "Tecnico")">
                            <i class="fas fa-user-check text-white-50 mr-2"></i> Asignar Inspector
                        </a>
                    </li>
                    <li>
                        <a class="aocr-link" href="@Url.Action("RealizarInspeccion", "Inspector")">
                            <i class="fas fa-clipboard-check text-success mr-2"></i> Realizar Inspección
                        </a>
                    </li>
                </ul>
            </div>
        }

        @* ===================== FINANCIERO (solo si la orden ya está generada) ===================== *@
        @if ((esRolAdministrativo || tieneOrdenGenerada) && puedeFinanciero)
        {
            <div class="nav-group mb-4">
                <div class="group-title text-success">
                    <i class="fas fa-money-bill-wave mr-1"></i> ÁREA FINANCIERA
                </div>
                <ul class="aocr-nav">
                    <li><a class="aocr-link" href="@Url.Action("TodasOrdenes", "Financiero")"><i class="fas fa-receipt text-white-50 mr-2"></i> Gestionar Órdenes</a></li>
                    <li><a class="aocr-link" href="@Url.Action("Index", "Financiero")"><i class="fas fa-check-circle text-white-50 mr-2"></i> Verificar Pagos</a></li>
                    <li><a class="aocr-link" href="@Url.Action("Index", "Financiero")"><i class="fas fa-file-invoice text-white-50 mr-2"></i> Reportes Financieros</a></li>
                </ul>
            </div>
        }

        @* ===================== COORDINACIÓN LEGAL (solo si la orden ya está generada) ===================== *@
        @if ((esRolAdministrativo || tieneOrdenGenerada) && puedeLegal)
        {
            <div class="nav-group mb-4">
                <div class="group-title text-purple">
                    <i class="fas fa-balance-scale mr-1"></i> COORDINACIÓN LEGAL
                </div>
                <ul class="aocr-nav">
                    <li><a class="aocr-link" href="@Url.Action("RevisarLegal", "CoordinacionLegal")"><i class="fas fa-gavel text-white-50 mr-2"></i> Revisión Legal</a></li>
                    <li><a class="aocr-link" href="@Url.Action("GenerarCertificados", "CoordinacionLegal")"><i class="fas fa-file-contract text-white-50 mr-2"></i> Generar Certificados</a></li>
                </ul>
            </div>
        }

        @* ===================== DIRECCIÓN / JEFATURA (solo si la orden ya está generada) ===================== *@
        @if ((esRolAdministrativo || tieneOrdenGenerada) && puedeDireccion)
        {
            <div class="nav-group mb-4">
                <div class="group-title text-danger">
                    <i class="fas fa-user-tie mr-1"></i> DIRECCIÓN / JEFATURA
                </div>
                <ul class="aocr-nav">
                    <li><a class="aocr-link" href="@Url.Action("DashboardGerencial", "Direccion")"><i class="fas fa-chart-line text-white-50 mr-2"></i> Dashboard Gerencial</a></li>
                    <li><a class="aocr-link" href="@Url.Action("AprobarSolicitudes", "Direccion")"><i class="fas fa-check-double text-white-50 mr-2"></i> Aprobar Solicitudes</a></li>
                    <li><a class="aocr-link" href="@Url.Action("ConfiguracionSistema", "Administrador")"><i class="fas fa-cogs text-white-50 mr-2"></i> Configuración Sistema</a></li>
                </ul>
            </div>
        }
    </div>

    <hr class="bg-secondary opacity-25" />

    <div class="mt-auto">
        <ul class="aocr-nav">
            <li>
                <a class="aocr-link" href="@Url.Action("Index", "Home")">
                    <i class="fas fa-home text-info mr-2"></i> Dashboard Inicio
                </a>
            </li>

            @if (!tieneOrdenGenerada && requiereOrden)
            {
                <li>
                    <a class="aocr-link text-warning fw-bold" href="@Url.Action("Obligatoria", "OrdenRecaudacion")">
                        <i class="fas fa-exclamation-triangle text-warning mr-2"></i> ⚠ Orden Requerida
                    </a>
                </li>
            }

            <li>
                <a class="aocr-link text-danger fw-bold" href="@Url.Action("Logout", "Account")">
                    <i class="fas fa-sign-out-alt text-danger mr-2"></i> Cerrar Sesión
                </a>
            </li>
        </ul>
    </div>
</div>

<style>
    .aocr-sidebar {
        min-height: 100vh;
        width: 260px;
        padding: 18px 18px 24px;
        background: radial-gradient(circle at 20% 20%, rgba(33,150,243,0.14), transparent 45%),
                    linear-gradient(180deg, #0f172a 0%, #0a0f1d 100%);
        box-shadow: 4px 0 18px rgba(0,0,0,0.25);
        display: flex;
        flex-direction: column;
        position: relative;
        overflow: hidden;
    }

    .sidebar-header {
        border-bottom: 1px solid rgba(255,255,255,0.08);
        padding-bottom: 14px;
    }

    .logo {
        max-height: 68px;
        border-radius: 10px;
    }

    .chip {
        display: inline-block;
        padding: 4px 10px;
        border-radius: 12px;
        font-size: 0.72rem;
        letter-spacing: 0.6px;
        background: rgba(56, 189, 248, 0.15);
        border: 1px solid rgba(56, 189, 248, 0.35);
    }
    .chip-info { color: #8bd3ff; }

    .user-mail { color: #dbeafe; font-size: 0.9rem; }

    .section-title {
        text-transform: uppercase;
        color: #94a3b8;
        font-size: 0.72rem;
        letter-spacing: 1.2px;
        margin-bottom: 14px;
    }

    .nav-group {
        padding-left: 10px;
        border-left: 2px solid rgba(255,255,255,0.08);
    }
    .group-title {
        font-weight: 700;
        font-size: 0.9rem;
        letter-spacing: 0.3px;
        margin-bottom: 10px;
    }

    .aocr-nav { list-style: none; padding-left: 0; margin: 0; }
    .aocr-nav li { margin-bottom: 8px; }

    .aocr-link {
        color: #e5e7eb;
        text-decoration: none;
        display: flex;
        align-items: center;
        padding: 8px 10px;
        border-radius: 8px;
        transition: all 0.18s ease;
        background: transparent;
    }
    .aocr-link:hover {
        background: rgba(255,255,255,0.06);
        transform: translateX(4px);
        color: #38bdf8 !important;
        text-decoration: none;
    }

    .nav-group .aocr-link i { width: 18px; text-align: center; }

    .alert {
        border: none;
        border-radius: 8px;
        font-size: 0.82rem;
        background: rgba(255,255,255,0.05);
    }

    .text-purple { color: #c084fc; }
</style>

<script>
    (function waitForJQuery() {
        if (typeof jQuery === 'undefined') {
            setTimeout(waitForJQuery, 50);
            return;
        }

        var $ = jQuery;

        // Mostrar tooltip para elementos bloqueados
        $(document).ready(function() {
            $('[title]').tooltip({
                placement: 'right',
                trigger: 'hover'
            });
        });
    })();
</script>






