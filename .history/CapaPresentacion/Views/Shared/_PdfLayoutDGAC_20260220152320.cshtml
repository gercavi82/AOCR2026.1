@using CapaNegocio.Helpers
@using System
@using System.IO
@{
    Layout = null;
    var assets = PdfBrandingHelper.ResolveAssets("Views/Shared/_PdfLayoutDGAC.cshtml");

    // Phase 2: build absolute URLs for wkhtmltopdf (works on IIS and localhost)
    var baseUrl = Request?.Url != null ? Request.Url.Scheme + "://" + Request.Url.Authority : null;
    var headerUrl = baseUrl != null ? baseUrl + Url.Content("~/Content/assets/imganes/pdf/header.png") : null;
    var footerUrl = baseUrl != null ? baseUrl + Url.Content("~/Content/assets/imganes/pdf/footer.png") : null;

    // Base64 fallbacks (Phase 5)
    var headerB64 = assets.HeaderDataUri; // already DataURI or null
    var footerB64 = assets.FooterDataUri;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <style>
        @@page {
          size: A4;
          margin-top: 30mm;
          margin-bottom: 25mm;
          margin-left: 15mm;
          margin-right: 15mm;
        }

        html, body { margin:0; padding:0; font-family: "Times New Roman", serif; font-size:12px }

        #pdf-header { position: fixed; top: -20mm; left:0; right:0; }
        #pdf-footer { position: fixed; bottom: -15mm; left:0; right:0; }

        #pdf-header img, #pdf-footer img { width:100%; height:auto; display:block }

        #pdf-content { position: relative; z-index:20; width:100%; margin:0; }
    </style>
    @RenderSection("PdfHead", required: false)
</head>
<body>
    <div id="pdf-header">
        @{
            var headerSrc = !string.IsNullOrWhiteSpace(headerUrl) ? headerUrl : headerB64;
            if (string.IsNullOrWhiteSpace(headerSrc) && assets.HeaderExists)
            {
                // last resort: try to map physical path -> file:///
                headerSrc = "file:///" + (assets.HeaderPhysicalPath ?? string.Empty).Replace('\\', '/');
            }
        }
        @if (!string.IsNullOrWhiteSpace(headerSrc))
        {
            <img src="@headerSrc" onerror="this.onerror=null;this.src='@(headerB64 ?? string.Empty)';" alt="Header institucional DGAC" />
        }
    </div>

    <div id="pdf-footer">
        @{
            var footerSrc = !string.IsNullOrWhiteSpace(footerUrl) ? footerUrl : footerB64;
            if (string.IsNullOrWhiteSpace(footerSrc) && assets.FooterExists)
            {
                footerSrc = "file:///" + (assets.FooterPhysicalPath ?? string.Empty).Replace('\\', '/');
            }
        }
        @if (!string.IsNullOrWhiteSpace(footerSrc))
        {
            <img src="@footerSrc" onerror="this.onerror=null;this.src='@(footerB64 ?? string.Empty)';" alt="Footer institucional DGAC" />
        }
    </div>

    <div id="pdf-content">
        @RenderBody()
    </div>
</body>
</html>
        }
