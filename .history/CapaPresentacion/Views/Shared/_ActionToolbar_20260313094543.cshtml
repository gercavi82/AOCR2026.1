@inherits System.Web.Mvc.WebViewPage
@{
    var leftTitle = ViewData["LeftTitle"] != null ? ViewData["LeftTitle"].ToString() : string.Empty;
    var leftDescription = ViewData["LeftDescription"] != null ? ViewData["LeftDescription"].ToString() : string.Empty;

    var backUrl = ViewData["BackUrl"] != null ? ViewData["BackUrl"].ToString() : string.Empty;
    var backText = ViewData["BackText"] != null ? ViewData["BackText"].ToString() : "Volver";

    var primaryActionUrl = ViewData["PrimaryActionUrl"] != null ? ViewData["PrimaryActionUrl"].ToString() : string.Empty;
    var primaryActionText = ViewData["PrimaryActionText"] != null ? ViewData["PrimaryActionText"].ToString() : string.Empty;
    var primaryActionIcon = ViewData["PrimaryActionIcon"] != null ? ViewData["PrimaryActionIcon"].ToString() : "fas fa-plus";

    var exportUrl = ViewData["ExportUrl"] != null ? ViewData["ExportUrl"].ToString() : string.Empty;
    var exportText = ViewData["ExportText"] != null ? ViewData["ExportText"].ToString() : "Exportar";

    var filterHtml = ViewData["FilterHtml"] != null ? ViewData["FilterHtml"].ToString() : string.Empty;

    var showSearch = ViewData["ShowSearch"] != null && string.Equals(ViewData["ShowSearch"].ToString(), "true", System.StringComparison.OrdinalIgnoreCase);
    var searchPlaceholder = ViewData["SearchPlaceholder"] != null ? ViewData["SearchPlaceholder"].ToString() : "Buscar";
    var searchInputId = ViewData["SearchInputId"] != null ? ViewData["SearchInputId"].ToString() : "aocrToolbarSearch";
}

<div class="aocr-toolbar aocr-action-toolbar">
    <div class="aocr-toolbar-left">
        @if (!string.IsNullOrWhiteSpace(leftTitle))
        {
            <h5 class="mb-1">@leftTitle</h5>
        }
        @if (!string.IsNullOrWhiteSpace(leftDescription))
        {
            <p class="text-muted mb-0">@leftDescription</p>
        }
    </div>

    <div class="aocr-toolbar-right">
        @if (!string.IsNullOrWhiteSpace(filterHtml))
        {
            @Html.Raw(filterHtml)
        }

        @if (showSearch)
        {
            <input id="@searchInputId" type="text" class="form-control form-control-sm" style="max-width:220px;" placeholder="@searchPlaceholder" />
        }

        @if (!string.IsNullOrWhiteSpace(exportUrl))
        {
            <a href="@exportUrl" class="btn btn-outline-secondary btn-sm">
                <i class="fas fa-file-export mr-1"></i> @exportText
            </a>
        }

        @if (!string.IsNullOrWhiteSpace(backUrl))
        {
            <a href="@backUrl" class="btn btn-outline-secondary btn-sm">
                <i class="fas fa-arrow-left mr-1"></i> @backText
            </a>
        }

        @if (!string.IsNullOrWhiteSpace(primaryActionUrl) && !string.IsNullOrWhiteSpace(primaryActionText))
        {
            <a href="@primaryActionUrl" class="btn btn-primary btn-sm">
                <i class="@primaryActionIcon mr-1"></i> @primaryActionText
            </a>
        }
    </div>
</div>
