@using CapaNegocio.Helpers
@using System
@using System.IO
@{
    Layout = null;
    var assets = PdfBrandingHelper.ResolveAssets("Views/Shared/_PdfLayoutDGAC.cshtml");

    // Phase 2: build absolute URLs for wkhtmltopdf (works on IIS and localhost)
    var baseUrl = (Request != null && Request.Url != null) ? Request.Url.Scheme + "://" + Request.Url.Authority : null;
    var headerUrl = baseUrl != null ? baseUrl + Url.Content("~/Content/assets/imganes/pdf/header.png") : null;
    var footerUrl = baseUrl != null ? baseUrl + Url.Content("~/Content/assets/imganes/pdf/footer.png") : null;

    // Base64 fallbacks (Phase 5)
    var headerB64 = assets.HeaderDataUri; // already DataURI or null
    var footerB64 = assets.FooterDataUri;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
        <style>
                @@page {
                            size: A4;
                            /* Reserve space for header and footer so content doesn't overlap */
                            /* A4 width = 210mm; margins left+right = 15mm each => content width = 180mm */
                            margin-top: 40mm;
                            margin-bottom: 35mm;
                            margin-left: 15mm;
                            margin-right: 15mm;
                        }

                        html, body { margin:0; padding:0; font-family: "Times New Roman", serif; font-size:12px; color:#111; -webkit-print-color-adjust: exact; print-color-adjust: exact; }

                        /* Header/footer fixed to full A4 width (210mm) and centered; content remains within printable area */
                        #pdf-header { position: fixed; top: 0mm; left: 50%; transform: translateX(-50%); z-index:9999; width: 210mm; margin: 0 auto; box-sizing: border-box; }
                        #pdf-footer { position: fixed; bottom: 0mm; left: 50%; transform: translateX(-50%); z-index:9999; width: 210mm; margin: 0 auto; box-sizing: border-box; height:30mm; overflow:hidden; }

                        /* Limit visual height of header/footer to avoid overlapping content */
                        #pdf-header { height: 28mm; overflow: hidden; }
                        #pdf-footer { height: 30mm; }
                        /* Make images span the full A4 width but keep aspect ratio and max heights */
                        #pdf-header img, #pdf-footer img { display:block; margin:0 auto; width:210mm; max-width:100%; height:auto; max-height:28mm; object-fit:cover; }
                        /* ensure content doesn't run into footer */
                        #pdf-content { padding-bottom: 36mm; }

                        /* Ensure content starts below the header reserved area and is centered */
                        #pdf-content { position: relative; z-index:20; width:95%; margin:0 auto; padding-top: 8mm; }

                        /* Document-specific styles */
                        .pdf-title { font-size:20px; font-weight:700; text-align:center; margin-bottom:2px; }
                        .pdf-subtitle { font-size:16px; font-weight:700; text-align:center; margin-bottom:2px; }
                        .pdf-section-title { font-size:14px; font-weight:700; margin-top:10px; margin-bottom:4px; }
                        .pdf-table { width:100%; border-collapse:collapse; margin:0 auto; }
                        .pdf-table th, .pdf-table td { border:1px solid #222; padding:6px 4px; font-size:12px; }
                        .pdf-table th { background:#f2f2f2; font-weight:700; text-align:center; }
                        .pdf-table td { text-align:left; }
                        .pdf-table .totales { font-weight:700; background:#e6e6e6; }
        </style>
    @RenderSection("PdfHead", required: false)
</head>
<body>
    <div id="pdf-header">
        @{
            var headerSrc = !string.IsNullOrWhiteSpace(headerUrl) ? headerUrl : headerB64;
            if (string.IsNullOrWhiteSpace(headerSrc) && assets.HeaderExists)
            {
                // last resort: try to map physical path -> file:///
                headerSrc = "file:///" + (assets.HeaderPhysicalPath ?? string.Empty).Replace('\\', '/');
            }
        }
        @if (!string.IsNullOrWhiteSpace(headerSrc))
        {
            <img src="@headerSrc" onerror="this.onerror=null;this.src='@(headerB64 ?? string.Empty)';" alt="Header institucional DGAC" />
        }
    </div>

    <div id="pdf-footer">
        @{
            var footerSrc = !string.IsNullOrWhiteSpace(footerUrl) ? footerUrl : footerB64;
            if (string.IsNullOrWhiteSpace(footerSrc) && assets.FooterExists)
            {
                footerSrc = "file:///" + (assets.FooterPhysicalPath ?? string.Empty).Replace('\\', '/');
            }
        }
        @if (!string.IsNullOrWhiteSpace(footerSrc))
        {
            <img src="@footerSrc" onerror="this.onerror=null;this.src='@(footerB64 ?? string.Empty)';" alt="Footer institucional DGAC" />
        }
    </div>

    <div id="pdf-content">
        @RenderBody()
    </div>
</body>
</html>
        
