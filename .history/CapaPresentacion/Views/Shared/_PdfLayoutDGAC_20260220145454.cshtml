@using CapaNegocio.Helpers
@{
    Layout = null;
    var assets = PdfBrandingHelper.ResolveAssets("Views/Shared/_PdfLayoutDGAC.cshtml");
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <style>
        @@page {
            size: A4;
            margin-top: 120px;
            margin-bottom: 80px;
            margin-left: 25px;
            margin-right: 25px;
        }

        html,
        body {
            margin: 0;
            padding: 0;
            width: 100%;
            font-family: "Times New Roman", serif;
            font-size: 12px;
            color: #111;
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
        }

        #pdf-header {
            position: fixed;
            top: -110px;
            left: 0;
            right: 0;
            height: 110px;
            z-index: 10;
            width: 95%;
            margin: 0 auto;
            text-align: center;
            padding-left: 30px;
            padding-right: 30px;
            box-sizing: border-box;
        }

        #pdf-footer {
            position: fixed;
            bottom: -60px;
            left: 0;
            right: 0;
            height: 60px;
            z-index: 10;
            width: 95%;
            margin: 0 auto;
            text-align: center;
            padding-left: 30px;
            padding-right: 30px;
            box-sizing: border-box;
        }

        #pdf-header img,
        #pdf-footer img {
            display: block;
            width: 100%;
            height: auto;
            max-height: 100%;
            object-fit: contain;
        }

        #pdf-content {
            position: relative;
            z-index: 20;
            width: 95%;
            margin: 0 auto;
        }
    </style>
    @RenderSection("PdfHead", required: false)
</head>
<body>
    <div id="pdf-header">
        <div style="color: red; font-size: 20px; font-weight: bold; text-align: center;">HEADER DEBUG</div>
        @if (assets.HeaderExists && !string.IsNullOrWhiteSpace(assets.HeaderDataUri))
        {
            <img src="@assets.HeaderDataUri" alt="Header institucional DGAC" />
        }
    </div>

    <div id="pdf-footer">
        @if (assets.FooterExists && !string.IsNullOrWhiteSpace(assets.FooterDataUri))
        {
            <img src="@assets.FooterDataUri" alt="Footer institucional DGAC" />
        }
    </div>

    <div id="pdf-content">
        @RenderBody()
    </div>
</body>
