<script>
// Funcionalidad del Sidebar Moderno
function toggleSidebar() {
    const sidebar = document.getElementById('mainSidebar');
    const overlay = document.getElementById('sidebarOverlay');
    
    if (window.innerWidth <= 768) {
        sidebar.classList.toggle('mobile-open');
        overlay.classList.toggle('active');
    }
}

function logout() {
    if (confirm('¿Está seguro de que desea cerrar sesión?')) {
        window.location.href = '@Url.Action("Logout", "Account")';
    }
}

// Marcar item activo según URL actual
document.addEventListener('DOMContentLoaded', function() {
    const currentPath = window.location.pathname;
    const menuLinks = document.querySelectorAll('.sidebar-menu-link');
    
    menuLinks.forEach(link => {
        const href = link.getAttribute('href');
        if (href && currentPath.includes(href.split('?')[0])) {
            link.classList.add('active');
        }
    });
    
    // Auto-close sidebar en mobile al hacer click en link
    menuLinks.forEach(link => {
        link.addEventListener('click', function() {
            if (window.innerWidth <= 768) {
                toggleSidebar();
            }
        });
    });
});

// Responsive behavior
window.addEventListener('resize', function() {
    const sidebar = document.getElementById('mainSidebar');
    const overlay = document.getElementById('sidebarOverlay');
    
    if (window.innerWidth > 768) {
        sidebar.classList.remove('mobile-open');
        overlay.classList.remove('active');
    }
});
</script>

@functions {
    public class ContextoUsuario
    {
        public string RolActual { get; set; } = "";
        public int IdUsuario { get; set; } = 0;
        public bool TieneOrdenGenerada { get; set; } = false;
        public bool TieneOrdenBorrador { get; set; } = false;
        public bool RequiereOrden { get; set; } = false;
        public bool EsRolAdministrativo { get; set; } = false;
        public bool PuedeSolicitante { get; set; } = false;
        public bool PuedeTecnica { get; set; } = false;
        public bool PuedeFinanciero { get; set; } = false;
        public bool PuedeLegal { get; set; } = false;
        public bool PuedeDireccion { get; set; } = false;
        public string EmailUsuario { get; set; } = "";
    }

    private ContextoUsuario ObtenerContextoUsuario()
    {
        var contexto = new ContextoUsuario
        {
            RolActual = Session["Rol"]?.ToString() ?? "",
            EmailUsuario = Session["Correo"]?.ToString() ?? ""
        };

        // Obtener ID de usuario
        var sessionUserId = Session["IdUsuario"] ?? Session["UserId"];
        if (sessionUserId != null)
        {
            int.TryParse(sessionUserId.ToString(), out contexto.IdUsuario);
        }

        // Determinar permisos por rol
        var rolesOperacionales = new[] { "Operador", "Solicitante", "Inspector", "Tecnico", "Administrador" };
        var rolesAdministrativos = new[] { "Financiero", "JefaturaTecnica", "Direccion", "CoordinacionLegal", "Administrador" };

        contexto.RequiereOrden = rolesOperacionales.Contains(contexto.RolActual);
        contexto.EsRolAdministrativo = rolesAdministrativos.Contains(contexto.RolActual);

        contexto.PuedeSolicitante = new[] { "Operador", "Administrador", "Solicitante" }.Contains(contexto.RolActual);
        contexto.PuedeTecnica = new[] { "Inspector", "Administrador", "Tecnico" }.Contains(contexto.RolActual);
        contexto.PuedeFinanciero = new[] { "Financiero", "Administrador" }.Contains(contexto.RolActual);
        contexto.PuedeLegal = new[] { "CoordinacionLegal", "Administrador" }.Contains(contexto.RolActual);
        contexto.PuedeDireccion = new[] { "Direccion", "JefaturaTecnica", "Administrador" }.Contains(contexto.RolActual);

        // Verificar estado de órdenes (con cache)
        if (contexto.IdUsuario > 0)
        {
            try
            {
                var cacheKey = $"OrdenEstado_{contexto.IdUsuario}";
                if (HttpContext.Current.Cache[cacheKey] == null)
                {
                    var daoOR = new OrdenRecaudacionDAO();
                    var estadoOrden = new
                    {
                        TieneGenerada = daoOR.ExisteORGeneradaOPagada(contexto.IdUsuario),
                        TieneBorrador = daoOR.ExisteORMinima(contexto.IdUsuario)
                    };
                    HttpContext.Current.Cache.Insert(cacheKey, estadoOrden, null, DateTime.Now.AddMinutes(5), TimeSpan.Zero);
                }

                var cached = HttpContext.Current.Cache[cacheKey] as dynamic;
                if (cached != null)
                {
                    contexto.TieneOrdenGenerada = cached.TieneGenerada;
                    contexto.TieneOrdenBorrador = cached.TieneBorrador;
                }
            }
            catch (Exception ex)
            {
                System.Diagnostics.Debug.WriteLine($"_Sidebar: Error consultando estado de orden: {ex.Message}");
            }
        }

        return contexto;
    }
}
