                    <i class="fas fa-cogs me-1"></i>
                    Área Técnica
                </div>
                
                <div class="sidebar-menu-item">
                    <a href="@Url.Action("Index", "Inspeccion")" class="sidebar-menu-link" title="Inspecciones">
                        <div class="sidebar-menu-icon">
                            <i class="fas fa-search"></i>
                        </div>
                        <span class="sidebar-menu-text">Inspecciones</span>
                        <i class="fas fa-chevron-right sidebar-menu-arrow"></i>
                    </a>
                </div>
                
                <div class="sidebar-menu-item">
                    <a href="@Url.Action("Index", "Checklist")" class="sidebar-menu-link" title="Checklists">
