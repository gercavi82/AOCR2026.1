@inherits System.Web.Mvc.WebViewPage<List<CapaDatos.Models.OrdenRecaudacionModel>>
@using CapaModelo
@using System.Web.Mvc
@using System.Web.Mvc.Html
@functions {
    public static string GetTextoTramite(string estado)
    {
        if (string.IsNullOrWhiteSpace(estado))
        {
            return "SIN ESTADO";
        }

        var est = estado.Trim().ToUpperInvariant();
        switch (est)
        {
            case "BORRADOR": return "Borrador";
            case "PENDIENTE": return "Pendiente de pago";
            case "PROCESADA": return "En revisión financiera";
            case "FACTURADA": return "Factura generada";
            case "COMPLETADA": return "Completada";
            case "ANULADA": return "Anulada";
            default: return est;
        }
    }
}

@{
    ViewBag.Title = "Todas las Órdenes de recaudación";
    ViewBag.PageSubtitle = "Área Financiera";
    Layout = "~/Views/Shared/_LayoutAOCR.cshtml";
}

<div class="container-fluid aocr-shell">
    @Html.Partial("_HeroPanel", null, new ViewDataDictionary {
        { "IconClass", "fas fa-file-invoice-dollar" },
        { "Overline", "Control Financiero" },
        { "Title", "Todas las Órdenes de Recaudación" },
        { "Subtitle", "Vista administrativa" },
        { "Description", "Gestione revisión, aprobación y rechazo de órdenes con trazabilidad operativa." },
        { "MetricLabel", "Total órdenes" },
        { "MetricValue", Model != null ? Model.Count : 0 }
    })

    <div class="card aocr-table-card mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">Órdenes de recaudación</h6>
        </div>
        <div class="card-body">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Número Orden</th>
                                <th>Usuario</th>
                                <th>Fecha Creación</th>
                                <th>Estado</th>
                                <th>Trámite</th>
                                <th>Monto</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var orden in Model)
                            {
                                <tr>
                                    <td>@orden.Id</td>
                                    <td>@orden.NumeroOrden</td>
                                    <td>@orden.CodigoUsuario</td>
                                    <td>@orden.FechaCreacion.ToString("dd/MM/yyyy")</td>
                                    <td>@Html.Partial("_StatusBadge", null, new ViewDataDictionary { { "Status", orden.Estado } })</td>
                                    <td>@GetTextoTramite(orden.Estado)</td>
                                    <td>@orden.Total.ToString("C")</td>
                                    <td class="text-center">
                                        <a href="@Url.Action("Detalles", "OrdenRecaudacion", new { id = orden.Id })"
                                           class="btn btn-sm btn-outline-primary"
                                           title="Ver detalles">
                                            <i class="fas fa-eye"></i>
                                            <span class="visually-hidden">Ver Detalles</span>
                                        </a>

                                        @{
                                            var estadoNorm = (orden.Estado ?? "").Trim().ToUpperInvariant().Replace(" ", "_");
                                        }

                                        @if (estadoNorm == "PROCESADA")
                                        {
                                            using (Html.BeginForm("AprobarOrden", "Financiero", FormMethod.Post))
                                            {
                                                @Html.AntiForgeryToken()
                                                @Html.Hidden("id", orden.Id)
                                                <button type="submit" class="btn btn-sm btn-success ms-1">Aprobar</button>
                                            }

                                            <button class="btn btn-sm btn-danger ms-1" type="button"
                                                    data-bs-toggle="modal" data-bs-target="#modalRechazo-@orden.Id">
                                                Rechazar
                                            </button>

                                            <div class="modal fade" id="modalRechazo-@orden.Id" tabindex="-1" aria-hidden="true">
                                                <div class="modal-dialog">
                                                    <div class="modal-content">
                                                        <div class="modal-header">
                                                            <h5 class="modal-title">Rechazar Orden</h5>
                                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                        </div>
                                                        @using (Html.BeginForm("RechazarOrden", "Financiero", FormMethod.Post))
                                                        {
                                                            @Html.AntiForgeryToken()
                                                            @Html.Hidden("id", orden.Id)
                                                            <div class="modal-body">
                                                                <label class="form-label">Motivo</label>
                                                                <textarea name="motivo" class="form-control" rows="3" required></textarea>
                                                            </div>
                                                            <div class="modal-footer">
                                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                                                                <button type="submit" class="btn btn-danger">Rechazar</button>
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="p-3">
                    @Html.Partial("_EmptyState", null, new ViewDataDictionary {
                        { "IconClass", "fas fa-inbox" },
                        { "Title", "No hay órdenes registradas" },
                        { "Description", "Cuando existan órdenes de recaudación, se mostrarán en esta bandeja." }
                    })
                </div>
            }
        </div>
    </div>
</div>

            @section Scripts {
                <script src="@Url.Content("~/Content/plugins/datatables/jquery.dataTables.min.js")"></script>
                <script src="https://cdn.datatables.net/1.13.4/js/dataTables.bootstrap5.min.js"></script>
                <script src="https://cdn.datatables.net/responsive/2.4.1/js/dataTables.responsive.min.js"></script>
                <script src="https://cdn.datatables.net/responsive/2.4.1/js/responsive.bootstrap5.min.js"></script>
                <script>
                    $(document).ready(function () {
                        $('#dataTable').DataTable({
                            responsive: true,
                            language: {
                                url: '@Url.Content("~/Content/plugins/datatables/i18n/Spanish.json")'
                            },
                            order: [[0, 'desc']],
                            pageLength: 10,
                            lengthMenu: [[5, 10, 25, 50, -1], [5, 10, 25, 50, 'Todos']]
                        });
                    });
                </script>
            }



