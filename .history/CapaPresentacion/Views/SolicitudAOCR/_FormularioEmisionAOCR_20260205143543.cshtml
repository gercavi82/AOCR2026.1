<script>
    $(document).ready(function () {

        // Funcion para actualizar el contador de aeronaves
        function actualizarContador() {
            let resumen = {};
            $('#tablaAeronaves tbody tr').each(function () {
                let fabricante = $(this).find('td').eq(0).text().trim();
                let modelo = $(this).find('td').eq(1).text().trim();
                let key = fabricante + ' - ' + modelo;

                if (resumen[key]) {
                    resumen[key]++;
                } else {
                    resumen[key] = 1;
                }
            });

            let resumenTexto = '';
            for (let key in resumen) {
                resumenTexto += `${key}: ${resumen[key]} aeronave(s)\n`;
            }

            $('#contadorAeronaves').val(resumenTexto.trim());
        }

        // Inicializar contador vacio
        $('#contadorAeronaves').val('');

        // Abrir modal Informacion Compania
        $('#btnInformacionCompania').click(function (e) {
            e.preventDefault();
            $('#modalInformacionCompania').modal('show');
        });

        // Abrir modal Agregar Aeronave
        $('#btnAgregarAeronave').click(function () {
            $('#formAgregarAeronave')[0].reset();
            $('#modalAgregarAeronave').modal('show');
        });

        // Guardar Aeronave desde el Modal
        $('#btnGuardarAeronave').click(function () {
            var fabricante = $('#fabricante').val();
            var modelo = $('#modelo').val();
            var serie = $('#serie').val();
            var matricula = $('#matricula').val();
            var configuracion = $('#configuracion').val();
            var etapaRuido = $('#etapaRuido').val();
            var peso = $('#peso').val();
            var desigOASI = $('#designadorOASI').val();

            // Validacion basica
            if (fabricante === '' || modelo === '' || serie === '' || matricula === '' || configuracion === '') {
                alert('Por favor complete todos los campos obligatorios.');
                return;
            }

            // Agregar nueva fila a la tabla (con estilo mejorado de icono borrar)
            var nuevaFila = `
                <tr>
                    <td>${fabricante}</td>
                    <td>${modelo}</td>
                    <td>${serie}</td>
                    <td>${matricula}</td>
                    <td>${configuracion}</td>
                    <td>${etapaRuido}</td>
                    <td>${peso}</td>
                    <td>${desigOASI}</td>
                    <td class="text-center">
                        <button type="button" class="btn btn-outline-danger btn-sm btnEliminarAeronave" title="Eliminar"><i class="fas fa-trash-alt"></i></button>
                    </td>
                </tr>
            `;
            $('#tablaAeronaves tbody').append(nuevaFila);

            $('#modalAgregarAeronave').modal('hide');
            actualizarContador(); // Actualizar contador al agregar
        });

        // Delegado para eliminar aeronaves
        $('#tablaAeronaves tbody').on('click', '.btnEliminarAeronave', function () {
            $(this).closest('tr').remove();
            actualizarContador(); // Actualizar contador al eliminar
        });

        // Click en boton cargar archivo
        $('#btnCargarArchivo').click(function () {
            // Reset del input para permitir seleccionar el mismo archivo nuevamente
            $('#inputArchivo').val('');
            $('#inputArchivo').click();
        });

        // Cuando el usuario seleccione un archivo
        $('#inputArchivo').change(function (e) {
            const archivo = e.target.files[0];
            if (!archivo) return;

            if (!archivo.name.endsWith('.csv')) {
                Swal.fire({
                    title: 'Error de formato',
                    text: 'Por favor seleccione un archivo .csv valido.',
                    icon: 'error',
                    confirmButtonText: 'OK'
                });
                return;
            }

            const lector = new FileReader();

            lector.onload = function (e) {
                try {
                    const contenido = decodeCsvBuffer(e.target.result);
                    let lineas = contenido.split(/\r\n|\n|\r/);
                    if (lineas.length > 0) {
                        lineas[0] = lineas[0].replace(/^\uFEFF/, '');
                    }


                    // Filtrar lineas vacias
                    lineas = lineas.filter(line => line.trim().length > 0);

                    if (lineas.length < 2) {
                        Swal.fire({
                            title: 'Archivo vacio',
                            text: 'El archivo CSV no contiene datos. Se requiere encabezado + minimo 1 fila.',
                            icon: 'warning',
                            confirmButtonText: 'OK'
                        });
                        return;
                    }

                    // Detectar delimitador automaticamente
                    const delimitador = detectarDelimitador(lineas[0]);
                    console.log('Delimitador detectado:', delimitador);

                    // Limpiar tabla antes de cargar nuevas filas
                    $('#tablaAeronaves tbody').empty();
                    let contadorAeronaves = 0;
                    let errores = [];

                    for (let i = 1; i < lineas.length; i++) {
                        const lineaTrimmed = lineas[i].trim();
                        if (!lineaTrimmed) continue;

                        const fila = parseCsvLine(lineaTrimmed, delimitador);

                        // Validar cantidad de columnas
                        if (fila.length !== 8) {
                            errores.push(`Fila ${i + 1}: ${fila.length} columnas (esperadas 8)`);
                            continue;
                        }

                        // Validar que matricula no este vacia
                        if (!fila[3].trim()) {
                            errores.push(`Fila ${i + 1}: Matricula vacia`);
                            continue;
                        }

                        // Crear fila de tabla
                        const nuevaFila = `
                <tr>
                    <td>${escapeHtml(fila[0].trim())}</td>
                    <td>${escapeHtml(fila[1].trim())}</td>
                    <td>${escapeHtml(fila[2].trim())}</td>
                    <td>${escapeHtml(fila[3].trim())}</td>
                    <td>${escapeHtml(fila[4].trim())}</td>
                    <td>${escapeHtml(fila[5].trim())}</td>
                    <td>${escapeHtml(fila[6].trim())}</td>
                    <td>${escapeHtml(fila[7].trim())}</td>
                    <td class="text-center">
                        <button type="button" class="btn btn-outline-danger btn-sm btnEliminarAeronave"><i class="fas fa-trash-alt"></i></button>
                    </td>
                </tr>
            `;
                        $('#tablaAeronaves tbody').append(nuevaFila);
                        contadorAeronaves++;
                    }

                    // Mostrar resultado
                    if (contadorAeronaves === 0) {
                        let mensajeError = 'No se cargaron aeronaves validas.\n\n';
                        if (errores.length > 0) {
                            mensajeError += 'Errores:\n' + errores.slice(0, 5).join('\n');
                            if (errores.length > 5) {
                                mensajeError += `\n... y ${errores.length - 5} errores mas`;
                            }
                        }
                        Swal.fire({
                            title: 'Error',
                            text: mensajeError,
                            icon: 'error',
                            confirmButtonText: 'OK'
                        });
                        return;
                    }

                    // Exito
                    let mensaje = `Se cargaron ${contadorAeronaves} aeronave(s)`;
                    if (errores.length > 0) {
                        mensaje += ` (${errores.length} fila(s) ignorada(s))`;
                    }
                    
                    Swal.fire({
                        title: 'Exito',
                        text: mensaje,
                        icon: 'success',
                        confirmButtonText: 'OK'
                    });

                    actualizarContador();
                    console.log(`Aeronaves cargadas: ${contadorAeronaves}`);

                } catch (error) {
                    console.error('Error al procesar CSV:', error);
                    Swal.fire({
                        title: 'Error',
                        text: 'Error al procesar el archivo: ' + error.message,
                        icon: 'error',
                        confirmButtonText: 'OK'
                    });
                }
            };

            lector.onerror = function(error) {
                console.error('Error al leer archivo:', error);
                Swal.fire({
                    title: 'Error',
                    text: 'Error al leer el archivo. Por favor intente de nuevo.',
                    icon: 'error',
                    confirmButtonText: 'OK'
                });
            };

            lector.readAsArrayBuffer(archivo);
        });
    });
    //Funcion que activa o desactiva el campo de captura de pantalla
    function validarArchivo(idInput) {
        const input = document.getElementById(idInput);
        const archivo = input.files[0];

        if (archivo) {
            const tamanoMaximo = 2 * 1024 * 1024; // 2 MB en bytes
            if (archivo.size > tamanoMaximo) {
                alert('El archivo supera los 2MB permitidos. Por favor suba una captura si aplica.');
                input.value = ''; // Vaciar el campo
            }
        }
    }

    function toggleCaptura(idArchivoPdf, idCapturaImagen, checkbox) {
        const inputArchivo = document.getElementById(idArchivoPdf);
        const divCaptura = document.getElementById(idCapturaImagen);

        if (checkbox.checked) {
            inputArchivo.value = ''; // Borra el archivo PDF
            inputArchivo.disabled = true;
            inputArchivo.required = false;
            divCaptura.style.display = 'block';
        } else {
            inputArchivo.disabled = false;
            inputArchivo.required = true;
            divCaptura.style.display = 'none';
        }
    }

    function validarConcepto(idTextarea) {
        const textarea = document.getElementById(idTextarea);
        const alerta = document.getElementById('alerta' + idTextarea.charAt(0).toUpperCase() + idTextarea.slice(1));

        if (textarea.value.trim() === '') {
            alerta.style.display = 'block';
        } else {
            alerta.style.display = 'none';
        }
    }

    function detectarDelimitador(lineaCabecera) {
        const conteos = [
            { d: ';', n: (lineaCabecera.match(/;/g) || []).length },
            { d: ',', n: (lineaCabecera.match(/,/g) || []).length },
            { d: '\t', n: (lineaCabecera.match(/\t/g) || []).length },
            { d: '|', n: (lineaCabecera.match(/\|/g) || []).length }
        ];
        conteos.sort((a, b) => b.n - a.n);
        return conteos[0].n > 0 ? conteos[0].d : ';';
    }

    function decodeCsvBuffer(buffer) {
        try {
            if (window.TextDecoder) {
                var utf8 = new TextDecoder('utf-8');
                var text = utf8.decode(buffer);
                if (text.indexOf('\uFFFD') === -1) {
                    return text;
                }
                var win1252 = new TextDecoder('windows-1252');
                return win1252.decode(buffer);
            }
        } catch (e) {
            console.warn('TextDecoder no disponible:', e);
        }
        // Fallback simple (ASCII)
        return String.fromCharCode.apply(null, new Uint8Array(buffer));
    }

    function parseCsvLine(line, delimiter) {
        var result = [];
        var current = '';
        var inQuotes = false;
        for (var i = 0; i < line.length; i++) {
            var ch = line[i];
            if (ch === '"') {
                if (inQuotes && line[i + 1] === '"') {
                    current += '"';
                    i++;
                } else {
                    inQuotes = !inQuotes;
                }
            } else if (ch === delimiter && !inQuotes) {
                result.push(current);
                current = '';
            } else {
                current += ch;
            }
        }
        result.push(current);
        return result;
    }

    function escapeHtml(value) {
        return String(value)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/\"/g, '&quot;')
            .replace(/'/g, '&#39;');
    }
    //funcion para mostrar archivo subido
    function mostrarVistaPreviaArchivo(inputId, vistaPreviaId) {
        const input = document.getElementById(inputId);
        const vistaPrevia = document.getElementById(vistaPreviaId);

        if (input.files && input.files[0]) {
            const file = input.files[0];
            const url = URL.createObjectURL(file);
            const enlace = vistaPrevia.querySelector('a');

            enlace.href = url;
            enlace.textContent = 'Visualizar archivo: ' + file.name;
            vistaPrevia.style.display = 'block';
        } else {
            vistaPrevia.style.display = 'none';
        }
    }
    //funcion para seleccionar companias
    const companias = new Set();

    function agregarCompania() {
        const select = document.getElementById('selectorCompanias');
        const contenedor = document.getElementById('companiasSeleccionadas');
        const seleccion = select.value;

        if (!seleccion) {
            alert('Por favor, seleccione una compania.');
            return;
        }

        if (companias.has(seleccion)) {
            alert('La compania ya ha sido agregada.');
            return;
        }

        companias.add(seleccion);

        // Crear la badge
        const badge = document.createElement('span');
        badge.className = 'badge badge-info mr-1 p-2 mb-1';
        badge.innerHTML = `<i class="fas fa-building"></i> ${seleccion} <i class="fas fa-times ml-1"></i>`;
        badge.style.cursor = 'pointer';
        badge.title = "Haz click para eliminar";

        badge.onclick = () => {
            companias.delete(seleccion);
            contenedor.removeChild(badge);
        };

        contenedor.appendChild(badge);

        // Resetear seleccion
        select.value = '';
    }
</script>
