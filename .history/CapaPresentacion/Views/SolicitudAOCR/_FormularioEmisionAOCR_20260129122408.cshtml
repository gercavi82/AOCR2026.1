</script>

<script>
  function guardarFormulario(){
    mapearCamposVM();
    const vm = {
      Solicitud: {
        CodigoSolicitud: parseInt($('#codigoSolicitud').val() || "0"),
        NombreOperador: $('#nombreOperador').val(),
        RepresentanteLegal: $('#nombreRepresentante').val(),
        CedulaRepresentante: $('#rucRepresentante').val(),
        Direccion: $('#direccionEcuador').val(),
        Telefono: $('#telefonoOperador').val(),
        Ruc: $('#rucOperador').val(),
        RazonSocial: $('#razonSocial').val(),
        TipoOperacion: $('#tipoOperacion').val(),
        DescripcionOperacion: $('#descripcionOperacion').val(),
        ObservacionesGenerales: $('#observacionesGenerales').val()
      },
      Banco: $('#banco').val(),
      NumeroComprobante: $('#numeroComprobante').val(),
      Aeronaves: window.aeronavesSeleccionadas || [] // (si ya manejas un array global)
    };

    $.ajax({
      url: '@Url.Action("FormularioCompleto", "SolicitudAOCR")',
      type: 'POST',
      data: JSON.stringify(vm),
      contentType: 'application/json; charset=utf-8',
      dataType: 'json',
      timeout: 15000,
      headers: {
        'X-CSRF-TOKEN': $('[name="__RequestVerificationToken"]').val()
      },
      success: function (r) {
        // Validar que la respuesta es un objeto JSON v�lido
        if (typeof r === 'object' && r !== null) {
          if (r.success === true) {
            Swal.fire('OK', r.mensaje || 'Solicitud guardada correctamente', 'success').then(() => location.reload());
          } else {
            Swal.fire('Error', r.mensaje || 'Error al guardar la solicitud', 'error');
          }
        } else {
          console.error("Respuesta no es JSON v�lido:", r);
          Swal.fire('Error', 'El servidor respondi� con un formato inv�lido.', 'error');
        }
      },
      error: function (xhr, status, error) {
        let mensajeError = "No se pudo guardar la solicitud.";
        
        if (status === 'timeout') {
          mensajeError = "La solicitud tard� demasiado tiempo. Intente nuevamente.";
        } else if (xhr.status === 0) {
          mensajeError = "Error de conexi�n. Verifique su conexi�n a internet.";
        } else if (xhr.status === 401) {
          mensajeError = "Su sesi�n ha expirado. Por favor, inicie sesi�n nuevamente.";
          setTimeout(() => location.href = '@Url.Action("Login", "Account")', 2000);
        } else if (xhr.status === 403) {
          mensajeError = "No tiene permisos para realizar esta acci�n.";
        } else if (xhr.status === 500) {
          mensajeError = "Error interno del servidor. Intente m�s tarde.";
          console.error("Respuesta del servidor:", xhr.responseText);
        } else if (error === 'parsererror') {
          mensajeError = "El servidor respondi� con un formato inv�lido. Contacte al administrador.";
          console.error("Error de parseo JSON:", xhr.responseText ? xhr.responseText.substring(0, 500) : "sin respuesta");
        } else {
          mensajeError = "Error: " + (error || "Desconocido");
        }
        
        Swal.fire('Error', mensajeError, 'error');
        console.error("Error AJAX completo:", { status: xhr.status, statusText: xhr.statusText, error: error, response: xhr.responseText });
      }
    });
  }
</script>


