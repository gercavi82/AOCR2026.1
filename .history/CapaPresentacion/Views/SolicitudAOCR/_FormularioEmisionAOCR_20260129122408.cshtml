        contenedor.appendChild(badge);

        // Resetear selecci�n
        select.value = '';
    }
<script>
  // ====== Generador Carta 129-01 ======
  function buildCarta12901(){
    const expl = $('#nombreCompania').val() || '________________';
    const fecha = $('#cartaFecha').val() || '____-__-__';
    const oficio = $('#cartaOficio').val() || '____';
    const director = $('#cartaDirector').val() || 'Director DGAC';
    const aace = $('#cartaAace').val() || 'Autoridad Aeron�utica';
    const opspec = $('#cartaOpspecDetalle').val() || 'OpSpecs ___';
    const acuerdo = $('#cartaAcuerdo').val() || '______';
    const acuerdoF = $('#cartaAcuerdoFecha').val() || '____-__-__';
    const rep = $('#cartaRepresentante').val() || $('#nombreRepresentante').val() || 'Representante Legal';

    const txt = `Quito, ${fecha}\n\nOficio: ${oficio}\n\nIng. ${director}\nDIRECCI�N GENERAL DE AVIACI�N CIVIL\nPresente\n\nPor medio del presente solicito se autorice el otorgamiento del Reconocimiento del Certificado de Explotador de Servicios A�reos (AOCR) a ${expl}, de conformidad con el Permiso de Operaci�n emitido por el Consejo Nacional de Aviaci�n Civil (Acuerdo ${acuerdo} de fecha ${acuerdoF}) y las OpSpecs vigentes (${opspec}) emitidas por ${aace}.\n\n${expl} designa como Representante Legal y/o Apoderado General en el Ecuador a ${rep}.\n\nAtentamente,\n${rep}\n${expl}`;
    $('#cartaPreview').val(txt);
    $('#carta12901Texto').val(txt);
  }

  $(document).on('input change', '#cartaFecha,#cartaOficio,#cartaDirector,#cartaAace,#cartaOpspecDetalle,#cartaAcuerdo,#cartaAcuerdoFecha,#cartaRepresentante,#nombreCompania', buildCarta12901);
  $(document).on('click','#btnCopiarCarta',function(){
      const t=$('#cartaPreview').val()||'';
      if(!t.trim()) return;
      if(navigator.clipboard){navigator.clipboard.writeText(t);}else{const ta=document.getElementById('cartaPreview');ta.select();document.execCommand('copy');}
  });

  // ====== Checklist 129-04 ======
  function setBadge(id, ok){
    const el=$('#'+id);
    el.removeClass('badge-secondary badge-success').addClass(ok?'badge-success':'badge-secondary').text(ok?'Completo':'Pendiente');
  }
  function updateChecklist(){
    setBadge('chkFacturaEstado', ($('#archivoFacturaPago').prop('files')||[]).length>0);
    setBadge('chk12901Estado', !!($('#carta12901Texto').val()||'').trim());
    const ok12902 = ($('#nombreRepresentante').val()||'').trim() && ($('#direccionEcuador').val()||'').trim();
    setBadge('chk12902Estado', !!ok12902);
    setBadge('chk12903Estado', $('#tablaAeronaves tbody tr').length>0);
    setBadge('chkAOCEstado', ($('#archivoAOC').prop('files')||[]).length>0);
    setBadge('chkOpSpecsEstado', ($('#archivoOpSpecs').prop('files')||[]).length>0);
    setBadge('chkManualEstado', ($('#archivoManualOperaciones').prop('files')||[]).length>0);
    setBadge('chkMELEstado', ($('#archivoMEL').prop('files')||[]).length>0);
    setBadge('chkPermisoEstado', ($('#archivoPermisoOperacion').prop('files')||[]).length>0);
    setBadge('chkPlanEstado', ($('#archivoPlanSeguridad').prop('files')||[]).length>0);
    setBadge('chkRuidoEstado', ($('#archivoCertificadoRuido').prop('files')||[]).length>0);
  }
  $(document).on('change input', '#archivoFacturaPago,#nombreRepresentante,#direccionEcuador,#archivoAOC,#archivoOpSpecs,#archivoManualOperaciones,#archivoMEL,#archivoPermisoOperacion,#archivoPlanSeguridad,#archivoCertificadoRuido', updateChecklist);

  // ====== Mapear UI -> campos VM antes de guardar ======
  function mapearCamposVM(){
    $('#nombreOperador').val($('#nombreCompania').val()||'');
    $('#rucOperador').val($('#rucRepresentante').val()||$('#rucOperador').val());
    $('#telefonoOperador').val($('#telefonoEcuador').val()||'');
