        if (archivo) {
            const tama�oMaximo = 2 * 1024 * 1024; // 2 MB en bytes
            if (archivo.size > tama�oMaximo) {
                alert('El archivo supera los 2MB permitidos. Por favor suba una captura si aplica.');
