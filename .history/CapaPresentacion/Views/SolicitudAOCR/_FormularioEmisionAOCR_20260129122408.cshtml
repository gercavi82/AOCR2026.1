    }

    function detectarDelimitador(lineaCabecera) {
        const cantidadPuntosComa = (lineaCabecera.match(/;/g) || []).length;
        const cantidadComas = (lineaCabecera.match(/,/g) || []).length;
        return cantidadPuntosComa >= cantidadComas ? ';' : ',';
    }
