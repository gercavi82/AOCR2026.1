@inherits System.Web.Mvc.WebViewPage<CapaModelo.SolicitudAOCR>
@using CapaDatos.Constants
@using CapaModelo
@using System.Collections.Generic
@using System.Web.Mvc
@using System.Web.Mvc.Html

@{
    ViewBag.Title = "Detalle de Solicitud AOCR";
    Layout = "~/Views/Shared/_LayoutAOCR.cshtml";

    var estadoActual = EstadoSolicitud.Normalizar(Model.Estado);
    var puedeInspectorDocumental =
        User.IsInRole("Inspector") &&
        (estadoActual == EstadoSolicitud.Pendiente
         || estadoActual == EstadoSolicitud.EnRevision
         || estadoActual == EstadoSolicitud.DocumentacionPendiente
         || estadoActual == EstadoSolicitud.Observada
         || estadoActual == EstadoSolicitud.Subsanada);

    var puedeSolicitarInspeccion =
        (User.IsInRole("Inspector") || User.IsInRole("Administrador")) &&
        (estadoActual == EstadoSolicitud.AceptacionDocumental
         || estadoActual == EstadoSolicitud.DocumentacionCompleta
         || estadoActual == EstadoSolicitud.Aprobada);

    var puedeMarcarElaboracion =
        (User.IsInRole("CoordinadorInspecciones") || User.IsInRole("Administrador")) &&
        estadoActual == EstadoSolicitud.EnInspeccion;

    var puedeMarcarRevision =
        (User.IsInRole("JefaturaTecnica") || User.IsInRole("Administrador")) &&
        estadoActual == EstadoSolicitud.AOCR_EnElaboracion;

    var puedeValidarJefatura =
        (User.IsInRole("JefaturaTecnica") || User.IsInRole("Administrador")) &&
        estadoActual == EstadoSolicitud.AOCR_EnRevision;

    var puedeLegalizar =
        (User.IsInRole("CoordinacionLegal") || User.IsInRole("DirectorGeneral") || User.IsInRole("Administrador")) &&
        estadoActual == EstadoSolicitud.AOCR_Validado;

    var puedeEmitirAocr =
        (User.IsInRole("CoordinacionLegal") || User.IsInRole("DirectorGeneral") || User.IsInRole("Administrador")) &&
        estadoActual == EstadoSolicitud.AOCR_Legalizado;
}

<h2 class="mb-4">Detalle de Solicitud AOCR</h2>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-4">ID Solicitud</dt>
            <dd class="col-sm-8">@Model.CodigoSolicitud</dd>

            <dt class="col-sm-4">Fecha Solicitud</dt>
            <dd class="col-sm-8">@(Model.FechaSolicitud.HasValue ? Model.FechaSolicitud.Value.ToString("yyyy-MM-dd HH:mm") : "")</dd>

            <dt class="col-sm-4">Estado</dt>
            <dd class="col-sm-8">@Model.Estado</dd>

            <dt class="col-sm-4">Operador</dt>
            <dd class="col-sm-8">@Model.NombreOperador</dd>

            <dt class="col-sm-4">RUC</dt>
            <dd class="col-sm-8">@Model.Ruc</dd>

            <dt class="col-sm-4">Email</dt>
            <dd class="col-sm-8">@Model.Email</dd>

            <dt class="col-sm-4">Telefono</dt>
            <dd class="col-sm-8">@Model.Telefono</dd>

            <dt class="col-sm-4">Direccion</dt>
            <dd class="col-sm-8">@Model.Direccion, @Model.Ciudad @Model.Provincia, @Model.Pais</dd>

            <dt class="col-sm-4">Representante Legal</dt>
            <dd class="col-sm-8">@Model.RepresentanteLegal (@Model.CedulaRepresentante)</dd>

            <dt class="col-sm-4">Tipo de Operacion</dt>
            <dd class="col-sm-8">@Model.TipoOperacion</dd>

            <dt class="col-sm-4">Descripcion de Operacion</dt>
            <dd class="col-sm-8">@Model.DescripcionOperacion</dd>

            <dt class="col-sm-4">Tecnico Responsable</dt>
            <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.TecnicoResponsableNombre) ? "-" : Model.TecnicoResponsableNombre + " - " + Model.TecnicoResponsableCedula)</dd>
        </dl>

        @if (User.IsInRole("Inspector"))
        {
            <hr class="my-4" />
            <h5 class="mb-3">Gestion de Documentos AOCR</h5>
            <div class="d-flex flex-column gap-2 mb-3">
                <a href="@Url.Action("Subir", "Documento", new { solicitudId = Model.CodigoSolicitud })" class="btn btn-outline-primary">
                    <i class="fas fa-upload"></i> Subir Documento/Borrador AOCR
                </a>
                <a href="@Url.Action("Lista", "Documento", new { solicitudId = Model.CodigoSolicitud })" class="btn btn-outline-secondary">
                    <i class="fas fa-file-alt"></i> Ver Documentos de la Solicitud
                </a>
            </div>
        }
    </div>
</div>

@if (puedeInspectorDocumental)
{
    <hr class="my-4" />
    <h5 class="mb-3">Revision Documental (Inspector)</h5>
    <div class="card border-info">
        <div class="card-body bg-light">
            <form method="post">

    Func<string, string> estadoCss = estado =>
    {
        var normalized = EstadoSolicitud.Normalizar(estado);
        if (normalized == EstadoSolicitud.Observada)
        {
            return "aocr-badge danger";
        }

        if (normalized == EstadoSolicitud.AOCR_Validado
            || normalized == EstadoSolicitud.AceptacionDocumental
            || normalized == EstadoSolicitud.AOCR_Legalizado
            || normalized == EstadoSolicitud.AOCR_EmitidoRecibido
            || normalized == EstadoSolicitud.Aprobada)
        {
            return "aocr-badge success";
        }

        if (normalized == EstadoSolicitud.EnRevision
            || normalized == EstadoSolicitud.AOCR_EnRevision
            || normalized == EstadoSolicitud.AOCR_EnElaboracion
            || normalized == EstadoSolicitud.EnInspeccion)
        {
            return "aocr-badge info";
        }

        return "aocr-badge warning";
    };
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.CodigoSolicitud" />
<style>
    .aocr-detail-shell {
        padding: 1.5rem 0 2rem;
    }

    .aocr-detail-card {
        border: 0;
        border-radius: 18px;
        box-shadow: 0 18px 40px rgba(14, 30, 62, 0.08);
        overflow: hidden;
    }

    .aocr-hero {
        background: linear-gradient(135deg, #0f3d75 0%, #174f97 55%, #2f6dbc 100%);
        color: #fff;
    }

    .aocr-hero .card-body {
        padding: 1.75rem;
    }

    .aocr-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.4rem 0.75rem;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.14);
        font-size: 0.8rem;
        letter-spacing: 0.03em;
        text-transform: uppercase;
    }

    .aocr-hero-title {
        font-size: 2rem;
        font-weight: 700;
        margin: 1rem 0 0.5rem;
    }

    .aocr-hero-subtitle {
        color: rgba(255, 255, 255, 0.84);
        margin-bottom: 0;
    }

    .aocr-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 132px;
        padding: 0.65rem 0.95rem;
        border-radius: 999px;
        font-size: 0.84rem;
        font-weight: 700;
        letter-spacing: 0.02em;
    }

    .aocr-badge.success {
        background: #dcfce7;
        color: #166534;
    }

    .aocr-badge.warning {
        background: #fef3c7;
        color: #92400e;
    }

    .aocr-badge.danger {
        background: #fee2e2;
        color: #b91c1c;
    }

    .aocr-badge.info {
        background: #dbeafe;
        color: #1d4ed8;
    }

    .aocr-summary-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 0.85rem;
        margin-top: 1.25rem;
    }

    .aocr-summary-item {
        background: rgba(255, 255, 255, 0.12);
        border: 1px solid rgba(255, 255, 255, 0.14);
        border-radius: 14px;
        padding: 0.9rem 1rem;
    }

    .aocr-summary-label {
        font-size: 0.78rem;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: rgba(255, 255, 255, 0.72);
        margin-bottom: 0.35rem;
    }

    .aocr-summary-value {
        font-size: 1rem;
        font-weight: 600;
        color: #fff;
    }

    .aocr-section-title {
        display: flex;
        align-items: center;
        gap: 0.7rem;
        font-size: 1.05rem;
        font-weight: 700;
        color: #16365f;
        margin-bottom: 1rem;
    }

    .aocr-section-title i {
        width: 40px;
        height: 40px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        background: #e8f1fb;
        color: #1e5aa8;
    }

    .aocr-info-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 1rem;
    }

    .aocr-info-item {
        padding: 0.95rem 1rem;
        border-radius: 14px;
        background: #f8fbff;
        border: 1px solid #e4edf7;
    }

    .aocr-info-label {
        display: flex;
        align-items: center;
        gap: 0.55rem;
        font-size: 0.8rem;
        font-weight: 700;
        text-transform: uppercase;
        color: #5f738c;
        margin-bottom: 0.45rem;
    }

    .aocr-info-label i {
        color: #1e5aa8;
    }

    .aocr-info-value {
        color: #102a43;
        font-weight: 600;
        line-height: 1.45;
    }

    .aocr-action-card {
        border: 1px solid #d8e4f2;
        background: linear-gradient(180deg, #ffffff 0%, #f8fbff 100%);
    }

    .aocr-action-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 1rem;
    }

    .aocr-action-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.6rem;
        width: 100%;
        min-height: 52px;
        border-radius: 14px;
        font-weight: 600;
    }

    .aocr-review-card {
        border-left: 5px solid #1e5aa8;
    }

    .aocr-review-card.success {
        border-left-color: #1f7a3b;
    }

    .aocr-review-card.warning {
        border-left-color: #d97706;
    }

    .aocr-review-card.danger {
        border-left-color: #c2410c;
    }

    .aocr-review-card.legal {
        border-left-color: #0f766e;
    }

    .aocr-review-card.emit {
        border-left-color: #166534;
    }

    .aocr-form-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
    }

    .aocr-history-table thead th {
        border-bottom-width: 1px;
        color: #4a5d75;
        font-size: 0.82rem;
        text-transform: uppercase;
        letter-spacing: 0.03em;
    }

    @@media (max-width: 767.98px) {
        .aocr-hero-title {
            font-size: 1.5rem;
        }

        .aocr-detail-shell {
            padding-top: 1rem;
        }
    }
</style>

<div class="container-fluid aocr-detail-shell">
    <div class="card aocr-detail-card aocr-hero mb-4">
        <div class="card-body">
            <div class="d-flex flex-column flex-lg-row justify-content-between gap-3 align-items-lg-start">
                <div>
                    <div class="aocr-eyebrow">
                        <i class="fas fa-file-signature"></i>
                        Detalle del tramite AOCR
                    </div>
                    <h1 class="aocr-hero-title">Solicitud AOCR #@Model.CodigoSolicitud</h1>
                    <p class="aocr-hero-subtitle">Vista consolidada del estado del tramite, datos del operador y acciones del flujo.</p>
                </div>
                <div class="text-lg-end">
                    <div class="mb-2 small text-uppercase opacity-75">Estado del tramite</div>
                    <span class="@estadoCss(Model.Estado)">@Model.Estado</span>
                </div>
            </div>

            <div class="aocr-summary-grid">
                <div class="aocr-summary-item">
                    <div class="aocr-summary-label">Fecha de solicitud</div>
                    <div class="aocr-summary-value">@(Model.FechaSolicitud.HasValue ? Model.FechaSolicitud.Value.ToString("yyyy-MM-dd HH:mm") : "No registrada")</div>
                </div>
                <div class="aocr-summary-item">
                    <div class="aocr-summary-label">Operador</div>
                    <div class="aocr-summary-value">@Model.NombreOperador</div>
                </div>
                <div class="aocr-summary-item">
                    <div class="aocr-summary-label">Tipo de operación</div>
                    <div class="aocr-summary-value">@(string.IsNullOrWhiteSpace(Model.TipoOperacion) ? "No definido" : Model.TipoOperacion)</div>
                </div>
                <div class="aocr-summary-item">
                    <div class="aocr-summary-label">Técnico responsable</div>
                    <div class="aocr-summary-value">@(string.IsNullOrWhiteSpace(Model.TecnicoResponsableNombre) ? "Sin asignar" : Model.TecnicoResponsableNombre)</div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-xl-7">
            <div class="card aocr-detail-card h-100">
                <div class="card-body p-4">
                    <div class="aocr-section-title">
                        <i class="fas fa-building"></i>
                        <span>Datos del Operador</span>
                    </div>

                    <div class="aocr-info-grid">
                        <div class="aocr-info-item">
                            <div class="aocr-info-label"><i class="fas fa-id-card"></i> RUC</div>
                            <div class="aocr-info-value">@(string.IsNullOrWhiteSpace(Model.Ruc) ? "No registrado" : Model.Ruc)</div>
                        </div>
                        <div class="aocr-info-item">
                            <div class="aocr-info-label"><i class="fas fa-building"></i> Nombre operador</div>
                            <div class="aocr-info-value">@(string.IsNullOrWhiteSpace(Model.NombreOperador) ? "No registrado" : Model.NombreOperador)</div>
                        </div>
                        <div class="aocr-info-item">
                            <div class="aocr-info-label"><i class="fas fa-envelope"></i> Email</div>
                            <div class="aocr-info-value">@(string.IsNullOrWhiteSpace(Model.Email) ? "No registrado" : Model.Email)</div>
                        </div>
                        <div class="aocr-info-item">
                            <div class="aocr-info-label"><i class="fas fa-phone"></i> Teléfono</div>
                            <div class="aocr-info-value">@(string.IsNullOrWhiteSpace(Model.Telefono) ? "No registrado" : Model.Telefono)</div>
                        </div>
                        <div class="aocr-info-item">
                            <div class="aocr-info-label"><i class="fas fa-map-marker-alt"></i> Dirección</div>
                            <div class="aocr-info-value">@string.Join(", ", new[] { Model.Direccion, (Model.Ciudad + " " + Model.Provincia).Trim(), Model.Pais }.Where(x => !string.IsNullOrWhiteSpace(x)))</div>
                        </div>
                        <div class="aocr-info-item">
                            <div class="aocr-info-label"><i class="fas fa-user-tie"></i> Representante legal</div>
                            <div class="aocr-info-value">
                                @(string.IsNullOrWhiteSpace(Model.RepresentanteLegal)
                                    ? "No registrado"
                                    : Model.RepresentanteLegal + (string.IsNullOrWhiteSpace(Model.CedulaRepresentante) ? string.Empty : " (" + Model.CedulaRepresentante + ")"))
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-5">
            <div class="card aocr-detail-card h-100">
                <div class="card-body p-4">
                    <div class="aocr-section-title">
                        <i class="fas fa-gears"></i>
                        <span>Información de Operación</span>
                    </div>

                    <div class="aocr-info-grid">
                        <div class="aocr-info-item">
                            <div class="aocr-info-label"><i class="fas fa-briefcase"></i> Tipo de operación</div>
                            <div class="aocr-info-value">@(string.IsNullOrWhiteSpace(Model.TipoOperacion) ? "No definido" : Model.TipoOperacion)</div>
                        </div>
                        <div class="aocr-info-item">
                            <div class="aocr-info-label"><i class="fas fa-align-left"></i> Descripción</div>
                            <div class="aocr-info-value">@(string.IsNullOrWhiteSpace(Model.DescripcionOperacion) ? "No definida" : Model.DescripcionOperacion)</div>
                        </div>
                        <div class="aocr-info-item">
                            <div class="aocr-info-label"><i class="fas fa-user-cog"></i> Técnico responsable</div>
                            <div class="aocr-info-value">@(string.IsNullOrWhiteSpace(Model.TecnicoResponsableNombre) ? "Sin asignar" : Model.TecnicoResponsableNombre + (string.IsNullOrWhiteSpace(Model.TecnicoResponsableCedula) ? string.Empty : " - " + Model.TecnicoResponsableCedula))</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card aocr-detail-card aocr-action-card mb-4">
        <div class="card-body p-4">
            <div class="aocr-section-title">
                <i class="fas fa-folder-open"></i>
                <span>Gestión Documental</span>
            </div>

            <div class="aocr-action-grid">
                <a href="@Url.Action("Subir", "Documento", new { solicitudId = Model.CodigoSolicitud })" class="btn btn-primary aocr-action-btn">
                    <i class="fas fa-upload"></i>
                    Subir Documento / Borrador AOCR
                </a>
                <a href="@Url.Action("Lista", "Documento", new { solicitudId = Model.CodigoSolicitud })" class="btn btn-outline-primary aocr-action-btn">
                    <i class="fas fa-file-alt"></i>
                    Ver Documentos de la Solicitud
                </a>
            </div>
        </div>
    </div>

    @if (puedeInspectorDocumental)
    {
        <div class="card aocr-detail-card aocr-review-card mb-4 success">
            <div class="card-body p-4">
                <div class="aocr-section-title mb-3">
                    <i class="fas fa-clipboard-check"></i>
                    <span>Revisión Documental</span>
                </div>
                <p class="text-muted mb-3">Registre observaciones y decida si la documentación pasa a aceptación documental o vuelve observada.</p>
                <form method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.CodigoSolicitud" />
                    <div class="mb-3">
                        <label for="observacionInspector" class="form-label fw-semibold">Observaciones</label>
                        <textarea class="form-control" id="observacionInspector" name="observacion" rows="4" placeholder="Ingrese observaciones si aplica"></textarea>
                    </div>
                    <div class="aocr-form-actions">
                        <button formaction="@Url.Action("Aprobar", "SolicitudAOCR")" class="btn btn-success aocr-action-btn" type="submit">
                            <i class="fas fa-check-circle"></i>
                            Aceptar Documentación
                        </button>
                        <button formaction="@Url.Action("Observar", "SolicitudAOCR")" class="btn btn-danger aocr-action-btn" type="submit">
                            <i class="fas fa-exclamation-circle"></i>
                            Observar
                        </button>
                    </div>
                </form>
            </div>
        </div>
    }

    @if (puedeSolicitarInspeccion)
    {
        <div class="card aocr-detail-card aocr-review-card mb-4 warning">
            <div class="card-body p-4 d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">
                <div>
                    <div class="aocr-section-title mb-2">
                        <i class="fas fa-clipboard-list"></i>
                        <span>Gestión de Inspección</span>
                    </div>
                    <p class="text-muted mb-0">La documentación fue aceptada y el trámite está listo para pasar a la fase de inspección.</p>
                </div>
                <a href="@Url.Action("SolicitarInspeccion", "SolicitudAOCR", new { id = Model.CodigoSolicitud })" class="btn btn-outline-primary aocr-action-btn">
                    <i class="fas fa-arrow-right"></i>
                    Pasar a En Inspección
                </a>
            </div>
        </div>
    }

    @if (puedeMarcarElaboracion)
    {
        <div class="card aocr-detail-card aocr-review-card mb-4 warning">
            <div class="card-body p-4">
                <div class="aocr-section-title mb-3">
                    <i class="fas fa-file-pen"></i>
                    <span>AOCR en Elaboración</span>
                </div>
                <form method="post" action="@Url.Action("MarcarAocrEnElaboracion", "SolicitudAOCR")">
                    @Html.AntiForgeryToken()
                    @Html.Hidden("id", Model.CodigoSolicitud)
                    <div class="mb-3">
                        <label class="form-label fw-semibold" for="obsElaboracion">Observación</label>
                        <textarea class="form-control" id="obsElaboracion" name="observacion" rows="3"></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary aocr-action-btn">
                        <i class="fas fa-file-signature"></i>
                        Marcar AOCR en Elaboración
                    </button>
                </form>
            </div>
        </div>
    }

    @if (puedeMarcarRevision)
    {
        <div class="card aocr-detail-card aocr-review-card mb-4 info">
            <div class="card-body p-4">
                <div class="aocr-section-title mb-3">
                    <i class="fas fa-search"></i>
                    <span>Validar paso a Revisión</span>
                </div>
                <form method="post" action="@Url.Action("MarcarAocrEnRevision", "SolicitudAOCR")">
                    @Html.AntiForgeryToken()
                    @Html.Hidden("id", Model.CodigoSolicitud)
                    <div class="mb-3">
                        <label class="form-label fw-semibold" for="obsRevision">Observación</label>
                        <textarea class="form-control" id="obsRevision" name="observacion" rows="3"></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary aocr-action-btn">
                        <i class="fas fa-search"></i>
                        Marcar AOCR en Revisión
                    </button>
                </form>
            </div>
        </div>
    }

    @if (puedeValidarJefatura)
    {
        <div class="card aocr-detail-card aocr-review-card mb-4 warning">
            <div class="card-body p-4">
                <div class="aocr-section-title mb-3">
                    <i class="fas fa-stamp"></i>
                    <span>Validación Técnica de Jefatura</span>
                </div>
                <form method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.CodigoSolicitud" />
                    <div class="mb-3">
                        <label for="observacionJefatura" class="form-label fw-semibold">Observaciones</label>
                        <textarea class="form-control" id="observacionJefatura" name="observaciones" rows="4" placeholder="Observaciones de jefatura"></textarea>
                    </div>
                    <div class="aocr-form-actions">
                        <button formaction="@Url.Action("AprobarPorJefatura", "SolicitudAOCR")" class="btn btn-success aocr-action-btn" type="submit">
                            <i class="fas fa-check-circle"></i>
                            Validar AOCR
                        </button>
                        <button formaction="@Url.Action("ObservarPorJefatura", "SolicitudAOCR")" class="btn btn-danger aocr-action-btn" type="submit">
                            <i class="fas fa-exclamation-triangle"></i>
                            Observar
                        </button>
                    </div>
                </form>
            </div>
        </div>
    }

    @if (puedeLegalizar)
    {
        <div class="card aocr-detail-card aocr-review-card mb-4 legal">
            <div class="card-body p-4">
                <div class="aocr-section-title mb-3">
                    <i class="fas fa-gavel"></i>
                    <span>Legalización AOCR</span>
                </div>
