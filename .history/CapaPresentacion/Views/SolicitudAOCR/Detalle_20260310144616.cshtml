@inherits System.Web.Mvc.WebViewPage<CapaModelo.SolicitudAOCR>
@using CapaDatos.Constants
@using CapaModelo
@using System.Collections.Generic
@using System.Web.Mvc
@using System.Web.Mvc.Html

@{
    ViewBag.Title = "Detalle de Solicitud AOCR";
    Layout = "~/Views/Shared/_LayoutAOCR.cshtml";

    var estadoActual = EstadoSolicitud.Normalizar(Model.Estado);
    var puedeInspectorDocumental =
        User.IsInRole("Inspector") &&
        (estadoActual == EstadoSolicitud.Pendiente
         || estadoActual == EstadoSolicitud.EnRevision
         || estadoActual == EstadoSolicitud.DocumentacionPendiente
         || estadoActual == EstadoSolicitud.Observada
         || estadoActual == EstadoSolicitud.Subsanada);

    var puedeSolicitarInspeccion =
        (User.IsInRole("Inspector") || User.IsInRole("Administrador")) &&
        (estadoActual == EstadoSolicitud.AceptacionDocumental
         || estadoActual == EstadoSolicitud.DocumentacionCompleta
         || estadoActual == EstadoSolicitud.Aprobada);

    var puedeMarcarElaboracion =
        (User.IsInRole("CoordinadorInspecciones") || User.IsInRole("Administrador")) &&
        estadoActual == EstadoSolicitud.EnInspeccion;

    var puedeMarcarRevision =
        (User.IsInRole("JefaturaTecnica") || User.IsInRole("Administrador")) &&
        estadoActual == EstadoSolicitud.AOCR_EnElaboracion;

    var puedeValidarJefatura =
        (User.IsInRole("JefaturaTecnica") || User.IsInRole("Administrador")) &&
        estadoActual == EstadoSolicitud.AOCR_EnRevision;

    var puedeLegalizar =
        (User.IsInRole("CoordinacionLegal") || User.IsInRole("DirectorGeneral") || User.IsInRole("Administrador")) &&
        estadoActual == EstadoSolicitud.AOCR_Validado;

    var puedeEmitirAocr =
        (User.IsInRole("CoordinacionLegal") || User.IsInRole("DirectorGeneral") || User.IsInRole("Administrador")) &&
        estadoActual == EstadoSolicitud.AOCR_Legalizado;
}

<h2 class="mb-4">Detalle de Solicitud AOCR</h2>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-4">ID Solicitud</dt>
            <dd class="col-sm-8">@Model.CodigoSolicitud</dd>

            <dt class="col-sm-4">Fecha Solicitud</dt>
            <dd class="col-sm-8">@(Model.FechaSolicitud.HasValue ? Model.FechaSolicitud.Value.ToString("yyyy-MM-dd HH:mm") : "")</dd>

            <dt class="col-sm-4">Estado</dt>
            <dd class="col-sm-8">@Model.Estado</dd>

            <dt class="col-sm-4">Operador</dt>
            <dd class="col-sm-8">@Model.NombreOperador</dd>

            <dt class="col-sm-4">RUC</dt>
            <dd class="col-sm-8">@Model.Ruc</dd>

            <dt class="col-sm-4">Email</dt>
            <dd class="col-sm-8">@Model.Email</dd>

            <dt class="col-sm-4">Telefono</dt>
            <dd class="col-sm-8">@Model.Telefono</dd>

            <dt class="col-sm-4">Direccion</dt>
            <dd class="col-sm-8">@Model.Direccion, @Model.Ciudad @Model.Provincia, @Model.Pais</dd>

            <dt class="col-sm-4">Representante Legal</dt>
            <dd class="col-sm-8">@Model.RepresentanteLegal (@Model.CedulaRepresentante)</dd>

            <dt class="col-sm-4">Tipo de Operacion</dt>
            <dd class="col-sm-8">@Model.TipoOperacion</dd>

            <dt class="col-sm-4">Descripcion de Operacion</dt>
            <dd class="col-sm-8">@Model.DescripcionOperacion</dd>

            <dt class="col-sm-4">Tecnico Responsable</dt>
            <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.TecnicoResponsableNombre) ? "-" : Model.TecnicoResponsableNombre + " - " + Model.TecnicoResponsableCedula)</dd>
        </dl>

        @if (User.IsInRole("Inspector"))
        {
            <hr class="my-4" />
            <h5 class="mb-3">Gestion de Documentos AOCR</h5>
            <div class="d-flex flex-column gap-2 mb-3">
                <a href="@Url.Action("Subir", "Documento", new { solicitudId = Model.CodigoSolicitud })" class="btn btn-outline-primary">
                    <i class="fas fa-upload"></i> Subir Documento/Borrador AOCR
                </a>
                <a href="@Url.Action("Lista", "Documento", new { solicitudId = Model.CodigoSolicitud })" class="btn btn-outline-secondary">
                    <i class="fas fa-file-alt"></i> Ver Documentos de la Solicitud
                </a>
            </div>
        }
    </div>
</div>

@if (puedeInspectorDocumental)
{
    <hr class="my-4" />
    <h5 class="mb-3">Revision Documental (Inspector)</h5>
    <div class="card border-info">
        <div class="card-body bg-light">
            <form method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.CodigoSolicitud" />
                <div class="mb-3">
                    <label for="observacionInspector" class="form-label">Observaciones (si aplica)</label>
                    <textarea class="form-control" id="observacionInspector" name="observacion" rows="3" placeholder="Ingrese observaciones si aplica"></textarea>
                </div>
                <div class="d-flex gap-2">
                    <button formaction="@Url.Action("Aprobar", "SolicitudAOCR")" class="btn btn-success">
                        <i class="fas fa-check"></i> Aceptacion Documental
                    </button>
                    <button type="submit" formaction="@Url.Action("Observar", "SolicitudAOCR")" class="btn btn-danger">
                        <i class="fas fa-exclamation-circle"></i> Observar
                    </button>
                </div>
            </form>
        </div>
    </div>
}

@if (puedeSolicitarInspeccion)
{
    <hr class="my-4" />
    <div class="d-flex align-items-center gap-2">
        <span class="text-muted">Fase siguiente:</span>
        <a href="@Url.Action("SolicitarInspeccion", "SolicitudAOCR", new { id = Model.CodigoSolicitud })" class="btn btn-outline-primary">
            <i class="fas fa-clipboard-check"></i> Pasar a En Inspeccion
        </a>
    </div>
}

@if (puedeMarcarElaboracion)
{
    <hr class="my-4" />
    <h5 class="mb-3">AOCR en Elaboracion</h5>
    using (Html.BeginForm("MarcarAocrEnElaboracion", "SolicitudAOCR", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.Hidden("id", Model.CodigoSolicitud)
        <div class="mb-3">
            <label class="form-label" for="obsElaboracion">Observacion (opcional)</label>
            <textarea class="form-control" id="obsElaboracion" name="observacion" rows="2"></textarea>
        </div>
        <button type="submit" class="btn btn-primary">
            <i class="fas fa-file-signature"></i> Marcar AOCR En Elaboracion
        </button>
    }
}

@if (puedeMarcarRevision)
{
    <hr class="my-4" />
    <h5 class="mb-3">Enviar AOCR a Revision</h5>
    using (Html.BeginForm("MarcarAocrEnRevision", "SolicitudAOCR", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.Hidden("id", Model.CodigoSolicitud)
        <div class="mb-3">
            <label class="form-label" for="obsRevision">Observacion (opcional)</label>
            <textarea class="form-control" id="obsRevision" name="observacion" rows="2"></textarea>
        </div>
        <button type="submit" class="btn btn-primary">
            <i class="fas fa-search"></i> Marcar AOCR En Revision
        </button>
    }
}

@if (puedeValidarJefatura)
{
    <hr class="my-4" />
    <h5 class="mb-3">Validacion Tecnica (Jefatura)</h5>
    <div class="card border-warning">
        <div class="card-body bg-light">
            <form method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.CodigoSolicitud" />
                <div class="mb-3">
                    <label for="observacionJefatura" class="form-label">Observaciones (si aplica)</label>
                    <textarea class="form-control" id="observacionJefatura" name="observaciones" rows="3" placeholder="Observaciones de jefatura"></textarea>
                </div>
                <div class="d-flex gap-2">
                    <button formaction="@Url.Action("AprobarPorJefatura", "SolicitudAOCR")" class="btn btn-success">
                        <i class="fas fa-check"></i> Validar AOCR
                    </button>
                    <button type="submit" formaction="@Url.Action("ObservarPorJefatura", "SolicitudAOCR")" class="btn btn-danger">
                        <i class="fas fa-times-circle"></i> Observar
                    </button>
                </div>
            </form>
        </div>
    </div>
}

@if (puedeLegalizar)
{
    <hr class="my-4" />
    <h5 class="mb-3">Legalizacion AOCR</h5>
    using (Html.BeginForm("Legalizar", "SolicitudAOCR", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.Hidden("id", Model.CodigoSolicitud)
        <div class="mb-3">
            <label for="observacionLegal" class="form-label">Observaciones de legalizacion (opcional)</label>
            <textarea class="form-control" id="observacionLegal" name="observacionLegal" rows="3"></textarea>
        </div>
        <button type="submit" class="btn btn-success">
            <i class="fas fa-check-circle"></i> Legalizar AOCR
        </button>
    }
}

@if (puedeEmitirAocr)
{
    <hr class="my-4" />
    <h5 class="mb-3">Emision AOCR</h5>
    using (Html.BeginForm("EmitirAocr", "SolicitudAOCR", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.Hidden("id", Model.CodigoSolicitud)
        <div class="mb-3">
            <label for="observacionEmitir" class="form-label">Observaciones (opcional)</label>
            <textarea class="form-control" id="observacionEmitir" name="observacion" rows="2"></textarea>
        </div>
        <button type="submit" class="btn btn-success">
            <i class="fas fa-file-export"></i> Emitir / Recibir AOCR
        </button>
    }
}

@if (ViewBag.HistorialEstados != null)
{
    var historial = (List<CapaModelo.HistorialEstado>)ViewBag.HistorialEstados;
    if (historial.Count > 0)
    {
        <div class="card mt-4">
            <div class="card-header bg-secondary text-white">Historial de Cambios y Observaciones</div>
            <div class="card-body p-0">
                <table class="table table-bordered table-sm mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Fecha</th>
                            <th>Estado Anterior</th>
                            <th>Estado Nuevo</th>
                            <th>Observaciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in historial)
                        {
                            <tr>
                                <td>@Convert.ToDateTime(item.FechaCambio).ToString("yyyy-MM-dd HH:mm")</td>
                                <td>@Html.Encode(item.EstadoAnterior)</td>
                                <td>@Html.Encode(item.EstadoNuevo)</td>
                                <td>@Html.Raw(System.Web.HttpUtility.HtmlEncode(item.Observaciones).Replace("\n", "<br/>"))</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-light mt-3">No hay observaciones registradas.</div>
    }
}
else
{
    <div class="alert alert-light mt-3">No hay historial registrado para esta solicitud.</div>
}

<div class="mt-4">
    @Html.ActionLink("Volver", "Index", null, new { @class = "btn btn-secondary" })
</div>
