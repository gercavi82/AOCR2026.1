@model CapaModelo.Common.CertificadoAOCRViewModel
@{
    Layout = "~/Views/Shared/_PdfLayoutDGAC.cshtml";
}

@section PdfHead {
    <style>
        body {
            font-family: Arial, Helvetica, sans-serif;
            font-size: 11pt;
            line-height: 1.5;
            color: #000;
        }

        .header {
            text-align: center;
            margin-bottom: 24px;
            border-bottom: 2px solid #003366;
            padding-bottom: 10px;
        }

        .header h1 {
            font-size: 18pt;
            font-weight: bold;
            color: #003366;
            margin: 4px 0;
            text-transform: uppercase;
        }

        .header h2 {
            font-size: 13pt;
            color: #666;
            margin: 2px 0;
        }

        .certificado-numero {
            text-align: center;
            font-size: 16pt;
            font-weight: bold;
            color: #003366;
            margin: 18px 0;
            padding: 8px;
            border: 2px solid #003366;
            background-color: #f0f0f0;
        }

        .seccion {
            margin: 18px 0;
        }

        .seccion-titulo {
            font-size: 12pt;
            font-weight: bold;
            color: #003366;
            border-bottom: 1px solid #ccc;
            padding-bottom: 5px;
            margin-bottom: 10px;
            text-transform: uppercase;
        }

        .campo {
            margin: 6px 0;
        }

        .campo-label {
            font-weight: bold;
            display: inline-block;
            width: 200px;
            color: #333;
        }

        .campo-valor {
            display: inline-block;
            color: #000;
        }

        .vigencia-box {
            background-color: #ffffcc;
            border: 2px solid #ffcc00;
            padding: 14px;
            margin: 20px 0;
            text-align: center;
            font-weight: bold;
        }

        .observaciones-box {
            border: 1px solid #ccc;
            padding: 10px;
            background-color: #f9f9f9;
            margin-top: 10px;
            min-height: 60px;
        }

        .firma-seccion {
            margin-top: 40px;
            page-break-inside: avoid;
        }

        .firma-contenedor {
            display: table;
            width: 100%;
            margin-top: 22px;
        }

        .firma-columna {
            display: table-cell;
            width: 50%;
            text-align: center;
            vertical-align: bottom;
        }

        .firma-linea {
            border-top: 2px solid #000;
            margin: 40px auto 5px;
            width: 70%;
        }

        .firma-nombre {
            font-weight: bold;
            font-size: 11pt;
        }

        .firma-cargo {
            font-size: 10pt;
            color: #666;
        }

        .pie-pagina {
            margin-top: 24px;
            text-align: center;
            font-size: 9pt;
            color: #666;
            border-top: 1px solid #ccc;
            padding-top: 10px;
        }
    </style>
}

<div class="header">
    <h1>Direccion General de Aviacion Civil</h1>
    <h2>Republica del Ecuador</h2>
    <p style="margin: 5px 0; font-size: 10pt;">
        <strong>CERTIFICADO DE OPERADOR AEREO COMERCIAL</strong><br />
        (AIR OPERATOR CERTIFICATE - AOC)
    </p>
</div>

<div class="certificado-numero">
    CERTIFICADO N&deg; @(!string.IsNullOrWhiteSpace(Model?.NumeroAOCR) ? System.Web.HttpUtility.HtmlEncode(Model.NumeroAOCR) : "-")
</div>

<div class="campo" style="text-align: center; margin: 10px 0;">
    <strong>Fecha de Emision:</strong> @(Model.FechaEmision.ToString("dd 'de' MMMM 'de' yyyy", new System.Globalization.CultureInfo("es-EC")))
</div>

<div class="seccion">
    <div class="seccion-titulo">I. Datos del Operador Aereo</div>
    <div class="campo">
        <span class="campo-label">Razon Social:</span>
        <span class="campo-valor">@Model.NombreOperador</span>
    </div>
    <div class="campo">
        <span class="campo-label">RUC:</span>
        <span class="campo-valor">@Model.RUC</span>
    </div>
    <div class="campo">
        <span class="campo-label">Direccion:</span>
        <span class="campo-valor">@(Model.Direccion ?? "N/A")</span>
    </div>
    <div class="campo">
        <span class="campo-label">Representante Legal:</span>
        <span class="campo-valor">@Model.RepresentanteLegal</span>
    </div>
</div>

<div class="seccion">
    <div class="seccion-titulo">II. Autorizacion de Operacion</div>
    <div class="campo">
        <span class="campo-label">Tipo de Operacion:</span>
        <span class="campo-valor">@Model.TipoOperacion</span>
    </div>
    <div class="campo">
        <span class="campo-label">Alcance:</span>
        <span class="campo-valor">@(Model.AlcanceOperacion ?? "Operaciones comerciales segun especificaciones operacionales")</span>
    </div>
</div>

<div class="seccion">
    <div class="seccion-titulo">III. Aeronaves Autorizadas</div>
    @if (!string.IsNullOrEmpty(Model.AeronavesDetalle))
    {
        <div>@Html.Raw(System.Web.HttpUtility.HtmlEncode(Model.AeronavesDetalle).Replace("\n", "<br/>"))</div>
    }
    else
    {
        <p>Segun lista de aeronaves aprobadas en especificaciones operacionales adjuntas.</p>
    }
</div>

@if (Model.FechaVencimiento.HasValue)
{
    <div class="vigencia-box">
        VIGENCIA: Del @(Model.FechaEmision.ToString("dd/MM/yyyy", new System.Globalization.CultureInfo("es-EC"))) al @(Model.FechaVencimiento.Value.ToString("dd/MM/yyyy", new System.Globalization.CultureInfo("es-EC")))
    </div>
}
else
{
    <div class="vigencia-box">
        CERTIFICADO VIGENTE - Sujeto a renovacion anual
    </div>
}

@if (!string.IsNullOrEmpty(Model.Observaciones))
{
    <div class="seccion">
        <div class="seccion-titulo">IV. Observaciones</div>
        <div class="observaciones-box">
            @Html.Raw(System.Web.HttpUtility.HtmlEncode(Model.Observaciones).Replace("\n", "<br/>"))
        </div>
    </div>
}

<div class="seccion" style="font-size: 10pt; text-align: justify;">
    <p>
        <strong>La Direccion General de Aviacion Civil (DGAC)</strong> certifica que el operador aereo mencionado ha cumplido con los requisitos establecidos en la normativa aeronautica nacional e internacional aplicable, y esta autorizado para realizar las operaciones especificadas en este certificado.
    </p>
    <p>
        Este certificado es valido siempre y cuando el operador mantenga el cumplimiento continuo de los requisitos operacionales, tecnicos y administrativos establecidos por la DGAC.
    </p>
</div>

<div class="firma-seccion">
    <div class="firma-contenedor">
        <div class="firma-columna">
            <div class="firma-linea"></div>
            <div class="firma-nombre">@(Model.AprobadoPor ?? "Director Financiero")</div>
            <div class="firma-cargo">@(Model.CargoAprobador ?? "Director Financiero - DGAC")</div>
        </div>
        <div class="firma-columna">
            @if (!string.IsNullOrEmpty(Model.RutaSelloOficial))
            {
                <div><strong>Sello oficial registrado</strong></div>
            }
            else
            {
                <div style="margin-top: 20px;">
                    <strong>SELLO OFICIAL</strong><br />
                    <span style="font-size: 9pt;">Direccion General de Aviacion Civil</span>
                </div>
            }
        </div>
    </div>
</div>

<div class="pie-pagina">
    <p>
        Direccion General de Aviacion Civil - Ecuador<br />
        Av. Amazonas N&deg; 1429 y Colon - Quito, Ecuador<br />
        Tel: (593) 2-2947400 | www.aviacioncivil.gob.ec
    </p>
    <p style="font-size: 8pt; margin-top: 5px;">
        Documento generado electronicamente el @DateTime.Now.ToString("dd/MM/yyyy HH:mm")
    </p>
</div>
