@inherits System.Web.Mvc.WebViewPage<List<CapaModelo.SolicitudAOCR>>
@using CapaModelo
@using System.Web.Mvc
@using System.Web.Mvc.Html

@{
    ViewBag.Title = "Solicitudes para Validación Técnica";
    ViewBag.PageSubtitle = "Jefatura Técnica";
    Layout = "~/Views/Shared/_LayoutAOCR.cshtml";
}

<div class="container-fluid aocr-shell">
    @Html.Partial("_HeroPanel", null, new ViewDataDictionary {
        { "IconClass", "fas fa-user-check" },
        { "Overline", "Validación Técnica" },
        { "Title", "Solicitudes pendientes de Jefatura" },
        { "Subtitle", "Control de revisión final" },
        { "Description", "Revise solicitudes pendientes y avance el flujo técnico según el estado documentado." },
        { "MetricLabel", "Pendientes" },
        { "MetricValue", Model != null ? Model.Count : 0 }
    })

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="card aocr-table-card">
        <div class="card-body p-0">
            @if (Model != null && Model.Count > 0)
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Operador</th>
                                <th>Tipo</th>
                                <th>Fecha</th>
                                <th>Estado</th>
                                <th style="width:120px;">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var s in Model)
                            {
                                <tr>
                                    <td>@Html.Encode(s.CodigoSolicitud)</td>
                                    <td>@Html.Encode(s.NombreOperador)</td>
                                    <td>@Html.Encode(s.TipoSolicitud)</td>
                                    <td>@Html.Encode(s.FechaSolicitud.HasValue ? s.FechaSolicitud.Value.ToString("dd/MM/yyyy") : "")</td>
                                    <td>@Html.Partial("_StatusBadge", null, new ViewDataDictionary { { "Status", s.Estado } })</td>
                                    <td>
                                        <a href="@Url.Action("Detalle", "SolicitudAOCR", new { id = s.CodigoSolicitud })" class="btn btn-sm btn-primary">
                                            Revisar
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="p-3">
                    @Html.Partial("_EmptyState", null, new ViewDataDictionary {
                        { "IconClass", "fas fa-clipboard-check" },
                        { "Title", "No hay solicitudes pendientes" },
                        { "Description", "Cuando existan solicitudes para validación técnica se mostrarán aquí." }
                    })
                </div>
            }
        </div>
    </div>
</div>



