@inherits System.Web.Mvc.WebViewPage<CapaPresentacion.Models.SolicitudAOCRViewModel>
@using CapaModelo
@using System.Web.Mvc
@using System.Web.Mvc.Html
@{
    Layout = null;
    var sol = Model != null ? Model.Solicitud : null;
    var codigoSolicitud = sol != null ? sol.CodigoSolicitud : 0;
}

<meta charset="UTF-8">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
<link rel="stylesheet" href="@Url.Content("~/Content/css/formulario-emision-aocr.css")">

<!-- Skip link para accesibilidad -->
<a href="#contenido-principal" class="skip-link sr-only sr-only-focusable">Saltar al contenido principal</a>

<div class="container-fluid py-4 formulario-aocr" role="main" id="contenido-principal">
    <div class="row">
        <!-- Menu lateral -->
        <div class="col-md-3 mb-4">
            <nav aria-label="Secciones del formulario">
                <div class="card shadow-sm">
                    <div class="card-body p-2">
                        <div class="list-group" id="list-tab" role="tablist">
                            <a class="list-group-item list-group-item-action active" id="list-explotador-list" data-bs-toggle="list" href="#explotador" role="tab" aria-controls="explotador" aria-selected="true">
                                <i class="fas fa-user-tie" aria-hidden="true"></i> 1. Explotador-Solicitante
                            </a>
                            <a class="list-group-item list-group-item-action" id="list-aeronaves-list" data-bs-toggle="list" href="#aeronaves" role="tab" aria-controls="aeronaves" aria-selected="false">
                                <i class="fas fa-plane" aria-hidden="true"></i> 2. Informacion de Aeronaves
                            </a>
                            <a class="list-group-item list-group-item-action" id="list-operaciones-list" data-bs-toggle="list" href="#operaciones" role="tab" aria-controls="operaciones" aria-selected="false">
                                <i class="fas fa-globe-americas" aria-hidden="true"></i> 3. Operaciones EAE
                            </a>
                            <a class="list-group-item list-group-item-action" id="list-comprobante-list" data-bs-toggle="list" href="#comprobante" role="tab" aria-controls="comprobante" aria-selected="false">
                                <i class="fas fa-receipt" aria-hidden="true"></i> 4. Comprobante
                            </a>
                            <a class="list-group-item list-group-item-action" id="list-anexos-list" data-bs-toggle="list" href="#anexos" role="tab" aria-controls="anexos" aria-selected="false">
                                <i class="fas fa-paperclip" aria-hidden="true"></i> 5. Anexos
                            </a>
                        </div>
                    </div>
                </div>
            </nav>
        </div>

        <div class="col-md-9">
            <div class="tab-content" id="nav-tabContent">

                <!-- TAB EXPLOTADOR -->
                <div class="tab-pane fade show active" id="explotador" role="tabpanel" aria-labelledby="list-explotador-list">
                    <div class="card card-custom">
                        <div class="card-header-custom">
                            <h5 class="mb-0 font-weight-bold titulo-seccion">Datos del Explotador-Solicitante</h5>
                        </div>
                        <div class="card-body card-body-custom">
                            <form id="formExplotador" novalidate>
                                @Html.AntiForgeryToken()
                                <input type="hidden" id="codigoSolicitud" value="@codigoSolicitud" />
                                <input type="hidden" id="nombreOperador" value="@(sol?.NombreOperador ?? "")" />
                                <input type="hidden" id="telefonoOperador" value="@(sol?.Telefono ?? "")" />
                                <input type="hidden" id="rucOperador" value="@(sol?.Ruc ?? "")" />
                                <input type="hidden" id="razonSocial" value="@(sol?.RazonSocial ?? "")" />
                                <input type="hidden" id="tipoOperacion" value="@(sol?.TipoOperacion ?? "")" />
                                <input type="hidden" id="descripcionOperacion" value="@(sol?.DescripcionOperacion ?? "")" />
                                <input type="hidden" id="observacionesGenerales" value="@(sol?.ObservacionesGenerales ?? "")" />

                                <!-- Punto de Contacto -->
                                <fieldset class="seccion-destacada mb-4">
                                    <legend class="titulo-subseccion"><i class="fas fa-map-marker-alt" aria-hidden="true"></i> Punto de Contacto en Ecuador</legend>

                                    <div class="form-row">
                                        <div class="form-group col-md-6">
                                            <label for="nombreRepresentante">Nombre del Representante Legal <span class="text-danger">*</span></label>
                                            <input type="text" class="form-control" id="nombreRepresentante" placeholder="Ingrese nombre del representante" value="@(sol?.RepresentanteLegal ?? "")" required aria-required="true">
                                            <div class="alerta-validacion" id="alertaNombreRepresentante">Este campo es requerido.</div>
                                        </div>
                                        <div class="form-group col-md-6">
                                            <label for="rucRepresentante">RUC</label>
                                            <input type="text" class="form-control" id="rucRepresentante" placeholder="Ingrese RUC" value="@(sol?.CedulaRepresentante ?? "")">
                                        </div>
                                    </div>

                                    <div class="form-group">
                                        <label for="direccionEcuador">Direccion en Ecuador <span class="text-danger">*</span></label>
                                        <div class="input-group">
                                            <div class="input-group-prepend">
                                                <span class="input-group-text"><i class="fas fa-home" aria-hidden="true"></i></span>
                                            </div>
                                            <input type="text" class="form-control" id="direccionEcuador" placeholder="Ingrese direccion en Ecuador" value="@(sol?.Direccion ?? "")" required aria-required="true">
                                        </div>
                                        <div class="alerta-validacion" id="alertaDireccionEcuador">Este campo es requerido.</div>
                                    </div>

                                    <div class="form-row">
                                        <div class="form-group col-md-6">
                                            <label for="telefonoEcuador">Telefono en Ecuador</label>
                                            <input type="tel" class="form-control" id="telefonoEcuador" placeholder="Ingrese telefono en Ecuador" value="@(sol?.Telefono ?? "")">
                                        </div>
                                        <div class="form-group col-md-6">
                                            <label for="emailEcuador">Email en Ecuador</label>
                                            <input type="email" class="form-control" id="emailEcuador" placeholder="Ingrese correo en Ecuador" value="@(sol?.Email ?? "")">
                                        </div>
                                    </div>
                                </fieldset>

                                <!-- Seleccion de Compania -->
                                <fieldset class="card shadow-sm mb-4">
                                    <div class="card-body">
                                        <legend class="titulo-subseccion"><i class="fas fa-building" aria-hidden="true"></i> Seleccion de Compania</legend>

                                        <div class="form-inline mb-3">
                                            <label for="selectorCompanias" class="sr-only">Seleccionar compania</label>
                                            <select id="selectorCompanias" class="form-control mr-2 custom-select" style="width: 60%;" aria-label="Seleccionar compania">
                                                <option value="" disabled selected>Seleccione una compania</option>
                                                <option value="Compania A">Compania A</option>
                                                <option value="Compania B">Compania B</option>
                                                <option value="Compania C">Compania C</option>
                                                <option value="Compania D">Compania D</option>
                                            </select>
                                            <button type="button" class="btn btn-outline-primary" id="btnAgregarCompania" aria-label="Agregar compania seleccionada">
                                                <i class="fas fa-plus" aria-hidden="true"></i> Agregar
                                            </button>
                                        </div>

                                        <div id="companiasSeleccionadas" class="companias-container" role="list" aria-label="Companias seleccionadas">
                                            <small class="text-muted d-block mb-1">Companias seleccionadas:</small>
                                        </div>
                                    </div>
                                </fieldset>

                                <!-- Datos de la Compania Principal -->
                                <fieldset class="seccion-destacada">
                                    <legend class="titulo-subseccion">Datos de la Compania Principal</legend>
                                    
                                    <div class="form-group">
                                        <label for="nombreCompania">Nombre de la Compania <span class="text-danger">*</span></label>
                                        <input type="text" class="form-control" id="nombreCompania" placeholder="Ingrese nombre de la compania" value="@(sol?.NombreOperador ?? "")" required aria-required="true">
                                        <small class="form-text text-muted mt-2">
                                            Los datos de la compania no son correctos?
                                            <a href="#" id="btnInformacionCompania" class="text-danger font-weight-bold ml-1">
                                                <i class="fas fa-exclamation-triangle" aria-hidden="true"></i> Reportar aqui
                                            </a>
                                        </small>
                                    </div>

                                    <div class="form-group">
                                        <label for="direccionCompania">Direccion de la Compania</label>
                                        <input type="text" class="form-control" id="direccionCompania" placeholder="Ingrese direccion de la compania" value="@(sol?.Direccion ?? "")">
                                    </div>

                                    <div class="form-row">
                                        <div class="form-group col-md-6">
                                            <label for="telefonoCompania">Telefono</label>
                                            <input type="tel" class="form-control" id="telefonoCompania" placeholder="Ingrese telefono" value="@(sol?.Telefono ?? "")">
                                        </div>
                                        <div class="form-group col-md-6">
                                            <label for="correoCompania">Correo Electronico</label>
                                            <input type="email" class="form-control" id="correoCompania" placeholder="Ingrese correo" value="@(sol?.Email ?? "")">
                                        </div>
                                    </div>
                                </fieldset>
                            </form>
                        </div>
                    </div>
                </div>

                <!-- TAB AERONAVES -->
                <div class="tab-pane fade" id="aeronaves" role="tabpanel" aria-labelledby="list-aeronaves-list">
                    <div class="card card-custom">
                        <div class="card-header-custom">
                            <h5 class="mb-0 font-weight-bold titulo-seccion">Informacion de las Aeronaves</h5>
                        </div>
                        <div class="card-body card-body-custom">
                            <div class="seccion-destacada mb-4">
                                <h6 class="text-muted mb-3"><small>Gestion de Flota</small></h6>
                                <div class="d-flex flex-wrap align-items-center">
                                    <button class="btn btn-success shadow-sm mr-2 mb-2" id="btnAgregarAeronave" type="button">
                                        <i class="fas fa-plus-circle" aria-hidden="true"></i> Agregar Manualmente
                                    </button>
                                    <button class="btn btn-primary shadow-sm mr-2 mb-2" id="btnCargarArchivo" type="button">
                                        <i class="fas fa-file-upload" aria-hidden="true"></i> Cargar CSV
                                    </button>
                                    <div class="btn-group mb-2 mr-2">
                                        <a href="@Url.Content("~/Content/documents/Formato_Aeronaves.xlsx")" download class="btn btn-outline-secondary">
                                            <i class="fas fa-download" aria-hidden="true"></i> Descargar Formato
                                        </a>
                                    </div>
                                    <input type="file" id="inputArchivo" accept=".csv" class="sr-only" aria-label="Seleccionar archivo CSV">
                                </div>
                                <small class="text-muted mt-2 d-block">
                                    <i class="fas fa-info-circle text-info" aria-hidden="true"></i>
                                    Solo se permite formato <strong>.csv</strong> (separado por <code>;</code>).
                                </small>
                            </div>

                            <div class="table-responsive shadow-sm rounded mb-3">
                                <table class="table table-bordered table-hover mb-0 tabla-aeronaves" id="tablaAeronaves" aria-label="Lista de aeronaves">
                                    <thead class="bg-dark text-white text-center">
                                        <tr>
                                            <th scope="col">Fabricante</th>
                                            <th scope="col">Modelo</th>
                                            <th scope="col">Serie</th>
                                            <th scope="col">Matricula</th>
                                            <th scope="col">Config.</th>
                                            <th scope="col">Etapa Ruido</th>
                                            <th scope="col">Peso</th>
                                            <th scope="col">OACI</th>
                                            <th scope="col"><span class="sr-only">Acciones</span><i class="fas fa-cogs" aria-hidden="true"></i></th>
                                        </tr>
                                    </thead>
                                    <tbody></tbody>
                                </table>
                            </div>

                            <div class="form-group mt-3">
                                <label for="contadorAeronaves" class="font-weight-bold text-secondary">Resumen de Flota</label>
                                <textarea class="form-control resumen-flota" id="contadorAeronaves" rows="3" readonly aria-readonly="true"></textarea>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- TAB OPERACIONES -->
                <div class="tab-pane fade" id="operaciones" role="tabpanel" aria-labelledby="list-operaciones-list">
                    <div class="card card-custom">
                        <div class="card-header-custom">
                            <h5 class="mb-0 font-weight-bold">Operaciones en el Ecuador</h5>
                        </div>
                        <div class="card-body card-body-custom">

                            <div class="form-group row">
                                <label for="fechaInicioOperaciones" class="col-sm-4 col-form-label font-weight-bold">Fecha propuesta inicio:</label>
                                <div class="col-sm-8">
                                    <input type="date" class="form-control" id="fechaInicioOperaciones">
                                </div>
                            </div>

                            <div class="card mb-3 border-info">
                                <div class="card-header bg-white text-info font-weight-bold">
                                    <i class="fas fa-list-ul"></i> Tipos de Operacion
                                </div>
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="custom-control custom-checkbox mb-2">
                                                <input class="custom-control-input" type="checkbox" id="opsRegulares">
                                                <label class="custom-control-label" for="opsRegulares">Operaciones Regulares</label>
                                            </div>
                                            <div class="custom-control custom-checkbox mb-2">
                                                <input class="custom-control-input" type="checkbox" id="opsNoRegulares">
                                                <label class="custom-control-label" for="opsNoRegulares">Operaciones No Regulares</label>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="custom-control custom-checkbox mb-2">
                                                <input class="custom-control-input" type="checkbox" id="pasajeros">
                                                <label class="custom-control-label" for="pasajeros">Pasajeros/Carga/Correo</label>
                                            </div>
                                            <div class="custom-control custom-checkbox mb-2">
                                                <input class="custom-control-input" type="checkbox" id="carga">
                                                <label class="custom-control-label" for="carga">Carga solamente</label>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="form-group">
                                <label for="resumenOperaciones" class="font-weight-bold">Resumen descriptivo de operaciones</label>
                                <textarea class="form-control" id="resumenOperaciones" rows="3" placeholder="Describa brevemente..."></textarea>
                            </div>

                            <hr>

                            <div class="row">
                                <div class="col-md-6">
                                    <h6 class="font-weight-bold">Aeropuertos dentro del Ecuador</h6>
                                    <div class="card p-3 bg-light border-0">
                                        <div class="custom-control custom-checkbox">
                                            <input class="custom-control-input" type="checkbox" id="quito">
                                            <label class="custom-control-label" for="quito">Quito (UIO)</label>
                                        </div>
                                        <div class="custom-control custom-checkbox">
                                            <input class="custom-control-input" type="checkbox" id="guayaquil">
                                            <label class="custom-control-label" for="guayaquil">Guayaquil (GYE)</label>
                                        </div>
                                        <div class="custom-control custom-checkbox">
                                            <input class="custom-control-input" type="checkbox" id="cuenca">
                                            <label class="custom-control-label" for="cuenca">Cuenca (CUE)</label>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <h6 class="font-weight-bold">Interfronterizos</h6>
                                    <div class="card p-3 border-warning">
                                        <div class="custom-control custom-checkbox">
                                            <input class="custom-control-input" type="checkbox" id="activarInterfronterizos" onchange="document.getElementById('opcionesInterfronterizos').style.display = this.checked ? 'block' : 'none'">
                                            <label class="custom-control-label text-warning font-weight-bold" for="activarInterfronterizos">Activar Operaciones Interfronterizas</label>
                                        </div>
                                        <div id="opcionesInterfronterizos" style="display:none; margin-top: 10px; padding-left: 10px;">
                                            <div class="custom-control custom-checkbox">
                                                <input class="custom-control-input" type="checkbox" id="interfronterizo1">
                                                <label class="custom-control-label" for="interfronterizo1">Frontera Norte (Ej. Tulcan)</label>
                                            </div>
                                            <div class="custom-control custom-checkbox">
                                                <input class="custom-control-input" type="checkbox" id="interfronterizo2">
                                                <label class="custom-control-label" for="interfronterizo2">Frontera Sur (Ej. Huaquillas)</label>
                                            </div>
                                            <div class="custom-control custom-checkbox">
                                                <input class="custom-control-input" type="checkbox" id="interfronterizo3">
                                                <label class="custom-control-label" for="interfronterizo3">Frontera Este (Ej. Lago Agrio)</label>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- TAB COMPROBANTE -->
                <div class="tab-pane fade" id="comprobante" role="tabpanel" aria-labelledby="list-comprobante-list">
                    <div class="card card-custom">
                        <div class="card-header-custom">
                            <h5 class="mb-0 font-weight-bold">Comprobante Requerido</h5>
                        </div>
                        <div class="card-body card-body-custom">

                            <div class="alert alert-info border-info shadow-sm" role="alert">
                                <i class="fas fa-info-circle fa-lg mr-2"></i>
                                <strong>Instrucciones:</strong> Tamano maximo <strong>2 MB</strong>. Formatos: PDF, JPG, PNG.
                            </div>

                            <div class="card p-4 border-primary">
                                <div class="form-group text-center">
                                    <label class="font-weight-bold h5 d-block mb-3 text-primary">Copia de comprobante de pago *</label>

                                    <div class="border rounded p-4 bg-light mb-3">
                                        <input type="file" class="form-control-file d-block mx-auto mb-2" id="archivoFacturaPago" accept=".pdf" required onchange="validarArchivo('archivoFacturaPago'); mostrarVistaPreviaArchivo('archivoFacturaPago', 'vistaPreviaFacturaPago')">

                                        <div class="mt-2" id="vistaPreviaFacturaPago" style="display:none;">
                                            <a href="#" class="btn btn-sm btn-info shadow-sm" target="_blank"><i class="fas fa-eye"></i> Visualizar archivo cargado</a>
                                        </div>
                                    </div>

                                    <div class="custom-control custom-checkbox mb-3">
                                        <input class="custom-control-input" type="checkbox" id="chkFacturaPago" onchange="toggleCaptura('archivoFacturaPago', 'capturaFacturaPago', this)">
                                        <label class="custom-control-label text-danger" for="chkFacturaPago">El archivo supera el tamano permitido</label>
                                    </div>

                                    <div id="capturaFacturaPago" style="display:none;" class="mb-3 p-3 border border-danger rounded bg-white">
                                        <label>Subir captura de pantalla (JPG/PNG)</label>
                                        <input type="file" class="form-control-file" accept=".jpg,.jpeg,.png">
                                    </div>

                                    <label class="text-left w-100 font-weight-bold">Descripcion / Enlace:</label>
                                    <textarea class="form-control" id="conceptoFacturaPago" rows="2" placeholder="Ingrese enlace o descripcion..." required onblur="validarConcepto('conceptoFacturaPago')"></textarea>
                                    <div class="text-danger small mt-1 text-left" id="alertaConceptoFacturaPago" style="display:none;">Debe ingresar un enlace o descripcion valida.</div>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>

                <!-- TAB ANEXOS -->
                <div class="tab-pane fade" id="anexos" role="tabpanel" aria-labelledby="list-anexos-list">
                    <div class="card card-custom">
                        <div class="card-header-custom">
                            <h5 class="mb-0 font-weight-bold">Documentacion y Anexos</h5>
                        </div>
                        <div class="card-body card-body-custom">
                            <div style="max-height: 65vh; overflow-y: auto; padding: 10px;">
                                <form id="formAnexos">

                                    <div class="anexo-item">
                                        <div class="d-flex justify-content-between">
                                            <label class="font-weight-bold text-dark"><span class="badge badge-primary mr-2">1</span> Copia de AOC valida *</label>
                                            <i class="fas fa-file-pdf text-danger fa-lg"></i>
                                        </div>
                                        <input type="file" class="form-control-file mb-2 mt-2" id="archivoAOC" accept=".pdf" required onchange="validarArchivo('archivoAOC')">

                                        <div class="custom-control custom-checkbox mb-2">
                                            <input class="custom-control-input" type="checkbox" id="chkAOC" onchange="toggleCaptura('archivoAOC', 'capturaAOC', this)">
                                            <label class="custom-control-label text-muted" for="chkAOC"><small>Supera tamano permitido</small></label>
                                        </div>
                                        <div id="capturaAOC" style="display:none;" class="p-2 bg-light border mb-2">
                                            <input type="file" class="form-control-file" accept=".jpg,.jpeg,.png">
                                        </div>
                                        <textarea class="form-control form-control-sm" id="conceptoAOC" rows="1" placeholder="Enlace o descripcion..." required onblur="validarConcepto('conceptoAOC')"></textarea>
                                        <div class="text-danger small mt-1" id="alertaConceptoAOC" style="display:none;">Requerido.</div>
                                    </div>

                                    <div class="anexo-item">
                                        <div class="d-flex justify-content-between">
                                            <label class="font-weight-bold text-dark"><span class="badge badge-primary mr-2">2</span> OpSpecs (Especificaciones) *</label>
                                            <i class="fas fa-file-pdf text-danger fa-lg"></i>
                                        </div>
                                        <input type="file" class="form-control-file mb-2 mt-2" id="archivoOpSpecs" accept=".pdf" required onchange="validarArchivo('archivoOpSpecs')">
                                        <div class="custom-control custom-checkbox mb-2">
                                            <input class="custom-control-input" type="checkbox" id="chkOpSpecs" onchange="toggleCaptura('archivoOpSpecs', 'capturaOpSpecs', this)">
                                            <label class="custom-control-label text-muted" for="chkOpSpecs"><small>Supera tamano permitido</small></label>
                                        </div>
                                        <div id="capturaOpSpecs" style="display:none;" class="p-2 bg-light border mb-2">
                                            <input type="file" class="form-control-file" accept=".jpg,.jpeg,.png">
                                        </div>
                                        <textarea class="form-control form-control-sm" id="conceptoOpSpecs" rows="1" placeholder="Enlace o descripcion..." required onblur="validarConcepto('conceptoOpSpecs')"></textarea>
                                        <div class="text-danger small mt-1" id="alertaConceptoOpSpecs" style="display:none;">Requerido.</div>
                                    </div>

                                    <div class="anexo-item">
                                        <div class="d-flex justify-content-between">
                                            <label class="font-weight-bold text-dark"><span class="badge badge-primary mr-2">3</span> Manual de Operaciones *</label>
                                            <i class="fas fa-book text-info fa-lg"></i>
                                        </div>
                                        <input type="file" class="form-control-file mb-2 mt-2" id="archivoManualOperaciones" accept=".pdf" required onchange="validarArchivo('archivoManualOperaciones')">
                                        <div class="custom-control custom-checkbox mb-2">
                                            <input class="custom-control-input" type="checkbox" id="chkManualOperaciones" onchange="toggleCaptura('archivoManualOperaciones', 'capturaManualOperaciones', this)">
                                            <label class="custom-control-label text-muted" for="chkManualOperaciones"><small>Supera tamano permitido</small></label>
                                        </div>
                                        <div id="capturaManualOperaciones" style="display:none;" class="p-2 bg-light border mb-2">
                                            <input type="file" class="form-control-file" accept=".jpg,.jpeg,.png">
                                        </div>
                                        <textarea class="form-control form-control-sm" id="conceptoManualOperaciones" rows="1" placeholder="Enlace o descripcion..." required onblur="validarConcepto('conceptoManualOperaciones')"></textarea>
                                        <div class="text-danger small mt-1" id="alertaConceptoManualOperaciones" style="display:none;">Requerido.</div>
                                    </div>

                                    <div class="anexo-item">
                                        <div class="d-flex justify-content-between">
                                            <label class="font-weight-bold text-dark"><span class="badge badge-primary mr-2">4</span> Carta aprobacion MEL *</label>
                                            <i class="fas fa-file-signature text-success fa-lg"></i>
                                        </div>
