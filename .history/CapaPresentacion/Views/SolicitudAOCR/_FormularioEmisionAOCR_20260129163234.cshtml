<script src="@Url.Content("~/Scripts/formulario-emision-aocr.js")"></script>
<script>
    // Inicializar el modulo con las URLs del servidor
    $(document).ready(function() {
        FormularioAOCR.init({
            urlGuardar: '@Url.Action("FormularioCompleto", "SolicitudAOCR")',
            urlIndex: '@Url.Action("Index", "SolicitudAOCR")',
            urlLogin: '@Url.Action("Login", "Account")'
        });

        // Eventos de botones principales
        $('#btnCancelar').on('click', function() {
            FormularioAOCR.Formulario.cancelar();
        });

        $('#btnGuardar').on('click', function() {
            FormularioAOCR.Formulario.guardar();
        });

        $('#btnAgregarCompania').on('click', function() {
            FormularioAOCR.Companias.agregar();
        });
    });
</script>