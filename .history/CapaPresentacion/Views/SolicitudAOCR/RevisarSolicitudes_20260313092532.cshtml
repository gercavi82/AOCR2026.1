@model List<CapaModelo.SolicitudAOCR>
@using CapaModelo
@using System.Web.Mvc
@using System.Web.Mvc.Html

@{
    ViewBag.Title = "Solicitudes Pendientes de Revisión";
    ViewBag.PageSubtitle = "Gestión Técnica";
    Layout = "~/Views/Shared/_LayoutAOCR.cshtml";
}

<div class="container-fluid aocr-shell">
    @Html.Partial("_HeroPanel", null, new ViewDataDictionary {
        { "IconClass", "fas fa-tasks" },
        { "Overline", "Flujo Técnico AOCR" },
        { "Title", "Solicitudes Pendientes de Revisión" },
        { "Subtitle", "Inspección y control técnico" },
        { "Description", "Seleccione una solicitud para revisar documentos y avanzar el proceso de evaluación." },
        { "MetricLabel", "Pendientes" },
        { "MetricValue", Model != null ? Model.Count : 0 }
    })

    @Html.Partial("_ActionToolbar", null, new ViewDataDictionary {
        { "LeftTitle", "Bandeja de revisión" },
        { "LeftDescription", "Priorice solicitudes pendientes y acceda al detalle para registrar observaciones." }
    })

    <div class="card aocr-table-card">
        <div class="card-body p-0">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Código</th>
                                <th>Operador</th>
                                <th>Fecha Solicitud</th>
                                <th>Estado</th>
                                <th style="width:130px;">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@Html.Encode(item.CodigoSolicitud)</td>
                                    <td>@Html.Encode(item.NombreOperador)</td>
                                    <td>@(item.FechaSolicitud.HasValue ? item.FechaSolicitud.Value.ToString("dd/MM/yyyy") : "")</td>
                                    <td>
                                        @Html.Partial("_StatusBadge", null, new ViewDataDictionary { { "Status", item.Estado } })
                                    </td>
                                    <td>
                                        @Html.ActionLink("Revisar", "Detalle", "SolicitudAOCR", new { id = item.CodigoSolicitud }, new { @class = "btn btn-sm btn-primary" })
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="p-3">
                    @Html.Partial("_EmptyState", null, new ViewDataDictionary {
                        { "IconClass", "fas fa-clipboard-check" },
                        { "Title", "No hay solicitudes pendientes." },
                        { "Description", "Cuando existan solicitudes para revisión técnica, se mostrarán en esta bandeja." }
                    })
                </div>
            }
        </div>
    </div>
</div>



