@inherits System.Web.Mvc.WebViewPage
@using CapaModelo
@using System.Web.Mvc
@using System.Web.Mvc.Html
@{
    ViewBag.Title = "Dashboard";
    Layout = "~/Views/Shared/_LayoutAOCR.cshtml";
}

<!-- Estilos mejorados para el Dashboard -->
<link href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" rel="stylesheet" />

<style>
:root {
    --primary-gradient: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    --success-gradient: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);
    --warning-gradient: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
    --info-gradient: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
    --card-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
    --hover-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
}

body {
    background: linear-gradient(120deg, #a8edea 0%, #fed6e3 100%);
    min-height: 100vh;
}

.dashboard-header {
    background: var(--primary-gradient);
    color: white;
    padding: 2rem 0;
    border-radius: 15px;
    margin-bottom: 2rem;
    box-shadow: var(--card-shadow);
}

.dashboard-title {
    font-size: 2.5rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
}

.dashboard-subtitle {
    font-size: 1.1rem;
    opacity: 0.9;
    margin-bottom: 0;
}

.kpi-card {
    background: white;
    border: none;
    border-radius: 20px;
    padding: 2rem 1.5rem;
    text-align: center;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: var(--card-shadow);
    overflow: hidden;
    position: relative;
    cursor: pointer;
    height: 180px;
    margin-bottom: 2rem;
}

.kpi-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: var(--primary-gradient);
    transition: height 0.3s ease;
}

.kpi-card:hover {
    transform: translateY(-10px) scale(1.02);
    box-shadow: var(--hover-shadow);
}

.kpi-card:hover::before {
    height: 100%;
    opacity: 0.05;
}

.kpi-card.success::before { background: var(--success-gradient); }
.kpi-card.warning::before { background: var(--warning-gradient); }
.kpi-card.info::before { background: var(--info-gradient); }

.kpi-icon {
    font-size: 3rem;
    margin-bottom: 1rem;
    background: var(--primary-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
}

.kpi-value {
    font-size: 2.5rem;
    font-weight: 800;
    margin-bottom: 0.5rem;
    background: var(--primary-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
}

.kpi-label {
    font-size: 1rem;
    font-weight: 600;
    color: #6c757d;
    margin-bottom: 0.5rem;
}

.modern-card {
    background: white;
    border: none;
    border-radius: 20px;
    box-shadow: var(--card-shadow);
    overflow: hidden;
    transition: all 0.3s ease;
}

.modern-card:hover {
    transform: translateY(-5px);
    box-shadow: var(--hover-shadow);
}

.card-header-gradient {
    background: var(--primary-gradient);
    color: white;
    padding: 1.5rem;
    border: none;
}

.table-modern {
    border-radius: 15px;
    overflow: hidden;
    box-shadow: var(--card-shadow);
}

.table-modern thead th {
    background: var(--primary-gradient);
    color: white;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    border: none;
    padding: 1.2rem 1rem;
}

.table-modern tbody tr {
    transition: all 0.3s ease;
    border: none;
}

.table-modern tbody tr:hover {
    background: linear-gradient(90deg, rgba(102, 126, 234, 0.05) 0%, rgba(255, 255, 255, 0) 100%);
    transform: scale(1.01);
}

.table-modern tbody td {
    padding: 1rem;
    vertical-align: middle;
    border: none;
    border-bottom: 1px solid #f8f9fa;
}

.btn-action {
    border-radius: 12px;
    padding: 0.5rem 1rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    transition: all 0.3s ease;
    border: none;
    margin: 0 0.25rem;
}

.btn-action:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.2);
}

.quick-actions {
    background: white;
    border-radius: 20px;
    padding: 2rem;
    box-shadow: var(--card-shadow);
}

.quick-action-btn {
    background: white;
    border: 2px solid #e9ecef;
    border-radius: 15px;
    padding: 1.5rem;
    text-align: center;
    transition: all 0.3s ease;
    text-decoration: none;
    color: #6c757d;
    display: block;
    margin-bottom: 1rem;
}

.quick-action-btn:hover {
    border-color: #667eea;
    background: linear-gradient(135deg, rgba(102, 126, 234, 0.1) 0%, rgba(255, 255, 255, 1) 100%);
    transform: translateY(-3px);
    color: #667eea;
    text-decoration: none;
}

.loading-pulse {
    animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
}

@@keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: .5; }
}

@@media (max-width: 768px) {
    .kpi-card {
        height: 160px;
        padding: 1.5rem 1rem;
    }
    
    .kpi-value {
        font-size: 2rem;
    }
    
    .dashboard-title {
        font-size: 2rem;
    }
}
</style>

<div class="container-fluid">
    <!-- Header del Dashboard Mejorado -->
    <div class="dashboard-header text-center animate__animated animate__fadeInDown">
        <div class="container">
            <h1 class="dashboard-title">
                <i class="fas fa-tachometer-alt me-3"></i>
                Dashboard AOCR
            </h1>
            <p class="dashboard-subtitle">
                Sistema Integral de Órdenes de Recaudación - Monitoreo en tiempo real
            </p>
        </div>
    </div>

    <!-- KPIs Rediseñados -->
    <div class="row mb-5">
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="kpi-card animate__animated animate__zoomIn" style="animation-delay: 0.1s">
                <div class="kpi-icon">
                    <i class="fas fa-clock"></i>
                </div>
                <div class="kpi-value" id="ordenesPendientes">0</div>
                <div class="kpi-label">Órdenes Pendientes</div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="kpi-card success animate__animated animate__zoomIn" style="animation-delay: 0.2s">
                <div class="kpi-icon" style="background: var(--success-gradient); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
                    <i class="fas fa-check-circle"></i>
                </div>
                <div class="kpi-value" id="ordenesCompletadas">0</div>
                <div class="kpi-label">Órdenes Completadas</div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="kpi-card info animate__animated animate__zoomIn" style="animation-delay: 0.3s">
                <div class="kpi-icon" style="background: var(--info-gradient); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
                    <i class="fas fa-dollar-sign"></i>
                </div>
                <div class="kpi-value" id="totalRecaudado">$0.00</div>
                <div class="kpi-label">Total Recaudado</div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="kpi-card warning animate__animated animate__zoomIn" style="animation-delay: 0.4s">
                <div class="kpi-icon" style="background: var(--warning-gradient); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
                    <i class="fas fa-calendar-alt"></i>
                </div>
                <div class="kpi-value" id="ultimaOrden">N/A</div>
                <div class="kpi-label">Última Orden</div>
            </div>
        </div>
    </div>

    <!-- Tabla de Órdenes Recientes Mejorada -->
    <div class="row">
        <div class="col-12">
            <div class="enhanced-table-card animate__animated animate__fadeInUp" style="animation-delay: 0.5s">
                <div class="card-header gradient-header">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="mb-0 text-white">
                            <i class="fas fa-list-alt me-2"></i>
                            Órdenes de Recaudación Recientes
                        </h5>
                        <div class="header-actions">
                            <button type="button" class="btn btn-outline-light btn-sm" id="refreshTable">
                                <i class="fas fa-sync-alt me-1"></i>
                                Actualizar
                            </button>
                            <div id="loadingOrdenes" class="text-light d-none ms-2">
                                <i class="fas fa-spinner fa-spin me-1"></i> Cargando...
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card-body p-0">
                    <div class="table-responsive modern-table">
                        <table class="table table-hover align-middle mb-0" id="tablaOrdenes" width="100%">
                            <thead class="table-light">
                                <tr>
                                    <th class="border-0 fw-bold">Número</th>
                                    <th class="border-0 fw-bold">Fecha</th>
                                    <th class="border-0 fw-bold">Estado</th>
                                    <th class="border-0 fw-bold">Total</th>
                                    <th class="border-0 fw-bold" style="width:140px;">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                <!-- DataTables manejará el contenido -->
                            </tbody>
                        </table>
                    </div>
                    <div class="card-footer bg-light">
                        <small class="text-muted">
                            <i class="fas fa-info-circle me-1"></i>
                            Las órdenes se actualizan automáticamente cada 30 segundos
                        </small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Acciones Rápidas Mejoradas -->
    <div class="row">
        <div class="col-12">
            <div class="enhanced-table-card animate__animated animate__fadeInUp" style="animation-delay: 0.6s">
                <div class="card-header gradient-header">
                    <h5 class="mb-0 text-white">
                        <i class="fas fa-bolt me-2"></i>
                        Acciones Rápidas
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-3">
                            <div class="quick-action-card primary">
                                <a href="@Url.Action("Nueva", "OrdenRecaudacion")" class="stretched-link">
                                    <div class="action-icon">
                                        <i class="fas fa-plus"></i>
                                    </div>
                                    <div class="action-content">
                                        <h6 class="action-title">Nueva Orden</h6>
                                        <p class="action-description">Crear una nueva orden de recaudación</p>
                                    </div>
                                </a>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="quick-action-card success">
                                <a href="@Url.Action("Obligatoria", "OrdenRecaudacion")" class="stretched-link">
                                    <div class="action-icon">
                                        <i class="fas fa-list"></i>
                                    </div>
                                    <div class="action-content">
                                        <h6 class="action-title">Mis Órdenes</h6>
                                        <p class="action-description">Ver y gestionar mis órdenes asignadas</p>
                                    </div>
                                </a>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="quick-action-card info">
                                <a href="@Url.Action("Index", "Reporte")" class="stretched-link">
                                    <div class="action-icon">
                                        <i class="fas fa-chart-bar"></i>
                                    </div>
                                    <div class="action-content">
                                        <h6 class="action-title">Reportes</h6>
                                        <p class="action-description">Generar reportes y análisis</p>
                                    </div>
                                </a>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="quick-action-card warning">
                                <a href="@Url.Action("Index", "Auditoria")" class="stretched-link">
                                    <div class="action-icon">
                                        <i class="fas fa-search"></i>
                                    </div>
                                    <div class="action-content">
                                        <h6 class="action-title">Auditoría</h6>
                                        <p class="action-description">Revisar logs y actividades</p>
                                    </div>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
                            <a href="@Url.Action("Index", "Reportes")" class="btn btn-info w-100 text-white">
                                <i class="fas fa-chart-bar"></i> Reportes
                            </a>
                        </div>
                        <div class="col-md-3 mb-3">
                            <a href="@Url.Action("Logout", "Account")" class="btn btn-warning w-100">
                                <i class="fas fa-sign-out-alt"></i> Cerrar Sesión
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

@section Scripts {
    <!-- Agregamos el CSS de Animate.css -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css">
    
    <script>
(function () {
    'use strict';

    var dt = null;

    function onDataTablesReady(callback) {
        if (window.jQuery && window.jQuery.fn && window.jQuery.fn.DataTable) {
            callback();
            return;
        }
        var handler = function () {
            document.removeEventListener('AOCR.DataTablesReady', handler);
            callback();
        };
        document.addEventListener('AOCR.DataTablesReady', handler);
    }

    // ⚡ Funciones mejoradas con efectos visuales
    function showLoading(show) {
        var el = document.getElementById('loadingOrdenes');
        if (!el) return;
        el.classList.toggle('d-none', !show);
    }

    function badgeEstado(estado) {
        var e = String(estado || '').toUpperCase();
        var animateClass = 'animate__animated animate__pulse';
        
        if (e === 'BORRADOR')   return '<span class="badge bg-warning text-dark ' + animateClass + '">BORRADOR</span>';
        if (e === 'COMPLETADA') return '<span class="badge bg-success ' + animateClass + '">COMPLETADA</span>';
        if (e === 'PAGADA')     return '<span class="badge bg-primary ' + animateClass + '">PAGADA</span>';
        return '<span class="badge bg-secondary ' + animateClass + '">' + (estado || 'N/D') + '</span>';
    }

    function formatFecha(data) {
        if (!data) return 'N/D';
        var d = new Date(data);
        if (isNaN(d.getTime())) return 'N/D';
        return d.toLocaleDateString('es-EC');
    }

    function formatMoney(v) {
        var n = Number(v || 0);
        return new Intl.NumberFormat('es-EC', { style: 'currency', currency: 'USD' }).format(n);
    }

    function initTable() {
        // Validación fuerte: si jQuery o DataTables no cargaron, no rompas la página
        if (!window.jQuery) {
            console.error("jQuery NO está cargado -> '$ is not defined'. Revisa Layout/Bundles/CSP.");
            return false;
        }
        if (!$.fn || !$.fn.DataTable) {
            console.error("DataTables NO está cargado -> 'DataTable is not a function'. Revisa bundles/datatables.");
            return false;
        }

        // Evitar doble inicialización si el partial se renderiza 2 veces
        if ($.fn.DataTable.isDataTable('#tablaOrdenes')) {
            dt = $('#tablaOrdenes').DataTable();
            return true;
        }

        dt = $('#tablaOrdenes').DataTable({
            // ✅ Idioma LOCAL (evita CSP/CDN)
            language: { url: '@Url.Content("~/Content/plugins/datatables/i18n/Spanish.json")' },

            order: [[1, 'desc']],
            autoWidth: false,
            responsive: true,
            processing: true,

            columns: [
                { data: 'numeroOrden', defaultContent: '' },
                {
                    data: 'fechaCreacion',
                    defaultContent: '',
                    render: function (data) { return formatFecha(data); }
                },
                {
                    data: 'estado',
                    defaultContent: 'N/D',
                    render: function (estado) { return badgeEstado(estado); }
                },
                {
                    data: 'total',
                    defaultContent: 0,
                    render: function (t) { return formatMoney(t); }
                },
                {
                    data: null,
                    orderable: false,
                    searchable: false,
                    render: function (row) {
                        var id = row && row.id ? row.id : 0;
                        return (
                            '<div class="btn-group" role="group">' +
                                '<a href="/Orden/Detalle/' + id + '" class="btn btn-action btn-info btn-sm" title="Ver Detalle">' +
                                    '<i class="fas fa-eye"></i>' +
                                '</a>' +
                                '<a href="/OrdenRecaudacion/DescargarPdf/' + id + '" class="btn btn-action btn-primary btn-sm" title="Descargar PDF">' +
                                    '<i class="fas fa-download"></i>' +
                                '</a>' +
                            '</div>'
                        );
                    }
                }
            ]
        });

        return true;
    }

    function cargarDatosDashboard() {
        if (!dt) return;

        showLoading(true);
        
        // Animación de carga en KPIs
        $('.kpi-value').addClass('animate__animated animate__pulse');

        $.ajax({
            url: '@Url.Action("ObtenerDatosDashboard", "Dashboard")',
            type: 'GET',
            dataType: 'json',
            cache: false,
            success: function (data) {
                if (!data || !data.success) return;

                // Animación de contador para KPIs
                animateCounter('#ordenesPendientes', data.ordenesPendientes || 0);
                animateCounter('#ordenesCompletadas', data.ordenesCompletadas || 0);
                animateMoney('#totalRecaudado', data.totalRecaudado || 0);
                $('#ultimaOrden').text(data.ultimaOrden || 'N/A');

                var ordenes = data.ordenesRecientes || [];
                dt.clear().rows.add(ordenes).draw();
                
                // Notificación de éxito
                showToast('Datos actualizados correctamente', 'success');
            },
            error: function (xhr) {
                console.log('Error al cargar datos del dashboard', xhr && xhr.status);
                showToast('Error al cargar los datos', 'error');
            },
            complete: function () {
                showLoading(false);
                $('.kpi-value').removeClass('animate__animated animate__pulse');
            }
        });
    }

    // Función para animar contadores
    function animateCounter(element, target) {
        var $el = $(element);
        var current = parseInt($el.text()) || 0;
        var increment = (target - current) / 20;
        var counter = 0;
        
        var timer = setInterval(function() {
            counter += increment;
            $el.text(Math.floor(counter));
            
            if (++current >= 20 || Math.abs(counter - target) < 1) {
                clearInterval(timer);
                $el.text(target);
            }
        }, 50);
    }

    function animateMoney(element, target) {
        var $el = $(element);
        var current = parseFloat($el.text().replace(/[^0-9.-]+/g, '')) || 0;
        var increment = (target - current) / 20;
        var counter = current;
        
        var timer = setInterval(function() {
            counter += increment;
            $el.text(formatMoney(counter));
            
            if (Math.abs(counter - target) < 1) {
                clearInterval(timer);
                $el.text(formatMoney(target));
            }
        }, 50);
    }

    // Función para mostrar notificaciones toast
    function showToast(message, type) {
        var toastHtml = '<div class="toast align-items-center text-white bg-' + 
                       (type === 'success' ? 'success' : 'danger') + 
                       ' border-0" role="alert" aria-live="assertive" aria-atomic="true">' +
                       '<div class="d-flex"><div class="toast-body">' + message + '</div>' +
                       '<button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button></div></div>';
        
        var $toastContainer = $('.toast-container');
        if ($toastContainer.length === 0) {
            $('body').append('<div class="toast-container position-fixed bottom-0 end-0 p-3"></div>');
            $toastContainer = $('.toast-container');
        }
        
        var $toast = $(toastHtml);
        $toastContainer.append($toast);
        
        var toast = new bootstrap.Toast($toast[0]);
        toast.show();
        
        $toast.on('hidden.bs.toast', function() {
            $(this).remove();
        });
    }

    $(function () {
        onDataTablesReady(function () {
            if (initTable()) {
                cargarDatosDashboard();
                
                // Botón de actualización manual
                $('#refreshTable').on('click', function() {
                    $(this).addClass('animate__animated animate__rotateIn');
                    cargarDatosDashboard();
                    
                    setTimeout(() => {
                        $(this).removeClass('animate__animated animate__rotateIn');
                    }, 1000);
                });
                
                // Auto-refresh cada 30 segundos
                setInterval(cargarDatosDashboard, 30000);
            }
        });
        
        // Efecto hover en las tarjetas KPI
        $('.kpi-card').hover(
            function() {
                $(this).addClass('animate__animated animate__pulse');
            },
            function() {
                $(this).removeClass('animate__animated animate__pulse');
            }
        );
        
        // Efecto hover en las acciones rápidas
        $('.quick-action-card').hover(
            function() {
                $(this).addClass('animate__animated animate__bounceIn');
            },
            function() {
                $(this).removeClass('animate__animated animate__bounceIn');
            }
        );
    });

    // opcional: refrescar cada X segundos
    // setInterval(cargarDatosDashboard, 60000);

})();
    </script>
}


