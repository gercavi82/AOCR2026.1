@model CapaPresentacion.Models.AocrDocumentoEdicionViewModel
@using System.Collections.Generic

@{
    Layout = "~/Views/Shared/_LayoutAOCR.cshtml";
    ViewBag.Title = "Completar Reconocimiento AOCR";
}

<div class="container-fluid mt-4">
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body d-flex flex-column flex-lg-row justify-content-between gap-3 align-items-lg-center">
            <div>
                <h2 class="mb-1">Completar Reconocimiento AOCR</h2>
                <p class="text-muted mb-0">Revise y complete la informacion antes de generar el documento para firma.</p>
            </div>
            <div class="d-flex gap-2 flex-wrap">
                <a class="btn btn-outline-secondary" href="@Url.Action("ValidarAocr", "CoordinacionJefatura")">Volver a la bandeja</a>
                <a class="btn btn-outline-dark" href="@Url.Action("Detalle", "SolicitudAOCR", new { id = Model.SolicitudId })">Abrir tramite</a>
            </div>
        </div>
    </div>

    @using (Html.BeginForm("GenerarDocumentoValidacionAocr", "CoordinacionJefatura", FormMethod.Post, new { target = "_blank", enctype = "multipart/form-data", id = "formDocumentoAocr" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.SolicitudId)
        @Html.HiddenFor(m => m.InspeccionId)
        @Html.HiddenFor(m => m.TipoDocumento)
        @Html.HiddenFor(m => m.NumeroAocr)
        @Html.HiddenFor(m => m.NombreDocumento)
        @Html.HiddenFor(m => m.UsaPosicionFirmaPersonalizada)
        @Html.HiddenFor(m => m.NumeroPaginaFirma)
        @Html.HiddenFor(m => m.PosicionFirmaX)
        @Html.HiddenFor(m => m.PosicionFirmaY)
        @Html.HiddenFor(m => m.AnchoFirma)
        @Html.HiddenFor(m => m.AltoFirma)

        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white border-0 pb-0">
                <h4 class="mb-0">Datos generales</h4>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label">Numero AOCR</label>
                        @Html.TextBoxFor(m => m.NumeroAocr, new { @class = "form-control", @readonly = "readonly" })
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Numero certificado original</label>
                        @Html.TextBoxFor(m => m.AocOriginalNumero, new { @class = "form-control" })
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Estado otorgante</label>
                        @Html.TextBoxFor(m => m.EstadoOtorgante, new { @class = "form-control" })
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Fecha emision documento</label>
                        @Html.TextBoxFor(m => m.FechaEmisionDocumento, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Nombre del explotador</label>
                        @Html.TextBoxFor(m => m.NombreExplotador, new { @class = "form-control" })
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Razon social</label>
                        @Html.TextBoxFor(m => m.RazonSocial, new { @class = "form-control" })
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Estado del explotador</label>
                        @Html.TextBoxFor(m => m.EstadoExplotador, new { @class = "form-control" })
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Direccion del explotador</label>
                        @Html.TextAreaFor(m => m.DireccionExplotador, new { @class = "form-control", rows = "2" })
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Telefono</label>
                        @Html.TextBoxFor(m => m.TelefonoExplotador, new { @class = "form-control" })
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Correo</label>
                        @Html.TextBoxFor(m => m.CorreoExplotador, new { @class = "form-control" })
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white border-0 pb-0">
                <h4 class="mb-0">Contacto en Ecuador y soporte operacional</h4>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">Punto de contacto en Ecuador</label>
                        @Html.TextBoxFor(m => m.PuntoContactoEcuador, new { @class = "form-control" })
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Representante tecnico</label>
                        @Html.TextBoxFor(m => m.RepresentanteTecnico, new { @class = "form-control" })
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Telefono de contacto</label>
                        @Html.TextBoxFor(m => m.ContactoTelefono, new { @class = "form-control" })
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Direccion de contacto</label>
                        @Html.TextAreaFor(m => m.ContactoDireccion, new { @class = "form-control", rows = "2" })
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Correo de contacto</label>
                        @Html.TextBoxFor(m => m.ContactoCorreo, new { @class = "form-control" })
                    </div>
                    <div class="col-12">
                        <label class="form-label">Puntos de contacto operacionales</label>
                        @Html.TextAreaFor(m => m.PuntosContactoOperacionales, new { @class = "form-control", rows = "4" })
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white border-0 pb-0">
                <h4 class="mb-0">Sustento y observaciones</h4>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Base legal / referencia</label>
                        @Html.TextAreaFor(m => m.BaseLegalReferencia, new { @class = "form-control", rows = "4" })
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Observaciones del reconocimiento</label>
                        @Html.TextAreaFor(m => m.ObservacionesReconocimiento, new { @class = "form-control", rows = "4" })
                    </div>
                    <div class="col-12">
                        <label class="form-label">Observaciones de validacion final</label>
                        @Html.TextAreaFor(m => m.ObservacionesValidacionFinal, new { @class = "form-control", rows = "3", placeholder = "Notas previas a la firma, referencias o condicionantes internas." })
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white border-0 pb-0">
                <h4 class="mb-0">Control de firmas</h4>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label">Fecha expedicion</label>
                        @Html.TextBoxFor(m => m.FechaExpedicion, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Fecha renovacion</label>
                        @Html.TextBoxFor(m => m.FechaRenovacion, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Fecha vencimiento</label>
                        @Html.TextBoxFor(m => m.FechaVencimiento, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Elaborado por</label>
                        @Html.TextBoxFor(m => m.ElaboradoPor, new { @class = "form-control" })
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Revisado por</label>
                        @Html.TextBoxFor(m => m.RevisadoPor, new { @class = "form-control" })
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Firmante final</label>
                        @Html.TextBoxFor(m => m.FirmanteNombre, new { @class = "form-control" })
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Cargo firmante</label>
                        @Html.TextBoxFor(m => m.FirmanteCargo, new { @class = "form-control" })
                    </div>
                    <div class="col-md-5">
                        <label class="form-label">Certificado digital (.p12 / .pfx)</label>
                        <input type="file" name="certificadoDigital" id="certificadoDigital" class="form-control" accept=".p12,.pfx" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Contraseña del certificado</label>
                        <input type="password" name="passwordCertificado" id="passwordCertificado" class="form-control" autocomplete="off" />
                    </div>
                    <div class="col-md-3 d-flex align-items-end">
                        <button type="button" class="btn btn-outline-info w-100" id="btnCargarFirmaDigital">Cargar datos del certificado</button>
                    </div>
                    <div class="col-12">
                        <div id="firmaDigitalStatus" class="alert alert-secondary mb-0">
                            Cargue el archivo .p12/.pfx y su contraseña para autocompletar el firmante o firmar digitalmente el PDF.
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white border-0 pb-0">
                <h4 class="mb-0">Firma por puntero</h4>
            </div>
            <div class="card-body">
                <p class="text-muted">La vista previa usa la misma plantilla HTML que se convierte a PDF. Haga clic o arrastre el bloque de firma para ajustar la posicion final antes de firmar.</p>
                <div class="row g-4 align-items-start">
                    <div class="col-lg-7">
                        <div class="aocr-sign-preview-wrap">
                            <div class="aocr-sign-preview-stage" id="firmaPreviewStage">
                                <iframe src="@Url.Action("PreviewDocumentoValidacionAocr", "CoordinacionJefatura", new { solicitudId = Model.SolicitudId, tipo = Model.TipoDocumento })" class="aocr-sign-preview-frame" title="Vista previa firma AOCR"></iframe>
                                <div class="aocr-sign-preview-overlay" id="firmaPreviewOverlay">
                                    <div class="aocr-sign-stamp" id="firmaStampProxy">
                                        <div>QR</div>
                                        <small>Firma autorizada</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-5">
                        <div class="row g-3">
                            <div class="col-12">
                                <div id="firmaPosicionStatus" class="alert alert-secondary mb-0">La posicion actual replica la ubicacion fija actual. Ajustela solo si necesita mover el bloque.</div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Ancho del bloque</label>
                                <input type="range" class="form-range" id="firmaWidthRange" min="0.18" max="0.38" step="0.005" />
                                <div class="small text-muted" id="firmaWidthValue"></div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Alto del bloque</label>
                                <input type="range" class="form-range" id="firmaHeightRange" min="0.05" max="0.14" step="0.005" />
                                <div class="small text-muted" id="firmaHeightValue"></div>
                            </div>
                            <div class="col-12 d-flex flex-column flex-md-row gap-2">
                                <button type="button" class="btn btn-outline-primary" id="btnGuardarPosicionFirma">Guardar posicion</button>
                                <button type="button" class="btn btn-outline-secondary" id="btnRestablecerPosicionFirma">Restablecer ubicacion fija</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex flex-column flex-md-row gap-2 justify-content-end mb-4">
            <button type="submit" name="accion" value="VISUALIZAR" class="btn btn-primary">Vista previa PDF</button>
            <button type="submit" name="accion" value="DESCARGAR" class="btn btn-success">Descargar PDF</button>
            <button type="submit" name="accion" value="FIRMAR_DESCARGAR" class="btn btn-dark">Firmar digitalmente y descargar</button>
        </div>
    }
</div>

<script>
    (function () {
        var style = document.createElement('style');
        style.textContent = '.aocr-sign-preview-wrap{max-width:480px}.aocr-sign-preview-stage{position:relative;width:100%;aspect-ratio:210/297;border:1px solid #cfd6de;border-radius:12px;overflow:hidden;background:#f3f5f7}.aocr-sign-preview-frame{width:100%;height:100%;border:0;background:#fff}.aocr-sign-preview-overlay{position:absolute;top:0;left:0;bottom:0;right:16px;cursor:crosshair}.aocr-sign-stamp{position:absolute;left:0;top:0;border:2px dashed #0d6efd;background:rgba(13,110,253,.12);border-radius:10px;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;color:#0d3b8c;font-size:11px;font-weight:600;user-select:none;cursor:move;box-shadow:0 8px 18px rgba(13,110,253,.18)}.aocr-sign-stamp small{font-size:10px;font-weight:500}';
        document.head.appendChild(style);

        var boton = document.getElementById('btnCargarFirmaDigital');
        if (!boton) {
            return;
        }

        var status = document.getElementById('firmaDigitalStatus');
        var form = document.getElementById('formDocumentoAocr');
        var archivo = document.getElementById('certificadoDigital');
        var password = document.getElementById('passwordCertificado');
        var firmante = document.getElementById('FirmanteNombre');
        var previewFrame = document.querySelector('.aocr-sign-preview-frame');
        var overlay = document.getElementById('firmaPreviewOverlay');
        var stage = document.getElementById('firmaPreviewStage');
        var stamp = document.getElementById('firmaStampProxy');
        var savePositionButton = document.getElementById('btnGuardarPosicionFirma');
        var resetPositionButton = document.getElementById('btnRestablecerPosicionFirma');
        var positionStatus = document.getElementById('firmaPosicionStatus');
        var widthRange = document.getElementById('firmaWidthRange');
        var heightRange = document.getElementById('firmaHeightRange');
        var widthValue = document.getElementById('firmaWidthValue');
        var heightValue = document.getElementById('firmaHeightValue');
        var useCustomField = document.getElementById('UsaPosicionFirmaPersonalizada');
        var pageField = document.getElementById('NumeroPaginaFirma');
        var xField = document.getElementById('PosicionFirmaX');
        var yField = document.getElementById('PosicionFirmaY');
        var widthField = document.getElementById('AnchoFirma');
        var heightField = document.getElementById('AltoFirma');
        var fixedState = {
            page: 2,
            x: 0.642017,
            y: 0.667458,
            width: 0.258824,
            height: 0.080760
        };
        var defaultState = {
            page: parseInt(pageField.value || fixedState.page, 10) || fixedState.page,
            x: parseFloat(xField.value || fixedState.x),
            y: parseFloat(yField.value || fixedState.y),
            width: parseFloat(widthField.value || fixedState.width),
            height: parseFloat(heightField.value || fixedState.height)
        };
        var dragState = null;

        function cloneState(state) {
            return {
                page: state.page,
                x: state.x,
                y: state.y,
                width: state.width,
                height: state.height
            };
        }

        function mostrarEstado(css, mensaje) {
            status.className = 'alert mb-0 ' + css;
            status.textContent = mensaje;
        }

        function mostrarEstadoPosicion(css, mensaje) {
            if (!positionStatus) {
                return;
            }
            positionStatus.className = 'alert mb-0 ' + css;
            positionStatus.textContent = mensaje;
        }

        function clamp(value, min, max) {
            return Math.max(min, Math.min(max, value));
        }

        function getPreviewScrollTarget() {
            if (!previewFrame || !previewFrame.contentWindow || !previewFrame.contentWindow.document) {
                return null;
            }

            var doc = previewFrame.contentWindow.document;
            return doc.scrollingElement || doc.documentElement || doc.body;
        }

        function getPreviewMetrics() {
            if (!stage) {
                return null;
            }

            var rect = stage.getBoundingClientRect();
            var target = getPreviewScrollTarget();
            var viewportWidth = Math.max(rect.width, 1);
            var viewportHeight = Math.max(rect.height, 1);

            if (!target) {
                return {
                    viewportWidth: viewportWidth,
                    viewportHeight: viewportHeight,
                    pageWidth: viewportWidth,
                    pageHeight: viewportHeight,
                    contentWidth: viewportWidth,
                    contentHeight: viewportHeight,
                    scrollLeft: 0,
                    scrollTop: 0,
                    totalPages: 1
                };
            }

            return {
                viewportWidth: viewportWidth,
                viewportHeight: viewportHeight,
                pageWidth: viewportWidth,
                pageHeight: viewportHeight,
                contentWidth: Math.max(target.scrollWidth, target.clientWidth, viewportWidth),
                contentHeight: Math.max(target.scrollHeight, target.clientHeight, viewportHeight),
                scrollLeft: Math.max(target.scrollLeft || 0, 0),
                scrollTop: Math.max(target.scrollTop || 0, 0),
                totalPages: Math.max(1, Math.ceil(Math.max(target.scrollHeight, target.clientHeight, viewportHeight) / viewportHeight))
            };
        }

        function scrollPreviewToPage(pageNumber) {
            var target = getPreviewScrollTarget();
            var metrics = getPreviewMetrics();
            if (!target || !metrics) {
                return;
            }

            var page = clamp(pageNumber || fixedState.page, 1, metrics.totalPages);
            target.scrollTop = (page - 1) * metrics.pageHeight;
        }

        function readState() {
            var metrics = getPreviewMetrics();
            var maxPage = metrics ? metrics.totalPages : fixedState.page;
            return {
                page: clamp(parseInt(pageField.value || defaultState.page, 10) || fixedState.page, 1, maxPage),
                x: clamp(parseFloat(xField.value || defaultState.x), 0, 0.95),
                y: clamp(parseFloat(yField.value || defaultState.y), 0, 0.95),
                width: clamp(parseFloat(widthField.value || defaultState.width), parseFloat(widthRange.min), parseFloat(widthRange.max)),
                height: clamp(parseFloat(heightField.value || defaultState.height), parseFloat(heightRange.min), parseFloat(heightRange.max))
            };
        }

        function writeState(state, markCustom) {
            if (markCustom === true) {
                useCustomField.value = 'true';
            } else if (markCustom === false) {
                useCustomField.value = 'false';
            }
            pageField.value = (state.page || fixedState.page).toString();
            xField.value = state.x.toFixed(6);
            yField.value = state.y.toFixed(6);
            widthField.value = state.width.toFixed(6);
            heightField.value = state.height.toFixed(6);
            widthRange.value = state.width.toFixed(6);
            heightRange.value = state.height.toFixed(6);
            widthValue.textContent = 'Ancho relativo: ' + Math.round(state.width * 100) + '%';
            heightValue.textContent = 'Alto relativo: ' + Math.round(state.height * 100) + '%';
        }

        function renderStamp() {
            if (!stage || !stamp) {
                return;
            }

            var state = readState();
            var metrics = getPreviewMetrics();
            var page = clamp(state.page || fixedState.page, 1, metrics.totalPages);
            var widthPx = metrics.pageWidth * state.width;
            var heightPx = metrics.pageHeight * state.height;
            var leftPx = clamp(metrics.pageWidth * state.x, 0, metrics.pageWidth - widthPx);
            var absoluteTop = ((page - 1) * metrics.pageHeight) + (metrics.pageHeight * state.y);
            var topPx = absoluteTop - metrics.scrollTop;
            stamp.style.width = widthPx + 'px';
            stamp.style.height = heightPx + 'px';
            stamp.style.left = leftPx + 'px';
            stamp.style.top = topPx + 'px';
        }

        function scrollPreview(deltaY) {
            var target = getPreviewScrollTarget();
            if (!target) {
                return false;
            }

            target.scrollTop += deltaY;
            renderStamp();
            return true;
        }

        function placeStampFromPointer(clientX, clientY) {
            if (!stage) {
                return;
            }

            var rect = stage.getBoundingClientRect();
            var metrics = getPreviewMetrics();
            var state = readState();
            var widthPx = metrics.pageWidth * state.width;
            var heightPx = metrics.pageHeight * state.height;
            var leftPx = clamp((clientX - rect.left) - (widthPx / 2), 0, metrics.pageWidth - widthPx);
            var absoluteCenterY = metrics.scrollTop + (clientY - rect.top);
            var page = clamp(Math.floor(absoluteCenterY / metrics.pageHeight) + 1, 1, metrics.totalPages);
            var topPx = clamp(absoluteCenterY - ((page - 1) * metrics.pageHeight) - (heightPx / 2), 0, metrics.pageHeight - heightPx);
            state.page = page;
            state.x = leftPx / metrics.pageWidth;
            state.y = topPx / metrics.pageHeight;
            writeState(state, true);
            renderStamp();
            mostrarEstadoPosicion('alert-info', 'Posicion actualizada. Puede guardar la configuracion o firmar directamente con esta ubicacion.');
        }

        function guardarPosicion(stateOverride, markCustom, successMessage) {
            var state = stateOverride ? cloneState(stateOverride) : readState();
            writeState(state, markCustom !== false);

            var data = new FormData();
            data.append('__RequestVerificationToken', form.querySelector('input[name="__RequestVerificationToken"]').value);
            data.append('SolicitudId', document.getElementById('SolicitudId').value);
            data.append('InspeccionId', document.getElementById('InspeccionId').value || '');
            data.append('TipoDocumento', document.getElementById('TipoDocumento').value);
            data.append('RolFirmante', 'AOCR_FIRMANTE');
            data.append('NumeroPaginaFirma', pageField.value || '1');
            data.append('PosicionFirmaX', state.x.toFixed(6));
            data.append('PosicionFirmaY', state.y.toFixed(6));
            data.append('AnchoFirma', state.width.toFixed(6));
            data.append('AltoFirma', state.height.toFixed(6));

            mostrarEstadoPosicion('alert-info', 'Guardando posicion de firma...');

            fetch('@Url.Action("GuardarPosicionFirmaAocr", "CoordinacionJefatura")', {
                method: 'POST',
                body: data,
                credentials: 'same-origin'
            })
            .then(function (response) {
                return response.json().then(function (json) {
                    if (!response.ok || !json.ok) {
                        throw new Error(json.mensaje || 'No se pudo guardar la posicion de firma.');
                    }
                    return json;
                });
            })
            .then(function (json) {
                defaultState = cloneState(state);
                mostrarEstadoPosicion('alert-success', successMessage || json.mensaje || 'La posicion de firma fue guardada.');
            })
            .catch(function (error) {
                mostrarEstadoPosicion('alert-danger', error.message || 'No se pudo guardar la posicion de firma.');
            });
        }

        if (overlay && stage && stamp) {
            writeState(readState(), false);
            renderStamp();

            overlay.addEventListener('wheel', function (event) {
                if (scrollPreview(event.deltaY)) {
                    event.preventDefault();
                }
            }, { passive: false });

            overlay.addEventListener('click', function (event) {
                if (dragState && dragState.moved) {
                    dragState = null;
                    return;
                }

                if (event.target === stamp || stamp.contains(event.target)) {
                    return;
                }

                placeStampFromPointer(event.clientX, event.clientY);
            });

            stamp.addEventListener('mousedown', function (event) {
                event.preventDefault();
                var stampRect = stamp.getBoundingClientRect();
                dragState = {
                    offsetX: event.clientX - stampRect.left,
                    offsetY: event.clientY - stampRect.top,
                    moved: false
                };
            });

            document.addEventListener('mousemove', function (event) {
                if (!dragState) {
                    return;
                }

                dragState.moved = true;
                var rect = stage.getBoundingClientRect();
                var metrics = getPreviewMetrics();
                var state = readState();
                var widthPx = metrics.pageWidth * state.width;
                var heightPx = metrics.pageHeight * state.height;
                var leftPx = clamp((event.clientX - rect.left) - dragState.offsetX, 0, metrics.pageWidth - widthPx);
                var absoluteTop = metrics.scrollTop + (event.clientY - rect.top) - dragState.offsetY;
                var page = clamp(Math.floor((absoluteTop + (heightPx / 2)) / metrics.pageHeight) + 1, 1, metrics.totalPages);
                var topPx = clamp(absoluteTop - ((page - 1) * metrics.pageHeight), 0, metrics.pageHeight - heightPx);
                state.page = page;
                state.x = leftPx / metrics.pageWidth;
                state.y = topPx / metrics.pageHeight;
                writeState(state, true);
                renderStamp();
            });

            document.addEventListener('mouseup', function () {
                if (dragState && dragState.moved) {
                    mostrarEstadoPosicion('alert-info', 'Posicion actualizada. Puede guardar la configuracion o firmar directamente con esta ubicacion.');
                }
                dragState = null;
            });

            window.addEventListener('resize', renderStamp);
            previewFrame.addEventListener('load', function () {
                var target = getPreviewScrollTarget();
                if (target) {
                    target.addEventListener('scroll', renderStamp);
                }
                scrollPreviewToPage(readState().page || fixedState.page);
                renderStamp();
            });
        }

        if (widthRange) {
            widthRange.addEventListener('input', function () {
                var state = readState();
                state.width = parseFloat(widthRange.value);
                writeState(state, true);
                renderStamp();
            });
        }

        if (heightRange) {
            heightRange.addEventListener('input', function () {
                var state = readState();
                state.height = parseFloat(heightRange.value);
                writeState(state, true);
                renderStamp();
            });
        }

        if (savePositionButton) {
            savePositionButton.addEventListener('click', function () {
                guardarPosicion(null, true, 'La posicion de firma fue guardada correctamente y quedara fija para este documento.');
            });
        }

        if (resetPositionButton) {
            resetPositionButton.addEventListener('click', function () {
                writeState(fixedState, false);
                scrollPreviewToPage(fixedState.page);
                renderStamp();
                guardarPosicion(fixedState, false, 'La ubicacion fija fue restablecida y guardada correctamente.');
            });
        }

        boton.addEventListener('click', function () {
            if (!archivo.files || !archivo.files.length) {
                mostrarEstado('alert-warning', 'Seleccione un certificado digital .p12 o .pfx.');
                return;
            }

            if (!password.value) {
                mostrarEstado('alert-warning', 'Ingrese la contraseña del certificado digital.');
                return;
            }

            var data = new FormData();
            data.append('__RequestVerificationToken', form.querySelector('input[name="__RequestVerificationToken"]').value);
            data.append('certificadoDigital', archivo.files[0]);
            data.append('passwordCertificado', password.value);

            mostrarEstado('alert-info', 'Leyendo certificado digital...');

            fetch('@Url.Action("CargarDatosFirmaDigitalAocr", "CoordinacionJefatura")', {
                method: 'POST',
                body: data,
                credentials: 'same-origin'
            })
            .then(function (response) {
                return response.json().then(function (json) {
                    if (!response.ok || !json.ok) {
                        throw new Error(json.mensaje || 'No se pudo leer el certificado digital.');
                    }
                    return json;
                });
            })
            .then(function (json) {
                if (firmante && (!firmante.value || firmante.value === 'USU_ADMIN')) {
                    firmante.value = json.nombreTitular || firmante.value;
                }
                mostrarEstado('alert-success', 'Certificado cargado: ' + (json.nombreTitular || 'Titular no identificado') + '. Vigente hasta ' + (json.vigenteHasta || 'N/D') + '.');
            })
            .catch(function (error) {
                mostrarEstado('alert-danger', error.message || 'No se pudo leer el certificado digital.');
            });
        });
    })();
</script>
