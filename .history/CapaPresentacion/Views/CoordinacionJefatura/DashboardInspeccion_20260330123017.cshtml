<script>
    (function ($) {
        function buildLanguageConfig() {
            return {
                search: 'Buscar:',
                lengthMenu: 'Mostrar _MENU_ registros',
                info: 'Mostrando _START_ a _END_ de _TOTAL_ registros',
                infoEmpty: 'Mostrando 0 a 0 de 0 registros',
                zeroRecords: 'No existen registros en esta etapa',
                emptyTable: 'No existen registros en esta etapa',
                infoFiltered: '(filtrado de _MAX_ registros)',
                paginate: {
                    first: 'Primero',
                    last: 'Último',
                    next: 'Siguiente',
                    previous: 'Anterior'
                }
            };
        }

        function initializeTable(table) {
            if (!$.fn.DataTable || !table.length) {
                return;
            }

            if ($.fn.DataTable.isDataTable(table)) {
                table.DataTable().destroy();
            }

            table.DataTable({
                pageLength: 10,
                order: [],
                autoWidth: false,
                language: buildLanguageConfig()
            });
        }

        function applyKanbanVisibility($column, forceExpand) {
            var previewLimit = parseInt($column.attr('data-preview-limit'), 10) || 5;
            var expanded = typeof forceExpand === 'boolean' ? forceExpand : $column.attr('data-expanded') === 'true';
            var $cards = $column.find('.dash-kanban-card').filter(function () {
                return $(this).attr('data-match') !== 'false';
            });

            $column.find('.dash-kanban-card').addClass('d-none');

            if (expanded) {
                $cards.removeClass('d-none');
            } else {
                $cards.slice(0, previewLimit).removeClass('d-none');
            }

            $column.attr('data-expanded', expanded ? 'true' : 'false');
            $column.find('.js-kanban-visible').text($cards.length > previewLimit && !expanded ? previewLimit : $cards.length);

            var $footer = $column.find('.dash-kanban-column__footer');
            if ($cards.length > previewLimit) {
                $footer.removeClass('d-none');
                $footer.find('.js-kanban-toggle').text(expanded ? 'Ver menos' : 'Ver más');
            } else {
                $footer.addClass('d-none');
            }
        }

        function filterKanbanBoard(searchText) {
            var normalized = (searchText || '').toLowerCase().trim();

            $('.dash-kanban-column').each(function () {
                var $column = $(this);
                $column.find('.dash-kanban-card').each(function () {
                    var $card = $(this);
                    var hayMatch = !normalized || ($card.attr('data-search') || '').indexOf(normalized) >= 0;
                    $card.attr('data-match', hayMatch ? 'true' : 'false');
                });

                applyKanbanVisibility($column);
            });
        }

        function openDetailModal(url, title) {
            if (!url) {
                return;
            }

            var $modal = $('#modalDetalleAocr');
            $('#modalDetalleAocrTitulo').text(title || 'Detalle del trámite');
            $('#modalDetalleAocrFrame').attr('src', url);
            $('#modalDetalleAocrLink').attr('href', url);

            if (window.bootstrap && window.bootstrap.Modal) {
                window.bootstrap.Modal.getOrCreateInstance($modal[0]).show();
                return;
            }

            if (typeof $modal.modal === 'function') {
                $modal.modal('show');
            }
        }

        $(function () {
            $('.js-dashboard-table').each(function () {
                initializeTable($(this));
            });

            $('.dash-kanban-column').each(function () {
                $(this).find('.dash-kanban-card').attr('data-match', 'true');
                applyKanbanVisibility($(this), false);
            });

            $(document).on('click', '.js-kanban-toggle', function () {
                var columnKey = $(this).attr('data-column');
                var $column = $('.dash-kanban-column[data-column="' + columnKey + '"]');
                applyKanbanVisibility($column, $column.attr('data-expanded') !== 'true');
            });

            $('#kanbanSearch').on('input', function () {
                filterKanbanBoard($(this).val());
            });

            $(document).on('click', '.js-open-detail-modal', function () {
                openDetailModal($(this).attr('data-url'), $(this).attr('data-title'));
            });

            $('#modalDetalleAocr').on('hidden.bs.modal hidden', function () {
                $('#modalDetalleAocrFrame').attr('src', 'about:blank');
            });
        });
    })(jQuery);
</script>