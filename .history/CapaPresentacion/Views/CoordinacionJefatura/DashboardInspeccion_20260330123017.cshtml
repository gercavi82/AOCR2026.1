@model CapaPresentacion.Models.DashboardInspeccionViewModel
@using System
@using System.Linq
@using System.Web
@using CapaPresentacion.Helpers
@{
    Layout = "~/Views/Shared/_LayoutAOCR.cshtml";
    ViewBag.Title = "Gestión Integral AOCR";

    var model = Model ?? new CapaPresentacion.Models.DashboardInspeccionViewModel();
    var gestionIntegral = model.GestionIntegralAocr ?? new System.Collections.Generic.List<CapaPresentacion.Models.DashboardGestionIntegralItemViewModel>();
    var firmas = model.PendientesFirma ?? new System.Collections.Generic.List<CapaPresentacion.Models.DashboardInspeccionFirmaItemViewModel>();
    var ncs = model.ObservacionesNc ?? new System.Collections.Generic.List<CapaPresentacion.Models.DashboardInspeccionNcItemViewModel>();
    var quickFilter = string.IsNullOrWhiteSpace(model.QuickFilter) ? "TODOS" : model.QuickFilter;
    var tablero = model.TableroAocr ?? new CapaPresentacion.Models.TableroAocrViewModel();
    const int kanbanPreviewLimit = 5;
    var puedeGestionarAsignacion = User.IsInRole("Administrador") || User.IsInRole("Direccion") || User.IsInRole("JefaturaTecnica");
    var puedeVerPendientesDirdac = User.IsInRole("Administrador") || User.IsInRole("Direccion") || User.IsInRole("Director") || User.IsInRole("JefaturaTecnica") || User.IsInRole("Jefe");

    var toolbarLinks = new System.Collections.Generic.List<string>();
    if (puedeVerPendientesDirdac)
    {
        toolbarLinks.Add("<a href=\"" + Url.Action("PendientesFirmaDirdac", "Inspeccion") + "\" class=\"btn btn-aocr-secondary\"><i class=\"fas fa-signature\"></i><span>Pendientes DIRDAC</span></a>");
    }

    if (User.IsInRole("Administrador") || User.IsInRole("JefaturaTecnica"))
    {
        toolbarLinks.Add("<a href=\"" + Url.Action("ValidarAocr", "CoordinacionJefatura") + "\" class=\"btn btn-aocr-primary\"><i class=\"fas fa-stamp\"></i><span>Validar AOCR</span></a>");
    }

    if (puedeGestionarAsignacion)
    {
        toolbarLinks.Add("<a href=\"" + Url.Action("Index", "Tecnico") + "\" class=\"btn btn-aocr-secondary\"><i class=\"fas fa-user-check\"></i><span>Asignar inspector</span></a>");
    }

    var pageHeaderData = new ViewDataDictionary
    {
        { "Kicker", "Coordinación y Jefatura" },
        { "Title", "Gestión Integral AOCR" },
        { "Subtitle", "Tablero operativo con vista kanban y tabla unificada de respaldo" },
        { "Breadcrumbs", new[]
            {
                new { Text = "Coordinación y Jefatura", Url = string.Empty },
                new { Text = "Gestión Integral AOCR", Url = string.Empty }
            }
        }
    };

    var heroData = new ViewDataDictionary
    {
        { "Kicker", "Control operativo AOCR" },
        { "Title", "Visión completa del trámite" },
        { "Subtitle", "Semáforo operativo por columna, acciones rápidas y detalle sin salir de la bandeja" },
        { "Description", "El tablero reorganiza la gestión en pendientes, revisión, inspección, observados, firmas y finalizados para detectar bloqueos y decidir más rápido sin romper la lógica actual." },
        { "MetricTitle", "Trámites visibles" },
        { "MetricValue", gestionIntegral.Count },
        { "MetricSubtitle", "Filtrados según los criterios activos" }
    };

    var toolbarData = new ViewDataDictionary
    {
        { "VolverUrl", Url.Action("RevisionVerificacion", "CoordinacionJefatura") },
        { "VolverTexto", "Ir a Revisión / Verificación" },
        { "CustomActionsHtml", new HtmlString(string.Join(string.Empty, toolbarLinks)) }
    };

    Func<string, string, string> quickFilterUrl = (value, label) => Url.Action("DashboardInspeccion", "CoordinacionJefatura", new
    {
        compania = model.CompaniaFiltro,
        inspector = model.InspectorFiltro,
        estado = model.EstadoFiltro,
        quickFilter = value
    });
}

@helper RenderKanbanColumn(string columnKey, string title, string subtitle, string icon, string accentClass, System.Collections.Generic.IEnumerable<CapaPresentacion.Models.DashboardGestionIntegralItemViewModel> items, int previewLimit)
{
    var itemList = (items ?? Enumerable.Empty<CapaPresentacion.Models.DashboardGestionIntegralItemViewModel>()).ToList();
    var total = itemList.Count;
    var visibleInitial = Math.Min(previewLimit, total);

    <div class="dash-kanban-column @accentClass" data-column="@columnKey" data-expanded="false" data-preview-limit="@previewLimit">
        <div class="dash-kanban-column__head">
            <div>
                <div class="dash-kanban-column__title"><i class="@icon"></i> @title</div>
                <div class="dash-kanban-column__subtitle">@subtitle</div>
            </div>
            <span class="dash-kanban-column__count">@total</span>
        </div>

        <div class="dash-kanban-column__body">
            @if (!itemList.Any())
            {
                <div class="dash-kanban-empty">
                    <i class="fas fa-inbox"></i>
                    <span>Sin registros</span>
                </div>
            }
            else
            {
                foreach (var item in itemList)
                {
                    var badgeGeneral = DashboardInspeccionBadgeHelper.GetBadgeEstado(item.EstadoGeneral, "GENERAL");
                    var badgeDocumental = DashboardInspeccionBadgeHelper.GetBadgeEstado(item.EstadoDocumental, "DOCUMENTO");
                    var badgeInspeccion = DashboardInspeccionBadgeHelper.GetBadgeEstado(item.EstadoInspeccion, "INSPECCION");
                    var mostrarAccionPrincipal = !string.IsNullOrWhiteSpace(item.UrlAccionPrincipal)
                        && !string.Equals(item.UrlAccionPrincipal, item.UrlDetalle, StringComparison.OrdinalIgnoreCase)
                        && !string.Equals(item.TextoAccionPrincipal, "Ver", StringComparison.OrdinalIgnoreCase);
                    var searchIndex = string.Join(" ", new[]
                    {
                        item.NumeroSolicitud,
                        item.Compania,
                        item.Tipo,
                        item.EstadoGeneral,
                        item.EstadoDocumental,
                        item.EstadoInspeccion,
                        item.Inspector,
                        item.EtapaActual,
                        item.ResumenKanban
                    }.Where(x => !string.IsNullOrWhiteSpace(x)));

                    <article class="dash-kanban-card dash-kanban-card--@item.ColorKanban @(item.EsUrgente ? "dash-kanban-card--urgent" : null)"
                             data-search="@searchIndex.ToLowerInvariant()"
                             title="@item.ResumenKanban">
                        <div class="dash-kanban-card__top">
                            <div>
                                <button type="button" class="dash-kanban-card__title js-open-detail-modal" data-url="@item.UrlDetalle" data-title="@item.NumeroSolicitud - @item.Compania">
                                    @item.NumeroSolicitud
                                </button>
                                <div class="dash-kanban-card__company">@item.Compania</div>
                            </div>
                            <span class="dash-chip">@item.Tipo</span>
                        </div>

                        <div class="dash-kanban-card__badges">
                            <span class="@badgeGeneral.CssClass">@badgeGeneral.Text</span>
                            <span class="@badgeDocumental.CssClass">@badgeDocumental.Text</span>
                            <span class="@badgeInspeccion.CssClass">@badgeInspeccion.Text</span>
                        </div>

                        <div class="dash-kanban-meta">
                            <span><i class="fas fa-user-check"></i> @item.Inspector</span>
                            <span><i class="fas fa-diagram-project"></i> @item.EtapaActual</span>
                            <span><i class="fas fa-calendar-days"></i> @(item.Fecha.HasValue ? item.Fecha.Value.ToString("dd/MM/yyyy") : "Sin fecha")</span>
                        </div>

                        <div class="dash-kanban-signatures">
                            <span class="dash-signature-line"><span class="dash-signature-dot @(item.FirmaInspector ? "dash-signature-dot-ok" : "dash-signature-dot-ko")"></span> Inspector</span>
                            <span class="dash-signature-line"><span class="dash-signature-dot @(item.FirmaDirdac ? "dash-signature-dot-ok" : "dash-signature-dot-ko")"></span> DIRDAC</span>
                        </div>

                        <div class="dash-kanban-summary">@item.ResumenKanban</div>

                        <div class="dash-kanban-actions">
                            <button type="button" class="btn btn-sm btn-outline-primary js-open-detail-modal" data-url="@item.UrlDetalle" data-title="@item.NumeroSolicitud - @item.Compania">
                                <i class="fas fa-eye"></i> Ver detalle
                            </button>
                            @if (mostrarAccionPrincipal)
                            {
                                <a class="btn btn-sm btn-outline-success" href="@item.UrlAccionPrincipal"><i class="fas fa-bolt"></i> @item.TextoAccionPrincipal</a>
                            }
                        </div>
                    </article>
                }
            }
        </div>

        <div class="dash-kanban-column__footer @(total > previewLimit ? null : "d-none")">
            <span class="dash-kanban-column__summary">Mostrando <strong class="js-kanban-visible">@visibleInitial</strong> de <strong>@total</strong></span>
            <button type="button" class="btn btn-sm btn-outline-secondary js-kanban-toggle" data-column="@columnKey">Ver más</button>
        </div>
    </div>
}

<style>
    .dash-shell {
        --dash-blue: #155c8a;
        --dash-blue-soft: #e6f1f8;
        --dash-orange: #c66a17;
        --dash-orange-soft: #fff1e1;
        --dash-green: #1d7b4f;
        --dash-green-soft: #e9f6ef;
        --dash-red: #b53939;
        --dash-red-soft: #fdecec;
        --dash-yellow: #b78312;
        --dash-yellow-soft: #fff7dc;
        --dash-gray: #5f6f7c;
        --dash-gray-soft: #eef2f5;
        --dash-ink: #183246;
        --dash-muted: #6d7f8b;
        --dash-border: rgba(24, 50, 70, 0.1);
    }

    .dash-filter-card,
    .dash-panel {
        background: #fff;
        border: 1px solid var(--dash-border);
        border-radius: 20px;
        box-shadow: 0 16px 32px rgba(17, 52, 73, 0.08);
    }

    .dash-filter-card {
        padding: 20px;
        margin-bottom: 22px;
    }

    .dash-filter-card .form-label {
        font-size: 0.82rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: var(--dash-muted);
    }

    .dash-quick-filters {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 14px;
    }

    .dash-quick-filter {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 14px;
        border-radius: 999px;
        border: 1px solid var(--dash-border);
        background: #fff;
        color: var(--dash-ink);
        font-weight: 700;
        text-decoration: none;
    }

    .dash-quick-filter.active {
        background: linear-gradient(135deg, #0f5e91 0%, #2f86bd 100%);
        color: #fff;
        border-color: transparent;
        box-shadow: 0 14px 26px rgba(17, 52, 73, 0.18);
    }

    .dash-panel {
        padding: 22px;
    }

    .dash-panel-head {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 16px;
        margin-bottom: 18px;
    }

    .dash-panel-title {
        margin: 0;
        font-size: 1.25rem;
        font-weight: 800;
        color: var(--dash-ink);
    }

    .dash-panel-subtitle {
        margin: 4px 0 0;
        color: var(--dash-muted);
    }

    .dash-table th {
        font-size: 0.82rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--dash-muted);
        border-top: 0;
        white-space: nowrap;
    }

    .dash-table td {
        vertical-align: middle;
    }

    .dash-table .btn {
        white-space: nowrap;
    }

    .dash-stack {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .dash-signatures {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .dash-signature-line {
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .dash-signature-dot {
        width: 10px;
        height: 10px;
        border-radius: 999px;
        display: inline-block;
    }

    .dash-signature-dot-ok { background: #1d7b4f; }
    .dash-signature-dot-ko { background: #9aa7b0; }

    .dash-chip {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 6px 10px;
        border-radius: 999px;
        border: 1px solid var(--dash-border);
        background: #f7fafc;
        color: var(--dash-ink);
        font-size: 0.8rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }

    .dash-primary {
        font-weight: 700;
        color: var(--dash-ink);
    }

    .dash-secondary {
        color: var(--dash-muted);
        font-size: 0.9rem;
    }

    .dash-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 999px;
        padding: 6px 12px;
        font-size: 0.78rem;
        font-weight: 800;
        letter-spacing: 0.03em;
        text-transform: uppercase;
    }

    .dash-badge-blue { background: var(--dash-blue-soft); color: var(--dash-blue); }
    .dash-badge-orange { background: var(--dash-orange-soft); color: var(--dash-orange); }
    .dash-badge-green { background: var(--dash-green); color: #fff; }
    .dash-badge-green-soft { background: var(--dash-green-soft); color: var(--dash-green); }
    .dash-badge-red { background: var(--dash-red-soft); color: var(--dash-red); }
    .dash-badge-yellow { background: var(--dash-yellow-soft); color: var(--dash-yellow); }
    .dash-badge-gray { background: var(--dash-gray-soft); color: var(--dash-gray); }
    .dash-badge-neutral { background: #f4f6f8; color: var(--dash-muted); }

    .aocr-metric-card.metric-secondary {
        border-color: rgba(95, 111, 124, 0.18);
        background: linear-gradient(180deg, #f7f9fb 0%, #eef2f5 100%);
    }

    .dash-search-box {
        position: relative;
    }

    .dash-search-box i {
        position: absolute;
        top: 50%;
        left: 14px;
        transform: translateY(-50%);
        color: var(--dash-muted);
    }

    .dash-search-box input {
        padding-left: 40px;
    }

    .dash-board-shell {
        display: grid;
        gap: 18px;
    }

    .dash-board-toolbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
    }

    .dash-board-caption {
        color: var(--dash-muted);
        margin: 0;
    }

    .dash-kanban-strip {
        display: grid;
        grid-auto-flow: column;
        grid-auto-columns: minmax(285px, 1fr);
        gap: 18px;
        overflow-x: auto;
        padding-bottom: 8px;
    }

    .dash-kanban-column {
        background: linear-gradient(180deg, rgba(255,255,255,0.98) 0%, rgba(246,249,251,0.98) 100%);
        border: 1px solid var(--dash-border);
        border-radius: 22px;
        box-shadow: 0 18px 34px rgba(17, 52, 73, 0.08);
        min-height: 520px;
        display: flex;
        flex-direction: column;
    }

    .dash-kanban-column__head {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 12px;
        padding: 16px 16px 12px;
        border-bottom: 1px solid rgba(24, 50, 70, 0.08);
    }

    .dash-kanban-column__title {
        font-weight: 800;
        color: var(--dash-ink);
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .dash-kanban-column__subtitle {
        margin-top: 4px;
        color: var(--dash-muted);
        font-size: 0.9rem;
    }

    .dash-kanban-column__count {
        min-width: 36px;
        height: 36px;
        padding: 0 10px;
        border-radius: 999px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        background: rgba(255,255,255,0.85);
        border: 1px solid rgba(24, 50, 70, 0.08);
        color: var(--dash-ink);
    }

    .dash-kanban-column__body {
        padding: 14px;
        display: grid;
        gap: 12px;
        align-content: start;
        flex: 1;
    }

    .dash-kanban-column__footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
        padding: 0 14px 14px;
    }

    .dash-kanban-column__summary {
        color: var(--dash-muted);
        font-size: 0.9rem;
    }

    .dash-column-gray .dash-kanban-column__head { background: linear-gradient(180deg, #f7f9fb 0%, #eef2f5 100%); border-radius: 22px 22px 0 0; }
    .dash-column-blue .dash-kanban-column__head { background: linear-gradient(180deg, #e9f4fb 0%, #dcebfa 100%); border-radius: 22px 22px 0 0; }
    .dash-column-yellow .dash-kanban-column__head { background: linear-gradient(180deg, #fff8e1 0%, #fff0c4 100%); border-radius: 22px 22px 0 0; }
    .dash-column-red .dash-kanban-column__head { background: linear-gradient(180deg, #fdecec 0%, #fbdede 100%); border-radius: 22px 22px 0 0; }
    .dash-column-green .dash-kanban-column__head { background: linear-gradient(180deg, #e9f6ef 0%, #dbf0e4 100%); border-radius: 22px 22px 0 0; }

    .dash-kanban-empty {
        min-height: 140px;
        border: 1px dashed rgba(24, 50, 70, 0.16);
        border-radius: 18px;
        display: grid;
        place-items: center;
        gap: 8px;
        color: var(--dash-muted);
        text-align: center;
        padding: 18px;
    }

    .dash-kanban-card {
        border-radius: 18px;
        border: 1px solid rgba(24, 50, 70, 0.08);
        background: #fff;
        padding: 14px;
        box-shadow: 0 12px 24px rgba(17, 52, 73, 0.06);
        display: grid;
        gap: 10px;
        transition: transform 0.18s ease, box-shadow 0.18s ease;
    }

    .dash-kanban-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 18px 28px rgba(17, 52, 73, 0.12);
    }

    .dash-kanban-card--secondary { border-top: 4px solid #7a8791; }
    .dash-kanban-card--info { border-top: 4px solid #2f86bd; }
    .dash-kanban-card--warning { border-top: 4px solid #d59b1b; }
    .dash-kanban-card--danger { border-top: 4px solid #d95c5c; }
    .dash-kanban-card--success { border-top: 4px solid #41a06e; }
    .dash-kanban-card--urgent { box-shadow: 0 0 0 2px rgba(217, 92, 92, 0.18), 0 18px 28px rgba(17, 52, 73, 0.12); }

    .dash-kanban-card__top {
        display: flex;
        justify-content: space-between;
        gap: 10px;
        align-items: flex-start;
    }

    .dash-kanban-card__title {
        border: 0;
        background: transparent;
        padding: 0;
        font-weight: 800;
        color: var(--dash-blue);
        text-align: left;
    }

    .dash-kanban-card__company {
        color: var(--dash-ink);
        font-weight: 600;
        margin-top: 2px;
        font-size: 0.95rem;
    }

    .dash-kanban-card__badges {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .dash-kanban-meta {
        display: grid;
        gap: 6px;
        color: var(--dash-muted);
        font-size: 0.9rem;
    }

    .dash-kanban-meta span,
    .dash-kanban-signatures {
        display: flex;
        gap: 8px;
        align-items: center;
        flex-wrap: wrap;
    }

    .dash-kanban-summary {
        font-size: 0.9rem;
        color: var(--dash-ink);
        background: #f8fbfd;
        border-radius: 14px;
        padding: 10px 12px;
    }

    .dash-kanban-actions {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
    }

    .dash-modal .modal-dialog {
        max-width: 1180px;
    }

    .dash-modal .modal-content {
        border-radius: 20px;
        overflow: hidden;
    }

    .dash-modal__frame {
        width: 100%;
        min-height: 70vh;
        border: 0;
        background: #fff;
    }

    .dash-section-card {
        background: #fff;
        border: 1px solid var(--dash-border);
        border-radius: 20px;
        box-shadow: 0 16px 32px rgba(17, 52, 73, 0.08);
    }

    .dash-section-title {
        margin: 0;
        font-size: 1.2rem;
        font-weight: 800;
        color: var(--dash-ink);
    }

    .dash-section-note {
        margin: 4px 0 0;
        color: var(--dash-muted);
    }

    .dash-subtable-wrap {
        background: linear-gradient(180deg, rgba(230, 241, 248, 0.45) 0%, rgba(255, 255, 255, 0.95) 100%);
        border-radius: 18px;
        padding: 12px;
    }

    .dash-tab-pane .alert-info {
        margin-bottom: 0;
        border-radius: 16px;
    }

    @@media (max-width: 991.98px) {
        .dash-panel {
            padding: 18px;
        }

        .dash-panel-head {
            flex-direction: column;
        }

        .dash-kanban-strip {
            grid-auto-columns: minmax(88vw, 1fr);
        }
    }
</style>

<div class="aocr-view dash-shell">
    @Html.Partial("_PageHeader", null, pageHeaderData)
    @Html.Partial("_HeroPanel", null, heroData)

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success" role="alert">@TempData["Success"]</div>
    }
    @if (TempData["Warning"] != null)
    {
        <div class="alert alert-warning" role="alert">@TempData["Warning"]</div>
    }
    @if (TempData["Info"] != null)
    {
        <div class="alert alert-info" role="alert">@TempData["Info"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger" role="alert">@TempData["Error"]</div>
    }

    <div class="row g-3 mb-4">
        <div class="col-12 col-md-6 col-xl">
            @Html.Partial("_MetricCard", null, new ViewDataDictionary { { "Label", "Total trámites" }, { "Value", model.TotalTramites }, { "Modifier", "info" }, { "Icon", "fas fa-table-list" }, { "Caption", "Registros en la tabla maestra" } })
        </div>
        <div class="col-12 col-md-6 col-xl">
            @Html.Partial("_MetricCard", null, new ViewDataDictionary { { "Label", "Pendientes" }, { "Value", model.TotalPendientes }, { "Modifier", "warning" }, { "Icon", "fas fa-hourglass-half" }, { "Caption", "Procesos aún no finalizados" } })
        </div>
        <div class="col-12 col-md-6 col-xl">
            @Html.Partial("_MetricCard", null, new ViewDataDictionary { { "Label", "En proceso" }, { "Value", model.TotalEnProceso }, { "Modifier", "warning" }, { "Icon", "fas fa-spinner" }, { "Caption", "En verificación o ejecución" } })
        </div>
        <div class="col-12 col-md-6 col-xl">
            @Html.Partial("_MetricCard", null, new ViewDataDictionary { { "Label", "Observadas" }, { "Value", model.TotalObservadas }, { "Modifier", "danger" }, { "Icon", "fas fa-triangle-exclamation" }, { "Caption", "Requieren atención o subsanación" } })
        </div>
        <div class="col-12 col-md-6 col-xl">
