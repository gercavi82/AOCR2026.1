@model CapaPresentacion.Models.AocrDocumentoEdicionViewModel
@using System.Collections.Generic
@using CapaPresentacion.Models

@{
    Layout = "~/Views/Shared/_LayoutAOCR.cshtml";
    ViewBag.Title = "Completar Condiciones y Limitaciones AOCR";
    var filas = Model != null ? Model.AeronavesCondiciones ?? new List<AocrCondicionAeronaveFilaViewModel>() : new List<AocrCondicionAeronaveFilaViewModel>();
}

<div class="container-fluid mt-4">
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body d-flex flex-column flex-lg-row justify-content-between gap-3 align-items-lg-center">
            <div>
                <h2 class="mb-1">Completar Condiciones y Limitaciones AOCR</h2>
                <p class="text-muted mb-0">Edite las condiciones operativas y luego genere el PDF para su revision y firma.</p>
            </div>
            <div class="d-flex gap-2 flex-wrap">
                <a class="btn btn-outline-secondary" href="@Url.Action("ValidarAocr", "CoordinacionJefatura")">Volver a la bandeja</a>
                <a class="btn btn-outline-dark" href="@Url.Action("Detalle", "SolicitudAOCR", new { id = Model.SolicitudId })">Abrir tramite</a>
            </div>
        </div>
    </div>

    @using (Html.BeginForm("GenerarDocumentoValidacionAocr", "CoordinacionJefatura", FormMethod.Post, new { target = "_blank" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.SolicitudId)
        @Html.HiddenFor(m => m.InspeccionId)
        @Html.HiddenFor(m => m.TipoDocumento)
        @Html.HiddenFor(m => m.NumeroAocr)
        @Html.HiddenFor(m => m.NombreDocumento)

        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white border-0 pb-0">
                <h4 class="mb-0">Datos operativos</h4>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label">Numero AOCR</label>
                        @Html.TextBoxFor(m => m.NumeroAocr, new { @class = "form-control", @readonly = "readonly" })
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Fecha emision documento</label>
                        @Html.TextBoxFor(m => m.FechaEmisionDocumento, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Fecha renovacion</label>
                        @Html.TextBoxFor(m => m.FechaRenovacion, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Fecha vencimiento</label>
                        @Html.TextBoxFor(m => m.FechaVencimiento, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Representante tecnico</label>
                        @Html.TextBoxFor(m => m.RepresentanteTecnico, new { @class = "form-control" })
                    </div>
                    <div class="col-md-8">
                        <label class="form-label">Condicion base de operacion</label>
                        @Html.TextAreaFor(m => m.CondicionBaseOperacion, new { @class = "form-control", rows = "2" })
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Restricciones / condiciones</label>
                        @Html.TextAreaFor(m => m.RestriccionesCondiciones, new { @class = "form-control", rows = "4" })
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Condiciones adicionales</label>
                        @Html.TextAreaFor(m => m.CondicionesAdicionales, new { @class = "form-control", rows = "4" })
                    </div>
                    <div class="col-12">
                        <label class="form-label">Observaciones de validacion final</label>
                        @Html.TextAreaFor(m => m.ObservacionesValidacionFinal, new { @class = "form-control", rows = "3", placeholder = "Conformidad interna, oficio, limitaciones finales o notas para la firma." })
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white border-0 pb-0">
                <h4 class="mb-0">Flota habilitada</h4>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-bordered align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Modelo y tipo</th>
                                <th>Matricula</th>
                                <th>Serie</th>
                                <th>UIO</th>
                                <th>GYE</th>
                                <th>MEC</th>
                                <th>LTX</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (var i = 0; i < filas.Count; i++)
                            {
                                <tr>
                                    <td>
                                        @Html.HiddenFor(m => m.AeronavesCondiciones[i].Id)
                                        @Html.TextBoxFor(m => m.AeronavesCondiciones[i].ModeloTipo, new { @class = "form-control" })
                                    </td>
                                    <td>@Html.TextBoxFor(m => m.AeronavesCondiciones[i].Matricula, new { @class = "form-control" })</td>
                                    <td>@Html.TextBoxFor(m => m.AeronavesCondiciones[i].Serie, new { @class = "form-control" })</td>
                                    <td>@Html.TextBoxFor(m => m.AeronavesCondiciones[i].Uio, new { @class = "form-control text-center" })</td>
                                    <td>@Html.TextBoxFor(m => m.AeronavesCondiciones[i].Gye, new { @class = "form-control text-center" })</td>
                                    <td>@Html.TextBoxFor(m => m.AeronavesCondiciones[i].Mec, new { @class = "form-control text-center" })</td>
                                    <td>@Html.TextBoxFor(m => m.AeronavesCondiciones[i].Ltx, new { @class = "form-control text-center" })</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white border-0 pb-0">
                <h4 class="mb-0">Firmas y responsables</h4>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label">Fecha expedicion</label>
                        @Html.TextBoxFor(m => m.FechaExpedicion, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Elaborado por</label>
                        @Html.TextBoxFor(m => m.ElaboradoPor, new { @class = "form-control" })
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Revisado por</label>
                        @Html.TextBoxFor(m => m.RevisadoPor, new { @class = "form-control" })
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Firmante final</label>
                        @Html.TextBoxFor(m => m.FirmanteNombre, new { @class = "form-control" })
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Cargo firmante</label>
                        @Html.TextBoxFor(m => m.FirmanteCargo, new { @class = "form-control" })
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex flex-column flex-md-row gap-2 justify-content-end mb-4">
            <button type="submit" name="accion" value="VISUALIZAR" class="btn btn-primary">Vista previa PDF</button>
            <button type="submit" name="accion" value="DESCARGAR" class="btn btn-success">Descargar PDF</button>
        </div>
    }
</div>
