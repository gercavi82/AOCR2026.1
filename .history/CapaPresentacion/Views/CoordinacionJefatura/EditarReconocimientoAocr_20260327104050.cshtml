@model CapaPresentacion.Models.AocrDocumentoEdicionViewModel
@using System.Collections.Generic

@{
    Layout = "~/Views/Shared/_LayoutAOCR.cshtml";
    ViewBag.Title = "Completar Reconocimiento AOCR";
}

<div class="container-fluid mt-4">
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body d-flex flex-column flex-lg-row justify-content-between gap-3 align-items-lg-center">
            <div>
                <h2 class="mb-1">Completar Reconocimiento AOCR</h2>
                <p class="text-muted mb-0">Revise y complete la informacion antes de generar el documento para firma.</p>
            </div>
            <div class="d-flex gap-2 flex-wrap">
                <a class="btn btn-outline-secondary" href="@Url.Action("ValidarAocr", "CoordinacionJefatura")">Volver a la bandeja</a>
                <a class="btn btn-outline-dark" href="@Url.Action("Detalle", "SolicitudAOCR", new { id = Model.SolicitudId })">Abrir tramite</a>
            </div>
        </div>
    </div>

    @using (Html.BeginForm("GenerarDocumentoValidacionAocr", "CoordinacionJefatura", FormMethod.Post, new { target = "_blank" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.SolicitudId)
        @Html.HiddenFor(m => m.InspeccionId)
        @Html.HiddenFor(m => m.TipoDocumento)
        @Html.HiddenFor(m => m.NumeroAocr)
        @Html.HiddenFor(m => m.NombreDocumento)

        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white border-0 pb-0">
                <h4 class="mb-0">Datos generales</h4>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label">Numero AOCR</label>
                        @Html.TextBoxFor(m => m.NumeroAocr, new { @class = "form-control", @readonly = "readonly" })
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Numero certificado original</label>
                        @Html.TextBoxFor(m => m.AocOriginalNumero, new { @class = "form-control" })
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Estado otorgante</label>
                        @Html.TextBoxFor(m => m.EstadoOtorgante, new { @class = "form-control" })
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Fecha emision documento</label>
                        @Html.TextBoxFor(m => m.FechaEmisionDocumento, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Nombre del explotador</label>
                        @Html.TextBoxFor(m => m.NombreExplotador, new { @class = "form-control" })
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Razon social</label>
                        @Html.TextBoxFor(m => m.RazonSocial, new { @class = "form-control" })
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Estado del explotador</label>
                        @Html.TextBoxFor(m => m.EstadoExplotador, new { @class = "form-control" })
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Direccion del explotador</label>
                        @Html.TextAreaFor(m => m.DireccionExplotador, new { @class = "form-control", rows = "2" })
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Telefono</label>
                        @Html.TextBoxFor(m => m.TelefonoExplotador, new { @class = "form-control" })
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Correo</label>
                        @Html.TextBoxFor(m => m.CorreoExplotador, new { @class = "form-control" })
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white border-0 pb-0">
                <h4 class="mb-0">Contacto en Ecuador y soporte operacional</h4>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">Punto de contacto en Ecuador</label>
                        @Html.TextBoxFor(m => m.PuntoContactoEcuador, new { @class = "form-control" })
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Representante tecnico</label>
                        @Html.TextBoxFor(m => m.RepresentanteTecnico, new { @class = "form-control" })
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Telefono de contacto</label>
                        @Html.TextBoxFor(m => m.ContactoTelefono, new { @class = "form-control" })
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Direccion de contacto</label>
                        @Html.TextAreaFor(m => m.ContactoDireccion, new { @class = "form-control", rows = "2" })
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Correo de contacto</label>
                        @Html.TextBoxFor(m => m.ContactoCorreo, new { @class = "form-control" })
                    </div>
                    <div class="col-12">
                        <label class="form-label">Puntos de contacto operacionales</label>
                        @Html.TextAreaFor(m => m.PuntosContactoOperacionales, new { @class = "form-control", rows = "4" })
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white border-0 pb-0">
                <h4 class="mb-0">Sustento y observaciones</h4>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Base legal / referencia</label>
                        @Html.TextAreaFor(m => m.BaseLegalReferencia, new { @class = "form-control", rows = "4" })
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Observaciones del reconocimiento</label>
                        @Html.TextAreaFor(m => m.ObservacionesReconocimiento, new { @class = "form-control", rows = "4" })
                    </div>
                    <div class="col-12">
                        <label class="form-label">Observaciones de validacion final</label>
                        @Html.TextAreaFor(m => m.ObservacionesValidacionFinal, new { @class = "form-control", rows = "3", placeholder = "Notas previas a la firma, referencias o condicionantes internas." })
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white border-0 pb-0">
                <h4 class="mb-0">Control de firmas</h4>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label">Fecha expedicion</label>
                        @Html.TextBoxFor(m => m.FechaExpedicion, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Fecha renovacion</label>
                        @Html.TextBoxFor(m => m.FechaRenovacion, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Fecha vencimiento</label>
                        @Html.TextBoxFor(m => m.FechaVencimiento, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Elaborado por</label>
                        @Html.TextBoxFor(m => m.ElaboradoPor, new { @class = "form-control" })
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Revisado por</label>
                        @Html.TextBoxFor(m => m.RevisadoPor, new { @class = "form-control" })
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Firmante final</label>
                        @Html.TextBoxFor(m => m.FirmanteNombre, new { @class = "form-control" })
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Cargo firmante</label>
                        @Html.TextBoxFor(m => m.FirmanteCargo, new { @class = "form-control" })
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex flex-column flex-md-row gap-2 justify-content-end mb-4">
            <button type="submit" name="accion" value="VISUALIZAR" class="btn btn-primary">Vista previa PDF</button>
            <button type="submit" name="accion" value="DESCARGAR" class="btn btn-success">Descargar PDF</button>
        </div>
    }
</div>
