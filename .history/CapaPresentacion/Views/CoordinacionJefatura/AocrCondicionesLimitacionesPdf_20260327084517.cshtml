@model CapaPresentacion.Models.AocrDocumentoPdfViewModel
@using System.Globalization
@using System.Linq

@{
    Layout = "~/Views/Shared/_PdfLayoutDGAC.cshtml";
    var solicitud = Model != null ? Model.Solicitud : null;
    var aeronaves = Model != null ? Model.Aeronaves ?? new System.Collections.Generic.List<CapaModelo.AeronaveSolicitud>() : new System.Collections.Generic.List<CapaModelo.AeronaveSolicitud>();
    var cultura = new CultureInfo("es-EC");
}

@section PdfHead {
    <style>
        body { font-family: Arial, Helvetica, sans-serif; font-size: 10pt; color: #111; }
        .sheet { border: 2px solid #222; padding: 18px; }
        table { width: 100%; border-collapse: collapse; }
        th, td { border: 1px solid #222; padding: 6px; vertical-align: top; }
        .title { text-align: center; font-weight: bold; font-size: 13pt; }
        .subtitle { text-align: center; font-size: 10pt; }
        .small { font-size: 8pt; color: #444; }
        ul { margin: 10px 0 0 20px; }
    </style>
}

<div class="sheet">
    <table>
        <tr>
            <td colspan="2" class="title">CONDICIONES Y LIMITACIONES</td>
        </tr>
        <tr>
            <td colspan="2" class="subtitle">CONDITIONS AND LIMITATIONS</td>
        </tr>
        <tr>
            <td style="width:50%;"><strong>AOCR #:</strong> @(Model != null ? Model.NumeroAocr : "-")</td>
            <td style="width:50%;"><strong>Fecha documento:</strong> @(Model != null ? Model.FechaEmisionDocumento.ToString("dd/MM/yyyy", cultura) : "-")</td>
        </tr>
    </table>

    <table style="margin-top:14px;">
        <tr>
            <th style="width:35%;">Representante Tecnico</th>
            <th>Operacion / Aeropuertos autorizados</th>
        </tr>
        <tr>
            <td>@(solicitud != null ? (solicitud.TecnicoResponsableNombre ?? solicitud.RepresentanteLegal ?? "-") : "-")</td>
            <td>@(solicitud != null ? ((solicitud.TipoOperacion ?? "-") + " / " + (solicitud.AeropuertosEcuador ?? "-")) : "-")</td>
        </tr>
    </table>

    <table style="margin-top:14px;">
        <thead>
            <tr>
                <th>Modelo y tipo de aeronave</th>
                <th>Matricula</th>
                <th>Configuracion</th>
                <th>Etapa ruido</th>
            </tr>
        </thead>
        <tbody>
            @if (aeronaves.Any())
            {
                foreach (var aeronave in aeronaves)
                {
                    <tr>
                        <td>@(((aeronave.Marca ?? string.Empty) + " " + (aeronave.Modelo ?? string.Empty)).Trim())</td>
                        <td>@(aeronave.Matricula ?? "-")</td>
                        <td>@(aeronave.Configuracion ?? "-")</td>
                        <td>@(aeronave.EtapaRuido ?? "-")</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="4">No existen aeronaves registradas para esta solicitud.</td>
                </tr>
            }
        </tbody>
    </table>

    <div style="margin-top:18px;">
        <strong>Condiciones institucionales:</strong>
        <ul>
            <li>El AOCR solo puede continuar a envio al RT cuando la firma del informe tecnico se encuentre completa.</li>
            <li>Las operaciones autorizadas quedan sujetas a las especificaciones operacionales y a la revision institucional vigente.</li>
            <li>Cualquier cambio material en aeronaves, rutas o contacto del operador debe registrarse previamente en el expediente AOCR.</li>
            <li>El incumplimiento de estas condiciones puede suspender la continuidad del tramite o requerir una nueva revision tecnica.</li>
        </ul>
    </div>

    <table style="margin-top:24px;">
        <tr>
            <td style="width:50%;"><strong>Fecha de emision / renovacion:</strong><br />@(Model != null ? Model.FechaEmisionDocumento.ToString("dd/MM/yyyy", cultura) : "-")</td>
            <td style="width:50%;"><strong>Nombre y firma:</strong><br />@(Model != null ? (Model.FirmanteFinal ?? "Director de Certificacion Aeronautica y Vigilancia Continua") : "Director de Certificacion Aeronautica y Vigilancia Continua")<br /><span class="small">@(Model != null ? (Model.CargoFirmante ?? "Direction General of Civil Aviation") : "Direction General of Civil Aviation")</span></td>
        </tr>
    </table>
</div>