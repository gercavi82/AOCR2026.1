@inherits System.Web.Mvc.WebViewPage<CapaPresentacion.Models.CoordinacionJefaturaRevisionViewModel>
@using System.Linq
@{
    ViewBag.Title = "Revisión / Verificación";
    ViewBag.PageSubtitle = "Dirección / Jefatura";
    Layout = "~/Views/Shared/_LayoutAOCR.cshtml";
}

<div class="container-fluid aocr-shell">
    @Html.Partial("_HeroPanel", null, new ViewDataDictionary {
        { "IconClass", "fas fa-project-diagram" },
        { "Overline", "Bandeja Ejecutiva AOCR" },
        { "Title", "Revisión y Verificación" },
        { "Subtitle", "Coordinación y Jefatura" },
        { "Description", "Controle documental, revisión AOCR y seguimiento de inspecciones en un tablero unificado." },
        { "MetricLabel", "Total en bandeja" },
        { "MetricValue", (Model.SolicitudesControlDocumental.Count + Model.SolicitudesAocrRevision.Count + Model.InspeccionesSeguimiento.Count) }
    })

    <div class="row g-3 mb-3">
        <div class="col-md-4">@Html.Partial("_MetricCard", null, new ViewDataDictionary { { "Label", "Control documental" }, { "Value", Model.SolicitudesControlDocumental.Count }, { "IconClass", "fas fa-folder-check" }, { "Tone", "metric-info" } })</div>
        <div class="col-md-4">@Html.Partial("_MetricCard", null, new ViewDataDictionary { { "Label", "AOCR en revisión" }, { "Value", Model.SolicitudesAocrRevision.Count }, { "IconClass", "fas fa-file-signature" }, { "Tone", "metric-warning" } })</div>
        <div class="col-md-4">@Html.Partial("_MetricCard", null, new ViewDataDictionary { { "Label", "Inspecciones seguimiento" }, { "Value", Model.InspeccionesSeguimiento.Count }, { "IconClass", "fas fa-magnifying-glass-chart" }, { "Tone", "metric-success" } })</div>
    </div>

    <div class="card aocr-table-card mb-3">
        <div class="card-header"><strong>Solicitudes para revisión documental</strong></div>
        <div class="card-body p-0">
            @if (!Model.SolicitudesControlDocumental.Any())
            {
                <div class="p-3">
                    @Html.Partial("_EmptyState", null, new ViewDataDictionary {
                        { "IconClass", "fas fa-folder-open" },
                        { "Title", "Sin pendientes documentales" },
                        { "Description", "No hay solicitudes pendientes de revisión documental en este momento." }
                    })
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm table-striped mb-0">
                        <thead>
                            <tr>
                                <th>Solicitud</th>
                                <th>Operador</th>
                                <th>Estado</th>
                                <th>Fecha</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var item in Model.SolicitudesControlDocumental)
                        {
                            <tr>
                                <td>@item.CodigoSolicitud</td>
                                <td>@Html.Encode(item.NombreOperador)</td>
                                <td>@Html.Partial("_StatusBadge", null, new ViewDataDictionary { { "Status", item.Estado } })</td>
                                <td>@(item.FechaSolicitud.HasValue ? item.FechaSolicitud.Value.ToString("yyyy-MM-dd") : string.Empty)</td>
                                <td>
                                    <a class="btn btn-sm btn-info" href="@Url.Action("Detalle", "SolicitudAOCR", new { id = item.CodigoSolicitud })">Detalle</a>
                                    <a class="btn btn-sm btn-outline-primary" href="@Url.Action("RevisarSolicitudes", "SolicitudAOCR")">Bandeja técnica</a>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <div class="card aocr-table-card mb-3">
        <div class="card-header"><strong>AOCR para validar, legalizar o cerrar</strong></div>
        <div class="card-body p-0">
            @if (!Model.SolicitudesAocrRevision.Any())
            {
                <div class="p-3">
                    @Html.Partial("_EmptyState", null, new ViewDataDictionary {
                        { "IconClass", "fas fa-check-double" },
                        { "Title", "Sin AOCR en cola" },
                        { "Description", "Actualmente no existen AOCR para validación o legalización." }
                    })
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm table-striped mb-0">
                        <thead>
                            <tr>
                                <th>Solicitud</th>
                                <th>Operador</th>
                                <th>Estado</th>
                                <th>Fecha</th>
                                <th>Ruta</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var item in Model.SolicitudesAocrRevision)
                        {
                            <tr>
                                <td>@item.CodigoSolicitud</td>
                                <td>@Html.Encode(item.NombreOperador)</td>
                                <td>@Html.Partial("_StatusBadge", null, new ViewDataDictionary { { "Status", item.Estado } })</td>
                                <td>@(item.FechaSolicitud.HasValue ? item.FechaSolicitud.Value.ToString("yyyy-MM-dd") : string.Empty)</td>
                                <td>
                                    <a class="btn btn-sm btn-info" href="@Url.Action("Detalle", "SolicitudAOCR", new { id = item.CodigoSolicitud })">Detalle</a>
                                    @if (User.IsInRole("JefaturaTecnica") || User.IsInRole("Administrador"))
                                    {
                                        <a class="btn btn-sm btn-warning" href="@Url.Action("ValidarAocr", "CoordinacionJefatura")">Validar AOCR</a>
                                    }
                                    @if (User.IsInRole("CoordinacionLegal") || User.IsInRole("CoordinadorLegal") || User.IsInRole("DirectorGeneral") || User.IsInRole("Administrador"))
                                    {
                                        <a class="btn btn-sm btn-success" href="@Url.Action("LegalizarAocr", "CoordinacionJefatura")">Legalizar AOCR</a>
                                    }
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <div class="card aocr-table-card">
        <div class="card-header"><strong>Inspecciones en seguimiento de coordinación / jefatura</strong></div>
        <div class="card-body p-0">
            @if (!Model.InspeccionesSeguimiento.Any())
            {
                <div class="p-3">
                    @Html.Partial("_EmptyState", null, new ViewDataDictionary {
                        { "IconClass", "fas fa-clipboard-list" },
                        { "Title", "Sin inspecciones en seguimiento" },
                        { "Description", "No hay inspecciones en seguimiento para coordinación o jefatura." }
                    })
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm table-striped mb-0">
                        <thead>
                            <tr>
                                <th>Inspección</th>
                                <th>Solicitud</th>
                                <th>Estado</th>
                                <th>Resultado</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var item in Model.InspeccionesSeguimiento)
                        {
                            <tr>
                                <td>@item.CodigoInspeccion</td>
                                <td>@item.CodigoSolicitud</td>
                                <td>@Html.Partial("_StatusBadge", null, new ViewDataDictionary { { "Status", item.Estado } })</td>
                                <td>@Html.Encode(item.Resultado)</td>
                                <td>
                                    <a class="btn btn-sm btn-info" href="@Url.Action("Detalle", "Inspeccion", new { id = item.CodigoInspeccion })">Detalle</a>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>