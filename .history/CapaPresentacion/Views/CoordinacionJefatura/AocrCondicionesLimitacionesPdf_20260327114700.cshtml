@model CapaPresentacion.Models.AocrDocumentoPdfViewModel
@using System.Globalization
@using System.Linq

@{
    Layout = "~/Views/Shared/_PdfLayoutDGAC.cshtml";
    var solicitud = Model != null ? Model.Solicitud : null;
    var informe = Model != null ? Model.Informe : null;
    var certificado = Model != null ? Model.Certificado : null;
    var aeronaves = Model != null ? Model.AeronavesCondiciones ?? new System.Collections.Generic.List<CapaPresentacion.Models.AocrCondicionAeronaveFilaViewModel>() : new System.Collections.Generic.List<CapaPresentacion.Models.AocrCondicionAeronaveFilaViewModel>();
    var cultura = new CultureInfo("es-EC");

    Func<string, string> textoCampo = value => !string.IsNullOrWhiteSpace(value) ? value : "PENDIENTE DE COMPLETAR";
    Func<string, string> claseCampo = value => !string.IsNullOrWhiteSpace(value) ? "field-value" : "field-value pending";
    Func<DateTime?, string> fechaCampo = value => value.HasValue ? value.Value.ToString("dd/MM/yyyy", cultura) : "PENDIENTE DE COMPLETAR";

    var representanteTecnico = Model != null ? Model.RepresentanteTecnico : null;
    var operacionAeropuertos = Model != null ? Model.CondicionBaseOperacion : null;
    var restricciones = Model != null ? Model.RestriccionesCondiciones : null;
    var firmadoPor = Model != null ? Model.FirmanteFinal : null;
    var cargoFirmante = Model != null ? Model.CargoFirmante : null;
}

@section PdfHead {
    <style>
        body { font-family: Arial, Helvetica, sans-serif; font-size: 10pt; color: #111; }
        .sheet { border: 2px solid #222; padding: 18px; }
        table { width: 100%; border-collapse: collapse; }
        th, td { border: 1px solid #222; padding: 6px; vertical-align: top; }
        .title { text-align: center; font-weight: bold; font-size: 13pt; }
        .subtitle { text-align: center; font-size: 10pt; }
        .small { font-size: 8pt; color: #444; }
        .section-title { font-weight: bold; font-size: 10.5pt; background: #e9eef5; padding: 7px 8px; border: 1px solid #222; margin-top: 14px; }
        .field-label { display: block; font-weight: bold; font-size: 8.5pt; margin-bottom: 4px; text-transform: uppercase; }
        .field-value { display: block; min-height: 20px; padding: 4px 6px; border: 1px dashed #666; background: #fbfbfb; }
        .field-value.pending { color: #7a4d00; font-style: italic; background: #fff8e8; }
        ul { margin: 10px 0 0 20px; }
        .signature-line { height: 34px; border-bottom: 1px solid #222; margin-bottom: 6px; }
        .signature-role { font-weight: bold; text-transform: uppercase; font-size: 8.5pt; }
        .signature-slot { height: 108px; border: 1px dashed #666; background: #fff; margin-top: 6px; }
    </style>
}

<div class="sheet">
    <table>
        <tr>
            <td colspan="2" class="title">CONDICIONES Y LIMITACIONES</td>
        </tr>
        <tr>
            <td colspan="2" class="subtitle">CONDITIONS AND LIMITATIONS</td>
        </tr>
        <tr>
            <td style="width:50%;"><strong>AOCR #:</strong> @(Model != null ? Model.NumeroAocr : "-")</td>
            <td style="width:50%;"><strong>Fecha documento:</strong> @(Model != null ? Model.FechaEmisionDocumento.ToString("dd/MM/yyyy", cultura) : "-")</td>
        </tr>
    </table>

    <div class="section-title">I. Datos operativos a validar</div>

    <table style="margin-top:14px;">
        <tr>
            <th style="width:35%;">Representante Tecnico</th>
            <th>Operacion / Aeropuertos autorizados</th>
        </tr>
        <tr>
            <td><span class="@claseCampo(representanteTecnico)">@textoCampo(representanteTecnico)</span></td>
            <td><span class="@claseCampo(operacionAeropuertos)">@textoCampo(operacionAeropuertos)</span></td>
        </tr>
        <tr>
            <td>
                <span class="field-label">Vigencia / renovacion</span>
                <span class="field-value @(Model != null && Model.FechaVencimiento.HasValue ? string.Empty : "pending")">@fechaCampo(Model != null ? Model.FechaVencimiento : null)</span>
            </td>
            <td>
                <span class="field-label">Condicion base de operacion</span>
                <span class="@claseCampo(operacionAeropuertos)">@textoCampo(operacionAeropuertos)</span>
            </td>
        </tr>
    </table>

    <div class="section-title">II. Flota y datos tecnicos</div>

    <table style="margin-top:14px;">
        <thead>
            <tr>
                <th>Modelo y tipo de aeronave</th>
                <th>Matricula</th>
                <th>Serie</th>
                <th>UIO</th>
                <th>GYE</th>
                <th>MEC</th>
                <th>LTX</th>
            </tr>
        </thead>
        <tbody>
            @if (aeronaves.Any())
            {
                foreach (var aeronave in aeronaves)
                {
                    <tr>
                        <td>@(aeronave.ModeloTipo ?? "-")</td>
                        <td>@(aeronave.Matricula ?? "-")</td>
                        <td>@(aeronave.Serie ?? "-")</td>
                        <td>@(aeronave.Uio ?? "-")</td>
                        <td>@(aeronave.Gye ?? "-")</td>
                        <td>@(aeronave.Mec ?? "-")</td>
                        <td>@(aeronave.Ltx ?? "-")</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="7">No existen aeronaves registradas para esta solicitud.</td>
                </tr>
            }
        </tbody>
    </table>

    <div class="section-title">III. Condiciones y restricciones</div>

    <div style="margin-top:18px;">
        <strong>Condiciones institucionales:</strong>
        <ul>
            <li>El AOCR solo puede continuar a envio al RT cuando la firma del informe tecnico se encuentre completa.</li>
            <li>Las operaciones autorizadas quedan sujetas a las especificaciones operacionales y a la revision institucional vigente.</li>
            <li>Cualquier cambio material en aeronaves, rutas o contacto del operador debe registrarse previamente en el expediente AOCR.</li>
            <li>El incumplimiento de estas condiciones puede suspender la continuidad del tramite o requerir una nueva revision tecnica.</li>
        </ul>
    </div>

    <table style="margin-top:14px;">
        <tr>
            <td>
                <span class="field-label">Restricciones / observaciones especificas</span>
                <span class="@claseCampo(restricciones)">@textoCampo(restricciones)</span>
            </td>
        </tr>
        <tr>
            <td>
                <span class="field-label">Condiciones adicionales para completar</span>
                <span class="@(string.IsNullOrWhiteSpace(Model != null ? Model.CondicionesAdicionales : null) ? "field-value pending" : "field-value")">@textoCampo(Model != null ? Model.CondicionesAdicionales : null)</span>
            </td>
        </tr>
    </table>

    <div class="section-title">IV. Firmas y conformidad</div>

    <table style="margin-top:24px;">
        <tr>
            <td style="width:33%;">
                <div class="signature-line"></div>
                <div class="signature-role">Preparado por</div>
                <div class="@claseCampo(Model != null ? Model.ElaboradoPor : null)">@textoCampo(Model != null ? Model.ElaboradoPor : null)</div>
                <div class="small">Coordinacion / Jefatura Tecnica</div>
            </td>
            <td style="width:33%;">
                <div class="signature-line"></div>
                <div class="signature-role">Revisado por</div>
                <div class="@claseCampo(Model != null ? Model.RevisadoPor : null)">@textoCampo(Model != null ? Model.RevisadoPor : null)</div>
                <div class="small">Fecha revision: @fechaCampo(Model != null ? Model.FechaRenovacion : null)</div>
            </td>
            <td style="width:34%;">
                <div class="signature-role">Firma autorizada</div>
                <div class="small">Espacio reservado para firma digital con QR y datos del firmante autorizado.</div>
                <div class="signature-slot"></div>
            </td>
        </tr>
        <tr>
            <td colspan="2"><span class="field-label">Constancia de revision</span><span class="@(string.IsNullOrWhiteSpace(Model != null ? Model.ObservacionesValidacionFinal : null) ? "field-value pending" : "field-value")">@textoCampo(Model != null ? Model.ObservacionesValidacionFinal : null)</span></td>
            <td><span class="field-label">Validacion de firma</span><span class="field-value pending">La firma digital autorizada se inserta en el recuadro superior al momento de firmar el documento.</span></td>
        </tr>
    </table>
</div>