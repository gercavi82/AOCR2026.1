@inherits System.Web.Mvc.WebViewPage<List<CapaModelo.Documento>>
@using CapaModelo
@using System.Web.Mvc
@using System.Web.Mvc.Html
@using System.Collections.Generic
@using System.Linq

@{
    ViewBag.Title = "Documentos de la Solicitud AOCR";
    ViewBag.PageSubtitle = "Gestion Documental";
    Layout = "~/Views/Shared/_LayoutAOCR.cshtml";

    var stats = (ViewBag.Stats as IDictionary<string, object>)
                ?? (ViewBag.Estadisticas as IDictionary<string, object>)
                ?? new Dictionary<string, object>();

    Func<string, int> statInt = key =>
    {
        object value;
        if (!stats.TryGetValue(key, out value) || value == null)
        {
            return 0;
        }

        int parsed;
        return int.TryParse(value.ToString(), out parsed) ? parsed : 0;
    };

    var totalDocs = statInt("Total");
    var pendientesDocs = statInt("Pendientes");
    var aprobadosDocs = statInt("Aprobados");
    var rechazadosDocs = statInt("Rechazados");
    var tamanioTotal = statInt("TamanioTotal");
    var solicitudId = ViewBag.SolicitudId != null ? ViewBag.SolicitudId.ToString() : string.Empty;
}

<div class="container-fluid aocr-page aocr-shell">
    @Html.Partial("_HeroPanel", null, new ViewDataDictionary {
        { "IconClass", "fas fa-folder-open" },
        { "Overline", "Solicitud AOCR" },
        { "Title", "Documentos de la Solicitud" },
        { "Subtitle", string.IsNullOrWhiteSpace(solicitudId) ? "Gestion documental" : "Solicitud #" + solicitudId },
        { "Description", "Revise, descargue y gestione la documentacion del tramite AOCR." },
        { "MetricLabel", "Total docs" },
        { "MetricValue", totalDocs }
    })

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }
    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success">@TempData["Exito"]</div>
    }

    <div class="row mb-3">
        <div class="col-md-3 mb-2">
            @Html.Partial("_MetricCard", null, new ViewDataDictionary { { "Label", "Pendientes" }, { "Value", pendientesDocs }, { "IconClass", "fas fa-clock" }, { "Tone", "metric-warning" } })
        </div>
        <div class="col-md-3 mb-2">
            @Html.Partial("_MetricCard", null, new ViewDataDictionary { { "Label", "Aprobados" }, { "Value", aprobadosDocs }, { "IconClass", "fas fa-check" }, { "Tone", "metric-success" } })
        </div>
        <div class="col-md-3 mb-2">
            @Html.Partial("_MetricCard", null, new ViewDataDictionary { { "Label", "Rechazados" }, { "Value", rechazadosDocs }, { "IconClass", "fas fa-times" }, { "Tone", "metric-danger" } })
        </div>
        <div class="col-md-3 mb-2">
            @Html.Partial("_MetricCard", null, new ViewDataDictionary { { "Label", "Tamano (bytes)" }, { "Value", tamanioTotal }, { "IconClass", "fas fa-database" }, { "Tone", "metric-info" } })
        </div>
    </div>

    <div class="aocr-toolbar aocr-action-toolbar">
        <div class="aocr-toolbar-left">
            <label for="filtroTipo" class="aocr-field-label mb-0">Filtrar por tipo:</label>
            <select id="filtroTipo" class="form-select form-select-sm" style="max-width:260px;">
                <option value="">Todos</option>
                <option value="BORRADOR_AOCR">Borrador AOCR</option>
                <option value="Otro">Otros</option>
            </select>
        </div>
        <div class="aocr-toolbar-right">
            <a href="@Url.Action("Detalle", "SolicitudAOCR", new { id = ViewBag.SolicitudId })" class="btn btn-outline-secondary btn-sm">
                <i class="fas fa-arrow-left mr-1"></i> Volver
            </a>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="card aocr-table-card">
            <div class="card-body p-0">
                <div class="table-responsive aocr-table-wrap">
                    <table class="table aocr-table table-hover mb-0" id="tablaDocumentos">
                        <thead>
                            <tr>
                                <th>Tipo</th>
                                <th>Archivo</th>
                                <th>Fecha</th>
                                <th>Estado</th>
                                <th style="width:180px;">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var doc in Model)
                            {
                                <tr data-tipo="@doc.TipoDocumento">
                                    <td>@doc.TipoDocumento</td>
                                    <td>@doc.NombreArchivo</td>
                                    <td>@doc.FechaCarga?.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td>@Html.Partial("_StatusBadge", null, new ViewDataDictionary { { "Status", doc.Estado } })</td>
                                    <td>
                                        <a href="@Url.Action("Descargar", "Documento", new { id = doc.CodigoDocumento })" class="btn btn-sm btn-primary">
                                            <i class="fas fa-download"></i> Descargar
                                        </a>

                                        @if (doc.TipoDocumento == "BORRADOR_AOCR" && User.IsInRole("Inspector"))
                                        {
                                            <a href="@Url.Action("Editar", "Documento", new { id = doc.CodigoDocumento })" class="btn btn-sm btn-outline-warning">
                                                <i class="fas fa-edit"></i> Editar
                                            </a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        @Html.Partial("_EmptyState", null, new ViewDataDictionary {
            { "IconClass", "fas fa-folder-open" },
            { "Title", "No hay documentos disponibles" },
            { "Description", "Cuando la solicitud tenga archivos cargados, se visualizaran aqui." },
            { "ActionUrl", Url.Action("Subir", "Documento", new { solicitudId = ViewBag.SolicitudId }) },
            { "ActionText", "Subir documento" }
        })
    }
</div>

@section Scripts {
    <script>
        document.getElementById("filtroTipo").addEventListener("change", function () {
            var tipoSeleccionado = this.value;
            var filas = document.querySelectorAll("#tablaDocumentos tbody tr");

            filas.forEach(function (fila) {
                var tipo = fila.getAttribute("data-tipo");
                if (!tipoSeleccionado || tipo === tipoSeleccionado || (tipoSeleccionado === "Otro" && tipo !== "BORRADOR_AOCR")) {
                    fila.style.display = "";
                } else {
                    fila.style.display = "none";
                }
            });
        });
    </script>
}


