@inherits System.Web.Mvc.WebViewPage<List<CapaModelo.Documento>>
@using CapaModelo
@using System.Web.Mvc
@using System.Web.Mvc.Html
@using System.Collections.Generic
@using System.Linq

@{
    ViewBag.Title = "Documentos de la Solicitud AOCR";
    ViewBag.PageSubtitle = "Gestion Documental";
    Layout = "~/Views/Shared/_LayoutAOCR.cshtml";

    var stats = (ViewBag.Stats as IDictionary<string, object>)
                ?? (ViewBag.Estadisticas as IDictionary<string, object>)
                ?? new Dictionary<string, object>();

    Func<string, int> statInt = key =>
    {
        object value;
        if (!stats.TryGetValue(key, out value) || value == null)
        {
            return 0;
        }

        int parsed;
        return int.TryParse(value.ToString(), out parsed) ? parsed : 0;
    };

    var totalDocs = statInt("Total");
    var pendientesDocs = statInt("Pendientes");
    var aprobadosDocs = statInt("Aprobados");
    var rechazadosDocs = statInt("Rechazados");
    var tamanioTotal = statInt("TamanioTotal");
    var solicitudId = ViewBag.SolicitudId != null ? ViewBag.SolicitudId.ToString() : string.Empty;

    var heroData = new ViewDataDictionary();
    heroData["IconClass"] = "fas fa-folder-open";
    heroData["Overline"] = "Solicitud AOCR";
    heroData["Title"] = "Documentos de la Solicitud";
    heroData["Subtitle"] = string.IsNullOrWhiteSpace(solicitudId) ? "Gestion documental" : "Solicitud #" + solicitudId;
    heroData["Description"] = "Revise, descargue y gestione la documentacion del tramite AOCR.";
    heroData["MetricLabel"] = "Total docs";
    heroData["MetricValue"] = totalDocs;

    var estadoVacioData = new ViewDataDictionary();
    estadoVacioData["IconClass"] = "fas fa-folder-open";
    estadoVacioData["Title"] = "No hay documentos disponibles";
    estadoVacioData["Description"] = "Cuando la solicitud tenga archivos cargados, se visualizaran aqui.";
    estadoVacioData["ActionUrl"] = Url.Action("Subir", "Documento", new { solicitudId = ViewBag.SolicitudId });
    estadoVacioData["ActionText"] = "Subir documento";

    var metricPendientes = new ViewDataDictionary();
    metricPendientes["Label"] = "Pendientes";
    metricPendientes["Value"] = pendientesDocs;
    metricPendientes["IconClass"] = "fas fa-clock";
    metricPendientes["Tone"] = "metric-warning";

    var metricAprobados = new ViewDataDictionary();
    metricAprobados["Label"] = "Aprobados";
    metricAprobados["Value"] = aprobadosDocs;
    metricAprobados["IconClass"] = "fas fa-check";
    metricAprobados["Tone"] = "metric-success";

    var metricRechazados = new ViewDataDictionary();
    metricRechazados["Label"] = "Rechazados";
    metricRechazados["Value"] = rechazadosDocs;
    metricRechazados["IconClass"] = "fas fa-times";
    metricRechazados["Tone"] = "metric-danger";

    var metricTamano = new ViewDataDictionary();
    metricTamano["Label"] = "Tamano bytes";
    metricTamano["Value"] = tamanioTotal;
    metricTamano["IconClass"] = "fas fa-database";
    metricTamano["Tone"] = "metric-info";

    var backUrl = Url.Action("Detalle", "SolicitudAOCR", new { id = ViewBag.SolicitudId });
}

<div class="container-fluid aocr-page aocr-shell">
    @Html.Partial("_HeroPanel", null, heroData)

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }
    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success">@TempData["Exito"]</div>
    }

    <div class="row mb-3">
        <div class="col-md-3 mb-2">
            @Html.Partial("_MetricCard", null, metricPendientes)
        </div>
        <div class="col-md-3 mb-2">
            @Html.Partial("_MetricCard", null, metricAprobados)
        </div>
        <div class="col-md-3 mb-2">
            @Html.Partial("_MetricCard", null, metricRechazados)
        </div>
        <div class="col-md-3 mb-2">
            @Html.Partial("_MetricCard", null, metricTamano)
        </div>
    </div>

    <div class="aocr-toolbar aocr-action-toolbar">
        <div class="aocr-toolbar-left">
            <label for="filtroTipo" class="aocr-field-label mb-0">Filtrar por tipo:</label>
            <select id="filtroTipo" class="form-select form-select-sm" style="max-width:260px;">
                <option value="">Todos</option>
                <option value="BORRADOR_AOCR">Borrador AOCR</option>
                <option value="Otro">Otros</option>
            </select>
        </div>
        <div class="aocr-toolbar-right">
            @Html.ActionLink("Volver", "Detalle", "SolicitudAOCR", new { id = ViewBag.SolicitudId }, new { @class = "btn btn-outline-secondary btn-sm" })
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="card aocr-table-card">
            <div class="card-body p-0">
                <div class="table-responsive aocr-table-wrap">
                    <table class="table aocr-table table-hover mb-0" id="tablaDocumentos">
                        <thead>
                            <tr>
                                <th>Tipo</th>
                                <th>Archivo</th>
                                <th>Fecha</th>
                                <th>Estado</th>
                                <th style="width:180px;">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var doc in Model)
                            {
                                <tr data-tipo="@doc.TipoDocumento">
                                    <td>@doc.TipoDocumento</td>
                                    <td>@doc.NombreArchivo</td>
                                    <td>@doc.FechaCarga?.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td>@Html.Partial("_StatusBadge", null, new ViewDataDictionary { { "Status", doc.Estado } })</td>
                                    <td>
                                        @Html.ActionLink("Descargar", "Descargar", "Documento", new { id = doc.CodigoDocumento }, new { @class = "btn btn-sm btn-primary" })

                                        @if (doc.TipoDocumento == "BORRADOR_AOCR" && User.IsInRole("Inspector"))
                                        {
                                            @Html.ActionLink("Editar", "Editar", "Documento", new { id = doc.CodigoDocumento }, new { @class = "btn btn-sm btn-outline-warning" })
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        @Html.Partial("_EmptyState", null, estadoVacioData)
    }
</div>

@section Scripts {
    <script>
        document.getElementById("filtroTipo").addEventListener("change", function () {
            var tipoSeleccionado = this.value;
            var filas = document.querySelectorAll("#tablaDocumentos tbody tr");

            filas.forEach(function (fila) {
                var tipo = fila.getAttribute("data-tipo");
                if (!tipoSeleccionado || tipo === tipoSeleccionado || (tipoSeleccionado === "Otro" && tipo !== "BORRADOR_AOCR")) {
                    fila.style.display = "";
                } else {
                    fila.style.display = "none";
                }
            });
        });
    </script>
}


