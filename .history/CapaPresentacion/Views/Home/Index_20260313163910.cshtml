@inherits System.Web.Mvc.WebViewPage<CapaPresentacion.Models.DashboardViewModel>
@using CapaModelo
@using System.Web.Mvc
@using System.Web.Mvc.Html

@{
    ViewBag.Title = "Inicio";
    ViewBag.PageSubtitle = "Panel General AOCR";
    Layout = "~/Views/Shared/_LayoutAOCR.cshtml";
}

@section Styles {
    <link rel="stylesheet"
          href="@Url.Content("~/Content/css/dashboard.css")" />
}

<div class="container-fluid aocr-shell">

    @Html.Partial("_HeroPanel", null, new ViewDataDictionary {
        { "IconClass", "fas fa-gauge-high" },
        { "Overline", "Sistema Institucional DGAC" },
        { "Title", "Plataforma AOCR" },
        { "Subtitle", "Bienvenido, " + (Model.NombreUsuario ?? "Usuario") },
        { "Description", "Monitoree solicitudes, validaciones y notificaciones desde un panel unificado." },
        { "MetricLabel", "Notificaciones" },
        { "MetricValue", Model.NotificacionesNuevas }
    })

    @Html.Partial("_ActionToolbar", null, new ViewDataDictionary {
        { "LeftTitle", "Acciones rápidas" },
        { "LeftDescription", "Acceda a los flujos principales del sistema de manera directa." },
        { "PrimaryActionUrl", Url.Action("Index", "SolicitudAOCR", new { abrir = "nueva" }) },
        { "PrimaryActionText", "Nueva Solicitud AOCR" },
        { "PrimaryActionIcon", "fas fa-plus-circle" }
    })

    <div class="row mb-3">
        <div class="col-md-3 mb-3">
            @Html.Partial("_MetricCard", null, new ViewDataDictionary {
                { "Label", "Pendientes" },
                { "Value", Model.SolicitudesPendientes },
                { "IconClass", "fas fa-clock" },
                { "Tone", "metric-warning" }
            })
        </div>
        <div class="col-md-3 mb-3">
            @Html.Partial("_MetricCard", null, new ViewDataDictionary {
                { "Label", "En proceso" },
                { "Value", Model.TramitesEnCurso },
                { "IconClass", "fas fa-spinner" },
                { "Tone", "metric-info" }
            })
        </div>
        <div class="col-md-3 mb-3">
            @Html.Partial("_MetricCard", null, new ViewDataDictionary {
                { "Label", "Notificaciones" },
                { "Value", Model.NotificacionesNuevas },
                { "IconClass", "fas fa-bell" },
                { "Tone", "metric-success" }
            })
        </div>
        <div class="col-md-3 mb-3">
            @Html.Partial("_MetricCard", null, new ViewDataDictionary {
                { "Label", "Fecha" },
                { "Value", DateTime.Now.ToString("dd/MM/yyyy") },
                { "IconClass", "fas fa-calendar-day" },
                { "Tone", "" }
            })
        </div>
    </div>

    <div class="card aocr-content-card">
        <div class="card-body">
            <h5 class="aocr-section-title"><i class="fas fa-bolt me-2"></i>Acciones rápidas por rol</h5>
            <div class="row">
                @if (Model.MostrarModuloOperador)
                {
                    <div class="col-md-3 mb-2">
                        <button class="btn btn-primary w-100" onclick="cargarFormulario(0)">
                            <i class="fas fa-plus-circle me-2"></i>Crear Solicitud
                        </button>
                    </div>
                }

                <div class="col-md-3 mb-2">
                    <a class="btn btn-outline-secondary w-100" href="@Url.Action("MisSolicitudes","SolicitudAOCR")">
                        <i class="fas fa-file-alt me-2"></i>Mis Solicitudes
                    </a>
                </div>

                <div class="col-md-3 mb-2">
                    <span class="form-control bg-light text-center" style="min-height:40px;">
                        Perfil actual: <strong>@Model.RolUsuario</strong>
                    </span>
                </div>
            </div>
        </div>
    </div>
</div>


