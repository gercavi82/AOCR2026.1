@using CapaModelo
@using System.Web.Mvc
@using System.Web.Mvc.Html
@using System.Collections.Generic
@{
    ViewBag.Title = "Dashboard Órdenes de Recaudación";
    Layout = "~/Views/Shared/_LayoutAOCR.cshtml";
}

<!-- ✅ FILTROS EMPRESARIALES -->
<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h1 class="h3 mb-0 text-primary">
                        <i class="fas fa-tachometer-alt me-2"></i>Dashboard Órdenes de Recaudación
                    </h1>
                    <p class="text-muted mb-0">Gestión integral y KPIs empresariales</p>
                </div>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-outline-primary btn-sm" id="btnFiltros">
                        <i class="fas fa-filter"></i> Filtros
                    </button>
                    <button type="button" class="btn btn-outline-success btn-sm" id="btnExportar">
                        <i class="fas fa-download"></i> Exportar
                    </button>
                    <button type="button" class="btn btn-primary btn-sm" id="btnActualizar">
                        <i class="fas fa-sync-alt"></i> Actualizar
                    </button>
                </div>
            </div>

            <!-- Panel de filtros colapsable -->
            <div class="card collapse" id="filtrosPanelCollapse">
                <div class="card-body">
                    <form id="filtrosForm" class="row g-3">
                        <div class="col-md-3">
                            <label class="form-label">Estado</label>
                            <select name="estadoFiltro" id="filtroEstado" class="form-select">
                                <option value="">Todos los estados</option>
                                <option value="BORRADOR">Borrador</option>
                                <option value="PENDIENTE">Pendiente</option>
                                <option value="PROCESADA">Procesada</option>
                                <option value="FACTURADA">Facturada</option>
                                <option value="COMPLETADA">Completada</option>
                                <option value="ANULADA">Anulada</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Desde</label>
                            <input type="date" class="form-control" id="filtroFechaDesde" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Hasta</label>
                            <input type="date" class="form-control" id="filtroFechaHasta" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Número Orden</label>
                            <input type="text" class="form-control" id="filtroNumeroOrden" placeholder="OR-..." />
                        </div>
                        <div class="col-12">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-search"></i> Aplicar Filtros
                            </button>
                            <button type="button" class="btn btn-outline-secondary" id="btnLimpiarFiltros">
                                <i class="fas fa-times"></i> Limpiar
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- ✅ KPIs EMPRESARIALES MEJORADOS -->
    <div class="row" id="kpisContainer">
        <div class="col-xl-2 col-md-4 col-sm-6 mb-4">
            <div class="card border-start border-primary border-4 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-xs fw-bold text-primary text-uppercase mb-1">Total Órdenes</div>
                            <div class="h5 mb-0 fw-bold text-gray-800" id="kpiTotalOrdenes">0</div>
                            <div class="text-xs text-muted" id="kpiTotalOrdenesVar"></div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-clipboard-list fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-2 col-md-4 col-sm-6 mb-4">
            <div class="card border-start border-warning border-4 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-xs fw-bold text-warning text-uppercase mb-1">Pendientes</div>
                            <div class="h5 mb-0 fw-bold text-gray-800" id="kpiOrdenesPendientes">0</div>
                            <div class="text-xs text-muted" id="kpiPendientesDetalle"></div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-clock fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-2 col-md-4 col-sm-6 mb-4">
            <div class="card border-start border-success border-4 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-xs fw-bold text-success text-uppercase mb-1">Completadas</div>
                            <div class="h5 mb-0 fw-bold text-gray-800" id="kpiOrdenesCompletadas">0</div>
                            <div class="text-xs text-success" id="kpiTasaAprobacion">0% aprobación</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-check-circle fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-2 col-md-4 col-sm-6 mb-4">
            <div class="card border-start border-info border-4 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-xs fw-bold text-info text-uppercase mb-1">Monto Total</div>
                            <div class="h5 mb-0 fw-bold text-gray-800" id="kpiMontoTotal">$0.00</div>
                            <div class="text-xs text-muted" id="kpiMontoPromedio"></div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-dollar-sign fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-2 col-md-4 col-sm-6 mb-4">
            <div class="card border-start border-success border-4 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-xs fw-bold text-success text-uppercase mb-1">Recaudado</div>
                            <div class="h5 mb-0 fw-bold text-gray-800" id="kpiMontoPagado">$0.00</div>
                            <div class="text-xs text-success" id="kpiPorcentajePagado">0%</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-money-bill-wave fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-2 col-md-4 col-sm-6 mb-4">
            <div class="card border-start border-danger border-4 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-xs fw-bold text-danger text-uppercase mb-1">Saldo Pend.</div>
                            <div class="h5 mb-0 fw-bold text-gray-800" id="kpiSaldoPendiente">$0.00</div>
                            <div class="text-xs text-muted" id="kpiPromedioTiempoPago">0 días promedio</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-exclamation-triangle fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ✅ TABLA EMPRESARIAL CON ACCIONES RÁPIDAS -->
    <div class="row">
        <div class="col-12">
            <div class="card shadow">
                <div class="card-header py-3 d-flex justify-content-between align-items-center">
                    <h6 class="m-0 fw-bold text-primary">
                        <i class="fas fa-list-alt me-2"></i>Órdenes Recientes
                        <span class="badge bg-secondary ms-2" id="contadorFiltradas">0</span>
                    </h6>
                    <div class="d-flex gap-2">
                        <div id="loadingOrdenes" class="text-muted d-none">
                            <div class="spinner-border spinner-border-sm me-1" role="status"></div> Cargando...
                        </div>
                        <div class="btn-group btn-group-sm" role="group">
                            <button type="button" class="btn btn-outline-primary" id="btnVistaTabla">
                                <i class="fas fa-table"></i>
                            </button>
                            <button type="button" class="btn btn-outline-primary" id="btnVistaCards">
                                <i class="fas fa-th"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle" id="tablaOrdenes">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 120px;">Número</th>
                                    <th style="width: 100px;">Fecha</th>
                                    <th style="width: 80px;">Estado</th>
                                    <th>Contribuyente</th>
                                    <th style="width: 100px;" class="text-end">Total</th>
                                    <th style="width: 80px;" class="text-center">Días</th>
                                    <th style="width: 160px;" class="text-center">Acciones</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>

                    <!-- ✅ MENSAJE CUANDO NO HAY DATOS -->
                    <div id="sinDatosMsg" class="text-center py-5 d-none">
                        <i class="fas fa-inbox fa-3x text-muted mb-3"></i>
                        <h5 class="text-muted">No se encontraron órdenes</h5>
                        <p class="text-muted">Intenta cambiar los filtros o <a href="/OrdenRecaudacion/Nueva">crear una nueva orden</a></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
(function() {
    'use strict';

    // =============================
    // VARIABLES GLOBALES
    // =============================
    let filtrosActuales = {};
    let datosActuales = null;

    // =============================
    // INICIALIZACIÓN
    // =============================
    $(document).ready(function() {
        inicializarEventos();
        cargarDatosIniciales();

        // Actualizar cada 2 minutos
        setInterval(() => {
            if (!$('#loadingOrdenes').is(':visible')) {
                cargarDatosDashboard();
            }
        }, 120000);
    });

    // =============================
    // EVENTOS
    // =============================
    function inicializarEventos() {
        // Mostrar/ocultar filtros
        $('#btnFiltros').click(function() {
            $('#filtrosPanelCollapse').collapse('toggle');
        });

        // Aplicar filtros
        $('#filtrosForm').on('submit', function(e) {
            e.preventDefault();
            aplicarFiltros();
        });

        // Limpiar filtros
        $('#btnLimpiarFiltros').click(function() {
            limpiarFiltros();
        });

        // Actualizar manualmente
        $('#btnActualizar').click(function() {
            cargarDatosDashboard();
        });

        // Exportar datos
        $('#btnExportar').click(function() {
            exportarDatos();
        });

        // Cambio de vista
        $('#btnVistaTabla, #btnVistaCards').click(function() {
            cambiarVista(this.id === 'btnVistaTabla' ? 'tabla' : 'cards');
        });
    }

    // =============================
    // CARGA DE DATOS PRINCIPAL
    // =============================
    function cargarDatosIniciales() {
        // Establecer fecha por defecto (último mes)
        const fechaHasta = new Date();
        const fechaDesde = new Date();
        fechaDesde.setMonth(fechaHasta.getMonth() - 1);

        $('#filtroFechaDesde').val(fechaDesde.toISOString().split('T')[0]);
        $('#filtroFechaHasta').val(fechaHasta.toISOString().split('T')[0]);

        cargarDatosDashboard();
    }

    function cargarDatosDashboard() {
        mostrarLoading(true);

        const params = {
            estado: filtrosActuales.estado || '',
            fechaDesde: filtrosActuales.fechaDesde || '',
            fechaHasta: filtrosActuales.fechaHasta || '',
            numeroOrden: filtrosActuales.numeroOrden || ''
        };

        $.ajax({
            url: '@Url.Action("ObtenerDatos", "OrdenRecaudacionDashboard")',
            type: 'GET',
            data: params,
            dataType: 'json',
            cache: false,
            success: function(response) {
                if (response.success) {
                    datosActuales = response;
                    actualizarKPIs(response.kpis);
                    actualizarTablaOrdenes(response.ordenesRecientes);
                    actualizarContadorFiltros(response.filtrosAplicados);
                } else {
                    mostrarError('Error cargando datos: ' + response.message);
                }
            },
            error: function(xhr) {
                console.error('Error AJAX:', xhr);
                mostrarError('Error de conexión. Intenta nuevamente.');
            },
            complete: function() {
                mostrarLoading(false);
            }
        });
    }

    // =============================
    // ACTUALIZACIÓN DE UI
    // =============================
    function actualizarKPIs(kpis) {
        $('#kpiTotalOrdenes').text(formatearNumero(kpis.totalOrdenes));
        $('#kpiOrdenesPendientes').text(formatearNumero(kpis.ordenesPendientes));
        $('#kpiOrdenesCompletadas').text(formatearNumero(kpis.ordenesCompletadas));
        $('#kpiMontoTotal').text(formatearMoneda(kpis.montoTotal));
        $('#kpiMontoPagado').text(formatearMoneda(kpis.montoPagado));
        $('#kpiSaldoPendiente').text(formatearMoneda(kpis.saldoPendiente));

        // KPIs calculados
        const porcentajePagado = kpis.montoTotal > 0 ?
            Math.round((kpis.montoPagado / kpis.montoTotal) * 100) : 0;
        $('#kpiPorcentajePagado').text(porcentajePagado + '%');

        const montoPromedio = kpis.totalOrdenes > 0 ?
            kpis.montoTotal / kpis.totalOrdenes : 0;
        $('#kpiMontoPromedio').text('Promedio: ' + formatearMoneda(montoPromedio));

        $('#kpiTasaAprobacion').text(Math.round(kpis.tasaAprobacion) + '% aprobación');
        $('#kpiPromedioTiempoPago').text(Math.round(kpis.promedioTiempoPago) + ' días promedio');

        // Detalle pendientes
        const detallePendientes = kpis.ordenesPendientes + " de " + kpis.totalOrdenes;
        $('#kpiPendientesDetalle').text(detallePendientes);
    }

    function actualizarTablaOrdenes(ordenes) {
        const tbody = $('#tablaOrdenes tbody');
        tbody.empty();

        if (!ordenes || ordenes.length === 0) {
            $('#sinDatosMsg').removeClass('d-none');
            $('#tablaOrdenes').addClass('d-none');
            return;
        }

        $('#sinDatosMsg').addClass('d-none');
        $('#tablaOrdenes').removeClass('d-none');

        ordenes.forEach(function(orden) {
            const fila = crearFilaOrden(orden);
            tbody.append(fila);
        });

        // Inicializar tooltips para acciones
        $('[data-bs-toggle="tooltip"]').tooltip();
    }

    function crearFilaOrden(orden) {
        const fechaFormateada = formatearFecha(orden.fechaCreacion);
        const estadoBadge = crearBadgeEstado(orden.estado, orden.estadoColor);
        const diasVencimiento = crearIndicadorDias(orden.diasVencimiento, orden.estado);
        const acciones = crearAccionesRapidas(orden);

        return '<tr>' +
            '<td><a href="/OrdenRecaudacion/Detalles/' + orden.id + '" class="text-decoration-none fw-bold">' +
                orden.numeroOrden +
            '</a></td>' +
            '<td>' + fechaFormateada + '</td>' +
            '<td>' + estadoBadge + '</td>' +
            '<td>' +
                '<div class="text-truncate" style="max-width: 200px;" title="' + orden.nombreContribuyente + '">' +
                    orden.nombreContribuyente +
                '</div>' +
            '</td>' +
            '<td class="text-end fw-bold">' + formatearMoneda(orden.total) + '</td>' +
            '<td class="text-center">' + diasVencimiento + '</td>' +
            '<td class="text-center">' + acciones + '</td>' +
        '</tr>';
    }

    function crearBadgeEstado(estado, color) {
        return '<span class="badge bg-' + color + '">' + estado + '</span>';
    }

    function crearIndicadorDias(dias, estado) {
        if (dias <= 0) return '<span class="text-muted">-</span>';

        const color = dias > 30 ? 'danger' : (dias > 15 ? 'warning' : 'info');
        return '<span class="badge bg-' + color + '">' + dias + 'd</span>';
    }

    function crearAccionesRapidas(orden) {
        let acciones = [];

        // Ver detalles (siempre)
        acciones.push(
            '<a href="/OrdenRecaudacion/Detalles/' + orden.id + '"' +
               ' class="btn btn-sm btn-outline-info"' +
               ' data-bs-toggle="tooltip"' +
               ' title="Ver Detalles">' +
                '<i class="fas fa-eye"></i>' +
            '</a>'
        );

        // Generar (solo si está en borrador y tiene monto)
        if (orden.estado === 'BORRADOR' && orden.total > 0) {
            acciones.push(
                '<button type="button"' +
                        ' class="btn btn-sm btn-outline-success"' +
                        ' onclick="accionRapida(\'GENERAR\', ' + orden.id + ')"' +
                        ' data-bs-toggle="tooltip"' +
                        ' title="Generar Orden">' +
                    '<i class="fas fa-play"></i>' +
                '</button>'
            );
        }

        // Anular (si no está facturada ni completada)
        if (orden.estado !== 'FACTURADA' && orden.estado !== 'COMPLETADA' && orden.estado !== 'ANULADA') {
            acciones.push(
                '<button type="button"' +
                        ' class="btn btn-sm btn-outline-danger"' +
                        ' onclick="confirmarAnulacion(' + orden.id + ')"' +
                        ' data-bs-toggle="tooltip"' +
                        ' title="Anular Orden">' +
                    '<i class="fas fa-times"></i>' +
                '</button>'
            );
        }

        // PDF (siempre)
        acciones.push(
            '<a href="/OrdenRecaudacion/DescargarPdf/' + orden.id + '"' +
               ' class="btn btn-sm btn-outline-primary"' +
               ' data-bs-toggle="tooltip"' +
               ' title="Descargar PDF">' +
                '<i class="fas fa-file-pdf"></i>' +
            '</a>'
        );

        return acciones.join(' ');
    }

    // =============================
    // ACCIONES RÁPIDAS
    // =============================
    window.accionRapida = function(accion, ordenId) {
        if (!confirm('¿Estás seguro de ' + accion.toLowerCase() + ' esta orden?')) {
            return;
        }

        $.ajax({
            url: '@Url.Action("AccionRapida", "OrdenRecaudacionDashboard")',
            type: 'POST',
            data: {
                accion: accion,
                ordenId: ordenId,
                __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
            },
            success: function(response) {
                if (response.success) {
                    mostrarExito(response.message);
                    cargarDatosDashboard(); // Recargar datos
                } else {
                    mostrarError(response.message);
                }
            },
            error: function() {
                mostrarError('Error de conexión');
            }
        });
    };

    window.confirmarAnulacion = function(ordenId) {
        const motivo = prompt('¿Motivo de anulación?');
        if (motivo && motivo.trim()) {
            accionRapida('ANULAR', ordenId);
        }
    };

    // =============================
    // FILTROS
    // =============================
    function aplicarFiltros() {
        filtrosActuales = {
            estado: $('#filtroEstado').val(),
            fechaDesde: $('#filtroFechaDesde').val(),
            fechaHasta: $('#filtroFechaHasta').val(),
            numeroOrden: $('#filtroNumeroOrden').val().trim()
        };

        cargarDatosDashboard();
    }

    function limpiarFiltros() {
        $('#filtrosForm')[0].reset();
        filtrosActuales = {};
        cargarDatosIniciales();
    }

    function actualizarContadorFiltros(filtros) {
        $('#contadorFiltradas').text(filtros.totalFiltradas);
    }

    // =============================
    // UTILIDADES
    // =============================
    function mostrarLoading(mostrar) {
        $('#loadingOrdenes').toggleClass('d-none', !mostrar);
    }

    function formatearMoneda(monto) {
        return new Intl.NumberFormat('es-EC', {
            style: 'currency',
            currency: 'USD'
        }).format(monto);
    }

    function formatearNumero(numero) {
        return new Intl.NumberFormat('es-EC').format(numero);
    }

    function formatearFecha(fecha) {
        return new Date(fecha).toLocaleDateString('es-EC', {
            day: '2-digit',
            month: '2-digit',
            year: 'numeric'
        });
    }

    function mostrarExito(mensaje) {
        // Implementar con tu sistema de notificaciones preferido
        if (typeof toastr !== 'undefined') {
            toastr.success(mensaje);
        } else {
            alert(mensaje);
        }
    }

    function mostrarError(mensaje) {
        // Implementar con tu sistema de notificaciones preferido
        if (typeof toastr !== 'undefined') {
            toastr.error(mensaje);
        } else {
            alert('Error: ' + mensaje);
        }
    }

    function exportarDatos() {
        if (!datosActuales) {
            mostrarError('No hay datos para exportar');
            return;
        }

        // Crear CSV de las órdenes
        let csv = 'Número,Fecha,Estado,Contribuyente,Total,Días\n';
        datosActuales.ordenesRecientes.forEach(function(orden) {
            const fila = [
                orden.numeroOrden,
                formatearFecha(orden.fechaCreacion),
                orden.estado,
                '"' + orden.nombreContribuyente + '"',
                orden.total,
                orden.diasVencimiento
            ].join(',');
            csv += fila + '\n';
        });

        // Descargar archivo
        const blob = new Blob([csv], { type: 'text/csv' });
        const url = window.URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = 'ordenes-dashboard-' + new Date().toISOString().split('T')[0] + '.csv';
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        window.URL.revokeObjectURL(url);
    }

    function cambiarVista(tipo) {
        // TODO: Implementar vista de cards como alternativa
        $('#btnVistaTabla, #btnVistaCards').removeClass('btn-primary').addClass('btn-outline-primary');
        if (tipo === 'tabla') {
            $('#btnVistaTabla').removeClass('btn-outline-primary').addClass('btn-primary');
        } else {
            $('#btnVistaCards').removeClass('btn-outline-primary').addClass('btn-primary');
        }
    }

})();
    </script>
}

@using (Html.BeginForm()) 
{ 
    @Html.AntiForgeryToken() 
}
