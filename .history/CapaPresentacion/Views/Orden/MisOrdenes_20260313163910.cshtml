@inherits System.Web.Mvc.WebViewPage<List<CapaPresentacion.Models.ViewModels.OrdenRecaudacionViewModel>>
@using CapaModelo
@using System.Web.Mvc
@using System.Web.Mvc.Html
@using System.Net
@using System.Linq

@{
    Layout = "~/Views/Shared/_LayoutAOCR.cshtml";
    ViewBag.Title = "Mis Ordenes";
    ViewBag.PageSubtitle = "Area Financiera";

    var total = Model != null ? Model.Count : 0;
    var requeridas = Model != null ? Model.Count(x => WebUtility.HtmlDecode(x.Estado) == "Orden de Recaudación Requerida") : 0;
}

<div class="container-fluid aocr-page aocr-shell">
    @Html.Partial("_HeroPanel", null, new ViewDataDictionary {
        { "IconClass", "fas fa-file-invoice-dollar" },
        { "Overline", "Ordenes de Recaudacion" },
        { "Title", "Mis Ordenes" },
        { "Subtitle", "Bandeja personal" },
        { "Description", "Consulte el estado y detalle de sus ordenes de recaudacion." },
        { "MetricLabel", "Total" },
        { "MetricValue", total }
    })

    <div class="row mb-3">
        <div class="col-md-6 mb-2">
            @Html.Partial("_MetricCard", null, new ViewDataDictionary { { "Label", "Total ordenes" }, { "Value", total }, { "IconClass", "fas fa-list" }, { "Tone", "metric-info" } })
        </div>
        <div class="col-md-6 mb-2">
            @Html.Partial("_MetricCard", null, new ViewDataDictionary { { "Label", "Requeridas" }, { "Value", requeridas }, { "IconClass", "fas fa-exclamation-circle" }, { "Tone", "metric-warning" } })
        </div>
    </div>

    @Html.Partial("_ActionToolbar", null, new ViewDataDictionary {
        { "LeftTitle", ViewBag.Mensaje != null ? ViewBag.Mensaje.ToString() : "Historial de ordenes" },
        { "LeftDescription", "Revise montos y acceda al detalle de cada orden." }
    })

    <div class="card aocr-table-card">
        <div class="card-body p-0">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive aocr-table-wrap">
                    <table class="table aocr-table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Numero</th>
                                <th>Fecha</th>
                                <th>Estado</th>
                                <th>Subtotal</th>
                                <th>Administracion</th>
                                <th>Total</th>
                                <th style="width:120px;">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var orden in Model)
                            {
                                var estado = WebUtility.HtmlDecode(orden.Estado);
                                <tr>
                                    <td>@orden.NumeroOrden</td>
                                    <td>@orden.FechaCreacion.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        @if (estado == "Orden de Recaudación Requerida")
                                        {
                                            @Html.Partial("_StatusBadge", null, new ViewDataDictionary { { "Status", "Pendiente" } })
                                        }
                                        else
                                        {
                                            @Html.Partial("_StatusBadge", null, new ViewDataDictionary { { "Status", estado } })
                                        }
                                    </td>
                                    <td>@orden.Subtotal.ToString("N2") USD</td>
                                    <td>@orden.Admin.ToString("N2") USD</td>
                                    <td>@orden.Total.ToString("N2") USD</td>
                                    <td>
                                        <a href="@Url.Action("Detalle", "Orden", new { id = orden.Id })" class="btn btn-sm btn-primary">Ver Detalle</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="p-3">
                    @Html.Partial("_EmptyState", null, new ViewDataDictionary {
                        { "IconClass", "fas fa-receipt" },
                        { "Title", "No tiene ordenes registradas" },
                        { "Description", "Cuando genere ordenes de recaudacion, se listaran en esta bandeja." }
                    })
                </div>
            }
        </div>
    </div>
</div>

