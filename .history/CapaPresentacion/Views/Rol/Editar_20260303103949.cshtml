@inherits System.Web.Mvc.WebViewPage<Rol>
@using CapaModelo
@using System.Web.Mvc
@using System.Web.Mvc.Html
@{
    ViewBag.Title = "Editar Rol";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-warning text-dark">
                    <h4 class="mb-0"><i class="fas fa-edit"></i> Editar Rol</h4>
                </div>
                <div class="card-body">
                    @using (Html.BeginForm("Editar", "Rol", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        @Html.HiddenFor(m => m.CodigoRol)
                        @Html.HiddenFor(m => m.IdRol)

                        <div class="mb-3">
                            <label class="form-label" for="Nombre">Nombre del Rol *</label>
                            @Html.TextBoxFor(m => m.Nombre, new { @class = "form-control", required = "required" })
                            @Html.ValidationMessageFor(m => m.Nombre, "", new { @class = "text-danger" })
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="Descripcion">Descripción</label>
                            @Html.TextAreaFor(m => m.Descripcion, new { @class = "form-control", rows = 4 })
                            @Html.ValidationMessageFor(m => m.Descripcion, "", new { @class = "text-danger" })
                        </div>

                        <div class="mb-3">
                            <div class="form-check">
                                @Html.CheckBoxFor(m => m.Activo, new { @class = "form-check-input" })
                                <label class="form-check-label" for="Activo">Rol Activo</label>
                            </div>
                        </div>

                        <div class="alert alert-warning">
                            <i class="fas fa-exclamation-triangle"></i>
                            Los cambios afectarán a todos los usuarios que tengan este rol asignado.
                        </div>

                        <hr />

                        <div class="d-flex justify-content-between">
                            <a href="@Url.Action("Index", "Rol")" class="btn btn-secondary">
                                <i class="fas fa-arrow-left"></i> Cancelar
                            </a>
                            <button type="submit" class="btn btn-warning">
                                <i class="fas fa-save"></i> Actualizar Rol
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

