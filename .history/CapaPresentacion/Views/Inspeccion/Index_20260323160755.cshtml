@model List<CapaModelo.Inspeccion>
@using CapaModelo
@using System.Web.Mvc.Html
@using System.Web.Mvc
@using System
@using System.Linq
@using System.Collections.Generic

@{
    ViewBag.Title = "Gestionar Inspecciones";
    Layout = "~/Views/Shared/_LayoutAOCR.cshtml";

    var inspecciones = Model ?? new List<CapaModelo.Inspeccion>();

    Func<string, string> normEstado = estado =>
    {
        if (string.IsNullOrWhiteSpace(estado)) return string.Empty;
        return estado.Trim().ToUpperInvariant().Replace(" ", "_");
    };

    Func<CapaModelo.Inspeccion, int> prioridad = item =>
    {
        var e = normEstado(item != null ? item.Estado : null);
        if (e == "RESULTADO_NO_SATISFACTORIO") return 0;
        if (e == "OBSERVADA" || e == "OBSERVACION_DOCUMENTAL" || e == "RECHAZADA") return 1;
        if (e == "ACEPTADA" || e == "RESULTADO_SATISFACTORIO" || e == "APROBADA") return 2;
        return 3;
    };

    var inspeccionesOrdenadas = inspecciones
        .OrderBy(i => prioridad(i))
        .ThenByDescending(i => i != null && i.UpdatedAt.HasValue ? i.UpdatedAt.Value : DateTime.MinValue)
        .ThenByDescending(i => i != null ? i.CodigoInspeccion : 0)
        .ToList();

    var total = inspeccionesOrdenadas.Count;
    var totalAceptadas = inspeccionesOrdenadas.Count(i =>
    {
        var e = normEstado(i.Estado);
        return e == "ACEPTADA" || e == "RESULTADO_SATISFACTORIO" || e == "APROBADA";
    });
    var totalObservadas = inspeccionesOrdenadas.Count(i =>
    {
        var e = normEstado(i.Estado);
        return e == "OBSERVADA" || e == "OBSERVACION_DOCUMENTAL" || e == "RECHAZADA";
    });
    var totalNoSatisfactorio = inspeccionesOrdenadas.Count(i => normEstado(i.Estado) == "RESULTADO_NO_SATISFACTORIO");
    var totalPendientes = Math.Max(0, total - totalAceptadas - totalObservadas - totalNoSatisfactorio);
}

@section Styles {
    <style>
        .insp-kpi-grid {
            display: grid;
            grid-template-columns: repeat(5, minmax(0, 1fr));
            gap: .9rem;
            margin-bottom: 1rem;
        }

        .insp-kpi-card {
            border: 1px solid rgba(13, 38, 59, .10);
            border-radius: 14px;
            background: #fff;
            padding: .9rem 1rem;
            box-shadow: 0 6px 20px rgba(13, 38, 59, .06);
        }

        .insp-kpi-card .kpi-label {
            display: block;
            font-size: .78rem;
            color: #516270;
            text-transform: uppercase;
            font-weight: 700;
            letter-spacing: .03em;
            margin-bottom: .15rem;
        }

        .insp-kpi-card .kpi-value {
            font-size: 1.45rem;
            font-weight: 800;
            color: #0f3044;
            line-height: 1.1;
        }

        .insp-kpi-card.kpi-ok { border-left: 4px solid #198754; }
        .insp-kpi-card.kpi-obs { border-left: 4px solid #f0ad4e; }
        .insp-kpi-card.kpi-no { border-left: 4px solid #dc3545; }
        .insp-kpi-card.kpi-pend { border-left: 4px solid #0d6efd; }

        .insp-toolbar {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: space-between;
            gap: .75rem;
            margin-bottom: .8rem;
            padding: .85rem;
            border: 1px solid rgba(13, 38, 59, .08);
            border-radius: 12px;
            background: #f8fbfd;
        }

        .insp-filter-group {
            display: flex;
            flex-wrap: wrap;
            gap: .45rem;
        }

        .insp-chip {
            border: 1px solid #c8d4df;
            background: #fff;
            color: #1d3a4d;
            border-radius: 999px;
            padding: .35rem .75rem;
            font-size: .8rem;
            font-weight: 700;
            cursor: pointer;
        }

        .insp-chip.active,
        .insp-chip:focus {
            border-color: #0d6efd;
            background: #e8f0ff;
            color: #0d3d87;
            outline: none;
        }

        .insp-chip.chip-ok.active {
            border-color: #198754;
            background: #eaf7ef;
            color: #166739;
        }

        .insp-chip.chip-obs.active {
            border-color: #f0ad4e;
            background: #fff7e9;
            color: #9a6509;
        }

        .insp-chip.chip-no.active {
            border-color: #dc3545;
            background: #feecee;
            color: #b02331;
        }

        .insp-search {
            min-width: 240px;
        }

        .insp-search .form-control {
            border-radius: 10px;
            font-size: .9rem;
        }

        .insp-state {
            display: inline-flex;
            align-items: center;
            gap: .35rem;
            border-radius: 999px;
            padding: .3rem .7rem;
            font-size: .78rem;
            font-weight: 800;
            letter-spacing: .02em;
            white-space: nowrap;
        }

        .insp-state .fa { font-size: .72rem; }

        .insp-state-ok {
            background: #eaf7ef;
            color: #166739;
            border: 1px solid #bee4cc;
        }

        .insp-state-obs {
            background: #fff7e9;
            color: #9a6509;
            border: 1px solid #f7d59f;
        }

        .insp-state-no {
            background: #feecee;
            color: #b02331;
            border: 1px solid #f4bcc2;
            font-size: .82rem;
            box-shadow: inset 0 0 0 1px rgba(176, 35, 49, .08);
        }

        .insp-state-other {
            background: #eef2f6;
            color: #42596a;
            border: 1px solid #d4dee6;
        }

        .insp-row-no { background: #fff7f8; }
        .insp-row-obs { background: #fffdf7; }

        .insp-obs {
            max-width: 320px;
            color: #294457;
        }

        .insp-obs-empty {
            color: #8a9aa8;
            font-style: italic;
        }

        .insp-priority-flag {
            display: inline-flex;
            align-items: center;
            gap: .3rem;
            margin-left: .45rem;
            font-size: .7rem;
            font-weight: 800;
            color: #b02331;
            background: #feecee;
            border: 1px solid #f4bcc2;
            border-radius: 999px;
            padding: .12rem .45rem;
        }

        @@media (max-width: 1200px) {
            .insp-kpi-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
        }

        @@media (max-width: 768px) {
            .insp-kpi-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
            .insp-search { width: 100%; min-width: 0; }
            .insp-toolbar { align-items: stretch; }
        }
    </style>
}


<div class="aocr-module-header mb-3">
    <div class="aocr-module-header-left">
        <h2 class="aocr-module-header-title">Gestionar Inspecciones</h2>
        <p class="aocr-module-header-subtitle">Seguimiento y control de inspecciones técnicas AOCR</p>
    </div>
    <nav>
        <ol class="aocr-breadcrumb breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")"><i class="fas fa-home"></i></a></li>
            <li class="breadcrumb-item active">Inspecciones</li>
        </ol>
    </nav>
</div>

<div class="insp-kpi-grid" aria-label="Resumen rapido de inspecciones">
    <div class="insp-kpi-card">
        <span class="kpi-label">Total revisados</span>
        <span class="kpi-value">@total</span>
    </div>
    <div class="insp-kpi-card kpi-ok">
        <span class="kpi-label">Aceptadas</span>
        <span class="kpi-value">@totalAceptadas</span>
    </div>
    <div class="insp-kpi-card kpi-obs">
        <span class="kpi-label">Observadas</span>
        <span class="kpi-value">@totalObservadas</span>
    </div>
    <div class="insp-kpi-card kpi-no">
        <span class="kpi-label">Resultado no satisfactorio</span>
        <span class="kpi-value">@totalNoSatisfactorio</span>
    </div>
    <div class="insp-kpi-card kpi-pend">
        <span class="kpi-label">Pendientes</span>
        <span class="kpi-value">@totalPendientes</span>
    </div>
</div>

<div class="card aocr-table-card">
    <div class="card-body p-0">
        @if (inspeccionesOrdenadas.Any())
        {
            <div class="insp-toolbar mx-3 mt-3">
                <div class="insp-filter-group" role="group" aria-label="Filtros rapidos por estado">
                    <button type="button" class="insp-chip active" data-filter="ALL">Todas</button>
                    <button type="button" class="insp-chip chip-ok" data-filter="ACEPTADA">ACEPTADA</button>
                    <button type="button" class="insp-chip chip-obs" data-filter="OBSERVADA">OBSERVADA</button>
                    <button type="button" class="insp-chip chip-no" data-filter="RESULTADO_NO_SATISFACTORIO">RESULTADO_NO_SATISFACTORIO</button>
                    <button type="button" class="insp-chip" data-filter="PENDIENTE">Pendientes</button>
                </div>
                <div class="insp-search">
                    <input id="inspQuickSearch" type="text" class="form-control" placeholder="Buscar por codigo, solicitud, inspector o observacion" />
                </div>
            </div>

            <div class="aocr-table-wrap">
                <table id="tblInspeccionesInspector" class="table table-dgac mb-0">
                <thead>
                    <tr>
                        <th>Código</th>
                        <th>Solicitud</th>
                        <th>Inspector</th>
                        <th>Fecha Programada</th>
                        <th>Estado</th>
                        <th>Observacion / alerta</th>
                        <th>Resultado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var inspeccion in inspeccionesOrdenadas)
                    {
                        var estadoNorm = normEstado(inspeccion.Estado);
                        var esAceptada = estadoNorm == "ACEPTADA" || estadoNorm == "RESULTADO_SATISFACTORIO" || estadoNorm == "APROBADA";
                        var esObservada = estadoNorm == "OBSERVADA" || estadoNorm == "OBSERVACION_DOCUMENTAL" || estadoNorm == "RECHAZADA";
                        var esNoSatisfactorio = estadoNorm == "RESULTADO_NO_SATISFACTORIO";
                        var esPendiente = !(esAceptada || esObservada || esNoSatisfactorio);
                        var rowClass = esNoSatisfactorio ? "insp-row-no" : (esObservada ? "insp-row-obs" : string.Empty);
                        var observacion = !string.IsNullOrWhiteSpace(inspeccion.Comentarios)
                            ? inspeccion.Comentarios
                            : inspeccion.ObservacionesGenerales;

                        var estadoCss = esNoSatisfactorio ? "insp-state insp-state-no" :
                                       (esObservada ? "insp-state insp-state-obs" :
                                       (esAceptada ? "insp-state insp-state-ok" : "insp-state insp-state-other"));

                        var estadoIcon = esNoSatisfactorio ? "fa-exclamation-triangle" :
                                        (esObservada ? "fa-exclamation-circle" :
                                        (esAceptada ? "fa-check-circle" : "fa-clock"));

                        <tr class="@rowClass"
                            data-estado="@(esNoSatisfactorio ? "RESULTADO_NO_SATISFACTORIO" : (esObservada ? "OBSERVADA" : (esAceptada ? "ACEPTADA" : "PENDIENTE")))">
                            <td>@inspeccion.CodigoInspeccion</td>
                            <td>@inspeccion.CodigoSolicitud</td>
                            <td>@(inspeccion.CodigoInspector.HasValue ? inspeccion.CodigoInspector.Value.ToString() : "No asignado")</td>
                            <td>@(inspeccion.FechaProgramada.HasValue ? inspeccion.FechaProgramada.Value.ToString("dd/MM/yyyy") : "-")</td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(inspeccion.Estado))
                                {
                                    <span class="@estadoCss">
                                        <i class="fa @estadoIcon"></i>
                                        @inspeccion.Estado
                                    </span>
                                    if (esNoSatisfactorio)
                                    {
                                        <span class="insp-priority-flag"><i class="fa fa-bolt"></i>Prioridad alta</span>
                                    }
                                }
                                else { <span class="text-muted">-</span> }
                            </td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(observacion))
                                {
                                    <details class="insp-obs">
                                        <summary>Ver observacion</summary>
                                        <div class="mt-1">@observacion</div>
                                    </details>
                                }
                                else if (esObservada || esNoSatisfactorio)
                                {
                                    <span class="insp-obs-empty">Sin observacion registrada</span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(inspeccion.Resultado))
                                {
                                    <span class="badge 
                                        @(inspeccion.Resultado == "APROBADO" ? "bg-success" : 
                                          inspeccion.Resultado == "RECHAZADO" ? "bg-danger" : "bg-warning")">
                                        @inspeccion.Resultado
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">Pendiente</span>
                                }
                            </td>
                            <td>
                                <div class="btn-group btn-group-sm" role="group" aria-label="Acciones rapidas de inspeccion">
                                    <a href="@Url.Action("Detalle", "Inspeccion", new { id = inspeccion.CodigoInspeccion })" 
                                       class="btn btn-outline-primary" title="Ver detalle">
                                        <i class="fa fa-eye"></i>
                                    </a>
                                    @if (User.IsInRole("Inspector") || User.IsInRole("Administrador"))
                                    {
                                        <a href="@Url.Action("Editar", "Inspeccion", new { id = inspeccion.CodigoInspeccion })" 
                                           class="btn btn-outline-warning" title="Editar">
                                            <i class="fa fa-edit"></i>
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        }
        else
        {
            <div class="aocr-no-results">
                <i class="fas fa-clipboard-list"></i>
                <p class="mb-0">No hay inspecciones registradas.</p>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            function escapeRegex(text) {
                return text.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
            }

            function setupWithDataTable() {
                if (!window.jQuery || !$.fn || !$.fn.DataTable) {
                    return false;
                }

                var table = $('#tblInspeccionesInspector').DataTable({
                    order: [],
                    paging: true,
                    pageLength: 25,
                    searching: true,
                    info: true,
                    language: {
                        search: 'Buscar:',
                        lengthMenu: 'Mostrar _MENU_ registros',
                        info: 'Mostrando _START_ a _END_ de _TOTAL_',
                        infoEmpty: 'Sin registros',
                        zeroRecords: 'No se encontraron inspecciones',
                        paginate: { previous: 'Anterior', next: 'Siguiente' }
                    }
                });

                $('#inspQuickSearch').on('input', function () {
                    table.search(this.value).draw();
                });

                $('.insp-chip').on('click', function () {
                    var $btn = $(this);
                    $('.insp-chip').removeClass('active');
                    $btn.addClass('active');

                    var filter = ($btn.data('filter') || 'ALL').toString();
                    if (filter === 'ALL') {
                        table.column(4).search('').draw();
                        return;
                    }

                    if (filter === 'PENDIENTE') {
                        table.column(4).search('^(?!.*ACEPTADA)(?!.*OBSERVADA)(?!.*RESULTADO_NO_SATISFACTORIO).*$', true, false).draw();
                        return;
                    }

                    table.column(4).search(escapeRegex(filter), true, false).draw();
                });

                return true;
            }

            function setupFallbackFiltering() {
                var $rows = $('#tblInspeccionesInspector tbody tr');
                var $search = $('#inspQuickSearch');
                var currentFilter = 'ALL';

                function applyFilter() {
                    var query = ($search.val() || '').toLowerCase();

                    $rows.each(function () {
                        var $row = $(this);
                        var estado = ($row.data('estado') || '').toString();
                        var text = $row.text().toLowerCase();

                        var byState = currentFilter === 'ALL'
                            ? true
                            : (currentFilter === 'PENDIENTE'
                                ? (estado !== 'ACEPTADA' && estado !== 'OBSERVADA' && estado !== 'RESULTADO_NO_SATISFACTORIO')
                                : estado === currentFilter);

                        var byQuery = !query || text.indexOf(query) >= 0;
                        $row.toggle(byState && byQuery);
                    });
                }

                $('.insp-chip').on('click', function () {
                    var $btn = $(this);
                    $('.insp-chip').removeClass('active');
                    $btn.addClass('active');
                    currentFilter = ($btn.data('filter') || 'ALL').toString();
                    applyFilter();
                });

                $search.on('input', applyFilter);
            }

            $(function () {
                var datatableReady = setupWithDataTable();
                if (!datatableReady) {
                    setupFallbackFiltering();
                }
            });
        })();
    </script>
}


