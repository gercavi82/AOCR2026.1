@model CapaPresentacion.Models.ViewModels.InformeTecnicoPdfViewModel
@using System
@using System.Globalization

@{
    Layout = "~/Views/Shared/_PdfLayoutDGACAocr.cshtml";
    var informe = Model != null ? Model.Informe : null;
    var cultura = new CultureInfo("es-EC");
    Func<string, string> textoCampo = value => !string.IsNullOrWhiteSpace(value) ? value.Trim() : "PENDIENTE DE COMPLETAR";
    Func<string, string> claseCampo = value => !string.IsNullOrWhiteSpace(value) ? "field-value" : "field-value pending";
    Func<DateTime?, string> fechaCampo = value => value.HasValue ? value.Value.ToString("dd/MM/yyyy", cultura) : "PENDIENTE DE COMPLETAR";
    var elaboradoPor = Model != null && Model.Inspeccion != null && !string.IsNullOrWhiteSpace(Model.Inspeccion.InspectorPrincipalNombre)
        ? Model.Inspeccion.InspectorPrincipalNombre
        : (Model != null && Model.Solicitud != null ? Model.Solicitud.TecnicoResponsableNombre : null);
    var revisadoPor = informe != null ? informe.UsuarioFirma2 : null;
    var observacionesFinales = informe != null && !string.IsNullOrWhiteSpace(informe.Observaciones)
        ? informe.Observaciones
        : (informe != null ? informe.NoConformidades : null);
}

@section PdfHead {
    <style>
        body { font-family: Arial, Helvetica, sans-serif; font-size: 10pt; color: #111; }
        .sheet { border: 2px solid #1f1f1f; padding: 18px; }
        .section-title { font-weight: bold; font-size: 10.5pt; background: #e9eef5; padding: 7px 8px; border: 1px solid #222; }
        .signature-table { width: 100%; border-collapse: collapse; page-break-inside: avoid; break-inside: avoid; margin-top: 12px; }
        .signature-table td { border: 1px solid #222; padding: 6px; vertical-align: top; }
        .signature-line { height: 34px; border-bottom: 1px solid #222; margin-bottom: 6px; }
        .signature-role { font-weight: bold; text-transform: uppercase; font-size: 8.5pt; }
        .small { font-size: 8pt; color: #444; }
        .field-label { display: block; font-weight: bold; font-size: 8.5pt; margin-bottom: 4px; text-transform: uppercase; }
        .field-value { display: block; min-height: 20px; padding: 4px 6px; border: 1px dashed #666; background: #fbfbfb; }
        .field-value.pending { color: #7a4d00; font-style: italic; background: #fff8e8; }
        .signature-slot { height: 108px; min-height: 108px; border: 1px dashed #666; background: #fff; margin-top: 6px; overflow: hidden; }
    </style>
}

<div class="sheet">
    <div class="section-title">III. Revision y firmas</div>

    <table class="signature-table">
        <tr>
            <td style="width:33%;">
                <div class="signature-line"></div>
                <div class="signature-role">Elaborado por</div>
                <div class="@claseCampo(elaboradoPor)">@textoCampo(elaboradoPor)</div>
                <div class="small">Inspector DGAC</div>
            </td>
            <td style="width:33%;">
                <div class="signature-line"></div>
                <div class="signature-role">Revisado por</div>
                <div class="@claseCampo(revisadoPor)">@textoCampo(revisadoPor)</div>
                <div class="small">Fecha revision: @fechaCampo(informe != null ? informe.FechaFirma2 : null)</div>
            </td>
            <td style="width:34%;">
                <div class="signature-role">FIRMA DE AUTORIZACION</div>
                <div class="small">Espacio reservado para firma digital con QR y datos del firmante autorizado.</div>
                <div class="signature-slot"></div>
            </td>
        </tr>
        <tr>
            <td colspan="2">
                <span class="field-label">Observaciones de validacion final</span>
                <span class="@claseCampo(observacionesFinales)">@textoCampo(observacionesFinales)</span>
            </td>
            <td>
                <span class="field-label">Validacion de firma</span>
                <span class="field-value pending">La firma digital autorizada se inserta en el recuadro superior al momento de firmar el documento.</span>
            </td>
        </tr>
    </table>
</div>
