@model List<CapaModelo.Inspeccion>
@using CapaModelo
@using System.Web.Mvc.Html
@using System.Web.Mvc
@using System
@using System.Linq
@using System.Collections.Generic

@{
    ViewBag.Title = "Gestionar Inspecciones";
    ViewBag.PageSubtitle = "Módulo de Inspección";
    Layout = "~/Views/Shared/_LayoutAOCR.cshtml";
}

<div class="container-fluid aocr-shell">
    @Html.Partial("_HeroPanel", null, new ViewDataDictionary {
        { "IconClass", "fas fa-clipboard-check" },
        { "Overline", "Control de Inspecciones" },
        { "Title", "Gestionar Inspecciones" },
        { "Subtitle", "Seguimiento técnico" },
        { "Description", "Consulte estado, resultado y acciones disponibles para cada inspección registrada." },
        { "MetricLabel", "Total" },
        { "MetricValue", Model != null ? Model.Count : 0 }
    })

    <div class="card aocr-table-card">
        <div class="card-body p-0">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Código</th>
                                <th>Solicitud</th>
                                <th>Inspector</th>
                                <th>Fecha Programada</th>
                                <th>Estado</th>
                                <th>Resultado</th>
                                <th style="width:120px;">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var inspeccion in Model)
                            {
                                <tr>
                                    <td>@inspeccion.CodigoInspeccion</td>
                                    <td>@inspeccion.CodigoSolicitud</td>
                                    <td>@(inspeccion.CodigoInspector.HasValue ? inspeccion.CodigoInspector.Value.ToString() : "No asignado")</td>
                                    <td>@(inspeccion.FechaProgramada.HasValue ? inspeccion.FechaProgramada.Value.ToString("dd/MM/yyyy") : "-")</td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(inspeccion.Estado))
                                        {
                                            @Html.Partial("_StatusBadge", null, new ViewDataDictionary { { "Status", inspeccion.Estado } })
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(inspeccion.Resultado))
                                        {
                                            @Html.Partial("_StatusBadge", null, new ViewDataDictionary { { "Status", inspeccion.Resultado } })
                                        }
                                        else
                                        {
                                            <span class="text-muted">Pendiente</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a href="@Url.Action("Detalle", "Inspeccion", new { id = inspeccion.CodigoInspeccion })"
                                               class="btn btn-outline-primary" title="Ver detalle">
                                                <i class="fa fa-eye"></i>
                                            </a>
                                            @if (User.IsInRole("Inspector") || User.IsInRole("Administrador"))
                                            {
                                                <a href="@Url.Action("Editar", "Inspeccion", new { id = inspeccion.CodigoInspeccion })"
                                                   class="btn btn-outline-warning" title="Editar">
                                                    <i class="fa fa-edit"></i>
                                                </a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="p-3">
                    @Html.Partial("_EmptyState", null, new ViewDataDictionary {
                        { "IconClass", "fas fa-clipboard" },
                        { "Title", "No hay inspecciones registradas" },
                        { "Description", "Cuando se creen inspecciones, se mostrarán en esta bandeja." }
                    })
                </div>
            }
        </div>
    </div>
</div>


