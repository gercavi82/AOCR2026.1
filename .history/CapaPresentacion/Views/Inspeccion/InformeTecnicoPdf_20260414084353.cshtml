@model CapaPresentacion.Models.ViewModels.InformeTecnicoPdfViewModel
@using System
@using System.Globalization
@using System.Linq
@using System.Web
@using CapaPresentacion.Helpers

@{
    Layout = "~/Views/Shared/_PdfLayoutDGACAocr.cshtml";

    var inspeccion = Model != null ? Model.Inspeccion : null;
    var solicitud = Model != null ? Model.Solicitud : null;
    var informe = Model != null ? Model.Informe : null;
    var cultura = new CultureInfo("es-EC");

    Func<string, string> textoCampo = value => !string.IsNullOrWhiteSpace(value) ? value.Trim() : "PENDIENTE DE COMPLETAR";
    Func<string, string> claseCampo = value => !string.IsNullOrWhiteSpace(value) ? "field-value" : "field-value pending";
    Func<string, IHtmlString> textoMulti = value =>
        Html.Raw(HttpUtility.HtmlEncode(textoCampo(value) ?? string.Empty).Replace("\r\n", "<br />").Replace("\n", "<br />"));
    Func<DateTime?, string> fechaCampo = value => value.HasValue ? value.Value.ToString("dd/MM/yyyy", cultura) : "PENDIENTE DE COMPLETAR";

    var numeroInspeccion = inspeccion != null
        ? (!string.IsNullOrWhiteSpace(inspeccion.NumeroInspeccion) ? inspeccion.NumeroInspeccion : inspeccion.CodigoInspeccion.ToString())
        : null;
    var operador = solicitud != null ? solicitud.NombreOperador : null;
    var inspector = inspeccion != null && !string.IsNullOrWhiteSpace(inspeccion.InspectorPrincipalNombre)
        ? inspeccion.InspectorPrincipalNombre
        : (solicitud != null ? solicitud.TecnicoResponsableNombre : null);
    var licenciaInspector = informe != null && !string.IsNullOrWhiteSpace(informe.NumeroLicenciaInspector)
        ? informe.NumeroLicenciaInspector
        : (inspeccion != null && !string.IsNullOrWhiteSpace(inspeccion.InspectorPrincipalCedula)
            ? inspeccion.InspectorPrincipalCedula
            : (solicitud != null ? solicitud.TecnicoResponsableCedula : null));
    var telefonoCorreo = string.Join(" / ", new[]
    {
        solicitud != null ? solicitud.CorreoRepresentanteTecnico : null,
        solicitud != null ? solicitud.Email : null,
        solicitud != null ? solicitud.Telefono : null
    }.Where(x => !string.IsNullOrWhiteSpace(x)).Distinct());
    var operacionComercial = informe != null && !string.IsNullOrWhiteSpace(informe.OperacionComercial)
        ? informe.OperacionComercial
        : (solicitud != null
            ? (!string.IsNullOrWhiteSpace(solicitud.TipoOperacion) ? solicitud.TipoOperacion : solicitud.DescripcionOperacion)
            : null);
    var numeroSolicitud = solicitud != null
        ? (!string.IsNullOrWhiteSpace(solicitud.NumeroSolicitud) ? solicitud.NumeroSolicitud : solicitud.CodigoSolicitud.ToString())
        : null;
    var fechaEmision = informe != null && informe.FechaFinalizacion.HasValue ? informe.FechaFinalizacion : DateTime.Now;
    var fechaProgramada = inspeccion != null ? inspeccion.FechaProgramada : null;
    var estadoInspeccion = inspeccion != null ? inspeccion.Estado : null;
    var resultadoTecnico = !string.IsNullOrWhiteSpace(informe != null ? informe.Resultado : null)
        ? informe.Resultado
        : (inspeccion != null ? inspeccion.Resultado : null);

    var antecedentes = informe != null && !string.IsNullOrWhiteSpace(informe.Antecedentes)
        ? informe.Antecedentes
        : (informe != null ? informe.Resumen : null);
    var alcance = informe != null && !string.IsNullOrWhiteSpace(informe.Alcance)
        ? informe.Alcance
        : (informe != null ? informe.Desarrollo : null);
    var trabajosRealizados = informe != null && !string.IsNullOrWhiteSpace(informe.TrabajosRealizados)
        ? informe.TrabajosRealizados
        : (informe != null ? informe.Resumen : null);
    var notas = informe != null ? informe.Notas : null;
    var noConformidades = informe != null && !string.IsNullOrWhiteSpace(informe.NoConformidades)
        ? informe.NoConformidades
        : (informe != null ? informe.Observaciones : null);
    var conclusion = informe != null ? informe.Conclusiones : null;
    var recomendaciones = informe != null ? informe.Recomendaciones : null;
    var evidencias = informe != null ? informe.Evidencias : null;
    var observacionesFinales = informe != null && !string.IsNullOrWhiteSpace(informe.Observaciones)
        ? informe.Observaciones
        : noConformidades;

    var servicios = InformeTecnicoTemplateHelper.GetServicioRows(informe != null ? informe.ServiciosEstaciones : null);
    var documentosBase = InformeTecnicoTemplateHelper.GetDocumentosAdjuntosBase();
    var documentosSeleccionados = InformeTecnicoTemplateHelper.SplitLines(informe != null ? informe.DocumentosAdjuntos : null);
    var otrosAdjuntos = InformeTecnicoTemplateHelper.SplitLines(informe != null ? informe.OtrosAdjuntos : null);
    var elaboradoPor = inspector;
    var revisadoPor = informe != null && !string.IsNullOrWhiteSpace(informe.UsuarioFirma2) ? informe.UsuarioFirma2 : null;
    var fechaElaboracion = informe != null && informe.FechaFirma1.HasValue ? informe.FechaFirma1 : fechaEmision;
    var firmadoInspector = informe != null && informe.FirmadoInspector;
    var firmadoDirdac = informe != null && informe.FirmadoDirdac;
    var firmanteInspector = informe != null && !string.IsNullOrWhiteSpace(informe.UsuarioFirma1) ? informe.UsuarioFirma1 : null;
}

@section PdfHead {
    <style>
        body { font-family: Arial, Helvetica, sans-serif; font-size: 10pt; color: #111; }
        .report-flow { display: block; }
        .head-table, .grid, .signature-table, .mini-grid { width: 100%; border-collapse: collapse; }
        .head-table td, .grid td, .grid th, .signature-table td, .mini-grid td, .mini-grid th { border: 1px solid #222; padding: 6px; vertical-align: top; }
        .signature-table tr, .mini-grid tr { page-break-inside: avoid; break-inside: avoid; }
        .head-table thead, .grid thead, .mini-grid thead, .signature-table thead { display: table-header-group; }
        .title { text-align: center; font-weight: bold; font-size: 13pt; letter-spacing: .4px; }
        .title-block { max-width: 86%; margin: 0 auto; line-height: 1.08; }
        .subtitle { text-align: center; font-size: 10pt; }
        .small { font-size: 8pt; color: #444; }
        .center { text-align: center; }
        .spacer { height: 14px; }
        .section-title { font-weight: bold; font-size: 10.5pt; background: #e9eef5; padding: 7px 8px; border: 1px solid #222; page-break-after: avoid; }
        .field-label { display: block; font-weight: bold; font-size: 8.5pt; margin-bottom: 4px; text-transform: uppercase; }
        .field-value { display: block; min-height: 20px; padding: 4px 6px; border: 1px dashed #666; background: #fbfbfb; }
        .field-value.pending { color: #7a4d00; font-style: italic; background: #fff8e8; }
        .section-grid { margin-top: 8px; }
        .coverage-wrap { margin-top: 8px; }
        .note-box { border: 1px solid #222; background: #f7fafc; padding: 10px 12px; page-break-inside: auto; break-inside: auto; }
        .signature-line { height: 34px; border-bottom: 1px solid #222; margin-bottom: 6px; }
        .signature-role { font-weight: bold; text-transform: uppercase; font-size: 8.5pt; }
        .checklist { margin: 0; padding-left: 18px; }
        .checklist li { margin-bottom: 4px; }
        .signature-wrap { margin-top: 14px; page-break-inside: avoid; break-inside: avoid; }
        .signature-table { page-break-inside: avoid; break-inside: avoid; }
        .signature-slot { height: 120px; min-height: 120px; border: 1px dashed #999; background: #fff; margin-top: 6px; overflow: hidden; position: relative; }
        .firma-anchor { font-size: 1px; color: #fff; line-height: 1px; height: 1px; overflow: hidden; display: block; }
        .mini-grid { margin-top: 6px; }
        .mini-grid th { text-align: center; background: #f0f4f8; font-size: 8.4pt; }
        .mini-grid td { font-size: 8.4pt; padding: 4px 5px; }
        .service-name { width: 38%; font-weight: bold; }
    </style>
}

<div class="report-flow">
    <table class="head-table">
        <tr>
            <td colspan="3" class="title">
                <div class="title-block">
                    INFORME DE INSPECCION<br />
                    AOCR
                </div>
            </td>
        </tr>
        <tr>
            <td colspan="3" class="subtitle">TECHNICAL INSPECTION REPORT</td>
        </tr>
        <tr>
            <td class="center" style="width:33%;"><strong>REPUBLICA DEL ECUADOR</strong><br /><span class="small">REPUBLIC OF ECUADOR</span></td>
            <td class="center" style="width:34%;"><strong>DIRECCION GENERAL DE AVIACION CIVIL</strong><br /><span class="small">CIVIL AVIATION GENERAL DIRECTORATE</span></td>
            <td class="center" style="width:33%;"><strong>GESTION DE INSPECCIONES AOCR</strong><br /><span class="small">AOCR INSPECTION UNIT</span></td>
        </tr>
    </table>

    <div class="spacer"></div>

    <div class="section-title">I. Datos generales de la inspeccion</div>

    <table class="grid">
        <tr>
            <td style="width:33%;"><span class="field-label">Orden de inspeccion</span><span class="@claseCampo(numeroInspeccion)">@textoCampo(numeroInspeccion)</span></td>
            <td style="width:34%;"><span class="field-label">Nombre del explotador</span><span class="@claseCampo(operador)">@textoCampo(operador)</span></td>
            <td style="width:33%;"><span class="field-label">Inspector DGAC</span><span class="@claseCampo(inspector)">@textoCampo(inspector)</span></td>
        </tr>
        <tr>
            <td><span class="field-label">Fecha de emision</span><span class="field-value">@fechaCampo(fechaEmision)</span></td>
            <td><span class="field-label">Resultado tecnico</span><span class="@claseCampo(resultadoTecnico)">@textoCampo(InformeTecnicoTemplateHelper.GetResultadoLabel(resultadoTecnico))</span></td>
            <td><span class="field-label">Correo / Telefono</span><span class="@claseCampo(telefonoCorreo)">@textoCampo(telefonoCorreo)</span></td>
        </tr>
        <tr>
            <td><span class="field-label">Operacion comercial</span><span class="@claseCampo(operacionComercial)">@textoCampo(operacionComercial)</span></td>
            <td><span class="field-label">No. licencia inspector</span><span class="@claseCampo(licenciaInspector)">@textoCampo(licenciaInspector)</span></td>
            <td><span class="field-label">Numero de solicitud / tramite base</span><span class="@claseCampo(numeroSolicitud)">@textoCampo(numeroSolicitud)</span></td>
        </tr>
        <tr>
            <td><span class="field-label">Estado de inspeccion</span><span class="@claseCampo(estadoInspeccion)">@textoCampo(estadoInspeccion)</span></td>
            <td><span class="field-label">Fecha programada</span><span class="field-value @(fechaProgramada.HasValue ? string.Empty : "pending")">@fechaCampo(fechaProgramada)</span></td>
            <td><span class="field-label">Operador</span><span class="@claseCampo(operador)">@textoCampo(operador)</span></td>
        </tr>
    </table>

    <div class="spacer"></div>

    <div class="note-box" style="border-left:3px solid #0d6efd; margin-bottom:8px;">
        <strong>Art. 110.- Inspección del Código Aeronáutico</strong><br />
        Con fundamento en el Art. 110 del Código Aeronáutico, se realizó la inspección con el fin de comprobar
        que el explotador <strong>@textoCampo(operador)</strong>
        cumple las condiciones mínimas de seguridad operacional exigidas por la Dirección General de Aviación Civil.
        Inspección <strong>@textoCampo(numeroInspeccion)</strong>,
        fecha programada: <strong>@fechaCampo(fechaProgramada)</strong>.
    </div>

    <div class="section-title">II. Campos tecnicos del informe</div>

    <table class="grid section-grid">
        <tr>
            <td style="width:50%;">
                <span class="field-label">Antecedentes / referencia tecnica</span>
                <span class="@claseCampo(antecedentes)">@textoMulti(antecedentes)</span>
            </td>
            <td style="width:50%;">
                <span class="field-label">Alcance de inspeccion</span>
                <span class="@claseCampo(alcance)">@textoMulti(alcance)</span>
            </td>
        </tr>
        <tr>
            <td colspan="2">
                <span class="field-label">Trabajos realizados</span>
                <span class="@claseCampo(trabajosRealizados)">@textoMulti(trabajosRealizados)</span>
            </td>
        </tr>
        <tr>
            <td colspan="2">
                <span class="field-label">Cobertura por estacion</span>
                <div class="coverage-wrap">
                <table class="mini-grid">
                    <tr>
                        <th class="service-name">Servicio / responsabilidad</th>
                        <th>UIO</th>
                        <th>GYE</th>
                        <th>MEC</th>
                        <th>LTX</th>
                    </tr>
                    @foreach (var fila in servicios)
                    {
                        <tr>
                            <td class="service-name">@fila.Label</td>
                            <td>@(string.IsNullOrWhiteSpace(fila.Uio) ? "N/A" : fila.Uio)</td>
                            <td>@(string.IsNullOrWhiteSpace(fila.Gye) ? "N/A" : fila.Gye)</td>
                            <td>@(string.IsNullOrWhiteSpace(fila.Mec) ? "N/A" : fila.Mec)</td>
                            <td>@(string.IsNullOrWhiteSpace(fila.Ltx) ? "N/A" : fila.Ltx)</td>
                        </tr>
                    }
                </table>
                </div>
            </td>
        </tr>
    </table>

    <table class="grid section-grid">
        <tr>
            <td style="width:50%;">
                <span class="field-label">Notas</span>
                <span class="@claseCampo(notas)">@textoMulti(notas)</span>
            </td>
            <td style="width:50%;">
                <span class="field-label">No conformidades</span>
                <span class="@claseCampo(noConformidades)">@textoMulti(noConformidades)</span>
            </td>
        </tr>
    </table>

    <table class="grid section-grid">
        <tr>
            <td style="width:100%;">
                <span class="field-label">Recomendaciones</span>
                <span class="@claseCampo(recomendaciones)">@textoMulti(recomendaciones)</span>
            </td>
        </tr>
    </table>

    <div class="spacer"></div>

    <div class="note-box">
        <strong>Documentos adjuntos y evidencias</strong>
        <ol class="checklist">
            @if (documentosSeleccionados.Any())
            {
                foreach (var item in documentosSeleccionados)
                {
                    <li>@item</li>
                }
            }
            else
            {
                <li>PENDIENTE DE COMPLETAR</li>
            }

            @foreach (var item in otrosAdjuntos)
            {
                if (!string.IsNullOrWhiteSpace(item))
                {
                    <li>@item</li>
                }
            }

            @if (!string.IsNullOrWhiteSpace(evidencias))
            {
                <li>@Html.Raw(HttpUtility.HtmlEncode(evidencias).Replace("\r\n", "<br />").Replace("\n", "<br />"))</li>
            }
        </ol>
    </div>

    <div class="signature-wrap">
    <div class="section-title">III. Revision y firmas</div>

    <table class="signature-table" style="margin-top:12px;">
        <tr>
            <td style="width:50%;">
                <div class="signature-role">ELABORADO POR</div>
                <div class="field-value" style="min-height:24px;">@(firmadoInspector && !string.IsNullOrWhiteSpace(firmanteInspector) ? firmanteInspector : textoCampo(elaboradoPor))</div>
                <div class="small">Inspector DGAC</div>
                <div class="small">Fecha: @(firmadoInspector && informe.FechaFirma1.HasValue ? informe.FechaFirma1.Value.ToString("dd/MM/yyyy", cultura) : fechaCampo(fechaElaboracion))</div>
            </td>
            <td style="width:50%;">
                <div class="signature-role">REVISADO / AUTORIZADO POR</div>
                <div class="field-value" style="min-height:24px;">@(firmadoDirdac && !string.IsNullOrWhiteSpace(revisadoPor) ? revisadoPor : (firmadoDirdac ? "—" : ""))</div>
                <div class="small">Director / Jefatura</div>
                <div class="small">Fecha revision: @(firmadoDirdac && informe.FechaFirma2.HasValue ? informe.FechaFirma2.Value.ToString("dd/MM/yyyy", cultura) : "")</div>
            </td>
        </tr>
        <tr>
            <td style="width:50%;" data-firma-rol="INFORME_TECNICO_INSPECTOR">
                <div class="signature-role">FIRMA DEL INSPECTOR DGAC</div>
                <div class="signature-slot">
                    <span class="firma-anchor">ANCLA_FIRMA_INSPECTOR_DGAC</span>
                </div>
            </td>
            <td style="width:50%;" data-firma-rol="INFORME_TECNICO_DIRDAC">
                <div class="signature-role">FIRMA DEL DIRECTOR / JEFATURA</div>
                <div class="signature-slot">
                    <span class="firma-anchor">ANCLA_FIRMA_DIRDAC_JEFATURA</span>
                </div>
            </td>
        </tr>
        <tr>
            <td colspan="2">
                <span class="field-label">OBSERVACIONES DE VALIDACION FINAL</span>
                <span class="@claseCampo(observacionesFinales)">@textoMulti(observacionesFinales)</span>
            </td>
        </tr>
    </table>
    </div>
</div>
