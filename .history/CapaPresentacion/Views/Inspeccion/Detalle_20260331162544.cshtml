        }

        .inspection-detail-page .table-card-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 1rem;
            margin-bottom: 1rem;
        }

        .inspection-detail-page .section-badge {
            display: inline-flex;
            align-items: center;
            padding: 0.35rem 0.7rem;
            border-radius: 999px;
            background: rgba(27, 79, 114, 0.08);
            color: var(--inspection-primary);
            font-size: 0.74rem;
            font-weight: 800;
        }

        .inspection-detail-page .hallazgos-summary {
            display: flex;
            flex-wrap: wrap;
            gap: 0.75rem;
            margin-top: 0.35rem;
        }

        .inspection-detail-page .hallazgos-summary-item {
            display: inline-flex;
            align-items: center;
            gap: 0.45rem;
            padding: 0.5rem 0.8rem;
