        }

        .inspection-detail-page .report-module-title {
            margin: 0;
            color: var(--inspection-primary-dark);
            font-size: 1rem;
            font-weight: 800;
        }

        .inspection-detail-page .report-module-copy {
            margin: 0.25rem 0 0;
            color: var(--inspection-muted);
            font-size: 0.82rem;
            line-height: 1.5;
        }

        .inspection-detail-page .report-module-badge {
            display: inline-flex;
            align-items: center;
            padding: 0.34rem 0.65rem;
            border-radius: 999px;
