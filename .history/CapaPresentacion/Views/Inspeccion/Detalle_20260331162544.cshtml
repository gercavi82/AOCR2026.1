        .inspection-detail-page .info-panel-title {
            margin: 0;
            font-size: 0.98rem;
            font-weight: 800;
            color: var(--inspection-primary-dark);
        }

        .inspection-detail-page .info-panel-copy {
            margin: 0.28rem 0 0;
            color: var(--inspection-muted);
