            font-size: 0.82rem;
            font-weight: 700;
        }

        .inspection-detail-page .hallazgos-empty-card {
            background: linear-gradient(180deg, #f8fbfd 0%, #ffffff 100%);
        }

        .inspection-detail-page .button-flow {
            display: flex;
            flex-wrap: wrap;
            gap: 0.75rem;
        }

        .inspection-detail-page .button-flow form {
            margin: 0;
        }

        .inspection-detail-page .button-flow .btn,
        .inspection-detail-page .compact-form .btn,
        .inspection-detail-page .upload-panel .btn,
        .inspection-detail-page .action-footer .btn {
            border-radius: 14px;
            font-weight: 700;
            padding: 0.65rem 1rem;
        }

        .inspection-detail-page .btn-ver-pdf {
            border-radius: 12px;
            font-weight: 700;
            padding: 0.55rem 1rem;
            color: #ffffff;
            background: #198754;
            border: 1px solid #198754;
        }

        .inspection-detail-page .btn-ver-pdf:hover,
        .inspection-detail-page .btn-ver-pdf:focus {
            color: #ffffff;
            background: #157347;
            border-color: #146c43;
            text-decoration: none;
        }

        .inspection-detail-page .compact-form {
            display: flex;
            flex-wrap: wrap;
            gap: 0.75rem;
            align-items: end;
        }

        .inspection-detail-page .compact-form .form-group,
        .inspection-detail-page .compact-form .form-field {
            flex: 1 1 200px;
            min-width: 180px;
        }

        .inspection-detail-page .compact-form label,
        .inspection-detail-page .upload-panel label {
            font-size: 0.82rem;
            font-weight: 700;
            color: var(--inspection-muted);
            margin-bottom: 0.35rem;
        }

        .inspection-detail-page .form-control,
        .inspection-detail-page .form-select {
            border-radius: 14px;
            border: 1px solid rgba(27, 79, 114, 0.16);
            padding: 0.78rem 0.95rem;
            box-shadow: none;
        }

        .inspection-detail-page select.form-control {
            color: #243746;
            background-color: #ffffff;
        }

        .inspection-detail-page select.form-control option {
            color: #243746;
            background-color: #ffffff;
        }

        .inspection-detail-page select.form-control:invalid {
            color: #6b7c8a;
        }

        .inspection-detail-page .result-select {
            height: 44px;
            min-height: 44px;
            padding: 0.5rem 0.95rem;
            line-height: 1.35;
            font-size: 0.95rem;
            color: #243746;
            -webkit-text-fill-color: #243746;
        }

        .inspection-detail-page .result-select option {
            font-size: 0.95rem;
        }

        .inspection-detail-page .form-control:focus,
        .inspection-detail-page .form-select:focus {
            border-color: rgba(15, 123, 132, 0.65);
            box-shadow: 0 0 0 0.2rem rgba(15, 123, 132, 0.12);
        }

        .inspection-detail-page .upload-panel {
            border: 1px dashed rgba(27, 79, 114, 0.24);
            border-radius: 20px;
            padding: 1rem;
            background: linear-gradient(180deg, #f8fbfd 0%, #ffffff 100%);
        }

        .inspection-detail-page .signature-panel {
            display: grid;
            gap: 1rem;
        }

        .inspection-detail-page .status-pill {
            display: inline-flex;
            align-items: center;
            gap: 0.45rem;
            padding: 0.45rem 0.8rem;
            border-radius: 999px;
            font-size: 0.78rem;
            font-weight: 800;
            letter-spacing: 0.03em;
            text-transform: uppercase;
        }

        .inspection-detail-page .status-pill.primary {
            color: #e9f4ff;
            background: rgba(27, 79, 114, 0.88);
        }

        .inspection-detail-page .status-pill.success {
            color: #eaf8f0;
            background: rgba(47, 125, 80, 0.92);
        }

        .inspection-detail-page .status-pill.warning {
            color: #fff8e7;
            background: rgba(196, 138, 24, 0.9);
        }

        .inspection-detail-page .status-pill.danger {
            color: #fff1f1;
            background: rgba(184, 74, 74, 0.9);
        }

        .inspection-detail-page .alert-inline {
            border-radius: 18px;
            border: 1px solid rgba(27, 79, 114, 0.1);
            background: linear-gradient(180deg, #f8fbfd 0%, #ffffff 100%);
            padding: 1rem 1.1rem;
        }

        .inspection-detail-page .report-pdf-bar {
            border-radius: 14px;
            border: 1px solid rgba(25, 135, 84, 0.24);
            background: #eefaf3;
            padding: 0.9rem 1rem;
        }

        .inspection-detail-page .report-pdf-title {
            display: block;
            color: #0f5132;
            font-weight: 800;
        }

        .inspection-detail-page .report-pdf-path {
            margin-top: 0.35rem;
            color: #1f3f33;
            font-size: 0.82rem;
            line-height: 1.35;
            word-break: break-all;
        }

        .inspection-detail-page .hallazgos-table {
            margin-bottom: 0;
            overflow: hidden;
            border-radius: 18px;
        }

        .inspection-detail-page .hallazgos-table thead th {
            background: #f1f6f9;
            color: var(--inspection-primary-dark);
            border-bottom: 1px solid rgba(27, 79, 114, 0.12);
            font-size: 0.8rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.03em;
        }

        .inspection-detail-page .hallazgos-table td,
        .inspection-detail-page .hallazgos-table th {
            vertical-align: middle;
            padding: 0.95rem 1rem;
        }

        .inspection-detail-page .hallazgos-empty {
            padding: 2rem 1rem;
            text-align: center;
            color: var(--inspection-muted);
        }

        .inspection-detail-page .timeline-list {
            display: grid;
            gap: 0.85rem;
        }

        .inspection-detail-page .timeline-item {
            border: 1px solid rgba(27, 79, 114, 0.12);
            border-radius: 18px;
            padding: 1rem;
            background: linear-gradient(180deg, #f8fbfd 0%, #ffffff 100%);
        }

        .inspection-detail-page .timeline-meta {
            display: flex;
            flex-wrap: wrap;
            gap: 0.65rem;
            margin-bottom: 0.45rem;
            color: var(--inspection-muted);
            font-size: 0.82rem;
        }

        .inspection-detail-page .doc-table thead th {
            background: #f1f6f9;
            color: var(--inspection-primary-dark);
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 0.03em;
        }

        .inspection-detail-page .doc-table td,
        .inspection-detail-page .doc-table th {
            padding: 0.9rem 0.85rem;
            vertical-align: middle;
        }

        .inspection-detail-page .action-footer {
            display: flex;
            flex-wrap: wrap;
            justify-content: space-between;
            align-items: center;
            gap: 1rem;
            margin-top: 1.5rem;
            padding: 1.1rem 1.2rem;
            border-radius: 22px;
            border: 1px solid rgba(27, 79, 114, 0.1);
            background: linear-gradient(180deg, #fbfdff 0%, #f3f8fb 100%);
        }

        .inspection-detail-page .modal-content {
            border: 0;
            border-radius: 24px;
            overflow: hidden;
            box-shadow: 0 24px 60px rgba(13, 40, 58, 0.18);
        }

        .inspection-detail-page .modal-header {
            background: linear-gradient(135deg, var(--inspection-primary-dark) 0%, var(--inspection-primary) 100%);
            color: #fff;
            border-bottom: 0;
            padding: 1rem 1.25rem;
        }

        .inspection-detail-page .modal-body {
            padding: 1.25rem;
            background: #f9fbfc;
        }

        @@media (max-width: 991.98px) {
            .inspection-detail-page .hero-layout,
            .inspection-detail-page .central-grid,
            .inspection-detail-page .utility-grid,
            .inspection-detail-page .hero-metrics,
            .inspection-detail-page .status-strip,
            .inspection-detail-page .detail-grid,
            .inspection-detail-page .action-grid {
                grid-template-columns: 1fr 1fr;
            }

            .inspection-detail-page .hero-layout,
            .inspection-detail-page .central-grid,
            .inspection-detail-page .utility-grid,
            .inspection-detail-page .info-panel-grid {
                grid-template-columns: 1fr;
            }

            .inspection-detail-page .report-grid-3 {
                grid-template-columns: 1fr 1fr;
            }
        }

        @@media (max-width: 767.98px) {
            .inspection-detail-page .inspection-shell {
                padding: 1rem;
            }

            .inspection-detail-page .hero-title {
                font-size: 1.6rem;
            }

            .inspection-detail-page .hero-metrics,
            .inspection-detail-page .status-strip,
            .inspection-detail-page .detail-grid,
            .inspection-detail-page .action-grid,
            .inspection-detail-page .bpmn-mini-grid,
            .inspection-detail-page .info-panel-stack.two-col,
            .inspection-detail-page .report-grid-2,
            .inspection-detail-page .report-grid-3 {
                grid-template-columns: 1fr;
            }

            .inspection-detail-page .action-footer {
                align-items: stretch;
            }
        }
    </style>
}

@if (Model == null)
{
    <div class="alert alert-danger">No se recibio el modelo de inspeccion.</div>
    return;
}

<div class="inspection-detail-page">
    <div class="inspection-shell">
        <div class="card hero-card mb-4">
            <div class="hero-body">
                <div class="hero-layout">
                    <div class="hero-main">
                        <div>
                            <span class="hero-badge">
                                <i class="fas fa-clipboard-check"></i>
                                Gestión Técnica DGAC
                            </span>
                            <h1 class="hero-title">Detalle de inspección</h1>
                            <p class="hero-subtitle">Vista ejecutiva para seguimiento técnico, trazabilidad BPMN, control documental y gestión integral del informe de inspección.</p>
                        </div>

                        <div class="hero-metrics">
                            <div class="hero-metric">
                                <span class="hero-metric-label">Código inspección</span>
                                <span class="hero-metric-value">@Model.CodigoInspeccion</span>
                            </div>
                            <div class="hero-metric">
                                <span class="hero-metric-label">Solicitud vinculada</span>
                                <span class="hero-metric-value">@Model.CodigoSolicitud</span>
                            </div>
                            <div class="hero-metric">
                                <span class="hero-metric-label">Estado actual</span>
                                <span class="hero-metric-value">@estadoActual</span>
                            </div>
                            <div class="hero-metric">
                                <span class="hero-metric-label">Fecha programada</span>
                                <span class="hero-metric-value">@fechaProgramada</span>
                            </div>
                        </div>

                        @if (solicitud != null)
                        {
                            <div class="hero-metrics mt-2">
                                <div class="hero-metric">
                                    <span class="hero-metric-label">Operador</span>
                                    <span class="hero-metric-value">@(!string.IsNullOrWhiteSpace(solicitud.RazonSocial) ? solicitud.RazonSocial : solicitud.NombreOperador)</span>
                                </div>
                                <div class="hero-metric">
                                    <span class="hero-metric-label">Correo solicitante</span>
                                    <span class="hero-metric-value">@correoSolicitante</span>
                                </div>
                                <div class="hero-metric">
                                    <span class="hero-metric-label">Versión informe</span>
                                    <span class="hero-metric-value">@(informeTecnico != null ? informeTecnico.Version.ToString() : "0")</span>
                                </div>
                                <div class="hero-metric">
                                    <span class="hero-metric-label">DIRDAC formalmente notificado</span>
                                    <span class="hero-metric-value">@(informeTecnico == null ? "NO" : (notificacionFormalDirdac ? "SI" : (informeEnviadoADirdac ? "PENDIENTE" : "NO")))</span>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="hero-side">
                        <div class="hero-side-card">
                            <h2 class="hero-side-title">Contexto ejecutivo</h2>
                            <p class="hero-side-copy">Concentre aquí la lectura operativa de la inspección antes de revisar transiciones BPMN, informe técnico, documentos y hallazgos.</p>
                        </div>
                        <div class="hero-side-card">
                            <div class="hero-pill-grid">
                                <div class="hero-pill-item">
                                    <span>Resultado</span>
                                    <strong>@resultadoActual</strong>
                                </div>
                                <div class="hero-pill-item">
                                    <span>Evaluación</span>
                                    <strong>@resultadoEvaluacion</strong>
                                </div>
                                <div class="hero-pill-item">
                                    <span>Estado documental</span>
                                    <strong>@estadoDocumental</strong>
                                </div>
                                <div class="hero-pill-item">
                                    <span>Hallazgos</span>
                                    <strong>@hallazgosLista.Count registrados</strong>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-inline mb-4">@TempData["Success"]</div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-inline mb-4">@TempData["Error"]</div>
        }

        @if (TempData["Warning"] != null)
        {
            <div class="alert alert-warning alert-inline mb-4">@TempData["Warning"]</div>
        }

        <div class="status-strip status-strip-wide">
            <div class="status-tile highlight">
                <small>Resultado</small>
                <strong>@resultadoActual</strong>
            </div>
            <div class="status-tile">
                <small>Evaluación</small>
                <strong>@resultadoEvaluacion</strong>
            </div>
            <div class="status-tile">
                <small>Estado documental</small>
                <strong>@estadoDocumental</strong>
            </div>
            <div class="status-tile">
                <small>Hallazgos</small>
                <strong>@hallazgosLista.Count registrados</strong>
            </div>
            <div class="status-tile">
                <small>Versión informe</small>
                <strong>@(informeTecnico != null ? informeTecnico.Version.ToString() : "0")</strong>
            </div>
            <div class="status-tile">
                <small>Notificación DGAC</small>
                <strong>@(notificacionFormalDirdac ? "Notificado" : (informeEnviadoADirdac ? "Pendiente" : "No enviado"))</strong>
            </div>
        </div>

        <div class="card section-card soft-card mt-4">
            <div class="card-body">
                <div class="section-heading">
                    <div class="section-icon">
                        <i class="fas fa-id-badge"></i>
                    </div>
                    <div>
                        <h2 class="section-title">Información general de inspección</h2>
                        <p class="section-copy">Consolidado principal de asignación, estado operativo y datos administrativos asociados a la inspección.</p>
                    </div>
                </div>

                <div class="info-panel-grid">
                    <div class="info-panel">
                        <div class="info-panel-head">
                            <div>
                                <h3 class="info-panel-title">Equipo inspector</h3>
                                <p class="info-panel-copy">Asignación visible, responsables principales y apoyo técnico registrado en AS400.</p>
                            </div>
                            <span class="info-panel-badge">Equipo</span>
                        </div>
                        <div class="info-panel-stack">
                            <div class="detail-item">
                                <span class="detail-label">Inspector asignado</span>
                                <div class="detail-value">@inspectorAsignado</div>
                            </div>
                            <div class="detail-item">
                                <span class="detail-label">Inspector principal AS400</span>
                                <div class="detail-value">@inspectorPrincipal</div>
                            </div>
                            <div class="detail-item">
                                <span class="detail-label">Inspector apoyo AS400</span>
                                <div class="detail-value">@inspectorApoyo</div>
                            </div>
                        </div>
                    </div>

                    <div class="info-panel">
                        <div class="info-panel-head">
                            <div>
                                <h3 class="info-panel-title">Clasificación técnica</h3>
                                <p class="info-panel-copy">Tipología de inspectores y lectura rápida del estado documental y de agenda.</p>
                            </div>
                            <span class="info-panel-badge">AS400</span>
                        </div>
                        <div class="info-panel-stack two-col">
                            <div class="detail-item">
                                <span class="detail-label">Tipo inspector principal</span>
                                <div class="detail-value">@(!string.IsNullOrWhiteSpace(Model.InspectorPrincipalTipo) ? Model.InspectorPrincipalTipo : "-")</div>
                            </div>
                            <div class="detail-item">
                                <span class="detail-label">Tipo inspector apoyo</span>
                                <div class="detail-value">@(!string.IsNullOrWhiteSpace(Model.InspectorApoyoTipo) ? Model.InspectorApoyoTipo : "-")</div>
                            </div>
                            <div class="detail-item">
                                <span class="detail-label">Estado documental</span>
                                <div class="detail-value">@estadoDocumental</div>
                            </div>
                            <div class="detail-item">
                                <span class="detail-label">Fecha programada</span>
                                <div class="detail-value">@fechaProgramada</div>
                            </div>
                        </div>
                    </div>

                    <div class="info-panel">
                        <div class="info-panel-head">
                            <div>
                                <h3 class="info-panel-title">Control financiero</h3>
                                <p class="info-panel-copy">Seguimiento de viáticos, validación financiera y coherencia administrativa.</p>
                            </div>
                            <span class="info-panel-badge">Finanzas</span>
                        </div>
                        <div class="info-panel-stack two-col">
                            <div class="detail-item">
                                <span class="detail-label">Viáticos requeridos</span>
                                <div class="detail-value">@(Model.ViaticosRequeridos ? "SI" : "NO")</div>
                            </div>
                            <div class="detail-item">
                                <span class="detail-label">Monto viáticos</span>
                                <div class="detail-value">@montoViaticos</div>
                            </div>
                            <div class="detail-item">
                                <span class="detail-label">Pago viáticos validado</span>
                                <div class="detail-value">@(Model.PagoViaticosValidado ? "SI" : "NO")</div>
                            </div>
                            <div class="detail-item">
                                <span class="detail-label">Fecha pago viáticos</span>
                                <div class="detail-value">@fechaPagoViaticos</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="central-grid">
            <div class="card section-card">
                <div class="card-body">
                    <div class="section-heading">
                        <div class="section-icon">
                            <i class="fas fa-project-diagram"></i>
                        </div>
                        <div>
                            <h2 class="section-title">Flujo BPMN de inspección</h2>
                            <p class="section-copy">Transiciones, lectura operativa del estado y decisiones disponibles según el rol autenticado.</p>
                        </div>
                    </div>

                    <div class="stack-grid">
                        <div class="bpmn-panel">
                            <div class="bpmn-mini-grid">
                                <div class="bpmn-mini-card">
                                    <small>Estado actual</small>
                                    <strong>@estadoActualNormalizado</strong>
                                </div>
                                <div class="bpmn-mini-card">
                                    <small>Resultado</small>
                                    <strong>@resultadoActual</strong>
                                </div>
                                <div class="bpmn-mini-card">
                                    <small>Operador</small>
                                    <strong>@operadorInspeccionado</strong>
                                </div>
                                <div class="bpmn-mini-card">
                                    <small>Inspector principal</small>
                                    <strong>@inspectorPrincipal</strong>
                                </div>
                            </div>
                        </div>

                    @if (mostrarAvisoCoordinacionDetalle)
                    {
                        <div class="alert alert-info mb-3" role="alert">
                            <strong>Gestion institucional centralizada en Direccion / Jefatura.</strong>
                            <div class="mt-2">@mensajeCoordinacionDetalle</div>
                            <div class="d-flex flex-wrap gap-3 mt-3 small">
                                <span><strong>Solicitud:</strong> @(solicitud != null && !string.IsNullOrWhiteSpace(solicitud.NumeroSolicitud) ? solicitud.NumeroSolicitud : (Model != null ? Model.CodigoSolicitud.ToString() : "-"))</span>
                                <span><strong>Compania:</strong> @operadorInspeccionado</span>
                                <span><strong>Estado actual:</strong> @estadoActualNormalizado</span>
                                <span><strong>Inspector:</strong> @inspectorPrincipal</span>
                            </div>
                            <div class="d-flex flex-wrap gap-2 mt-3">
                                <a href="@urlRevisionVerificacion" class="btn btn-sm btn-outline-primary">
                                    <i class="fas fa-search"></i> Abrir Revisión / Verificación
                                </a>
                                @if (puedeDerivarAsignacionInspector)
                                {
                                    <a href="@urlAsignarInspectorDetalle" class="btn btn-sm btn-outline-secondary">
                                        <i class="fas fa-user-check"></i> Asignar inspector
                                    </a>
                                }
                            </div>
                        </div>
                    }

                    @if (mostrarBloqueCoordinacionDetalle)
                    {
                        <div class="role-panel">
                            <div class="role-panel-head">
                                <div>
                                    <h3 class="role-panel-title">Coordinación y jefatura</h3>
                                    <p class="role-panel-copy">Decisiones institucionales y transiciones de alto nivel para esta inspección.</p>
                                </div>
                                <span class="status-pill primary"><i class="fas fa-user-shield"></i> Coordinación</span>
                            </div>
                            <div class="button-flow">
                                @if (puedeVerificacion)
                                {
                                    using (Html.BeginForm("CambiarEstado", "Inspeccion", FormMethod.Post))
                                    {
                                        @Html.AntiForgeryToken()
                                        @Html.Hidden("id", Model.CodigoInspeccion)
                                        @Html.Hidden("estado", EstadosInspeccion.VERIFICACION_SOLICITUD)
                                        <button type="submit" class="btn btn-outline-primary">Verificacion</button>
                                    }
                                }
                                @if (puedeAceptarSolicitud)
                                {
                                    using (Html.BeginForm("CambiarEstado", "Inspeccion", FormMethod.Post))
                                    {
                                        @Html.AntiForgeryToken()
                                        @Html.Hidden("id", Model.CodigoInspeccion)
                                        @Html.Hidden("estado", EstadosInspeccion.ACEPTADA)
                                        <button type="submit" class="btn btn-outline-success">Aceptar solicitud</button>
                                    }
                                }
                                @if (puedeObservar)
                                {
                                    using (Html.BeginForm("CambiarEstado", "Inspeccion", FormMethod.Post))
                                    {
                                        @Html.AntiForgeryToken()
                                        @Html.Hidden("id", Model.CodigoInspeccion)
                                        @Html.Hidden("estado", EstadosInspeccion.OBSERVADA)
                                        <button type="submit" class="btn btn-outline-danger">Observar</button>
                                    }
                                }
                                @if (puedeSubsanada)
                                {
                                    using (Html.BeginForm("CambiarEstado", "Inspeccion", FormMethod.Post))
                                    {
                                        @Html.AntiForgeryToken()
                                        @Html.Hidden("id", Model.CodigoInspeccion)
                                        @Html.Hidden("estado", EstadosInspeccion.SUBSANADA)
                                        <button type="submit" class="btn btn-outline-warning">Subsanada</button>
                                    }
                                }
                                @if (puedeCerrar)
                                {
                                    using (Html.BeginForm("CambiarEstado", "Inspeccion", FormMethod.Post))
                                    {
                                        @Html.AntiForgeryToken()
                                        @Html.Hidden("id", Model.CodigoInspeccion)
                                        @Html.Hidden("estado", EstadosInspeccion.CERRADA)
                                        <button type="submit" class="btn btn-outline-dark">Cerrar</button>
                                    }
                                }
                            </div>
                            @if (!hayAccionesCoordinacionDisponibles)
                            {
                                <small class="text-muted d-block mt-2">No hay transiciones habilitadas para este bloque desde el estado actual (@estadoActualNormalizado).</small>
                            }
                        </div>
                    }

                    @if (mostrarBloqueInspectorDetalle)
                    {
                        <div class="role-panel">
                            <div class="role-panel-head">
                                <div>
                                    <h3 class="role-panel-title">Operación de inspector</h3>
                                    <p class="role-panel-copy">Acciones disponibles para ejecución operativa y documentación técnica del inspector.</p>
                                </div>
                                <span class="status-pill warning"><i class="fas fa-user-check"></i> Inspector</span>
                            </div>
                            <div class="button-flow">
                                @if (puedeIniciarInspeccion)
                                {
                                    using (Html.BeginForm("CambiarEstado", "Inspeccion", FormMethod.Post))
                                    {
                                        @Html.AntiForgeryToken()
                                        @Html.Hidden("id", Model.CodigoInspeccion)
                                        @Html.Hidden("estado", EstadosInspeccion.EN_INSPECCION)
                                        <button type="submit" class="btn btn-outline-warning">Iniciar inspeccion</button>
                                    }
                                }
                                @if (puedeInformeElaborado)
                                {
                                    using (Html.BeginForm("CambiarEstado", "Inspeccion", FormMethod.Post))
                                    {
                                        @Html.AntiForgeryToken()
                                        @Html.Hidden("id", Model.CodigoInspeccion)
                                        @Html.Hidden("estado", EstadosInspeccion.INFORME_ELABORADO)
                                        <button type="submit" class="btn btn-outline-info">Informe elaborado</button>
                                    }
                                }
                                @if (puedeObservacionDocumental)
                                {
                                    using (Html.BeginForm("CambiarEstado", "Inspeccion", FormMethod.Post))
                                    {
                                        @Html.AntiForgeryToken()
                                        @Html.Hidden("id", Model.CodigoInspeccion)
                                        @Html.Hidden("estado", EstadosInspeccion.OBSERVACION_DOCUMENTAL)
                                        <button type="submit" class="btn btn-outline-danger">Observacion documental</button>
                                    }
                                }
                            </div>
                            @if (!hayAccionesInspectorDisponibles)
                            {
                                <small class="text-muted d-block mt-2">@mensajeInspectorSinAcciones</small>
                            }
                        </div>
                    }

                    </div>

                </div>
            </div>

            <div class="card section-card soft-card">
                <div class="card-body">
                    <div class="section-heading">
                        <div class="section-icon">
                            <i class="fas fa-file-pdf"></i>
                        </div>
                        <div>
                            <h2 class="section-title">Informe tecnico</h2>
                            <p class="section-copy">Redacción estructurada del informe, generación automática del PDF y flujo formal de firma digital hasta DIRDAC.</p>
                        </div>
                    </div>

                    @if (puedeEditarInformeTecnico)
                    {
                        using (Html.BeginForm("GuardarInformeTecnico", "Inspeccion", FormMethod.Post, new { @class = "mb-4" }))
                        {
                            @Html.AntiForgeryToken()
                            @Html.Hidden("id", Model.CodigoInspeccion)
                            @Html.Hidden("titulo", string.IsNullOrWhiteSpace(informeTecnico != null ? informeTecnico.Titulo : null) ? "Informe de inspeccion" : informeTecnico.Titulo)

                            <div class="report-shell">
                                <div class="report-module">
                                    <div class="report-module-head">
                                        <div>
                                            <h3 class="report-module-title">A. Datos base del informe</h3>
                                            <p class="report-module-copy">Identificación del informe, operador inspeccionado y parámetros base del documento técnico.</p>
                                        </div>
                                        <span class="report-module-badge">Base</span>
                                    </div>
                                    <div class="report-grid-2">
                                        <div class="detail-item">
                                            <label class="detail-label">Orden de inspección</label>
                                            <input type="text" class="form-control" value="@numeroInspeccionVisual" readonly />
                                        </div>
                                        <div class="detail-item">
                                            <label class="detail-label">Operador inspeccionado</label>
                                            <input type="text" class="form-control" value="@operadorInspeccionado" readonly />
                                        </div>
                                        <div class="detail-item">
                                            <label class="detail-label">Inspector DGAC</label>
                                            <input type="text" class="form-control" value="@inspectorPrincipal" readonly />
                                        </div>
                                        <div class="detail-item">
                                            <label class="detail-label">Fecha programada</label>
                                            <input type="text" class="form-control" value="@fechaProgramada" readonly />
                                        </div>
                                        <div class="detail-item">
                                            <label class="detail-label">No. licencia inspector</label>
                                            <input type="text" class="form-control" name="numeroLicenciaInspector" value="@numeroLicenciaInspector" placeholder="Licencia o identificacion del inspector" />
                                        </div>
                                        <div class="detail-item">
                                            <label class="detail-label">Resultado tecnico</label>
                                            <select name="resultado" class="form-control result-select" required>
                                                <option value="" @(string.IsNullOrWhiteSpace(informeTecnico != null ? informeTecnico.Resultado : null) ? "selected" : null) disabled>Seleccione</option>
                                                <option value="SATISFACTORIO" @(string.Equals(informeTecnico != null ? informeTecnico.Resultado : null, "SATISFACTORIO", System.StringComparison.OrdinalIgnoreCase) ? "selected" : null)>Satisfactorio</option>
                                                <option value="NO_SATISFACTORIO" @(string.Equals(informeTecnico != null ? informeTecnico.Resultado : null, "NO_SATISFACTORIO", System.StringComparison.OrdinalIgnoreCase) ? "selected" : null)>Insatisfactorio</option>
                                                <option value="OBSERVACION_DOCUMENTAL" @(string.Equals(informeTecnico != null ? informeTecnico.Resultado : null, "OBSERVACION_DOCUMENTAL", System.StringComparison.OrdinalIgnoreCase) ? "selected" : null)>Observacion documental</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>

                                <div class="report-module">
                                    <div class="report-module-head">
                                        <div>
                                            <h3 class="report-module-title">B. Contexto técnico</h3>
                                            <p class="report-module-copy">Descripción del trabajo realizado y contexto operativo del anexo técnico.</p>
                                        </div>
                                        <span class="report-module-badge">Contexto</span>
                                    </div>
                                    <div class="mb-3">
                                        <label class="detail-label">1. Trabajos realizados</label>
                                        <textarea class="form-control" name="trabajosRealizados" rows="5" placeholder="Redacte el cuerpo del numeral 1 del anexo: fecha, estaciones inspeccionadas, compañía verificada, facilidades, personal técnico y alcance de la verificación.">@trabajosRealizadosInforme</textarea>
                                        <div class="inspection-doc-note">Este bloque alimenta el párrafo principal del anexo antes de la matriz UIO / GYE / MEC / LTX.</div>
                                    </div>
                                    <div class="report-grid-2">
                                        <div class="detail-item">
                                            <label class="detail-label">Operación comercial</label>
                                            <input type="text" class="form-control" name="operacionComercial" value="@operacionComercialInforme" placeholder="Operación comercial de la compañía inspeccionada" />
                                        </div>
                                        <div class="detail-item">
                                            <label class="detail-label">Anexo</label>
                                            <input type="text" class="form-control" value="ANEXO 1 - INFORME DE INSPECCIÓN" readonly />
                                        </div>
                                    </div>
                                </div>

                                <div class="report-module">
                                    <div class="report-module-head">
                                        <div>
                                            <h3 class="report-module-title">C. Cuadrícula de cumplimiento / verificación</h3>
                                            <p class="report-module-copy">Matriz de servicios y responsabilidades verificadas por estación.</p>
                                        </div>
                                        <span class="report-module-badge">Cobertura</span>
                                    </div>
                                    <label class="detail-label">Cobertura por estación</label>
                                    <input type="hidden" name="serviciosEstacionesPresent" value="true" />
                                    <div class="table-responsive table-shell">
                                        <table class="table table-bordered inspection-services-table">
                                            <thead>
                                                <tr>
                                                    <th>Servicio / responsabilidad</th>
                                                    <th class="text-center">UIO</th>
                                                    <th class="text-center">GYE</th>
                                                    <th class="text-center">MEC</th>
                                                    <th class="text-center">LTX</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var fila in serviciosEstacionesInforme)
                                                {
                                                    <tr>
                                                        <td>@fila.Label</td>
                                                        <td><input type="checkbox" class="service-check" name="@("servicio_" + fila.Key + "_uio")" value="X" @(!string.IsNullOrWhiteSpace(fila.Uio) ? "checked" : null) /></td>
                                                        <td><input type="checkbox" class="service-check" name="@("servicio_" + fila.Key + "_gye")" value="X" @(!string.IsNullOrWhiteSpace(fila.Gye) ? "checked" : null) /></td>
                                                        <td><input type="checkbox" class="service-check" name="@("servicio_" + fila.Key + "_mec")" value="X" @(!string.IsNullOrWhiteSpace(fila.Mec) ? "checked" : null) /></td>
                                                        <td><input type="checkbox" class="service-check" name="@("servicio_" + fila.Key + "_ltx")" value="X" @(!string.IsNullOrWhiteSpace(fila.Ltx) ? "checked" : null) /></td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>

                                <div class="report-module">
                                    <div class="report-module-head">
                                        <div>
                                            <h3 class="report-module-title">D. Observaciones</h3>
                                            <p class="report-module-copy">Notas, no conformidades, conclusión técnica y recomendaciones del informe.</p>
                                        </div>
                                        <span class="report-module-badge">Observación</span>
                                    </div>
                                    <div class="report-grid-2 mb-3">
                                        <div class="detail-item">
                                            <label class="detail-label">Notas</label>
                                            <textarea class="form-control" name="notas" rows="5" placeholder="Ingrese una nota por línea para que se muestre como viñeta en el PDF.">@notasInforme</textarea>
                                        </div>
                                        <div class="detail-item">
                                            <label class="detail-label">No conformidades</label>
                                            <textarea class="form-control" name="noConformidades" rows="5" placeholder="Ingrese una no conformidad por línea.">@noConformidadesInforme</textarea>
                                        </div>
                                    </div>
                                    <div class="mb-3">
                                        <label class="detail-label">2. Conclusión</label>
                                        <textarea class="form-control" name="conclusiones" rows="3" placeholder="Describa la conclusión del informe técnico.">@(informeTecnico != null ? informeTecnico.Conclusiones : string.Empty)</textarea>
                                    </div>
                                    <div>
                                        <label class="detail-label">3. Recomendaciones</label>
                                        <textarea class="form-control" name="recomendaciones" rows="4" placeholder="Ingrese una recomendación por línea.">@(informeTecnico != null ? informeTecnico.Recomendaciones : string.Empty)</textarea>
                                    </div>
                                </div>

                                <div class="report-module">
                                    <div class="report-module-head">
                                        <div>
                                            <h3 class="report-module-title">E. Documentos adjuntos</h3>
                                            <p class="report-module-copy">Selección de anexos base y documentos adicionales que acompañan el PDF técnico.</p>
                                        </div>
                                        <span class="report-module-badge">Adjuntos</span>
                                    </div>
                                    <label class="detail-label">Documentos adjuntos</label>
                                    <input type="hidden" name="documentosAdjuntosPresent" value="true" />
                                    <div class="inspection-checklist mb-3">
                                        @foreach (var adjunto in documentosAdjuntosBase)
                                        {
                                            var estaSeleccionado = documentosAdjuntosSeleccionados.Any(item => string.Equals(item, adjunto, System.StringComparison.OrdinalIgnoreCase));
                                            <label class="inspection-check">
                                                <input type="checkbox" name="documentosAdjuntos" value="@adjunto" @(estaSeleccionado ? "checked" : null) />
                                                <div>
                                                    <strong>@adjunto</strong>
                                                    <span>Se mostrará en la hoja de adjuntos del PDF.</span>
                                                </div>
                                            </label>
                                        }
                                    </div>
                                    <div>
                                        <label class="detail-label">Otros documentos adjuntos</label>
                                        <textarea class="form-control" name="otrosAdjuntos" rows="3" placeholder="Ingrese otros documentos, uno por línea.">@otrosAdjuntosInforme</textarea>
                                    </div>
                                </div>

                                <div class="report-module">
                                    <div class="report-module-head">
                                        <div>
                                            <h3 class="report-module-title">F. Acciones</h3>
                                            <p class="report-module-copy">Gestione el borrador o cierre la edición para generar el PDF del informe técnico.</p>
                                        </div>
                                        <span class="report-module-badge">Acciones</span>
                                    </div>
                                    <div class="report-actions-bar">
                                        <p class="report-actions-copy">El documento PDF se genera automáticamente al finalizar el informe con la información consolidada en esta sección.</p>
                                        <div class="report-actions-buttons">
                                            <button type="submit" class="btn btn-outline-primary">Guardar borrador</button>
                                            <button type="submit" class="btn btn-primary" name="finalizar" value="true">Finalizar informe y generar PDF</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    }

                    @if (tieneInforme)
                    {
                        <div class="report-pdf-bar d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-3">
                            <div>
                                <span class="report-pdf-title">Documento disponible para revisión / firma</span>
                                <div class="report-pdf-path">@rutaInformeVisual</div>
                            </div>
                            <a class="btn btn-ver-pdf"
                               href="@Url.Action("VerInforme", "Inspeccion", new { id = Model.CodigoInspeccion })"
                               target="_blank" rel="noopener">
                                Ver PDF
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-light alert-inline mb-3">Aún no hay informe cargado para esta inspección.</div>
                    }

                    <div class="alert alert-info alert-inline mb-0">
                        El informe PDF se genera automáticamente al finalizar el informe. La firma digital se aplica después sobre ese PDF, sin modificar la generación base.
                    </div>

                    @if (informeTecnico != null)
                    {
                        <div class="alert alert-light alert-inline mt-3 mb-0">
                            <strong>Versión actual del informe:</strong> @informeTecnico.Version
                            <span class="ms-3"><strong>Estado documento:</strong> @estadoInformeTecnico</span>
                            <span class="ms-3"><strong>DIRDAC:</strong> @(notificacionFormalDirdac ? "Notificado" : (informeEnviadoADirdac ? "En bandeja / correo pendiente" : "Pendiente"))</span>
                            <span class="ms-3"><strong>Firma inspector:</strong> @(informeTecnico.FirmadoInspector ? "Aplicada" : "Pendiente")</span>
                            <span class="ms-3"><strong>Firma DIRDAC:</strong> @(informeTecnico.FirmadoDirdac ? "Aplicada" : "Pendiente")</span>
                        </div>

                        if (puedeReintentarNotificacionDirdac)
                        {
                            <div class="alert alert-warning alert-inline mt-3 mb-0">
                                El documento ya fue transferido a la bandeja de DIRDAC, pero la notificación formal por correo sigue pendiente. Puede reintentar el envío sin duplicar la transición de estado.
                            </div>
                        }

                        <div class="detail-grid mt-3">
                            <div class="detail-item">
                                <span class="detail-label">Hash del documento</span>
                                <div class="detail-value">@(!string.IsNullOrWhiteSpace(informeTecnico.HashDocumento) ? informeTecnico.HashDocumento : "Pendiente")</div>
                            </div>
                            <div class="detail-item">
                                <span class="detail-label">Inspector firmante</span>
                                <div class="detail-value">@(!string.IsNullOrWhiteSpace(informeTecnico.UsuarioFirma1) ? informeTecnico.UsuarioFirma1 : "Pendiente")</div>
                            </div>
                            <div class="detail-item">
                                <span class="detail-label">Fecha firma inspector</span>
                                <div class="detail-value">@(informeTecnico.FechaFirma1.HasValue ? informeTecnico.FechaFirma1.Value.ToString("yyyy-MM-dd HH:mm") : "Pendiente")</div>
                            </div>
                            <div class="detail-item">
                                <span class="detail-label">Fecha envío DIRDAC</span>
                                <div class="detail-value">@(informeTecnico.FechaEnvioDirdac.HasValue ? informeTecnico.FechaEnvioDirdac.Value.ToString("yyyy-MM-dd HH:mm") : "Pendiente")</div>
                            </div>
                            <div class="detail-item">
                                <span class="detail-label">Usuario envío DIRDAC</span>
                                <div class="detail-value">@(!string.IsNullOrWhiteSpace(informeTecnico.UsuarioEnvioDirdac) ? informeTecnico.UsuarioEnvioDirdac : "Pendiente")</div>
                            </div>
                            <div class="detail-item">
                                <span class="detail-label">Firmante DIRDAC</span>
                                <div class="detail-value">@(!string.IsNullOrWhiteSpace(informeTecnico.UsuarioFirma2) ? informeTecnico.UsuarioFirma2 : "Pendiente")</div>
                            </div>
                            <div class="detail-item">
                                <span class="detail-label">Fecha firma DIRDAC</span>
                                <div class="detail-value">@(informeTecnico.FechaFirma2.HasValue ? informeTecnico.FechaFirma2.Value.ToString("yyyy-MM-dd HH:mm") : "Pendiente")</div>
                            </div>
                        </div>

                        if (puedeFirmarInspector)
                        {
                            using (Html.BeginForm("FirmarInformeInspector", "Inspeccion", FormMethod.Post, new { enctype = "multipart/form-data", @class = "upload-panel mt-3" }))
                            {
                                @Html.AntiForgeryToken()
                                @Html.Hidden("id", Model.CodigoInspeccion)
                                @Html.Hidden("UsaPosicionFirmaPersonalizadaInspector", inspectorFirmaUsaPosicionPersonalizada, new { id = "UsaPosicionFirmaPersonalizadaInspector" })
                                @Html.Hidden("NumeroPaginaFirmaInspector", inspectorFirmaNumeroPagina, new { id = "NumeroPaginaFirmaInspector" })
                                @Html.Hidden("PosicionFirmaXInspector", inspectorFirmaPosicionX, new { id = "PosicionFirmaXInspector" })
                                @Html.Hidden("PosicionFirmaYInspector", inspectorFirmaPosicionY, new { id = "PosicionFirmaYInspector" })
                                @Html.Hidden("AnchoFirmaInspector", inspectorFirmaAncho, new { id = "AnchoFirmaInspector" })
                                @Html.Hidden("AltoFirmaInspector", inspectorFirmaAlto, new { id = "AltoFirmaInspector" })
                                <div class="compact-form">
                                    <div class="form-field">
                                        <label>Certificado inspector (.p12 / .pfx)</label>
                                        <input type="file" name="CertificadoInspector" class="form-control" accept=".p12,.pfx" required />
                                    </div>
                                    <div class="form-field">
                                        <label>Contraseña del certificado</label>
                                        <input type="password" name="passwordCertificado" class="form-control" autocomplete="off" required />
                                    </div>
                                    <div>
                                        <button type="submit" class="btn btn-outline-success">Firmar Informe</button>
                                    </div>
                                </div>
                                <div class="inspection-signature-config mt-3" data-signature-canvas="Inspector">
                                    <p class="inspection-doc-note mb-2">Ubique el bloque de firma del Inspector sobre la página de firmas real del informe técnico.</p>
                                    <div class="inspection-signature-stage" id="firmaPreviewStageInspector">
                                        <iframe src="@Url.Action("PreviewFirmaInformeTecnico", "Inspeccion", new { id = Model.CodigoInspeccion })" class="inspection-signature-frame" title="Vista previa firma inspector"></iframe>
                                        <div class="inspection-signature-overlay" id="firmaPreviewOverlayInspector">
                                            <div class="inspection-signature-stamp" id="firmaStampInspector">
                                                <div>QR</div>
                                                <small>Firma Inspector</small>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row g-3 mt-2 align-items-end">
                                        <div class="col-md-4">
                                            <label class="form-label">Ancho</label>
                                            <input type="range" class="form-range" id="firmaWidthRangeInspector" min="0.18" max="0.34" step="0.005" />
                                            <div class="small text-muted" id="firmaWidthValueInspector"></div>
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label">Alto</label>
                                            <input type="range" class="form-range" id="firmaHeightRangeInspector" min="0.06" max="0.14" step="0.005" />
                                            <div class="small text-muted" id="firmaHeightValueInspector"></div>
                                        </div>
                                        <div class="col-md-4 d-flex gap-2 flex-wrap justify-content-md-end">
                                            <button type="button" class="btn btn-outline-primary btn-sm" id="btnGuardarPosicionFirmaInspector">Guardar posición</button>
                                            <button type="button" class="btn btn-outline-secondary btn-sm" id="btnResetPosicionFirmaInspector">Restablecer</button>
                                        </div>
                                        <div class="col-12">
                                            <div class="alert alert-secondary mb-0" id="firmaPosicionStatusInspector">La posición inicial replica la ubicación fija actual del informe técnico.</div>
                                        </div>
                                    </div>
                                </div>
                            }
                        }

                        if (puedeEnviarADirdac || puedeReintentarNotificacionDirdac)
                        {
                            using (Html.BeginForm("EnviarADirdac", "Inspeccion", FormMethod.Post, new { @class = "mt-3" }))
                            {
                                @Html.AntiForgeryToken()
                                @Html.Hidden("id", Model.CodigoInspeccion)
                                <button type="submit" class="btn btn-outline-primary">@(puedeReintentarNotificacionDirdac ? "Reintentar notificación a Dirección" : "Enviar a Dirección")</button>
                            }
                        }

                        if (puedeFirmarDirdac)
                        {
                            using (Html.BeginForm("FirmarInformeDirdac", "Inspeccion", FormMethod.Post, new { enctype = "multipart/form-data", @class = "upload-panel mt-3" }))
                            {
                                @Html.AntiForgeryToken()
                                @Html.Hidden("id", Model.CodigoInspeccion)
                                @Html.Hidden("UsaPosicionFirmaPersonalizadaDirdac", dirdacFirmaUsaPosicionPersonalizada, new { id = "UsaPosicionFirmaPersonalizadaDirdac" })
                                @Html.Hidden("NumeroPaginaFirmaDirdac", dirdacFirmaNumeroPagina, new { id = "NumeroPaginaFirmaDirdac" })
                                @Html.Hidden("PosicionFirmaXDirdac", dirdacFirmaPosicionX, new { id = "PosicionFirmaXDirdac" })
                                @Html.Hidden("PosicionFirmaYDirdac", dirdacFirmaPosicionY, new { id = "PosicionFirmaYDirdac" })
                                @Html.Hidden("AnchoFirmaDirdac", dirdacFirmaAncho, new { id = "AnchoFirmaDirdac" })
                                @Html.Hidden("AltoFirmaDirdac", dirdacFirmaAlto, new { id = "AltoFirmaDirdac" })
                                <div class="compact-form">
                                    <div class="form-field">
                                        <label>Certificado DIRDAC (.p12 / .pfx)</label>
                                        <input type="file" name="CertificadoDirdac" class="form-control" accept=".p12,.pfx" required />
                                    </div>
                                    <div class="form-field">
                                        <label>Contraseña del certificado</label>
                                        <input type="password" name="passwordCertificado" class="form-control" autocomplete="off" required />
                                    </div>
                                    <div>
                                        <button type="submit" class="btn btn-primary">Firmar Documento (DIRDAC)</button>
                                    </div>
                                </div>
                                <div class="inspection-signature-config mt-3" data-signature-canvas="Dirdac">
                                    <p class="inspection-doc-note mb-2">Ubique el bloque de firma institucional sobre la página de firmas real del informe técnico.</p>
                                    <div class="inspection-signature-stage" id="firmaPreviewStageDirdac">
                                        <iframe src="@Url.Action("PreviewFirmaInformeTecnico", "Inspeccion", new { id = Model.CodigoInspeccion })" class="inspection-signature-frame" title="Vista previa firma DIRDAC"></iframe>
                                        <div class="inspection-signature-overlay" id="firmaPreviewOverlayDirdac">
                                            <div class="inspection-signature-stamp" id="firmaStampDirdac">
                                                <div>QR</div>
                                                <small>Firma DIRDAC</small>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row g-3 mt-2 align-items-end">
                                        <div class="col-md-4">
                                            <label class="form-label">Ancho</label>
                                            <input type="range" class="form-range" id="firmaWidthRangeDirdac" min="0.18" max="0.34" step="0.005" />
                                            <div class="small text-muted" id="firmaWidthValueDirdac"></div>
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label">Alto</label>
                                            <input type="range" class="form-range" id="firmaHeightRangeDirdac" min="0.06" max="0.14" step="0.005" />
                                            <div class="small text-muted" id="firmaHeightValueDirdac"></div>
                                        </div>
                                        <div class="col-md-4 d-flex gap-2 flex-wrap justify-content-md-end">
                                            <button type="button" class="btn btn-outline-primary btn-sm" id="btnGuardarPosicionFirmaDirdac">Guardar posición</button>
                                            <button type="button" class="btn btn-outline-secondary btn-sm" id="btnResetPosicionFirmaDirdac">Restablecer</button>
                                        </div>
                                        <div class="col-12">
                                            <div class="alert alert-secondary mb-0" id="firmaPosicionStatusDirdac">La posición inicial replica la ubicación fija actual del informe técnico.</div>
                                        </div>
                                    </div>
                                </div>
                            }
                        }

                        if (esDirdac)
                        {
                            <div class="action-footer mt-3">
                                <a class="btn btn-outline-dark" href="@Url.Action("PendientesFirmaDirdac", "Inspeccion")">Ver documentos pendientes DIRDAC</a>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>

        <div class="action-grid mt-4">
            <div class="card section-card">
                <div class="card-body">
                    <div class="section-heading">
                        <div class="section-icon">
                            <i class="fas fa-wallet"></i>
                        </div>
                        <div>
                            <h2 class="section-title">Viáticos</h2>
                            <p class="section-copy">Solicitud y validación financiera vinculada al proceso de inspección.</p>
                        </div>
                    </div>

                    @if (puedeSolicitarViaticos)
                    {
                        using (Html.BeginForm("SolicitarViaticos", "Inspeccion", FormMethod.Post, new { @class = "compact-form mb-3" }))
                        {
                            @Html.AntiForgeryToken()
                            @Html.Hidden("id", Model.CodigoInspeccion)
                            <div class="form-field">
                                <label>Monto</label>
                                <input type="number" step="0.01" min="0" name="monto" class="form-control" value="@(Model.ViaticosMonto.HasValue ? Model.ViaticosMonto.Value.ToString("0.00") : "")" />
                            </div>
                            <div class="form-field">
                                <label>Observación</label>
                                <input type="text" name="observacion" class="form-control" placeholder="Observación de viáticos" />
                            </div>
                            <div>
                                <button class="btn btn-outline-warning" type="submit">Solicitar viáticos</button>
                            </div>
                        }
                    }

                    @if (puedeValidarViaticos)
                    {
                        using (Html.BeginForm("ValidarPagoViaticos", "Inspeccion", FormMethod.Post, new { @class = "compact-form" }))
                        {
                            @Html.AntiForgeryToken()
                            @Html.Hidden("id", Model.CodigoInspeccion)
                            <div class="form-field">
                                <label>Observación de validación</label>
                                <input type="text" name="observacion" class="form-control" placeholder="Observación de validación" />
                            </div>
                            <div>
                                <button class="btn btn-outline-success" type="submit">Validar pago viáticos</button>
                            </div>
                        }
                    }
                </div>
            </div>

            <div class="card section-card soft-card">
                <div class="card-body">
                    <div class="section-heading">
                        <div class="section-icon">
                            <i class="fas fa-check-double"></i>
                        </div>
                        <div>
                            <h2 class="section-title">Resultado de inspección</h2>
                            <p class="section-copy">Registro formal del resultado técnico y cierre de evaluación.</p>
                        </div>
                    </div>

                    @if (puedeRegistrarResultado)
                    {
                        using (Html.BeginForm("RegistrarResultado", "Inspeccion", FormMethod.Post, new { @class = "compact-form" }))
                        {
                            @Html.AntiForgeryToken()
                            @Html.Hidden("id", Model.CodigoInspeccion)
                            <div class="form-field">
                                <label>Resultado</label>
                                <select name="resultado" class="form-control result-select" required>
                                    <option value="" selected disabled>Seleccione</option>
                                    <option value="SATISFACTORIO">Satisfactorio</option>
                                    <option value="NO_SATISFACTORIO">No satisfactorio</option>
                                </select>
                            </div>
                            <div class="form-field">
                                <label>Observación</label>
                                <input type="text" name="observacion" class="form-control" placeholder="Observación del resultado" />
                            </div>
                            <div>
                                <button class="btn btn-outline-primary" type="submit">Registrar resultado</button>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>

        <div class="action-grid mt-4">
            <div class="card section-card soft-card">
                <div class="card-body">
                    <div class="section-heading">
                        <div class="section-icon">
                            <i class="fas fa-stream"></i>
                        </div>
                        <div>
                            <h2 class="section-title">Historial de estados</h2>
                            <p class="section-copy">Trazabilidad completa de transiciones BPMN, origen y observaciones de cada movimiento.</p>
                        </div>
                    </div>

                    @if (historialLista.Any())
                    {
                        <div class="timeline-list">
                            @foreach (var item in historialLista)
                            {
                                <div class="timeline-item">
                                    <div class="timeline-meta">
                                        <span><strong>@item.FechaCambio.ToString("yyyy-MM-dd HH:mm")</strong></span>
                                        <span>@(string.IsNullOrWhiteSpace(item.UsuarioNombre) ? "Sistema" : item.UsuarioNombre)</span>
                                        <span>@(string.IsNullOrWhiteSpace(item.Origen) ? "FLUJO" : item.Origen)</span>
                                    </div>
                                    <div class="detail-value">@(!string.IsNullOrWhiteSpace(item.EstadoAnterior) ? item.EstadoAnterior : "SIN ESTADO") <i class="fas fa-arrow-right text-muted mx-1"></i> @item.EstadoNuevo</div>
                                    @if (!string.IsNullOrWhiteSpace(item.Observacion))
                                    {
                                        <div class="text-muted mt-2">@item.Observacion</div>
                                    }
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-light alert-inline mb-0">Todavía no existen eventos de transición registrados para esta inspección.</div>
                    }
                </div>
            </div>

            <div class="card section-card">
                <div class="card-body">
                    <div class="section-heading">
                        <div class="section-icon">
                            <i class="fas fa-file-upload"></i>
                        </div>
                        <div>
                            <h2 class="section-title">Subsanación y documentos</h2>
                            <p class="section-copy">Versionado de documentos corregidos y revisión del solicitante sobre observaciones documentales.</p>
                        </div>
                    </div>

                    @if (esSolicitante)
                    {
                        <div class="alert alert-inline mb-3">
                            Revise el informe final, atienda las observaciones registradas y cargue una nueva versión del documento requerido.
                        </div>
                    }

                    @if (documentosLista.Any())
                    {
                        <div class="table-responsive doc-table mb-3">
                            <table class="table table-hover mb-0">
                                <thead>
                                    <tr>
                                        <th>Tipo</th>
                                        <th>Versión</th>
                                        <th>Archivo</th>
                                        <th>Rol</th>
                                        <th>Observación</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var doc in documentosLista)
                                    {
                                        <tr>
                                            <td>@(doc.TipoDocumento ?? "-")</td>
                                            <td>v@doc.Version</td>
                                            <td>
                                                @if (!string.IsNullOrWhiteSpace(doc.RutaArchivo))
                                                {
                                                    <a href="@Url.Action("VerDocumentoSolicitante", "Inspeccion", new { documentoId = doc.CodigoDocumento })" target="_blank" rel="noopener">@(doc.NombreArchivoOriginal ?? doc.NombreArchivoStorage)</a>
                                                }
                                                else
                                                {
                                                    @:(sin ruta)
                                                }
                                            </td>
                                            <td>@(doc.SubidoPorRol ?? "-")</td>
                                            <td>@(doc.Observacion ?? "-")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-light alert-inline mb-3">No existen documentos versionados para esta inspección.</div>
                    }

                    <div class="alert alert-info alert-inline mb-0">
                        El PDF del informe técnico se genera automáticamente al guardar/finalizar el informe.
                    </div>
                </div>
            </div>
        </div>

        <div class="card section-card mt-4">
            <div class="card-body">
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-3">
                    <div class="section-heading mb-0">
                        <div class="section-icon">
                            <i class="fas fa-search"></i>
                        </div>
                        <div>
                            <h2 class="section-title">Hallazgos</h2>
                            <p class="section-copy">Registro de novedades, severidad y estado de seguimiento de cada hallazgo.</p>
                        </div>
                    </div>

                    @if (puedeRegistrarHallazgo)
                    {
                        <button class="btn btn-warning" type="button" data-bs-toggle="modal" data-bs-target="#modalHallazgo">
                            <i class="fas fa-plus-circle"></i>
                            Registrar hallazgo
                        </button>
                    }
                </div>

                <div class="table-responsive hallazgos-table">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Severidad</th>
                                <th>Descripción</th>
                                <th>Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (hallazgosLista.Any())
                            {
                                foreach (var h in hallazgosLista)
                                {
                                    <tr>
                                        <td>@(h.Criticidad ?? "-")</td>
                                        <td>@(h.Descripcion ?? "-")</td>
                                        <td>@(h.Estado ?? "-")</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="3" class="hallazgos-empty">No hay hallazgos registrados para esta inspección.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="action-footer">
            @if (puedePlanificar)
            {
                <a class="btn btn-primary"
                   href="@Url.Action("Planificacion", "Inspeccion", new { id = Model.CodigoInspeccion })">
                    <i class="fas fa-calendar-alt"></i>
                    Planificar inspección
                </a>
            }

            @if (mostrarAccionesCierreDetalle && puedeCerrar)
            {
                using (Html.BeginForm("Cerrar", "Inspeccion", FormMethod.Post, new { @class = "button-flow" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.Hidden("id", Model.CodigoInspeccion)
                    <button type="submit" name="resultado" value="APROBADO" class="btn btn-success">Aprobar</button>
                    <button type="submit" name="resultado" value="RECHAZADO" class="btn btn-danger">Rechazar</button>
                }
            }
            else if (puedeGestionarCoordinacion && !esInspector && puedeCerrar)
            {
                <div class="alert alert-info mb-0" role="alert">
                    El cierre institucional de esta inspeccion se ejecuta desde
                    <a href="@Url.Action("RevisionVerificacion", "CoordinacionJefatura")" class="alert-link">Direccion / Jefatura</a>
                    para mantener una sola bandeja de decision y trazabilidad.
                </div>
            }
        </div>
    </div>
</div>

<script>
    (function () {
        var widgets = document.querySelectorAll('[data-signature-canvas]');
        if (!widgets.length) {
            return;
        }

        var style = document.createElement('style');
        style.textContent = '.inspection-signature-stage{position:relative;max-width:480px;width:100%;aspect-ratio:210/297;border:1px solid rgba(27,79,114,.18);border-radius:16px;overflow:hidden;background:#f2f5f8}.inspection-signature-frame{width:100%;height:100%;border:0;background:#fff}.inspection-signature-overlay{position:absolute;inset:0;cursor:crosshair}.inspection-signature-stamp{position:absolute;left:0;top:0;border:2px dashed #0d6efd;background:rgba(13,110,253,.12);border-radius:10px;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;color:#0d3b8c;font-size:11px;font-weight:700;user-select:none;cursor:move;box-shadow:0 8px 18px rgba(13,110,253,.18)}.inspection-signature-stamp small{font-size:10px;font-weight:500}';
        document.head.appendChild(style);

        function clamp(value, min, max) {
            return Math.max(min, Math.min(max, value));
        }

        function initWidget(container) {
            var suffix = container.getAttribute('data-signature-canvas');
            var stage = document.getElementById('firmaPreviewStage' + suffix);
            var stamp = document.getElementById('firmaStamp' + suffix);
            var saveButton = document.getElementById('btnGuardarPosicionFirma' + suffix);
            var resetButton = document.getElementById('btnResetPosicionFirma' + suffix);
            var status = document.getElementById('firmaPosicionStatus' + suffix);
            var widthRange = document.getElementById('firmaWidthRange' + suffix);
            var heightRange = document.getElementById('firmaHeightRange' + suffix);
            var widthValue = document.getElementById('firmaWidthValue' + suffix);
            var heightValue = document.getElementById('firmaHeightValue' + suffix);
            var useCustomField = document.getElementById('UsaPosicionFirmaPersonalizada' + suffix);
            var pageField = document.getElementById('NumeroPaginaFirma' + suffix);
            var xField = document.getElementById('PosicionFirmaX' + suffix);
            var yField = document.getElementById('PosicionFirmaY' + suffix);
            var widthField = document.getElementById('AnchoFirma' + suffix);
            var heightField = document.getElementById('AltoFirma' + suffix);
            var form = container.closest('form');
            if (!stage || !stamp || !form || !xField || !yField || !widthField || !heightField) {
                return;
            }

            var defaultState = {
                x: parseFloat(xField.value || '0.655462'),
                y: parseFloat(yField.value || '0.209026'),
                width: parseFloat(widthField.value || '0.248739'),
                height: parseFloat(heightField.value || '0.106888')
            };
            var dragState = null;

            function showStatus(css, message) {
                if (!status) {
                    return;
                }
                status.className = 'alert mb-0 ' + css;
                status.textContent = message;
            }

            function readState() {
                return {
                    x: clamp(parseFloat(xField.value || defaultState.x), 0, 0.95),
                    y: clamp(parseFloat(yField.value || defaultState.y), 0, 0.95),
                    width: clamp(parseFloat(widthField.value || defaultState.width), parseFloat(widthRange.min), parseFloat(widthRange.max)),
                    height: clamp(parseFloat(heightField.value || defaultState.height), parseFloat(heightRange.min), parseFloat(heightRange.max))
                };
            }

            function writeState(state, markCustom) {
                if (useCustomField && markCustom) {
                    useCustomField.value = 'true';
                }
                if (pageField) {
                    pageField.value = '2';
                }
                xField.value = state.x.toFixed(6);
                yField.value = state.y.toFixed(6);
                widthField.value = state.width.toFixed(6);
                heightField.value = state.height.toFixed(6);
                widthRange.value = state.width.toFixed(6);
                heightRange.value = state.height.toFixed(6);
                widthValue.textContent = 'Ancho relativo: ' + Math.round(state.width * 100) + '%';
                heightValue.textContent = 'Alto relativo: ' + Math.round(state.height * 100) + '%';
            }

            function renderStamp() {
                var state = readState();
                var rect = stage.getBoundingClientRect();
                var widthPx = rect.width * state.width;
                var heightPx = rect.height * state.height;
                var leftPx = clamp(rect.width * state.x, 0, rect.width - widthPx);
                var topPx = clamp(rect.height * state.y, 0, rect.height - heightPx);
                stamp.style.width = widthPx + 'px';
                stamp.style.height = heightPx + 'px';
                stamp.style.left = leftPx + 'px';
                stamp.style.top = topPx + 'px';
            }

            function placeFromPointer(clientX, clientY) {
                var rect = stage.getBoundingClientRect();
                var state = readState();
                var widthPx = rect.width * state.width;
                var heightPx = rect.height * state.height;
                var leftPx = clamp(clientX - rect.left - (widthPx / 2), 0, rect.width - widthPx);
                var topPx = clamp(clientY - rect.top - (heightPx / 2), 0, rect.height - heightPx);
                state.x = leftPx / rect.width;
                state.y = topPx / rect.height;
                writeState(state, true);
                renderStamp();
                showStatus('alert-info', 'Posición actualizada. Puede guardarla o firmar directamente con esta ubicación.');
            }

            function savePosition() {
                var data = new FormData();
                data.append('__RequestVerificationToken', form.querySelector('input[name="__RequestVerificationToken"]').value);
                data.append('id', form.querySelector('input[name="id"]').value);
                data.append('rolFirmaVisual', suffix === 'Dirdac' ? 'INFORME_TECNICO_DIRDAC' : 'INFORME_TECNICO_INSPECTOR');
                data.append('numeroPaginaFirma', pageField ? pageField.value : '2');
                data.append('posicionFirmaX', xField.value);
                data.append('posicionFirmaY', yField.value);
                data.append('anchoFirma', widthField.value);
                data.append('altoFirma', heightField.value);
                if (useCustomField) {
                    useCustomField.value = 'true';
                }

                showStatus('alert-info', 'Guardando posición de firma...');

                fetch('@Url.Action("GuardarPosicionFirmaInformeTecnico", "Inspeccion")', {
                    method: 'POST',
                    body: data,
                    credentials: 'same-origin'
                })
                .then(function (response) {
                    return response.json().then(function (json) {
                        if (!response.ok || !json.ok) {
                            throw new Error(json.mensaje || 'No se pudo guardar la posición de firma.');
                        }
                        return json;
                    });
                })
                .then(function (json) {
                    showStatus('alert-success', json.mensaje || 'La posición de firma fue guardada.');
                })
                .catch(function (error) {
                    showStatus('alert-danger', error.message || 'No se pudo guardar la posición de firma.');
                });
            }

            stage.addEventListener('click', function (event) {
                if (dragState && dragState.moved) {
                    dragState = null;
                    return;
                }

                if (event.target === stamp || stamp.contains(event.target)) {
                    return;
                }

                placeFromPointer(event.clientX, event.clientY);
            });

            stamp.addEventListener('mousedown', function (event) {
                event.preventDefault();
                var stampRect = stamp.getBoundingClientRect();
                dragState = {
                    offsetX: event.clientX - stampRect.left,
                    offsetY: event.clientY - stampRect.top,
                    moved: false
                };
            });

            document.addEventListener('mousemove', function (event) {
                if (!dragState) {
                    return;
                }

                dragState.moved = true;
                var rect = stage.getBoundingClientRect();
                var state = readState();
                var widthPx = rect.width * state.width;
                var heightPx = rect.height * state.height;
                var leftPx = clamp(event.clientX - rect.left - dragState.offsetX, 0, rect.width - widthPx);
                var topPx = clamp(event.clientY - rect.top - dragState.offsetY, 0, rect.height - heightPx);
                state.x = leftPx / rect.width;
                state.y = topPx / rect.height;
                writeState(state, true);
                renderStamp();
            });

            document.addEventListener('mouseup', function () {
                if (dragState && dragState.moved) {
                    showStatus('alert-info', 'Posición actualizada. Puede guardarla o firmar directamente con esta ubicación.');
                }
                dragState = null;
            });

            widthRange.addEventListener('input', function () {
                var state = readState();
                state.width = parseFloat(widthRange.value);
                writeState(state, true);
                renderStamp();
            });

            heightRange.addEventListener('input', function () {
                var state = readState();
                state.height = parseFloat(heightRange.value);
                writeState(state, true);
                renderStamp();
            });

            if (saveButton) {
                saveButton.addEventListener('click', savePosition);
            }

            if (resetButton) {
                resetButton.addEventListener('click', function () {
                    if (useCustomField) {
                        useCustomField.value = 'false';
                    }
                    writeState(defaultState, false);
                    renderStamp();
                    showStatus('alert-secondary', 'Se restableció la ubicación fija actual del informe técnico.');
                });
            }

            writeState(readState(), false);
            renderStamp();
            window.addEventListener('resize', renderStamp);
        }

        Array.prototype.forEach.call(widgets, initWidget);
    })();
</script>

<div class="modal fade" id="modalHallazgo" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Registrar hallazgo</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                @using (Html.BeginForm("RegistrarHallazgo", "Inspeccion", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    @Html.Hidden("CodigoInspeccion", Model.CodigoInspeccion)

                    <div class="mb-3">
                        <label class="form-label d-block">Severidad</label>
                        <select name="Severidad" class="form-control" required>
                            <option value="ALTA">ALTA</option>
                            <option value="MEDIA">MEDIA</option>
                            <option value="BAJA">BAJA</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label d-block">Descripción</label>
                        <textarea name="Descripcion" class="form-control" rows="3" required></textarea>
                    </div>

                    <button class="btn btn-primary" type="submit">Guardar</button>
                }
            </div>
        </div>
    </div>
</div>
