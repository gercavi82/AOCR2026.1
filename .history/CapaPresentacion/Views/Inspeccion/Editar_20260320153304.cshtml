@model CapaModelo.Inspeccion
@using System.Web.Mvc
@using System.Web.Mvc.Html

@{
    ViewBag.Title = "Editar Inspeccion";
    Layout = "~/Views/Shared/_LayoutAOCR.cshtml";
    var tipoInspectorInicial = "TODOS";
    if (Model != null && !string.IsNullOrWhiteSpace(Model.InspectorPrincipalTipo))
    {
        tipoInspectorInicial = Model.InspectorPrincipalTipo.Trim().ToUpperInvariant();
    }
    if (tipoInspectorInicial != "OPS" && tipoInspectorInicial != "AIR" && tipoInspectorInicial != "TODOS")
    {
        tipoInspectorInicial = "TODOS";
    }
}

<h2>Editar Inspeccion</h2>
<hr />

@if (Model == null)
{
    <div class="alert alert-danger">No se pudo cargar la inspeccion.</div>
    return;
}

@using (Html.BeginForm("Editar", "Inspeccion", FormMethod.Post, new { @class = "form-horizontal" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.CodigoInspeccion)
    @Html.HiddenFor(m => m.CodigoSolicitud)
    @Html.HiddenFor(m => m.InspectorPrincipalNombre, new { id = "inspectorPrincipalNombre" })
    @Html.HiddenFor(m => m.InspectorApoyoNombre, new { id = "inspectorApoyoNombre" })

    <div class="form-group">
        <label class="col-md-3 control-label">Codigo Inspeccion</label>
        <div class="col-md-4">
            <input type="text" class="form-control" value="@Model.CodigoInspeccion" readonly />
        </div>
    </div>

    <div class="form-group">
        <label class="col-md-3 control-label">Codigo Solicitud</label>
        <div class="col-md-4">
            <input type="text" class="form-control" value="@Model.CodigoSolicitud" readonly />
        </div>
    </div>

    <div class="form-group">
        <label class="col-md-3 control-label">Tipo Inspector</label>
        <div class="col-md-4">
            <select id="tipoInspectorFiltro" name="tipoInspector" class="form-control">
                <option value="OPS" @(tipoInspectorInicial == "OPS" ? "selected" : "")>Operaciones (OPS)</option>
                <option value="AIR" @(tipoInspectorInicial == "AIR" ? "selected" : "")>Aeronavegabilidad (AIR)</option>
                <option value="TODOS" @(tipoInspectorInicial == "TODOS" ? "selected" : "")>Todos (OPS + AIR)</option>
            </select>
            <small class="text-muted">Fuente: OPINSPECTORES/OPIAR2 (solo activos).</small>
        </div>
    </div>

    <div class="form-group">
        <label class="col-md-3 control-label">Inspector Principal (AS400)</label>
        <div class="col-md-6">
            <select id="inspectorPrincipalCedula"
                    name="InspectorPrincipalCedula"
                    class="form-control"
                    data-selected="@Model.InspectorPrincipalCedula">
                <option value="">-- Seleccione --</option>
            </select>
        </div>
    </div>

    <div class="form-group">
        <label class="col-md-3 control-label">Inspector Apoyo (AS400)</label>
        <div class="col-md-6">
            <select id="inspectorApoyoCedula"
                    name="InspectorApoyoCedula"
                    class="form-control"
                    data-selected="@Model.InspectorApoyoCedula">
                <option value="">-- Opcional --</option>
            </select>
        </div>
    </div>

    <div class="form-group">
        <label class="col-md-3 control-label">Codigo Inspector (legacy)</label>
        <div class="col-md-4">
            @Html.TextBoxFor(m => m.CodigoInspector, new { @class = "form-control", type = "number", min = "1", id = "codigoInspector" })
        </div>
    </div>

    <div class="form-group">
        <label class="col-md-3 control-label">Fecha Programada</label>
        <div class="col-md-4">
            @Html.TextBoxFor(m => m.FechaProgramada, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
        </div>
    </div>

    <div class="form-group">
        <label class="col-md-3 control-label">Hora Programada</label>
        <div class="col-md-4">
            @Html.TextBoxFor(m => m.HoraProgramada, "{0:hh\\:mm}", new { @class = "form-control", type = "time" })
        </div>
    </div>

    <div class="form-group">
        <label class="col-md-3 control-label">Estado</label>
        <div class="col-md-4">
            @Html.DropDownListFor(m => m.Estado, new SelectList(new[]
            {
                "SOLICITUD_INSPECCION_CREADA",
                "VERIFICACION_SOLICITUD",
                "ACEPTADA",
                "OBSERVADA",
                "SUBSANADA",
                "VIATICOS_REQUERIDOS",
                "PAGO_VALIDADO",
                "EN_INSPECCION",
                "INFORME_ELABORADO",
                "RESULTADO_SATISFACTORIO",
                "RESULTADO_NO_SATISFACTORIO",
                "OBSERVACION_DOCUMENTAL",
                "CERRADA"
            }, Model.Estado), new { @class = "form-control" })
        </div>
    </div>

    <div class="form-group">
        <label class="col-md-3 control-label">Resultado</label>
        <div class="col-md-4">
            @Html.TextBoxFor(m => m.Resultado, new { @class = "form-control" })
        </div>
    </div>

    <div class="form-group">
        <label class="col-md-3 control-label">Observaciones</label>
        <div class="col-md-8">
            @Html.TextAreaFor(m => m.ObservacionesGenerales, new { @class = "form-control", rows = "4" })
        </div>
    </div>

    <div class="form-group">
        <label class="col-md-3 control-label">Hallazgos Principales</label>
        <div class="col-md-8">
            @Html.TextAreaFor(m => m.HallazgosPrincipales, new { @class = "form-control", rows = "3" })
        </div>
    </div>

    <div class="form-group">
        <label class="col-md-3 control-label">Comentarios</label>
        <div class="col-md-8">
            @Html.TextAreaFor(m => m.Comentarios, new { @class = "form-control", rows = "3" })
        </div>
    </div>

    <div class="form-group">
        <div class="col-md-offset-3 col-md-9">
            <button type="submit" class="btn btn-primary">Guardar Cambios</button>
            <a href="@Url.Action("Detalle", "Inspeccion", new { id = Model.CodigoInspeccion })" class="btn btn-default">Cancelar</a>
        </div>
    </div>
}

@section Scripts {
    <script>
        (function waitForJQuery() {
            if (typeof window.jQuery === 'undefined') {
                setTimeout(waitForJQuery, 50);
                return;
            }

            window.jQuery(function ($) {
                var endpoint = '@Url.Action("ListarInspectoresActivos", "Tecnico")';
                var $tipo = $('#tipoInspectorFiltro');
                var $principal = $('#inspectorPrincipalCedula');
                var $apoyo = $('#inspectorApoyoCedula');
                var $principalNombre = $('#inspectorPrincipalNombre');
                var $apoyoNombre = $('#inspectorApoyoNombre');
                var $codigoInspector = $('#codigoInspector');

                function optionTemplate(item) {
                    return $('<option/>')
                        .val(item.cedula || '')
                        .text(item.etiqueta || ((item.nombre || '') + ' - ' + (item.cedula || '')))
                        .attr('data-nombre', item.nombre || '')
                        .attr('data-tipo', item.tipo || '');
                }

                function setSelected($select, value) {
                    var normalized = (value || '').trim();
                    if (!normalized) {
                        return;
                    }

                    $select.val(normalized);
                }

                function updateHiddenNames() {
                    var principalName = $principal.find('option:selected').data('nombre') || '';
                    var apoyoName = $apoyo.find('option:selected').data('nombre') || '';
                    $principalNombre.val(principalName);
                    $apoyoNombre.val(apoyoName);

                    var cedula = ($principal.val() || '').trim();
                    if (/^\d{1,9}$/.test(cedula)) {
                        $codigoInspector.val(cedula);
                    }
                }

                function populateSelects(items) {
                    var selectedPrincipal = $principal.data('selected') || '';
                    var selectedApoyo = $apoyo.data('selected') || '';

                    $principal.empty().append($('<option/>').val('').text('-- Seleccione --'));
                    $apoyo.empty().append($('<option/>').val('').text('-- Opcional --'));

                    (items || []).forEach(function (item) {
                        $principal.append(optionTemplate(item));
                        $apoyo.append(optionTemplate(item));
                    });

                    setSelected($principal, selectedPrincipal);
                    setSelected($apoyo, selectedApoyo);
                    updateHiddenNames();
                }

                function loadInspectores() {
                    $.getJSON(endpoint, { tipoInspector: $tipo.val() || 'TODOS' })
                        .done(function (resp) {
                            populateSelects(resp && resp.success ? resp.items : []);
                        })
                        .fail(function () {
                            populateSelects([]);
                        });
                }

                $tipo.on('change', loadInspectores);
                $principal.on('change', updateHiddenNames);
                $apoyo.on('change', updateHiddenNames);

                loadInspectores();
            });
        })();
    </script>
}
