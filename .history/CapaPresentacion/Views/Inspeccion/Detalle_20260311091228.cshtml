@inherits System.Web.Mvc.WebViewPage<CapaModelo.Inspeccion>
@using CapaModelo
@using CapaDatos.Constants
@using System.Web.Mvc
@using System.Web.Mvc.Html
@using System.Linq

@{
    ViewBag.Title = "Detalle Inspeccion";
    Layout = "~/Views/Shared/_LayoutAOCR.cshtml";
    var hallazgos = ViewBag.Hallazgos as IEnumerable<dynamic>;
    var hallazgosLista = hallazgos != null ? hallazgos.ToList() : new List<dynamic>();
    var historialEstados = ViewBag.HistorialEstados as IEnumerable<InspeccionHistorialEstado>;
    var historialLista = historialEstados != null ? historialEstados.ToList() : new List<InspeccionHistorialEstado>();
    var informeTecnico = ViewBag.InformeTecnico as InspeccionInformeTecnico;
    var documentosSolicitante = ViewBag.DocumentosSolicitante as IEnumerable<DocumentoInspeccion>;
    var documentosLista = documentosSolicitante != null ? documentosSolicitante.ToList() : new List<DocumentoInspeccion>();
    var solicitud = ViewBag.Solicitud as SolicitudAOCR;
    var fechaProgramada = Model != null && Model.FechaProgramada.HasValue ? Model.FechaProgramada.Value.ToString("yyyy-MM-dd") : "-";
    var fechaPagoViaticos = Model != null && Model.FechaPagoViaticos.HasValue ? Model.FechaPagoViaticos.Value.ToString("yyyy-MM-dd HH:mm") : "-";
    var montoViaticos = Model != null && Model.ViaticosMonto.HasValue ? Model.ViaticosMonto.Value.ToString("0.00") : "-";
    var estadoActual = Model != null && !string.IsNullOrWhiteSpace(Model.Estado) ? Model.Estado : "SIN ESTADO";
    var resultadoActual = Model != null && !string.IsNullOrWhiteSpace(Model.Resultado) ? Model.Resultado : "Pendiente";
    var resultadoEvaluacion = Model != null && !string.IsNullOrWhiteSpace(Model.ResultadoEvaluacion) ? Model.ResultadoEvaluacion : "Pendiente";
    var estadoDocumental = Model != null && !string.IsNullOrWhiteSpace(Model.EstadoDocumental) ? Model.EstadoDocumental : "Pendiente";
    var inspectorAsignado = Model != null && Model.CodigoInspector.HasValue ? Model.CodigoInspector.Value.ToString() : "No asignado";
    var inspectorPrincipal = Model != null && !string.IsNullOrWhiteSpace(Model.InspectorPrincipalNombre)
        ? (Model.InspectorPrincipalNombre + " - " + Model.InspectorPrincipalCedula)
        : "No asignado";
    var inspectorApoyo = Model != null && !string.IsNullOrWhiteSpace(Model.InspectorApoyoNombre)
        ? (Model.InspectorApoyoNombre + " - " + Model.InspectorApoyoCedula)
        : "No asignado";
    var tieneInforme = Model != null && !string.IsNullOrWhiteSpace(Model.RutaInforme);
    var puedeGestionarCoordinacion = User.IsInRole("CoordinadorInspecciones") || User.IsInRole("JefaturaTecnica") || User.IsInRole("Administrador");
    var puedeGestionarInspector = User.IsInRole("Inspector") || User.IsInRole("Administrador");
    var puedePlanificar = User.IsInRole("CoordinadorInspecciones") || User.IsInRole("Administrador");
    var puedeCerrar = User.IsInRole("JefaturaTecnica") || User.IsInRole("Administrador");
    var puedeSubirInforme = User.IsInRole("Inspector") || User.IsInRole("Administrador");
    var puedeSolicitarViaticos = User.IsInRole("Inspector") || User.IsInRole("CoordinadorInspecciones") || User.IsInRole("Administrador");
    var puedeValidarViaticos = User.IsInRole("CoordinadorFinanciero") || User.IsInRole("DirectorFinanciero") || User.IsInRole("Administrador");
    var puedeRegistrarResultado = User.IsInRole("Inspector") || User.IsInRole("JefaturaTecnica") || User.IsInRole("Administrador");
    var puedeRegistrarHallazgo = User.IsInRole("Inspector") || User.IsInRole("Administrador");
    var puedeEditarInformeTecnico = User.IsInRole("Inspector") || User.IsInRole("CoordinadorInspecciones") || User.IsInRole("JefaturaTecnica") || User.IsInRole("Administrador");
    var puedeSubirCorreccionSolicitante = User.IsInRole("Solicitante") || User.IsInRole("Administrador");
    var esSolicitante = User.IsInRole("Solicitante");
    var correoSolicitante = solicitud != null && !string.IsNullOrWhiteSpace(solicitud.CorreoRepresentanteTecnico)
        ? solicitud.CorreoRepresentanteTecnico
        : (solicitud != null ? solicitud.Email : "-");
}

@section Styles {
    <style>
        .inspection-detail-page {
            --inspection-primary: #1b4f72;
            --inspection-primary-dark: #163a55;
            --inspection-accent: #0f7b84;
            --inspection-soft: #eef5f8;
            --inspection-border: rgba(27, 79, 114, 0.14);
            --inspection-muted: #667784;
            --inspection-text: #243746;
            --inspection-success: #2f7d50;
            --inspection-warning: #c48a18;
            --inspection-danger: #b84a4a;
            --inspection-shadow: 0 18px 38px rgba(13, 40, 58, 0.08);
            color: var(--inspection-text);
        }

        .inspection-detail-page .inspection-shell {
            background: linear-gradient(180deg, #f8fbfd 0%, #edf3f7 100%);
            border: 1px solid rgba(255, 255, 255, 0.75);
            border-radius: 28px;
            padding: 1.5rem;
        }

        .inspection-detail-page .hero-card {
            position: relative;
            overflow: hidden;
            border: 0;
            border-radius: 28px;
            background: linear-gradient(135deg, var(--inspection-primary-dark) 0%, var(--inspection-primary) 58%, #266f8b 100%);
            color: #fff;
            box-shadow: var(--inspection-shadow);
        }

        .inspection-detail-page .hero-card::before {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient(90deg, rgba(255, 255, 255, 0.08), transparent 58%);
        }

        .inspection-detail-page .hero-card::after {
            content: "";
            position: absolute;
            right: -70px;
            bottom: -85px;
            width: 240px;
            height: 240px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.08);
        }

        .inspection-detail-page .hero-body {
            position: relative;
            z-index: 1;
            padding: 1.75rem;
        }

        .inspection-detail-page .hero-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.55rem;
            padding: 0.5rem 0.85rem;
            border-radius: 999px;
            background: rgba(255, 255, 255, 0.14);
            font-size: 0.8rem;
            font-weight: 800;
            letter-spacing: 0.04em;
            text-transform: uppercase;
        }

        .inspection-detail-page .hero-title {
            margin: 1rem 0 0.35rem;
            font-size: 2rem;
            font-weight: 800;
            line-height: 1.08;
        }

        .inspection-detail-page .hero-subtitle {
            margin: 0;
            color: rgba(255, 255, 255, 0.84);
            font-size: 1rem;
        }

        .inspection-detail-page .hero-metrics {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 0.85rem;
            margin-top: 1.35rem;
        }

        .inspection-detail-page .hero-metric {
            padding: 0.95rem 1rem;
            border-radius: 18px;
            background: rgba(255, 255, 255, 0.12);
            backdrop-filter: blur(4px);
        }

        .inspection-detail-page .hero-metric-label {
            display: block;
            font-size: 0.74rem;
            font-weight: 700;
            letter-spacing: 0.04em;
            text-transform: uppercase;
            color: rgba(255, 255, 255, 0.72);
            margin-bottom: 0.25rem;
        }

        .inspection-detail-page .hero-metric-value {
            display: block;
            font-size: 1rem;
            font-weight: 800;
            color: #fff;
        }

        .inspection-detail-page .status-strip {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 1rem;
            margin-top: 1.25rem;
        }

        .inspection-detail-page .status-tile {
            background: #fff;
            border: 1px solid var(--inspection-border);
            border-radius: 20px;
            padding: 1rem;
            box-shadow: 0 10px 24px rgba(15, 45, 64, 0.05);
        }

        .inspection-detail-page .status-tile small {
            display: block;
            margin-bottom: 0.3rem;
            color: var(--inspection-muted);
            text-transform: uppercase;
            letter-spacing: 0.04em;
            font-size: 0.72rem;
            font-weight: 800;
        }

        .inspection-detail-page .status-tile strong {
            font-size: 1rem;
            color: var(--inspection-text);
        }

        .inspection-detail-page .section-card {
            border: 1px solid var(--inspection-border);
            border-radius: 24px;
            overflow: hidden;
            box-shadow: 0 14px 30px rgba(15, 45, 64, 0.06);
            background: #fff;
        }

        .inspection-detail-page .section-card + .section-card {
            margin-top: 1.25rem;
        }

        .inspection-detail-page .section-card .card-body {
            padding: 1.5rem;
        }

        .inspection-detail-page .soft-card {
            background: linear-gradient(180deg, #f8fbfd 0%, #ffffff 100%);
        }

        .inspection-detail-page .section-heading {
            display: flex;
            align-items: flex-start;
            gap: 1rem;
            margin-bottom: 1.25rem;
        }

        .inspection-detail-page .section-icon {
            width: 52px;
            height: 52px;
            flex: 0 0 52px;
            border-radius: 16px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            background: linear-gradient(135deg, var(--inspection-primary) 0%, var(--inspection-accent) 100%);
            box-shadow: 0 14px 30px rgba(27, 79, 114, 0.24);
        }

        .inspection-detail-page .section-title {
            margin: 0;
            font-size: 1.2rem;
            font-weight: 800;
        }

        .inspection-detail-page .section-copy {
            margin: 0.3rem 0 0;
            color: var(--inspection-muted);
        }

        .inspection-detail-page .detail-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 1rem;
        }

        .inspection-detail-page .detail-item {
            border: 1px solid rgba(27, 79, 114, 0.1);
            border-radius: 18px;
            padding: 1rem 1.1rem;
            background: #fff;
        }

        .inspection-detail-page .detail-label {
            display: block;
            margin-bottom: 0.25rem;
            color: var(--inspection-muted);
            font-size: 0.74rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.04em;
        }

        .inspection-detail-page .detail-value {
            font-size: 1rem;
            font-weight: 700;
            color: var(--inspection-text);
            line-height: 1.35;
        }

        .inspection-detail-page .action-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 1rem;
        }

        .inspection-detail-page .button-flow {
            display: flex;
            flex-wrap: wrap;
            gap: 0.75rem;
        }

        .inspection-detail-page .button-flow form {
            margin: 0;
        }

        .inspection-detail-page .button-flow .btn,
        .inspection-detail-page .compact-form .btn,
        .inspection-detail-page .upload-panel .btn,
        .inspection-detail-page .action-footer .btn {
            border-radius: 14px;
            font-weight: 700;
            padding: 0.65rem 1rem;
        }

        .inspection-detail-page .compact-form {
            display: flex;
            flex-wrap: wrap;
            gap: 0.75rem;
            align-items: end;
        }

        .inspection-detail-page .compact-form .form-group,
        .inspection-detail-page .compact-form .form-field {
            flex: 1 1 200px;
            min-width: 180px;
        }

        .inspection-detail-page .compact-form label,
        .inspection-detail-page .upload-panel label {
            font-size: 0.82rem;
            font-weight: 700;
            color: var(--inspection-muted);
            margin-bottom: 0.35rem;
        }

        .inspection-detail-page .form-control,
        .inspection-detail-page .form-select {
            border-radius: 14px;
            border: 1px solid rgba(27, 79, 114, 0.16);
            padding: 0.78rem 0.95rem;
            box-shadow: none;
        }

        .inspection-detail-page .form-control:focus,
        .inspection-detail-page .form-select:focus {
            border-color: rgba(15, 123, 132, 0.65);
            box-shadow: 0 0 0 0.2rem rgba(15, 123, 132, 0.12);
        }

        .inspection-detail-page .upload-panel {
            border: 1px dashed rgba(27, 79, 114, 0.24);
            border-radius: 20px;
            padding: 1rem;
            background: linear-gradient(180deg, #f8fbfd 0%, #ffffff 100%);
        }

        .inspection-detail-page .status-pill {
            display: inline-flex;
            align-items: center;
            gap: 0.45rem;
            padding: 0.45rem 0.8rem;
            border-radius: 999px;
            font-size: 0.78rem;
            font-weight: 800;
            letter-spacing: 0.03em;
            text-transform: uppercase;
        }

        .inspection-detail-page .status-pill.primary {
            color: #e9f4ff;
            background: rgba(27, 79, 114, 0.88);
        }

        .inspection-detail-page .status-pill.success {
            color: #eaf8f0;
            background: rgba(47, 125, 80, 0.92);
        }

        .inspection-detail-page .status-pill.warning {
            color: #fff8e7;
            background: rgba(196, 138, 24, 0.9);
        }

        .inspection-detail-page .status-pill.danger {
            color: #fff1f1;
            background: rgba(184, 74, 74, 0.9);
        }

        .inspection-detail-page .alert-inline {
            border-radius: 18px;
            border: 1px solid rgba(27, 79, 114, 0.1);
            background: linear-gradient(180deg, #f8fbfd 0%, #ffffff 100%);
            padding: 1rem 1.1rem;
        }

        .inspection-detail-page .hallazgos-table {
            margin-bottom: 0;
            overflow: hidden;
            border-radius: 18px;
        }

        .inspection-detail-page .hallazgos-table thead th {
            background: #f1f6f9;
            color: var(--inspection-primary-dark);
            border-bottom: 1px solid rgba(27, 79, 114, 0.12);
            font-size: 0.8rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.03em;
        }

        .inspection-detail-page .hallazgos-table td,
        .inspection-detail-page .hallazgos-table th {
            vertical-align: middle;
            padding: 0.95rem 1rem;
        }

        .inspection-detail-page .hallazgos-empty {
            padding: 2rem 1rem;
            text-align: center;
            color: var(--inspection-muted);
        }

        .inspection-detail-page .action-footer {
            display: flex;
            flex-wrap: wrap;
            justify-content: space-between;
            align-items: center;
            gap: 1rem;
            margin-top: 1.5rem;
        }

        .inspection-detail-page .modal-content {
            border: 0;
            border-radius: 24px;
            overflow: hidden;
            box-shadow: 0 24px 60px rgba(13, 40, 58, 0.18);
        }

        .inspection-detail-page .modal-header {
            background: linear-gradient(135deg, var(--inspection-primary-dark) 0%, var(--inspection-primary) 100%);
            color: #fff;
            border-bottom: 0;
            padding: 1rem 1.25rem;
        }

        .inspection-detail-page .modal-body {
            padding: 1.25rem;
            background: #f9fbfc;
        }

        @@media (max-width: 991.98px) {
            .inspection-detail-page .hero-metrics,
            .inspection-detail-page .status-strip,
            .inspection-detail-page .detail-grid,
            .inspection-detail-page .action-grid {
                grid-template-columns: 1fr 1fr;
            }
        }

        @@media (max-width: 767.98px) {
            .inspection-detail-page .inspection-shell {
                padding: 1rem;
            }

            .inspection-detail-page .hero-title {
                font-size: 1.6rem;
            }

            .inspection-detail-page .hero-metrics,
            .inspection-detail-page .status-strip,
            .inspection-detail-page .detail-grid,
            .inspection-detail-page .action-grid {
                grid-template-columns: 1fr;
            }

            .inspection-detail-page .action-footer {
                align-items: stretch;
            }
        }
    </style>
}

@if (Model == null)
{
    <div class="alert alert-danger">No se recibio el modelo de inspeccion.</div>
    return;
}

<div class="inspection-detail-page">
    <div class="inspection-shell">
        <div class="card hero-card mb-4">
            <div class="hero-body">
                <span class="hero-badge">
                    <i class="fas fa-clipboard-check"></i>
                    Gestión Técnica DGAC
                </span>
                <h1 class="hero-title">Detalle de inspección</h1>
                <p class="hero-subtitle">Vista operativa integral para seguimiento técnico, control documental y avance del flujo BPMN.</p>

                <div class="hero-metrics">
                    <div class="hero-metric">
                        <span class="hero-metric-label">Código inspección</span>
                        <span class="hero-metric-value">@Model.CodigoInspeccion</span>
                    </div>
                    <div class="hero-metric">
                        <span class="hero-metric-label">Solicitud vinculada</span>
                        <span class="hero-metric-value">@Model.CodigoSolicitud</span>
                    </div>
                    <div class="hero-metric">
                        <span class="hero-metric-label">Estado actual</span>
                        <span class="hero-metric-value">@estadoActual</span>
                    </div>
                    <div class="hero-metric">
                        <span class="hero-metric-label">Fecha programada</span>
                        <span class="hero-metric-value">@fechaProgramada</span>
                    </div>
                </div>
            </div>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-inline mb-4">@TempData["Success"]</div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-inline mb-4">@TempData["Error"]</div>
        }

        <div class="status-strip">
            <div class="status-tile">
                <small>Resultado</small>
                <strong>@resultadoActual</strong>
            </div>
            <div class="status-tile">
                <small>Evaluación</small>
                <strong>@resultadoEvaluacion</strong>
            </div>
            <div class="status-tile">
                <small>Estado documental</small>
                <strong>@estadoDocumental</strong>
            </div>
            <div class="status-tile">
                <small>Hallazgos</small>
                <strong>@hallazgosLista.Count registrados</strong>
            </div>
        </div>

        <div class="card section-card soft-card mt-4">
            <div class="card-body">
                <div class="section-heading">
                    <div class="section-icon">
                        <i class="fas fa-id-badge"></i>
                    </div>
                    <div>
                        <h2 class="section-title">Información general de inspección</h2>
                        <p class="section-copy">Consolidado principal de asignación, estado operativo y datos administrativos asociados a la inspección.</p>
                    </div>
                </div>

                <div class="detail-grid">
                    <div class="detail-item">
                        <span class="detail-label">Inspector asignado</span>
                        <div class="detail-value">@inspectorAsignado</div>
                    </div>
                    <div class="detail-item">
                        <span class="detail-label">Inspector principal AS400</span>
                        <div class="detail-value">@inspectorPrincipal</div>
                    </div>
                    <div class="detail-item">
                        <span class="detail-label">Tipo inspector principal</span>
                        <div class="detail-value">@(!string.IsNullOrWhiteSpace(Model.InspectorPrincipalTipo) ? Model.InspectorPrincipalTipo : "-")</div>
                    </div>
                    <div class="detail-item">
                        <span class="detail-label">Inspector apoyo AS400</span>
                        <div class="detail-value">@inspectorApoyo</div>
                    </div>
                    <div class="detail-item">
                        <span class="detail-label">Tipo inspector apoyo</span>
                        <div class="detail-value">@(!string.IsNullOrWhiteSpace(Model.InspectorApoyoTipo) ? Model.InspectorApoyoTipo : "-")</div>
                    </div>
                    <div class="detail-item">
                        <span class="detail-label">Viáticos requeridos</span>
                        <div class="detail-value">@(Model.ViaticosRequeridos ? "SI" : "NO")</div>
                    </div>
                    <div class="detail-item">
                        <span class="detail-label">Monto viáticos</span>
                        <div class="detail-value">@montoViaticos</div>
                    </div>
                    <div class="detail-item">
                        <span class="detail-label">Pago viáticos validado</span>
                        <div class="detail-value">@(Model.PagoViaticosValidado ? "SI" : "NO")</div>
                    </div>
                    <div class="detail-item">
                        <span class="detail-label">Fecha pago viáticos</span>
                        <div class="detail-value">@fechaPagoViaticos</div>
                    </div>
                    <div class="detail-item">
                        <span class="detail-label">Estado documental</span>
                        <div class="detail-value">@estadoDocumental</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="action-grid mt-4">
            <div class="card section-card">
                <div class="card-body">
                    <div class="section-heading">
                        <div class="section-icon">
                            <i class="fas fa-project-diagram"></i>
                        </div>
                        <div>
                            <h2 class="section-title">Flujo BPMN de inspección</h2>
                            <p class="section-copy">Acciones de transición disponibles según el rol autenticado.</p>
                        </div>
                    </div>

                    @if (puedeGestionarCoordinacion)
                    {
                        <div class="mb-3">
                            <div class="mb-2"><span class="status-pill primary"><i class="fas fa-user-shield"></i> Coordinación y jefatura</span></div>
                            <div class="button-flow">
                                @using (Html.BeginForm("CambiarEstado", "Inspeccion", FormMethod.Post))
                                {
                                    @Html.AntiForgeryToken()
                                    @Html.Hidden("id", Model.CodigoInspeccion)
                                    @Html.Hidden("estado", "VERIFICACION_SOLICITUD")
                                    <button type="submit" class="btn btn-outline-primary">Verificación</button>
                                }
                                @using (Html.BeginForm("CambiarEstado", "Inspeccion", FormMethod.Post))
                                {
                                    @Html.AntiForgeryToken()
                                    @Html.Hidden("id", Model.CodigoInspeccion)
                                    @Html.Hidden("estado", "ACEPTADA")
                                    <button type="submit" class="btn btn-outline-success">Aceptar solicitud</button>
                                }
                                @using (Html.BeginForm("CambiarEstado", "Inspeccion", FormMethod.Post))
                                {
                                    @Html.AntiForgeryToken()
                                    @Html.Hidden("id", Model.CodigoInspeccion)
                                    @Html.Hidden("estado", "OBSERVADA")
                                    <button type="submit" class="btn btn-outline-danger">Observar</button>
                                }
                                @using (Html.BeginForm("CambiarEstado", "Inspeccion", FormMethod.Post))
                                {
                                    @Html.AntiForgeryToken()
                                    @Html.Hidden("id", Model.CodigoInspeccion)
                                    @Html.Hidden("estado", "SUBSANADA")
                                    <button type="submit" class="btn btn-outline-warning">Subsanada</button>
                                }
                                @using (Html.BeginForm("CambiarEstado", "Inspeccion", FormMethod.Post))
                                {
                                    @Html.AntiForgeryToken()
                                    @Html.Hidden("id", Model.CodigoInspeccion)
                                    @Html.Hidden("estado", "CERRADA")
                                    <button type="submit" class="btn btn-outline-dark">Cerrar</button>
                                }
                            </div>
                        </div>
                    }

                    @if (puedeGestionarInspector)
                    {
                        <div>
                            <div class="mb-2"><span class="status-pill warning"><i class="fas fa-user-check"></i> Operación de inspector</span></div>
                            <div class="button-flow">
                                @using (Html.BeginForm("CambiarEstado", "Inspeccion", FormMethod.Post))
                                {
                                    @Html.AntiForgeryToken()
                                    @Html.Hidden("id", Model.CodigoInspeccion)
                                    @Html.Hidden("estado", "EN_INSPECCION")
                                    <button type="submit" class="btn btn-outline-warning">Iniciar inspección</button>
                                }
                                @using (Html.BeginForm("CambiarEstado", "Inspeccion", FormMethod.Post))
                                {
                                    @Html.AntiForgeryToken()
                                    @Html.Hidden("id", Model.CodigoInspeccion)
                                    @Html.Hidden("estado", "INFORME_ELABORADO")
                                    <button type="submit" class="btn btn-outline-info">Informe elaborado</button>
                                }
                                @using (Html.BeginForm("CambiarEstado", "Inspeccion", FormMethod.Post))
                                {
                                    @Html.AntiForgeryToken()
                                    @Html.Hidden("id", Model.CodigoInspeccion)
                                    @Html.Hidden("estado", "OBSERVACION_DOCUMENTAL")
                                    <button type="submit" class="btn btn-outline-danger">Observación documental</button>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="card section-card soft-card">
                <div class="card-body">
                    <div class="section-heading">
                        <div class="section-icon">
                            <i class="fas fa-file-pdf"></i>
                        </div>
                        <div>
                            <h2 class="section-title">Informe técnico</h2>
                            <p class="section-copy">Control de carga y acceso al documento PDF asociado a la inspección.</p>
                        </div>
                    </div>

                    @if (tieneInforme)
                    {
                        <div class="alert alert-success alert-inline d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-3">
                            <div>
                                <strong>Informe cargado</strong>
                                <div class="small text-muted mt-1">@Model.RutaInforme</div>
                            </div>
                            <a class="btn btn-outline-primary"
                               href="@Url.Action("VerInforme", "Inspeccion", new { id = Model.CodigoInspeccion })"
                               target="_blank" rel="noopener">
                                Ver PDF
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-light alert-inline mb-3">Aún no hay informe cargado para esta inspección.</div>
                    }

                    @if (puedeSubirInforme)
                    {
                        using (Html.BeginForm("SubirInforme", "Inspeccion", FormMethod.Post, new { enctype = "multipart/form-data", @class = "upload-panel" }))
                        {
                            @Html.AntiForgeryToken()
                            @Html.Hidden("id", Model.CodigoInspeccion)

                            <div class="mb-3">
                                <label class="form-label d-block">Subir informe en formato PDF</label>
                                <input type="file" name="Informe" class="form-control" accept="application/pdf" required />
                                <small class="text-muted">Tamaño máximo sugerido: 10 MB.</small>
                            </div>

                            <button class="btn btn-primary" type="submit">Subir informe</button>
                        }
                    }
                </div>
            </div>
        </div>

        <div class="action-grid mt-4">
            <div class="card section-card">
                <div class="card-body">
                    <div class="section-heading">
                        <div class="section-icon">
                            <i class="fas fa-wallet"></i>
                        </div>
                        <div>
                            <h2 class="section-title">Viáticos</h2>
                            <p class="section-copy">Solicitud y validación financiera vinculada al proceso de inspección.</p>
                        </div>
                    </div>

                    @if (puedeSolicitarViaticos)
                    {
                        using (Html.BeginForm("SolicitarViaticos", "Inspeccion", FormMethod.Post, new { @class = "compact-form mb-3" }))
                        {
                            @Html.AntiForgeryToken()
                            @Html.Hidden("id", Model.CodigoInspeccion)
                            <div class="form-field">
                                <label>Monto</label>
                                <input type="number" step="0.01" min="0" name="monto" class="form-control" value="@(Model.ViaticosMonto.HasValue ? Model.ViaticosMonto.Value.ToString("0.00") : "")" />
                            </div>
                            <div class="form-field">
                                <label>Observación</label>
                                <input type="text" name="observacion" class="form-control" placeholder="Observación de viáticos" />
                            </div>
                            <div>
                                <button class="btn btn-outline-warning" type="submit">Solicitar viáticos</button>
                            </div>
                        }
                    }

                    @if (puedeValidarViaticos)
                    {
                        using (Html.BeginForm("ValidarPagoViaticos", "Inspeccion", FormMethod.Post, new { @class = "compact-form" }))
                        {
                            @Html.AntiForgeryToken()
                            @Html.Hidden("id", Model.CodigoInspeccion)
                            <div class="form-field">
                                <label>Observación de validación</label>
                                <input type="text" name="observacion" class="form-control" placeholder="Observación de validación" />
                            </div>
                            <div>
                                <button class="btn btn-outline-success" type="submit">Validar pago viáticos</button>
                            </div>
                        }
                    }
                </div>
            </div>

            <div class="card section-card soft-card">
                <div class="card-body">
                    <div class="section-heading">
                        <div class="section-icon">
                            <i class="fas fa-check-double"></i>
                        </div>
                        <div>
                            <h2 class="section-title">Resultado de inspección</h2>
                            <p class="section-copy">Registro formal del resultado técnico y cierre de evaluación.</p>
                        </div>
                    </div>

                    @if (puedeRegistrarResultado)
                    {
                        using (Html.BeginForm("RegistrarResultado", "Inspeccion", FormMethod.Post, new { @class = "compact-form" }))
                        {
                            @Html.AntiForgeryToken()
                            @Html.Hidden("id", Model.CodigoInspeccion)
                            <div class="form-field">
                                <label>Resultado</label>
                                <select name="resultado" class="form-control">
                                    <option value="SATISFACTORIO">Satisfactorio</option>
                                    <option value="NO_SATISFACTORIO">No satisfactorio</option>
                                </select>
                            </div>
                            <div class="form-field">
                                <label>Observación</label>
                                <input type="text" name="observacion" class="form-control" placeholder="Observación del resultado" />
                            </div>
                            <div>
                                <button class="btn btn-outline-primary" type="submit">Registrar resultado</button>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>

        <div class="card section-card mt-4">
            <div class="card-body">
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-3">
                    <div class="section-heading mb-0">
                        <div class="section-icon">
                            <i class="fas fa-search"></i>
                        </div>
                        <div>
                            <h2 class="section-title">Hallazgos</h2>
                            <p class="section-copy">Registro de novedades, severidad y estado de seguimiento de cada hallazgo.</p>
                        </div>
                    </div>

                    @if (puedeRegistrarHallazgo)
                    {
                        <button class="btn btn-warning" type="button" data-bs-toggle="modal" data-bs-target="#modalHallazgo">
                            <i class="fas fa-plus-circle"></i>
                            Registrar hallazgo
                        </button>
                    }
                </div>

                <div class="table-responsive hallazgos-table">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Severidad</th>
                                <th>Descripción</th>
                                <th>Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (hallazgosLista.Any())
                            {
                                foreach (var h in hallazgosLista)
                                {
                                    <tr>
                                        <td>@(h.Severidad ?? "-")</td>
                                        <td>@(h.Descripcion ?? "-")</td>
                                        <td>@(h.Estado ?? "-")</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="3" class="hallazgos-empty">No hay hallazgos registrados para esta inspección.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="action-footer">
            @if (puedePlanificar)
            {
                <a class="btn btn-primary"
                   href="@Url.Action("Planificacion", "Inspeccion", new { id = Model.CodigoInspeccion })">
                    <i class="fas fa-calendar-alt"></i>
                    Planificar inspección
                </a>
            }

            @if (puedeCerrar)
            {
                using (Html.BeginForm("Cerrar", "Inspeccion", FormMethod.Post, new { @class = "button-flow" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.Hidden("id", Model.CodigoInspeccion)
                    <button type="submit" name="resultado" value="APROBADO" class="btn btn-success">Aprobar</button>
                    <button type="submit" name="resultado" value="RECHAZADO" class="btn btn-danger">Rechazar</button>
                }
            }
        </div>
    </div>
</div>

<div class="modal fade" id="modalHallazgo" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Registrar hallazgo</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                @using (Html.BeginForm("RegistrarHallazgo", "Inspeccion", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    @Html.Hidden("CodigoInspeccion", Model.CodigoInspeccion)

                    <div class="mb-3">
                        <label class="form-label d-block">Severidad</label>
                        <select name="Severidad" class="form-control" required>
                            <option value="ALTA">ALTA</option>
                            <option value="MEDIA">MEDIA</option>
                            <option value="BAJA">BAJA</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label d-block">Descripción</label>
                        <textarea name="Descripcion" class="form-control" rows="3" required></textarea>
                    </div>

                    <button class="btn btn-primary" type="submit">Guardar</button>
                }
            </div>
        </div>
    </div>
</div>
