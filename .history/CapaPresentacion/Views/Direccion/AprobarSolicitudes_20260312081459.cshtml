@inherits System.Web.Mvc.WebViewPage<List<CapaModelo.SolicitudAOCR>>
@using CapaModelo
@using System.Web.Mvc
@using System.Web.Mvc.Html
@using System.Linq

@{
    ViewBag.Title = "Aprobar Solicitudes - Dirección/Jefatura";
    Layout = "~/Views/Shared/_LayoutAOCR.cshtml";
}

<h3><i class="glyphicon glyphicon-check"></i> Solicitudes pendientes para decisión</h3>
<hr />

@if (TempData["success"] != null)
{
    <div class="alert alert-success">
        <i class="glyphicon glyphicon-ok"></i> @TempData["success"]
    </div>
}

@if (TempData["error"] != null)
{
    <div class="alert alert-danger">
        <i class="glyphicon glyphicon-remove"></i> @TempData["error"]
    </div>
}

@if (Model != null && Model.Any())
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>CÓdigo</th>
                    <th>Operador</th>
                    <th>RUC</th>
                    <th>Fecha Solicitud</th>
                    <th>Estado</th>
                    <th>Ruta de decisión</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var solicitud in Model)
                {
                    <tr>
                        <td>@solicitud.CodigoSolicitud</td>
                        <td>@solicitud.NombreOperador</td>
                        <td>@solicitud.Ruc</td>
                        <td>@solicitud.FechaSolicitud?.ToString("dd/MM/yyyy")</td>
                        <td>
                            <span class="label label-warning">@solicitud.Estado</span>
                        </td>
                        <td>
                            @Html.ActionLink("Ver Detalle", "Detalle", "SolicitudAOCR", new { id = solicitud.CodigoSolicitud }, new { @class = "btn btn-info btn-sm" })
                            @if (User.IsInRole("JefaturaTecnica"))
                            {
                                @Html.ActionLink("Revisión Jefatura", "RevisarPorJefatura", "SolicitudAOCR", null, new { @class = "btn btn-warning btn-sm" })
                            }
                            @if (User.IsInRole("CoordinacionLegal") || User.IsInRole("Administrador") || User.IsInRole("DirectorGeneral"))
                            {
                                @Html.ActionLink("Revisión Legal", "RevisarLegalizacion", "SolicitudAOCR", null, new { @class = "btn btn-success btn-sm" })
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-info">
        <i class="glyphicon glyphicon-info-sign"></i> No hay solicitudes pendientes para aprobación o legalización.
    </div>
}

