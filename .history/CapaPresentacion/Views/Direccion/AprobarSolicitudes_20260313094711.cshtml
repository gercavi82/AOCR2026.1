@inherits System.Web.Mvc.WebViewPage<List<CapaModelo.SolicitudAOCR>>
@using CapaModelo
@using System.Linq
@using System.Web.Mvc
@using System.Web.Mvc.Html

@{
    ViewBag.Title = "Aprobacion de Solicitudes AOCR";
    ViewBag.PageSubtitle = "Direccion / Jefatura";
    Layout = "~/Views/Shared/_LayoutAOCR.cshtml";

    var totalPendientes = Model != null ? Model.Count : 0;
    var aprobadas = Model != null ? Model.Count(x => !string.IsNullOrWhiteSpace(x.Estado) && x.Estado.ToUpperInvariant().Contains("APROBAD")) : 0;
    var observadas = Model != null ? Model.Count(x => !string.IsNullOrWhiteSpace(x.Estado) && x.Estado.ToUpperInvariant().Contains("OBSERV")) : 0;
}

<div class="container-fluid aocr-page aocr-shell">
    @Html.Partial("_HeroPanel", null, new ViewDataDictionary {
        { "IconClass", "fas fa-landmark" },
        { "Overline", "Sistema Institucional DGAC" },
        { "Title", "Aprobacion de Solicitudes AOCR" },
        { "Subtitle", "Direccion / Jefatura" },
        { "Description", "Revise y formalice decisiones sobre solicitudes AOCR dentro del flujo institucional." },
        { "MetricLabel", "Pendientes" },
        { "MetricValue", totalPendientes }
    })

    <div class="row mb-3">
        <div class="col-md-4 mb-2">
            @Html.Partial("_MetricCard", null, new ViewDataDictionary {
                { "Label", "Pendientes" },
                { "Value", totalPendientes },
                { "IconClass", "fas fa-hourglass-half" },
                { "Tone", "metric-warning" }
            })
        </div>
        <div class="col-md-4 mb-2">
            @Html.Partial("_MetricCard", null, new ViewDataDictionary {
                { "Label", "Aprobadas" },
                { "Value", aprobadas },
                { "IconClass", "fas fa-check-circle" },
                { "Tone", "metric-success" }
            })
        </div>
        <div class="col-md-4 mb-2">
            @Html.Partial("_MetricCard", null, new ViewDataDictionary {
                { "Label", "Observadas" },
                { "Value", observadas },
                { "IconClass", "fas fa-exclamation-triangle" },
                { "Tone", "metric-danger" }
            })
        </div>
    </div>

    @if (TempData["success"] != null)
    {
        <div class="alert alert-success shadow-sm border-0">
            <i class="glyphicon glyphicon-ok"></i> @TempData["success"]
        </div>
    }

    @if (TempData["error"] != null)
    {
        <div class="alert alert-danger shadow-sm border-0">
            <i class="glyphicon glyphicon-remove"></i> @TempData["error"]
        </div>
    }

    <div class="aocr-toolbar aocr-action-toolbar">
        <div class="aocr-toolbar-left">
            <h5 class="mb-1">Bandeja de aprobacion</h5>
            <p class="text-muted mb-0">Solicitudes disponibles para revision de Direccion/Jefatura.</p>
        </div>
        <div class="aocr-toolbar-right">
            @if (User.IsInRole("JefaturaTecnica"))
            {
                <a href="@Url.Action("RevisarPorJefatura", "SolicitudAOCR")" class="btn btn-outline-warning btn-sm">
                    <i class="fas fa-user-check mr-1"></i> Revision Jefatura
                </a>
            }
            @if (User.IsInRole("CoordinacionLegal") || User.IsInRole("Administrador") || User.IsInRole("DirectorGeneral"))
            {
                <a href="@Url.Action("RevisarLegalizacion", "SolicitudAOCR")" class="btn btn-outline-success btn-sm">
                    <i class="fas fa-balance-scale mr-1"></i> Revision Legal
                </a>
            }
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="card aocr-table-card">
            <div class="card-body p-0">
                <div class="table-responsive aocr-table-wrap">
                    <table class="table aocr-table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Solicitud</th>
                                <th>Compania</th>
                                <th>Codigo OACI</th>
                                <th>Representante</th>
                                <th>Fecha</th>
                                <th>Estado</th>
                                <th style="width:140px;">Accion</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var solicitud in Model)
                            {
                                var numeroSolicitudTexto = !string.IsNullOrWhiteSpace(solicitud.NumeroSolicitud)
                                    ? solicitud.NumeroSolicitud
                                    : solicitud.CodigoSolicitud.ToString();
                                <tr>
                                    <td><strong>#@numeroSolicitudTexto</strong></td>
                                    <td>@(string.IsNullOrWhiteSpace(solicitud.NombreOperador) ? "No especificada" : solicitud.NombreOperador)</td>
                                    <td>@(string.IsNullOrWhiteSpace(solicitud.CodigoOaci) ? "No registrado" : solicitud.CodigoOaci)</td>
                                    <td>@(string.IsNullOrWhiteSpace(solicitud.RepresentanteLegal) ? "No registrado" : solicitud.RepresentanteLegal)</td>
                                    <td>@(solicitud.FechaSolicitud.HasValue ? solicitud.FechaSolicitud.Value.ToString("dd/MM/yyyy") : "No registrada")</td>
                                    <td>@Html.Partial("_StatusBadge", null, new ViewDataDictionary { { "Status", solicitud.Estado } })</td>
                                    <td>
                                        @Html.ActionLink("Revisar", "Detalle", "SolicitudAOCR", new { id = solicitud.CodigoSolicitud }, new { @class = "btn btn-sm btn-primary" })
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        @Html.Partial("_EmptyState", null, new ViewDataDictionary {
            { "IconClass", "fas fa-clipboard-check" },
            { "Title", "No existen solicitudes pendientes" },
            { "Description", "Cuando ingresen solicitudes para aprobacion, apareceran en esta bandeja." }
        })
    }
</div>
