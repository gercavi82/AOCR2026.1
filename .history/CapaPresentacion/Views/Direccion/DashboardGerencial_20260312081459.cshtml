@inherits System.Web.Mvc.WebViewPage<CapaPresentacion.Models.DashboardGerencialViewModel>
@{
    ViewBag.Title = "Dashboard Gerencial";
    Layout = "~/Views/Shared/_LayoutAOCR.cshtml";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="mb-0"><i class="fas fa-chart-line"></i> @ViewBag.Title</h3>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-md-3"><div class="card"><div class="card-body"><div class="text-muted">Total solicitudes</div><h4>@Model.TotalSolicitudes</h4></div></div></div>
        <div class="col-md-3"><div class="card"><div class="card-body"><div class="text-muted">Pendientes</div><h4>@Model.SolicitudesPendientes</h4></div></div></div>
        <div class="col-md-3"><div class="card"><div class="card-body"><div class="text-muted">Observadas</div><h4>@Model.SolicitudesObservadas</h4></div></div></div>
        <div class="col-md-3"><div class="card"><div class="card-body"><div class="text-muted">Aceptación documental</div><h4>@Model.SolicitudesAceptadasDocumental</h4></div></div></div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-md-3"><div class="card"><div class="card-body"><div class="text-muted">Inspecciones pendientes</div><h4>@Model.InspeccionesPendientes</h4></div></div></div>
        <div class="col-md-3"><div class="card"><div class="card-body"><div class="text-muted">Inspecciones en curso</div><h4>@Model.InspeccionesEnCurso</h4></div></div></div>
        <div class="col-md-3"><div class="card"><div class="card-body"><div class="text-muted">Inspecciones finalizadas</div><h4>@Model.InspeccionesFinalizadas</h4></div></div></div>
        <div class="col-md-3"><div class="card"><div class="card-body"><div class="text-muted">AOCR emitidos/recibidos</div><h4>@Model.AocrEmitidosRecibidos</h4></div></div></div>
    </div>

    <div class="row g-3">
        <div class="col-lg-6">
            <div class="card">
                <div class="card-header"><strong>Pipeline AOCR</strong></div>
                <div class="card-body">
                    <div class="d-flex justify-content-between"><span>AOCR en revisión</span><span>@Model.AocrEnRevision</span></div>
                    <div class="d-flex justify-content-between"><span>AOCR validados</span><span>@Model.AocrValidados</span></div>
                    <div class="d-flex justify-content-between"><span>AOCR legalizados</span><span>@Model.AocrLegalizados</span></div>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card mb-3">
                <div class="card-header"><strong>Cuellos de botella</strong></div>
                <div class="card-body">
                    @if (Model.CuellosBotella == null || !Model.CuellosBotella.Any())
                    {
                        <div class="text-muted">No hay acumulaciones relevantes.</div>
                    }
                    else
                    {
                        foreach (var item in Model.CuellosBotella)
                        {
                            <div class="d-flex justify-content-between"><span>@item.Estado</span><span>@item.Total</span></div>
                        }
                    }
                </div>
            </div>

            <div class="card">
                <div class="card-header"><strong>Distribución de estados</strong></div>
                <div class="card-body p-0">
                    <table class="table table-sm mb-0">
                        <thead><tr><th>Estado</th><th class="text-end">Total</th></tr></thead>
                        <tbody>
                        @foreach (var item in Model.EstadosSolicitud)
                        {
                            <tr>
                                <td>@item.Estado</td>
                                <td class="text-end">@item.Total</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>


