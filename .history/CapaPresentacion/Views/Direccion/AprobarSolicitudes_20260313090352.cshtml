@inherits System.Web.Mvc.WebViewPage<List<CapaModelo.SolicitudAOCR>>
@using CapaModelo
@using System.Web.Mvc
@using System.Web.Mvc.Html
@using System.Linq

@{
    ViewBag.Title = "Aprobación de Solicitudes AOCR";
    ViewBag.PageSubtitle = "Dirección / Jefatura";
    Layout = "~/Views/Shared/_LayoutAOCR.cshtml";
}

<section class="aocr-approval-hero card shadow-sm border-0 mb-4">
    <div class="card-body">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div>
                <p class="hero-overline mb-2">
                    <i class="fas fa-landmark mr-1"></i> Sistema Institucional DGAC
                </p>
                <h2 class="hero-title mb-1">Aprobación de Solicitudes AOCR</h2>
                <p class="hero-subtitle mb-0">Dirección / Jefatura</p>
            </div>
            <div class="hero-stat text-center">
                <div class="hero-stat-number">@(Model?.Count ?? 0)</div>
                <div class="hero-stat-label">Pendientes</div>
            </div>
        </div>
        <div class="hero-separator mt-3"></div>
        <p class="hero-note mt-3 mb-0">
            Revise y formalice la decisión de cada solicitud en cumplimiento del flujo institucional AOCR.
        </p>
    </div>
</section>

@if (TempData["success"] != null)
{
    <div class="alert alert-success shadow-sm border-0">
        <i class="glyphicon glyphicon-ok"></i> @TempData["success"]
    </div>
}

@if (TempData["error"] != null)
{
    <div class="alert alert-danger shadow-sm border-0">
        <i class="glyphicon glyphicon-remove"></i> @TempData["error"]
    </div>
}

@if (Model != null && Model.Any())
{
    <div class="approval-grid row">
        @foreach (var solicitud in Model)
        {
            var estadoRaw = (solicitud.Estado ?? string.Empty).Trim().ToUpperInvariant();
            var badgeClass = "badge badge-secondary";
            if (estadoRaw.Contains("APROBAD")) { badgeClass = "badge badge-success"; }
            else if (estadoRaw.Contains("OBSERV") || estadoRaw.Contains("RECHAZ")) { badgeClass = "badge badge-danger"; }
            else if (estadoRaw.Contains("REVISION") || estadoRaw.Contains("ENVIADO")) { badgeClass = "badge badge-primary"; }
            else if (estadoRaw.Contains("PENDIENT") || estadoRaw.Contains("VALIDAD")) { badgeClass = "badge badge-warning"; }

            var estadoTexto = string.IsNullOrWhiteSpace(estadoRaw)
                ? "Sin estado"
                : System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(estadoRaw.Replace("_", " ").ToLowerInvariant());

            <div class="col-12 col-lg-6 d-flex mb-4">
                <article class="card solicitud-card shadow-sm border-0 w-100">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-3 gap-2 flex-wrap">
                            <div>
                                <p class="solicitud-kicker mb-1">Solicitud AOCR</p>
                                <h5 class="mb-0">
                                    <span class="solicitud-number">#@(!string.IsNullOrWhiteSpace(solicitud.NumeroSolicitud) ? solicitud.NumeroSolicitud : solicitud.CodigoSolicitud.ToString())</span>
                                </h5>
                            </div>
                            <span class="@badgeClass">@estadoTexto</span>
                        </div>

                        <dl class="solicitud-metadata mb-3">
                            <div><dt>Compañía</dt><dd>@(string.IsNullOrWhiteSpace(solicitud.NombreOperador) ? "No especificada" : solicitud.NombreOperador)</dd></div>
                            <div><dt>Código OACI</dt><dd>@(string.IsNullOrWhiteSpace(solicitud.CodigoOaci) ? "No registrado" : solicitud.CodigoOaci)</dd></div>
                            <div><dt>Representante Técnico</dt><dd>@(string.IsNullOrWhiteSpace(solicitud.RepresentanteLegal) ? "No registrado" : solicitud.RepresentanteLegal)</dd></div>
                            <div><dt>Fecha de solicitud</dt><dd>@(solicitud.FechaSolicitud.HasValue ? solicitud.FechaSolicitud.Value.ToString("dd/MM/yyyy") : "No registrada")</dd></div>
                        </dl>

                        <div class="mt-auto d-flex flex-wrap gap-2">
                            @Html.ActionLink("Revisar solicitud", "Detalle", "SolicitudAOCR", new { id = solicitud.CodigoSolicitud }, new { @class = "btn btn-primary btn-sm" })

                            @if (User.IsInRole("JefaturaTecnica"))
                            {
                                @Html.ActionLink("Revisión Jefatura", "RevisarPorJefatura", "SolicitudAOCR", null, new { @class = "btn btn-outline-warning btn-sm" })
                            }

                            @if (User.IsInRole("CoordinacionLegal") || User.IsInRole("Administrador") || User.IsInRole("DirectorGeneral"))
                            {
                                @Html.ActionLink("Revisión Legal", "RevisarLegalizacion", "SolicitudAOCR", null, new { @class = "btn btn-outline-success btn-sm" })
                            }
                        </div>
                    </div>
                </article>
            </div>
        }
    </div>
}
else
{
    <div class="empty-state card border-0 shadow-sm">
        <div class="card-body text-center py-5">
            <div class="empty-state-icon mx-auto mb-3">
                <i class="fas fa-clipboard-check"></i>
            </div>
            <h4 class="mb-2">No existen solicitudes pendientes de aprobación.</h4>
            <p class="text-muted mb-0">
                Cuando existan solicitudes, aparecerán aquí para revisión por Dirección o Jefatura.
            </p>
        </div>
    </div>
}

@section Styles {
    <style>
        .aocr-approval-hero {
            background: linear-gradient(120deg, #0b3f66 0%, #0f6a7f 52%, #f3f8fb 52%, #f3f8fb 100%);
            color: #0f2d44;
            overflow: hidden;
        }

        .hero-overline {
            color: #d3e8f4;
            text-transform: uppercase;
            letter-spacing: 1px;
            font-size: 0.74rem;
            font-weight: 700;
        }

        .hero-title {
            color: #ffffff;
            font-size: 1.7rem;
            font-weight: 700;
            letter-spacing: 0.2px;
        }

        .hero-subtitle {
            color: #d3e8f4;
            font-size: 1rem;
            font-weight: 500;
        }

        .hero-separator {
            height: 2px;
            width: 100%;
            background: linear-gradient(90deg, rgba(255,255,255,0.45), rgba(255,255,255,0));
        }

        .hero-note {
            color: #d7e5ef;
            max-width: 66ch;
        }

        .hero-stat {
            min-width: 124px;
            background: rgba(255, 255, 255, 0.94);
            border-radius: 12px;
            padding: 12px 14px;
            box-shadow: 0 8px 18px rgba(11, 63, 102, 0.16);
        }

        .hero-stat-number {
            color: #0b3f66;
            font-size: 1.7rem;
            font-weight: 700;
            line-height: 1;
        }

        .hero-stat-label {
            color: #4d6475;
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            margin-top: 4px;
        }

        .solicitud-card {
            border-left: 4px solid #0f6a7f;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

        .solicitud-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 14px 24px rgba(16, 47, 68, 0.13) !important;
        }

        .solicitud-kicker {
            color: #507089;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            font-size: 0.76rem;
            font-weight: 700;
        }

        .solicitud-metadata {
            margin: 0;
        }

        .solicitud-metadata > div {
            display: grid;
            grid-template-columns: 165px 1fr;
            gap: 8px;
            padding: 6px 0;
            border-bottom: 1px dashed #e3eaf0;
        }

        .solicitud-metadata > div:last-child {
            border-bottom: 0;
        }

        .solicitud-metadata dt {
            margin: 0;
            color: #597184;
            font-size: 0.84rem;
            font-weight: 600;
        }

        .solicitud-metadata dd {
            margin: 0;
            color: #1d2e3f;
            font-weight: 600;
        }

        .empty-state {
            background: radial-gradient(circle at top right, rgba(15,106,127,0.11), transparent 42%), #ffffff;
        }

        .empty-state-icon {
            width: 86px;
            height: 86px;
            border-radius: 50%;
            background: linear-gradient(145deg, #0b3f66, #0f6a7f);
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
            box-shadow: 0 10px 24px rgba(11, 63, 102, 0.28);
        }

        @@media (max-width: 768px) {
            .aocr-approval-hero {
                background: linear-gradient(160deg, #0b3f66 0%, #0f6a7f 100%);
            }

            .hero-stat {
                width: 100%;
            }

            .solicitud-metadata > div {
                grid-template-columns: 1fr;
                gap: 2px;
            }
        }
    </style>
}

