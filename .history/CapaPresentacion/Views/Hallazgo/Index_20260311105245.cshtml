@inherits System.Web.Mvc.WebViewPage<IEnumerable<CapaModelo.Hallazgo>>
@using CapaModelo
@using System.Web.Mvc
@using System.Web.Mvc.Html

@{
    ViewBag.Title = "Hallazgos de la Inspección";
    int inspeccionId = 0;
    try
    {
        var inspeccionIdRaw = ViewBag.InspeccionId as object;
        if (inspeccionIdRaw != null)
        {
            int.TryParse(System.Convert.ToString(inspeccionIdRaw), out inspeccionId);
        }
    }
    catch
    {
        inspeccionId = 0;
    }
}

<h2>Hallazgos</h2>

<a href="@Url.Action("Crear", new { inspeccionId })" class="btn btn-success mb-3">
    + Registrar nuevo hallazgo
</a>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Severidad</th>
            <th>Descripción</th>
            <th>Estado</th>
            <th>Detectado</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var h in Model)
            {
                <tr>
                    <td>@h.Criticidad</td>
                    <td>@h.Descripcion</td>
                    <td>
                        <span class="badge @(h.Estado == "RESUELTO" ? "bg-success" : "bg-warning")">
                            @h.Estado
                        </span>
                    </td>
                    <td>@(h.FechaDeteccion.HasValue ? h.FechaDeteccion.Value.ToString("dd/MM/yyyy") : "")</td>
                    <td>
                        <a class="btn btn-info btn-sm"
                           href="@Url.Action("Editar", new { id = h.CodigoHallazgo })">Editar</a>

                        @if (h.Estado == "PENDIENTE")
                        {
                            <form action="@Url.Action("Cerrar")" method="post" style="display:inline;">
                                @Html.AntiForgeryToken()
                                @Html.Hidden("id", h.CodigoHallazgo)
                                @Html.Hidden("inspeccionId", inspeccionId)
                                <button class="btn btn-success btn-sm">Cerrar</button>
                            </form>
                        }

                        <form action="@Url.Action("Eliminar")" method="post" style="display:inline;">
                            @Html.AntiForgeryToken()
                            @Html.Hidden("id", h.CodigoHallazgo)
                            @Html.Hidden("inspeccionId", inspeccionId)
                            <button class="btn btn-danger btn-sm"
                                    onclick="return confirm('¿Eliminar hallazgo?')">
                                Eliminar
                            </button>
                        </form>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="5" class="text-center text-muted">No hay hallazgos registrados.</td>
            </tr>
        }
    </tbody>
</table>

<a href="@Url.Action("Detalle", "Inspeccion", new { id = inspeccionId })" class="btn btn-secondary">
    ← Volver a inspección
</a>


