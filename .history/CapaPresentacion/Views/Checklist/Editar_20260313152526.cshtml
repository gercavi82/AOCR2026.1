@inherits System.Web.Mvc.WebViewPage<Checklist>
@using CapaModelo
@using System.Web.Mvc
@using System.Web.Mvc.Html
@{
    ViewBag.Title = "Editar Checklist";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card shadow">
                <div class="card-header bg-warning text-dark">
                    <h4 class="mb-0"><i class="fas fa-edit"></i> Editar Checklist</h4>
                </div>
                <div class="card-body">
                    @using (Html.BeginForm("Editar", "Checklist", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        @Html.HiddenFor(m => m.CodigoChecklist)
                        @Html.HiddenFor(m => m.CodigoInspeccion)
                        @Html.HiddenFor(m => m.CodigoSolicitud)

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                @Html.LabelFor(m => m.Seccion, "Sección *", new { @class = "form-label" })
                                @Html.TextBoxFor(m => m.Seccion, new { @class = "form-control", required = "required" })
                                @Html.ValidationMessageFor(m => m.Seccion, "", new { @class = "text-danger" })
                            </div>
                            <div class="col-md-6 mb-3">
                                @Html.LabelFor(m => m.ItemNumero, "Número de Item", new { @class = "form-label" })
                                @Html.TextBoxFor(m => m.ItemNumero, new { @class = "form-control" })
                            </div>
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(m => m.Descripcion, "Descripción *", new { @class = "form-label" })
                            @Html.TextAreaFor(m => m.Descripcion, new { @class = "form-control", rows = 4, required = "required" })
                            @Html.ValidationMessageFor(m => m.Descripcion, "", new { @class = "text-danger" })
                        </div>

                        <div class="row">
                            <div class="col-md-4 mb-3">
                                @Html.LabelFor(m => m.Cumple, "Cumple", new { @class = "form-label" })
                                <select name="Cumple" class="form-select">
                                    <option value="" @(string.IsNullOrEmpty(Model.Cumple) ? "selected" : "")>Seleccione...</option>
                                    <option value="Si" @(Model.Cumple == "Si" ? "selected" : "")>Sí</option>
                                    <option value="No" @(Model.Cumple == "No" ? "selected" : "")>No</option>
                                    <option value="N/A" @(Model.Cumple == "N/A" ? "selected" : "")>N/A</option>
                                </select>
                            </div>
                            <div class="col-md-4 mb-3">
                                @Html.LabelFor(m => m.Criticidad, "Criticidad", new { @class = "form-label" })
                                <select name="Criticidad" class="form-select">
                                    <option value="" @(string.IsNullOrEmpty(Model.Criticidad) ? "selected" : "")>Seleccione...</option>
                                    <option value="Alta" @(Model.Criticidad == "Alta" ? "selected" : "")>Alta</option>
                                    <option value="Media" @(Model.Criticidad == "Media" ? "selected" : "")>Media</option>
                                    <option value="Baja" @(Model.Criticidad == "Baja" ? "selected" : "")>Baja</option>
                                </select>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Fecha Creación</label>
                                <input type="text" class="form-control" value="@(Model.CreatedAt.HasValue ? Model.CreatedAt.Value.ToString("dd/MM/yyyy HH:mm") : "")" readonly />
                            </div>
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(m => m.Observaciones, "Observaciones", new { @class = "form-label" })
                            @Html.TextAreaFor(m => m.Observaciones, new { @class = "form-control", rows = 3 })
                        </div>

                        <div class="alert alert-warning">
                            <i class="fas fa-exclamation-triangle"></i>
                            Los cambios afectarán todos los informes relacionados con este checklist.
                        </div>

                        <hr />

                        <div class="d-flex justify-content-between">
                            <a href="@Url.Action("Index", "Checklist")" class="btn btn-secondary">
                                <i class="fas fa-arrow-left"></i> Cancelar
                            </a>
                            <button type="submit" class="btn btn-warning">
                                <i class="fas fa-save"></i> Actualizar Checklist
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Html.Partial("_ValidationScriptsPartial")
}

