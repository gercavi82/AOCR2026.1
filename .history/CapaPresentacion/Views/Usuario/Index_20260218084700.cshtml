@model List<CapaModelo.Usuario>
@{
    ViewBag.Title = "Usuarios del Sistema";
}

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col-12">
            <h2><i class="fas fa-users"></i> Usuarios del Sistema</h2>
            <p class="text-muted">Listado completo de usuarios (eliminación permanente).</p>
        </div>
    </div>

    @if (TempData["msg"] != null)
    {
        <div class="alert alert-success">@TempData["msg"]</div>
    }
    @if (TempData["error"] != null)
    {
        <div class="alert alert-danger">@TempData["error"]</div>
    }

    <div class="card shadow">
        <div class="card-body">
            <div class="table-responsive">
                <table id="tablaUsuariosAll" class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Usuario</th>
                            <th>Nombre Completo</th>
                            <th>Email</th>
                            <th>Rol</th>
                            <th>Activo</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var u in Model)
                        {
                            <tr>
                                <td>@Html.Encode(u.Id)</td>
                                <td>@Html.Encode(u.CodigoUsuario)</td>
                                <td>@Html.Encode((u.NombreCompleto ?? "") + " " + (u.ApellidoUsuario ?? ""))</td>
                                <td>@Html.Encode(u.Email)</td>
                                <td>@Html.Encode(u.Rol)</td>
                                <td>@(u.Activo ? "Sí" : "No")</td>
                                <td>
                                    @using (Html.BeginForm("Eliminar", "Usuario", FormMethod.Post, new { @class = "d-inline" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        @Html.Hidden("id", u.Id)
                                        <button type="submit" class="btn btn-outline-danger btn-sm"
                                                onclick="return confirm('Eliminar usuario definitivamente?');">
                                            <i class="fas fa-trash me-1"></i> Eliminar
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            if ($.fn.DataTable) {
                $('#tablaUsuariosAll').DataTable({
                    language: {
                        url: '@Url.Content("~/Content/plugins/datatables/i18n/Spanish.json")'
                    }
                });
            }
        });
    </script>
}
