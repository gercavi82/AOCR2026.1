@inherits System.Web.Mvc.WebViewPage<CapaModelo.Direccion>
@using CapaModelo
@using System.Web.Mvc
@using System.Web.Mvc.Html
@{
    ViewBag.Title = "Eliminar Dirección";
}

<h2 class="mt-3 text-danger">⚠️ Eliminar Dirección</h2>

<p>¿Está seguro que desea eliminar esta dirección?</p>

<table class="table table-bordered">
    <tr><th>Calle</th><td>@Html.Encode(Model.Calle)</td></tr>
    <tr><th>Ciudad</th><td>@Html.Encode(Model.Ciudad)</td></tr>
    <tr><th>Provincia</th><td>@Html.Encode(Model.Provincia)</td></tr>
    <tr><th>País</th><td>@Html.Encode(Model.Pais)</td></tr>
</table>

@using (Html.BeginForm("ConfirmarEliminar", "Direccion", FormMethod.Post))
{
    @Html.HiddenFor(m => m.CodigoDireccion)

    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a href="@Url.Action("Index")" class="btn btn-secondary">Cancelar</a>
}


