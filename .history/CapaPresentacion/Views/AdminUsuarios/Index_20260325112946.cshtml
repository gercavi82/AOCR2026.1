@model CapaPresentacion.Models.AdminUsuarios.AdminUsuariosIndexViewModel

@{
    ViewBag.Title = "Dashboard de Administracion";
    var rolSesion = Session["Rol"] != null ? Session["Rol"].ToString() : string.Empty;
    var esAdminSesion = string.Equals(rolSesion, "Administrador", System.StringComparison.OrdinalIgnoreCase);
    var esJefaturaSesion = string.Equals(rolSesion, "JefaturaTecnica", System.StringComparison.OrdinalIgnoreCase);
    var totalUsuarios = Model.TotalUsuarios > 0 ? Model.TotalUsuarios : 1;
    var porcentajeActivos = Model.TotalUsuarios > 0 ? (int)System.Math.Round((Model.UsuariosActivos * 100m) / Model.TotalUsuarios) : 0;
    var porcentajeCoberturaRoles = Model.TotalUsuarios > 0 ? (int)System.Math.Round((Model.UsuariosConRoles * 100m) / Model.TotalUsuarios) : 0;
    var porcentajeActividad = Model.TotalUsuarios > 0 ? (int)System.Math.Round((Model.UsuariosConAccesoReciente * 100m) / Model.TotalUsuarios) : 0;
    var gradosActivos = porcentajeActivos * 36 / 10;
    var gradosCobertura = porcentajeCoberturaRoles * 36 / 10;
    var gradosActividad = porcentajeActividad * 36 / 10;
}

<style>
    .admin-dashboard {
        --admin-ink: #123047;
        --admin-muted: #5f7384;
        --admin-line: rgba(18, 48, 71, 0.12);
        --admin-panel: rgba(255, 255, 255, 0.92);
        --admin-shadow: 0 24px 60px rgba(19, 52, 80, 0.14);
        --admin-accent: #0f766e;
        --admin-accent-soft: #d9f3ef;
        --admin-warm: #d97706;
        --admin-warm-soft: #ffedd5;
        --admin-danger: #c2410c;
        --admin-danger-soft: #fff1ea;
        --admin-cold: #1d4ed8;
        --admin-cold-soft: #dbeafe;
        color: var(--admin-ink);
    }

    .admin-hero {
        display: grid;
        grid-template-columns: minmax(0, 1.6fr) minmax(280px, 1fr);
        gap: 1.5rem;
        padding: 2rem;
        border-radius: 28px;
        background:
            radial-gradient(circle at top right, rgba(15, 118, 110, 0.18), transparent 30%),
            radial-gradient(circle at left bottom, rgba(29, 78, 216, 0.14), transparent 28%),
            linear-gradient(135deg, #f7fbfd 0%, #edf6fb 48%, #f8fbf6 100%);
        box-shadow: var(--admin-shadow);
        margin-bottom: 1.5rem;
        overflow: hidden;
    }

    .admin-kicker {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.35rem 0.8rem;
        border-radius: 999px;
        background: rgba(18, 48, 71, 0.08);
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .admin-hero h1 {
        margin: 1rem 0 0.75rem;
        font-size: 2.35rem;
        font-weight: 800;
        line-height: 1.05;
    }

    .admin-hero p {
        max-width: 720px;
        color: var(--admin-muted);
        font-size: 1rem;
        line-height: 1.7;
        margin-bottom: 0;
    }

    .admin-hero__summary {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.85rem;
        align-self: stretch;
    }

    .admin-summary-card {
        border-radius: 20px;
        padding: 1rem 1.1rem;
        background: rgba(255, 255, 255, 0.78);
        border: 1px solid rgba(255, 255, 255, 0.7);
        backdrop-filter: blur(8px);
    }

    .admin-summary-card span {
        display: block;
        color: var(--admin-muted);
        font-size: 0.78rem;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        font-weight: 700;
        margin-bottom: 0.35rem;
    }

    .admin-summary-card strong {
        display: block;
        font-size: 1.9rem;
        line-height: 1.1;
    }

    .admin-summary-card small {
        display: block;
        margin-top: 0.35rem;
        color: var(--admin-muted);
    }

    .admin-kpis {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    .admin-kpi {
        border-radius: 24px;
        padding: 1.35rem;
        background: var(--admin-panel);
        border: 1px solid rgba(255, 255, 255, 0.75);
        box-shadow: var(--admin-shadow);
        position: relative;
        overflow: hidden;
    }

    .admin-kpi::after {
        content: "";
        position: absolute;
        inset: auto -20px -34px auto;
        width: 110px;
        height: 110px;
        border-radius: 50%;
        background: rgba(18, 48, 71, 0.05);
    }

    .admin-kpi__label {
        color: var(--admin-muted);
        font-size: 0.82rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.08em;
    }

    .admin-kpi__value {
        display: block;
        margin-top: 0.85rem;
        font-size: 2.2rem;
        font-weight: 800;
        line-height: 1;
    }

    .admin-kpi__note {
        display: inline-flex;
        margin-top: 0.85rem;
        padding: 0.35rem 0.65rem;
        border-radius: 999px;
        font-size: 0.82rem;
        font-weight: 700;
    }

    .admin-kpi__note--teal {
        background: var(--admin-accent-soft);
        color: var(--admin-accent);
    }

    .admin-kpi__note--amber {
        background: var(--admin-warm-soft);
        color: var(--admin-warm);
    }

    .admin-kpi__note--blue {
        background: var(--admin-cold-soft);
        color: var(--admin-cold);
    }

    .admin-kpi__note--orange {
        background: var(--admin-danger-soft);
        color: var(--admin-danger);
    }

    .admin-grid {
        display: grid;
        grid-template-columns: minmax(0, 1.25fr) minmax(320px, 0.95fr);
        gap: 1rem;
        margin-bottom: 1rem;
    }

    .admin-panel {
        border-radius: 24px;
        padding: 1.4rem;
        background: var(--admin-panel);
        border: 1px solid rgba(255, 255, 255, 0.72);
        box-shadow: var(--admin-shadow);
    }

    .admin-panel__header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 1rem;
        margin-bottom: 1.2rem;
    }

    .admin-panel__header h3,
    .admin-table-card h3 {
        margin: 0;
        font-size: 1.12rem;
        font-weight: 800;
    }

    .admin-panel__header p,
    .admin-table-card p {
        margin: 0.35rem 0 0;
        color: var(--admin-muted);
    }

    .admin-rings {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1rem;
    }

    .admin-ring-card {
        border-radius: 20px;
        padding: 1rem;
        background: #f7fbfd;
        border: 1px solid var(--admin-line);
        text-align: center;
    }

    .admin-ring {
        width: 118px;
        height: 118px;
        border-radius: 50%;
        margin: 0 auto 0.9rem;
        display: grid;
        place-items: center;
        position: relative;
    }

    .admin-ring::before {
        content: "";
        width: 78px;
        height: 78px;
        border-radius: 50%;
        background: #ffffff;
        box-shadow: inset 0 0 0 1px rgba(18, 48, 71, 0.06);
    }

    .admin-ring strong {
        position: absolute;
        font-size: 1.35rem;
        font-weight: 800;
    }

    .admin-ring-card span {
        display: block;
        font-size: 0.8rem;
        font-weight: 700;
        color: var(--admin-muted);
        text-transform: uppercase;
        letter-spacing: 0.06em;
    }

    .admin-ring-card p {
        margin: 0.55rem 0 0;
        color: var(--admin-muted);
        line-height: 1.5;
    }

    .admin-bars {
        margin-top: 1.35rem;
        display: grid;
        gap: 0.9rem;
    }

    .admin-bar__meta {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 0.35rem;
        font-weight: 700;
    }

    .admin-bar__track {
        height: 10px;
        border-radius: 999px;
        background: #e8eef2;
        overflow: hidden;
    }

    .admin-bar__fill {
        height: 100%;
        border-radius: inherit;
    }

    .admin-links {
        display: grid;
        gap: 0.85rem;
    }

    .admin-link-card {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        padding: 1rem 1.1rem;
        border-radius: 20px;
        text-decoration: none;
        color: inherit;
        background: #f8fbfd;
        border: 1px solid var(--admin-line);
        transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
    }

    .admin-link-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 14px 28px rgba(18, 48, 71, 0.08);
        border-color: rgba(15, 118, 110, 0.26);
        text-decoration: none;
        color: inherit;
    }

    .admin-link-card strong {
        display: block;
        font-size: 1rem;
        font-weight: 800;
        margin-bottom: 0.2rem;
    }

    .admin-link-card span {
        color: var(--admin-muted);
        line-height: 1.45;
    }

    .admin-link-card i {
        width: 44px;
        height: 44px;
        border-radius: 14px;
        display: grid;
        place-items: center;
        background: rgba(15, 118, 110, 0.1);
        color: var(--admin-accent);
        font-size: 1rem;
        flex: 0 0 auto;
    }

    .admin-activity-list {
        display: grid;
        gap: 0.8rem;
    }

    .admin-activity-item {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        padding: 0.95rem 1rem;
        border-radius: 18px;
        background: #f9fcfe;
        border: 1px solid var(--admin-line);
    }

    .admin-activity-item strong {
        display: block;
        font-size: 0.98rem;
        font-weight: 800;
    }

    .admin-activity-item span,
    .admin-activity-item small {
        color: var(--admin-muted);
        line-height: 1.45;
    }

    .admin-table-card {
        border-radius: 24px;
        padding: 1.4rem;
        background: var(--admin-panel);
        border: 1px solid rgba(255, 255, 255, 0.72);
        box-shadow: var(--admin-shadow);
        margin-top: 1rem;
    }

    .admin-filter-card {
        border-radius: 20px;
        padding: 1rem;
        background: #f8fbfd;
        border: 1px solid var(--admin-line);
        margin: 1.1rem 0 1.2rem;
    }

    .admin-table-wrap {
        border-radius: 18px;
        overflow: hidden;
        border: 1px solid var(--admin-line);
    }

    .admin-table-wrap table {
        margin-bottom: 0;
        background: #fff;
    }

    .admin-table-wrap thead th {
        background: #123047;
        color: #fff;
        border-color: #123047;
        vertical-align: middle;
    }

    .admin-empty {
        border-radius: 18px;
        padding: 1.5rem;
        text-align: center;
        background: #f8fbfd;
        color: var(--admin-muted);
        border: 1px dashed var(--admin-line);
    }

    @@media (max-width: 1199px) {
        .admin-kpis,
        .admin-rings {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .admin-grid,
        .admin-hero {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 767px) {
        .admin-dashboard {
            font-size: 0.96rem;
        }

        .admin-hero,
        .admin-panel,
        .admin-table-card {
            padding: 1.1rem;
        }

        .admin-kpis,
        .admin-rings,
        .admin-hero__summary {
            grid-template-columns: 1fr;
        }

        .admin-hero h1 {
            font-size: 1.8rem;
        }

        .admin-activity-item,
        .admin-link-card,
        .admin-panel__header {
            display: block;
        }

        .admin-link-card i {
            margin-bottom: 0.85rem;
        }
    }
</style>

<div class="admin-dashboard">
    <div class="admin-hero">
        <div>
            <span class="admin-kicker">
                <i class="fas fa-shield-alt"></i>
                Gobierno de acceso y operacion
            </span>
            <h1>Dashboard de Administracion</h1>
            <p>
                Esta vista consolida usuarios, roles, aprobaciones RT y accesos operativos de la seccion
                Administracion. Se mantiene la tabla de gestion al final, pero ahora la entrada del modulo
                muestra estado general, actividad reciente y accesos directos.
            </p>
        </div>

        <div class="admin-hero__summary">
            <div class="admin-summary-card">
                <span>Usuarios activos</span>
                <strong>@Model.UsuariosActivos</strong>
                <small>@porcentajeActivos% del universo administrado</small>
            </div>
            <div class="admin-summary-card">
                <span>Con roles asignados</span>
                <strong>@Model.UsuariosConRoles</strong>
                <small>@porcentajeCoberturaRoles% con cobertura funcional</small>
            </div>
            <div class="admin-summary-card">
                <span>Actividad 7 dias</span>
                <strong>@Model.UsuariosConAccesoReciente</strong>
                <small>Usuarios con ultimo acceso reciente</small>
            </div>
            <div class="admin-summary-card">
                <span>Pendientes RT</span>
                <strong>@Model.PendientesDesignacionRt</strong>
                <small>Requieren revision documental</small>
            </div>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }
    @if (TempData["PasswordTemporal"] != null)
    {
        <div class="alert alert-warning">
            <strong>Contrasena temporal generada:</strong>
            <div class="mt-1"><code>@TempData["PasswordTemporal"]</code></div>
            <small>Comparta esta clave por un canal seguro. Se solicitara cambio en el siguiente inicio de sesion.</small>
        </div>
    }

    <div class="admin-kpis">
        <div class="admin-kpi">
            <span class="admin-kpi__label">Base de usuarios</span>
            <strong class="admin-kpi__value">@Model.TotalUsuarios</strong>
            <span class="admin-kpi__note admin-kpi__note--teal">@Model.UsuariosActivos activos / @Model.UsuariosInactivos inactivos</span>
        </div>
        <div class="admin-kpi">
            <span class="admin-kpi__label">Roles operativos</span>
            <strong class="admin-kpi__value">@Model.RolesActivos</strong>
            <span class="admin-kpi__note admin-kpi__note--blue">Roles disponibles para asignacion</span>
        </div>
        <div class="admin-kpi">
            <span class="admin-kpi__label">Cobertura funcional</span>
            <strong class="admin-kpi__value">@Model.UsuariosConRoles</strong>
            <span class="admin-kpi__note admin-kpi__note--amber">@Model.UsuariosSinRoles usuarios sin rol</span>
        </div>
        <div class="admin-kpi">
            <span class="admin-kpi__label">Revision RT</span>
            <strong class="admin-kpi__value">@Model.PendientesDesignacionRt</strong>
            <span class="admin-kpi__note admin-kpi__note--orange">Pendientes de validar o resolver</span>
        </div>
    </div>

    <div class="admin-grid">
        <section class="admin-panel">
            <div class="admin-panel__header">
                <div>
                    <h3>Salud operativa del modulo</h3>
                    <p>Lectura rapida del estado de usuarios, roles y actividad administrativa.</p>
                </div>
            </div>

            <div class="admin-rings">
                <div class="admin-ring-card">
                    <div class="admin-ring" style="background: conic-gradient(#0f766e 0deg, #0f766e @gradosActivosdeg, rgba(15, 118, 110, 0.14) @gradosActivosdeg, rgba(15, 118, 110, 0.14) 360deg);">
                        <strong>@porcentajeActivos%</strong>
                    </div>
                    <span>Usuarios activos</span>
                    <p>@Model.UsuariosActivos usuarios habilitados para operar en plataforma.</p>
                </div>

                <div class="admin-ring-card">
                    <div class="admin-ring" style="background: conic-gradient(#1d4ed8 0deg, #1d4ed8 @gradosCoberturadeg, rgba(29, 78, 216, 0.14) @gradosCoberturadeg, rgba(29, 78, 216, 0.14) 360deg);">
                        <strong>@porcentajeCoberturaRoles%</strong>
                    </div>
                    <span>Cobertura de roles</span>
                    <p>@Model.UsuariosConRoles usuarios cuentan con uno o mas roles asignados.</p>
                </div>

                <div class="admin-ring-card">
                    <div class="admin-ring" style="background: conic-gradient(#d97706 0deg, #d97706 @gradosActividaddeg, rgba(217, 119, 6, 0.14) @gradosActividaddeg, rgba(217, 119, 6, 0.14) 360deg);">
                        <strong>@porcentajeActividad%</strong>
                    </div>
                    <span>Actividad reciente</span>
                    <p>@Model.UsuariosConAccesoReciente usuarios registraron login durante los ultimos 7 dias.</p>
                </div>
            </div>

            <div class="admin-bars">
                <div>
                    <div class="admin-bar__meta">
                        <span>Usuarios activos</span>
                        <span>@Model.UsuariosActivos / @Model.TotalUsuarios</span>
                    </div>
                    <div class="admin-bar__track">
                        <div class="admin-bar__fill" style="width:@porcentajeActivos%; background:#0f766e;"></div>
                    </div>
                </div>
                <div>
                    <div class="admin-bar__meta">
                        <span>Usuarios con roles</span>
                        <span>@Model.UsuariosConRoles / @Model.TotalUsuarios</span>
                    </div>
                    <div class="admin-bar__track">
                        <div class="admin-bar__fill" style="width:@porcentajeCoberturaRoles%; background:#1d4ed8;"></div>
                    </div>
                </div>
                <div>
                    <div class="admin-bar__meta">
                        <span>Actividad de la semana</span>
                        <span>@Model.UsuariosConAccesoReciente / @Model.TotalUsuarios</span>
                    </div>
                    <div class="admin-bar__track">
                        <div class="admin-bar__fill" style="width:@porcentajeActividad%; background:#d97706;"></div>
                    </div>
                </div>
            </div>
        </section>

        <section class="admin-panel">
            <div class="admin-panel__header">
                <div>
                    <h3>Accesos rapidos</h3>
                    <p>Entrada central a las operaciones principales de la seccion Administracion.</p>
                </div>
            </div>

            <div class="admin-links">
                <a class="admin-link-card" href="@Url.Action("Create", "AdminUsuarios")">
                    <div>
                        <strong>Crear usuario</strong>
                        <span>Alta de usuarios internos o de gestion con asignacion posterior de roles.</span>
                    </div>
                    <i class="fas fa-user-plus"></i>
                </a>

                <a class="admin-link-card" href="@Url.Action("PermisosRol", "AdminUsuarios")">
                    <div>
                        <strong>Roles y permisos</strong>
                        <span>Administracion de permisos por rol y control de cobertura funcional.</span>
                    </div>
                    <i class="fas fa-key"></i>
                </a>

                @if (esAdminSesion)
                {
                    <a class="admin-link-card" href="@Url.Action("CrearUsuarioInternoRT", "AdminUsuarios")">
                        <div>
                            <strong>Crear usuario interno RT</strong>
                            <span>Provision rapida para personal interno vinculado a flujo RT.</span>
                        </div>
                        <i class="fas fa-id-badge"></i>
                    </a>
                }

                <a class="admin-link-card" href="@Url.Action("ConfiguracionSistema", "Direccion")">
                    <div>
                        <strong>Configuracion del sistema</strong>
                        <span>Parametros globales y opciones de operacion institucional.</span>
                    </div>
                    <i class="fas fa-sliders-h"></i>
                </a>

                @if (esAdminSesion)
                {
                    <a class="admin-link-card" href="@Url.Action("Index", "SyncAdmin")">
                        <div>
                            <strong>Sync RT DB2</strong>
                            <span>Monitoreo de mirror, lotes recientes y ejecucion manual de sincronizacion.</span>
                        </div>
                        <i class="fas fa-database"></i>
                    </a>
                }

                @if (esAdminSesion || esJefaturaSesion)
                {
                    <a class="admin-link-card" href="@Url.Action("RevisarDesignaciones", "Usuario")">
                        <div>
                            <strong>Aprobar usuarios RT</strong>
                            <span>@Model.PendientesDesignacionRt solicitudes pendientes de revision documental.</span>
                        </div>
                        <i class="fas fa-user-check"></i>
                    </a>
                }
            </div>
        </section>
    </div>

    <div class="admin-grid">
        <section class="admin-panel">
            <div class="admin-panel__header">
                <div>
                    <h3>Ultimos accesos</h3>
                    <p>Usuarios con actividad reciente para monitorear uso efectivo del modulo.</p>
                </div>
            </div>

            @if (Model.UsuariosRecientes != null && Model.UsuariosRecientes.Any())
            {
                <div class="admin-activity-list">
                    @foreach (var item in Model.UsuariosRecientes)
                    {
                        <div class="admin-activity-item">
                            <div>
                                <strong>@item.CodigoUsuario</strong>
                                <span>@(string.Format("{0} {1}", item.NombreUsuario, item.ApellidoUsuario).Trim())</span>
                                <small>@(string.IsNullOrWhiteSpace(item.RolesTexto) ? "Sin roles asignados" : item.RolesTexto)</small>
                            </div>
                            <div class="text-md-right">
                                <strong>@(item.UltimoLogin.HasValue ? item.UltimoLogin.Value.ToString("dd/MM/yyyy") : "-")</strong>
                                <small>@(item.UltimoLogin.HasValue ? item.UltimoLogin.Value.ToString("HH:mm") : "Sin registro")</small>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="admin-empty">No existen registros recientes de acceso para los filtros actuales.</div>
            }
        </section>

        <section class="admin-panel">
            <div class="admin-panel__header">
                <div>
                    <h3>Prioridades inmediatas</h3>
                    <p>Lectura breve de lo que requiere intervencion directa del area administrativa.</p>
                </div>
            </div>

            <div class="admin-links">
                <div class="admin-link-card">
                    <div>
                        <strong>Usuarios sin rol</strong>
                        <span>@Model.UsuariosSinRoles cuentas requieren definicion de acceso antes de operar.</span>
                    </div>
                    <i class="fas fa-user-lock"></i>
                </div>
                <div class="admin-link-card">
                    <div>
                        <strong>Usuarios inactivos</strong>
                        <span>@Model.UsuariosInactivos cuentas marcadas como inactivas en el estado actual del filtro.</span>
                    </div>
                    <i class="fas fa-user-slash"></i>
                </div>
                <div class="admin-link-card">
                    <div>
                        <strong>Revision RT</strong>
                        <span>@Model.PendientesDesignacionRt documentos pendientes para aprobacion o rechazo.</span>
                    </div>
                    <i class="fas fa-file-signature"></i>
                </div>
            </div>
        </section>
    </div>

    <section class="admin-table-card">
        <div class="admin-panel__header">
            <div>
                <h3>Gestion detallada de usuarios</h3>
                <p>Se mantiene la operacion original: filtro, consulta y acciones administrativas por usuario.</p>
            </div>
            <div class="d-flex flex-wrap">
                @if (esAdminSesion)
                {
                    <a class="btn btn-outline-dark mr-2 mb-2" href="@Url.Action("CrearUsuarioInternoRT", "AdminUsuarios")">
                        <i class="fas fa-user-plus mr-1"></i> Crear Usuario Interno RT
                    </a>
                }
                <a class="btn btn-outline-primary mr-2 mb-2" href="@Url.Action("PermisosRol", "AdminUsuarios")">
                    <i class="fas fa-key mr-1"></i> Permisos por rol
                </a>
                <a class="btn btn-success mb-2" href="@Url.Action("Create", "AdminUsuarios")">
                    <i class="fas fa-user-plus mr-1"></i> Crear usuario
                </a>
            </div>
        </div>

        @using (Html.BeginForm("Index", "AdminUsuarios", FormMethod.Get, new { @class = "admin-filter-card" }))
        {
            <div class="row align-items-end">
                <div class="col-md-6">
                    <label>Busqueda</label>
                    <input type="text"
                           name="filtro"
                           class="form-control"
                           value="@Model.Filtro"
                           placeholder="Usuario, correo o nombre" />
                </div>
                <div class="col-md-3 mt-3 mt-md-0">
                    <label>Estado</label>
                    <select class="form-control" name="activo">
                        <option value="" @(Model.Activo.HasValue ? null : "selected")>Todos</option>
                        <option value="true" @(Model.Activo == true ? "selected" : null)>Activos</option>
                        <option value="false" @(Model.Activo == false ? "selected" : null)>Inactivos</option>
                    </select>
                </div>
                <div class="col-md-3 mt-3 mt-md-0">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fas fa-search mr-1"></i> Filtrar
                    </button>
                </div>
            </div>
        }

        <div class="admin-table-wrap table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead>
                    <tr>
                        <th>Usuario</th>
                        <th>Nombre</th>
                        <th>Correo</th>
                        <th>Roles</th>
                        <th>Estado</th>
                        <th>Ultimo login</th>
                        <th class="text-right">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Usuarios != null && Model.Usuarios.Any())
                    {
                        foreach (var item in Model.Usuarios)
                        {
                            <tr>
                                <td><strong>@item.CodigoUsuario</strong></td>
                                <td>@(string.Format("{0} {1}", item.NombreUsuario, item.ApellidoUsuario).Trim())</td>
                                <td>@item.Correo</td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(item.RolesTexto))
                                    {
                                        @item.RolesTexto
                                    }
                                    else
                                    {
                                        <span class="text-muted">Sin roles</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge @(item.Activo ? "bg-success" : "bg-secondary")">
                                        @(item.Activo ? "Activo" : "Inactivo")
                                    </span>
                                </td>
                                <td>@(item.UltimoLogin.HasValue ? item.UltimoLogin.Value.ToString("dd/MM/yyyy HH:mm") : "-")</td>
                                <td class="text-right">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a class="btn btn-outline-primary"
                                           href="@Url.Action("Edit", "AdminUsuarios", new { id = item.IdUsuario })"
                                           title="Editar usuario">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <a class="btn btn-outline-info"
                                           href="@Url.Action("Roles", "AdminUsuarios", new { id = item.IdUsuario })"
                                           title="Asignar roles">
                                            <i class="fas fa-user-shield"></i>
                                        </a>
                                        <a class="btn btn-outline-danger"
                                           href="@Url.Action("TransferirEliminar", "AdminUsuarios", new { id = item.IdUsuario })"
                                           title="Eliminar / Transferir usuario">
                                            <i class="fas fa-user-times"></i>
                                        </a>
                                    </div>

                                    @using (Html.BeginForm("ResetPassword", "AdminUsuarios", FormMethod.Post, new { @class = "d-inline-block", data_confirm = "Se generara una contrasena temporal para este usuario. Desea continuar?" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.IdUsuario" />
                                        <button type="submit" class="btn btn-warning btn-sm" title="Reset password">
                                            <i class="fas fa-key"></i>
                                        </button>
                                    }

                                    @using (Html.BeginForm("CambiarEstado", "AdminUsuarios", FormMethod.Post, new { @class = "d-inline-block", data_confirm = item.Activo ? "Se desactivara el usuario. Desea continuar?" : "Se activara el usuario. Desea continuar?" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.IdUsuario" />
                                        <input type="hidden" name="activo" value="@(item.Activo ? "false" : "true")" />
                                        <button type="submit"
                                                class="btn btn-sm @(item.Activo ? "btn-outline-danger" : "btn-outline-success")"
                                                title="@(item.Activo ? "Desactivar" : "Activar")">
                                            <i class="fas @(item.Activo ? "fa-user-slash" : "fa-user-check")"></i>
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">No hay usuarios para los filtros seleccionados.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>

@section Scripts {
    <script src="~/Scripts/admin-usuarios.js"></script>
}
