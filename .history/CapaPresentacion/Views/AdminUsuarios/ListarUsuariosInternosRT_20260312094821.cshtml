@model IEnumerable<CapaDatos.Models.UsuarioInternoRTRegistro>
@using CapaDatos.Models
@{
    ViewBag.Title = "Usuarios RT / Inspectores Registrados";
    Layout = "~/Views/Shared/_LayoutAOCR.cshtml";
    var lista = Model != null ? Model.ToList() : new System.Collections.Generic.List<UsuarioInternoRTRegistro>();
}

<style>
    .rt-list-shell { padding: 1.5rem 0 2rem; }
    .rt-hero {
        background: linear-gradient(135deg, #0f3d75 0%, #174f97 55%, #2f6dbc 100%);
        color: #fff; border-radius: 18px; overflow: hidden;
        box-shadow: 0 18px 40px rgba(14,30,62,0.08);
    }
    .rt-hero .card-body { padding: 1.75rem; }
    .rt-hero-title { font-size: 1.8rem; font-weight: 700; margin: 0.75rem 0 0.35rem; }
    .rt-hero-sub { color: rgba(255,255,255,0.82); margin-bottom: 0; }
    .rt-eyebrow {
        display: inline-flex; align-items: center; gap: 0.4rem;
        padding: 0.4rem 0.75rem; border-radius: 999px;
        background: rgba(255,255,255,0.14);
        font-size: 0.8rem; letter-spacing: 0.03em; text-transform: uppercase;
    }
    .rt-kpi-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px,1fr)); gap: 0.85rem; margin-top: 1.25rem; }
    .rt-kpi { background: rgba(255,255,255,0.12); border: 1px solid rgba(255,255,255,0.14); border-radius: 14px; padding: 0.9rem 1rem; }
    .rt-kpi-label { font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.04em; color: rgba(255,255,255,0.72); margin-bottom: 0.35rem; }
    .rt-kpi-value { font-size: 1.15rem; font-weight: 700; color: #fff; }
    .rt-card { border: 0; border-radius: 18px; box-shadow: 0 12px 28px rgba(14,30,62,0.06); overflow: hidden; }
    .rt-badge-ops { background: #dbeafe; color: #1d4ed8; font-weight: 600; border-radius: 999px; padding: 0.35rem 0.75rem; font-size: 0.82rem; }
    .rt-badge-air { background: #dcfce7; color: #166534; font-weight: 600; border-radius: 999px; padding: 0.35rem 0.75rem; font-size: 0.82rem; }
    .rt-table thead th { border-bottom-width: 1px; color: #4a5d75; font-size: 0.82rem; text-transform: uppercase; letter-spacing: 0.03em; }
</style>

<div class="container-fluid rt-list-shell">
    <div class="card rt-hero mb-4">
        <div class="card-body">
            <div class="d-flex flex-column flex-lg-row justify-content-between gap-3 align-items-lg-start">
                <div>
                    <div class="rt-eyebrow"><i class="fas fa-user-shield"></i> Administracion AOCR</div>
                    <h1 class="rt-hero-title">Usuarios RT / Inspectores</h1>
                    <p class="rt-hero-sub">Listado de inspectores y tecnicos responsables registrados desde la base institucional (OPINSPECTORES / OPIAR2).</p>
                </div>
                <div class="text-lg-end flex-shrink-0">
                    <a href="@Url.Action("CrearUsuarioInternoRT", "AdminUsuarios")" class="btn btn-light fw-bold">
                        <i class="fas fa-user-plus me-1"></i> Registrar Nuevo RT
                    </a>
                </div>
            </div>
            <div class="rt-kpi-grid">
                <div class="rt-kpi">
                    <div class="rt-kpi-label">Total registrados</div>
                    <div class="rt-kpi-value">@lista.Count</div>
                </div>
                <div class="rt-kpi">
                    <div class="rt-kpi-label">Tipo OPS</div>
                    <div class="rt-kpi-value">@lista.Count(x => (x.Tipo ?? "").Equals("OPS", StringComparison.OrdinalIgnoreCase))</div>
                </div>
                <div class="rt-kpi">
                    <div class="rt-kpi-label">Tipo AIR</div>
                    <div class="rt-kpi-value">@lista.Count(x => (x.Tipo ?? "").Equals("AIR", StringComparison.OrdinalIgnoreCase))</div>
                </div>
            </div>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-1"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-triangle me-1"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card rt-card">
        <div class="card-body p-4">
            @if (lista.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 rt-table" id="tablaRT">
                        <thead class="table-light">
                            <tr>
                                <th>Cedula</th>
                                <th>Nombre Completo</th>
                                <th>Tipo</th>
                                <th>Aeropuerto</th>
                                <th>Ciudad</th>
                                <th>Cod. Financiero</th>
                                <th>Registrado</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var rt in lista)
                            {
                                var tipoBadge = (rt.Tipo ?? "").Equals("AIR", StringComparison.OrdinalIgnoreCase)
                                    ? "rt-badge-air" : "rt-badge-ops";
                                <tr>
                                    <td class="fw-semibold">@Html.Encode(rt.CodigoUsuario)</td>
                                    <td>@Html.Encode(string.IsNullOrWhiteSpace(rt.NombreCompleto) ? "-" : rt.NombreCompleto)</td>
                                    <td><span class="@tipoBadge">@Html.Encode(string.IsNullOrWhiteSpace(rt.Tipo) ? "-" : rt.Tipo)</span></td>
                                    <td>@Html.Encode(string.IsNullOrWhiteSpace(rt.Opcar5) ? "-" : rt.Opcar5)</td>
                                    <td>@Html.Encode(string.IsNullOrWhiteSpace(rt.CiudadCodigo) ? "-" : rt.CiudadCodigo)</td>
                                    <td>@(rt.CodigoFinanciero > 0 ? rt.CodigoFinanciero.ToString("0") : "-")</td>
                                    <td class="text-muted small">@rt.CreatedAt.ToString("yyyy-MM-dd")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="fas fa-users-slash fa-3x text-muted mb-3 d-block"></i>
                    <h5 class="text-muted">No hay inspectores RT registrados</h5>
                    <p class="text-muted">Use el boton "Registrar Nuevo RT" para sincronizar inspectores desde la base institucional.</p>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            if ($.fn.DataTable && $('#tablaRT').length) {
                $('#tablaRT').DataTable({
                    language: { url: 'https://cdn.datatables.net/plug-ins/1.13.4/i18n/es-ES.json' },
                    pageLength: 25,
                    order: [[1, 'asc']]
                });
            }
        });
    </script>
}
