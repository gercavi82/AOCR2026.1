                                        @if (EsFechaValida(orden.FechaCreacion))
                                        {
                                            var fechaValor = orden.FechaCreacion.GetValueOrDefault();
                                            <div class="d-flex flex-column">
                                                <span class="fw-medium">@fechaValor.ToString("dd/MM/yyyy")</span>
                                                <small class="text-muted">@fechaValor.ToString("HH:mm") hrs</small>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted fst-italic">No registrada</span>
                                        }
                                    </td>

                                    <td class="text-end pe-3">
                                        <div class="d-flex flex-column align-items-end">
                                            <span class="fw-bold text-primary total-orden">@totalFormatted</span>
                                            @if (orden.Subtotal > 0)
                                            {
                                                <small class="text-muted">Base: @subtotalFormatted</small>
                                            }
                                        </div>
                                    </td>

                                    <td>
                                        <span class="badge @estadoClase badge-estado" title="@estadoTexto" aria-label="Estado: @estadoTexto">
                                            @estadoTexto
                                        </span>
                                    </td>

                                    <td>
                                        <span class="text-muted">@estadoTramite</span>
                                    </td>

                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(orden.ConceptoNombre))
                                        {
                                            <span class="badge bg-secondary" title="@orden.ConceptoNombre" aria-label="Concepto: @orden.ConceptoNombre">
                                                @TruncateText(orden.ConceptoNombre, 20)
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted fst-italic">N/A</span>
                                        }
                                    </td>

                                    <td class="text-center pe-3 acciones-rapidas">
                                        <div class="btn-group btn-group-sm" role="group" aria-label="Acciones para orden @orden.NumeroOrden">
                                            <a href="@Url.Action("Detalles", "OrdenRecaudacion", new { id = orden.Id })"
                                               class="btn btn-outline-primary btn-sm btn-detalle"
                                               title="Ver detalles completos"
                                               data-bs-toggle="tooltip"
                                               data-id="@orden.Id"
                                               aria-label="Ver detalles de orden @orden.NumeroOrden">
                                                <i class="fas fa-eye"></i>
                                            </a>

                                            @if (puedeEditar)
                                            {
                                                <a href="@Url.Action("Editar", "OrdenRecaudacion", new { id = orden.Id })"
                                                   class="btn btn-outline-success btn-sm btn-editar"
                                                   title="Editar orden"
                                                   data-bs-toggle="tooltip"
                                                   data-id="@orden.Id"
                                                   aria-label="Editar orden @orden.NumeroOrden">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                            }

                                            @if (puedeAnular)
                                            {
                                                <button type="button"
                                                        class="btn btn-outline-danger btn-sm btn-anular"
                                                        title="Anular orden"
                                                        data-bs-toggle="tooltip"
                                                        data-id="@orden.Id"
                                                        data-numero="@(orden.NumeroOrden ?? orden.Id.ToString())"
                                                        aria-label="Anular orden @orden.NumeroOrden">
                                                    <i class="fas fa-ban"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>

                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        @if (Model != null && Model.Any())
        {
            <div class="card-footer bg-white border-top-0 pt-3">
                <div class="row align-items-center">
                    <div class="col-md-6">
                        <div class="text-muted small d-flex align-items-center">
                            <i class="fas fa-info-circle me-2"></i>
                            <span>
                                Mostrando <span id="filas-mostradas" class="fw-semibold">@Model.Count</span>
                                de <span id="filas-totales" class="fw-semibold">@Model.Count</span> registros
                            </span>
                        </div>
                    </div>

                    <div class="col-md-6 text-md-end">
                        <div class="d-flex flex-column flex-md-row justify-content-md-end align-items-start align-items-md-center gap-2">
                            <a href="@Url.Action("Index", "OrdenRecaudacion")"
                               class="btn btn-outline-secondary btn-sm d-inline-flex align-items-center order-md-2"
                               id="btn-recargar"
                               aria-label="Recargar p�gina">
                                <i class="fas fa-redo me-2"></i> Recargar
                            </a>

                            @if (esFinanciero)
                            {
                                <a href="@Url.Action("ExportarExcel", "OrdenRecaudacion")"
                                   class="btn btn-outline-primary btn-sm d-inline-flex align-items-center order-md-1"
                                   id="btn-exportar-excel"
                                   aria-label="Exportar a Excel">
                                    <i class="fas fa-file-excel me-2"></i> Exportar Excel
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

</div>

@section Scripts {
    <script>
(function () {
    'use strict';

    var CONFIG = {
        apiBase: '@Url.Content("~/OrdenRecaudacion")',
        tokenSelector: 'input[name="__RequestVerificationToken"]',
        ajaxTimeout: 30000,
        notificationTimeout: 5000,
        pageLength: 10,
        selectors: {
            tabla: '#tablaOrdenes',
            formFiltros: '#form-filtros',
            btnAnular: '.btn-anular',
            btnDbPing: '#btn-db-ping',
            btnExportarPdf: '.export-pdf',
            btnExportarCsv: '.export-csv',
            filtroFechaDesde: '#filtroFechaDesde',
            filtroFechaHasta: '#filtroFechaHasta'
        },
        messages: {
            confirmarAnular: '�Est� seguro de anular la orden {0}? Esta acci�n no se puede deshacer.',
            anuladoExito: 'Orden {0} anulada correctamente.',
            anuladoError: 'Error al anular la orden: {0}',
            exportando: 'Generando archivo {0}...',
            exportadoExito: 'Archivo {0} listo para descargar',
            validacionFechas: 'La fecha "desde" no puede ser mayor a la fecha "hasta".'
        },
        dataTableLang: {
            "decimal": ",",
            "emptyTable": "No hay datos disponibles en la tabla",
            "info": "Mostrando _START_ a _END_ de _TOTAL_ registros",
            "infoEmpty": "Mostrando 0 a 0 de 0 registros",
            "infoFiltered": "(filtrado de _MAX_ registros totales)",
            "thousands": ".",
            "lengthMenu": "Mostrar _MENU_ registros",
            "loadingRecords": "Cargando...",
            "processing": "Procesando...",
            "search": "Buscar:",
            "zeroRecords": "No se encontraron registros coincidentes",
            "paginate": { "first": "Primero", "last": "�ltimo", "next": "Siguiente", "previous": "Anterior" },
            "aria": { "sortAscending": ": activar para ordenar la columna ascendente", "sortDescending": ": activar para ordenar la columna descendente" }
        }
    };

    var tablaOrdenesDT = null;
    var tooltipInstances = [];
    var isLoading = false;

    function log(msg) { if (window.console && console.log) console.log('[AOCR-Ordenes] ' + msg); }
    function logError(msg, err) { if (window.console && console.error) console.error('[AOCR-Ordenes] ' + msg, err || ''); }

    function init() {
        if (typeof jQuery === 'undefined') { setTimeout(init, 100); return; }

        $(document).ready(function () {
            initDateValidation();
            initTooltips();
            initDataTables();
            initEventListeners();
            setupAccessibility();
        });
    }

    function initDateValidation() {
        var $desde = $(CONFIG.selectors.filtroFechaDesde);
        var $hasta = $(CONFIG.selectors.filtroFechaHasta);
        if (!$desde.length || !$hasta.length) return;

        var today = new Date().toISOString().split('T')[0];
        $desde.attr('max', today);
        $hasta.attr('max', today);

        $desde.on('change', function () {
            var d = $(this).val();
            if (d) $hasta.attr('min', d);

            var h = $hasta.val();
            if (h && d && d > h) {
                showNotification(CONFIG.messages.validacionFechas, 'warning');
                $hasta.val(d);
            }
        });

        $hasta.on('change', function () {
            var h = $(this).val();
            var d = $desde.val();
            if (h && d && d > h) {
                showNotification(CONFIG.messages.validacionFechas, 'warning');
                $desde.val(h);
            }
        });
    }

    function destroyTooltips() {
        for (var i = 0; i < tooltipInstances.length; i++) {
            try { tooltipInstances[i].dispose(); } catch (e) {}
        }
        tooltipInstances = [];
    }

    function initTooltips() {
        if (typeof bootstrap === 'undefined' || !bootstrap.Tooltip) return;

        destroyTooltips();
        var els = document.querySelectorAll('[data-bs-toggle="tooltip"]');
        for (var i = 0; i < els.length; i++) {
            try {
                tooltipInstances.push(new bootstrap.Tooltip(els[i], { trigger: 'hover focus', delay: { show: 100, hide: 100 } }));
            } catch (e) {}
        }
    }

    function initDataTables() {
        var $table = $(CONFIG.selectors.tabla);
        if ($table.length === 0) return;
        if ($table.find('tbody tr').length === 0) return;

        if (typeof $.fn.DataTable === 'undefined') { setTimeout(initDataTables, 100); return; }

        try {
            if ($.fn.DataTable.isDataTable(CONFIG.selectors.tabla)) {
                $table.DataTable().destroy(true);
                $table.removeClass('dataTable');
            }

            // OJO: tu tabla tiene 9 columnas => �ndices 0..8
            $table.DataTable({
                language: CONFIG.dataTableLang,
                order: [[0, 'desc']],
                pageLength: CONFIG.pageLength,
                lengthMenu: [[5, 10, 25, 50, -1], [5, 10, 25, 50, 'Todos']],
                responsive: true,
                autoWidth: false,
                processing: true,
                serverSide: false,
                deferRender: true,
                columnDefs: [
                    { orderable: false, targets: [8] },      // Acciones
                    { className: 'dt-body-center', targets: [0, 8] },
                    { className: 'dt-body-right', targets: [4] }
                ],
                drawCallback: function () {
                    setTimeout(initTooltips, 50);
                    updateRowCounters();
                    updateAccessibility();
                },
                initComplete: function () {
                    tablaOrdenesDT = this.api();
                    updateRowCounters();
                }
            });

        } catch (e) {
            logError('Error DataTables:', e);
        }
    }

    function initEventListeners() {
        var $doc = $(document);

        $doc.on('click', CONFIG.selectors.btnDbPing, function (e) {
            e.preventDefault();
            showNotification('Funci�n temporalmente deshabilitada', 'info');
        });

        $doc.on('click', CONFIG.selectors.btnAnular, function () {
            if (isLoading) return;

            var $btn = $(this);
            var id = $btn.data('id');
            var numero = $btn.data('numero') || id;

            confirmAction('Anular Orden', CONFIG.messages.confirmarAnular.replace('{0}', numero), function () {
                anularOrden(id, numero, $btn);
            });
        });

        $doc.on('click', CONFIG.selectors.btnExportarPdf + ', ' + CONFIG.selectors.btnExportarCsv, function (e) {
            e.preventDefault();
            if (isLoading) return;

            var tipo = $(this).hasClass('export-pdf') ? 'PDF' : 'CSV';
            showNotification(CONFIG.messages.exportando.replace('{0}', tipo), 'info');
            isLoading = true;

            setTimeout(function () {
                showNotification(CONFIG.messages.exportadoExito.replace('{0}', tipo), 'success');
                isLoading = false;
            }, 1200);
        });

        $doc.on('submit', CONFIG.selectors.formFiltros, function (e) {
            var $f = $(this);
            var d = $f.find(CONFIG.selectors.filtroFechaDesde).val();
            var h = $f.find(CONFIG.selectors.filtroFechaHasta).val();
            if (d && h && d > h) {
                e.preventDefault();
                showNotification(CONFIG.messages.validacionFechas, 'warning');
                return false;
            }

            var $submit = $f.find('#btn-aplicar-filtros');
            $submit.prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-2"></i>Procesando...');
            return true;
        });
    }

    function setupAccessibility() {
        $(document).on('keydown', function (e) {
            if (e.ctrlKey && (e.key === 'f' || e.keyCode === 70)) {
                e.preventDefault();
                var $search = $('.dataTables_filter input');
                if ($search.length) $search.focus();
            }
        });
    }

    function updateAccessibility() {
        $('table#tablaOrdenes tbody tr').each(function () {
            var $row = $(this);
            var numeroOrden = $row.data('numero') || $row.find('td:eq(1) strong').text();
            $row.find('.btn-detalle').attr('aria-label', 'Ver detalles de orden ' + numeroOrden);
            $row.find('.btn-editar').attr('aria-label', 'Editar orden ' + numeroOrden);
            $row.find('.btn-anular').attr('aria-label', 'Anular orden ' + numeroOrden);
        });
    }

    function getToken() {
        return $(CONFIG.tokenSelector).val() || '';
    }

    function anularOrden(id, numero, $btn) {
        if (isLoading) return;

        isLoading = true;
        var originalHtml = $btn.html();
        $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i>');

        $.ajax({
            // Ajusta esta ruta si tu action est� distinta
            url: CONFIG.apiBase + '/Anular/' + id,
            type: 'POST',
            data: { __RequestVerificationToken: getToken() },
            timeout: CONFIG.ajaxTimeout,
            dataType: 'json'
        })
        .done(function (resp) {
            if (resp && resp.success) {
                showNotification(CONFIG.messages.anuladoExito.replace('{0}', numero), 'success');
                setTimeout(function () { window.location.reload(); }, 900);
            } else {
                var msg = (resp && resp.message) ? resp.message : 'Error desconocido';
                showNotification(CONFIG.messages.anuladoError.replace('{0}', msg), 'danger');
            }
        })
        .fail(function (xhr, status, err) {
            logError('AJAX Anular:', err);
            showNotification(CONFIG.messages.anuladoError.replace('{0}', 'Error de conexi�n'), 'danger');
        })
        .always(function () {
            setTimeout(function () {
                $btn.prop('disabled', false).html(originalHtml);
                isLoading = false;
            }, 500);
        });
    }

    function updateRowCounters() {
        if (!tablaOrdenesDT) return;

        try {
            var total = tablaOrdenesDT.rows().count();
            var filtered = tablaOrdenesDT.rows({ search: 'applied' }).count();

            $('#filas-mostradas').text(filtered);
            $('#filas-totales').text(total);
            $('#contador-registros').text(total);

            var $badge = $('#badge-contador');
            if (filtered < total) {
                $badge.removeClass('bg-light').addClass('bg-warning');
                $badge.find('i').removeClass('fa-database').addClass('fa-filter');
            } else {
                $badge.removeClass('bg-warning').addClass('bg-light');
                $badge.find('i').removeClass('fa-filter').addClass('fa-database');
            }
        } catch (e) { }
    }

    function showNotification(message, type) {
        if (typeof toastr !== 'undefined') {
            toastr.options = { closeButton: true, progressBar: true, positionClass: 'toast-top-right', timeOut: CONFIG.notificationTimeout };
            if (type === 'success') toastr.success(message);
            else if (type === 'warning') toastr.warning(message);
            else if (type === 'danger' || type === 'error') toastr.error(message);
            else toastr.info(message);
            return;
        }

        if (typeof bootstrap !== 'undefined') {
            var alertClass = 'alert-' + (type === 'danger' ? 'danger' : type);
            var id = 'alert-' + Date.now();
            var html =
                '<div id="' + id + '" class="alert ' + alertClass + ' alert-dismissible fade show" role="alert">' +
                message +
                '<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>' +
                '</div>';

            $('.container-fluid').first().prepend(html);
            setTimeout(function () { $('#' + id).alert('close'); }, CONFIG.notificationTimeout);
            return;
        }

        alert(message);
    }

    function confirmAction(title, message, callback) {
        if (typeof Swal !== 'undefined') {
            Swal.fire({
                title: title,
                html: message,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'S�, proceder',
                cancelButtonText: 'Cancelar',
                confirmButtonColor: '#d33',
                cancelButtonColor: '#6c757d',
                reverseButtons: true
            }).then(function (r) {
                if (r.isConfirmed && typeof callback === 'function') callback();
            });
            return;
        }

        if (confirm(title + '\n\n' + message)) {
            if (typeof callback === 'function') callback();
        }
    }

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
    else setTimeout(init, 50);

})();
    </script>
}

@functions {
    private static readonly CultureInfo EcCulture = new CultureInfo("es-EC");

    public static string FormatCurrency(decimal amount)
    {
        try { return amount.ToString("C2", EcCulture); }
        catch { return amount.ToString("N2") + " USD"; }
    }

    public static string FormatCurrency(decimal? amount)
    {
        var val = amount ?? 0m;
        try { return val.ToString("C2", EcCulture); }
        catch { return val.ToString("N2") + " USD"; }
    }

    public static string GetClaseEstado(string estado)
    {
        if (string.IsNullOrWhiteSpace(estado)) return "bg-secondary";

        switch (estado.Trim().ToUpperInvariant())
        {
            case "BORRADOR": return "estado-borrador";
            case "GENERADA": return "estado-generada";
            case "ENVIADA": return "estado-enviada";
            case "PAGADA": return "estado-pagada";
            case "ANULADA": return "estado-anulada";
            default: return "bg-secondary";
        }
    }

    public static string GetTextoEstado(string estado)
    {
        if (string.IsNullOrWhiteSpace(estado)) return "DESCONOCIDO";
        return estado.Trim().ToUpperInvariant();
    }

    public static string TruncateText(string texto, int maxLength)
    {
        if (string.IsNullOrWhiteSpace(texto)) return "N/A";
        texto = texto.Trim();
        return (texto.Length <= maxLength) ? texto : (texto.Substring(0, maxLength) + "�");
    }

    public static bool EsFechaValida(DateTime? fecha)
    {
        return fecha.HasValue && fecha.Value != DateTime.MinValue;
    }

    public static string GetTextoTramite(string estado)
    {
        if (string.IsNullOrWhiteSpace(estado)) return "Sin estado";

        switch (estado.Trim().ToUpperInvariant())
        {
            case "BORRADOR": return "Edici�n del solicitante";
            case "GENERADA": return "Generada (lista para env�o)";
            case "ENVIADA": return "En revisi�n financiera";
            case "PAGADA": return "Pago confirmado / Facturaci�n";
            case "ANULADA": return "Proceso anulado";
            default: return "Estado no mapeado";
        }
    }
}
