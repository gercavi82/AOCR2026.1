@inherits System.Web.Mvc.WebViewPage<List<CapaDatos.Models.OrdenRecaudacionModel>>
@using CapaModelo
@using System.Web.Mvc
@using System.Web.Mvc.Html
@using System.Globalization

@{
    ViewBag.Title = "Orden de Recaudaci�n Requerida";
    Layout = "~/Views/Shared/_LayoutAOCR.cshtml";

    // ==========================================================
    // VALIDACI�N SEGURA DE VIEWBAG / ROLES / ESTAD�STICAS
    // ==========================================================
    int totalOrdenes = 0;
    int pagadas = 0;
    decimal saldoPendiente = 0m;
    decimal montoPagado = 0m;

    try
    {
        var estadisticas = ViewBag.Estadisticas as System.Collections.Generic.Dictionary<string, object>;
        if (estadisticas != null)
        {
            object v;
            if (estadisticas.TryGetValue("Total", out v)) { int.TryParse(Convert.ToString(v), out totalOrdenes); }
            if (estadisticas.TryGetValue("Pagadas", out v)) { int.TryParse(Convert.ToString(v), out pagadas); }
            if (estadisticas.TryGetValue("SaldoPendiente", out v)) { decimal.TryParse(Convert.ToString(v), out saldoPendiente); }
            if (estadisticas.TryGetValue("MontoPagado", out v)) { decimal.TryParse(Convert.ToString(v), out montoPagado); }
        }
    }
    catch
    {
        totalOrdenes = 0; pagadas = 0; saldoPendiente = 0m; montoPagado = 0m;
    }

    int pendientes = totalOrdenes - pagadas;
    if (pendientes < 0) { pendientes = 0; }

    bool tieneOrdenBorrador = false;
    try
    {
        if (ViewBag.TieneOrdenBorrador != null)
        {
            bool.TryParse(ViewBag.TieneOrdenBorrador.ToString(), out tieneOrdenBorrador);
        }
    }
    catch { tieneOrdenBorrador = false; }

    bool usuarioAutenticado = (User != null && User.Identity != null && User.Identity.IsAuthenticated);
    bool esSolicitante = usuarioAutenticado && (User.IsInRole("Solicitante") || User.IsInRole("Administrador"));
    bool esFinanciero = usuarioAutenticado && (User.IsInRole("Financiero") || User.IsInRole("Administrador"));
    bool esAdministrador = usuarioAutenticado && User.IsInRole("Administrador");

    var estadosLista = ViewBag.Estados as IEnumerable<System.Web.Mvc.SelectListItem>;
    var selectEstados = estadosLista ?? new List<System.Web.Mvc.SelectListItem>();
}

