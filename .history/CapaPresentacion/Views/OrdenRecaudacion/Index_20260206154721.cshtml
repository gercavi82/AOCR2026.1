                    <table id="tablaOrdenes"
                           class="table table-hover table-striped align-middle mb-0"
                           style="width:100%"
                           aria-label="Tabla de �rdenes de recaudaci�n">
                        <thead class="table-light">
                            <tr>
                                <th scope="col" width="5%" class="ps-3">ID</th>
                                <th scope="col" width="15%">N�mero Orden</th>
