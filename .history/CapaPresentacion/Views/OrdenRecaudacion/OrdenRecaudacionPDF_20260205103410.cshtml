@model CapaPresentacion.Models.ViewModels.OrdenRecaudacionPDFModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Orden de Recaudación @Model.NumeroOrden</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            font-size: 11px;
            margin: 0;
            padding: 20px;
            color: #333;
        }
        .header {
            text-align: center;
            margin-bottom: 30px;
        }
        .title {
            font-size: 16px;
            font-weight: bold;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 5px;
        }
        .subtitle {
            font-size: 14px;
            font-weight: bold;
            margin-bottom: 20px;
        }
        .orden-number {
            font-size: 12px;
            margin-bottom: 20px;
        }
        .info-section {
            margin-bottom: 20px;
        }
        .info-row {
            margin-bottom: 5px;
            display: flex;
        }
        .info-label {
            font-weight: bold;
            width: 150px;
            display: inline-block;
        }
        .info-value {
            flex: 1;
        }
        .detalle-section {
            margin-top: 30px;
            margin-bottom: 30px;
        }
        .detalle-title {
            background-color: #5DADE2;
            color: white;
            font-weight: bold;
            padding: 8px;
            text-align: center;
            font-size: 12px;
            text-transform: uppercase;
        }
        .detalle-header {
            background-color: #5DADE2;
            color: white;
            display: flex;
            font-weight: bold;
            font-size: 12px;
        }
        .detalle-header .concepto {
            flex: 2;
            padding: 8px;
            text-align: center;
        }
        .detalle-header .valor {
            flex: 1;
            padding: 8px;
            text-align: center;
        }
        .detalle-row {
            display: flex;
            border: 1px solid #ddd;
            border-top: none;
        }
        .detalle-row .concepto {
            flex: 2;
            padding: 8px;
            border-right: 1px solid #ddd;
        }
        .detalle-row .valor {
            flex: 1;
            padding: 8px;
            text-align: right;
            font-weight: bold;
        }
        .total-row {
            background-color: #f8f9fa;
            font-weight: bold;
            font-size: 12px;
        }
        .footer-note {
            margin-top: 30px;
            font-style: italic;
            font-size: 10px;
        }
    </style>
</head>
<body>
    <div class="header">
        <div class="title">DIRECCIÓN GENERAL DE AVIACIÓN CIVIL</div>
        <div class="subtitle">ORDEN DE RECAUDACIÓN</div>
        <div class="orden-number">No. @Model.NumeroOrden</div>
    </div>

    <div class="info-section">
        <div class="info-row">
            <span class="info-label">Lugar y Fecha de Emisión:</span>
            <span class="info-value">@Model.LugarEmision, @Model.FechaEmision.ToString("dd/MM/yyyy")</span>
        </div>
        <div class="info-row">
            <span class="info-label">Compañía:</span>
            <span class="info-value">@Model.NombreCompania</span>
        </div>
        <div class="info-row">
            <span class="info-label">RUC/Cédula:</span>
            <span class="info-value">@Model.Ruc</span>
        </div>
        <div class="info-row">
            <span class="info-label">Email:</span>
            <span class="info-value">@Model.Email</span>
        </div>
        <div class="info-row">
            <span class="info-label">Teléfono:</span>
            <span class="info-value">@Model.Telefono</span>
        </div>
        <div class="info-row">
            <span class="info-label">Referencia:</span>
            <span class="info-value">@Model.Referencia</span>
        </div>
    </div>

    <div class="detalle-section">
        <div class="detalle-title">DETALLE DEL SERVICIO OTORGADO</div>
        <div class="detalle-header">
            <div class="concepto">CONCEPTO</div>
            <div class="valor">VALOR</div>
        </div>
        
        <!-- Concepto Principal -->
        <div class="detalle-row">
            <div class="concepto">@Model.ConceptoPrincipal</div>
            <div class="valor">USD$ @Model.ValorBase.ToString("N2")</div>
        </div>
        
        <!-- Inspecciones usando valores dinámicos -->
        @if (Model.Estaciones > 0)
        {
            <div class="detalle-row">
                <div class="concepto">Inspecciones (@Model.Estaciones x $@(Model.ValorInspecciones / Math.Max(Model.Estaciones, 1):N2})</div>
                <div class="valor">USD$ @Model.ValorInspecciones.ToString("N2")</div>
            </div>
        }
        
        <!-- Viáticos usando valores dinámicos -->
        @if (Model.Dias > 0)
        {
            <div class="detalle-row">
                <div class="concepto">Viáticos (@Model.Dias x $@(Model.ValorViaticos / Math.Max(Model.Dias, 1):N2})</div>
                <div class="valor">USD$ @Model.ValorViaticos.ToString("N2")</div>
            </div>
        }
        
        <!-- Gastos Administrativos usando porcentaje dinámico -->
        @if (Model.ValorGastosAdmin > 0)
        {
            <div class="detalle-row">
                <div class="concepto">Gastos Administrativos (@(Math.Round((Model.ValorGastosAdmin / Math.Max(Model.ValorViaticos, 1)) * 100, 1))% sobre viáticos)</div>
                <div class="valor">USD$ @Model.ValorGastosAdmin.ToString("N2")</div>
            </div>
        }
        
        <!-- Total -->
        <div class="detalle-row total-row">
            <div class="concepto">TOTAL: @Model.TotalEnLetras</div>
            <div class="valor">USD$ @Model.Total.ToString("N2")</div>
        </div>
    </div>

    <div class="footer-note">
        Los valores recaudados tienen el carácter de No Reembolsables.
    </div>
</body>
</html>