@inherits System.Web.Mvc.WebViewPage<List<CapaDatos.Models.OrdenRecaudacionModel>>
@using CapaModelo
@using System.Web.Mvc
@using System.Web.Mvc.Html
    @{
        ViewBag.Title = "Orden de Recaudaci�n Requerida";
        Layout = "~/Views/Shared/_LayoutAOCR.cshtml";

        // ============================================
        // SECCIÓN: VALIDACIÓN SEGURA DE DATOS
        // ============================================

        // Inicializar variables con valores por defecto
        int totalOrdenes = 0;
        int pagadas = 0;
        decimal saldoPendiente = 0;
        decimal montoPagado = 0;

        // Validar y obtener estadísticas desde ViewBag
        try
        {
            var estadisticas = ViewBag.Estadisticas as System.Collections.Generic.Dictionary<string, object>;

            if (estadisticas != null)
            {
                if (estadisticas.ContainsKey("Total"))
                {
                    int.TryParse(estadisticas["Total"].ToString(), out totalOrdenes);
                }

                if (estadisticas.ContainsKey("Pagadas"))
                {
                    int.TryParse(estadisticas["Pagadas"].ToString(), out pagadas);
                }

                if (estadisticas.ContainsKey("SaldoPendiente"))
                {
                    decimal.TryParse(estadisticas["SaldoPendiente"].ToString(), out saldoPendiente);
                }

                if (estadisticas.ContainsKey("MontoPagado"))
                {
                    decimal.TryParse(estadisticas["MontoPagado"].ToString(), out montoPagado);
                }
            }
        }
        catch (Exception)
        {
            // En producción, registrar en log pero no mostrar al usuario
            totalOrdenes = 0;
            pagadas = 0;
            saldoPendiente = 0;
            montoPagado = 0;
        }

        // Calcular pendientes con validación
        int pendientes = totalOrdenes - pagadas;
        if (pendientes < 0)
        {
            pendientes = 0;
        }

        // Validar orden en borrador
        bool tieneOrdenBorrador = false;
        try
        {
            if (ViewBag.TieneOrdenBorrador != null)
            {
                bool.TryParse(ViewBag.TieneOrdenBorrador.ToString(), out tieneOrdenBorrador);
            }
        }
        catch (Exception)
        {
            tieneOrdenBorrador = false;
        }

        // Validar usuario autenticado
        bool usuarioAutenticado = User != null && User.Identity != null && User.Identity.IsAuthenticated;
        bool esSolicitante = usuarioAutenticado && (User.IsInRole("Solicitante") || User.IsInRole("Administrador"));
        bool esFinanciero = usuarioAutenticado && (User.IsInRole("Financiero") || User.IsInRole("Administrador"));
        bool esAdministrador = usuarioAutenticado && User.IsInRole("Administrador");
    }

    @* ============================================
        SECCIÓN: ESTILOS CSS OPTIMIZADOS
        ============================================ *@
    @section Styles{
        <!-- DataTables CSS -->
        <link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/1.13.4/css/dataTables.bootstrap5.min.css">
        <link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/responsive/2.4.1/css/responsive.bootstrap5.min.css">

        <style>
            /* Variables CSS para consistencia y mantenibilidad */
            :root {
                --color-primary: #1B4F72;
                --color-primary-light: #2E86C1;
                --color-danger: #dc3545;
                --color-warning: #ffc107;
                --color-success: #28a745;
                --color-info: #17a2b8;
                --color-secondary: #6c757d;
                --color-light: #f8f9fa;
                --color-dark: #343a40;
                --color-border: #dee2e6;
                --transition-speed: 0.3s;
                --border-radius: 0.375rem;
                --box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
                --box-shadow-hover: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
            }

            /* Efectos hover optimizados */
            .hover-shadow {
                transition: all var(--transition-speed) cubic-bezier(0.4, 0, 0.2, 1);
            }

                .hover-shadow:hover {
                    transform: translateY(-0.25rem);
                    box-shadow: var(--box-shadow-hover) !important;
                }

            /* Componentes de UI */
            .user-img-fallback {
                width: 2.5rem;
                height: 2.5rem;
                border-radius: 50%;
                background: var(--color-secondary);
                display: inline-flex;
                align-items: center;
                justify-content: center;
                color: white;
                font-size: 0.875rem;
                margin-right: 0.5rem;
                flex-shrink: 0;
            }

            /* Tarjetas de orden con estados */
            .card-orden {
                border-left: 0.25rem solid var(--color-primary);
                transition: all var(--transition-speed) ease;
            }

                .card-orden.urgente {
                    border-left-color: var(--color-danger);
                }

                .card-orden.pendiente {
                    border-left-color: var(--color-warning);
                }

                .card-orden.completada {
                    border-left-color: var(--color-success);
                }

            /* Badges de estado */
            .badge-estado {
                font-size: 0.75rem;
                padding: 0.25rem 0.5rem;
                min-width: 5rem;
                text-align: center;
                border-radius: var(--border-radius);
                font-weight: 600;
                text-transform: uppercase;
                letter-spacing: 0.5px;
            }

            /* Acciones rápidas */
            .acciones-rapidas {
                opacity: 1;
                transition: opacity var(--transition-speed) ease;
                white-space: nowrap;
            }

            tr:hover .acciones-rapidas {
                opacity: 1;
            }

            /* Estados específicos con contraste WCAG */
            .estado-borrador {
                background-color: var(--color-secondary) !important;
                color: white !important;
                border: 1px solid var(--color-secondary);
            }

            .estado-generada {
                background-color: var(--color-info) !important;
                color: white !important;
                border: 1px solid var(--color-info);
            }

            .estado-enviada {
                background-color: var(--color-primary-light) !important;
                color: white !important;
                border: 1px solid var(--color-primary-light);
            }

            .estado-pagada {
                background-color: var(--color-success) !important;
                color: white !important;
                border: 1px solid var(--color-success);
            }

            .estado-anulada {
                background-color: var(--color-danger) !important;
                color: white !important;
                border: 1px solid var(--color-danger);
            }

            /* Mejoras para DataTables */
            .dataTables_filter input {
                border: 1px solid var(--color-border) !important;
                border-radius: var(--border-radius) !important;
                padding: 0.375rem 0.75rem !important;
                transition: border-color 0.15s ease-in-out, box-shadow 0.15s ease-in-out;
            }

                .dataTables_filter input:focus {
                    border-color: var(--color-primary) !important;
                    box-shadow: 0 0 0 0.2rem rgba(27, 79, 114, 0.25) !important;
                    outline: 0;
                }

            /* Optimizaciones responsive */
            @@media (max-width: 767.98px) {
                .btn-responsive {
                    width: 100%;
                    margin-bottom: 0.5rem;
                }

                .acciones-rapidas {
                    opacity: 1;
                }

                .table-responsive {
                    border: 0;
                    margin-bottom: 1rem;
                    overflow-x: auto;
                    -webkit-overflow-scrolling: touch;
                }

                .card-body {
                    padding: 1rem !important;
                }

                .col-md-4.text-md-end {
                    text-align: left !important;
                    margin-top: 1rem;
                }
            }

            @@media (max-width: 575.98px) {
                .row.g-3 {
                    margin-left: -0.5rem;
                    margin-right: -0.5rem;
                }

                    .row.g-3 > .col-md-4,
                    .row.g-3 > .col-md-3,
                    .row.g-3 > .col-md-2 {
                        padding-left: 0.5rem;
                        padding-right: 0.5rem;
                    }
            }

            /* Mejoras de accesibilidad */
            .btn:focus,
            .form-control:focus,
            .form-select:focus {
                box-shadow: 0 0 0 0.25rem rgba(27, 79, 114, 0.25);
            }

            /* Loading states */
            .loading {
                opacity: 0.6;
                pointer-events: none;
            }

            /* Animaciones de carga */
            @@keyframes spin {
                0% {
                    transform: rotate(0deg);
                }

                100% {
                    transform: rotate(360deg);
                }
            }

            .spinner {
                animation: spin 1s linear infinite;
            }

            /* Imágenes fallback */
            .img-fallback {
                background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
                color: white;
                display: flex;
                align-items: center;
                justify-content: center;
                font-weight: bold;
            }

            /* Asegurar que DataTables se muestre bien */
            table.dataTable {
                width: 100% !important;
                margin: 0 !important;
                border-collapse: collapse !important;
            }

            /* Asegurar que la tabla exista en el DOM */
            #tablaOrdenes_wrapper {
                padding: 1rem;
            }
        </style>
    }

    @* ============================================
        SECCIÓN: CONTENIDO PRINCIPAL
        ============================================ *@
    <div class="container-fluid py-4">
        <!-- Encabezado de página con breadcrumb -->
        <div class="row mb-4">
            <div class="col-md-8">
                <nav aria-label="breadcrumb" class="d-none d-md-block mb-3">
                    <ol class="breadcrumb bg-transparent p-0">
                        <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")" class="text-decoration-none">Inicio</a></li>
                        <li class="breadcrumb-item"><a href="@Url.Action("Index", "Dashboard")" class="text-decoration-none">Dashboard</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Ordenes de Recaudación</li>
                    </ol>
                </nav>

                <h1 class="h3 text-dark mb-2">
                    <i class="fas fa-file-invoice-dollar me-2 text-primary"></i>
                    @ViewBag.Title
                </h1>
                <p class="text-muted mb-0">
                    Gestión de órdenes de recaudación requeridas para el proceso AOCR.
                    @if (tieneOrdenBorrador)
                    {
                        <span class="badge bg-warning ms-2 align-middle">
                            <i class="fas fa-exclamation-triangle me-1"></i> Tiene orden en borrador
                        </span>
                    }
                </p>
            </div>
            <div class="col-md-4 text-md-end mt-3 mt-md-0">
                @if (esSolicitante)
                {
                    <a href="@Url.Action("Nueva", "OrdenRecaudacion")"
                       class="btn btn-primary btn-lg hover-shadow d-inline-flex align-items-center"
                       id="btn-nueva-orden"
                       aria-label="Crear nueva orden de recaudación">
                        <i class="fas fa-plus-circle me-2"></i> Nueva Orden
                    </a>
                }

                @if (esFinanciero)
                {
                    <div class="btn-group ms-2 mt-2 mt-md-0" role="group">
                        <button type="button"
                                class="btn btn-outline-secondary dropdown-toggle d-inline-flex align-items-center"
                                data-bs-toggle="dropdown"
                                aria-expanded="false"
                                aria-label="Opciones de exportación">
                            <i class="fas fa-download me-2"></i> Exportar
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow">
                            <li>
                                <a class="dropdown-item d-flex align-items-center"
                                   href="@Url.Action("ExportarExcel", "OrdenRecaudacion")"
                                   id="btn-exportar-excel-menu">
                                    <i class="fas fa-file-excel text-success me-2"></i>
                                    <div>
                                        <div>Excel</div>
                                        <small class="text-muted">Formato .xlsx</small>
                                    </div>
                                </a>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item d-flex align-items-center export-pdf"
                                   href="#"
                                   role="button"
                                   id="btn-exportar-pdf">
                                    <i class="fas fa-file-pdf text-danger me-2"></i>
                                    <div>
                                        <div>PDF</div>
                                        <small class="text-muted">Documento imprimible</small>
                                    </div>
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item d-flex align-items-center export-csv"
                                   href="#"
                                   role="button"
                                   id="btn-exportar-csv">
                                    <i class="fas fa-file-csv text-info me-2"></i>
                                    <div>
                                        <div>CSV</div>
                                        <small class="text-muted">Datos separados por comas</small>
                                    </div>
                                </a>
                            </li>
                        </ul>
                    </div>
                }
            </div>
        </div>

        <!-- Tarjeta de filtros con validación -->
        <div class="card mb-4 hover-shadow border" id="card-filtros">
            <div class="card-header bg-light border-bottom-0">
                <h6 class="mb-0">
                    <i class="fas fa-filter me-2 text-primary"></i>Filtros de Búsqueda
                    <small class="text-muted ms-2">(@totalOrdenes órdenes encontradas)</small>
                </h6>
            </div>
            <div class="card-body">
                <!-- Formulario HTML nativo - EVITA ERRORES CS1061 -->
                <form action="@Url.Action("Index", "OrdenRecaudacion")"
                      method="get"
                      class="row g-3"
                      id="form-filtros"
                      novalidate="novalidate">

                    <!-- CSRF Token manual para formularios GET (opcional) -->
                    <input type="hidden" name="__RequestVerificationToken" value="@GetAntiForgeryToken()" />

                    <div class="col-md-4">
                        <label for="filtroEstado" class="form-label fw-semibold">
                            Estado <span class="text-muted">(opcional)</span>
                        </label>
                        @{
                            var estadosLista = ViewBag.Estados as IEnumerable<System.Web.Mvc.SelectListItem>;
                            var selectEstados = estadosLista ?? new List<System.Web.Mvc.SelectListItem>();
                        }
                        <select class="form-select filtro-estado"
                                id="filtroEstado"
                                name="estado"
                                aria-describedby="estadoHelp">
                            <option value="">Todos los estados</option>
                            @foreach (var estado in selectEstados)
                            {
                                <option value="@estado.Value"
                                        @(estado.Selected ? "selected=\"selected\"" : "")>
                                    @estado.Text
                                </option>
                            }
                        </select>
                        <small id="estadoHelp" class="form-text text-muted">Filtrar por estado de la orden</small>
                    </div>

                    <div class="col-md-3">
                        <label for="filtroFechaDesde" class="form-label fw-semibold">
                            Fecha desde <span class="text-muted">(opcional)</span>
                        </label>
                        <input type="date"
                               class="form-control filtro-fecha"
                               id="filtroFechaDesde"
                               name="fechaDesde"
                               max="@DateTime.Now.ToString("yyyy-MM-dd")"
                               aria-describedby="fechaDesdeHelp">
                        <small id="fechaDesdeHelp" class="form-text text-muted">Fecha mínima de creación</small>
                    </div>

                    <div class="col-md-3">
                        <label for="filtroFechaHasta" class="form-label fw-semibold">
                            Fecha hasta <span class="text-muted">(opcional)</span>
                        </label>
                        <input type="date"
                               class="form-control filtro-fecha"
                               id="filtroFechaHasta"
                               name="fechaHasta"
                               max="@DateTime.Now.ToString("yyyy-MM-dd")"
                               aria-describedby="fechaHastaHelp">
                        <small id="fechaHastaHelp" class="form-text text-muted">Fecha máxima de creación</small>
                    </div>

                    <div class="col-md-2 d-flex align-items-end">
                        <button type="submit"
                                class="btn btn-primary w-100 d-inline-flex align-items-center justify-content-center"
                                id="btn-aplicar-filtros"
                                aria-label="Aplicar filtros de búsqueda">
                            <i class="fas fa-filter me-2"></i> Filtrar
                        </button>
                    </div>
                </form>

                <div class="row mt-3">
                    <div class="col-md-12">
                        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center">
                            <div class="mb-2 mb-md-0">
                                <small class="text-muted">
                                    <i class="fas fa-info-circle me-1"></i>
                                    Use los filtros para refinar los resultados
                                </small>
                            </div>
                            <div>
                                <a href="@Url.Action("Index", "OrdenRecaudacion")"
                                   class="btn btn-outline-secondary btn-sm d-inline-flex align-items-center"
                                   id="btn-limpiar-filtros"
                                   aria-label="Limpiar todos los filtros">
                                    <i class="fas fa-times me-2"></i> Limpiar filtros
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tarjetas de estadísticas con seguridad -->
        <div class="row mb-4 g-3">
            <div class="col-xl-3 col-md-6">
                <div class="card bg-primary text-white hover-shadow h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <h6 class="card-title text-white-50 mb-1">Total Órdenes</h6>
                                <h2 class="mb-0" id="total-ordenes">@totalOrdenes</h2>
                                <small class="opacity-75 d-block mt-1">Registros en el sistema</small>
                            </div>
                            <div class="bg-white bg-opacity-10 rounded-circle p-3">
                                <i class="fas fa-file-invoice fa-2x"></i>
                            </div>
                        </div>
                        <div class="mt-3">
                            <div class="progress" style="height: 4px;">
                                <div class="progress-bar bg-white"
                                     role="progressbar"
                                     style="width: 100%"
                                     aria-valuenow="100"
                                     aria-valuemin="0"
                                     aria-valuemax="100"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-6">
                <div class="card bg-warning text-dark hover-shadow h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <h6 class="card-title text-dark-50 mb-1">Pendientes</h6>
                                <h2 class="mb-0" id="pendientes">@pendientes</h2>
                                <small class="opacity-75 d-block mt-1">Requieren atención</small>
                            </div>
                            <div class="bg-dark bg-opacity-10 rounded-circle p-3">
                                <i class="fas fa-clock fa-2x"></i>
                            </div>
                        </div>
                        <div class="mt-3">
                            <div class="progress" style="height: 4px;">
                                <div class="progress-bar bg-dark"
                                     role="progressbar"
                                     style="width: @(totalOrdenes > 0 ? (pendientes * 100 / totalOrdenes) : 0)%"
                                     aria-valuenow="@(totalOrdenes > 0 ? (pendientes * 100 / totalOrdenes) : 0)"
                                     aria-valuemin="0"
                                     aria-valuemax="100"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-6">
                <div class="card bg-success text-white hover-shadow h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <h6 class="card-title text-white-50 mb-1">Pagadas</h6>
                                <h2 class="mb-0" id="pagadas">@pagadas</h2>
                                <small class="opacity-75 d-block mt-1">Procesos completados</small>
                            </div>
                            <div class="bg-white bg-opacity-10 rounded-circle p-3">
                                <i class="fas fa-check-circle fa-2x"></i>
                            </div>
                        </div>
                        <div class="mt-3">
                            <div class="progress" style="height: 4px;">
                                <div class="progress-bar bg-white"
                                     role="progressbar"
                                     style="width: @(totalOrdenes > 0 ? (pagadas * 100 / totalOrdenes) : 0)%"
                                     aria-valuenow="@(totalOrdenes > 0 ? (pagadas * 100 / totalOrdenes) : 0)"
                                     aria-valuemin="0"
                                     aria-valuemax="100"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-6">
                <div class="card bg-info text-white hover-shadow h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <h6 class="card-title text-white-50 mb-1">Saldo Pendiente</h6>
                                <h4 class="mb-0" id="saldo-pendiente">
                                    @FormatCurrency(saldoPendiente)
                                </h4>
                                <small class="opacity-75 d-block mt-1">
                                    Pagado: @FormatCurrency(montoPagado)
                                </small>
                            </div>
                            <div class="bg-white bg-opacity-10 rounded-circle p-3">
                                <i class="fas fa-dollar-sign fa-2x"></i>
                            </div>
                        </div>
                        <div class="mt-3">
                            <div class="progress" style="height: 4px;">
                                @{
                                    decimal totalMonto = saldoPendiente + montoPagado;
                                    int porcentajePagado = totalMonto > 0 ? (int)((montoPagado * 100) / totalMonto) : 0;
                                }
                                <div class="progress-bar bg-white"
                                     role="progressbar"
                                     style="width: @porcentajePagado%"
                                     aria-valuenow="@porcentajePagado"
                                     aria-valuemin="0"
                                     aria-valuemax="100"
                                     aria-label="@porcentajePagado% pagado"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tabla principal de órdenes -->
        <div class="card hover-shadow border-0 overflow-hidden">
            <div class="card-header bg-white border-bottom-0 py-3">
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center">
                    <div class="mb-2 mb-md-0">
                        <h5 class="card-title mb-0 d-flex align-items-center">
                            <i class="fas fa-list me-2 text-primary"></i> Listado de Órdenes de Recaudación
                        </h5>
                        <small class="text-muted d-block mt-1">
                            Gestión completa de todas las Órdenes del sistema
                        </small>
                    </div>
                    <div class="d-flex align-items-center">
                        <span class="badge bg-light text-dark me-3" id="badge-contador">
                            <i class="fas fa-database me-1"></i>
                            <span id="contador-registros">@(Model != null ? Model.Count : 0)</span> registros
                        </span>

                        @if (esAdministrador)
                        {
                            <button type="button"
                                    class="btn btn-sm btn-outline-success d-flex align-items-center"
                                    id="btn-db-ping"
                                    title="Probar conexión a base de datos"
                                    data-bs-toggle="tooltip"
                                    aria-label="Probar conexión a la base de datos">
                                <i class="fas fa-plug me-1"></i>
                                <span class="d-none d-md-inline">Test BD</span>
                            </button>
                        }
                    </div>
                </div>
            </div>

            <div class="card-body p-0">
                @if (Model == null || !Model.Any())
                {
                    <!-- Estado vacío -->
                    <div class="text-center py-5" id="sin-datos">
                        <div class="py-5">
                            <i class="fas fa-inbox fa-4x text-muted mb-4 opacity-50"></i>
                            <h4 class="text-muted mb-3">No hay órdenes de recaudación</h4>
                            <p class="text-muted mb-4 col-md-6 mx-auto">
                                No se encontraron órdenes con los filtros aplicados.
                                Puede intentar con diferentes criterios de búsqueda o crear una nueva orden.
                            </p>
                            @if (esSolicitante)
                            {
                                <a href="@Url.Action("Nueva", "OrdenRecaudacion")"
                                   class="btn btn-primary px-4 py-2 d-inline-flex align-items-center"
                                   id="btn-primera-orden">
                                    <i class="fas fa-plus-circle me-2"></i> Crear primera orden
                                </a>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <!-- Tabla de datos -->
                    <div class="table-responsive" id="tabla-contenedor">
                        <table id="tablaOrdenes"
                               class="table table-hover table-striped align-middle mb-0"
                               style="width:100%"
                               aria-label="Tabla de órdenes de recaudación">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col" width="5%" class="ps-3">ID</th>
                                    <th scope="col" width="15%">Número Orden</th>
                                    <th scope="col" width="20%">Contribuyente</th>
                                    <th scope="col" width="15%">Fecha Creación</th>
                                    <th scope="col" width="10%" class="text-end pe-3">Monto</th>
                                    <th scope="col" width="15%">Estado</th>
                                    <th scope="col" width="15%">Trámite</th>
                                    <th scope="col" width="10%">Concepto</th>
                                    <th scope="col" width="10%" class="text-center pe-3">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var orden in Model)
                                {
                                    // Validaciones seguras para cada orden
                                    string estadoClase = GetClaseEstado(orden.Estado);
                                    string estadoTexto = GetTextoEstado(orden.Estado);
                                    string estadoTramite = GetTextoTramite(orden.Estado);

                                    bool esBorrador = false;
                                    if (!string.IsNullOrWhiteSpace(orden.Estado))
                                    {
                                        esBorrador = string.Equals((orden.Estado ?? "").Trim(), "BORRADOR", StringComparison.OrdinalIgnoreCase);
                                    }

                                    bool puedeEditar = esSolicitante && esBorrador;

                                    // Formatear valores monetarios
                                    string totalFormatted = FormatCurrency(orden.Total);
                                    string subtotalFormatted = FormatCurrency(orden.Subtotal);

                                    // Validar si puede anular
                                    bool puedeAnular = esAdministrador &&
                                                       !string.IsNullOrWhiteSpace(orden.Estado) &&
                                                       !string.Equals(orden.Estado, "ANULADA", StringComparison.OrdinalIgnoreCase);

                                    <tr data-id="@orden.Id"
                                        data-estado="@(orden.Estado ?? "")"
                                        data-numero="@(orden.NumeroOrden ?? "")"
                                        class="@(esBorrador ? "table-warning" : "")">
                                        <td class="ps-3 fw-semibold">@orden.Id</td>
                                        <td>
                                            <div class="d-flex flex-column">
                                                <strong class="text-primary">@(orden.NumeroOrden ?? "N/A")</strong>
                                                @if (!string.IsNullOrWhiteSpace(orden.CodigoSolicitud))
                                                {
                                                    <small class="text-muted mt-1">
                                                        <i class="fas fa-hashtag me-1"></i>Sol: @orden.CodigoSolicitud
                                                    </small>
                                                }
                                            </div>
                                        </td>
                                        <td>
                                            <div class="d-flex align-items-start">
                                                <div class="user-img-fallback flex-shrink-0">
                                                    <i class="fas fa-building"></i>
                                                </div>
                                                <div class="flex-grow-1 ms-2">
                                                    <strong class="d-block">@(orden.Compania ?? "Sin nombre")</strong>
                                                    <div class="text-muted small mt-1">
                                                        @if (!string.IsNullOrWhiteSpace(orden.RucCedula))
                                                        {
                                                            <div class="d-flex align-items-center">
                                                                <i class="fas fa-id-card me-1"></i>
                                                                <span>RUC/CI: @orden.RucCedula</span>
                                                            </div>
                                                        }
                                                        @if (!string.IsNullOrWhiteSpace(orden.Correo))
                                                        {
                                                            <div class="d-flex align-items-center mt-1">
                                                                <i class="fas fa-envelope me-1"></i>
                                                                <span>@orden.Correo</span>
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            @if (orden.FechaCreacion != null && orden.FechaCreacion != DateTime.MinValue)
                                            {
                                                <div class="d-flex flex-column">
                                                    <span class="fw-medium">@(orden.FechaCreacion.ToString("dd/MM/yyyy"))</span>
                                                    <small class="text-muted">@(orden.FechaCreacion.ToString("HH:mm")) hrs</small>
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="text-muted fst-italic">No registrada</span>
                                            }
                                        </td>
                                        <td class="text-end pe-3">
                                            <div class="d-flex flex-column align-items-end">
                                                <span class="fw-bold text-primary total-orden">
                                                    @totalFormatted
                                                </span>
                                                @if (orden.Subtotal > 0)
                                                {
                                                    <small class="text-muted">Base: @subtotalFormatted</small>
                                                }
                                            </div>
                                        </td>
                                        <td>
                                            <span class="badge @estadoClase badge-estado"
                                                  title="@estadoTexto"
                                                  aria-label="Estado: @estadoTexto">
                                                @estadoTexto
                                            </span>
                                        </td>
                                        <td>
                                            <span class="text-muted">@estadoTramite</span>
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrWhiteSpace(orden.ConceptoNombre))
                                            {
                                                <span class="badge bg-secondary"
                                                      title="@orden.ConceptoNombre"
                                                      aria-label="Concepto: @orden.ConceptoNombre">
                                                    @TruncateText(orden.ConceptoNombre, 20)
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-muted fst-italic">N/A</span>
                                            }
                                        </td>
                                        <td class="text-center pe-3 acciones-rapidas">
                                            <div class="btn-group btn-group-sm" role="group" aria-label="Acciones para orden @orden.NumeroOrden">
                                                <a href="@Url.Action("Detalles", "OrdenRecaudacion", new { id = orden.Id })"
                                                   class="btn btn-outline-primary btn-sm btn-detalle"
                                                   title="Ver detalles completos"
                                                   data-bs-toggle="tooltip"
                                                   data-id="@orden.Id"
                                                   aria-label="Ver detalles de orden @orden.NumeroOrden">
                                                    <i class="fas fa-eye"></i>
                                                </a>

                                                @if (puedeEditar)
                                                {
                                                    <a href="@Url.Action("Editar", "OrdenRecaudacion", new { id = orden.Id })"
                                                       class="btn btn-outline-success btn-sm btn-editar"
                                                       title="Editar orden"
                                                       data-bs-toggle="tooltip"
                                                       data-id="@orden.Id"
                                                       aria-label="Editar orden @orden.NumeroOrden">
                                                        <i class="fas fa-edit"></i>
                                                    </a>
                                                }

                                                @if (puedeAnular)
                                                {
                                                    <button type="button"
                                                            class="btn btn-outline-danger btn-sm btn-anular"
                                                            title="Anular orden"
                                                            data-bs-toggle="tooltip"
                                                            data-id="@orden.Id"
                                                            data-numero="@(orden.NumeroOrden ?? orden.Id.ToString())"
                                                            aria-label="Anular orden @orden.NumeroOrden">
                                                        <i class="fas fa-ban"></i>
                                                    </button>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            @if (Model != null && Model.Any())
            {
                <!-- Footer de la tabla -->
                <div class="card-footer bg-white border-top-0 pt-3">
                    <div class="row align-items-center">
                        <div class="col-md-6">
                            <div class="text-muted small d-flex align-items-center">
                                <i class="fas fa-info-circle me-2"></i>
                                <span>
                                    Mostrando <span id="filas-mostradas" class="fw-semibold">@Model.Count</span>
                                    de <span id="filas-totales" class="fw-semibold">@Model.Count</span> registros
                                </span>
                            </div>
                        </div>
                        <div class="col-md-6 text-md-end">
                            <div class="d-flex flex-column flex-md-row justify-content-md-end align-items-start align-items-md-center gap-2">
                                <a href="@Url.Action("Index", "OrdenRecaudacion")"
                                   class="btn btn-outline-secondary btn-sm d-inline-flex align-items-center order-md-2"
                                   id="btn-recargar"
                                   aria-label="Recargar página">
                                    <i class="fas fa-redo me-2"></i> Recargar
                                </a>

                                @if (esFinanciero)
                                {
                                    <a href="@Url.Action("ExportarExcel", "OrdenRecaudacion")"
                                       class="btn btn-outline-primary btn-sm d-inline-flex align-items-center order-md-1"
                                       id="btn-exportar-excel"
                                       aria-label="Exportar a Excel">
                                        <i class="fas fa-file-excel me-2"></i> Exportar Excel
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    @* ============================================
        SECCI�N: SCRIPTS PROFESIONALES PARA PRODUCCIÓN
        ============================================ *@
    @section Scripts {
        <!-- Script principal -->
        <script>
    // =====================================================================
    // ? MODULO PRINCIPAL - PRODUCCIÓN C# 5 COMPATIBLE
    // =====================================================================
    (function () {
        'use strict';

        // ====================================================
        // CONFIGURACIÓN GLOBAL
        // ====================================================
        var CONFIG = {
            // URLs - Corrección: Usar Url.Action correctamente
            apiUrl: '@Url.Action("", "OrdenRecaudacion")',
            baseUrl: '@Url.Content("~/")',

            // DataTables
            dataTableLang: {
                "decimal": ",",
                "emptyTable": "No hay datos disponibles en la tabla",
                "info": "Mostrando _START_ a _END_ de _TOTAL_ registros",
                "infoEmpty": "Mostrando 0 a 0 de 0 registros",
                "infoFiltered": "(filtrado de _MAX_ registros totales)",
                "infoPostFix": "",
                "thousands": ".",
                "lengthMenu": "Mostrar _MENU_ registros",
                "loadingRecords": "Cargando...",
                "processing": "Procesando...",
                "search": "Buscar:",
                "zeroRecords": "No se encontraron registros coincidentes",
                "paginate": {
                    "first": "Primero",
                    "last": "Último",
                    "next": "Siguiente",
                    "previous": "Anterior"
                },
                "aria": {
                    "sortAscending": ": activar para ordenar la columna ascendente",
                    "sortDescending": ": activar para ordenar la columna descendente"
                }
            },
            pageLength: 10,

            // Timeouts
            ajaxTimeout: 30000,
            notificationTimeout: 5000,

            // Selectores
            selectors: {
                tabla: '#tablaOrdenes',
                formFiltros: '#form-filtros',
                btnAnular: '.btn-anular',
                btnDbPing: '#btn-db-ping',
                btnExportarPdf: '.export-pdf',
                btnExportarCsv: '.export-csv',
                filtroFechaDesde: '#filtroFechaDesde',
                filtroFechaHasta: '#filtroFechaHasta'
            },

            // Mensajes
            messages: {
                confirmarAnular: 'Está seguro de anular la orden {0}? Esta acción no se puede deshacer.',
                anulando: 'Anulando orden...',
                anuladoExito: 'Orden {0} anulada correctamente.',
                anuladoError: 'Error al anular la orden: {0}',
                conexionExito: '? Conexión a BD exitosa',
                conexionError: '? Error en conexión a BD',
                exportando: '?? Generando archivo {0}...',
                exportadoExito: '? Archivo {0} listo para descargar',
                validacionFechas: 'La fecha "desde" no puede ser mayor a la fecha "hasta".'
            }
        };

        // ====================================================
        // VARIABLES GLOBALES
        // ====================================================
        var tablaOrdenesDT = null;
        var tooltipInstances = [];
        var isLoading = false;

        // ====================================================
        // INICIALIZACIóN PRINCIPAL
        // ====================================================
        function init() {
            try {
                // Esperar a que jQuery est� disponible
                if (typeof jQuery === 'undefined') {
                    console.error('? jQuery no está disponible');
                    setTimeout(init, 100);
                    return;
                }

                $(document).ready(function () {
                    log('?? Inicializando módulo de órdenes...');

                    // Inicializar componentes en orden de dependencia
                    initDateValidation();
                    initTooltips();
                    initDataTables();
                    initEventListeners();
                    setupAccessibility();

                    log('? Módulo completamente inicializado');
                });
            } catch (error) {
                logError('Error en inicializaci�n:', error);
                showErrorToUser('No se pudo inicializar la página. Por favor, recargue.');
            }
        }

        // ====================================================
        // FUNCIONES DE UTILIDAD
        // ====================================================

        // Logging controlado
        function log(message) {
            if (window.console && window.console.log) {
                console.log('[AOCR-Ordenes] ' + message);
            }
        }

        function logError(message, error) {
            if (window.console && window.console.error) {
                console.error('[AOCR-Ordenes] ' + message, error || '');
            }
        }

        // Formatear moneda
        function formatCurrency(amount) {
            if (amount === null || amount === undefined || isNaN(amount)) {
                return '$0.00';
            }
            return '$' + parseFloat(amount).toLocaleString('es-EC', {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
            });
        }

        // ====================================================
        // INICIALIZACI�N DE COMPONENTES
        // ====================================================

        // Validación de fechas
        function initDateValidation() {
            var $fechaDesde = $(CONFIG.selectors.filtroFechaDesde);
            var $fechaHasta = $(CONFIG.selectors.filtroFechaHasta);

            if ($fechaDesde.length && $fechaHasta.length) {
                var today = new Date().toISOString().split('T')[0];
                $fechaDesde.attr('max', today);
                $fechaHasta.attr('max', today);

                $fechaDesde.on('change', function() {
                    var desde = $(this).val();
                    $fechaHasta.attr('min', desde);

                    // Validar rango
                    var hasta = $fechaHasta.val();
                    if (hasta && desde > hasta) {
                        showNotification(CONFIG.messages.validacionFechas, 'warning');
                        $fechaHasta.val(desde);
                    }
                });

                $fechaHasta.on('change', function() {
                    var hasta = $(this).val();
                    $fechaDesde.attr('max', hasta);

                    // Validar rango
                    var desde = $fechaDesde.val();
                    if (desde && desde > hasta) {
                        showNotification(CONFIG.messages.validacionFechas, 'warning');
                        $fechaDesde.val(hasta);
                    }
                });
            }
        }

        // Tooltips de Bootstrap
        function initTooltips() {
            if (typeof bootstrap === 'undefined' || !bootstrap.Tooltip) {
                log('?? Bootstrap Tooltip no disponible');
                return;
            }

            // Limpiar tooltips anteriores
            destroyTooltips();

            var tooltipElements = document.querySelectorAll('[data-bs-toggle="tooltip"]');
            tooltipElements.forEach(function(element) {
                try {
                    var tooltip = new bootstrap.Tooltip(element, {
                        trigger: 'hover focus',
                        delay: { show: 100, hide: 100 }
                    });
                    tooltipInstances.push(tooltip);
                } catch (error) {
                    logError('Error al crear tooltip:', error);
                }
            });

            log('? Tooltips inicializados: ' + tooltipInstances.length);
        }

        function destroyTooltips() {
            tooltipInstances.forEach(function(tooltip) {
                try {
                    tooltip.dispose();
                } catch(e) {
                    // Ignorar errores de disposici�n
                }
            });
            tooltipInstances = [];
        }

        // DataTables
        function initDataTables() {
            var $table = $(CONFIG.selectors.tabla);

            // Verificar si la tabla existe y tiene datos
            if ($table.length === 0) {
                log('?? No hay tabla para inicializar DataTables');
                return;
            }

            // Verificar si la tabla tiene filas
            if ($table.find('tbody tr').length === 0) {
                log('?? La tabla no tiene datos');
                return;
            }

            try {
                // Verificar si DataTables esta disponible
                if (typeof $.fn.DataTable === 'undefined') {
                    log('? Esperando DataTables...');
                    setTimeout(initDataTables, 100);
                    return;
                }

                // Destruir instancia previa
                if ($.fn.DataTable.isDataTable(CONFIG.selectors.tabla)) {
                    if (tablaOrdenesDT) {
                        tablaOrdenesDT.destroy(true);
                        $table.removeClass('dataTable');
                    }
                }

                // Configuración profesional
                var config = {
                    language: CONFIG.dataTableLang,
                    order: [[0, 'desc']],
                    pageLength: CONFIG.pageLength,
                    lengthMenu: [[5, 10, 25, 50, -1], [5, 10, 25, 50, 'Todos']],
                    responsive: true,
                    autoWidth: false,
                    processing: true,
                    stateSave: false,
                    serverSide: false,
                    deferRender: true,
                    searching: true,
                    info: true,
                    paging: true,
                    columnDefs: [
                        { orderable: false, targets: [7] },
                        { className: 'dt-body-center', targets: [0, 7] },
                        { className: 'dt-body-right', targets: [4] },
                        { width: '80px', targets: [0] },
                        { width: '150px', targets: [1] },
                        { width: '200px', targets: [2] },
                        { width: '120px', targets: [3, 6] },
                        { width: '130px', targets: [4] },
                        { width: '150px', targets: [5] },
                        { width: '100px', targets: [7] }
                    ],
                    drawCallback: function (settings) {
                        setTimeout(initTooltips, 50);
                        updateRowCounters();
                        updateAccessibility();
                    },
                    initComplete: function () {
                        log('? DataTables inicializado correctamente');
                        tablaOrdenesDT = this.api();
                        updateRowCounters();
                    },
                    createdRow: function(row, data, dataIndex) {
                        // Mejoras de accesibilidad
                        $(row).attr('role', 'row');
                        $(row).find('td').attr('role', 'gridcell');
                    }
                };

                // Inicializar DataTables
                $table.DataTable(config);

            } catch (error) {
                logError('? Error al inicializar DataTables:', error);
                // No mostrar alerta al usuario, solo log
            }
        }

        // Event Listeners
        function initEventListeners() {
            var $document = $(document);

            // Test de conexi�n a BD - SOLUCIÓN: Deshabilitar temporalmente
            $document.on('click', CONFIG.selectors.btnDbPing, function(e) {
                e.preventDefault();
                showNotification('Función temporalmente deshabilitada', 'info');
                /*
                if (isLoading) return;

                var $btn = $(this);
                var originalHtml = $btn.html();

                isLoading = true;
                $btn.addClass('loading');
                $btn.html('<i class="fas fa-spinner fa-spin me-1"></i><span class="d-none d-md-inline">Probando...</span>');
                $btn.prop('disabled', true);

                $.ajax({
                    url: CONFIG.apiUrl + '/TestConexion',
                    type: 'GET',
                    timeout: CONFIG.ajaxTimeout,
                    dataType: 'json'
                })
                .done(function(response) {
                    if (response && response.ok) {
                        showNotification(CONFIG.messages.conexionExito, 'success');
                    } else {
                        showNotification(CONFIG.messages.conexionError, 'warning');
                    }
                })
                .fail(function(xhr, status, error) {
                    logError('Error en ping DB:', error);
                    showNotification(CONFIG.messages.conexionError, 'danger');
                })
                .always(function() {
                    setTimeout(function() {
                        $btn.html(originalHtml);
                        $btn.prop('disabled', false);
                        $btn.removeClass('loading');
                        isLoading = false;
                    }, 1000);
                });
                */
            });

            // Anular orden
            $document.on('click', CONFIG.selectors.btnAnular, function() {
                if (isLoading) return;

                var $btn = $(this);
                var id = $btn.data('id');
                var numero = $btn.data('numero') || id;

                confirmAction(
                    'Anular Orden',
                    CONFIG.messages.confirmarAnular.replace('{0}', numero),
                    function() {
                        anularOrden(id, numero, $btn);
                    }
                );
            });

            // Exportar PDF/CSV
            $document.on('click', CONFIG.selectors.btnExportarPdf + ', ' + CONFIG.selectors.btnExportarCsv, function(e) {
                e.preventDefault();
                if (isLoading) return;

                var $btn = $(this);
                var tipo = $btn.hasClass('export-pdf') ? 'PDF' : 'CSV';

                showNotification(CONFIG.messages.exportando.replace('{0}', tipo), 'info');
                isLoading = true;

                // Simular procesamiento (en producci�n ser�a AJAX real)
                setTimeout(function() {
                    showNotification(CONFIG.messages.exportadoExito.replace('{0}', tipo), 'success');
                    isLoading = false;
                }, 2000);
            });

            // Validar formulario de filtros
            $document.on('submit', CONFIG.selectors.formFiltros, function(e) {
                var $form = $(this);
                var $fechaDesde = $form.find(CONFIG.selectors.filtroFechaDesde);
                var $fechaHasta = $form.find(CONFIG.selectors.filtroFechaHasta);

                if ($fechaDesde.val() && $fechaHasta.val() && $fechaDesde.val() > $fechaHasta.val()) {
                    e.preventDefault();
                    showNotification(CONFIG.messages.validacionFechas, 'warning');
                    $fechaHasta.focus();
                    return false;
                }

                // Mostrar indicador de carga
                var $submitBtn = $form.find('#btn-aplicar-filtros');
                $submitBtn.addClass('loading');
                $submitBtn.html('<i class="fas fa-spinner fa-spin me-2"></i>Procesando...');
                $submitBtn.prop('disabled', true);

                return true;
            });
        }

        // Accesibilidad
        function setupAccessibility() {
            // Mejoras de navegaci�n por teclado
            $(document).on('keydown', function(e) {
                // Ctrl+F para buscar
                if (e.ctrlKey && e.key === 'f') {
                    e.preventDefault();
                    var $searchInput = $('.dataTables_filter input');
                    if ($searchInput.length) {
                        $searchInput.focus();
                    }
                }

                // Escape para limpiar filtros
                if (e.key === 'Escape') {
                    $('#btn-limpiar-filtros').click();
                }
            });

            // Focus management
            $(document).on('click', '.btn-anular', function() {
                setTimeout(function() {
                    $('.btn-anular:first').focus();
                }, 100);
            });
        }

        function updateAccessibility() {
            // Actualizar ARIA labels din�micamente
            $('table#tablaOrdenes tbody tr').each(function(index) {
                var $row = $(this);
                var numeroOrden = $row.data('numero') || $row.find('td:eq(1) strong').text();
                $row.find('.btn-detalle').attr('aria-label', 'Ver detalles de orden ' + numeroOrden);
                $row.find('.btn-editar').attr('aria-label', 'Editar orden ' + numeroOrden);
                $row.find('.btn-anular').attr('aria-label', 'Anular orden ' + numeroOrden);
            });
        }

        // ====================================================
        // FUNCIONES DE NEGOCIO
        // ====================================================

        // Anular orden
        function anularOrden(id, numero, $btn) {
            if (isLoading) return;

            isLoading = true;
            var originalHtml = $btn.html();

            $btn.addClass('loading');
            $btn.html('<i class="fas fa-spinner fa-spin"></i>');
            $btn.prop('disabled', true);

            $.ajax({
                url: CONFIG.apiUrl + '/Anular',
                type: 'POST',
                data: {
                    id: id,
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                },
                timeout: CONFIG.ajaxTimeout,
                dataType: 'json'
            })
            .done(function(response) {
                if (response && response.success) {
                    showNotification(
                        CONFIG.messages.anuladoExito.replace('{0}', numero),
                        'success'
                    );

                    // Recargar despu�s de �xito
                    setTimeout(function() {
                        window.location.reload();
                    }, 1500);
                } else {
                    var errorMsg = response && response.message ? response.message : 'Error desconocido';
                    showNotification(
                        CONFIG.messages.anuladoError.replace('{0}', errorMsg),
                        'danger'
                    );
                }
            })
            .fail(function(xhr, status, error) {
                logError('Error AJAX al anular:', error);
                showNotification(CONFIG.messages.anuladoError.replace('{0}', 'Error de conexión'), 'danger');
            })
            .always(function() {
                setTimeout(function() {
                    $btn.html(originalHtml);
                    $btn.prop('disabled', false);
                    $btn.removeClass('loading');
                    isLoading = false;
                }, 1000);
            });
        }

        // Actualizar contadores
        function updateRowCounters() {
            if (!tablaOrdenesDT) return;

            try {
                var total = tablaOrdenesDT.rows().count();
                var filtered = tablaOrdenesDT.rows({ search: 'applied' }).count();

                $('#filas-mostradas').text(filtered);
                $('#filas-totales').text(total);
                $('#contador-registros').text(total);

                // Actualizar badge
                var $badge = $('#badge-contador');
                if (filtered < total) {
                    $badge.removeClass('bg-light').addClass('bg-warning');
                    $badge.find('i').removeClass('fa-database').addClass('fa-filter');
                } else {
                    $badge.removeClass('bg-warning').addClass('bg-light');
                    $badge.find('i').removeClass('fa-filter').addClass('fa-database');
                }
            } catch (error) {
                logError('Error al actualizar contadores:', error);
            }
        }

        // ====================================================
        // FUNCIONES DE UI/UX
        // ====================================================

        // Mostrar notificaci�n
        function showNotification(message, type) {
            // Prioridad: Toastr > Bootstrap > Nativo
            if (typeof toastr !== 'undefined') {
                toastr.options = {
                    closeButton: true,
                    progressBar: true,
                    positionClass: 'toast-top-right',
                    timeOut: CONFIG.notificationTimeout,
                    extendedTimeOut: 1000
                };

                switch(type) {
                    case 'success': toastr.success(message); break;
                    case 'error':
                    case 'danger': toastr.error(message); break;
                    case 'warning': toastr.warning(message); break;
                    case 'info':
                    default: toastr.info(message);
                }
            } else if (typeof bootstrap !== 'undefined') {
                var alertClass = 'alert-' + (type === 'danger' ? 'danger' : type);
                var icon = '';

                switch(type) {
                    case 'success': icon = '<i class="fas fa-check-circle me-2"></i>'; break;
                    case 'error':
                    case 'danger': icon = '<i class="fas fa-exclamation-circle me-2"></i>'; break;
                    case 'warning': icon = '<i class="fas fa-exclamation-triangle me-2"></i>'; break;
                    case 'info': icon = '<i class="fas fa-info-circle me-2"></i>'; break;
                }

                var alertId = 'alert-' + Date.now();
                var alertHtml = '<div id="' + alertId + '" class="alert ' + alertClass + ' alert-dismissible fade show" role="alert">' +
                               icon + AOCR.escapeHtml(String(message)) +
                               '<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>' +
                               '</div>';

                $('.container-fluid').first().prepend(alertHtml);

                // Auto-dismiss
                setTimeout(function() {
                    $('#' + alertId).alert('close');
                }, CONFIG.notificationTimeout);
            } else {
                alert(message);
            }
        }

        // Confirmar acci�n
        function confirmAction(title, message, callback) {
            if (typeof Swal !== 'undefined') {
                Swal.fire({
                    title: title,
                    text: message,
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'Si, proceder',
                    cancelButtonText: 'Cancelar',
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#6c757d',
                    reverseButtons: true,
                    focusCancel: true,
                    allowOutsideClick: false,
                    allowEscapeKey: true
                }).then(function(result) {
                    if (result.isConfirmed && typeof callback === 'function') {
                        callback();
                    }
                });
            } else if (typeof bootstrap !== 'undefined') {
                // Implementaci�n con Bootstrap Modal
                var modalHtml = '<div class="modal fade" id="modalConfirmacion" tabindex="-1">' +
                               '<div class="modal-dialog">' +
                               '<div class="modal-content">' +
                               '<div class="modal-header">' +
                               '<h5 class="modal-title">' + AOCR.escapeHtml(String(title)) + '</h5>' +
                               '<button type="button" class="btn-close" data-bs-dismiss="modal"></button>' +
                               '</div>' +
                               '<div class="modal-body">' + AOCR.escapeHtml(String(message)) + '</div>' +
                               '<div class="modal-footer">' +
                               '<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>' +
                               '<button type="button" class="btn btn-danger" id="btnConfirmarAccion">Proceder</button>' +
                               '</div>' +
                               '</div>' +
                               '</div>' +
                               '</div>';

                $('body').append(modalHtml);

                var modal = new bootstrap.Modal(document.getElementById('modalConfirmacion'));

                $('#btnConfirmarAccion').off('click').on('click', function() {
                    modal.hide();
                    if (typeof callback === 'function') {
                        callback();
                    }
                    $('#modalConfirmacion').remove();
                });

                $('#modalConfirmacion').on('hidden.bs.modal', function() {
                    $(this).remove();
                });

                modal.show();
            } else {
                if (confirm(title + '\n\n' + message)) {
                    if (typeof callback === 'function') {
                        callback();
                    }
                }
            }
        }

        // Mostrar alerta
        function showAlert(title, message, type) {
            if (typeof Swal !== 'undefined') {
                Swal.fire({
                    title: title,
                    text: message,
                    icon: type || 'info',
                    confirmButtonText: 'Aceptar',
                    confirmButtonColor: '#1B4F72'
                });
            } else {
                alert(title + '\n' + message);
            }
        }

        // Mostrar error al usuario
        function showErrorToUser(message) {
            var errorHtml = '<div class="alert alert-danger alert-dismissible fade show" role="alert">' +
                           '<i class="fas fa-exclamation-triangle me-2"></i>' +
                           '<strong>Error:</strong> ' + AOCR.escapeHtml(String(message)) +
                           '<button type="button" class="btn-close" data-bs-dismiss="alert"></button>' +
                           '</div>';

            $('.container-fluid').first().prepend(errorHtml);
        }

        // ====================================================
        // INICIALIZAR APLICACI�N
        // ====================================================
        // Esperar a que todo est� cargado
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', init);
        } else {
            // DOM ya est� cargado
            setTimeout(init, 100);
        }

        // ====================================================
        // EXPONER API P�BLICA (opcional)
        // ====================================================
        window.AOCROrdenes = {
            recargar: function() {
                window.location.reload();
            },
            exportarExcel: function() {
                window.location.href = '@Url.Action("ExportarExcel", "OrdenRecaudacion")';
            },
            getContadores: function() {
                return {
                    total: $('#filas-totales').text(),
                    mostradas: $('#filas-mostradas').text()
                };
            }
        };

    })();
        </script>
    }

    @* ============================================
        SECCI�N: FUNCIONES HELPER EN C# (SERVER-SIDE)
        ============================================ *@
    @functions {
    /// <summary>
    /// Formatea un valor decimal como moneda
    /// </summary>
    public static string FormatCurrency(decimal amount)
    {
        try
        {
            return amount.ToString("C", System.Globalization.CultureInfo.CurrentCulture);
        }
        catch
        {
            // Fallback seguro
            return amount.ToString("N2") + " USD";
        }
    }

    /// <summary>
    /// Formatea un valor decimal nullable como moneda
    /// </summary>
    public static string FormatCurrency(decimal? amount)
    {
        if (!amount.HasValue || amount.Value == 0)
        {
            return "$0.00";
        }

        try
        {
            return amount.Value.ToString("C", System.Globalization.CultureInfo.CurrentCulture);
        }
        catch
        {
            return amount.Value.ToString("N2") + " USD";
        }
    }

    /// <summary>
    /// Obtiene la clase CSS para el estado de la orden
    /// </summary>
    public static string GetClaseEstado(string estado)
    {
        if (string.IsNullOrWhiteSpace(estado))
        {
            return "bg-secondary";
        }

        var estadoUpper = estado.Trim().ToUpperInvariant();

        switch (estadoUpper)
        {
            case "BORRADOR": return "estado-borrador";
            case "PENDIENTE": return "estado-generada";
            case "PROCESADA": return "estado-enviada";
            case "FACTURADA": return "estado-pagada";
            case "COMPLETADA": return "estado-pagada";
            case "ANULADA": return "estado-anulada";
            default: return "bg-secondary";
        }
    }

    /// <summary>
    /// Obtiene el texto para mostrar del estado
    /// </summary>
    public static string GetTextoEstado(string estado)
    {
        if (string.IsNullOrWhiteSpace(estado))
        {
            return "DESCONOCIDO";
        }

        var est = estado.Trim().ToUpperInvariant();
        switch (est)
        {
            case "PENDIENTE": return "PENDIENTE";
            case "PROCESADA": return "PROCESADA";
            case "FACTURADA": return "FACTURADA";
            case "COMPLETADA": return "COMPLETADA";
            default: return est;
        }
    }

    /// <summary>
    /// Trunca texto a una longitud m�xima
    /// </summary>
    public static string TruncateText(string texto, int maxLength)
    {
        if (string.IsNullOrWhiteSpace(texto))
        {
            return string.Empty;
        }

        if (texto.Length <= maxLength)
        {
            return texto;
        }

        return texto.Substring(0, maxLength) + "...";
    }

    /// <summary>
    /// Valida si una fecha es v�lida (no nula y no m�nima)
    /// </summary>
    public static bool EsFechaValida(DateTime? fecha)
    {
        return fecha.HasValue && fecha.Value != DateTime.MinValue;
    }

    /// <summary>
    /// Obtiene el token AntiForgery para formularios manuales
    /// </summary>
    public static string GetAntiForgeryToken()
    {
        try
        {
            // Esta es una implementaci�n b�sica. En producci�n, necesitar�as
            // usar el m�todo real de AntiForgeryToken de MVC
            return Guid.NewGuid().ToString();
        }
        catch
        {
            return string.Empty;
        }
    }

    // Texto amigable del tr�mite
    public static string GetTextoTramite(string estado)
    {
        if (string.IsNullOrWhiteSpace(estado))
        {
            return "SIN ESTADO";
        }

        var est = estado.Trim().ToUpperInvariant();
        switch (est)
        {
            case "BORRADOR": return "Borrador";
            case "PENDIENTE": return "Pendiente de pago";
            case "PROCESADA": return "En revisión financiera";
            case "FACTURADA": return "Su factura ha sido generada correctamente";
            case "COMPLETADA": return "Completada";
            case "ANULADA": return "Anulada";
            default: return est;
        }
    }
}


