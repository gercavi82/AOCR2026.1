@inherits System.Web.Mvc.WebViewPage<List<CapaDatos.Models.OrdenRecaudacionModel>>
@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Ordenes de Recaudación</title>
    <style>
        body { font-family: Arial, sans-serif; font-size: 11px; }
        h2 { margin: 0 0 10px 0; }
        table { width: 100%; border-collapse: collapse; }
        th, td { border: 1px solid #ccc; padding: 6px; }
        th { background: #f0f0f0; text-align: left; }
        .num { text-align: right; }
    </style>
</head>
<body>
    <h2>Órdenes de Recaudación</h2>
    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Número</th>
                <th>Estado</th>
                <th>Fecha</th>
                <th>Compañía</th>
                <th>RUC/Cédula</th>
                <th class="num">Subtotal</th>
                <th class="num">Admin</th>
                <th class="num">Total</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null)
            {
                foreach (var o in Model)
                {
                    <tr>
                        <td>@o.Id</td>
                        <td>@o.NumeroOrden</td>
                        <td>@o.Estado</td>
                        <td>@String.Format("{0:yyyy-MM-dd}", o.FechaCreacion)</td>
                        <td>@o.Compania</td>
                        <td>@o.RucCedula</td>
                        <td class="num">@String.Format("{0:0.00}", o.Subtotal)</td>
                        <td class="num">@String.Format("{0:0.00}", o.Admin)</td>
                        <td class="num">@String.Format("{0:0.00}", o.Total)</td>
                    </tr>
                }
            }
        </tbody>
    </table>
</body>
</html>
