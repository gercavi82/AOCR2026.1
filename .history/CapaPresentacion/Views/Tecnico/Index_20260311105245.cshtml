@model IEnumerable<CapaModelo.SolicitudAOCR>
@using CapaModelo
@using System.Web.Mvc
@using System.Web.Mvc.Html

@{
    ViewBag.Title = "Asignación de Inspectores";
    Layout = "~/Views/Shared/_LayoutAOCR.cshtml";
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <h2 class="mb-0">
        <i class="glyphicon glyphicon-search"></i> Solicitudes Pendientes de Asignación
    </h2>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="glyphicon glyphicon-ok-circle"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="glyphicon glyphicon-exclamation-sign"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Info"] != null)
{
    <div class="alert alert-info alert-dismissible fade show" role="alert">
        <i class="glyphicon glyphicon-info-sign"></i> @TempData["Info"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card">
    <div class="card-body">
        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width:110px;">Código</th>
                            <th>N° Solicitud</th>
                            <th>Operador</th>
                            <th>Fecha Solicitud</th>
                            <th>Estado</th>
                            <th style="width:140px;" class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model)
                        {
                            <tr>
                                <td>@Html.Encode(s.CodigoSolicitud)</td>
                                <td>@Html.Encode(s.NumeroSolicitud)</td>
                                <td>@Html.Encode(s.NombreOperador)</td>
                                <td>@Html.Encode(s.FechaSolicitud.HasValue ? s.FechaSolicitud.Value.ToString("dd/MM/yyyy") : "-")</td>
                                <td>
                                    <span class="badge 
                                        @(s.Estado == "APROBADA" ? "bg-success" : 
                                          s.Estado == "INSPECCION_SOLICITADA" ? "bg-info" : "bg-secondary")">
                                        @s.Estado
                                    </span>
                                </td>
                                <td class="text-center">
                                    <a href="@Url.Action("AsignarInspector", "Tecnico", new { solicitudId = s.CodigoSolicitud })" 
                                       class="btn btn-sm btn-primary" title="Asignar Inspector">
                                        <i class="glyphicon glyphicon-user"></i> Asignar
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-info mb-0">
                <i class="glyphicon glyphicon-info-sign"></i> No hay solicitudes pendientes de asignación de inspector.
            </div>
        }
    </div>
</div>


