@inherits System.Web.Mvc.WebViewPage<CapaModelo.SolicitudAOCR>
@using CapaModelo
@using System.Web.Mvc
@using System.Web.Mvc.Html
@{
    ViewBag.Title = "Asignar Inspector";
    Layout = "~/Views/Shared/_LayoutAOCR.cshtml";
    var tipoInspectorSeleccionado = (ViewBag.TipoInspector as string) ?? "OPS";
    var warningInspectores = ViewBag.WarningInspectores as string;
    var tipoInspectorTexto = tipoInspectorSeleccionado;
    var tiposInspectorSelectList = ViewBag.TiposInspector as SelectList;

    if (tiposInspectorSelectList != null)
    {
        var tipoSeleccionadoItem = tiposInspectorSelectList.Cast<SelectListItem>().FirstOrDefault(x => x.Value == tipoInspectorSeleccionado);
        if (tipoSeleccionadoItem != null && !string.IsNullOrWhiteSpace(tipoSeleccionadoItem.Text))
        {
            tipoInspectorTexto = tipoSeleccionadoItem.Text;
        }
    }
}

@section Styles {
    <style>
        .assign-inspector-page {
            --assign-primary: #1b4f72;
            --assign-primary-dark: #163d59;
            --assign-accent: #0c7c86;
            --assign-soft: #f3f8fb;
            --assign-border: rgba(27, 79, 114, 0.14);
            --assign-text: #243746;
            --assign-muted: #6b7b88;
            --assign-success: #2d8f57;
            --assign-shadow: 0 18px 38px rgba(16, 46, 66, 0.09);
            color: var(--assign-text);
        }

        .assign-inspector-page .assign-shell {
            background: linear-gradient(135deg, #f7fbfd 0%, #eef4f8 100%);
            border: 1px solid rgba(255, 255, 255, 0.75);
            border-radius: 28px;
            padding: 1.5rem;
            box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.65);
        }

        .assign-inspector-page .hero-card {
            position: relative;
            overflow: hidden;
            border: 0;
            border-radius: 28px;
            background: linear-gradient(135deg, var(--assign-primary-dark) 0%, var(--assign-primary) 58%, #256e8c 100%);
            color: #fff;
            box-shadow: var(--assign-shadow);
        }

        .assign-inspector-page .hero-card::after {
            content: "";
            position: absolute;
            inset: auto -60px -80px auto;
            width: 220px;
            height: 220px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.08);
        }

        .assign-inspector-page .hero-card::before {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient(90deg, rgba(255, 255, 255, 0.06), transparent 55%);
        }

        .assign-inspector-page .hero-body {
            position: relative;
            z-index: 1;
            padding: 1.75rem;
        }

        .assign-inspector-page .hero-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.55rem;
            padding: 0.5rem 0.85rem;
            border-radius: 999px;
            background: rgba(255, 255, 255, 0.14);
            font-size: 0.82rem;
            font-weight: 700;
            letter-spacing: 0.04em;
            text-transform: uppercase;
        }

        .assign-inspector-page .hero-title {
            margin: 1rem 0 0.35rem;
            font-size: 2rem;
            font-weight: 800;
            line-height: 1.1;
        }

        .assign-inspector-page .hero-subtitle {
            margin: 0;
            font-size: 1rem;
            color: rgba(255, 255, 255, 0.82);
        }

        .assign-inspector-page .hero-meta {
            display: flex;
            flex-wrap: wrap;
            gap: 0.75rem;
            margin-top: 1.35rem;
        }

        .assign-inspector-page .hero-meta-item {
            min-width: 150px;
            padding: 0.85rem 1rem;
            border-radius: 18px;
            background: rgba(255, 255, 255, 0.12);
            backdrop-filter: blur(4px);
        }

        .assign-inspector-page .hero-meta-label {
            display: block;
            font-size: 0.76rem;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            color: rgba(255, 255, 255, 0.72);
            margin-bottom: 0.2rem;
        }

        .assign-inspector-page .hero-meta-value {
            font-size: 1rem;
            font-weight: 700;
            color: #fff;
        }

        .assign-inspector-page .progress-strip {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 1rem;
            margin-top: 1.25rem;
        }

        .assign-inspector-page .progress-step {
            display: flex;
            align-items: center;
            gap: 0.85rem;
            padding: 1rem;
            background: #fff;
            border: 1px solid var(--assign-border);
            border-radius: 20px;
            box-shadow: 0 10px 24px rgba(15, 45, 64, 0.05);
        }

        .assign-inspector-page .progress-step-icon {
            width: 46px;
            height: 46px;
            border-radius: 14px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, var(--assign-soft) 0%, #dcecf5 100%);
            color: var(--assign-primary);
            font-size: 1.05rem;
        }

        .assign-inspector-page .progress-step small {
            display: block;
            margin-bottom: 0.15rem;
            color: var(--assign-muted);
            text-transform: uppercase;
            letter-spacing: 0.04em;
            font-size: 0.72rem;
            font-weight: 700;
        }

        .assign-inspector-page .progress-step strong {
            display: block;
            font-size: 0.98rem;
            color: var(--assign-text);
        }

        .assign-inspector-page .section-card {
            border: 1px solid var(--assign-border);
            border-radius: 24px;
            box-shadow: 0 14px 30px rgba(15, 45, 64, 0.06);
            overflow: hidden;
        }

        .assign-inspector-page .section-card + .section-card {
            margin-top: 1.25rem;
        }

        .assign-inspector-page .section-card .card-body {
            padding: 1.5rem;
        }

        .assign-inspector-page .section-card.soft-card {
            background: linear-gradient(180deg, #f7fbfd 0%, #ffffff 100%);
        }

        .assign-inspector-page .section-heading {
            display: flex;
            align-items: flex-start;
            gap: 1rem;
            margin-bottom: 1.25rem;
        }

        .assign-inspector-page .section-icon {
            width: 52px;
            height: 52px;
            flex: 0 0 52px;
            border-radius: 16px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            background: linear-gradient(135deg, var(--assign-primary) 0%, var(--assign-accent) 100%);
            box-shadow: 0 14px 30px rgba(27, 79, 114, 0.24);
        }

        .assign-inspector-page .section-title {
            margin: 0;
            font-size: 1.22rem;
            font-weight: 800;
            color: var(--assign-text);
        }

        .assign-inspector-page .section-copy {
            margin: 0.25rem 0 0;
            color: var(--assign-muted);
        }

        .assign-inspector-page .info-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 1rem;
        }

        .assign-inspector-page .info-tile {
            border: 1px solid rgba(27, 79, 114, 0.1);
            border-radius: 18px;
            padding: 1rem 1.1rem;
            background: #fff;
        }

        .assign-inspector-page .info-label {
            display: block;
            font-size: 0.76rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            color: var(--assign-muted);
            margin-bottom: 0.3rem;
        }

        .assign-inspector-page .info-value {
            font-size: 1rem;
            font-weight: 700;
            color: var(--assign-text);
        }

        .assign-inspector-page .type-form-wrap {
            border: 1px dashed rgba(12, 124, 134, 0.28);
            border-radius: 18px;
            background: rgba(12, 124, 134, 0.05);
            padding: 1rem;
        }

        .assign-inspector-page .type-form-label,
        .assign-inspector-page .form-label-strong {
            font-weight: 700;
            color: var(--assign-text);
            margin-bottom: 0.45rem;
        }

        .assign-inspector-page .field-required {
            color: #c0392b;
            font-weight: 800;
            margin-left: 0.2rem;
        }

        .assign-inspector-page .field-hint {
            display: block;
            margin-top: 0.45rem;
            color: var(--assign-muted);
            font-size: 0.85rem;
        }

        .assign-inspector-page .input-group-modern {
            position: relative;
        }

        .assign-inspector-page .input-icon {
            position: absolute;
            top: 50%;
            left: 1rem;
            transform: translateY(-50%);
            color: #7a8d9c;
            pointer-events: none;
            z-index: 2;
        }

        .assign-inspector-page .input-group-modern .form-control,
        .assign-inspector-page .input-group-modern .form-select,
        .assign-inspector-page .input-group-modern textarea.form-control {
            min-height: 54px;
            border-radius: 16px;
            border: 1px solid rgba(36, 55, 70, 0.14);
            padding-left: 2.9rem;
            background-color: #fff;
            box-shadow: none;
            transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
        }

        .assign-inspector-page .input-group-modern textarea.form-control {
            min-height: 130px;
            padding-top: 0.95rem;
            resize: vertical;
        }

        .assign-inspector-page .input-group-modern .form-control:focus,
        .assign-inspector-page .input-group-modern .form-select:focus,
        .assign-inspector-page .input-group-modern textarea.form-control:focus {
            border-color: rgba(27, 79, 114, 0.42);
            box-shadow: 0 0 0 0.28rem rgba(27, 79, 114, 0.12);
            transform: translateY(-1px);
        }

        .assign-inspector-page .textarea-icon {
            top: 1.05rem;
            transform: none;
        }

        .assign-inspector-page .action-bar {
            display: flex;
            justify-content: flex-end;
            gap: 0.85rem;
            margin-top: 1.5rem;
        }

        .assign-inspector-page .btn-action {
            min-width: 190px;
            min-height: 50px;
            border-radius: 14px;
            font-weight: 700;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

        .assign-inspector-page .btn-action:hover,
        .assign-inspector-page .btn-action:focus {
            transform: translateY(-1px);
        }

        .assign-inspector-page .btn-confirm {
            border: 0;
            color: #fff;
            background: linear-gradient(135deg, #2b8c59 0%, #207146 100%);
            box-shadow: 0 12px 24px rgba(43, 140, 89, 0.24);
        }

        .assign-inspector-page .btn-confirm:hover,
        .assign-inspector-page .btn-confirm:focus {
            color: #fff;
            box-shadow: 0 16px 28px rgba(43, 140, 89, 0.28);
        }

        .assign-inspector-page .btn-cancel {
            border: 1px solid rgba(36, 55, 70, 0.14);
            background: #f8fafb;
            color: #51616d;
        }

        .assign-inspector-page .alert-modern {
            border: 0;
            border-left: 4px solid #f0ad4e;
            border-radius: 18px;
            background: linear-gradient(90deg, rgba(240, 173, 78, 0.12), rgba(240, 173, 78, 0.04));
            color: #7c5a17;
            box-shadow: 0 10px 25px rgba(240, 173, 78, 0.08);
        }

        .assign-inspector-page .empty-state-note {
            margin-top: 1rem;
            padding: 0.95rem 1rem;
            border-radius: 16px;
            background: rgba(12, 124, 134, 0.06);
            color: var(--assign-muted);
            font-size: 0.9rem;
        }

        @@media (max-width: 991.98px) {
            .assign-inspector-page .progress-strip,
            .assign-inspector-page .info-grid {
                grid-template-columns: 1fr;
            }
        }

        @@media (max-width: 767.98px) {
            .assign-inspector-page .assign-shell {
                padding: 1rem;
                border-radius: 22px;
            }

            .assign-inspector-page .hero-body,
            .assign-inspector-page .section-card .card-body {
                padding: 1.2rem;
            }

            .assign-inspector-page .hero-title {
                font-size: 1.6rem;
            }

            .assign-inspector-page .action-bar {
                flex-direction: column-reverse;
            }

            .assign-inspector-page .btn-action {
                width: 100%;
                min-width: 0;
            }
        }
    </style>
}

<div class="container-fluid mt-4 assign-inspector-page">
    <div class="assign-shell">
        <div class="card hero-card mb-4">
            <div class="hero-body">
                <span class="hero-badge">
                    <i class="fas fa-landmark"></i>
                    DGAC Ecuador
                </span>
                <div class="row align-items-end g-3 mt-1">
                    <div class="col-lg-8">
                        <h1 class="hero-title">
                            <i class="fas fa-user-check me-2"></i>Asignación de Inspectores
                        </h1>
                        <p class="hero-subtitle">Gestione la designación institucional de inspectores para la solicitud seleccionada, manteniendo trazabilidad y control operativo.</p>
                    </div>
                    <div class="col-lg-4">
                        <div class="hero-meta justify-content-lg-end">
                            <div class="hero-meta-item">
                                <span class="hero-meta-label">Solicitud</span>
                                <span class="hero-meta-value">#@Model.CodigoSolicitud</span>
                            </div>
                            <div class="hero-meta-item">
                                <span class="hero-meta-label">Estado actual</span>
                                <span class="hero-meta-value">@(string.IsNullOrWhiteSpace(Model.Estado) ? "No definido" : Model.Estado)</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="progress-strip mb-4">
            <div class="progress-step">
                <span class="progress-step-icon"><i class="fas fa-file-signature"></i></span>
                <div>
                    <small>Bloque 1</small>
                    <strong>Información de la solicitud</strong>
                </div>
            </div>
            <div class="progress-step">
                <span class="progress-step-icon"><i class="fas fa-user-tie"></i></span>
                <div>
                    <small>Bloque 2</small>
                    <strong>Selección de inspectores</strong>
                </div>
            </div>
            <div class="progress-step">
                <span class="progress-step-icon"><i class="fas fa-calendar-check"></i></span>
                <div>
                    <small>Bloque 3</small>
                    <strong>Programación de inspección</strong>
                </div>
            </div>
        </div>

    @if (ViewBag.WarningInspectores != null)
    {
        <div class="alert alert-modern d-flex align-items-start gap-3 mb-4">
            <i class="fas fa-triangle-exclamation mt-1"></i>
            <div>
                <strong>Advertencia de disponibilidad</strong>
                <div>@ViewBag.WarningInspectores</div>
            </div>
        </div>
    }

        <div class="card section-card mb-4">
            <div class="card-body">
                <div class="section-heading">
                    <span class="section-icon"><i class="fas fa-circle-info"></i></span>
                    <div>
                        <h2 class="section-title">Información de la solicitud</h2>
                        <p class="section-copy">Resumen del trámite y filtro del tipo de inspector requerido para esta designación.</p>
                    </div>

                            <div class="mt-3">
                                <label class="form-label-strong" for="horaInspeccion">Hora de revisión<span class="field-required">*</span></label>
                                <div class="input-group-modern">
                                    <span class="input-icon"><i class="fas fa-clock"></i></span>
                                    <input type="time" id="horaInspeccion" name="horaInspeccion" class="form-control" required value="09:00" />
                                </div>
                            </div>
                            <div class="info-tile">
                                <span class="info-label">Número de trámite</span>
                        <div class="col-lg-8">
                            </div>
                            <div class="info-tile">
                                <span class="info-label">Estado</span>
                                <span class="info-value">@(string.IsNullOrWhiteSpace(Model.Estado) ? "No definido" : Model.Estado)</span>
                            </div>
                            <div class="info-tile">
                                <span class="info-label">Tipo de inspector</span>
                                <span class="info-value">@tipoInspectorTexto</span>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-5">
                        @using (Html.BeginForm("AsignarInspector", "Tecnico", FormMethod.Get, new { @class = "type-form-wrap h-100 d-flex flex-column justify-content-center" }))
                        {
                            @Html.Hidden("solicitudId", Model.CodigoSolicitud)
                            <label class="type-form-label" for="tipoInspector">Filtrar tipo de inspector</label>
                            @Html.DropDownList("tipoInspector", (SelectList)ViewBag.TiposInspector, new { @class = "form-select form-control", onchange = "this.form.submit();", aria_label = "Tipo de inspector" })
                            <span class="field-hint">La lista de inspectores se actualiza automáticamente según el tipo seleccionado.</span>
                        }
                    </div>
                </div>
            </div>
        </div>

        @using (Html.BeginForm("AsignarInspector", "Tecnico", FormMethod.Post, new { @class = "assign-form" }))
        {
            @Html.AntiForgeryToken()
            @Html.Hidden("solicitudId", Model.CodigoSolicitud)
            @Html.Hidden("tipoInspector", tipoInspectorSeleccionado)

            <div class="card section-card soft-card">
                <div class="card-body">
                    <div class="section-heading">
                        <span class="section-icon"><i class="fas fa-user-tie"></i></span>
                        <div>
                            <h2 class="section-title">Asignación de inspectores</h2>
                            <p class="section-copy">Defina el inspector principal responsable y, de ser necesario, un inspector de apoyo para el proceso.</p>
                        </div>
                    </div>

                    <div class="row g-4">
                        <div class="col-lg-6">
                            <label class="form-label-strong" for="inspectorPrincipal">Inspector Principal<span class="field-required">*</span></label>
                            <div class="input-group-modern">
                                <span class="input-icon"><i class="fas fa-user-check"></i></span>
                                @Html.DropDownList("inspectorPrincipal", (SelectList)ViewBag.Inspectores, "-- Seleccione --", new { @class = "form-select form-control", required = "required" })
                            </div>
                            <span class="field-hint">Campo obligatorio para confirmar la asignación.</span>
                        </div>

                        <div class="col-lg-6">
                            <label class="form-label-strong" for="inspectorApoyo">Inspector de Apoyo</label>
                            <div class="input-group-modern">
                                <span class="input-icon"><i class="fas fa-user-plus"></i></span>
                                @Html.DropDownList("inspectorApoyo", (SelectList)ViewBag.Inspectores, "-- Opcional --", new { @class = "form-select form-control" })
                            </div>
                            <span class="field-hint">Utilice este campo cuando la inspección requiera acompañamiento técnico.</span>
                        </div>
                    </div>

                    <div class="empty-state-note">
                        <i class="fas fa-shield-halved me-2"></i>
                        La asignación conserva los nombres de campo originales y mantiene la integración actual con el controller y el model binding de Razor.
                    </div>
                </div>
            </div>

            <div class="card section-card mt-4">
                <div class="card-body">
                    <div class="section-heading">
                        <span class="section-icon"><i class="fas fa-calendar-days"></i></span>
                        <div>
                            <h2 class="section-title">Programación de inspección</h2>
                            <p class="section-copy">Establezca la fecha prevista y documente observaciones operativas relevantes para el equipo técnico.</p>
                        </div>
                    </div>

                    <div class="row g-4">
                        <div class="col-lg-4">
                            <label class="form-label-strong" for="fechaInspeccion">Fecha de inspección<span class="field-required">*</span></label>
                            <div class="input-group-modern">
                                <span class="input-icon"><i class="fas fa-calendar-check"></i></span>
                                <input type="date" id="fechaInspeccion" name="fechaInspeccion" class="form-control" required value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                            </div>
                        </div>

                        <div class="col-lg-4">
                            <label class="form-label-strong" for="horaInspeccion">Hora de revisión<span class="field-required">*</span></label>
                            <div class="input-group-modern">
                                <span class="input-icon"><i class="fas fa-clock"></i></span>
                                <input type="time" id="horaInspeccion" name="horaInspeccion" class="form-control" required value="09:00" />
                            </div>
                        </div>

                        <div class="col-lg-4">
                            <label class="form-label-strong" for="observaciones">Observaciones</label>
                            <div class="input-group-modern">
                                <span class="input-icon textarea-icon"><i class="fas fa-clipboard-list"></i></span>
                                <textarea id="observaciones" name="observaciones" class="form-control" rows="4" placeholder="Ingrese observaciones relevantes para la inspección, coordinación o seguimiento."></textarea>
                            </div>
                        </div>
                    </div>

                    <div class="action-bar">
                        <a href="@Url.Action("Index")" class="btn btn-action btn-cancel">
                            <i class="fas fa-arrow-left me-2"></i>Cancelar
                        </a>
                        <button type="submit" class="btn btn-action btn-confirm assignment-submit">
                            <i class="fas fa-check me-2"></i>Confirmar Asignación
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<script>
    (function () {
        var prefix = "[UI-Inspecciones]";
        var solicitudId = "@Model.CodigoSolicitud";
        var estadoActual = "@((Model.Estado ?? string.Empty).Replace("'", "\\'"))";
        var tipoInspector = "@tipoInspectorSeleccionado";
        var warning = "@((warningInspectores ?? string.Empty).Replace("'", "\\'"))";

        function logInfo(msg, data) {
            if (typeof console !== "undefined" && console.info) {
                console.info(prefix + " " + msg, data || "");
            }
        }

        function logWarn(msg, data) {
            if (typeof console !== "undefined" && console.warn) {
                console.warn(prefix + " " + msg, data || "");
            }
        }

        function logError(msg, data) {
            if (typeof console !== "undefined" && console.error) {
                console.error(prefix + " " + msg, data || "");
            }
        }

        function evaluarHabilitacionBoton() {
            var btn = document.querySelector(".assignment-submit");
            var selectPrincipal = document.getElementById("inspectorPrincipal");
            if (!btn || !selectPrincipal) {
                return;
            }

            var motivo = "";
            var habilitado = true;

            if (selectPrincipal.options.length <= 1) {
                habilitado = false;
                motivo = "sin opciones de inspectores";
            } else if (!selectPrincipal.value) {
                habilitado = false;
                motivo = "sin inspector seleccionado";
            }

            btn.disabled = !habilitado;
            logInfo("Boton gestionar habilitado=" + habilitado + ", motivo=" + (motivo || "OK"));
        }

        document.addEventListener("DOMContentLoaded", function () {
            logInfo("Pantalla cargada", {
                solicitudId: solicitudId,
                estadoActual: estadoActual,
                tipoInspector: tipoInspector
            });

            var selectPrincipal = document.getElementById("inspectorPrincipal");
            var selectApoyo = document.getElementById("inspectorApoyo");

            logInfo("Select inspectores encontrado=" + (!!selectPrincipal));
            if (selectPrincipal) {
                logInfo("Inspectores recibidos en respuesta (render server)=" + Math.max(0, selectPrincipal.options.length - 1));
                selectPrincipal.addEventListener("change", function () {
                    logInfo("Valor seleccionado inspectorPrincipal=" + (selectPrincipal.value || "(vacio)"));
                    evaluarHabilitacionBoton();
                });
            }

            if (selectApoyo) {
                selectApoyo.addEventListener("change", function () {
                    logInfo("Valor seleccionado inspectorApoyo=" + (selectApoyo.value || "(vacio)"));
                });
            }

            if (warning) {
                logWarn("Advertencia backend=" + warning);
            }

            var ajaxUrl = "@Url.Action("ListarInspectoresActivos", "Tecnico")" + "?tipoInspector=" + encodeURIComponent(tipoInspector);
            fetch(ajaxUrl, {
                method: "GET",
                headers: { "X-Requested-With": "XMLHttpRequest" }
            })
            .then(function (response) {
                return response.json();
            })
            .then(function (data) {
                logInfo("Respuesta AJAX completa", data);
                var total = data && data.items ? data.items.length : 0;
                var origen = data && data.origen ? data.origen : "(sin-origen)";
                logInfo("Inspectores recibidos en respuesta AJAX=" + total + ", Origen=" + origen);
            })
            .catch(function (error) {
                logError("Error AJAX cargando inspectores", error);
            })
            .finally(function () {
                evaluarHabilitacionBoton();
            });
        });
    })();
</script>

