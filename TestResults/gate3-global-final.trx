        public class GuardarProgresoPayload&#xD;
        {&#xD;
            [JsonProperty("seccion")]&#xD;
            public string Seccion { get; set; }&#xD;
&#xD;
            [JsonProperty("solicitud")]&#xD;
            public SolicitudAOCR Solicitud { get; set; }&#xD;
