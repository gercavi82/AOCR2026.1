                return RedirectToAction("Detalle", new { id });&#xD;
            }&#xD;
&#xD;
            string mensajeCambio;&#xD;
            if (!CambiarEstadoConReglasAocr(id, envioPlan.EstadoDestino, envioPlan.ObservacionEstado, out mensajeCambio))&#xD;
