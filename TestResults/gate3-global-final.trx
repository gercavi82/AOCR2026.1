        public ActionResult RevisarPorJefatura()&#xD;
        {&#xD;
            var pendientes = _solicitudDAO.ObtenerPorEstados("ENVIADO_A_JEFATURA", EstadoSolicitud.AOCR_EnRevision, EstadoSolicitud.AOCR_EnElaboracion);&#xD;
            return View(pendientes);&#xD;
